{
  "name": "@mesh/glass",
  "version": "0.1.0",
  "description": "Liquid-glass desktop: floating top bar of glass pills, desktop player with spectrum and weather cards, a bottom dock with an app grid, notification toasts, a dashboard and a wallpaper carousel, in the violet glass theme.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "composition",
    "uses": {
      "modules": {
        "@mesh/glass-bar": ">=0.1.0",
        "@mesh/glass-widgets": ">=0.1.0",
        "@mesh/glass-dock": ">=0.1.0",
        "@mesh/settings": ">=0.1.0",
        "@mesh/debug-inspector": { "version": ">=0.1.0", "optional": true },
        "@mesh/violet-glass": ">=0.1.0",
        "@mesh/glass-wallpaper": ">=0.1.0",
        "@mesh/glass-material": ">=0.1.0",
        "@mesh/glass-notifications": ">=0.1.0",
        "@mesh/glass-dashboard": ">=0.1.0",
        "@mesh/wallpaper-carousel": ">=0.1.0"
      }
    },
    "compose": {
      "roots": {
        "@mesh/glass-wallpaper#default": {
          "module": "@mesh/glass-wallpaper",
          "entrypoint": "main",
          "active": true
        },
        "@mesh/glass-bar#default": {
          "module": "@mesh/glass-bar",
          "entrypoint": "main",
          "active": true
        },
        "@mesh/glass-widgets#default": {
          "module": "@mesh/glass-widgets",
          "entrypoint": "main",
          "active": true
        },
        "@mesh/glass-dock#default": {
          "module": "@mesh/glass-dock",
          "entrypoint": "main",
          "active": true
        },
        "@mesh/settings#default": {
          "module": "@mesh/settings",
          "entrypoint": "main",
          "active": true
        },
        "@mesh/debug-inspector#default": {
          "module": "@mesh/debug-inspector",
          "entrypoint": "main",
          "active": true
        },
        "@mesh/glass-notifications#default": {
          "module": "@mesh/glass-notifications",
          "entrypoint": "main",
          "active": true
        },
        "@mesh/glass-dashboard#default": {
          "module": "@mesh/glass-dashboard",
          "entrypoint": "main",
          "active": true
        },
        "@mesh/wallpaper-carousel#default": {
          "module": "@mesh/wallpaper-carousel",
          "entrypoint": "main",
          "active": true
        }
      },
      "providers": {
        "mesh.audio": "@mesh/pipewire-audio",
        "mesh.brightness": "@mesh/backlight-brightness",
        "mesh.media": "@mesh/mpris-media",
        "mesh.weather": "@mesh/open-meteo-weather",
        "mesh.network": "@mesh/networkmanager-network",
        "mesh.apps": "@mesh/hyprland-apps",
        "mesh.recorder": "@mesh/wf-recorder",
        "mesh.notifications": "@mesh/freedesktop-notifications",
        "mesh.system": "@mesh/proc-system",
        "mesh.visualizer": "@mesh/cava-visualizer",
        "mesh.wallpapers": "@mesh/wallpaper-directory"
      },
      "resources": {
        "theme": "@mesh/violet-glass",
        "icons": [
          "@mesh/icons-material-symbols"
        ]
      }
    }
  }
}
