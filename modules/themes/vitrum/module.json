{
  "name": "@mesh/vitrum",
  "version": "0.1.0",
  "description": "Vitrum palette on Material surfaces: violet accent with a mint second hue, solid tonal surfaces and elevation shadows, with dark and light modes.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "theme",
    "contributes": {
      "themes": [
        {
          "id": "vitrum",
          "label": "Vitrum",
          "modes": {
            "light": "light.css",
            "dark": "dark.css"
          },
          "default_mode": "dark",
          "mode_metadata": {
            "light": {
              "color_scheme": "light",
              "contrast": "normal"
            },
            "dark": {
              "color_scheme": "dark",
              "contrast": "normal"
            }
          },
          "tokenContract": "1.1",
          "recommends": {
            "composition": "@mesh/desk",
            "fonts": [
              "Inter",
              "JetBrains Mono",
              "Noto Sans"
            ],
            "icons": [
              "Phosphor",
              "Papirus-Dark",
              "WhiteSur-dark"
            ],
            "compositor_glass": false
          }
        }
      ]
    }
  }
}
