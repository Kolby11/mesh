{
  "name": "@mesh/material",
  "version": "0.1.0",
  "description": "Material theme: solid tonal surfaces, elevation shadows and Material motion, with dark and light modes. No glass effects.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "theme",
    "contributes": {
      "themes": [
        {
          "id": "material",
          "label": "Material",
          "modes": {
            "dark": "dark.css",
            "light": "light.css"
          },
          "default_mode": "dark",
          "mode_metadata": {
            "dark": {
              "color_scheme": "dark",
              "contrast": "normal"
            },
            "light": {
              "color_scheme": "light",
              "contrast": "normal"
            }
          },
          "tokenContract": "1.1",
          "recommends": {
            "composition": "@mesh/desk",
            "fonts": [
              "Inter",
              "Noto Sans"
            ],
            "icons": [
              "Papirus",
              "Adwaita"
            ],
            "compositor_glass": false
          }
        }
      ]
    }
  }
}
