{
  "name": "@mesh/liquid-glass",
  "version": "0.1.0",
  "description": "Liquid glass theme: neutral translucent white glass over a deep blue base, system-blue accents and Inter type.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "theme",
    "contributes": {
      "themes": [
        {
          "id": "liquid-glass",
          "label": "Liquid Glass",
          "modes": {
            "dark": "theme.css"
          },
          "default_mode": "dark",
          "mode_metadata": {
            "dark": {
              "color_scheme": "dark",
              "contrast": "normal"
            }
          },
          "tokenContract": "1.1",
          "recommends": {
            "composition": "@mesh/glass",
            "fonts": [
              "SF Pro Display",
              "SF Pro Text",
              "Inter",
              "Google Sans Flex",
              "Noto Sans"
            ],
            "icons": [
              "WhiteSur-dark",
              "WhiteSur",
              "Papirus-Dark"
            ],
            "compositor_glass": true
          }
        }
      ]
    }
  }
}
