{
  "name": "@mesh/frutiger-aero",
  "version": "0.1.0",
  "description": "Frutiger Aero palette on Material surfaces: sky and aqua blues with grass-green accents, solid tonal surfaces and elevation shadows. Aero Day (light) and Aero Night (dark).",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "theme",
    "contributes": {
      "themes": [
        {
          "id": "frutiger-aero",
          "label": "Frutiger Aero",
          "modes": {
            "light": "light.css",
            "dark": "dark.css"
          },
          "default_mode": "light",
          "mode_metadata": {
            "light": {
              "color_scheme": "light",
              "contrast": "normal"
            },
            "dark": {
              "color_scheme": "dark",
              "contrast": "normal"
            }
          },
          "tokenContract": "1.1",
          "recommends": {
            "composition": "@mesh/desk",
            "fonts": [
              "Frutiger",
              "Segoe UI",
              "Myriad Pro",
              "Noto Sans"
            ],
            "icons": [
              "Papirus",
              "OneUI-light",
              "breeze"
            ],
            "compositor_glass": false
          }
        }
      ]
    }
  }
}
