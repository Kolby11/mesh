{
  "name": "@mesh/nord",
  "version": "0.1.0",
  "description": "Nord theme palette on Material surfaces.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "theme",
    "contributes": {
      "themes": [
        {
          "id": "nord",
          "label": "Nord",
          "modes": {
            "dark": "theme.css"
          },
          "default_mode": "dark",
          "mode_metadata": {
            "dark": {
              "color_scheme": "dark",
              "contrast": "normal"
            }
          },
          "tokenContract": "1.1",
          "recommends": {
            "fonts": [
              "Rubik",
              "Inter",
              "Noto Sans"
            ],
            "icons": [
              "Nordzy-dark",
              "Papirus-Dark"
            ],
            "compositor_glass": false
          }
        }
      ]
    }
  }
}
