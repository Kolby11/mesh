{
  "name": "@mesh/brightness-interface",
  "version": "1.0.0",
  "description": "Standard brightness service contract, independent of its providers.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "interface",
    "interface": {
      "name": "mesh.brightness",
      "version": "1.0",
      "domain": "brightness",
      "relationship": "base",
      "contract": {
        "state": [
          {
            "name": "available",
            "type": "boolean",
            "description": "Whether a controllable display backlight is available"
          },
          {
            "name": "level",
            "type": "float",
            "minimum": 0,
            "maximum": 100,
            "description": "Current display brightness as a percentage (0.0-100.0)"
          }
        ],
        "methods": [
          {
            "name": "set",
            "args": [
              {
                "name": "level",
                "type": "float"
              }
            ],
            "returns": "Result",
            "coalesce": true,
            "stateBinding": {
              "field": "level",
              "fromArg": "level"
            }
          },
          {
            "name": "increase",
            "args": [
              {
                "name": "amount",
                "type": "float"
              }
            ],
            "returns": "Result"
          },
          {
            "name": "decrease",
            "args": [
              {
                "name": "amount",
                "type": "float"
              }
            ],
            "returns": "Result"
          }
        ],
        "events": [
          {
            "name": "BrightnessChanged",
            "payload": [
              {
                "name": "level",
                "type": "float"
              }
            ]
          }
        ],
        "capabilities": {
          "required": [
            "service.brightness.read"
          ],
          "optional": [
            "service.brightness.control"
          ]
        }
      }
    }
  }
}
