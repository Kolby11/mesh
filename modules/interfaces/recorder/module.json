{
  "name": "@mesh/recorder-interface",
  "version": "1.0.0",
  "description": "Standard screen-recording status and control contract.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "interface",
    "interface": {
      "name": "mesh.recorder",
      "version": "1.0",
      "domain": "recorder",
      "relationship": "base",
      "contract": {
        "state": {
          "available": {
            "type": "boolean",
            "description": "Whether a recorder can be started"
          },
          "recording": {
            "type": "boolean",
            "description": "Whether a recording is in progress"
          },
          "started_at": {
            "type": "float",
            "description": "Unix time in seconds the current recording began; 0 when idle"
          },
          "output": {
            "type": "string",
            "description": "Path of the current or last recording"
          }
        },
        "methods": { "toggle": "() -> Result" },
        "events": { "RecordingSaved": { "path": "string" } },
        "capabilities": {
          "required": ["service.recorder.read"],
          "optional": ["service.recorder.control"],
          "methods": { "toggle": ["service.recorder.control"] },
          "permissions": {
            "service.recorder.read": "standard",
            "service.recorder.control": "elevated"
          }
        }
      }
    }
  }
}
