{
  "name": "@mesh/audio-interface",
  "version": "1.0.0",
  "description": "Base audio interface contract for frontend modules and backend providers.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "interface",
    "interface": {
      "name": "mesh.audio",
      "version": "1.0",
      "domain": "audio",
      "relationship": "base",
      "contract": {
        "state": {
          "available": {
            "type": "boolean",
            "description": "Whether the audio service is reachable"
          },
          "percent": {
            "type": "float",
            "minimum": 0,
            "maximum": 100,
            "description": "Current default output volume as a percentage (0.0-100.0)"
          },
          "muted": {
            "type": "boolean",
            "description": "Whether the default output is muted"
          },
          "source_module": {
            "type": "string",
            "description": "Backend module ID that emitted this state (runtime-additive)"
          }
        },
        "methods": {
          "set_volume": {
            "signature": "(device_id: string, percent: float) -> Result",
            "coalesce": { "key": ["device_id"] },
            "stateBinding": { "field": "percent", "fromArg": "percent" }
          },
          "set_muted": {
            "signature": "(device_id: string, muted: boolean) -> Result",
            "coalesce": { "key": ["device_id"] },
            "stateBinding": { "field": "muted", "fromArg": "muted" }
          },
          "volume_up": "()",
          "volume_down": "()",
          "toggle_mute": {
            "signature": "()",
            "stateBinding": { "field": "muted", "toggle": true }
          },
          "play_sound": "(path: string) -> Result"
        },
        "events": { "VolumeChanged": { "device_id": "string", "level": "float" } },
        "types": {
          "Device": {
            "id": "string",
            "name": "string",
            "description": "string",
            "is_default": "boolean",
            "volume": "float",
            "muted": "boolean"
          },
          "Stream": {
            "id": "string",
            "name": "string",
            "application": "string",
            "volume": "float",
            "muted": "boolean"
          }
        },
        "capabilities": {
          "required": ["service.audio.read"],
          "optional": ["service.audio.control"],
          "read": ["service.audio.read"],
          "events": { "VolumeChanged": ["service.audio.read"] },
          "methods": {
            "set_volume": ["service.audio.control"],
            "set_muted": ["service.audio.control"],
            "volume_up": ["service.audio.control"],
            "volume_down": ["service.audio.control"],
            "toggle_mute": ["service.audio.control"],
            "play_sound": ["service.audio.control"]
          }
        }
      }
    }
  }
}
