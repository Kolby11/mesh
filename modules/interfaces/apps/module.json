{
  "name": "@mesh/apps-interface",
  "version": "1.1.0",
  "description": "Standard pinned, running and installed application contract for docks and launchers.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "interface",
    "interface": {
      "name": "mesh.apps",
      "version": "1.1",
      "domain": "apps",
      "relationship": "base",
      "contract": {
        "state": {
          "available": {
            "type": "boolean",
            "description": "Whether application state is reachable"
          },
          "apps": {
            "type": "App[]",
            "description": "Pinned applications in order, followed by running unpinned ones"
          },
          "installed": {
            "type": "App[]",
            "description": "Every launchable desktop entry, sorted by name; empty until indexed"
          }
        },
        "methods": { "activate": "(id: string) -> Result" },
        "events": {},
        "types": {
          "App": {
            "id": "string",
            "name": "string",
            "icon": "string",
            "pinned": "boolean",
            "running": "boolean",
            "focused": "boolean",
            "windows": "int"
          }
        },
        "capabilities": {
          "required": ["service.apps.read"],
          "optional": ["service.apps.launch"],
          "methods": { "activate": ["service.apps.launch"] },
          "permissions": {
            "service.apps.read": "standard",
            "service.apps.launch": "elevated"
          }
        }
      }
    }
  }
}
