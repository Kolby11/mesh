{
  "name": "@mesh/wallpapers-interface",
  "version": "1.1.0",
  "description": "Wallpaper library contract: the images a picker offers. Selecting one is mesh.theme.set_backdrop_image.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "interface",
    "interface": {
      "name": "mesh.wallpapers",
      "version": "1.1",
      "domain": "wallpapers",
      "relationship": "base",
      "contract": {
        "state": {
          "available": {
            "type": "boolean",
            "description": "Whether the wallpaper directory could be read"
          },
          "directory": {
            "type": "string",
            "description": "Absolute path of the wallpaper directory"
          },
          "wallpapers": {
            "type": "Wallpaper[]",
            "description": "Images in the directory, sorted by name"
          }
        },
        "methods": { "refresh": "() -> Result" },
        "events": {},
        "types": {
          "Wallpaper": {
            "path": "string",
            "name": "string",
            "thumbnail": "string",
            "panorama": "string",
            "color": "string"
          }
        },
        "capabilities": {
          "required": ["service.wallpapers.read"],
          "methods": { "refresh": ["service.wallpapers.read"] },
          "permissions": { "service.wallpapers.read": "standard" }
        }
      }
    }
  }
}
