{
  "name": "@mesh/network-interface",
  "version": "1.0.0",
  "description": "Standard network connectivity and Wi-Fi contract, independent of its providers.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "interface",
    "interface": {
      "name": "mesh.network",
      "version": "1.0",
      "domain": "network",
      "relationship": "base",
      "contract": {
        "state": {
          "available": {
            "type": "boolean",
            "description": "Whether the network service is reachable"
          },
          "connectivity": {
            "type": "string",
            "description": "\"full\", \"limited\", \"portal\" or \"none\""
          },
          "kind": {
            "type": "string",
            "description": "Primary connection kind: \"wifi\", \"ethernet\" or \"none\""
          },
          "wifi_enabled": {
            "type": "boolean",
            "description": "Whether the Wi-Fi radio is on"
          },
          "ssid": {
            "type": "string",
            "description": "Connected Wi-Fi network name; empty when none"
          },
          "signal": {
            "type": "int",
            "minimum": 0,
            "maximum": 100,
            "description": "Connected Wi-Fi signal strength percentage"
          },
          "interface_name": {
            "type": "string",
            "description": "Device of the primary connection"
          },
          "networks": {
            "type": "WifiNetwork[]",
            "description": "Visible Wi-Fi networks from the last scan"
          }
        },
        "methods": {
          "set_wifi_enabled": {
            "signature": "(enabled: boolean) -> Result",
            "stateBinding": { "field": "wifi_enabled", "fromArg": "enabled" }
          },
          "scan": "() -> Result",
          "connect": "(id: string) -> Result"
        },
        "events": {},
        "types": {
          "WifiNetwork": {
            "id": "string",
            "ssid": "string",
            "signal": "int",
            "secured": "boolean",
            "connected": "boolean"
          }
        },
        "capabilities": {
          "required": ["service.network.read"],
          "optional": ["service.network.control"]
        }
      }
    }
  }
}
