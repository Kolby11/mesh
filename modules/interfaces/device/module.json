{
  "name": "@mesh/device-interface",
  "version": "1.0.0",
  "description": "Base device-information interface for settings and system surfaces.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "interface",
    "interface": {
      "name": "mesh.device",
      "version": "1.0",
      "domain": "device",
      "relationship": "base",
      "contract": {
        "state": {
          "available": {
            "type": "boolean",
            "description": "Whether a device-information provider can report system details"
          },
          "hostname": { "type": "string", "description": "Local system hostname" },
          "os_name": {
            "type": "string",
            "description": "Operating-system or distribution name"
          },
          "os_version": {
            "type": "string",
            "description": "Operating-system or distribution version"
          },
          "kernel": { "type": "string", "description": "Running kernel release" },
          "architecture": {
            "type": "string",
            "description": "Kernel-reported machine architecture"
          },
          "desktop": {
            "type": "string",
            "description": "Desktop environment or session name"
          },
          "processor": {
            "type": "string",
            "description": "Human-readable processor model"
          },
          "memory_total_bytes": {
            "type": "int",
            "minimum": 0,
            "description": "Total physical memory in bytes"
          },
          "graphics": {
            "type": "string",
            "description": "Human-readable primary graphics adapter when available"
          },
          "uptime_seconds": {
            "type": "int",
            "minimum": 0,
            "description": "System uptime in seconds"
          },
          "source_module": {
            "type": "string",
            "description": "Backend module ID that emitted this state (runtime-additive)"
          }
        },
        "capabilities": {
          "required": ["service.device.read"],
          "read": ["service.device.read"]
        }
      }
    }
  }
}
