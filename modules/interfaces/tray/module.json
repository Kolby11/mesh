{
  "name": "@mesh/tray-interface",
  "version": "2.0.0",
  "description": "StatusNotifier tray items and activation controls.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "interface",
    "interface": {
      "name": "mesh.tray",
      "version": "2.0",
      "domain": "tray",
      "relationship": "base",
      "contract": {
        "state": { "available": "boolean", "items": "Item[]" },
        "methods": {
          "activate": "(id: string, x: int, y: int) -> Result",
          "secondary_activate": "(id: string, x: int, y: int) -> Result",
          "context_menu": "(id: string, x: int, y: int) -> Result",
          "scroll": "(id: string, delta: int, orientation: string) -> Result"
        },
        "events": {},
        "types": {
          "Item": {
            "id": "string",
            "title": "string",
            "application_id": "string",
            "category": "string",
            "status": "string",
            "icon_name": "string",
            "attention_icon_name": "string",
            "overlay_icon_name": "string",
            "icon_theme_path": "string",
            "tooltip_title": "string",
            "tooltip_text": "string",
            "item_is_menu": "boolean",
            "menu": "string",
            "icon_pixmap": "blob?"
          },
          "Result": { "ok": "boolean", "error": "string" }
        },
        "capabilities": {
          "read": ["service.tray.read"],
          "methods": {
            "activate": ["service.tray.control"],
            "secondary_activate": ["service.tray.control"],
            "context_menu": ["service.tray.control"],
            "scroll": ["service.tray.control"]
          },
          "permissions": {
            "service.tray.read": "standard",
            "service.tray.control": "standard"
          }
        }
      }
    }
  }
}
