{
  "name": "@mesh/media-interface",
  "version": "1.0.0",
  "description": "Standard now-playing media contract (MPRIS-shaped), independent of its providers.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "interface",
    "interface": {
      "name": "mesh.media",
      "version": "1.0",
      "domain": "media",
      "relationship": "base",
      "contract": {
        "state": {
          "available": {
            "type": "boolean",
            "description": "Whether a media player is reachable"
          },
          "state": {
            "type": "string",
            "description": "\"playing\", \"paused\" or \"stopped\""
          },
          "player": {
            "type": "string",
            "description": "Identity of the controlled player; empty when none"
          },
          "title": {
            "type": "string",
            "description": "Track title; empty when unknown"
          },
          "artist": {
            "type": "string",
            "description": "Track artist; empty when unknown"
          },
          "album": {
            "type": "string",
            "description": "Track album; empty when unknown"
          },
          "art_path": {
            "type": "string",
            "description": "Absolute local path of the cover art; empty when none"
          },
          "position": {
            "type": "float",
            "minimum": 0,
            "description": "Playback position in seconds when the state was published"
          },
          "length": {
            "type": "float",
            "minimum": 0,
            "description": "Track length in seconds; 0 when unknown"
          },
          "updated_at": {
            "type": "float",
            "description": "Unix time in seconds at which position was sampled, so consumers can extrapolate while playing"
          }
        },
        "methods": {
          "play_pause": "() -> Result",
          "next": "() -> Result",
          "previous": "() -> Result",
          "seek": {
            "signature": "(position: float) -> Result",
            "coalesce": { "key": [] },
            "stateBinding": { "field": "position", "fromArg": "position" }
          }
        },
        "events": { "TrackChanged": { "title": "string", "artist": "string" } },
        "capabilities": {
          "required": ["service.media.read"],
          "optional": ["service.media.control"]
        }
      }
    }
  }
}
