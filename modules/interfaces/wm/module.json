{
  "name": "@mesh/wm-interface",
  "version": "1.1.0",
  "description": "Standard wm service contract, independent of its providers.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "interface",
    "interface": {
      "name": "mesh.wm",
      "version": "1.1",
      "domain": "wm",
      "relationship": "base",
      "contract": {
        "state": {
          "available": {
            "type": "boolean",
            "description": "Whether the compositor is running and reachable"
          },
          "active_workspace": {
            "type": "int",
            "description": "Provider-local ID of the globally focused workspace, not its display index; meaningful when available."
          },
          "active_window": {
            "type": "object?",
            "description": "Focused window summary: title, app_id and/or class when supplied; nil when no window has focus."
          },
          "workspaces": {
            "type": "Workspace[]",
            "description": "List of known workspaces"
          }
        },
        "methods": {
          "focus_workspace": {
            "signature": "(id: int) -> Result",
            "stateBinding": { "field": "active_workspace", "fromArg": "id" }
          }
        },
        "events": {
          "WorkspaceChanged": { "id": "int", "name": "string" },
          "WindowChanged": { "title": "string", "class": "string" }
        },
        "types": {
          "Workspace": {
            "id": "int",
            "name": "string",
            "windows": "int",
            "index": "int?",
            "output": "string?",
            "visible": "boolean?",
            "focused": "boolean?",
            "urgent": "boolean?"
          }
        },
        "capabilities": {
          "required": ["service.wm.read"],
          "optional": ["service.wm.control"]
        }
      }
    }
  }
}
