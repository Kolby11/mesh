{
  "name": "@mesh/mpris-media",
  "version": "0.1.0",
  "description": "MPRIS now-playing provider over playerctl, with remote cover art cached locally.",
  "private": true,
  "mesh": {
    "apiVersion": "0.1",
    "kind": "backend",
    "uses": {
      "capabilities": [
        "exec.argv:playerctl:[\"--follow\",\"metadata\",\"--format\",\"*\"]",
        "exec.argv:playerctl:[\"metadata\",\"--format\",\"*\"]",
        "exec.argv:playerctl:[\"play-pause\"]",
        "exec.argv:playerctl:[\"next\"]",
        "exec.argv:playerctl:[\"previous\"]",
        "exec.argv:playerctl:[\"position\",\"*\"]",
        "exec.argv:playerctl:[\"--follow\",\"status\"]",
        "exec.argv:playerctl:[\"--player\",\"*\",\"metadata\",\"--format\",\"*\"]",
        "exec.argv:playerctl:[\"--player\",\"*\",\"play-pause\"]",
        "exec.argv:playerctl:[\"--player\",\"*\",\"next\"]",
        "exec.argv:playerctl:[\"--player\",\"*\",\"previous\"]",
        "exec.argv:playerctl:[\"--player\",\"*\",\"position\",\"*\"]"
      ],
      "optionalCapabilities": [
        "net.http"
      ],
      "binaries": [
        {
          "name": "playerctl",
          "reason": "Read and control MPRIS media players.",
          "packages": {
            "arch": "playerctl",
            "debian": "playerctl",
            "fedora": "playerctl",
            "nixos": "playerctl"
          }
        }
      ],
      "modules": {
        "@mesh/media-interface": "^1.0.0"
      }
    },
    "entry": "src/main.luau",
    "implements": [
      {
        "interface": "mesh.media",
        "version": "1.0",
        "provider": "mpris",
        "label": "MPRIS (playerctl)",
        "priority": 100
      }
    ]
  }
}
