{
  "name": "@mesh/hyprland-wm",
  "version": "0.1.0",
  "description": "Hyprland compositor backend \u2014 workspace state over ext-workspace, window state over Hyprland's IPC sockets.",
  "private": true,
  "mesh": {
    "apiVersion": "0.1",
    "kind": "backend",
    "uses": {
      "capabilities": [
        "exec.argv:hyprctl:[\"activewindow\",\"-j\"]",
        "exec.argv:hyprctl:[\"dispatch\",\"hl.dsp.focus({ workspace = \\\"*\\\" })\"]",
        "exec.argv:hyprctl:[\"dispatch\",\"workspace\",\"*\"]",
        "exec.argv:hyprctl:[\"instances\",\"-j\"]",
        "exec.argv:sh:[\"-c\",\"printf '%s' \\\"$HYPRLAND_INSTANCE_SIGNATURE\\\"\"]",
        "exec.argv:sh:[\"-c\",\"printf '%s' \\\"${XDG_RUNTIME_DIR:-/run/user/$(id -u)}\\\"\"]",
        "exec.argv:sh:[\"-c\",\"test -S \\\"$1\\\" && echo ok\",\"sh\",\"*\"]",
        "wayland.observe"
      ],
      "optionalCapabilities": [
        "net.socket",
        "exec.argv:nc:[\"-U\",\"*\"]",
        "exec.argv:socat:[\"-\",\"UNIX-CONNECT:*\"]"
      ],
      "binaries": [
        {
          "name": "hyprctl",
          "reason": "Dispatch workspace switches, and query the active window when native socket access is not granted.",
          "packages": {
            "arch": "hyprland",
            "nixos": "hyprland"
          }
        },
        {
          "name": "socat",
          "reason": "Stream Hyprland IPC events when native socket access is not granted (preferred over nc).",
          "optional": true,
          "packages": {
            "debian": "socat",
            "arch": "socat",
            "fedora": "socat",
            "nixos": "socat"
          }
        },
        {
          "name": "nc",
          "reason": "Fallback stream reader for the Hyprland event socket when socat is not available.",
          "optional": true,
          "packages": {
            "debian": "netcat-openbsd",
            "arch": "openbsd-netcat",
            "fedora": "nmap-ncat",
            "nixos": "netcat-openbsd"
          }
        }
      ],
      "modules": {
        "@mesh/wm-interface": "^1.1.0"
      }
    },
    "i18n": {
      "defaultLocale": "en",
      "supportedLocales": [
        "en"
      ]
    },
    "entry": "src/main.luau",
    "implements": [
      {
        "interface": "mesh.wm",
        "version": "1.1",
        "provider": "hyprland",
        "label": "Hyprland",
        "priority": 100
      }
    ]
  }
}
