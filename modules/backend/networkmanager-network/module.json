{
  "name": "@mesh/networkmanager-network",
  "version": "0.1.0",
  "description": "NetworkManager provider: connectivity, primary connection and Wi-Fi networks read over D-Bus; nmcli for controls.",
  "private": true,
  "mesh": {
    "apiVersion": "0.1",
    "kind": "backend",
    "uses": {
      "capabilities": [
        "dbus.read:system:org.freedesktop.NetworkManager:org.freedesktop.NetworkManager",
        "dbus.read:system:org.freedesktop.NetworkManager:org.freedesktop.NetworkManager.Device",
        "dbus.read:system:org.freedesktop.NetworkManager:org.freedesktop.NetworkManager.Device.Wireless",
        "dbus.read:system:org.freedesktop.NetworkManager:org.freedesktop.NetworkManager.AccessPoint",
        "dbus.subscribe:system:org.freedesktop.NetworkManager"
      ],
      "optionalCapabilities": [
        "exec.argv:nmcli:[\"radio\",\"wifi\",\"*\"]",
        "exec.argv:nmcli:[\"device\",\"wifi\",\"rescan\"]",
        "exec.argv:nmcli:[\"device\",\"wifi\",\"connect\",\"*\"]"
      ],
      "binaries": [
        {
          "name": "nmcli",
          "reason": "Control NetworkManager: Wi-Fi radio, scans and connections.",
          "packages": {
            "arch": "networkmanager",
            "debian": "network-manager",
            "fedora": "NetworkManager",
            "nixos": "networkmanager"
          }
        }
      ],
      "modules": {
        "@mesh/network-interface": "^1.0.0"
      }
    },
    "entry": "src/main.luau",
    "implements": [
      {
        "interface": "mesh.network",
        "version": "1.0",
        "provider": "networkmanager",
        "label": "NetworkManager",
        "priority": 100
      }
    ]
  }
}
