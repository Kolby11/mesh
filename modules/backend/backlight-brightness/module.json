{
  "name": "@mesh/backlight-brightness",
  "version": "0.1.0",
  "description": "Display backlight backend using brightnessctl.",
  "private": true,
  "mesh": {
    "apiVersion": "0.1",
    "kind": "backend",
    "uses": {
      "capabilities": [
        "exec.argv:brightnessctl:[\"-m\"]",
        "exec.argv:brightnessctl:[\"set\",\"*\"]"
      ],
      "optionalCapabilities": [
        "fs.watch"
      ],
      "binaries": [
        {
          "name": "brightnessctl",
          "reason": "Read and control the active display backlight.",
          "packages": {
            "debian": "brightnessctl",
            "arch": "brightnessctl",
            "fedora": "brightnessctl",
            "nixos": "brightnessctl"
          }
        }
      ],
      "modules": {
        "@mesh/brightness-interface": "^1.0.0"
      }
    },
    "i18n": {
      "defaultLocale": "en",
      "supportedLocales": [
        "en"
      ]
    },
    "entry": "src/main.luau",
    "implements": [
      {
        "interface": "mesh.brightness",
        "version": "1.0",
        "provider": "brightnessctl",
        "label": "Display backlight",
        "priority": 100
      }
    ]
  }
}
