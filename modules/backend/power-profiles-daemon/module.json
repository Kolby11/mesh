{
  "name": "@mesh/power-profiles-daemon",
  "version": "0.1.0",
  "description": "Power profiles through power-profiles-daemon.",
  "private": true,
  "mesh": {
    "apiVersion": "0.1",
    "kind": "backend",
    "uses": {
      "capabilities": [
        "dbus.subscribe:system:net.hadess.PowerProfiles",
        "exec.argv:powerprofilesctl:[\"get\"]",
        "exec.argv:powerprofilesctl:[\"list\"]",
        "exec.argv:powerprofilesctl:[\"set\",\"*\"]"
      ],
      "binaries": [
        {
          "name": "powerprofilesctl",
          "reason": "Read and set the platform power profile.",
          "packages": {
            "arch": "power-profiles-daemon",
            "debian": "power-profiles-daemon",
            "fedora": "power-profiles-daemon",
            "nixos": "power-profiles-daemon"
          }
        }
      ],
      "modules": {
        "@mesh/power-profile-interface": "^1.0.0"
      }
    },
    "i18n": {
      "defaultLocale": "en",
      "supportedLocales": [
        "en"
      ]
    },
    "entry": "src/main.luau",
    "implements": [
      {
        "interface": "mesh.power-profile",
        "version": "1.0",
        "provider": "power-profiles-daemon",
        "label": "power-profiles-daemon",
        "priority": 100
      }
    ]
  }
}
