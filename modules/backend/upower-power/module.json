{
  "name": "@mesh/upower-power",
  "version": "0.1.0",
  "description": "Power/battery backend reading state via the upower CLI.",
  "private": true,
  "mesh": {
    "apiVersion": "0.1",
    "kind": "backend",
    "uses": {
      "capabilities": [
        "exec.argv:upower:[\"-e\"]",
        "exec.argv:upower:[\"-i\",\"*\"]"
      ],
      "optionalCapabilities": [
        "exec.argv:upower:[\"--monitor\"]"
      ],
      "binaries": [
        {
          "name": "upower",
          "reason": "Battery state, charge level, and rate.",
          "packages": {
            "debian": "upower",
            "arch": "upower",
            "fedora": "upower",
            "nixos": "upower"
          }
        }
      ],
      "modules": {
        "@mesh/power-interface": "^1.0.0"
      }
    },
    "i18n": {
      "defaultLocale": "en",
      "supportedLocales": [
        "en"
      ]
    },
    "entry": "src/main.luau",
    "implements": [
      {
        "interface": "mesh.power",
        "version": "1.0",
        "provider": "upower",
        "label": "UPower",
        "priority": 100
      }
    ]
  }
}
