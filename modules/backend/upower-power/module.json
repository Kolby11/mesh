{
  "name": "@mesh/upower-power",
  "version": "0.1.0",
  "description": "Power/battery backend reading UPower over D-Bus.",
  "private": true,
  "mesh": {
    "apiVersion": "0.1",
    "kind": "backend",
    "uses": {
      "capabilities": [
        "dbus.read:system:org.freedesktop.UPower:org.freedesktop.UPower.Device",
        "dbus.subscribe:system:org.freedesktop.UPower"
      ],
      "modules": {
        "@mesh/power-interface": "^1.0.0"
      }
    },
    "i18n": {
      "defaultLocale": "en",
      "supportedLocales": [
        "en"
      ]
    },
    "entry": "src/main.luau",
    "implements": [
      {
        "interface": "mesh.power",
        "version": "1.0",
        "provider": "upower",
        "label": "UPower",
        "priority": 100
      }
    ]
  }
}
