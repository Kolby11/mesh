{
  "name": "@mesh/glass-wallpapers",
  "version": "0.1.0",
  "description": "Liquid-glass wallpaper picker: a tilted carousel of your wallpapers with a colour strip; choosing one changes the backdrop every glass surface refracts.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "ui",
    "uses": {
      "interfaces": {
        "mesh.theme": ">=1.0",
        "mesh.wallpapers": ">=1.0"
      },
      "modules": {
        "@mesh/glass-material": ">=0.1.0"
      },
      "resources": {
        "icons": [
          "@mesh/icons-material-symbols"
        ]
      },
      "capabilities": [
        "shell.surface",
        "theme.read",
        "locale.read",
        "service.theme.control",
        "service.wallpapers.read"
      ]
    },
    "entry": "src/main.mesh",
    "surface": {
      "anchor": "top",
      "layer": "overlay",
      "keyboard_mode": "exclusive",
      "visible_on_start": false
    },
    "provides": {
      "layout": [
        {
          "id": "main",
          "entrypoint": "src/main.mesh",
          "label": "Glass wallpaper picker"
        }
      ]
    },
    "accessibility": {
      "role": "dialog"
    },
    "i18n": {
      "defaultLocale": "en"
    },
    "contributes": {
      "i18n": [
        { "id": "en", "locale": "en", "path": "config/i18n/en.json" },
        { "id": "sk", "locale": "sk", "path": "config/i18n/sk.json" }
      ],
      "keybinds": {
        "close": {
          "label": { "t": "keybind.close", "fallback": "Close wallpaper picker" },
          "category": { "t": "keybind.category", "fallback": "Wallpapers" },
          "trigger": { "kind": "shortcut", "key": "Escape" }
        },
        "previous": {
          "label": { "t": "keybind.previous", "fallback": "Previous wallpaper" },
          "category": { "t": "keybind.category", "fallback": "Wallpapers" },
          "trigger": { "kind": "shortcut", "key": "ArrowLeft" }
        },
        "next": {
          "label": { "t": "keybind.next", "fallback": "Next wallpaper" },
          "category": { "t": "keybind.category", "fallback": "Wallpapers" },
          "trigger": { "kind": "shortcut", "key": "ArrowRight" }
        },
        "apply": {
          "label": { "t": "keybind.apply", "fallback": "Use this wallpaper" },
          "category": { "t": "keybind.category", "fallback": "Wallpapers" },
          "trigger": { "kind": "shortcut", "key": "Enter" }
        }
      }
    }
  }
}
