{
  "name": "@mesh/debug-inspector",
  "version": "0.1.0",
  "description": "Shell-shipped debug inspector surface for profiling and live shell diagnostics.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "ui",
    "uses": {
      "interfaces": {
        "mesh.debug": ">=1.0"
      },
      "capabilities": [
        "shell.surface",
        "service.debug.read",
        "service.debug.control",
        "locale.read"
      ],
      "modules": {
        "@mesh/glass-material": ">=0.1.0"
      }
    },
    "entry": "src/main.mesh",
    "surface": {
      "role": "window",
      "title": "MESH Debug Inspector",
      "appId": "mesh.debug-inspector",
      "resizable": true,
      "visible_on_start": false
    },
    "accessibility": {
      "role": "dialog",
      "label": "Debug inspector",
      "description": "Debug-only profiling and shell inspection panel"
    },
    "contributes": {
      "keybinds": {
        "next-view": {
          "label": "Next inspector view",
          "description": "Show the next debug inspector view",
          "category": "Developer tools",
          "trigger": {
            "kind": "shortcut",
            "key": "Tab",
            "modifiers": [
              "ctrl"
            ]
          }
        }
      }
    }
  }
}
