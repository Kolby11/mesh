<template>
  <row class="workspace-list" onpointerleave={onWorkspaceLeave}>
    <box class="ws-active-trail" hidden={not active_visible} style:transform={"translateX(" .. active_offset .. "px)"} aria-hidden="true" />
    <box class="ws-hover" class:ws-hover-visible={hover_visible} style:transform={"translateX(" .. hover_offset .. "px)"} aria-hidden="true" />
    <box class="ws-active-indicator" hidden={not active_visible} style:transform={"translateX(" .. active_offset .. "px)"} aria-hidden="true" />
    {#for workspace in workspace_items key={workspace.id}}
      <button class="ws-btn" class:ws-btn-active={ws_active == workspace.id} onclick={onSwitch(workspace.id)} onpointerenter={onWorkspaceEnter(workspace.slot)} title={workspace.label} aria-label={workspace.label}>
        <text class="ws-num">{workspace.label}</text>
      </button>
    {/for}
  </row>
</template>

<script lang="luau">
local wm = require("mesh.wm")
workspace_items = {}
ws_active = nil
active_visible = false
active_offset = 0
hover_offset = 0
hover_visible = false

local WS_SLOT_STRIDE = 26

local function select_indicator(id)
    ws_active = id
    active_visible = false
    for _, workspace in workspace_items do
        if workspace.id == id then
            active_visible = true
            active_offset = (workspace.slot - 1) * WS_SLOT_STRIDE
            break
        end
    end
end

effect(function()
    local items = {}
    if wm.available then
        for _, workspace in wm.workspaces do
            items[#items + 1] = {
                id = workspace.id,
                label = workspace.name ~= "" and workspace.name or tostring(workspace.id),
                slot = #items + 1,
            }
        end
    end
    workspace_items = items
    select_indicator(wm.active_workspace)
end)

function onWorkspaceEnter(slot)
    hover_offset = (slot - 1) * WS_SLOT_STRIDE
    hover_visible = true
end

function onWorkspaceLeave()
    hover_visible = false
end

function onSwitch(id)
    select_indicator(id)
    wm.focus_workspace(id)
end
</script>

<style>
/* The pills stay px, not container-derived: the sliding indicator is placed by
a translateX the script computes, so its stride needs a number both sides
agree on. `WS_SLOT_STRIDE` in the script is this width plus the gap. */
.workspace-list {
    position: relative;
    height: 24px;
    align-items: center;
    gap: 2px;
    flex-shrink: 0;
    /* The indicator and trail below are out of flow, so they neither size this
    row nor stop at its edge. Clipping here is what actually keeps them inside
    the workspace strip instead of painting over the next region. */
    overflow-x: hidden;
    overflow-y: hidden;
}

.ws-active-indicator {
    position: absolute;
    top: 2px;
    left: 0px;
    width: 24px;
    height: 24px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    z-index: 1;
    transition: transform var(--animation-duration-medium) var(--animation-curves-bezier-emphasized-decelerate);
}

.ws-active-trail {
    position: absolute;
    top: 2px;
    left: 0px;
    width: 24px;
    height: 24px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    opacity: 0.28;
    z-index: 0;
    transition-property: transform, opacity;
    transition-duration: var(--animation-duration-long);
    transition-timing-function: var(--animation-curves-bezier-emphasized-decelerate);
}

.ws-btn {
    width: 24px;
    height: 24px;
    justify-content: center;
    align-items: center;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-on-surface-variant);
    border-width: 2px;
    border-style: solid;
    border-color: transparent;
    transform: scale(1);
    z-index: 2;
    transition-property: color, border-color, transform;
    transition-duration: var(--animation-duration-medium);
    transition-timing-function: var(--animation-curves-bezier-standard);
}

/* Hover reads as the pill sliding under the number, not as the number itself
changing, so the whole row feels like one moving surface. */
.ws-hover {
    position: absolute;
    top: 2px;
    left: 0px;
    width: 24px;
    height: 24px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    opacity: 0;
    z-index: 0;
    transition-property: transform, opacity;
    transition-duration: var(--animation-duration-medium);
    transition-timing-function: var(--animation-curves-bezier-emphasized-decelerate);
}

.ws-hover-visible {
    opacity: 0.16;
}

.ws-btn:hover {
    color: var(--color-on-surface);
}

.ws-btn:focus-visible {
    color: var(--color-on-surface);
    border-color: var(--color-primary);
}

.ws-btn:active {
    transform: scale(0.9);
}

.ws-btn-active,
.ws-btn-active:hover {
    color: var(--color-on-primary);
}

.ws-num {
    font-size: 11px;
    font-weight: 600;
    color: inherit;
}

@container (max-width: 560px) {
    .workspace-list {
        display: none;
    }
}
</style>
