<template>
    <stack class="nav-button-shell">
        <button
            ref="themeButton"
            class="theme-trigger"
            aria-haspopup="true"
            title={t(theme_tooltip_key)}
            aria-label={t(theme_tooltip_key)}
        >
            <icon class="theme-trigger-glyph" name={theme_icon} size="18" />
        </button>
        <ThemeSelector bind:this={theme_popover} />
    </stack>
</template>

<script lang="luau">
local t = import("mesh.i18n", "t")
local ThemeSelector = require("@mesh/theme-selector")

theme_icon = "weather-clear-night"
theme_tooltip_key = "nav.select_theme"

theme_popover = nil

local theme = require("mesh.theme")

effect(function()
    theme_icon = theme.is_dark ~= false and "weather-clear-night" or "weather-clear"
end)
</script>

<style>
    .nav-button-shell {
        height: 100%;
        aspect-ratio: 1;
        flex-shrink: 0;
        justify-content: center;
        align-items: center;
        position: relative;
        overflow: visible;
    }

    .theme-trigger {
        height: 100%;
        width: 100%;
        flex-shrink: 0;
        justify-content: center;
        align-items: center;
        padding: 0;
        border-radius: var(--radius-full);
        background: transparent;
        color: var(--color-on-surface-variant);
        border-width: 2px;
        border-style: solid;
        border-color: transparent;
        transform: scale(1);
        text-wrap: none;
        position: relative;
        z-index: 3;
        transition-property: color, border-color, transform;
        transition-duration: var(--animation-duration-medium);
        transition-timing-function: var(--animation-curves-bezier-standard);
    }

    .theme-trigger:hover {
        color: var(--color-on-surface);
        transform: scale(1.12);
    }

    /* Keyboard only. A pointer press on a button never sets `focus-visible`,
    so clicking leaves no ring behind — only tabbing to the control does. */
    .theme-trigger:focus-visible {
        color: var(--color-on-surface);
    }

    .theme-trigger:active {
        color: var(--color-primary);
        transform: scale(0.9);
    }

    /* Popover open reads through the glyph, not a ring: no border may appear
    from a pointer interaction. */
    .theme-trigger:expanded,
    .theme-trigger:expanded:hover,
    .theme-trigger:expanded:focus-visible {
        color: var(--color-primary);
    }

    .theme-trigger-glyph {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
        justify-content: center;
        align-items: center;
        color: inherit;
        transition: color var(--animation-duration-medium) var(--animation-curves-bezier-standard);
    }
</style>
