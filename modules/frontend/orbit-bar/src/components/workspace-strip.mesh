<template><row class="strip">{#for item in items key={item.id}}<button class="slot" class:active={item.active} onclick={switchWorkspace(item.id)} aria-label={item.label}><text class="number">{item.label}</text></button>{/for}</row></template>
<script lang="luau">
local wm = require("mesh.wm")
items = {}
effect(function() local list = {} for id = 1, 5 do list[#list + 1] = { id = id, label = tostring(id), active = wm.available and wm.active_workspace == id } end items = list end)
function switchWorkspace(id) wm.focus_workspace(id) end
</script>
<style>
.strip { margin-top: 6px; padding: 4px; gap: 2px; border-radius: 999px; background: var(--color-surface); }
.slot { width: 24px; height: 24px; padding: 0; align-items: center; justify-content: center; border-radius: 999px; background: transparent; color: var(--color-on-surface-variant); }
.active { background: var(--color-primary); color: var(--color-on-primary); }
.number { font-size: 10px; color: inherit; }
</style>
