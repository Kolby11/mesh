{
  "name": "@mesh/brightness-widget",
  "version": "0.1.0",
  "description": "Display brightness control for any navigation bar.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "ui",
    "uses": {
      "optionalInterfaces": {
        "mesh.brightness": ">=1.0"
      },
      "resources": {
        "icons": [
          "@mesh/icons-material-symbols"
        ]
      },
      "capabilities": [
        "service.brightness.read",
        "service.brightness.control",
        "locale.read"
      ]
    },
    "i18n": {
      "defaultLocale": "en"
    },
    "icons": {
      "ignore_shell_default": true
    },
    "iconRequirements": {
      "required": [
        "display-brightness-off",
        "display-brightness-low",
        "display-brightness-medium",
        "display-brightness-high"
      ]
    },
    "entry": "src/main.mesh",
    "contributes": {
      "i18n": [
        {
          "id": "en",
          "locale": "en",
          "path": "config/i18n/en.json"
        },
        {
          "id": "sk",
          "locale": "sk",
          "path": "config/i18n/sk.json"
        }
      ]
    },
    "provides": {
      "extensionPoints": {
        "mesh.navigation.item": [
          {
            "id": "brightness",
            "entry": "src/main.mesh"
          }
        ]
      }
    },
    "accessibility": {
      "role": "button"
    }
  }
}
