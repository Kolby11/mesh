<props>
blur_enabled:    { type: "bool", default: true, label: "Backdrop blur" }
blur_radius:     { type: "size", default: "var(--effect-backdrop-blur-surface-radius)", label: "Blur radius" }
blur_background: { type: "color", default: "var(--effect-backdrop-blur-surface-background)", label: "Frosted background" }
corner_radius:   { type: "size", default: "var(--radius-lg)", label: "Corner radius" }
</props>

<template>
    <row class={props.blur_enabled and "nav-shell nav-shell-blur" or "nav-shell"}>
        <row class="status-cluster">
            <slot name="start" extension-point="mesh.navigation.item" mode="customizable" />
        </row>

        <row class="center-cluster">
            <slot name="center" extension-point="mesh.navigation.item" mode="customizable" />
        </row>

        <row ref="control-cluster" class="right-cluster">
            <slot name="end" extension-point="mesh.navigation.item" mode="customizable" />
        </row>
    </row>
</template>

<script lang="luau">
-- Navigation items are public alternate-root contributions selected by the
-- active composition. This root owns only the three author-declared regions.
</script>

<style>
    .nav-shell {
        width: 100%;
        height: 40px;
        margin: 8px 8px 0;
        container-type: inline-size;
        justify-content: space-between;
        align-items: center;
        gap: var(--spacing-md);
        padding-inline: var(--spacing-lg);
        /* The one place control size is decided: the block padding leaves the
        cluster row its height, and every control derives from that. */
        padding-block: 6px;
        overflow-x: hidden;
        overflow-y: hidden;
        background-color: prop(blur_background);
        border-radius: prop(corner_radius);
        color: var(--color-on-surface);
        transition-property: background-color, color, gap;
        transition-duration: var(--animation-duration-medium);
        transition-timing-function: var(--animation-curves-bezier-standard);
    }

    .nav-shell-blur {
        backdrop-filter: blur(prop(blur_radius));
    }

    /* Three equal regions, so the center one is the middle of the bar however
    wide the side content gets. Without this the clock only lands in the middle
    when both sides happen to measure the same. */
    .status-cluster,
    .center-cluster,
    .right-cluster {
        height: 100%;
        flex-grow: 1;
        flex-basis: 0;
        min-width: 0;
        align-items: center;
        transition: gap var(--animation-duration-medium) var(--animation-curves-bezier-standard);
    }

    .status-cluster {
        justify-content: flex-start;
        gap: var(--spacing-sm);
    }

    .center-cluster {
        justify-content: center;
        gap: var(--spacing-sm);
    }

    .right-cluster {
        justify-content: flex-end;
        gap: 2px;
    }

    @container (max-width: 860px) {
        .nav-shell {
            gap: var(--spacing-sm);
        }
    }

    @container (max-width: 720px) {
        .nav-shell {
            gap: var(--spacing-sm);
            padding-inline: var(--spacing-md);
        }

        .right-cluster {
            gap: 1px;
        }
    }
</style>
