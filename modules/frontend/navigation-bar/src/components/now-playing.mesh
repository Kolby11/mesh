<template>
  <row class="now-playing" hidden={not isPlaying()}>
    <icon class="np-icon" name="media-playback-start" size="12" />
    <text class="np-text">{trackName()}</text>
  </row>
</template>

<script lang="luau">
local media = require("mesh.media")

local function isPlaying()
    return media.available and media.state == "playing" and (media.title or "") ~= ""
end

local function trackName()
    if not media.available then return "" end
    local title = media.title or ""
    if title == "" then return "" end
    local artist = media.artist or ""
    local full = artist ~= "" and (artist .. " — " .. title) or title
    return #full > 38 and (string.sub(full, 1, 36) .. "…") or full
end
</script>

<style>
.now-playing {
    align-items: center;
    gap: 5px;
    min-width: 0;
    max-width: 200px;
    flex-shrink: 1;
    padding-inline: var(--spacing-sm);
    height: 32px;
    border-radius: var(--radius-full);
    background: var(--color-surface-container);
    transition: background-color var(--animation-duration-short) var(--animation-curves-bezier-standard);
}

.now-playing:hover {
    background: var(--color-surface-container-high);
}

.np-icon {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    color: var(--color-primary);
}

.np-text {
    color: var(--color-on-surface);
    font-size: var(--typography-size-xs);
    font-weight: 500;
    text-wrap: none;
}

@container (max-width: 860px) {
    .now-playing {
        max-width: 140px;
    }
}

@container (max-width: 720px) {
    .now-playing {
        display: none;
    }
}
</style>
