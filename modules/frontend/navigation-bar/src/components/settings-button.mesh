<template>
  <stack class="nav-button-shell">
    <button
      ref="settingsButton"
      class="nav-button"
      onclick={onOpenSettings}
      aria-haspopup="true"
      title={t('nav.open_settings')}
      aria-label={t('nav.open_settings')}
    >
      <icon class="nav-button-glyph" name="preferences-system" size="18" />
    </button>
    <QuickSettings bind:this={quick_settings} />
  </stack>
</template>

<script lang="luau">
local t = import("mesh.i18n", "t")
local QuickSettings = require("@mesh/quick-settings")

quick_settings = nil

function onOpenSettings()
    -- A click is the explicit path into the full settings application; the
    -- hover-opened Quick Settings popup is the lightweight surface. Hover only
    -- reopens it on the next pointer entry, so it stays closed under the cursor.
    mesh.shell.show_surface("@mesh/settings")
    if quick_settings ~= nil then
        quick_settings.open = false
    end
    -- Settings owns focus once its window opens. Leaving focus on the launcher
    -- makes it look permanently active while the separate window is visible.
    refs.settingsButton:blur()
end
</script>

<style>
.nav-button-shell {
    height: 100%;
    aspect-ratio: 1;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
}

.nav-button {
    height: 100%;
    width: 100%;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    padding: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-on-surface-variant);
    border-width: 2px;
    border-style: solid;
    border-color: transparent;
    transform: scale(1);
    text-wrap: none;
    transition-property: color, border-color, transform;
    transition-duration: var(--animation-duration-medium);
    transition-timing-function: var(--animation-curves-bezier-standard);
}

.nav-button:hover {
    color: var(--color-on-surface);
    transform: scale(1.12);
}

/* Keyboard only. A pointer press on a button never sets `focus-visible`,
so clicking leaves no ring behind — only tabbing to the control does. */
.nav-button:focus-visible {
    color: var(--color-on-surface);
    border-color: var(--color-primary);
}

.nav-button:active {
    color: var(--color-primary);
    transform: scale(0.9);
}

.nav-button-glyph {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    color: inherit;
    transition: color var(--animation-duration-medium) var(--animation-curves-bezier-standard);
}
</style>
