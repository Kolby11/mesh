<template>
  <stack class="nav-button-shell">
    <button
      ref="settingsButton"
      class="nav-button"
      onclick={onOpenSettings}
      onpointerenter={onSettingsEnter}
      onpointerleave={onSettingsLeave}
      aria-haspopup="true"
      aria-expanded={settings_aria_expanded}
      data-tooltip-disabled={settings_tooltip_disabled}
      title={settings_tooltip}
      aria-label={t('nav.open_settings')}
    >
      <icon class="nav-button-glyph" name="preferences-system" size="18" />
    </button>
    <QuickSettings bind:this={quick_settings} />
  </stack>
</template>

<script lang="luau">
local t = import("mesh.i18n", "t")
local QuickSettings = require("@mesh/quick-settings")

settings_surface_hidden = true
settings_launcher_blocked = false
settings_aria_expanded = "false"
settings_tooltip = t('nav.open_settings')
settings_tooltip_disabled = "false"

quick_settings = nil
local quick_settings_connected = false
local CLOSE_BRIDGE_KEY = "quick-settings-close"
local CLOSE_BRIDGE_DELAY_MS = 400
local connect_quick_settings

local function cancel_bridge_close()
    mesh.events.publish("shell.cancel-handler", { key = CLOSE_BRIDGE_KEY })
end

local function schedule_bridge_close()
    mesh.events.publish("shell.schedule-handler", {
        key = CLOSE_BRIDGE_KEY,
        handler = "closeSettingsBridge",
        delay_ms = CLOSE_BRIDGE_DELAY_MS,
    })
end

-- The quick-settings popup is a promoted child surface that covers the space
-- the tooltip would occupy. Leaving the tooltip live while the popup is open
-- leaves a sliver of it visible below the bar, so the trigger drops its
-- tooltip for as long as the popup is up.
local function sync_trigger_state()
    settings_aria_expanded = settings_surface_hidden and "false" or "true"
    if settings_surface_hidden then
        settings_tooltip = t('nav.open_settings')
        settings_tooltip_disabled = "false"
    else
        settings_tooltip = ""
        settings_tooltip_disabled = "true"
    end
end

local function show_settings_selector(event)
    if quick_settings and settings_surface_hidden and not settings_launcher_blocked then
        connect_quick_settings()
        cancel_bridge_close()
        quick_settings.open = true
        settings_surface_hidden = false
        sync_trigger_state()
    end
end

local function hide_settings_selector(bridge)
    if not settings_surface_hidden then
        if bridge == true then
            schedule_bridge_close()
            return
        end
        cancel_bridge_close()
        quick_settings.open = false
        settings_surface_hidden = true
        sync_trigger_state()
    end
end

connect_quick_settings = function()
    if quick_settings == nil or quick_settings_connected then
        return
    end
    quick_settings_connected = true
    quick_settings.PopoverEnter:on(onQuickSettingsEnter)
    quick_settings.PopoverLeave:on(function()
        schedule_bridge_close()
    end)
    quick_settings.CloseRequested:on(function()
        hide_settings_selector(false)
    end)
end

function render(self)
    connect_quick_settings()
end

function onOpenSettings()
    -- A click is the explicit path into the full settings application. The
    -- quick-settings popup remains the lightweight hover surface.
    -- Keep the launcher from reopening Quick Settings while the pointer is
    -- still over this button after the full surface appears. The lock is
    -- released by the next pointer leave, so a later hover works normally.
    settings_launcher_blocked = true
    cancel_bridge_close()
    mesh.events.publish("shell.show-surface", { surface_id = "@mesh/settings" })
    hide_settings_selector(false)
    -- Settings owns focus once its window opens. Leaving focus on the launcher
    -- makes it look permanently active while the separate window is visible.
    refs.settingsButton:blur()
end

-- Hover opens quick settings; leaving the trigger starts a core-owned hover
-- bridge so the pointer can cross into the promoted popup.
function onSettingsEnter(event)
    connect_quick_settings()
    cancel_bridge_close()
    show_settings_selector(event)
end

function onSettingsLeave()
    settings_launcher_blocked = false
    hide_settings_selector(true)
end

function onQuickSettingsEnter()
    cancel_bridge_close()
end

function closeSettingsBridge()
    hide_settings_selector(false)
end
</script>

<style>
.nav-button-shell {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
}

.nav-button {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    padding: var(--spacing-xs);
    border-radius: var(--radius-full);
    transform: translateY(0px) scale(1);
    background: var(--color-surface-container);
    color: var(--color-on-surface);
    border-width: 2px;
    border-style: solid;
    border-color: transparent;
    text-wrap: none;
    transition: background-color var(--animation-duration-short) var(--animation-curves-bezier-standard),
                color var(--animation-duration-short) var(--animation-curves-bezier-standard),
                border-color var(--animation-duration-long) var(--animation-curves-bezier-standard),
                transform var(--animation-duration-short) var(--animation-curves-bezier-emphasized-decelerate);
}

.nav-button:hover {
    background: var(--color-secondary-container);
    color: var(--color-on-secondary-container);
    transform: translateY(-1px) scale(1.04);
}

.nav-button:focus,
.nav-button:focus-visible {
    background: var(--color-tertiary-container);
    color: var(--color-on-tertiary-container);
    transform: translateY(-1px) scale(1.03);
}

.nav-button:active {
    background: var(--color-primary);
    color: var(--color-on-primary);
    border-color: var(--color-primary);
    transform: translateY(0px) scale(0.94);
}

.nav-button-glyph {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    color: inherit;
    transition: color var(--animation-duration-short) var(--animation-curves-bezier-standard);
}

@container (max-width: 720px) {
    .nav-button-shell {
        width: 36px;
        height: 36px;
    }

    .nav-button {
        width: 36px;
        height: 36px;
    }
}
</style>
