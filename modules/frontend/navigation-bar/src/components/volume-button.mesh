<props>
    scroll_sensitivity: { type: "number", default: 5, min: 1, max: 100, step: 1 }
</props>

<template>
    <stack class="nav-button-shell">
        <button
            ref="volume-button"
            class="nav-button"
            keybind="mute"
            onclick={onAudioToggle}
            onscroll={onVolumeScroll}
            ontwofingerscroll={onVolumeScroll}
            onkeybind={onMuteKeybind}
            title="{audio_tooltip}"
            aria-label="{audio_aria_label}"
        >
            <icon class="nav-button-glyph" name="{icon_name}" size="18" />
        </button>
    </stack>
</template>

<script lang="luau">
local t = import("mesh.i18n", "t")
local audio = require("mesh.audio")

icon_name = "audio-volume-muted"
audio_tooltip_key = "nav.volume_unavailable"
audio_tooltip_value = ""
audio_tooltip = "Volume unavailable"
audio_aria_label = "Volume"
audio_percent = 0

local function normalized_scroll_sensitivity()
    local amount = tonumber(props and props.scroll_sensitivity)
    if amount == nil or amount ~= amount or amount == math.huge or amount == -math.huge or amount <= 0 then
        return 5
    end
    return math.max(1, math.min(100, amount))
end

local function sync_audio_text()
    if audio_tooltip_value == nil or audio_tooltip_value == "" then
        audio_tooltip = t(audio_tooltip_key)
    else
        audio_tooltip = t(audio_tooltip_key) .. " " .. audio_tooltip_value
    end

    if audio_tooltip_value == nil or audio_tooltip_value == "" then
        audio_aria_label = t("nav.volume")
    else
        audio_aria_label = t("nav.volume") .. " " .. audio_tooltip_value
    end
end

local function update_audio_copy(percent, muted)
    local safe = math.floor(tonumber(percent) or 0)
    if safe < 0 then
        safe = 0
    end
    if safe > 100 then
        safe = 100
    end
    audio_percent = safe

    if muted or safe == 0 then
        icon_name = "audio-volume-muted"
    elseif safe < 34 then
        icon_name = "audio-volume-low"
    elseif safe < 67 then
        icon_name = "audio-volume-medium"
    else
        icon_name = "audio-volume-high"
    end

    if muted then
        audio_tooltip_key = "nav.volume_muted_at"
    else
        audio_tooltip_key = "nav.volume_level"
    end
    audio_tooltip_value = string.format("%d%%", safe)
    sync_audio_text()
end

if audio and audio.VolumeChanged then
    audio.VolumeChanged:on(function(event)
        local percent = math.floor(tonumber(event.level) or 0)
        if percent < 0 then
            percent = 0
        end
        if percent > 100 then
            percent = 100
        end
        local muted = audio.muted or false
        update_audio_copy(percent, muted)
    end)
end

function render(self)
    if not audio or audio.available == false then
        icon_name = "audio-volume-muted"
        audio_tooltip_key = "nav.audio_service_unavailable"
        audio_tooltip_value = ""
        sync_audio_text()
        audio_percent = 0
        return
    end

    local percent = math.floor(tonumber(audio.percent) or 0)
    if percent < 0 then
        percent = 0
    end
    if percent > 100 then
        percent = 100
    end
    local muted = audio.muted or false
    update_audio_copy(percent, muted)
end

function onAudioToggle()
    if not audio or audio.available == false then
        return
    end

    if type(audio.set_muted) == "function" then
        audio.set_muted("default", not (audio.muted or false))
    elseif type(audio.toggle_mute) == "function" then
        audio.toggle_mute()
    end
end

function onVolumeScroll(event)
    if not audio or audio.available == false or type(audio.set_volume) ~= "function" then
        return
    end

    local delta = event and event.delta or {}
    local dy = tonumber(delta.y) or 0
    if dy == 0 then
        return
    end

    local amount = normalized_scroll_sensitivity()
    if dy > 0 then
        update_audio_copy(audio_percent + amount, false)
        audio.set_volume("default", audio_percent)
    else
        update_audio_copy(audio_percent - amount, false)
        audio.set_volume("default", audio_percent)
    end
end
</script>

<style>
    .nav-button-shell {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        justify-content: center;
        align-items: center;
    }

    .nav-button {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        justify-content: center;
        align-items: center;
        padding: var(--spacing-xs);
        border-radius: var(--radius-full);
        background: var(--color-surface-container);
        color: var(--color-on-surface);
        border-width: 2px;
        border-style: solid;
        border-color: transparent;
        text-wrap: none;
        transition: background-color var(--animation-duration-short) var(--animation-curves-bezier-standard),
        color var(--animation-duration-short) var(--animation-curves-bezier-standard),
        border-color var(--animation-duration-short) var(--animation-curves-bezier-standard),
        transform var(--animation-duration-short) var(--animation-curves-bezier-emphasized-decelerate);
    }

    .nav-button:hover {
        background: var(--color-secondary-container);
        color: var(--color-on-secondary-container);
    }

    .nav-button:focus,
    .nav-button:focus-visible {
        background: var(--color-tertiary-container);
        color: var(--color-on-tertiary-container);
    }

    .nav-button:active {
        background: var(--color-primary);
        color: var(--color-on-primary);
        border-color: var(--color-primary);
    }

    .nav-button-glyph {
        width: 24px;
        height: 24px;
        flex-shrink: 0;
        justify-content: center;
        align-items: center;
        color: inherit;
        --icon-fill: 0;
        --icon-weight: 400;
        transition: color var(--animation-duration-short) var(--animation-curves-bezier-standard);
    }

    .nav-button:hover .nav-button-glyph {
        --icon-fill: 1;
        --icon-weight: 500;
    }

    .nav-button:active .nav-button-glyph {
        --icon-fill: 1;
        --icon-weight: 600;
    }

    @container (max-width: 720px) {
        .nav-button-shell {
            width: 36px;
            height: 36px;
        }

        .nav-button {
            width: 36px;
            height: 36px;
        }
    }
</style>
