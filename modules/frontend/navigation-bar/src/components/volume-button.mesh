<props>
scroll_sensitivity: { type: "number", default: 5, min: 1, max: 100, step: 1 }
</props>

<template>
    <stack class="nav-button-shell">
        <button
            ref="volumeButton"
            class="nav-button"
            keybind="mute"
            onclick={onAudioToggle}
            onpointerenter={onVolumeEnter}
            onpointerleave={onVolumeLeave}
            onscroll={onVolumeScroll}
            ontwofingerscroll={onVolumeScroll}
            onkeybind={onMuteKeybind}
            aria-haspopup="true"
            aria-expanded={audio_aria_expanded}
            title={audio_tooltip_value == '' and t(audio_tooltip_key) or t(audio_tooltip_key) .. ' ' .. audio_tooltip_value}
            aria-label={audio_tooltip_value == '' and t('nav.volume') or t('nav.volume') .. ' ' .. audio_tooltip_value}
        >
            <icon class="nav-button-glyph" name={icon_name} size="18" />
        </button>
        <AudioPopover bind:this={audio_popover} />
    </stack>
</template>

<script lang="luau">
local audio = require("mesh.audio")
local AudioPopover = require("@mesh/audio-popover")

icon_name = "audio-volume-muted"
audio_tooltip_key = "nav.volume_unavailable"
audio_tooltip_value = ""
audio_percent = 0
audio_popover = nil
audio_popover_connected = false
audio_surface_hidden = true
audio_aria_expanded = "false"
audio_pointer_inside = false
audio_dragging = false
local do_close
-- One close timer for the trigger and its popover: leaving either schedules
-- it, entering either (or dragging the slider) cancels it.
local hover = mesh.ui.hover_intent(function()
    do_close()
end)

local function sync_trigger_state()
    audio_aria_expanded = audio_surface_hidden and "false" or "true"
end

local function connect_audio_popover()
    if audio_popover == nil or audio_popover_connected then
        return
    end
    audio_popover_connected = true
    audio_popover.PopoverEnter:on(function()
        audio_pointer_inside = true
        hover.cancel()
    end)
    audio_popover.PopoverLeave:on(function()
        audio_pointer_inside = false
        if not audio_dragging then
            hover.leave()
        end
    end)
    audio_popover.DragStart:on(function()
        audio_dragging = true
        hover.cancel()
    end)
    audio_popover.DragEnd:on(function()
        audio_dragging = false
        if not audio_pointer_inside then
            hover.leave()
        end
    end)
    audio_popover.CloseRequested:on(function()
        do_close()
    end)
    audio_popover.KeyboardDismissRequested:on(function()
        do_close()
    end)
end

local function do_open()
    connect_audio_popover()
    if audio_popover and audio_surface_hidden then
        hover.cancel()
        audio_popover.open = true
        audio_surface_hidden = false
        sync_trigger_state()
    end
end

do_close = function()
    hover.cancel()
    if audio_popover and not audio_surface_hidden then
        audio_popover.open = false
        audio_surface_hidden = true
        sync_trigger_state()
    end
end

local function normalized_scroll_sensitivity()
    local amount = tonumber(props and props.scroll_sensitivity)
    if amount == nil or amount ~= amount or amount == math.huge or amount == -math.huge or amount <= 0 then
        return 5
    end
    return math.max(1, math.min(100, amount))
end

local function update_audio_copy(percent, muted)
    local safe = math.floor(percent)
    audio_percent = safe

    if muted or safe == 0 then
        icon_name = "audio-volume-muted"
    elseif safe < 34 then
        icon_name = "audio-volume-low"
    elseif safe < 67 then
        icon_name = "audio-volume-medium"
    else
        icon_name = "audio-volume-high"
    end

    if muted then
        audio_tooltip_key = "nav.volume_muted_at"
    else
        audio_tooltip_key = "nav.volume_level"
    end
    audio_tooltip_value = mesh.locale.format_percent(safe)
end

audio.VolumeChanged:on(function(event)
    -- Event payloads carry no declared range, unlike `audio.percent`.
    update_audio_copy(math.clamp(event.level, 0, 100), audio.muted)
end)

function render(self)
    connect_audio_popover()
    if audio.available == false then
        icon_name = "audio-volume-muted"
        audio_tooltip_key = "nav.audio_service_unavailable"
        audio_tooltip_value = ""
        audio_percent = 0
        return
    end

    update_audio_copy(audio.percent, audio.muted)
end

function onVolumeEnter(event)
    audio_pointer_inside = true
    hover.cancel()
    do_open()
end

function onVolumeLeave()
    audio_pointer_inside = false
    if not audio_surface_hidden and not audio_dragging then
        hover.leave()
    end
end

function onAudioToggle()
    if audio.available == false then
        return
    end

    if type(audio.set_muted) == "function" then
        audio.set_muted("default", not (audio.muted or false))
    elseif type(audio.toggle_mute) == "function" then
        audio.toggle_mute()
    end
end

function onMuteKeybind()
    onAudioToggle()
end

function onVolumeScroll(event)
    if audio.available == false or type(audio.set_volume) ~= "function" then
        return
    end

    local delta = event and event.delta or {}
    local dy = tonumber(delta.y) or 0
    if dy == 0 then
        return
    end

    local amount = normalized_scroll_sensitivity()
    local step = dy > 0 and amount or -amount
    update_audio_copy(math.clamp(audio_percent + step, 0, 100), false)
    audio.set_volume("default", audio_percent)
end
</script>

<style>
    .nav-button-shell {
        height: 100%;
        aspect-ratio: 1;
        flex-shrink: 0;
        justify-content: center;
        align-items: center;
    }

    .nav-button {
        height: 100%;
        width: 100%;
        flex-shrink: 0;
        justify-content: center;
        align-items: center;
        padding: 0;
        border-radius: var(--radius-full);
        background: transparent;
        color: var(--color-on-surface-variant);
        border-width: 2px;
        border-style: solid;
        border-color: transparent;
        transform: scale(1);
        text-wrap: none;
        transition-property: color, border-color, transform;
        transition-duration: var(--animation-duration-medium);
        transition-timing-function: var(--animation-curves-bezier-standard);
    }

    .nav-button:hover {
        color: var(--color-on-surface);
        transform: scale(1.12);
    }

    /* Keyboard only. A pointer press on a button never sets `focus-visible`,
    so clicking leaves no ring behind — only tabbing to the control does. */
    .nav-button:focus-visible {
        color: var(--color-on-surface);
        border-color: var(--color-primary);
    }

    .nav-button:active {
        color: var(--color-primary);
        transform: scale(0.9);
    }

    .nav-button-glyph {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
        justify-content: center;
        align-items: center;
        color: inherit;
        transition: color var(--animation-duration-medium) var(--animation-curves-bezier-standard);
    }

    .nav-button {
        --icon-fill: 0;
        --icon-weight: 400;
    }

    .nav-button:hover {
        --icon-fill: 1;
        --icon-weight: 500;
    }

    .nav-button:active {
        --icon-fill: 1;
        --icon-weight: 600;
    }
</style>
