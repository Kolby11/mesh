<template>
    <stack class="nav-button-shell">
        <button
            ref="themeButton"
            class="theme-trigger"
            class:theme-trigger-open={not theme_surface_hidden}
            onclick={onThemeToggle}
            onpointerenter={onThemeEnter}
            onpointerleave={onThemeLeave}
            aria-haspopup="true"
            aria-expanded={theme_aria_expanded}
            data-tooltip-disabled={theme_tooltip_disabled}
            title={theme_tooltip}
            aria-label={t(theme_tooltip_key)}
        >
            <icon class="theme-trigger-glyph" name={theme_icon} size="18" />
        </button>
        <ThemeSelector bind:this={theme_popover} />
    </stack>
</template>

<script lang="luau">
local t = import("mesh.i18n", "t")
local ThemeSelector = require("@mesh/theme-selector")

theme_icon = "weather-clear-night"
theme_tooltip_key = "nav.select_theme"
theme_tooltip = ""
theme_tooltip_disabled = "false"
theme_is_dark = true
theme_surface_hidden = true
theme_aria_expanded = "false"

theme_popover = nil
local theme_popover_connected = false
local do_close
local CLOSE_BRIDGE_DELAY_MS = 400
local close_bridge = nil
local popover_close_pending = false

local function cancel_bridge_close()
    if close_bridge ~= nil then
        close_bridge:cancel()
        close_bridge = nil
    end
    -- The popover runs its own close after the pointer leaves it; returning
    -- to the trigger has to stop that one too. Only call across when one is
    -- pending: each call through `bind:this` resyncs the popover's state.
    if popover_close_pending and theme_popover ~= nil then
        popover_close_pending = false
        theme_popover.cancelPendingClose()
    end
end

local function schedule_bridge_close()
    cancel_bridge_close()
    close_bridge = task.delay(CLOSE_BRIDGE_DELAY_MS, function()
        close_bridge = nil
        do_close()
    end)
end

local function sync_trigger_state()
    theme_aria_expanded = theme_surface_hidden and "false" or "true"
    if theme_surface_hidden then
        theme_tooltip = t(theme_tooltip_key)
        theme_tooltip_disabled = "false"
    else
        theme_tooltip = ""
        theme_tooltip_disabled = "true"
    end
end

local function apply_theme(theme_id)
    theme_is_dark = type(theme_id) == "string" and string.find(theme_id, "dark", 1, true) ~= nil
    theme_icon = theme_is_dark and "weather-clear-night" or "weather-clear"
end

local function connect_popover()
    if theme_popover == nil or theme_popover_connected then
        return
    end
    theme_popover_connected = true
    apply_theme(theme_popover.current_theme)
    theme_popover.ThemeChanged:on(function()
        apply_theme(theme_popover.current_theme)
    end)
    theme_popover.PopoverEnter:on(function()
        cancel_bridge_close()
    end)
    theme_popover.CloseScheduled:on(function()
        popover_close_pending = true
    end)
    theme_popover.CloseRequested:on(function()
        do_close()
    end)
    theme_popover.KeyboardDismissRequested:on(function()
        do_close()
    end)
end

local function do_open()
    if theme_popover and theme_surface_hidden then
        connect_popover()
        cancel_bridge_close()
        theme_popover.open = true
        theme_surface_hidden = false
        sync_trigger_state()
    end
end

do_close = function()
    cancel_bridge_close()
    popover_close_pending = false
    if theme_popover and not theme_surface_hidden then
        theme_popover.open = false
        theme_surface_hidden = true
        sync_trigger_state()
    end
end

function render(self)
    -- `bind:this` becomes available after the initial template evaluation.
    -- State updates then flow through the child event instead of being polled.
    connect_popover()
end

sync_trigger_state()

-- Keyboard-only toggle; hover opens/closes.
function onThemeToggle(event)
    local keyboard = event ~= nil and event.trigger ~= nil and event.trigger.type == "keyboard"
    if not keyboard then
        return
    end
    if theme_surface_hidden then
        do_open()
    else
        do_close()
    end
end

function onThemeEnter(event)
    cancel_bridge_close()
    do_open()
end

function onThemeLeave()
    if not theme_surface_hidden then
        schedule_bridge_close()
    end
end
</script>

<style>
    .nav-button-shell {
        height: 100%;
        aspect-ratio: 1;
        flex-shrink: 0;
        justify-content: center;
        align-items: center;
        position: relative;
        overflow: visible;
    }

    .theme-trigger {
        height: 100%;
        width: 100%;
        flex-shrink: 0;
        justify-content: center;
        align-items: center;
        padding: 0;
        border-radius: var(--radius-full);
        background: transparent;
        color: var(--color-on-surface-variant);
        border-width: 2px;
        border-style: solid;
        border-color: transparent;
        transform: scale(1);
        text-wrap: none;
        position: relative;
        z-index: 3;
        transition-property: color, border-color, transform;
        transition-duration: var(--animation-duration-medium);
        transition-timing-function: var(--animation-curves-bezier-standard);
    }

    .theme-trigger:hover {
        color: var(--color-on-surface);
        transform: scale(1.12);
    }

    /* Keyboard only. A pointer press on a button never sets `focus-visible`,
    so clicking leaves no ring behind — only tabbing to the control does. */
    .theme-trigger:focus-visible {
        color: var(--color-on-surface);
        border-color: var(--color-primary);
    }

    .theme-trigger:active {
        color: var(--color-primary);
        transform: scale(0.9);
    }

    /* Popover open reads through the glyph, not a ring: no border may appear
    from a pointer interaction. */
    .theme-trigger-open,
    .theme-trigger-open:hover,
    .theme-trigger-open:focus-visible {
        color: var(--color-primary);
    }

    .theme-trigger-glyph {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
        justify-content: center;
        align-items: center;
        color: inherit;
        transition: color var(--animation-duration-medium) var(--animation-curves-bezier-standard);
    }
</style>
