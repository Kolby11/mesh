<template>
    <stack class="nav-button-shell">
        <button
            ref="languageButton"
            class="language-trigger"
            aria-haspopup="true"
            title={t('nav.language_menu')}
            aria-label={t('nav.language_menu')}
        >
            <label class="language-label">{current_locale_label}</label>
        </button>
        <LanguagePopover bind:this={lang_popover} />
    </stack>
</template>

<script lang="luau">
local t = import("mesh.i18n", "t")
local LanguagePopover = require("@mesh/language-popover")

current_locale_label = "🇬🇧"

lang_popover = nil
local lang_popover_connected = false

-- The flag shown on the trigger comes from the popover, which owns the locale
-- table. Keeping a second copy here is what left the button reading "EN" for
-- every locale except Slovak: it only knew two of them.
local function popover_flag()
    if lang_popover == nil then
        return nil
    end
    local flag = lang_popover.current_flag
    if type(flag) ~= "string" or flag == "" then
        return nil
    end
    return flag
end

effect(function(self)
    -- `bind:this` becomes available after the initial template evaluation.
    -- State updates then flow through the child event instead of being polled.
    if lang_popover == nil or lang_popover_connected then
        return
    end
    lang_popover_connected = true
    current_locale_label = popover_flag() or current_locale_label
    lang_popover.LocaleChanged:on(function(event)
        local flag = event and event.flag
        if type(flag) == "string" and flag ~= "" then
            current_locale_label = flag
        else
            current_locale_label = popover_flag() or current_locale_label
        end
    end)
end)
</script>

<style>
    .nav-button-shell {
        height: 100%;
        aspect-ratio: 1;
        flex-shrink: 0;
        justify-content: center;
        align-items: center;
        position: relative;
        overflow: visible;
    }

    .language-trigger {
        height: 100%;
        width: 100%;
        flex-shrink: 0;
        justify-content: center;
        align-items: center;
        padding: 0;
        border-radius: var(--radius-full);
        background: transparent;
        color: var(--color-on-surface-variant);
        border-width: 2px;
        border-style: solid;
        border-color: transparent;
        transform: scale(1);
        text-wrap: none;
        transition-property: color, border-color, transform;
        transition-duration: var(--animation-duration-medium);
        transition-timing-function: var(--animation-curves-bezier-standard);
    }

    .language-trigger:hover {
        color: var(--color-on-surface);
        transform: scale(1.12);
    }

    /* Keyboard only. A pointer press on a button never sets `focus-visible`,
    so clicking leaves no ring behind — only tabbing to the control does. */
    .language-trigger:focus-visible {
        color: var(--color-on-surface);
        border-color: var(--color-primary);
    }

    .language-trigger:active {
        color: var(--color-primary);
        transform: scale(0.9);
    }

    .language-trigger:expanded,
    .language-trigger:expanded:hover,
    .language-trigger:expanded:focus-visible {
        color: var(--color-primary);
    }

    .language-label {
        color: inherit;
        /* A flag emoji, not a two-letter code: no tracking to add after the
        regional-indicator pair, and large enough to read at trigger size. */
        font-size: var(--typography-size-md);
        font-weight: 700;
        line-height: 1;
        user-select: none;
        transition: color var(--animation-duration-medium) var(--animation-curves-bezier-standard);
    }
</style>
