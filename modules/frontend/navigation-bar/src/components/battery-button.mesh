<template>
    <box
        class="battery-widget"
        title={t('nav.battery') .. newline .. t(remaining_key) .. ': ' .. remaining_label .. newline .. t(rate_key) .. ': ' .. rate_label .. newline .. t('nav.health') .. ': ' .. health_label}
        aria-label={t('nav.battery') .. ' ' .. battery_label .. '. ' .. t(rate_key) .. '. ' .. t(remaining_key) .. ': ' .. remaining_label .. '. ' .. t('nav.health') .. ': ' .. health_label .. '.'}
    >
        <icon class="battery-glyph" name={battery_icon_name} size="18" />
        <text class="battery-value">{battery_label}</text>
    </box>
</template>

<script lang="luau">
local power = require("mesh.power")

newline = "\n"
battery_icon_name = "battery-empty"
battery_label = "--%"
remaining_key = "nav.time_to_empty"
remaining_label = "--"
rate_key = "nav.discharging"
rate_label = "--"
health_label = "--"

function round_percent(level_value)
    local safe = level_value or 0
    if safe < 0 then
        safe = 0
    end
    if safe <= 1 then
        safe = safe * 100
    end
    if safe > 100 then
        safe = 100
    end
    return math.floor(safe + 0.5)
end

function format_minutes(total_minutes)
    if total_minutes == nil or total_minutes <= 0 then
        return "--"
    end
    local hours = math.floor(total_minutes / 60)
    local minutes = total_minutes % 60
    if hours > 0 and minutes > 0 then
        return string.format("%dh, %dm", hours, minutes)
    end
    if hours > 0 then
        return string.format("%dh", hours)
    end
    return string.format("%dm", minutes)
end

function format_watts(watts)
    if watts == nil or watts <= 0 then
        return "--"
    end
    return string.format("%.2fW", watts)
end

function format_health(health_percent)
    if health_percent == nil or health_percent <= 0 then
        return "--"
    end
    return string.format("%.1f%%", health_percent)
end

function battery_icon_for(percent_value)
    if percent_value >= 95 then
        return "battery-full"
    end
    if percent_value >= 70 then
        return "battery-good"
    end
    if percent_value >= 45 then
        return "battery-low"
    end
    if percent_value >= 20 then
        return "battery-caution"
    end
    return "battery-empty"
end

function render(self)
    if not power or not power.available then
        battery_icon_name = "battery-empty"
        battery_label = "N/A"
        remaining_key = "nav.time_to_empty"
        remaining_label = "--"
        rate_key = "nav.discharging"
        rate_label = "--"
        health_label = "--"
        return
    end

    local percent_value = round_percent(power.level)
    local charging = power.charging or false

    battery_icon_name = battery_icon_for(percent_value)
    battery_label = string.format("%d%%", percent_value)
    remaining_key = charging and "nav.time_to_full" or "nav.time_to_empty"
    remaining_label = charging and format_minutes(power.time_to_full_minutes)
        or format_minutes(power.time_remaining_minutes)
    rate_key = charging and "nav.charging" or "nav.discharging"
    rate_label = format_watts(power.power_draw_watts)
    health_label = format_health(power.health_percent)
end
</script>

<style>
    .battery-widget {
        height: 100%;
        flex-shrink: 0;
        justify-content: center;
        align-items: center;
        gap: var(--spacing-xs);
        padding-inline: var(--spacing-xs);
        border-radius: var(--radius-full);
        background: transparent;
        color: var(--color-on-surface-variant);
        text-wrap: none;
        transition: color var(--animation-duration-medium) var(--animation-curves-bezier-standard);
    }

    .battery-widget:hover {
        color: var(--color-on-surface);
    }

    .battery-glyph {
        width: 18px;
        height: 18px;
        justify-content: center;
        align-items: center;
        color: inherit;
        transition: color var(--animation-duration-medium) var(--animation-curves-bezier-standard);
    }

    .battery-value {
        color: inherit;
        font-size: var(--typography-size-xs);
        font-weight: 700;
    }

    @container (max-width: 720px) {
        .battery-value {
            display: none;
        }
    }
</style>
