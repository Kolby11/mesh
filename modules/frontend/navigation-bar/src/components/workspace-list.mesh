<template>
  <row class="workspace-list">
    <box class="ws-active-trail" style={trail_style} aria-hidden="true" />
    <box class="ws-active-indicator" style={indicator_style} aria-hidden="true" />
    <button class="{ws1_class}" onclick={onSwitch1} title="Workspace 1" aria-label="Workspace 1">
      <text class="ws-num">1</text>
    </button>
    <button class="{ws2_class}" onclick={onSwitch2} title="Workspace 2" aria-label="Workspace 2">
      <text class="ws-num">2</text>
    </button>
    <button class="{ws3_class}" onclick={onSwitch3} title="Workspace 3" aria-label="Workspace 3">
      <text class="ws-num">3</text>
    </button>
    <button class="{ws4_class}" onclick={onSwitch4} title="Workspace 4" aria-label="Workspace 4">
      <text class="ws-num">4</text>
    </button>
    <button class="{ws5_class}" onclick={onSwitch5} title="Workspace 5" aria-label="Workspace 5">
      <text class="ws-num">5</text>
    </button>
  </row>
</template>

<script lang="luau">
ws_active = 1
ws1_class = "ws-btn ws-btn-active"
ws2_class = "ws-btn"
ws3_class = "ws-btn"
ws4_class = "ws-btn"
ws5_class = "ws-btn"
indicator_style = "transform: translateX(0px);"
trail_style = "transform: translateX(0px);"

local wm = require("mesh.wm")

local function get_wm_state()
    if wm then
        return wm.active_workspace
    end
    return nil
end

local function sync_indicator()
    local slot = math.max(1, math.min(5, ws_active))
    local offset = (slot - 1) * 28
    indicator_style = string.format("transform: translateX(%dpx);", offset)
    trail_style = string.format("transform: translateX(%dpx);", offset)
end

local function sync_classes()
    ws1_class = ws_active == 1 and "ws-btn ws-btn-active" or "ws-btn"
    ws2_class = ws_active == 2 and "ws-btn ws-btn-active" or "ws-btn"
    ws3_class = ws_active == 3 and "ws-btn ws-btn-active" or "ws-btn"
    ws4_class = ws_active == 4 and "ws-btn ws-btn-active" or "ws-btn"
    ws5_class = ws_active == 5 and "ws-btn ws-btn-active" or "ws-btn"
    sync_indicator()
end

function render(self)
    local active = get_wm_state()
    if active then
        local n = tonumber(active) or 1
        if n ~= ws_active then
            ws_active = n
            sync_classes()
        end
    end
end

local function switch_to(n)
    ws_active = n
    sync_classes()
    if wm and type(wm.focus_workspace) == "function" then
        wm.focus_workspace(n)
    else
        mesh.log.warn("[workspace-list] mesh.wm focus_workspace method is unavailable")
    end
end

function onSwitch1() switch_to(1) end
function onSwitch2() switch_to(2) end
function onSwitch3() switch_to(3) end
function onSwitch4() switch_to(4) end
function onSwitch5() switch_to(5) end
</script>

<style>
.workspace-list {
    position: relative;
    height: 26px;
    align-items: center;
    gap: 2px;
    flex-shrink: 0;
}

.ws-active-indicator {
    position: absolute;
    top: 0px;
    left: 0px;
    width: 26px;
    height: 26px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    z-index: 1;
    transition: transform var(--animation-duration-short) var(--animation-curves-bezier-emphasized-decelerate);
}

.ws-active-trail {
    position: absolute;
    top: 0px;
    left: 0px;
    width: 26px;
    height: 26px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    opacity: 0.28;
    z-index: 0;
    transition: transform var(--animation-duration-long) var(--animation-curves-bezier-emphasized-decelerate), opacity var(--animation-duration-medium) var(--animation-curves-bezier-standard);
}

.ws-btn {
    width: 26px;
    height: 26px;
    justify-content: center;
    align-items: center;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-on-surface-variant);
    border-width: 0;
    z-index: 2;
    transition: color var(--animation-duration-short) var(--animation-curves-bezier-standard);
}

.ws-btn:hover {
    background: var(--color-surface-container-high);
    color: var(--color-on-surface);
}

.ws-btn-active {
    background: transparent;
    color: var(--color-on-primary);
}

.ws-btn-active:hover {
    background: transparent;
    color: var(--color-on-primary);
}

.ws-num {
    font-size: 11px;
    font-weight: 600;
    color: inherit;
}

@container (max-width: 560px) {
    .workspace-list {
        display: none;
    }
}
</style>
