<template>
  <button
    class="clock-btn"
    onclick={onClockClick}
    title="{clock_full_date}"
    aria-label="{clock_aria_label}"
  >
    <column class="clock-content">
      <text class="clock-time">{clock_time}</text>
      <text class="clock-date">{clock_date}</text>
    </column>
  </button>
</template>

<script lang="luau">
clock_time = "00:00"
clock_date = "Jan 01"
clock_full_date = ""
clock_aria_label = ""

local MONTHS = {"Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"}
local DAYS   = {"Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"}

function render(self)
    local t = os.date("*t")
    clock_time = string.format("%02d:%02d", t.hour, t.min)
    clock_date = string.format("%s %02d", MONTHS[t.month], t.day)
    clock_full_date = string.format(
        "%s, %s %d, %d",
        DAYS[t.wday], MONTHS[t.month], t.day, t.year
    )
    clock_aria_label = "Time " .. clock_time .. " — " .. clock_full_date
end

function onClockClick()
    -- No calendar surface exists yet; wire this to a real surface toggle
    -- (shell.toggle-surface with its surface_id) once one ships.
end
</script>

<style>
.clock-btn {
    height: 28px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    padding-inline: var(--spacing-sm);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-on-surface-variant);
    border-width: 2px;
    border-style: solid;
    border-color: transparent;
    transform: scale(1);
    text-wrap: none;
    transition-property: color, border-color, transform;
    transition-duration: var(--animation-duration-medium);
    transition-timing-function: var(--animation-curves-bezier-standard);
}

.clock-btn:hover {
    color: var(--color-on-surface);
    transform: scale(1.05);
}

.clock-btn:focus-visible {
    color: var(--color-on-surface);
    border-color: var(--color-primary);
}

.clock-btn:active {
    color: var(--color-primary);
    transform: scale(0.96);
}

.clock-content {
    align-items: center;
    gap: 0;
}

.clock-time {
    color: inherit;
    font-size: 12px;
    font-weight: 700;
    text-wrap: none;
    line-height: 1.1;
}

.clock-date {
    color: inherit;
    font-size: 9px;
    font-weight: 500;
    text-wrap: none;
    opacity: 0.75;
    line-height: 1.1;
}
</style>
