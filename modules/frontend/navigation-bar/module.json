{
  "name": "@mesh/navigation-bar",
  "version": "0.1.0",
  "description": "Top-edge navigation bar surface with start, center and end regions for navigation items.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "ui",
    "uses": {
      "modules": {
        "@mesh/shell-ui-interface": ">=1.0.0",
        "@mesh/workspaces-widget": ">=0.1.0",
        "@mesh/window-title-widget": ">=0.1.0",
        "@mesh/clock-widget": ">=0.1.0",
        "@mesh/brightness-widget": ">=0.1.0",
        "@mesh/volume-widget": ">=0.1.0",
        "@mesh/theme-widget": ">=0.1.0",
        "@mesh/language-widget": ">=0.1.0",
        "@mesh/battery-widget": ">=0.1.0",
        "@mesh/settings-widget": ">=0.1.0"
      },
      "interfaces": {
        "mesh.settings": ">=1.0"
      },
      "capabilities": [
        "shell.surface",
        "service.settings.read"
      ]
    },
    "entry": "src/main.mesh",
    "surface": {
      "anchor": "top",
      "layer": "top",
      "keyboard_mode": "on_demand",
      "visible_on_start": true,
      "blur": true
    },
    "provides": {
      "layout": [
        {
          "id": "main",
          "entrypoint": "src/main.mesh",
          "label": "Navigation Bar"
        }
      ],
      "settings": {
        "namespace": "@mesh/navigation-bar",
        "schema": {
          "keyboard": {
            "type": "object",
            "description": "Focused-surface keyboard defaults for the navigation bar. The manifest keybinds section declares keybind ids and default triggers; frontend components subscribe handlers to those ids.",
            "properties": {
              "shortcuts": {
                "type": "object",
                "description": "Shortcut definitions keyed by keybind id. Shell settings may remap the effective key per surface."
              }
            }
          }
        }
      },
      "extensionPoints": {
        "mesh.settings.page": [
          {
            "id": "navigation-bar",
            "entry": "src/settings.mesh",
            "order": 100,
            "props": {
              "namespace": "@mesh/navigation-bar",
              "title": "Navigation bar"
            }
          }
        ]
      }
    },
    "hosts": {
      "mesh.navigation.item": {
        "version": ">=1.0",
        "layout": "row",
        "max": 6,
        "slots": {
          "start": {
            "defaults": [
              "@mesh/workspaces-widget:workspaces",
              "@mesh/window-title-widget:window-title"
            ]
          },
          "center": {
            "defaults": [
              "@mesh/clock-widget:clock"
            ]
          },
          "end": {
            "defaults": [
              "@mesh/brightness-widget:brightness",
              "@mesh/volume-widget:volume",
              "@mesh/theme-widget:theme",
              "@mesh/language-widget:language",
              "@mesh/battery-widget:battery",
              "@mesh/settings-widget:settings"
            ]
          }
        }
      }
    },
    "accessibility": {
      "role": "toolbar"
    }
  }
}
