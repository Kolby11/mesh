{
  "name": "@mesh/settings",
  "version": "0.1.0",
  "description": "Backend-aware desktop settings for connectivity, audio, appearance, device details, and modules.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "frontend",
    "uses": {
      "interfaces": {
        "mesh.debug": ">=1.0",
        "mesh.theme": ">=1.0",
        "mesh.locale": ">=1.0",
        "mesh.audio": ">=1.0",
        "mesh.settings": ">=1.0",
        "mesh.packages": ">=1.0"
      },
      "optionalInterfaces": {
        "mesh.network": ">=1.0",
        "mesh.bluetooth": ">=1.0",
        "mesh.device": ">=1.0"
      },
      "resources": {
        "icons": [
          "@mesh/icons-material-symbols"
        ]
      },
      "capabilities": [
        "shell.surface",
        "service.debug.read",
        "service.audio.read",
        "service.audio.control",
        "service.network.read",
        "service.network.control",
        "service.bluetooth.read",
        "service.bluetooth.control",
        "service.device.read",
        "theme.read",
        "locale.read",
        "locale.write",
        "service.theme.control",
        "service.settings.read",
        "service.settings.control",
        "service.packages.read",
        "service.packages.control"
      ],
      "modules": {
        "@mesh/shell-ui-interface": ">=1.0.0"
      }
    },
    "i18n": {
      "defaultLocale": "en"
    },
    "icons": {
      "ignore_shell_default": true
    },
    "entry": "src/main.mesh",
    "iconRequirements": {
      "required": [
        "preferences-system",
        "settings",
        "wifi",
        "bluetooth",
        "computer",
        "applications-graphics",
        "audio-volume-muted",
        "audio-volume-low",
        "audio-volume-medium",
        "audio-volume-high",
        "window-close",
        "window-new",
        "window-restore"
      ]
    },
    "surface": {
      "role": "layer",
      "promotable": true,
      "anchor": "right",
      "layer": "overlay",
      "keyboard_mode": "on_demand",
      "title": {
        "t": "settings.title",
        "fallback": "Settings"
      },
      "appId": "mesh.settings",
      "visible_on_start": false
    },
    "contributes": {
      "i18n": [
        {
          "id": "en",
          "locale": "en",
          "path": "config/i18n/en.json"
        },
        {
          "id": "sk",
          "locale": "sk",
          "path": "config/i18n/sk.json"
        }
      ]
    },
    "accessibility": {
      "role": "dialog",
      "label": "Settings",
      "description": "Manage connectivity, audio, appearance, device details, modules, and providers"
    },
    "hosts": {
      "mesh.settings.page": {
        "version": ">=1.0",
        "layout": "column"
      }
    }
  }
}
