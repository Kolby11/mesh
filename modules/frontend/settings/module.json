{
  "name": "@mesh/settings",
  "version": "0.1.0",
  "description": "Backend-aware desktop settings for connectivity, audio, display, power, notifications, input, accessibility, apps, privacy, appearance, device details, and modules.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "ui",
    "uses": {
      "interfaces": {
        "mesh.debug": ">=1.0",
        "mesh.theme": ">=1.0",
        "mesh.locale": ">=1.0",
        "mesh.audio": ">=1.0",
        "mesh.settings": ">=1.0",
        "mesh.packages": ">=1.0",
        "mesh.keybinds": ">=1.0"
      },
      "optionalInterfaces": {
        "mesh.network": ">=1.0",
        "mesh.bluetooth": ">=1.0",
        "mesh.device": ">=1.0",
        "mesh.notifications": ">=1.0",
        "mesh.power": ">=1.0",
        "mesh.brightness": ">=1.0",
        "mesh.apps": ">=1.0",
        "mesh.session": ">=1.0",
        "mesh.display": ">=1.0",
        "mesh.input": ">=1.0",
        "mesh.power-profile": ">=1.0",
        "mesh.time": ">=1.0",
        "mesh.idle": ">=1.0",
        "mesh.network-details": ">=1.0",
        "mesh.hardware": ">=1.0",
        "mesh.audio-devices": ">=1.0"
      },
      "resources": {
        "icons": [
          "@mesh/icons-material-symbols"
        ]
      },
      "capabilities": [
        "shell.surface",
        "service.debug.read",
        "service.audio.read",
        "service.audio.control",
        "service.network.read",
        "service.network.control",
        "service.bluetooth.read",
        "service.bluetooth.control",
        "service.device.read",
        "theme.read",
        "locale.read",
        "locale.write",
        "service.theme.control",
        "service.settings.read",
        "service.settings.control",
        "service.packages.read",
        "service.packages.control",
        "service.keybinds.read",
        "service.keybinds.control",
        "service.notifications.read",
        "service.notifications.control",
        "service.power.read",
        "service.brightness.read",
        "service.brightness.control",
        "service.apps.read",
        "service.apps.launch",
        "service.session.read",
        "service.session.control",
        "service.display.read",
        "service.display.control",
        "service.input.read",
        "service.input.control",
        "service.power-profile.read",
        "service.power-profile.control",
        "service.time.read",
        "service.time.control",
        "service.idle.read",
        "service.idle.control",
        "service.network-details.read",
        "service.network-details.control",
        "service.hardware.read",
        "service.hardware.control",
        "service.audio-devices.read",
        "service.audio-devices.control"
      ],
      "modules": {
        "@mesh/shell-ui-interface": ">=1.0.0",
        "@mesh/glass-material": ">=0.1.0",
        "@mesh/glass-controls": ">=0.1.0",
        "@mesh/volume-presentation": ">=0.1.0"
      }
    },
    "i18n": {
      "defaultLocale": "en"
    },
    "entry": "src/main.mesh",
    "iconRequirements": {
      "required": [
        "preferences-system",
        "settings",
        "wifi",
        "bluetooth",
        "computer",
        "applications-graphics",
        "audio-volume-muted",
        "audio-volume-low",
        "audio-volume-medium",
        "audio-volume-high",
        "window-close",
        "window-new",
        "window-restore",
        "input-keyboard",
        "lock",
        "video-display",
        "input-mouse",
        "battery-good",
        "notifications",
        "preferences-desktop-locale",
        "preferences-desktop-accessibility",
        "applications-all",
        "security-high",
        "view-grid",
        "system-users"
      ]
    },
    "surface": {
      "role": "layer",
      "promotable": true,
      "anchor": "right",
      "layer": "overlay",
      "keyboard_mode": "on_demand",
      "title": {
        "t": "settings.title",
        "fallback": "Settings"
      },
      "appId": "mesh.settings",
      "visible_on_start": false
    },
    "contributes": {
      "i18n": [
        {
          "id": "en",
          "locale": "en",
          "path": "config/i18n/en.json"
        },
        {
          "id": "sk",
          "locale": "sk",
          "path": "config/i18n/sk.json"
        }
      ]
    },
    "accessibility": {
      "role": "dialog",
      "label": "Settings",
      "description": "Manage connectivity, audio, appearance, device details, modules, and providers"
    },
    "hosts": {
      "mesh.settings.page": {
        "version": ">=1.0",
        "layout": "column"
      }
    }
  }
}
