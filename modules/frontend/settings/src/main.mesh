<template>
    <dialog class="settings-shell" aria-label={t('settings.title')}>
        <row class="settings-layout">
            <column class="settings-sidebar">
                <row class="settings-brand">
                    <box class="brand-mark">
                        <icon name="preferences-system" size="20" />
                    </box>
                    <column class="brand-copy">
                        <text class="brand-title">{t('settings.title')}</text>
                        <text class="brand-subtitle">{t('settings.control_center')}</text>
                    </column>
                </row>

                <column class="settings-navigation" aria-label={t('settings.categories')}>
                    <button class={wifi_nav_class} onclick={showWifi} title={t('nav.wifi.tooltip')}>
                        <icon name="wifi" size="18" />
                        <column class="nav-copy">
                            <text class="nav-title">{t('nav.wifi')}</text>
                            <text class="nav-subtitle">{t('nav.wifi.subtitle')}</text>
                        </column>
                    </button>
                    <button class={audio_nav_class} onclick={showAudio} title={t('nav.audio.tooltip')}>
                        <icon name="audio-volume-high" size="18" />
                        <column class="nav-copy">
                            <text class="nav-title">{t('nav.audio')}</text>
                            <text class="nav-subtitle">{t('nav.audio.subtitle')}</text>
                        </column>
                    </button>
                    <button class={bluetooth_nav_class} onclick={showBluetooth} title={t('nav.bluetooth.tooltip')}>
                        <icon name="bluetooth" size="18" />
                        <column class="nav-copy">
                            <text class="nav-title">{t('nav.bluetooth')}</text>
                            <text class="nav-subtitle">{t('nav.bluetooth.subtitle')}</text>
                        </column>
                    </button>
                    <button class={appearance_nav_class} onclick={showAppearance} title={t('nav.appearance.tooltip')}>
                        <icon name="applications-graphics" size="18" />
                        <column class="nav-copy">
                            <text class="nav-title">{t('nav.appearance')}</text>
                            <text class="nav-subtitle">{t('nav.appearance.subtitle')}</text>
                        </column>
                    </button>
                    <button class={device_nav_class} onclick={showDevice} title={t('nav.device.tooltip')}>
                        <icon name="computer" size="18" />
                        <column class="nav-copy">
                            <text class="nav-title">{t('nav.device')}</text>
                            <text class="nav-subtitle">{t('nav.device.subtitle')}</text>
                        </column>
                    </button>
                    <button class={advanced_nav_class} onclick={showAdvanced} title={t('nav.advanced.tooltip')}>
                        <icon name="settings" size="18" />
                        <column class="nav-copy">
                            <text class="nav-title">{t('nav.advanced')}</text>
                            <text class="nav-subtitle">{t('nav.advanced.subtitle')}</text>
                        </column>
                    </button>
                </column>

                <spacer />

                <column class="sidebar-foot">
                    <text class="sidebar-foot-title">{t('settings.backend_aware')}</text>
                    <text class="sidebar-foot-copy">{t('settings.backend_aware.copy')}</text>
                </column>
            </column>

            <column class="settings-workspace">
                <row class="settings-header">
                    <column class="header-copy">
                        <text class="page-eyebrow">{t('settings.eyebrow')}</text>
                        <text class="page-title">{t(page_title)}</text>
                        <text class="page-subtitle">{t(page_subtitle)}</text>
                    </column>
                    <row class="settings-header-actions">
                        <button class="header-button pop-out-button" onclick={onPopOut} aria-label={t('settings.pop_out')}>
                            <icon name="window-new" size="18" />
                        </button>
                        <button class="header-button dock-back-button" onclick={onDockBack} aria-label={t('settings.dock_back')}>
                            <icon name="window-restore" size="18" />
                        </button>
                        <button class="header-button close-button" onclick={onClose} aria-label={t('settings.close')}>
                            <icon name="window-close" size="18" />
                        </button>
                    </row>
                </row>

                <scroll ref="settings_scroll" class="settings-scroll">
                    <column class="settings-page-stack">
                        <column class="settings-page-slot" hidden={wifi_hidden}>
                            <WifiPage />
                        </column>
                        <column class="settings-page-slot" hidden={audio_hidden}>
                            <AudioPage />
                        </column>
                        <column class="settings-page-slot" hidden={bluetooth_hidden}>
                            <BluetoothPage />
                        </column>
                        <column class="settings-page-slot" hidden={appearance_hidden}>
                            <AppearancePage />
                        </column>
                        <column class="settings-page-slot" hidden={device_hidden}>
                            <DeviceInfoPage />
                        </column>
                        <column class="settings-page-slot" hidden={advanced_hidden}>
                            <AdvancedPage />
                        </column>
                    </column>
                </scroll>
            </column>
        </row>
    </dialog>
</template>

<script lang="luau">
local AdvancedPage = require("./components/advanced-page.mesh")
local AppearancePage = require("./components/appearance-page.mesh")
local AudioPage = require("./components/audio-page.mesh")
local BluetoothPage = require("./components/bluetooth-page.mesh")
local DeviceInfoPage = require("./components/device-info-page.mesh")
local WifiPage = require("./components/wifi-page.mesh")
local t = import("mesh.i18n", "t")

active_page = "wifi"
page_title = "page.wifi.title"
page_subtitle = "page.wifi.subtitle"

wifi_hidden = false
audio_hidden = true
bluetooth_hidden = true
appearance_hidden = true
device_hidden = true
advanced_hidden = true

wifi_nav_class = "settings-nav-item settings-nav-item-active"
audio_nav_class = "settings-nav-item"
bluetooth_nav_class = "settings-nav-item"
appearance_nav_class = "settings-nav-item"
device_nav_class = "settings-nav-item"
advanced_nav_class = "settings-nav-item"

local function page_copy(page)
    local key = "page." .. tostring(page or "wifi")
    return {
        title = key .. ".title",
        subtitle = key .. ".subtitle",
    }
end

local function activate(page)
    active_page = page
    local copy = page_copy(page)
    page_title = copy.title
    page_subtitle = copy.subtitle

    wifi_hidden = page ~= "wifi"
    audio_hidden = page ~= "audio"
    bluetooth_hidden = page ~= "bluetooth"
    appearance_hidden = page ~= "appearance"
    device_hidden = page ~= "device"
    advanced_hidden = page ~= "advanced"

    wifi_nav_class = page == "wifi" and "settings-nav-item settings-nav-item-active" or "settings-nav-item"
    audio_nav_class = page == "audio" and "settings-nav-item settings-nav-item-active" or "settings-nav-item"
    bluetooth_nav_class = page == "bluetooth" and "settings-nav-item settings-nav-item-active" or "settings-nav-item"
    appearance_nav_class = page == "appearance" and "settings-nav-item settings-nav-item-active" or "settings-nav-item"
    device_nav_class = page == "device" and "settings-nav-item settings-nav-item-active" or "settings-nav-item"
    advanced_nav_class = page == "advanced" and "settings-nav-item settings-nav-item-active" or "settings-nav-item"

    refs.settings_scroll:scroll_to(0)
end

function render()
    local copy = page_copy(active_page)
    page_title = copy.title
    page_subtitle = copy.subtitle
end

function showWifi() activate("wifi") end
function showAudio() activate("audio") end
function showBluetooth() activate("bluetooth") end
function showAppearance() activate("appearance") end
function showDevice() activate("device") end
function showAdvanced() activate("advanced") end

function onClose()
    mesh.events.publish("shell.hide-surface", { surface_id = "@mesh/settings" })
end

-- Move this surface between shell chrome and an ordinary compositor window.
-- The component keeps running across the change: same VM, same page selection,
-- same scroll position and service subscriptions — only the Wayland object is
-- swapped, so these handlers state the target role and nothing else.
function onPopOut()
    mesh.events.publish("shell.set-surface-role", {
        surface_id = "@mesh/settings",
        role = "window",
    })
end

function onDockBack()
    mesh.events.publish("shell.set-surface-role", {
        surface_id = "@mesh/settings",
        role = "layer",
    })
end
</script>

<style>
    /* This surface is `promotable`: it starts as shell chrome anchored to the
       right edge and can be popped out into an ordinary window. The size below
       means different things in the two roles — as a layer surface MESH tells
       the compositor this size; as a window it is only the initial request,
       which the compositor answers and may override (fullscreen, maximize,
       tiling, interactive resize). The state rules further down handle the
       cases where it does. */
    .settings-shell {
        margin: 12px 12px 12px 0;
        exclusive-zone: none;
        width: 920px;
        height: 700px;
        min-width: 920px;
        min-height: 700px;
        background: var(--color-surface);
        color: var(--color-on-surface);
        border-width: 1px;
        border-style: solid;
        border-color: var(--color-outline-variant);
        border-radius: var(--radius-lg);
    }

    /* Popped out into a window: square off the corners. A floating layer
       surface reads as chrome sitting over the desktop, but a window with
       client-side decorations owns its whole rectangle, and rounded corners
       there fight whatever the compositor draws around it. */
    .settings-shell:windowed {
        border-radius: 0;
    }

    /* Filling the output: take the compositor's size, and drop the border and
       corner treatment that only make sense on a floating window. */
    .settings-shell:fullscreen,
    .settings-shell:maximized {
        width: 100%;
        height: 100%;
        min-width: 0;
        min-height: 0;
        border-width: 0;
        border-radius: 0;
    }

    /* Tiled edges abut a neighbour: take the tile, and drop the floating
       minimum so a narrow tile is not overflowed by it. */
    .settings-shell:tiled {
        width: 100%;
        height: 100%;
        min-width: 0;
        min-height: 0;
        border-radius: 0;
    }

    .settings-layout {
        width: 100%;
        height: 100%;
        min-width: 0;
    }

    .settings-sidebar {
        width: 250px;
        height: 100%;
        flex-shrink: 0;
        gap: var(--spacing-lg);
        padding: var(--spacing-lg);
        background: var(--color-surface-container-low);
        border-right-width: 1px;
        border-right-style: solid;
        border-right-color: var(--color-outline-variant);
    }

    .settings-brand {
        width: 100%;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .brand-mark {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-md);
        background: var(--color-primary);
        color: var(--color-on-primary);
    }

    .brand-copy,
    .nav-copy,
    .header-copy,
    .settings-page,
    .settings-section,
    .settings-card-copy,
    .sidebar-foot {
        gap: var(--spacing-xs);
    }

    .brand-title {
        color: var(--color-on-surface);
        font-size: var(--typography-size-md);
        font-weight: 750;
    }

    .brand-subtitle,
    .nav-subtitle,
    .page-subtitle,
    .sidebar-foot-copy,
    .settings-muted,
    .settings-card-meta {
        height: auto;
        flex-shrink: 0;
        color: var(--color-on-surface-variant);
        font-size: var(--typography-size-xs);
    }

    .settings-navigation {
        width: 100%;
        gap: var(--spacing-xs);
    }

    .settings-nav-item {
        width: 100%;
        min-height: 56px;
        align-items: center;
        justify-content: flex-start;
        gap: var(--spacing-sm);
        padding-inline: var(--spacing-sm);
        padding-block: var(--spacing-xs);
        border-radius: var(--radius-md);
        border-width: 0;
        background: transparent;
        color: var(--color-on-surface-variant);
        text-align: left;
        transition: background-color var(--animation-duration-short) var(--animation-curves-bezier-standard),
                    color var(--animation-duration-short) var(--animation-curves-bezier-standard);
    }

    .settings-nav-item:hover {
        background: var(--color-surface-container-high);
        color: var(--color-on-surface);
    }

    .settings-nav-item-active {
        background: var(--color-secondary-container);
        color: var(--color-on-secondary-container);
    }

    .nav-title {
        color: inherit;
        font-size: var(--typography-size-sm);
        font-weight: 700;
    }

    .nav-subtitle {
        color: inherit;
        opacity: 0.75;
    }

    .sidebar-foot {
        width: 100%;
        padding: var(--spacing-md);
        border-radius: var(--radius-md);
        background: var(--color-surface-container);
    }

    .sidebar-foot-title {
        color: var(--color-on-surface);
        font-size: var(--typography-size-xs);
        font-weight: 700;
        text-transform: uppercase;
    }

    .settings-workspace {
        min-width: 0;
        height: 100%;
        flex-grow: 1;
    }

    .settings-header {
        width: 100%;
        min-height: 112px;
        align-items: center;
        justify-content: space-between;
        gap: var(--spacing-lg);
        padding-inline: 28px;
        padding-block: var(--spacing-lg);
        border-bottom-width: 1px;
        border-bottom-style: solid;
        border-bottom-color: var(--color-outline-variant);
    }

    .page-eyebrow {
        color: var(--color-primary);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.4px;
    }

    .page-title {
        height: auto;
        flex-shrink: 0;
        color: var(--color-on-surface);
        font-size: 26px;
        font-weight: 750;
    }

    .header-button {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-full);
        border-width: 0;
        background: var(--color-surface-container);
        color: var(--color-on-surface-variant);
    }

    .header-button:hover {
        background: var(--color-surface-container-high);
        color: var(--color-on-surface);
    }

    .settings-header-actions {
        align-items: center;
        gap: var(--spacing-xs);
    }

    .close-button:hover {
        background: var(--color-error-container);
        color: var(--color-on-error-container);
    }

    /* The role controls which of the two is present. `display: none` takes the
       hidden one out of layout entirely, so it is not clickable either — the
       header always offers exactly the move that is available. */
    .dock-back-button {
        display: none;
    }

    .pop-out-button:windowed {
        display: none;
    }

    .dock-back-button:windowed {
        display: flex;
    }

    .settings-scroll {
        width: 100%;
        min-height: 0;
        flex-grow: 1;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .settings-page-stack {
        width: 100%;
        padding: 28px;
    }

    .settings-page-slot {
        width: 100%;
    }

    .settings-page {
        width: 100%;
        gap: var(--spacing-lg);
    }

    .settings-section {
        width: 100%;
        gap: var(--spacing-sm);
    }

    .settings-section-head,
    .settings-control-row,
    .settings-card,
    .settings-card-head,
    .settings-info-row {
        width: 100%;
        align-items: center;
        justify-content: space-between;
        gap: var(--spacing-md);
    }

    .settings-section-title,
    .settings-control-title,
    .settings-card-title {
        color: var(--color-on-surface);
        font-size: var(--typography-size-sm);
        font-weight: 700;
    }

    .settings-section-copy {
        height: auto;
        flex-shrink: 0;
        color: var(--color-on-surface-variant);
        font-size: var(--typography-size-xs);
        line-height: 1.45;
    }

    .settings-card,
    .settings-control-row,
    .settings-empty-state {
        width: 100%;
        padding: var(--spacing-md);
        border-radius: var(--radius-md);
        border-width: 1px;
        border-style: solid;
        border-color: var(--color-outline-variant);
        background: var(--color-surface-container-low);
    }

    .settings-card-copy {
        min-width: 0;
        flex-grow: 1;
    }

    .settings-empty-state {
        gap: var(--spacing-sm);
        align-items: center;
        justify-content: center;
        min-height: 116px;
        text-align: center;
    }

    .settings-status-pill {
        flex-shrink: 0;
        padding-inline: var(--spacing-sm);
        padding-block: var(--spacing-xs);
        border-radius: var(--radius-full);
        background: var(--color-surface-container-high);
        color: var(--color-on-surface-variant);
        font-size: var(--typography-size-xs);
        font-weight: 700;
    }

    .settings-status-pill-active {
        background: var(--color-tertiary-container);
        color: var(--color-on-tertiary-container);
    }

    .settings-primary-button,
    .settings-secondary-button,
    .settings-danger-button {
        min-height: 34px;
        flex-shrink: 0;
        padding-inline: var(--spacing-md);
        border-radius: var(--radius-sm);
        font-size: var(--typography-size-xs);
        font-weight: 700;
    }

    .settings-primary-button {
        border-width: 0;
        background: var(--color-primary);
        color: var(--color-on-primary);
    }

    .settings-secondary-button {
        border-width: 1px;
        border-style: solid;
        border-color: var(--color-outline-variant);
        background: var(--color-surface-container);
        color: var(--color-on-surface);
    }

    .settings-danger-button {
        border-width: 0;
        background: var(--color-error-container);
        color: var(--color-on-error-container);
    }

    .settings-list {
        width: 100%;
        gap: var(--spacing-sm);
    }

    .settings-slider {
        min-width: 240px;
        flex-grow: 1;
    }

    .settings-value {
        min-width: 48px;
        color: var(--color-on-surface);
        font-size: var(--typography-size-sm);
        font-weight: 750;
        text-align: right;
    }

    .settings-info-label {
        color: var(--color-on-surface-variant);
        font-size: var(--typography-size-xs);
    }

    .settings-info-value {
        color: var(--color-on-surface);
        font-size: var(--typography-size-xs);
        font-weight: 650;
        text-align: right;
    }
</style>
