<template>
    <dialog class="settings-shell" aria-label={t('settings.title')}>
        <row class="settings-layout">
            <column class="settings-sidebar">
                <text class="sidebar-title">{t('settings.title')}</text>
                <input class="sidebar-search" value={search_query} oninput={onSearch} placeholder={t('settings.search')} aria-label={t('settings.search')} />

                <column class="sidebar-scroll">
                    <tabs class="sidebar-groups" aria-label={t('settings.categories')} aria-orientation="vertical">
                        <column class="settings-navigation">
                        <tab class="settings-nav-item" selected={active_page == "wifi"} hidden={not nav_visible("wifi")} onactivate={showWifi} title={t('nav.wifi.tooltip')}>
                            <box class="nav-tile nav-tile-blue"><icon class="nav-icon" name="wifi" size="16" /></box>
                            <text class="nav-title">{t('nav.wifi')}</text>
                        </tab>
                        <tab class="settings-nav-item" selected={active_page == "audio"} hidden={not nav_visible("audio")} onactivate={showAudio} title={t('nav.audio.tooltip')}>
                            <box class="nav-tile nav-tile-red"><icon class="nav-icon" name="audio-volume-high" size="16" /></box>
                            <text class="nav-title">{t('nav.audio')}</text>
                        </tab>
                        <tab class="settings-nav-item" selected={active_page == "bluetooth"} hidden={not nav_visible("bluetooth")} onactivate={showBluetooth} title={t('nav.bluetooth.tooltip')}>
                            <box class="nav-tile nav-tile-indigo"><icon class="nav-icon" name="bluetooth" size="16" /></box>
                            <text class="nav-title">{t('nav.bluetooth')}</text>
                        </tab>
                        </column>
                        <column class="settings-navigation">
                        <tab class="settings-nav-item" selected={active_page == "appearance"} hidden={not nav_visible("appearance")} onactivate={showAppearance} title={t('nav.appearance.tooltip')}>
                            <box class="nav-tile nav-tile-purple"><icon class="nav-icon" name="applications-graphics" size="16" /></box>
                            <text class="nav-title">{t('nav.appearance')}</text>
                        </tab>
                        <tab class="settings-nav-item" selected={active_page == "device"} hidden={not nav_visible("device")} onactivate={showDevice} title={t('nav.device.tooltip')}>
                            <box class="nav-tile nav-tile-green"><icon class="nav-icon" name="computer" size="16" /></box>
                            <text class="nav-title">{t('nav.device')}</text>
                        </tab>
                        <tab class="settings-nav-item" selected={active_page == "keyboard"} hidden={not nav_visible("keyboard")} onactivate={showKeyboard} title={t('nav.keyboard.tooltip')}>
                            <box class="nav-tile nav-tile-orange"><icon class="nav-icon" name="input-keyboard" size="16" /></box>
                            <text class="nav-title">{t('nav.keyboard')}</text>
                        </tab>
                        <tab class="settings-nav-item" selected={active_page == "advanced"} hidden={not nav_visible("advanced")} onactivate={showAdvanced} title={t('nav.advanced.tooltip')}>
                            <box class="nav-tile nav-tile-grey"><icon class="nav-icon" name="settings" size="16" /></box>
                            <text class="nav-title">{t('nav.advanced')}</text>
                        </tab>
                        </column>
                    </tabs>
                </column>
            </column>

            <column class="settings-workspace">
                <row class="settings-header">
                    <column class="header-copy">
                        <text class="page-title">{t('page.' .. active_page .. '.title')}</text>
                        <text class="page-subtitle">{t('page.' .. active_page .. '.subtitle')}</text>
                    </column>
                    <row class="settings-header-actions">
                        <button class="header-button pop-out-button" onclick={onPopOut} aria-label={t('settings.pop_out')}>
                            <icon class="header-glyph" name="window-new" size="10" />
                        </button>
                        <button class="header-button dock-back-button" onclick={onDockBack} aria-label={t('settings.dock_back')}>
                            <icon class="header-glyph" name="window-restore" size="10" />
                        </button>
                        <button class="header-button close-button" onclick={onClose} aria-label={t('settings.close')}>
                            <icon class="header-glyph" name="window-close" size="10" />
                        </button>
                    </row>
                </row>

                <scroll ref="settings_scroll" class="settings-scroll">
                    <column class="settings-page-stack">
                        <column class="settings-page-slot" hidden={active_page ~= "wifi"}>
                            <WifiPage />
                        </column>
                        <column class="settings-page-slot" hidden={active_page ~= "audio"}>
                            <AudioPage />
                        </column>
                        <column class="settings-page-slot" hidden={active_page ~= "bluetooth"}>
                            <BluetoothPage />
                        </column>
                        <column class="settings-page-slot" hidden={active_page ~= "appearance"}>
                            <AppearancePage />
                        </column>
                        <column class="settings-page-slot" hidden={active_page ~= "device"}>
                            <DeviceInfoPage />
                        </column>
                        <column class="settings-page-slot" hidden={active_page ~= "keyboard"}>
                            <KeyboardPage />
                        </column>
                        <column class="settings-page-slot" hidden={active_page ~= "advanced"}>
                            <AdvancedPage />
                        </column>
                    </column>
                </scroll>
            </column>
        </row>
    </dialog>
</template>

<script lang="luau">
local AdvancedPage = require("./components/advanced-page.mesh")
local AppearancePage = require("./components/appearance-page.mesh")
local AudioPage = require("./components/audio-page.mesh")
local BluetoothPage = require("./components/bluetooth-page.mesh")
local DeviceInfoPage = require("./components/device-info-page.mesh")
local KeyboardPage = require("./components/keyboard-page.mesh")
local WifiPage = require("./components/wifi-page.mesh")
local t = import("mesh.i18n", "t")

-- The active page drives the nav highlight, the visible page slot and the
-- header copy straight from the template.
active_page = "wifi"

search_query = ""

function onSearch(value)
    search_query = string.lower(tostring(type(value) == "table" and value.value or value or ""))
end

-- A page matches when the query appears in its localized name or subtitle.
function nav_visible(page)
    if search_query == "" then return true end
    local haystack = string.lower(t("nav." .. page) .. " " .. t("nav." .. page .. ".subtitle"))
    return string.find(haystack, search_query, 1, true) ~= nil
end

local function activate(page)
    active_page = page
    refs.settings_scroll:scroll_to(0)
end

function showWifi() activate("wifi") end
function showAudio() activate("audio") end
function showBluetooth() activate("bluetooth") end
function showAppearance() activate("appearance") end
function showDevice() activate("device") end
function showKeyboard() activate("keyboard") end
function showAdvanced() activate("advanced") end

function onClose()
    mesh.shell.hide_surface("@mesh/settings")
end

-- Move this surface between shell chrome and an ordinary compositor window.
-- The component keeps running across the change: same VM, same page selection,
-- same scroll position and service subscriptions — only the Wayland object is
-- swapped, so these handlers state the target role and nothing else.
function onPopOut()
    mesh.shell.set_surface_role("@mesh/settings", "window")
end

function onDockBack()
    mesh.shell.set_surface_role("@mesh/settings", "layer")
end
</script>

<style>
    /* This surface is `promotable`: it starts as shell chrome anchored to the
       right edge and can be popped out into an ordinary window. The size below
       means different things in the two roles — as a layer surface MESH tells
       the compositor this size; as a window it is only the initial request,
       which the compositor answers and may override (fullscreen, maximize,
       tiling, interactive resize). The state rules further down handle the
       cases where it does. */
    .settings-shell {
        margin: 12px;
        exclusive-zone: none;
        width: 920px;
        height: 700px;
        /* The size above is a request. A compositor that configures less (an
           output narrower than 920px) gets a layout that fits, not one the
           surface clips. */
        max-width: 100%;
        max-height: 100%;
        background: transparent;
        background-image: var(--glass-settings-surface);
        backdrop-filter: var(--glass-backdrop-panel);
        box-shadow: var(--glass-shadow-card);
        color: var(--glass-settings-text);
        border-width: 1px;
        border-style: solid;
        border-color: var(--glass-rim);
        border-radius: var(--radius-lg);
    }

    /* Popped out into a window: fill the size the compositor configured and
       square off the corners. A floating layer surface reads as chrome sitting
       over the desktop, but a window with client-side decorations owns its
       whole rectangle, and rounded corners there fight whatever the compositor
       draws around it. The chrome margin goes too: inside a window it would
       leave an uneven inset that the compositor's own rounding then cuts. */
    .settings-shell:windowed {
        width: 100%;
        height: 100%;
        margin: 0;
        border-radius: 0;
    }

    /* Filling the output: take the compositor's size, and drop the border and
       corner treatment that only make sense on a floating window. */
    .settings-shell:fullscreen,
    .settings-shell:maximized {
        width: 100%;
        height: 100%;
        min-width: 0;
        min-height: 0;
        border-width: 0;
        border-radius: 0;
    }

    /* Tiled edges abut a neighbour: take the tile, and drop the floating
       minimum so a narrow tile is not overflowed by it. */
    .settings-shell:tiled {
        width: 100%;
        height: 100%;
        min-width: 0;
        min-height: 0;
        border-radius: 0;
    }

    .settings-layout {
        width: 100%;
        height: 100%;
        min-width: 0;
    }

    .settings-sidebar {
        width: 250px;
        height: 100%;
        flex-shrink: 0;
        gap: var(--spacing-lg);
        padding: var(--spacing-lg);
        background: var(--glass-settings-inset);
        border-right-width: 1px;
        border-right-style: solid;
        border-right-color: var(--glass-settings-rim);
        /* The shell does not clip its children, so the sidebar fill follows
           the shell's left corners itself. */
        border-top-left-radius: var(--radius-lg);
        border-bottom-left-radius: var(--radius-lg);
    }

    .settings-sidebar:windowed {
        border-radius: 0;
    }

    .brand-copy,
    .nav-copy,
    .header-copy,
    .settings-page,
    .settings-section,
    .settings-card-copy,
    .page-subtitle,
    .settings-muted,
    .settings-card-meta {
        height: auto;
        flex-shrink: 0;
        color: var(--glass-settings-text-muted);
        font-size: var(--typography-size-xs);
    }

    /* Each page has a coloured tile, as in the system settings the glass
       shell follows. The longest subtitle ("Blízke a spárované zariadenia")
       otherwise squeezes the tile to nothing. */
    .nav-tile {
        width: 26px;
        height: 26px;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        background: var(--color-primary);
    }

    .nav-tile-red { background: var(--color-error-container); }
    .nav-tile-indigo { background: var(--color-info-container); }
    .nav-tile-purple { background: var(--color-tertiary-container); }
    .nav-tile-green { background: var(--color-success-container); }
    .nav-tile-orange { background: var(--color-warning-container); }
    .nav-tile-grey { background: var(--color-outline); }

    .nav-icon {
        flex-shrink: 0;
        background: transparent;
        color: var(--color-on-primary);
    }

    .sidebar-title {
        height: auto;
        flex-shrink: 0;
        color: var(--glass-settings-text);
        font-size: 26px;
        font-weight: 750;
    }

    .sidebar-search {
        width: 100%;
        height: 36px;
        flex-shrink: 0;
        padding-inline: var(--spacing-md);
        border-radius: var(--radius-full);
        border-width: 1px;
        border-style: solid;
        border-color: var(--glass-settings-rim);
        background: var(--glass-settings-inset);
        color: var(--glass-settings-text);
        font-size: var(--typography-size-sm);
    }

    .sidebar-search:hover {
        border-color: var(--glass-control-rim-hover);
    }

    .sidebar-search:focus-visible {
        border-color: var(--glass-control-rim-focus);
    }

    .sidebar-scroll {
        width: 100%;
        min-height: 0;
        flex-grow: 1;
    }

    .sidebar-groups {
        width: 100%;
        flex-direction: column;
        gap: var(--spacing-md);
    }

    .settings-navigation {
        width: 100%;
        flex-direction: column;
        gap: var(--spacing-xs);
        padding: var(--spacing-xs);
        border-radius: var(--radius-lg);
        border-width: 1px;
        border-style: solid;
        border-color: var(--glass-settings-rim);
        background: var(--glass-settings-inset);
    }

    .settings-nav-item {
        flex-direction: row;
        width: 100%;
        min-height: 44px;
        align-items: center;
        justify-content: flex-start;
        gap: var(--spacing-sm);
        padding-inline: var(--spacing-sm);
        padding-block: var(--spacing-xs);
        border-radius: var(--radius-md);
        border-width: 1px;
        border-style: solid;
        border-color: transparent;
        background: transparent;
        color: var(--glass-settings-text-muted);
        text-align: left;
        transition: background-color var(--animation-duration-short) var(--animation-curves-bezier-standard),
                    border-color var(--animation-duration-short) var(--animation-curves-bezier-standard);
    }

    .settings-nav-item:hover {
        background: var(--glass-control-fill-hover);
    }

    .settings-nav-item:active {
        background: var(--glass-control-fill-pressed);
    }

    .settings-nav-item:focus-visible {
        border-color: var(--glass-control-rim-focus);
    }

    .settings-nav-item:selected {
        background: transparent;
        background-image: var(--glass-settings-selected);
        border-color: var(--glass-control-rim);
        color: var(--glass-settings-text);
    }

    .nav-title {
        height: auto;
        flex-shrink: 0;
        color: inherit;
        font-size: var(--typography-size-sm);
        font-weight: 700;
    }

    .sidebar-foot {
        width: 100%;
        padding: var(--spacing-md);
        border-radius: var(--radius-md);
        background: var(--glass-settings-inset);
    }

    .settings-workspace {
        min-width: 0;
        height: 100%;
        flex-grow: 1;
    }

    .settings-header {
        width: 100%;
        min-height: 96px;
        align-items: center;
        justify-content: space-between;
        gap: var(--spacing-lg);
        padding-inline: 28px;
        padding-block: var(--spacing-lg);
    }

    .page-title {
        height: auto;
        flex-shrink: 0;
        color: var(--glass-settings-text);
        font-size: 26px;
        font-weight: 750;
    }

    /* Window controls are small coloured dots; the glyph only hints at the
       action, the accessible label carries it. */
    .header-button {
        width: 14px;
        height: 14px;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-full);
        border-width: 1px;
        border-style: solid;
        border-color: #00000014;
        background: var(--color-success);
        transition: opacity var(--animation-duration-short) var(--animation-curves-bezier-standard);
    }

    .header-button:hover {
        opacity: 0.85;
    }

    .header-button:active {
        opacity: 0.7;
    }

    .header-glyph {
        color: #00000080;
    }

    .dock-back-button {
        background: var(--color-warning);
    }

    .settings-header-actions {
        align-self: flex-start;
        align-items: center;
        gap: 8px;
    }

    .close-button {
        background: var(--color-error);
    }

    /* The role controls which of the two is present. `display: none` takes the
       hidden one out of layout entirely, so it is not clickable either — the
       header always offers exactly the move that is available. */
    .dock-back-button {
        display: none;
    }

    .pop-out-button:windowed {
        display: none;
    }

    .dock-back-button:windowed {
        display: flex;
    }

    .settings-scroll {
        width: 100%;
        min-height: 0;
        flex-grow: 1;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .settings-page-stack {
        width: 100%;
        padding: 28px;
    }

    .settings-page-slot {
        width: 100%;
    }

    .settings-page {
        width: 100%;
        gap: var(--spacing-lg);
    }

    .settings-section {
        width: 100%;
        gap: var(--spacing-sm);
    }

    .settings-section-head,
    .settings-control-row,
    .settings-card,
    .settings-card-head,
    .settings-info-row {
        width: 100%;
        align-items: center;
        justify-content: space-between;
        gap: var(--spacing-md);
    }

    .settings-section-title,
    .settings-control-title,
    .settings-card-title {
        color: var(--glass-settings-text);
        font-size: var(--typography-size-sm);
        font-weight: 700;
    }

    .settings-section-title {
        color: var(--glass-settings-text-muted);
        font-size: var(--typography-size-xs);
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .settings-section-copy {
        height: auto;
        flex-shrink: 0;
        color: var(--glass-settings-text-muted);
        font-size: var(--typography-size-xs);
        line-height: 1.45;
    }

    .settings-card,
    .settings-control-row,
    .settings-empty-state {
        width: 100%;
        padding: var(--spacing-md);
        border-radius: var(--radius-md);
        border-width: 1px;
        border-style: solid;
        border-color: var(--glass-settings-rim);
        background: var(--glass-settings-inset);
        transition: background-color var(--animation-duration-short) var(--animation-curves-bezier-standard),
                    border-color var(--animation-duration-short) var(--animation-curves-bezier-standard);
    }

    list-item.settings-card:hover {
        background-image: linear-gradient(to bottom, var(--glass-control-fill-hover), var(--glass-control-fill-hover));
        border-color: var(--glass-control-rim-hover);
    }

    list-item.settings-card:focus-visible {
        border-color: var(--glass-control-rim-focus);
    }

    .settings-card-copy {
        min-width: 0;
        flex-grow: 1;
    }

    /* Icon, title and copy stack: laid out as a centred row, long copy ran
       past both edges of the card. */
    .settings-empty-state {
        flex-direction: column;
        gap: var(--spacing-sm);
        align-items: center;
        justify-content: center;
        min-height: 116px;
        text-align: center;
    }

    .settings-status-pill {
        flex-shrink: 0;
        padding-inline: var(--spacing-sm);
        padding-block: var(--spacing-xs);
        border-radius: var(--radius-full);
        background: var(--glass-hover);
        color: var(--glass-settings-text-muted);
        font-size: var(--typography-size-xs);
        font-weight: 700;
    }

    .settings-status-pill-active {
        background: var(--color-tertiary-container);
        color: var(--color-on-tertiary-container);
    }

    .settings-list {
        width: 100%;
        gap: var(--spacing-sm);
    }

    .settings-slider {
        min-width: 240px;
        flex-grow: 1;
    }

    .settings-value {
        min-width: 48px;
        color: var(--glass-settings-text);
        font-size: var(--typography-size-sm);
        font-weight: 750;
        text-align: right;
    }

    .settings-info-label {
        color: var(--glass-settings-text-muted);
        font-size: var(--typography-size-xs);
    }

    .settings-info-value {
        color: var(--glass-settings-text);
        font-size: var(--typography-size-xs);
        font-weight: 650;
        text-align: right;
    }
</style>
