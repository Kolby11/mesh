<props>
{
    clock_24h = { type = "bool", default = true },
    first_day = { type = "enum", options = { "monday", "sunday", "saturday" }, default = "monday" },
    show_battery_percent = { type = "bool", default = true },
    low_battery_percent = { type = "int", default = 15, min = 5, max = 50 },
    reduce_motion = { type = "bool", default = false },
    high_contrast = { type = "bool", default = false },
    -- Legacy flag for profiles saved before the transparency mask had its own layer.
    reduce_transparency = { type = "bool", default = false },
}
</props>

<template>
    <dialog class="settings-shell" aria-label={t('settings.title')}
        style:--settings-output-width={layer_width} style:--settings-output-height={layer_height}>
        <row class="settings-toolbar">
            <text class="sidebar-title">{t('settings.title')}</text>
            <input class="sidebar-search" value={search_query} oninput={onSearch} placeholder={t('settings.search')} aria-label={t('settings.search')} />
            <box class="settings-toolbar-spacer" aria-hidden="true" />
            <row class="settings-header-actions">
                <button class="header-button pop-out-button" onclick={onPopOut} aria-label={t('settings.pop_out')}>
                    <icon class="header-glyph" name="window-new" size="16" />
                </button>
                <button class="header-button dock-back-button" onclick={onDockBack} aria-label={t('settings.dock_back')}>
                    <icon class="header-glyph" name="window-restore" size="16" />
                </button>
                <button class="header-button close-button" onclick={onClose} aria-label={t('settings.close')}>
                    <icon class="header-glyph" name="window-close" size="16" />
                </button>
            </row>
        </row>
        <row class="settings-layout">
            <column class="settings-sidebar">
                <scroll class="sidebar-scroll">
                    <tabs class="sidebar-groups" aria-label={t('settings.categories')} aria-orientation="vertical">
                        <column class="settings-navigation" hidden={not (nav_visible("wifi") or nav_visible("bluetooth"))}>
                            <text class="nav-group-heading">{t('nav.group.connectivity')}</text>
                            <tab class="settings-nav-item" selected={active_page == "wifi"} hidden={not nav_visible("wifi")} onactivate={showWifi} title={t('nav.wifi.tooltip')}>
                                <box class="nav-tile"><icon class="nav-icon" name="wifi" size="16" /></box>
                                <text class="nav-title">{t('nav.wifi')}</text>
                            </tab>
                            <tab class="settings-nav-item" selected={active_page == "bluetooth"} hidden={not nav_visible("bluetooth")} onactivate={showBluetooth} title={t('nav.bluetooth.tooltip')}>
                                <box class="nav-tile"><icon class="nav-icon" name="bluetooth" size="16" /></box>
                                <text class="nav-title">{t('nav.bluetooth')}</text>
                            </tab>
                        </column>
                        <column class="settings-navigation" hidden={not (nav_visible("audio") or nav_visible("display") or nav_visible("keyboard") or nav_visible("pointer") or nav_visible("power"))}>
                            <text class="nav-group-heading">{t('nav.group.devices')}</text>
                            <tab class="settings-nav-item" selected={active_page == "audio"} hidden={not nav_visible("audio")} onactivate={showAudio} title={t('nav.audio.tooltip')}>
                                <box class="nav-tile"><icon class="nav-icon" name="audio-volume-high" size="16" /></box>
                                <text class="nav-title">{t('nav.audio')}</text>
                            </tab>
                            <tab class="settings-nav-item" selected={active_page == "display"} hidden={not nav_visible("display")} onactivate={showDisplay} title={t('nav.display.tooltip')}>
                                <box class="nav-tile"><icon class="nav-icon" name="video-display" size="16" /></box>
                                <text class="nav-title">{t('nav.display')}</text>
                            </tab>
                            <tab class="settings-nav-item" selected={active_page == "keyboard"} hidden={not nav_visible("keyboard")} onactivate={showKeyboard} title={t('nav.keyboard.tooltip')}>
                                <box class="nav-tile"><icon class="nav-icon" name="input-keyboard" size="16" /></box>
                                <text class="nav-title">{t('nav.keyboard')}</text>
                            </tab>
                            <tab class="settings-nav-item" selected={active_page == "pointer"} hidden={not nav_visible("pointer")} onactivate={showPointer} title={t('nav.pointer.tooltip')}>
                                <box class="nav-tile"><icon class="nav-icon" name="input-mouse" size="16" /></box>
                                <text class="nav-title">{t('nav.pointer')}</text>
                            </tab>
                            <tab class="settings-nav-item" selected={active_page == "power"} hidden={not nav_visible("power")} onactivate={showPower} title={t('nav.power.tooltip')}>
                                <box class="nav-tile"><icon class="nav-icon" name="battery-good" size="16" /></box>
                                <text class="nav-title">{t('nav.power')}</text>
                            </tab>
                        </column>
                        <column class="settings-navigation" hidden={not (nav_visible("appearance") or nav_visible("notifications") or nav_visible("language") or nav_visible("accessibility"))}>
                            <text class="nav-group-heading">{t('nav.group.personal')}</text>
                            <tab class="settings-nav-item" selected={active_page == "appearance"} hidden={not nav_visible("appearance")} onactivate={showAppearance} title={t('nav.appearance.tooltip')}>
                                <box class="nav-tile"><icon class="nav-icon" name="applications-graphics" size="16" /></box>
                                <text class="nav-title">{t('nav.appearance')}</text>
                            </tab>
                            <tab class="settings-nav-item" selected={active_page == "notifications"} hidden={not nav_visible("notifications")} onactivate={showNotifications} title={t('nav.notifications.tooltip')}>
                                <box class="nav-tile"><icon class="nav-icon" name="notifications" size="16" /></box>
                                <text class="nav-title">{t('nav.notifications')}</text>
                            </tab>
                            <tab class="settings-nav-item" selected={active_page == "language"} hidden={not nav_visible("language")} onactivate={showLanguage} title={t('nav.language.tooltip')}>
                                <box class="nav-tile"><icon class="nav-icon" name="preferences-desktop-locale" size="16" /></box>
                                <text class="nav-title">{t('nav.language')}</text>
                            </tab>
                            <tab class="settings-nav-item" selected={active_page == "accessibility"} hidden={not nav_visible("accessibility")} onactivate={showAccessibility} title={t('nav.accessibility.tooltip')}>
                                <box class="nav-tile"><icon class="nav-icon" name="preferences-desktop-accessibility" size="16" /></box>
                                <text class="nav-title">{t('nav.accessibility')}</text>
                            </tab>
                        </column>
                        <column class="settings-navigation" hidden={not (nav_visible("apps") or nav_visible("privacy") or nav_visible("shell") or nav_visible("advanced") or nav_visible("users") or nav_visible("device"))}>
                            <text class="nav-group-heading">{t('nav.group.system')}</text>
                            <tab class="settings-nav-item" selected={active_page == "apps"} hidden={not nav_visible("apps")} onactivate={showApps} title={t('nav.apps.tooltip')}>
                                <box class="nav-tile"><icon class="nav-icon" name="applications-all" size="16" /></box>
                                <text class="nav-title">{t('nav.apps')}</text>
                            </tab>
                            <tab class="settings-nav-item" selected={active_page == "privacy"} hidden={not nav_visible("privacy")} onactivate={showPrivacy} title={t('nav.privacy.tooltip')}>
                                <box class="nav-tile"><icon class="nav-icon" name="security-high" size="16" /></box>
                                <text class="nav-title">{t('nav.privacy')}</text>
                            </tab>
                            <tab class="settings-nav-item" selected={active_page == "shell"} hidden={not nav_visible("shell")} onactivate={showShell} title={t('nav.shell.tooltip')}>
                                <box class="nav-tile"><icon class="nav-icon" name="view-grid" size="16" /></box>
                                <text class="nav-title">{t('nav.shell')}</text>
                            </tab>
                            <tab class="settings-nav-item" selected={active_page == "advanced"} hidden={not nav_visible("advanced")} onactivate={showAdvanced} title={t('nav.advanced.tooltip')}>
                                <box class="nav-tile"><icon class="nav-icon" name="settings" size="16" /></box>
                                <text class="nav-title">{t('nav.advanced')}</text>
                            </tab>
                            <tab class="settings-nav-item" selected={active_page == "users"} hidden={not nav_visible("users")} onactivate={showUsers} title={t('nav.users.tooltip')}>
                                <box class="nav-tile"><icon class="nav-icon" name="system-users" size="16" /></box>
                                <text class="nav-title">{t('nav.users')}</text>
                            </tab>
                            <tab class="settings-nav-item" selected={active_page == "device"} hidden={not nav_visible("device")} onactivate={showDevice} title={t('nav.device.tooltip')}>
                                <box class="nav-tile"><icon class="nav-icon" name="computer" size="16" /></box>
                                <text class="nav-title">{t('nav.device')}</text>
                            </tab>
                        </column>
                    </tabs>
                </scroll>
            </column>

            <column class="settings-workspace">
                <scroll ref="settings_scroll" class="settings-scroll">
                    <column class="settings-page-stack">
                        <column class="header-copy">
                            <text class="page-title">{t('page.' .. active_page .. '.title')}</text>
                            <text class="page-subtitle">{t('page.' .. active_page .. '.subtitle')}</text>
                        </column>
                        <column class="settings-page-slot" hidden={active_page ~= "wifi"}>
                            {#if active_page == "wifi"}<PrefsPage page="wifi" />{/if}
                        </column>
                        <column class="settings-page-slot" hidden={active_page ~= "audio"}>
                            {#if active_page == "audio"}<PrefsPage page="audio" />{/if}
                        </column>
                        <column class="settings-page-slot" hidden={active_page ~= "bluetooth"}>
                            {#if active_page == "bluetooth"}<PrefsPage page="bluetooth" />{/if}
                        </column>
                        <column class="settings-page-slot" hidden={active_page ~= "appearance"}>
                            {#if active_page == "appearance"}<AppearancePage />{/if}
                        </column>
                        <column class="settings-page-slot" hidden={active_page ~= "device"}>
                            {#if active_page == "device"}<PrefsPage page="device" />{/if}
                        </column>
                        <column class="settings-page-slot" hidden={active_page ~= "keyboard"}>
                            {#if active_page == "keyboard"}<KeyboardPage />{/if}
                        </column>
                        <column class="settings-page-slot" hidden={active_page ~= "advanced"}>
                            {#if active_page == "advanced"}<AdvancedPage />{/if}
                        </column>
                        <column class="settings-page-slot" hidden={active_page ~= "display"}>
                            {#if active_page == "display"}<PrefsPage page="display" />{/if}
                        </column>
                        <column class="settings-page-slot" hidden={active_page ~= "pointer"}>
                            {#if active_page == "pointer"}<PrefsPage page="pointer" />{/if}
                        </column>
                        <column class="settings-page-slot" hidden={active_page ~= "power"}>
                            {#if active_page == "power"}<PrefsPage page="power" />{/if}
                        </column>
                        <column class="settings-page-slot" hidden={active_page ~= "notifications"}>
                            {#if active_page == "notifications"}<PrefsPage page="notifications" />{/if}
                        </column>
                        <column class="settings-page-slot" hidden={active_page ~= "language"}>
                            {#if active_page == "language"}<PrefsPage page="language" />{/if}
                        </column>
                        <column class="settings-page-slot" hidden={active_page ~= "accessibility"}>
                            {#if active_page == "accessibility"}<PrefsPage page="accessibility" />{/if}
                        </column>
                        <column class="settings-page-slot" hidden={active_page ~= "apps"}>
                            {#if active_page == "apps"}<PrefsPage page="apps" />{/if}
                        </column>
                        <column class="settings-page-slot" hidden={active_page ~= "privacy"}>
                            {#if active_page == "privacy"}<PrefsPage page="privacy" />{/if}
                        </column>
                        <column class="settings-page-slot" hidden={active_page ~= "shell"}>
                            {#if active_page == "shell"}<PrefsPage page="shell" />{/if}
                        </column>
                        <column class="settings-page-slot" hidden={active_page ~= "users"}>
                            {#if active_page == "users"}<PrefsPage page="users" />{/if}
                        </column>
                    </column>
                </scroll>
            </column>
        </row>
    </dialog>
</template>

<script lang="luau">
local AdvancedPage = require("./components/advanced-page.mesh")
local AppearancePage = require("./components/appearance-page.mesh")
local KeyboardPage = require("./components/keyboard-page.mesh")
local PrefsPage = require("./components/prefs-page.mesh")
local raw_t = import("mesh.i18n", "t")
-- An empty or missing key yields no text instead of the "!!" miss marker.
local function t(key, ...)
    if key == nil or key == "" then return "" end
    return raw_t(key, ...)
end

-- The active page drives the nav highlight, the visible page slot and the
-- header copy straight from the template. Only the active page is built, but
-- every page keeps its own slot column: pages that were bare siblings under an
-- {#if} would share child positions, and so node identities, and the engine
-- would animate the previous page's geometry into the next page.
active_page = "wifi"

local display_ok, display = pcall(require, "mesh.display")
if not display_ok then display = nil end
layer_width = nil
layer_height = nil

effect(function()
    local outputs = display and display.available and display.outputs or {}
    -- A layer surface is assigned to an output by the compositor. Only use
    -- the provider's dimensions when the choice is unambiguous.
    local output = #outputs == 1 and outputs[1] or nil
    if output and output.width > 0 and output.height > 0 and output.scale > 0 then
        layer_width = tostring(math.max(1, math.min(1280, math.floor(output.width / output.scale) - 24))) .. "px"
        -- Leave space for an edge panel in addition to the window margins.
        layer_height = tostring(math.max(1, math.min(880, math.floor(output.height / output.scale) - 88))) .. "px"
    else
        layer_width = nil
        layer_height = nil
    end
end)

search_query = ""

function onSearch(value)
    search_query = string.lower(tostring(type(value) == "table" and value.value or value or ""))
end

-- A page matches when the query appears in its localized name or subtitle.
function nav_visible(page)
    if search_query == "" then return true end
    local haystack = string.lower(t("nav." .. page) .. " " .. t("nav." .. page .. ".subtitle"))
    return string.find(haystack, search_query, 1, true) ~= nil
end

local function activate(page)
    active_page = page
    refs.settings_scroll:scroll_to(0)
end

function showWifi() activate("wifi") end
function showAudio() activate("audio") end
function showBluetooth() activate("bluetooth") end
function showAppearance() activate("appearance") end
function showDevice() activate("device") end
function showKeyboard() activate("keyboard") end
function showAdvanced() activate("advanced") end
function showDisplay() activate("display") end
function showPointer() activate("pointer") end
function showPower() activate("power") end
function showNotifications() activate("notifications") end
function showLanguage() activate("language") end
function showAccessibility() activate("accessibility") end
function showApps() activate("apps") end
function showPrivacy() activate("privacy") end
function showShell() activate("shell") end
function showUsers() activate("users") end

function onClose()
    mesh.shell.hide_surface("@mesh/settings")
end

-- Move this surface between shell chrome and an ordinary compositor window.
-- The component keeps running across the change: same VM, same page selection,
-- same scroll position and service subscriptions — only the Wayland object is
-- swapped, so these handlers state the target role and nothing else.
function onPopOut()
    mesh.shell.set_surface_role("@mesh/settings", "window")
end

function onDockBack()
    mesh.shell.set_surface_role("@mesh/settings", "layer")
end
</script>

<style>
    /* This surface is `promotable`: it starts as shell chrome anchored to the
       right edge and can be popped out into an ordinary window. The size below
       means different things in the two roles — as a layer surface MESH tells
       the compositor this size; as a window it is only the initial request,
       which the compositor answers and may override (fullscreen, maximize,
       tiling, interactive resize). The state rules further down handle the
       cases where it does. */
    .settings-shell {
        --settings-output-width: 1280px;
        --settings-output-height: 880px;
        margin: 12px;
        exclusive-zone: none;
        width: var(--settings-output-width);
        height: var(--settings-output-height);
        /* The size above is a request. A compositor that configures less (an
           output narrower than 1280px) gets a layout that fits the configured extent. */
        max-width: 100%;
        max-height: 100%;
        background: transparent;
        background-image: var(--glass-settings-surface);
        backdrop-filter: var(--glass-backdrop-panel);
        box-shadow: var(--glass-shadow-card);
        color: var(--glass-settings-text);
        border-width: var(--glass-border-width);
        border-style: solid;
        border-color: var(--glass-rim);
        border-radius: var(--glass-radius-window);
        flex-direction: column;
    }

    /* Popped out into a window: fill the size the compositor configured and
       square off the corners. A floating layer surface reads as chrome sitting
       over the desktop, but a window with client-side decorations owns its
       whole rectangle, and rounded corners there fight whatever the compositor
       draws around it. The chrome margin goes too: inside a window it would
       leave an uneven inset that the compositor's own rounding then cuts. */
    .settings-shell:windowed {
        width: 100%;
        height: 100%;
        margin: 0;
        border-radius: 0;
    }

    /* Filling the output: take the compositor's size, and drop the border and
       corner treatment that only make sense on a floating window. */
    .settings-shell:fullscreen,
    .settings-shell:maximized {
        width: 100%;
        height: 100%;
        min-width: 0;
        min-height: 0;
        border-width: 0;
        border-radius: 0;
    }

    /* Tiled edges abut a neighbour: take the tile, and drop the floating
       minimum so a narrow tile is not overflowed by it. */
    .settings-shell:tiled {
        width: 100%;
        height: 100%;
        min-width: 0;
        min-height: 0;
        border-radius: 0;
    }

    .settings-layout {
        width: 100%;
        min-height: 0;
        flex-grow: 1;
        min-width: 0;
    }

    .settings-toolbar {
        width: 100%;
        min-height: var(--glass-settings-toolbar-height, 48px);
        flex-shrink: 0;
        align-items: center;
        gap: 16px;
        padding: 4px 14px 4px 18px;
        background: var(--glass-settings-toolbar);
        background-image: var(--glass-settings-toolbar-image);
        border-bottom-width: var(--glass-border-width);
        border-color: var(--glass-settings-rim);
        border-style: solid;
        border-top-left-radius: var(--glass-radius-window);
        border-top-right-radius: var(--glass-radius-window);
    }

    .settings-toolbar:windowed,
    .settings-sidebar:windowed {
        border-radius: 0;
    }

    .settings-sidebar {
        width: 264px;
        flex-shrink: 1;
        max-width: 38%;
        padding: 12px;
        background: var(--glass-settings-sidebar);
        border-right-width: 1px;
        border-right-style: solid;
        border-right-color: var(--glass-settings-rim);
        /* The shell does not clip its children, so the sidebar fill follows
           the shell's left corners itself. */
        border-bottom-left-radius: var(--glass-radius-window);
    }

    .brand-copy,
    .nav-copy,
    .header-copy,
    .settings-page,
    .settings-section,
    .settings-card-copy,
    .page-subtitle,
    .settings-muted,
    .settings-card-meta {
        height: auto;
        flex-shrink: 0;
        color: var(--glass-settings-text-muted);
        font-size: var(--typography-size-xs);
    }

    .nav-tile {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
    }


    .nav-icon {
        flex-shrink: 0;
        background: transparent;
        color: inherit;
    }

    .sidebar-title {
        height: auto;
        flex-shrink: 0;
        color: var(--glass-settings-toolbar-text);
        font-size: 16px;
        font-weight: 700;
        font-family: var(--typography-family-brand);
    }

    .sidebar-search {
        width: 340px;
        min-width: 72px;
        max-width: 55%;
        height: var(--glass-settings-toolbar-control-size, 34px);
        flex-shrink: 1;
        padding-inline: var(--spacing-md);
        border-radius: var(--glass-radius-control);
        border-width: var(--glass-border-width);
        border-style: solid;
        border-color: var(--glass-settings-rim);
        background: var(--glass-settings-inset);
        color: var(--glass-settings-text);
        font-size: var(--typography-size-sm);
    }

    .sidebar-search:hover {
        border-color: var(--glass-control-rim-hover);
    }

    .sidebar-scroll {
        width: 100%;
        min-height: 0;
        flex-grow: 1;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .sidebar-groups {
        width: 100%;
        flex-direction: column;
        gap: 4px;
    }

    .settings-navigation {
        width: 100%;
        flex-direction: column;
        gap: 2px;
        padding: 0 4px 4px 0;
    }

    .nav-group-heading {
        height: auto;
        flex-shrink: 0;
        padding: 8px 10px 2px;
        color: var(--glass-settings-text-muted);
        font-size: 11px;
        font-weight: 700;
        line-height: 1.2;
        text-transform: uppercase;
    }

    .settings-nav-item {
        flex-direction: row;
        width: 100%;
        min-height: 34px;
        align-items: center;
        justify-content: flex-start;
        gap: var(--spacing-sm);
        padding-inline: var(--spacing-sm);
        padding-block: var(--spacing-xs);
        border-radius: var(--glass-radius-control);
        border-width: var(--glass-border-width);
        border-style: solid;
        border-color: transparent;
        background: transparent;
        color: var(--glass-settings-text-muted);
        text-align: left;
        transition: background-color var(--animation-duration-short) var(--animation-curves-bezier-standard),
                    border-color var(--animation-duration-short) var(--animation-curves-bezier-standard);
    }

    .settings-nav-item:hover {
        background: var(--glass-control-fill-hover);
    }

    .settings-nav-item:active {
        background: var(--glass-control-fill-pressed);
    }

    .settings-nav-item:selected {
        background: transparent;
        background-image: var(--glass-settings-navigation-selected);
        border-color: var(--glass-settings-selected-rim);
        color: var(--glass-settings-selected-text);
        box-shadow: var(--glass-settings-selected-shadow);
    }

    .nav-title {
        height: auto;
        flex-shrink: 1;
        color: inherit;
        font-size: var(--typography-size-md);
        font-weight: 600;
    }

    .sidebar-foot {
        width: 100%;
        padding: var(--spacing-md);
        border-radius: var(--radius-md);
        background: var(--glass-settings-inset);
    }

    .settings-workspace {
        min-width: 0;
        height: 100%;
        flex-grow: 1;
    }

    .header-copy {
        gap: 4px;
    }

    .page-subtitle {
        font-size: 13px;
    }

    .page-title {
        height: auto;
        flex-shrink: 0;
        color: var(--glass-settings-text);
        font-size: var(--glass-settings-heading-size);
        font-weight: var(--glass-settings-heading-weight);
        font-family: var(--typography-family-brand);
    }

    .header-button {
        width: 32px;
        height: var(--glass-settings-toolbar-control-size, 32px);
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        border-radius: var(--glass-radius-control);
        border-width: var(--glass-border-width);
        border-style: solid;
        border-color: var(--glass-control-rim);
        background: var(--glass-settings-inset);
        transition: opacity var(--animation-duration-short) var(--animation-curves-bezier-standard);
        box-shadow: var(--glass-control-shadow);
    }

    .header-button:hover {
        opacity: 0.85;
    }

    .header-button:active {
        opacity: 0.7;
    }

    .header-glyph {
        color: var(--glass-settings-text);
    }

    .settings-toolbar-spacer {
        flex-grow: 1;
        min-width: 0;
    }

    .settings-header-actions {
        flex-shrink: 0;
        align-items: center;
        gap: 8px;
    }

    /* The role controls which of the two is present. `display: none` takes the
       hidden one out of layout entirely, so it is not clickable either — the
       header always offers exactly the move that is available. */
    .dock-back-button {
        display: none;
    }

    .pop-out-button:windowed {
