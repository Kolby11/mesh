<template>
    <column class="settings-page" hidden={hidden}>
        <row class="settings-control-row">
            <column class="settings-card-copy">
                <text class="settings-control-title">{t('audio.service')}</text>
                <text class="settings-card-meta">{t(audio_status)}</text>
            </column>
            <text class="settings-status-pill" class:settings-status-pill-active={service_active}>{t(service_pill)}</text>
        </row>

        <column class="settings-section">
            <row class="settings-section-head">
                <column class="settings-card-copy">
                    <text class="settings-section-title">{t('audio.volume')}</text>
                    <text class="settings-section-copy">{t('audio.volume.copy')}</text>
                </column>
                <box hidden={muted_state}>
                    <GlassButton label={t('audio.mute')} onclick={onToggleMute} />
                </box>
                <box hidden={not muted_state}>
                    <GlassButton label={t('audio.unmute')} variant="primary" onclick={onToggleMute} />
                </box>
            </row>
            <row class="settings-card">
                <icon name={volume_icon} size="22" />
                <slider
                    class="settings-slider"
                    min="0"
                    max="100"
                    value={volume_percent}
                    onchange={onVolumeChange}
                    disabled={controls_disabled}
                    aria-label={t('audio.volume')}
                />
                <text class="settings-value">{volume_label}</text>
            </row>
        </column>

        <column class="settings-section">
            <text class="settings-section-title">{t('audio.output_device')}</text>
            <row class="settings-card">
                <column class="settings-card-copy">
                    <text class="settings-card-title">{output_name}</text>
                    <text class="settings-card-meta">{output_description}</text>
                </column>
                <text class="settings-status-pill settings-status-pill-active">{t('common.default')}</text>
            </row>
        </column>

        <column class="settings-section">
            <text class="settings-section-title">{t('common.backend_details')}</text>
            <column class="settings-card">
                <row class="settings-info-row">
                    <text class="settings-info-label">{t('common.provider')}</text>
                    <text class="settings-info-value">{t(provider_label)}</text>
                </row>
                <row class="settings-info-row">
                    <text class="settings-info-label">{t('common.interface')}</text>
                    <text class="settings-info-value">mesh.audio@1.x</text>
                </row>
                <row class="settings-info-row">
                    <text class="settings-info-label">{t('audio.control_path')}</text>
                    <text class="settings-info-value">{t(control_path)}</text>
                </row>
            </column>
        </column>
    </column>
</template>

<script lang="luau">
local GlassButton = require("@mesh/glass-controls")
hidden = false

local audio_ok, audio = pcall(require, "mesh.audio@>=1.0")
if not audio_ok then audio = nil end
local t = import("mesh.i18n", "t")
local volume_presentation = require("@mesh/volume-presentation/volume")

audio_status = "audio.waiting"
service_pill = "common.unavailable"
service_active = false
volume_percent = 0
volume_label = "0%"
volume_icon = "audio-volume-muted"
muted_state = false
controls_disabled = true
output_name = t("audio.default_output")
output_description = t("audio.discovery_unavailable")
provider_label = "common.no_provider"
control_path = "common.unavailable"

local function clamp_percent(value)
    local numeric = tonumber(value) or 0
    return math.max(0, math.min(100, math.floor(numeric + 0.5)))
end

local function event_value(value)
    if type(value) == "table" then
        return value.value
    end
    return value
end

local function sync_volume(percent, muted)
    volume_percent = clamp_percent(percent)
    volume_label = mesh.locale.format_percent(volume_percent)
    volume_icon = volume_presentation.icon(volume_percent, muted)
    muted_state = muted
end

effect(function()
    local mute, unmute = t("audio.mute"), t("audio.unmute")
    if mute_label ~= mute then mute_label = mute end
    if unmute_label ~= unmute then unmute_label = unmute end
    if not audio or audio.available == false then
        audio_status = "audio.install_backend"
        service_pill = "common.unavailable"
        service_active = false
        controls_disabled = true
        provider_label = "common.no_active_provider"
        control_path = "common.unavailable"
        output_name = t("audio.default_output")
        output_description = t("audio.discovery_unavailable")
        sync_volume(0, false)
        return
    end

    local muted = audio.muted == true
    controls_disabled = false
    audio_status = muted and "audio.output_muted" or "audio.output_active"
    service_pill = muted and "audio.muted" or "common.active"
    service_active = true
    provider_label = tostring(audio.source_module or "audio.active_provider")
    control_path = type(audio.set_volume) == "function" and "audio.read_control" or "audio.read_only"
    local raw_output = audio.output_name or audio.device_name
    output_name = (raw_output and tostring(raw_output) ~= "") and tostring(raw_output) or t("audio.default_system_output")
    local raw_desc = audio.output_description
    output_description = (raw_desc and tostring(raw_desc) ~= "") and tostring(raw_desc) or t("audio.managed_by_backend")
    sync_volume(audio.percent, muted)
end)

function onVolumeChange(value)
    if not audio or audio.available == false or type(audio.set_volume) ~= "function" then
        return
    end
    local percent = clamp_percent(event_value(value))
    sync_volume(percent, false)
    audio.set_volume("default", percent)
end

function onToggleMute()
    if not audio or audio.available == false then
        return
    end
    if type(audio.set_muted) == "function" then
        audio.set_muted("default", not (audio.muted == true))
    elseif type(audio.toggle_mute) == "function" then
        audio.toggle_mute()
    end
end
</script>
