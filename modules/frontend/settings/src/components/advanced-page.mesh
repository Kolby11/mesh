<template>
    <column class="settings-page" hidden={hidden}>
        <column class="settings-section">
            <text class="settings-section-title">{t('advanced.active_providers')}</text>
            <text class="settings-section-copy">{providers_count .. t(providers_summary) .. providers_notice_separator .. t(provider_notice)}</text>
            <list class="settings-list" label={t('advanced.active_backend_providers')} hidden={providers_hidden}>
                {#for row in provider_rows}
                    <list-item class="settings-card">
                        <column class="settings-card-copy">
                            <text class="settings-card-title">{row.interface}</text>
                            <text class="settings-card-meta">{row.provider}</text>
                        </column>
                        <button
                            class="settings-secondary-button"
                            hidden={row.action_hidden}
                            onclick={onProviderNext(row.interface, row.provider)}
                        >
                            {t('advanced.next_provider')}
                        </button>
                    </list-item>
                {/for}
            </list>
            <empty-state class="settings-empty-state" hidden={providers_empty_hidden}>
                <text class="settings-card-title">{t('advanced.no_active_bindings')}</text>
                <text class="settings-section-copy">{t('advanced.bindings_waiting')}</text>
            </empty-state>
        </column>

        <column class="settings-section">
            <row class="settings-section-head">
                <column class="settings-card-copy">
                    <text class="settings-section-title">{t('advanced.installed_modules')}</text>
                    <text class="settings-section-copy">{modules_match_count .. t(modules_of) .. modules_total_count .. t(modules_summary) .. modules_notice_separator .. t(module_notice)}</text>
                </column>
                <input
                    class="module-filter"
                    value={module_filter}
                    placeholder={t('advanced.filter_modules')}
                    label={t('advanced.filter_installed_modules')}
                    onchange={onModuleFilterChange}
                />
            </row>
            <list class="settings-list" label={t('advanced.installed_modules')} hidden={modules_hidden}>
                {#for row in module_rows}
                    <list-item class="settings-card">
                        <column class="settings-card-copy">
                            <row class="module-title-row">
                                <text class="settings-card-title">{row.module_id}</text>
                                <text class="settings-status-pill">{t(row.kind)}</text>
                            </row>
                            <text class="settings-card-meta">{t(row.status) .. row.status_details}</text>
                            <text class="settings-card-meta">{t('advanced.uses') .. ' ' .. row.interface_count .. ' ' .. t('advanced.interface_count') .. ' · ' .. t('advanced.settings') .. ' ' .. t(row.settings_list)}</text>
                            <text class="settings-card-meta module-detail" hidden={row.details_hidden}>{t('advanced.required_interfaces') .. ': ' .. row.required_interfaces}</text>
                            <text class="settings-card-meta module-detail" hidden={row.details_hidden}>{t('advanced.optional_interfaces') .. ': ' .. row.optional_interfaces}</text>
                            <text class="settings-card-meta module-detail" hidden={row.details_hidden}>{t('advanced.provides') .. ': ' .. row.provides}</text>
                            <text class="settings-card-meta module-detail" hidden={row.details_hidden}>{t('advanced.module_dependencies') .. ': ' .. row.modules}</text>
                            <text class="settings-card-meta module-detail" hidden={row.details_hidden}>{t('advanced.capabilities') .. ': ' .. row.capabilities}</text>
                            <text class="settings-card-meta module-detail" hidden={row.details_hidden}>{t('advanced.resources') .. ': ' .. row.resources}</text>
                            <text class="settings-card-meta module-detail" hidden={row.details_hidden}>{t('advanced.native_binaries') .. ': ' .. row.native_binaries}</text>
                            <text class="settings-card-meta module-detail" hidden={row.details_hidden}>{t('advanced.i18n_catalogs') .. ': ' .. row.i18n_catalogs}</text>
                            <text class="settings-card-meta module-detail" hidden={row.details_hidden}>{t('advanced.keybinds') .. ': ' .. row.keybinds}</text>
                            <text class="settings-card-meta module-detail" hidden={row.details_hidden}>{t('advanced.health') .. ': ' .. row.health}</text>
                        </column>
                        <column class="module-actions">
                            <button
                                class="settings-secondary-button"
                                onclick={onModuleDetails(row.module_id)}
                            >
                                {t(row.details_action)}
                            </button>
                            <button
                                class={row.button_class}
                                hidden={row.action_hidden}
                                onclick={onModuleToggle(row.module_id, row.enabled)}
                            >
                                {t(row.action)}
                            </button>
                        </column>
                    </list-item>
                {/for}
            </list>
            <empty-state class="settings-empty-state" hidden={modules_empty_hidden}>
                <text class="settings-card-title">{t('advanced.no_matching_modules')}</text>
                <text class="settings-section-copy">{t('advanced.clear_filter')}</text>
            </empty-state>
        </column>

        <column class="settings-section">
            <column class="settings-card-copy">
                <text class="settings-section-title">{t('advanced.module_preferences')}</text>
                <text class="settings-section-copy">{t('advanced.module_preferences.copy')}</text>
            </column>
            <list class="settings-list" label={t('advanced.module_preferences')} hidden={props_hidden}>
                {#for row in prop_rows}
                    <list-item class="settings-card settings-prop-card">
                        <column class="settings-card-copy settings-prop-copy">
                            <text class="settings-card-title">{row.label}</text>
                            <text class="settings-card-meta">{row.module_id .. ' · ' .. row.name .. row.description}</text>
                        </column>
                        <button
                            class="settings-secondary-button settings-prop-control"
                            hidden={row.bool_hidden}
                            onclick={onPropToggle(row.module_id, row.name, row.value)}
                        >
                            {row.value and t('common.enabled') or t('common.disabled')}
                        </button>
                        <button
                            class="settings-secondary-button settings-prop-control"
                            hidden={row.enum_hidden}
                            onclick={onPropEnumNext(row.module_id, row.name, row.value, row.options)}
                        >
                            {row.display_value}
                        </button>
                        <slider
                            class="settings-slider settings-prop-slider"
                            hidden={row.number_hidden}
                            min={row.minimum}
                            max={row.maximum}
                            step={row.step}
                            value={row.value}
                            label={row.label}
                            onchange={onPropNumber(row.module_id, row.name)}
                        />
                        <input
                            class="module-filter settings-prop-control"
                            hidden={row.text_hidden}
                            value={row.display_value}
                            label={row.label}
                            onchange={onPropText(row.module_id, row.name, row.type)}
                        />
                        <text class="settings-value" hidden={row.number_hidden}>{row.display_value}</text>
                        <button
                            class="settings-secondary-button"
                            hidden={row.reset_hidden}
                            onclick={onPropReset(row.module_id, row.name, row.default)}
                        >
                            {t('common.reset')}
                        </button>
                    </list-item>
                {/for}
            </list>
            <empty-state class="settings-empty-state" hidden={props_empty_hidden}>
                <text class="settings-card-title">{t('advanced.no_module_preferences')}</text>
                <text class="settings-section-copy">{t('advanced.no_module_preferences.copy')}</text>
            </empty-state>
        </column>
    </column>
</template>

<script lang="luau">
hidden = false

local debug_service = require("mesh.debug")
local t = import("mesh.i18n", "t")

providers_count = ""
providers_summary = "advanced.waiting_graph"
providers_notice_separator = ""
modules_match_count = ""
modules_of = ""
modules_total_count = ""
modules_summary = "advanced.waiting_graph"
modules_notice_separator = ""
module_filter = ""
provider_rows = {}
module_rows = {}
prop_rows = {}
selected_module_id = ""
providers_hidden = true
providers_empty_hidden = false
modules_hidden = true
modules_empty_hidden = false
props_hidden = true
props_empty_hidden = false

local provider_candidates = {}
local pending_providers = {}
local pending_module_enabled = {}
local provider_notice = ""
local module_notice = ""
local pending_props = {}

local function lower(value)
    return string.lower(tostring(value or ""))
end

local function list_count(values)
    if type(values) ~= "table" then return 0 end
    return #values
end

local function join_limited(values, limit)
    if type(values) ~= "table" or #values == 0 then return t("common.none") end
    local out = {}
    for i = 1, math.min(#values, limit) do
        local item = values[i]
        if type(item) == "table" then
            out[#out + 1] = tostring(item.interface or item.id or item.name or "")
        else
            out[#out + 1] = tostring(item)
        end
    end
    if #values > limit then out[#out + 1] = "+" .. tostring(#values - limit) end
    return table.concat(out, ", ")
end

local function append_values(out, label, values)
    if type(values) == "table" and #values > 0 then
        out[#out + 1] = t(label) .. ": " .. join_limited(values, 6)
    end
end

local function provider_binding(value)
    if type(value) == "table" then
        return tostring(value.interface or ""), tostring(value.provider or "")
    end
    local interface, provider = string.match(tostring(value or ""), "^([^=]+)=(.+)$")
    return tostring(interface or ""), tostring(provider or "")
end

local function interface_summary(values, active_providers)
    if type(values) ~= "table" or #values == 0 then return t("common.none") end
    local out = {}
    for _, value in ipairs(values) do
        local interface = type(value) == "table" and value.interface or value
        interface = tostring(interface or "")
        local provider = active_providers[interface]
        out[#out + 1] = interface .. " → " .. (provider or t("common.unavailable"))
    end
    return table.concat(out, ", ")
end

local function binary_summary(values)
    if type(values) ~= "table" or #values == 0 then return t("common.none") end
    local out = {}
    for _, binary in ipairs(values) do
        local status = binary.available == true and t("advanced.available") or t("common.unavailable")
        local optional = binary.optional == true and (", " .. t("advanced.optional")) or ""
        out[#out + 1] = tostring(binary.name or "") .. " (" .. status .. optional .. ")"
    end
    return table.concat(out, ", ")
end

local function module_matches(entry, query)
    if query == "" then return true end
    if string.find(lower(entry.module_id), query, 1, true) then return true end
    if string.find(lower(entry.kind), query, 1, true) then return true end
    local uses = entry.uses or {}
    if string.find(lower(join_limited(uses.interfaces, 16)), query, 1, true) then return true end
    local provides = entry.provides or {}
    return string.find(lower(join_limited(provides.settings, 16)), query, 1, true) ~= nil
end

local function localized_text(value, fallback)
    if type(value) == "string" and value ~= "" then return value end
    if type(value) == "table" then
        if type(value.t) == "string" and value.t ~= "" then
            local translated = t(value.t)
            if translated ~= value.t then return translated end
        end
        if type(value.fallback) == "string" and value.fallback ~= "" then
            return value.fallback
        end
    end
    return fallback
end

local function event_value(event)
    if type(event) == "table" then return event.value end
    return event
end

local function pending_key(module_id, name)
    return tostring(module_id) .. "\0" .. tostring(name)
end

local function update_local_prop(module_id, name, value, has_override)
    local key = pending_key(module_id, name)
    pending_props[key] = { value = value, has_override = has_override }
    for _, row in ipairs(prop_rows) do
        if row.module_id == module_id and row.name == name then
            row.value = value
            row.display_value = tostring(value or "") .. tostring(row.unit or "")
            row.reset_hidden = not has_override
        end
    end
end

function render()
    local graph = {}
    if debug_service and type(debug_service.module_graph) == "table" then
        graph = debug_service.module_graph
    end

    local active_providers = {}
    local active_provider_modules = {}
    local providers = {}
    local matched = {}
    local seen_bindings = {}
    provider_candidates = {}

    for _, entry in ipairs(graph) do
        local uses = entry.uses or {}
        local active = uses.active_providers
        if type(active) == "table" then
            for _, pair in ipairs(active) do
                    local interface, provider = provider_binding(pair)
                if interface ~= "" and provider ~= "" then
                    active_providers[interface] = provider
                    active_provider_modules[provider] = true
                    local key = interface .. "=" .. provider
                    if not seen_bindings[key] then
                        providers[#providers + 1] = { interface = interface, provider = provider }
                        seen_bindings[key] = true
                    end
                end
            end
        end

        if entry.enabled ~= false and entry.kind == "backend" then
            local provided = (entry.provides or {}).interfaces
            if type(provided) == "table" then
                for _, value in ipairs(provided) do
                    local interface = type(value) == "table" and value.interface or value
                    interface = tostring(interface or "")
                    if interface ~= "" then
                        provider_candidates[interface] = provider_candidates[interface] or {}
                        provider_candidates[interface][#provider_candidates[interface] + 1] = tostring(entry.module_id or "")
                    end
                end
            end
        end

        if module_matches(entry, lower(module_filter)) then
            matched[#matched + 1] = entry
        end
    end

    provider_rows = {}
    for _, pair in ipairs(providers) do
        local interface = pair.interface
        local candidates = provider_candidates[interface] or {}
        provider_rows[#provider_rows + 1] = {
            interface = interface,
            provider = pending_providers[interface] or active_providers[interface] or pair.provider,
            action_hidden = #candidates < 2,
        }
    end
    providers_hidden = #provider_rows == 0
    providers_empty_hidden = #provider_rows > 0
    providers_count = #providers == 0 and "" or (tostring(#providers) .. " ")
    providers_summary = #providers == 0 and "advanced.no_bindings_published"
        or "advanced.binding_count"
    providers_notice_separator = provider_notice == "" and "" or " · "

    module_rows = {}
    prop_rows = {}
    for i = 1, math.min(#matched, 12) do
        local entry = matched[i]
        local module_id = tostring(entry.module_id or "")
        local enabled = pending_module_enabled[module_id]
        if enabled == nil then enabled = entry.enabled ~= false end
        local uses = entry.uses or {}
        local provides = entry.provides or {}
        local diagnostics = entry.diagnostics or {}
        local health = entry.health or {}
        local status = enabled and "common.enabled" or "common.disabled"
        local status_details = #diagnostics > 0
            and (" · " .. join_limited(diagnostics, 2))
            or ""
        local action_allowed = module_id ~= "@mesh/settings"
            and entry.root_layout ~= true
            and not active_provider_modules[module_id]
        local module_providers = {}
        for _, binding in ipairs(uses.active_providers or {}) do
            local interface, provider = provider_binding(binding)
            if interface ~= "" and provider ~= "" then module_providers[interface] = provider end
        end
        local capability_parts = {}
        append_values(capability_parts, "advanced.required", uses.capabilities or entry.capabilities)
        append_values(capability_parts, "advanced.optional", uses.optional_capabilities or entry.optional_capabilities)
        local resource_parts = {}
        append_values(resource_parts, "advanced.icon_packs", uses.icon_packs)
        append_values(resource_parts, "advanced.font_packs", uses.font_packs)
        append_values(resource_parts, "advanced.theme_packs", uses.theme_packs)
        append_values(resource_parts, "advanced.required_icons", provides.required_icons)
        append_values(resource_parts, "advanced.provided_themes", provides.themes)
        local health_parts = {}
        for _, value in ipairs(health) do health_parts[#health_parts + 1] = tostring(value) end
        for _, value in ipairs(diagnostics) do health_parts[#health_parts + 1] = tostring(value) end
        local details_visible = selected_module_id == module_id
        module_rows[#module_rows + 1] = {
            module_id = module_id,
            kind = tostring(entry.kind or "advanced.module"),
            status = status,
            status_details = status_details,
            interface_count = tostring(list_count(uses.interfaces)),
            settings_list = join_limited(provides.settings, 2),
            enabled = enabled,
            action = enabled and "common.disable" or "common.enable",
            action_hidden = not action_allowed,
            button_class = enabled and "settings-danger-button" or "settings-primary-button",
            details_hidden = not details_visible,
            details_action = details_visible and "advanced.hide_details" or "advanced.show_details",
            required_interfaces = interface_summary(uses.interfaces, module_providers),
            optional_interfaces = interface_summary(uses.optional_interfaces, module_providers),
            provides = join_limited(provides.interfaces, 8),
            modules = join_limited(uses.modules, 8),
            capabilities = #capability_parts == 0 and t("common.none") or table.concat(capability_parts, " · "),
            resources = #resource_parts == 0 and t("common.none") or table.concat(resource_parts, " · "),
            native_binaries = binary_summary(uses.native_binaries),
            i18n_catalogs = join_limited(provides.i18n, 8),
            keybinds = join_limited(uses.keybinds, 8),
            health = #health_parts == 0 and t("advanced.healthy") or table.concat(health_parts, ", "),
        }

        local settings_schema = provides.settings_schema or {}
        local properties = settings_schema.properties or {}
        local overrides = provides.settings_values or {}
        for name, definition in pairs(properties) do
            local prop_type = tostring(definition.type or "string")
            local override = overrides[name]
            local has_override = override ~= nil
            local value = has_override and override or definition.default
            local pending = pending_props[pending_key(module_id, name)]
            if pending ~= nil then
                value = pending.value
                has_override = pending.has_override
            end
            local bounded_number = (prop_type == "number" or prop_type == "int" or prop_type == "duration")
                and definition.minimum ~= nil and definition.maximum ~= nil
            local description = localized_text(definition.description, "")
            prop_rows[#prop_rows + 1] = {
                module_id = module_id,
                name = tostring(name),
                type = prop_type,
                label = localized_text(definition.label, tostring(name)),
                description = description == "" and "" or (" · " .. description),
                value = value,
                default = definition.default,
                display_value = tostring(value or "") .. tostring(definition.unit or ""),
                unit = tostring(definition.unit or ""),
                options = definition.enum or {},
                minimum = tonumber(definition.minimum) or 0,
                maximum = tonumber(definition.maximum) or 100,
                step = tonumber(definition.step) or 1,
                bool_hidden = prop_type ~= "bool",
                enum_hidden = prop_type ~= "enum",
                number_hidden = not bounded_number,
                text_hidden = prop_type == "bool" or prop_type == "enum" or bounded_number,
                reset_hidden = not has_override,
            }
        end
    end
    table.sort(prop_rows, function(a, b)
        if a.module_id == b.module_id then return a.name < b.name end
        return a.module_id < b.module_id
    end)
    modules_hidden = #module_rows == 0
    modules_empty_hidden = #module_rows > 0
    props_hidden = #prop_rows == 0
    props_empty_hidden = #prop_rows > 0
    modules_match_count = #graph == 0 and "" or (tostring(#matched) .. " ")
    modules_of = #graph == 0 and "" or "advanced.of"
    modules_total_count = #graph == 0 and "" or (" " .. tostring(#graph) .. " ")
    modules_summary = #graph == 0 and "advanced.no_modules_published"
        or "advanced.modules_match"
    modules_notice_separator = module_notice == "" and "" or " · "
end

function onPropToggle(module_id, name, current)
    local value = not (current == true)
    update_local_prop(module_id, name, value, true)
    mesh.events.publish("shell.set-module-prop", {
        module_id = module_id, prop = name, value = value,
    })
end

function onPropEnumNext(module_id, name, current, options)
    if type(options) ~= "table" or #options == 0 then return end
    local index = 0
    for i, option in ipairs(options) do
        if option == current then index = i end
    end
    local value = options[(index % #options) + 1]
    update_local_prop(module_id, name, value, true)
    mesh.events.publish("shell.set-module-prop", {
        module_id = module_id, prop = name, value = value,
    })
end

function onPropNumber(module_id, name, event)
    local value = tonumber(event_value(event))
    if value == nil then return end
    update_local_prop(module_id, name, value, true)
    mesh.events.publish("shell.set-module-prop", {
        module_id = module_id, prop = name, value = value,
    })
end

function onPropText(module_id, name, prop_type, event)
    local value = tostring(event_value(event) or "")
    if prop_type == "number" or prop_type == "int" or prop_type == "duration" then
        value = tonumber(value)
        if value == nil then return end
    end
    update_local_prop(module_id, name, value, true)
    mesh.events.publish("shell.set-module-prop", {
        module_id = module_id, prop = name, value = value,
    })
end

function onPropReset(module_id, name, default)
    update_local_prop(module_id, name, default, false)
    mesh.events.publish("shell.unset-module-prop", {
        module_id = module_id, prop = name,
    })
end

function onModuleFilterChange(value)
    if type(value) == "table" then
        module_filter = tostring(value.value or "")
    else
        module_filter = tostring(value or "")
    end
end

function onProviderNext(interface, current)
    local candidates = provider_candidates[interface] or {}
    if interface == "" or #candidates < 2 then return end
    local index = 0
    for i, provider in ipairs(candidates) do
        if provider == current then index = i end
    end
    local provider_id = candidates[(index % #candidates) + 1]
    pending_providers[interface] = provider_id
    provider_notice = "advanced.switching_live"
    mesh.events.publish("shell.set-provider", {
        interface = interface,
        provider_id = provider_id,
    })
end

function onModuleToggle(module_id, current_enabled)
    if module_id == "" or module_id == "@mesh/settings" then return end
    local enabled = not current_enabled
    pending_module_enabled[module_id] = enabled
    module_notice = "advanced.applying_live"
    mesh.events.publish("shell.set-module-enabled", {
        module_id = module_id,
        enabled = enabled,
    })
end

function onModuleDetails(module_id)
    if selected_module_id == module_id then
        selected_module_id = ""
    else
        selected_module_id = module_id
    end
    local updated = {}
    for _, row in ipairs(module_rows) do
        local visible = row.module_id == selected_module_id
        row.details_hidden = not visible
        row.details_action = visible and "advanced.hide_details" or "advanced.show_details"
        updated[#updated + 1] = row
    end
    module_rows = updated
end
</script>

<style>
    .module-filter {
        width: 190px;
        flex-shrink: 0;
    }

    .module-title-row {
        width: 100%;
        align-items: center;
        justify-content: space-between;
        gap: var(--spacing-sm);
    }

    .module-actions {
        flex-shrink: 0;
        gap: var(--spacing-xs);
    }

    .module-detail {
        width: 100%;
    }

    .settings-prop-card {
        gap: var(--spacing-sm);
    }

    .settings-prop-copy {
        min-width: 0;
        flex-grow: 1;
    }

    .settings-prop-control {
        width: 180px;
        flex-shrink: 0;
    }

    .settings-prop-slider {
        width: 150px;
        flex-shrink: 0;
    }
</style>
