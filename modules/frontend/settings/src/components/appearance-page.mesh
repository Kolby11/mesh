<template>
    <column class="settings-page" hidden={hidden}>
        <column class="settings-section">
            <text class="settings-section-title">{t('appearance.theme')}</text>
            <text class="settings-section-copy">{t('appearance.theme.copy')}</text>
            <text class="settings-card-meta">{theme_scope_label}</text>
            <GlassButton label={theme_pin_label} onclick={onThemePin} hidden={theme_pin_hidden} />
            <row class="theme-grid settings-group">
                {#for row in theme_rows}
                    <button class="theme-option" class:theme-option-active={row.active} onclick={onThemeSelect(row.id)}>
                        <box class="theme-preview" style:background={row.palette.surface}>
                            <column class="theme-preview-sidebar" style:background={row.palette.surface_container_low}>
                                <box class="theme-preview-dot" style:background={row.palette.primary} />
                                <box class="theme-preview-line" style:background={row.palette.outline_variant} />
                                <box class="theme-preview-line theme-preview-line-short" style:background={row.palette.outline_variant} />
                            </column>
                            <column class="theme-preview-body">
                                <box class="theme-preview-heading" style:background={row.palette.on_surface} />
                                <box class="theme-preview-panel" style:background={row.palette.surface_container_high} />
                            </column>
                        </box>
                        <column class="theme-option-copy">
                            <text class="theme-kicker">{row.kicker}</text>
                            <row class="theme-title-row">
                                <text class="theme-title">{row.label}</text>
                                <text class="theme-now" hidden={not row.active}>{t('appearance.theme.now')}</text>
                            </row>
                            <text class="settings-card-meta">{row.recommends}</text>
                            <text class="settings-card-meta">{row.coverage}</text>
                        </column>
                    </button>
                {/for}
            </row>
        </column>

        <column class="settings-section">
            <text class="settings-section-title">{t('appearance.glass')}</text>
            <text class="settings-section-copy">{t('appearance.glass.copy')}</text>
            <column class="settings-group">
                <row class="settings-group-row">
                    <box class="row-tile row-tile-cyan"><icon class="row-icon" name="texture" size="16" /></box>
                    <text class="settings-group-label">{t('appearance.glass.style')}</text>
                    <row class="glass-style-options" aria-label={t('appearance.glass.style')}>
                        <button class="glass-style-option" class:glass-style-option-active={glass_style == "theme"} onclick={onGlassPresetTheme}><text class="glass-style-label" class:glass-style-label-active={glass_style == "theme"}>{t('appearance.glass.style.theme')}</text></button>
                        <button class="glass-style-option" class:glass-style-option-active={glass_style == "liquid"} onclick={onGlassPresetLiquid}><text class="glass-style-label" class:glass-style-label-active={glass_style == "liquid"}>{t('appearance.glass.style.liquid')}</text></button>
                        <button class="glass-style-option" class:glass-style-option-active={glass_style == "soft"} onclick={onGlassPresetSoft}><text class="glass-style-label" class:glass-style-label-active={glass_style == "soft"}>{t('appearance.glass.style.soft')}</text></button>
                        <button class="glass-style-option" class:glass-style-option-active={glass_style == "frosted"} onclick={onGlassPresetFrosted}><text class="glass-style-label" class:glass-style-label-active={glass_style == "frosted"}>{t('appearance.glass.style.frosted')}</text></button>
                    </row>
                </row>
                <box class="settings-group-divider" />
                <row class="settings-group-row">
                    <box class="row-tile row-tile-blue"><icon class="row-icon" name="blur" size="16" /></box>
                    <text class="settings-group-label">{t('appearance.glass.blur')}</text>
                    <text class="settings-value">{glass_blur_label}</text>
                    <slider class="glass-strength" min="0" max="100" step="1" value="{glass_blur}" onchange={onGlassBlur} aria-label={t('appearance.glass.blur')} />
                </row>
                <box class="settings-group-divider" />
                <row class="settings-group-row">
                    <box class="row-tile row-tile-purple"><icon class="row-icon" name="water-drop" size="16" /></box>
                    <text class="settings-group-label">{t('appearance.glass.liquid')}</text>
                    <text class="settings-value">{glass_liquid_label}</text>
                    <slider class="glass-strength" min="0" max="100" step="1" value="{glass_liquid}" onchange={onGlassLiquid} aria-label={t('appearance.glass.liquid')} />
                </row>
            </column>
        </column>

        <column class="settings-section">
            <text class="settings-section-title">{t('appearance.icons')}</text>
            <text class="settings-section-copy">{t('appearance.icons.copy')}</text>
            <scroll class="settings-list resource-list">
                {#for row in icon_theme_rows key={row.id}}
                    <button class="resource-option language-option" class:language-option-active={row.id == icon_theme_value} onclick={onIconThemeSelect(row.id)}>
                        <column class="settings-card-copy">
                            <text class="settings-card-title">{row.name}</text>
                            <text class="settings-card-meta">{row.detail}</text>
                        </column>
                        <text class="language-check" hidden={row.id ~= icon_theme_value}>{t('common.selected')}</text>
                    </button>
                {/for}
            </scroll>
            <GlassButton label={t('appearance.show_more')} onclick={onShowMoreIcons} hidden={icon_more_hidden} />
        </column>

        <column class="settings-section">
            <text class="settings-section-title">{t('appearance.fonts')}</text>
            <text class="settings-section-copy">{t('appearance.fonts.copy')}</text>
            <scroll class="settings-list resource-list">
                {#for row in font_rows key={row.name}}
                    <button class="resource-option language-option" class:language-option-active={row.name == font_value} style:font-family={row.family} onclick={onFontSelect(row.name)}>
                        <column class="settings-card-copy">
                            <text class="settings-card-title">{row.name}</text>
                            <text class="settings-card-meta">{row.detail}</text>
                        </column>
                        <text class="language-check" hidden={row.name ~= font_value}>{t('common.selected')}</text>
                    </button>
                {/for}
            </scroll>
            <GlassButton label={t('appearance.show_more')} onclick={onShowMoreFonts} hidden={font_more_hidden} />
        </column>

        <column class="settings-section">
            <text class="settings-section-title">{t('appearance.language')}</text>
            <text class="settings-section-copy">{t('appearance.language.copy')}</text>
            <row class="settings-segmented" aria-label={t('appearance.language')}>
                <GlassButton variant="ghost" active={not locale_slovak} label={t('language.english.native')} onclick={onLocaleEnglish} />
                <GlassButton variant="ghost" active={locale_slovak} label={t('language.slovak.native')} onclick={onLocaleSlovak} />
            </row>
        </column>

        <column class="settings-section">
            <text class="settings-section-title">{t('appearance.current')}</text>
            <column class="settings-card">
                <row class="settings-info-row">
                    <text class="settings-info-label">{t('common.theme')}</text>
                    <text class="settings-info-value">{theme_value}</text>
                </row>
                <row class="settings-info-row">
                    <text class="settings-info-label">{t('common.locale')}</text>
                    <text class="settings-info-value">{locale_value}</text>
                </row>
                <row class="settings-info-row">
                    <text class="settings-info-label">{t('appearance.icons')}</text>
                    <text class="settings-info-value">{icon_theme_value}</text>
                </row>
                <row class="settings-info-row">
                    <text class="settings-info-label">{t('appearance.fonts')}</text>
                    <text class="settings-info-value">{font_value}</text>
                </row>
            </column>
        </column>
    </column>
</template>

<script lang="luau">
local GlassButton = require("@mesh/glass-controls")
hidden = false

local theme = require("mesh.theme")
local debug_ok, debug_service = pcall(require, "mesh.debug")
if not debug_ok then debug_service = nil end
local settings_ok, settings_service = pcall(require, "mesh.settings")
if not settings_ok then settings_service = nil end
local t = import("mesh.i18n", "t")

theme_value = "mesh-default"
locale_value = "en"
theme_rows = {}
theme_scope_label = ""
theme_pin_label = ""
theme_pin_hidden = true
icon_theme_rows = {}
font_rows = {}
icon_theme_value = "hicolor"
font_value = "system-ui"
icon_more_hidden = true
font_more_hidden = true
locale_slovak = false
glass_style = "theme"
glass_blur = 0
glass_liquid = 0
glass_blur_label = "0%"
glass_liquid_label = "0%"

local RESOURCE_PAGE_SIZE = 24
local icon_limit = RESOURCE_PAGE_SIZE
local font_limit = RESOURCE_PAGE_SIZE
local font_catalog = {}
local font_revision = nil
local font_loading = false

local function fallback_preview_palette(theme_id)
    local id = string.lower(tostring(theme_id or ""))
    local light = string.find(id, "light", 1, true) ~= nil
    if light then
        return {
            surface = "#f5f6fa",
            surface_container_low = "#e8e9ef",
            surface_container_high = "#d9dbe4",
            primary = "#6750a4",
            outline_variant = "#79747e",
            on_surface = "#1c1b1f",
        }
    end
    return {
        surface = "#17181c",
        surface_container_low = "#24252b",
        surface_container_high = "#34353d",
        primary = "#d0bcff",
        outline_variant = "#938f99",
        on_surface = "#e6e1e5",
    }
end

local function preview_palette(option)
    local fallback = fallback_preview_palette(option.id)
    local palette = type(option.palette) == "table" and option.palette or {}
    return {
        surface = tostring(palette.surface or fallback.surface),
        surface_container_low = tostring(
            palette.surface_container_low or fallback.surface_container_low
        ),
        surface_container_high = tostring(
            palette.surface_container_high or fallback.surface_container_high
        ),
        primary = tostring(palette.primary or fallback.primary),
        outline_variant = tostring(palette.outline_variant or fallback.outline_variant),
        on_surface = tostring(palette.on_surface or fallback.on_surface),
    }
end

local function installed_themes()
    local rows = {}
    local seen = {}
    local positions = {}

    local function add_theme(candidate)
        local id = type(candidate) == "table" and candidate.id or candidate
        id = tostring(id or "")
        if id == "" then return end

        local label = type(candidate) == "table"
            and tostring(candidate.label or id)
            or id
        local palette = type(candidate) == "table" and candidate.palette or nil
        local position = positions[id]
        if position then
            -- A later source may know more than an early partial registry
            -- snapshot. Enrich the existing row without creating duplicates.
            if rows[position].label == id and label ~= id then
                rows[position].label = label
            end
            if rows[position].palette == nil and palette ~= nil then
                rows[position].palette = palette
            end
            if type(candidate) == "table" then
                for _, field in ipairs({ "coverage", "modes", "recommends" }) do
                    if candidate[field] ~= nil then
                        rows[position][field] = candidate[field]
                    end
                end
            end
            return
        end

        local details = type(candidate) == "table" and candidate or {}
        rows[#rows + 1] = {
            id = id,
            label = label,
            palette = palette,
            coverage = details.coverage,
            modes = details.modes,
            recommends = details.recommends,
        }
        positions[id] = #rows
        seen[id] = true
    end

    local service_themes = theme and theme.themes or {}

    if type(service_themes) == "table" then
        for _, candidate in ipairs(service_themes) do
            add_theme(candidate)
        end
    end

    local available = theme and theme.available or {}
    if type(available) == "table" then
        for _, candidate in ipairs(available) do
            add_theme(candidate)
        end
    end

    -- The graph can enrich a provider snapshot that has only published its
    -- active theme so far. Debug is optional in isolated component hosts, so
    -- read it behind pcall rather than turning Appearance into a hard debug
    -- dependency.
    local graph = {}
    local graph_ok, graph_value = pcall(function()
        return debug_service and debug_service.module_graph or {}
    end)
    if graph_ok and type(graph_value) == "table" then
        graph = graph_value
    end
    for _, entry in ipairs(graph) do
        if entry.enabled ~= false then
            local provided = (entry.provides or {}).themes
            if type(provided) == "table" then
                for _, candidate in ipairs(provided) do
                    add_theme(candidate)
                end
            end
        end
    end

    return rows, seen
end

-- The mode names a theme offers, as the small caption above its name.
local function theme_kicker(option)
    local names = {}
    for _, mode in ipairs(type(option.modes) == "table" and option.modes or {}) do
        local name = type(mode) == "table" and mode.name or mode
        if name ~= nil then names[#names + 1] = string.upper(tostring(name)) end
    end
    return table.concat(names, " · ")
end

-- What selecting the theme adopts: its first installed font and icon theme,
-- or its first choice when the installed catalog has not loaded that far.
local function theme_recommendation(option)
    local recommends = type(option.recommends) == "table" and option.recommends or {}
    local resources = theme and theme.system_resources or {}
    local function first(candidates, installed, field)
        local present = {}
        for _, entry in ipairs(installed or {}) do
            present[tostring(entry[field] or "")] = true
        end
        for _, candidate in ipairs(candidates or {}) do
            if present[candidate] then return candidate end
        end
        return (candidates or {})[1]
    end
    local font = first(recommends.fonts, font_catalog, "name")
    local icons = first(recommends.icons, resources.icon_themes, "id")
    if font == nil and icons == nil then return "" end
    local parts = {}
    if font ~= nil then parts[#parts + 1] = font end
    if icons ~= nil then parts[#parts + 1] = icons end
    return t('appearance.theme.recommends') .. " " .. table.concat(parts, " · ")
end

local function sync_theme(theme_id)
    theme_value = tostring(theme_id or "mesh-default")
    local installed, seen = installed_themes()

    -- Keep the current theme selectable while the module graph is still being
    -- published, or if it came from a theme source not represented there yet.
    if not seen[theme_value] then
        installed[#installed + 1] = { id = theme_value, label = theme_value }
    end

    local rows = {}
    for index, option in ipairs(installed) do
        local active = option.id == theme_value
        local palette = preview_palette(option)
        rows[index] = {
            id = option.id,
            label = option.label,
            palette = palette,
            active = active,
            kicker = theme_kicker(option),
            recommends = theme_recommendation(option),
            coverage = type(option.coverage) == "table"
                and (tostring(option.coverage.tuned or 0) .. " " .. t('appearance.coverage.tuned')
                    .. " · " .. tostring(option.coverage.defaults or 0) .. " " .. t('appearance.coverage.defaults')
                    .. " · " .. tostring(option.coverage.independent or 0) .. " " .. t('appearance.coverage.independent')
                    .. " · " .. tostring((option.coverage.internal_selectors or 0) + (option.coverage.absent_targets or 0)) .. " " .. t('appearance.coverage.warnings'))
                or t('appearance.coverage.unavailable'),
        }
    end
    theme_rows = rows
end

local function sync_locale(locale)
    locale_value = tostring(locale or "en")
    local slovak = locale_value == "sk" or string.find(locale_value, "sk-", 1, true) == 1
    locale_slovak = slovak
end

local function sync_system_resources()
    local resources = theme and theme.system_resources or {}
    icon_theme_value = tostring(resources.active_icon_theme or "hicolor")
    font_value = tostring(resources.active_font_family or "system-ui")

    local icons = {}
    icon_more_hidden = true
    for index, candidate in ipairs(resources.icon_themes or {}) do
        if index <= icon_limit then
            local id = tostring(candidate.id or "")
            local inherits = candidate.inherits or {}
            icons[index] = {
                id = id,
                name = tostring(candidate.name or id),
                detail = #inherits > 0
                    and (id .. " · " .. t('appearance.inherits') .. " " .. table.concat(inherits, ", "))
                    or id,
            }
        else
            icon_more_hidden = false
        end
    end
    icon_theme_rows = icons

    if resources.font_revision ~= font_revision or font_revision == nil then
        font_catalog = resources.font_families or {}
        font_revision = resources.font_revision
        font_limit = RESOURCE_PAGE_SIZE
    end
    local fonts = {}
    font_more_hidden = true
    for index, candidate in ipairs(font_catalog) do
        if index <= font_limit then
            local name = tostring(candidate.name or "")
            local face_count = tonumber(candidate.face_count or 0) or 0
            local kind = candidate.monospace and t('appearance.font.monospace') or t('appearance.font.proportional')
            fonts[index] = {
                name = name,
                detail = kind .. " · " .. tostring(face_count) .. " " .. t('appearance.font.faces'),
                family = "'" .. string.gsub(name, "'", "\\'") .. "'",
            }
        else
            font_more_hidden = false
        end
    end
    if tonumber(resources.font_total or #font_catalog) > font_limit then
        font_more_hidden = false
    end
    font_rows = fonts
end

-- Glass material. Strength 100% is each tier's strongest glass; the saved
-- `glass.strength.*` overrides record the choice, and the backdrop overrides
-- apply it to every module that uses @mesh/glass-material.
local GLASS_TIERS = {
    pill = { blur = 16, depth = 6, edge = 5, dispersion = 0.4 },
    card = { blur = 24, depth = 10, edge = 8, dispersion = 0.6 },
    dock = { blur = 20, depth = 9, edge = 7, dispersion = 0.6 },
    panel = { blur = 32, depth = 12, edge = 9, dispersion = 0.6 },
    flare = { blur = 10, depth = 0, edge = 0, dispersion = 0 },
    lens = { blur = 0, depth = 8, edge = 8, dispersion = 0 },
}
local GLASS_PRESETS = {
    liquid = { blur = 10, liquid = 100 },
    soft = { blur = 45, liquid = 45 },
    frosted = { blur = 100, liquid = 0 },
}

local function length(value)
    return string.format("%gpx", math.floor(value * 10 + 0.5) / 10)
end

local function backdrop_filter(tier, blur, liquid)
    local parts = {}
    if tier.blur > 0 then
        parts[#parts + 1] = "blur(" .. length(tier.blur * blur / 100) .. ")"
    end
    parts[#parts + 1] = "refract(" .. length(tier.depth * liquid / 100) .. " "
        .. length(tier.edge * liquid / 100) .. ")"
    if tier.dispersion > 0 and liquid > 0 then
        parts[#parts + 1] = "dispersion(" .. length(tier.dispersion * liquid / 100) .. ")"
    end
    return table.concat(parts, " ")
end

local function stored_tokens()
    local namespaces = settings_service and settings_service.namespaces or {}
    local shell = type(namespaces) == "table" and namespaces.shell or {}
    local themed = type(shell) == "table" and shell.theme or {}
    return type(themed) == "table" and type(themed.tokens) == "table" and themed.tokens or {}
end

local function show_glass(style, blur, liquid)
    glass_style = style
    glass_blur = blur
    glass_liquid = liquid
    glass_blur_label = tostring(math.floor(blur + 0.5)) .. "%"
    glass_liquid_label = tostring(math.floor(liquid + 0.5)) .. "%"
end

local function sync_glass()
    local tokens = stored_tokens()
    local blur = tonumber(tokens["glass.strength.blur"])
    local liquid = tonumber(tokens["glass.strength.liquid"])
    if blur == nil or liquid == nil then
        show_glass("theme", glass_blur, glass_liquid)
        return
    end
    show_glass(tostring(tokens["glass.strength.style"] or "custom"), blur, liquid)
end

local function apply_glass(style, blur, liquid)
    show_glass(style, blur, liquid)
    local tokens = {
        ["glass.strength.style"] = style,
        ["glass.strength.blur"] = blur,
        ["glass.strength.liquid"] = liquid,
    }
    for name, tier in pairs(GLASS_TIERS) do
        tokens["@mesh/glass-material.glass.backdrop." .. name] = backdrop_filter(tier, blur, liquid)
    end
    theme.set_tokens(tokens)
end

local function slider_number(value)
    if type(value) == "table" then value = value.value end
    return math.max(0, math.min(100, tonumber(value) or 0))
end

function onGlassPresetTheme()
    show_glass("theme", glass_blur, glass_liquid)
    local tokens = {
        ["glass.strength.style"] = mesh.json.null,
        ["glass.strength.blur"] = mesh.json.null,
        ["glass.strength.liquid"] = mesh.json.null,
    }
    for name in pairs(GLASS_TIERS) do
        tokens["@mesh/glass-material.glass.backdrop." .. name] = mesh.json.null
    end
    theme.set_tokens(tokens)
end

function onGlassPresetLiquid() apply_glass("liquid", GLASS_PRESETS.liquid.blur, GLASS_PRESETS.liquid.liquid) end
function onGlassPresetSoft() apply_glass("soft", GLASS_PRESETS.soft.blur, GLASS_PRESETS.soft.liquid) end
function onGlassPresetFrosted() apply_glass("frosted", GLASS_PRESETS.frosted.blur, GLASS_PRESETS.frosted.liquid) end

function onGlassBlur(value) apply_glass("custom", slider_number(value), glass_liquid) end
function onGlassLiquid(value) apply_glass("custom", glass_blur, slider_number(value)) end

effect(function()
    local current_theme = "mesh-default"
    if theme then
        current_theme = theme.current or theme.theme_id or current_theme
        if theme.state then
            current_theme = theme.state.current or theme.state.theme_id or current_theme
        end
    end
    -- Resources first: theme cards name the recommended fonts that are installed.
    sync_system_resources()
    sync_theme(current_theme)
    local pinned = theme and theme.scope == "profile"
    theme_scope_label = pinned and t('appearance.theme.pinned') or t('appearance.theme.shared')
    theme_pin_label = pinned and t('appearance.theme.unpin') or t('appearance.theme.pin')
    theme_pin_hidden = not (pinned or (theme and theme.can_pin))
    sync_locale(mesh.locale.current() or "en")
    sync_glass()
end)

function onThemeSelect(theme_id)
    local selected = tostring(theme_id or "")
    if selected == "" then return end
    sync_theme(selected)
    theme.set_theme(selected)
end

function onThemePin()
    theme.set_theme(theme_value, theme.scope == "profile" and "user" or "profile")
end

function onIconThemeSelect(theme_id)
    local selected = tostring(theme_id or "")
    if selected == "" then return end
    icon_theme_value = selected
    theme.set_icon_theme(selected)
end

function onFontSelect(family)
    local selected = tostring(family or "")
    if selected == "" then return end
    font_value = selected
    theme.set_font_family(selected)
end

function onShowMoreIcons()
    icon_limit = icon_limit + RESOURCE_PAGE_SIZE
    sync_system_resources()
end

function onShowMoreFonts()
    if font_loading then return end
    local resources = theme and theme.system_resources or {}
    if resources.font_revision ~= nil and #font_catalog < tonumber(resources.font_total or 0) then
        font_loading = true
        task.spawn(function()
            local succeeded, completion = pcall(function()
                return theme.list_font_families(#font_catalog, RESOURCE_PAGE_SIZE):await()
            end)
            font_loading = false
            if not succeeded then return end
            local page = completion and completion.result or {}
            if page.ok ~= true or page.revision ~= font_revision then return end
            for _, candidate in ipairs(page.families or {}) do
                font_catalog[#font_catalog + 1] = candidate
            end
            font_limit = font_limit + RESOURCE_PAGE_SIZE
            sync_system_resources()
        end)
        return
    end
    font_limit = font_limit + RESOURCE_PAGE_SIZE
    sync_system_resources()
end

function onLocaleEnglish()
    sync_locale("en")
    mesh.locale.set("en")
end

function onLocaleSlovak()
    sync_locale("sk")
    mesh.locale.set("sk")
end
</script>

<style>
    .theme-grid {
        width: 100%;
        gap: var(--spacing-md);
        flex-wrap: wrap;
        padding: var(--spacing-md);
    }

    .theme-option {
        flex-direction: column;
        align-items: stretch;
        min-width: 0;
        flex-basis: 220px;
        flex-grow: 1;
        gap: var(--spacing-sm);
        padding: var(--spacing-sm);
        border-radius: var(--radius-md);
        border-width: 1px;
        border-style: solid;
        border-color: var(--glass-settings-rim);
        background: var(--glass-settings-inset);
        color: var(--glass-settings-text);
    }

