<template>
    <column class="settings-page" hidden={hidden}>
        <row class="theme-grid">
            {#for row in theme_rows key={row.id}}
                <button class="theme-option" class:theme-option-active={row.active} hidden={hideTheme(row)} aria-pressed={row.active} onclick={onThemeSelect(row.id)}>
                    <box class="theme-preview" style:background={row.palette.surface}>
                        <column class="theme-preview-sidebar" style:background={row.palette.surface_container_low}>
                            <box class="theme-preview-dot" style:background={row.palette.primary} />
                            <box class="theme-preview-line" style:background={row.palette.outline_variant} />
                            <box class="theme-preview-line theme-preview-line-short" style:background={row.palette.outline_variant} />
                        </column>
                        <column class="theme-preview-body">
                            <box class="theme-preview-heading" style:background={row.palette.on_surface} />
                            <box class="theme-preview-panel" style:background={row.palette.surface_container_high} />
                        </column>
                    </box>
                    <column class="theme-option-copy">
                        <row class="theme-title-row">
                            <text class="theme-title">{row.label}</text>
                        </row>
                    </column>
                </button>
            {/for}
        </row>

        <row class="appearance-columns">
            <column class="settings-group appearance-card">
                <row class="settings-group-row">
                    <text class="settings-group-label">{t('appearance.mode')}</text>
                    <row class="glass-style-options" aria-label={t('appearance.mode')}>
                        {#for mode in available_modes key={mode.name}}
                            <button class="glass-style-option" class:glass-style-option-active={mode.active} aria-pressed={mode.active} onclick={onMode(mode.name)}><text>{mode.label}</text></button>
                        {/for}
                    </row>
                </row>
                <box class="settings-group-divider" />
                <row class="settings-group-row">
                    <text class="settings-group-label">{t('appearance.accent')}</text>
                    <row class="accent-options">
                        {#for accent in accents key={accent.name}}
                            <button class="accent-swatch" style:background={accent.color} aria-label={t('appearance.accent.' .. accent.name)} aria-pressed={accent_value == accent.color} class:accent-swatch-active={accent_value == accent.color} onclick={onAccent(accent.name)} />
                        {/for}
                        <GlassButton variant="ghost" label={t('appearance.reset')} onclick={onAccentReset} />
                    </row>
                </row>
                <PrefsPage page="appearance" />
            </column>
            <column class="settings-group appearance-card">
                <row class="settings-group-row">
                    <text class="settings-group-label">{t('appearance.icons')}</text>
                    <button class="appearance-icon-picker" aria-expanded={icons_open} onclick={onToggleIcons}><text>{icon_theme_name ~= '' and icon_theme_name or t('appearance.system_default')}</text></button>
                </row>
                <box class="settings-group-divider" />
                <row class="settings-group-row">
                    <text class="settings-group-label">{t('appearance.fonts')}</text>
                    <GlassButton label={font_value ~= '' and font_value or t('appearance.system_default')} active={fonts_open} onclick={onToggleFonts} />
                </row>
                <box class="settings-group-divider" />
                <row class="settings-group-row">
                    <text class="settings-group-label">{t('appearance.base_size')}</text>
                    <slider class="appearance-size" min="10" max="32" step="1" value={base_size} onchange={onBaseSize} onrelease={onBaseSizeCommit} aria-label={t('appearance.base_size')} />
                    <text class="settings-value">{tostring(base_size) .. " px"}</text>
                </row>
            </column>
        </row>
        <column class="settings-group" hidden={not icons_open}>
            <scroll class="settings-list resource-list">
                {#for row in icon_theme_rows key={row.id}}
                    <button class="resource-option language-option" class:language-option-active={row.id == icon_theme_value} onclick={onIconThemeSelect(row.id)}>
                        <column class="settings-card-copy">
                            <text class="settings-card-title">{row.name}</text>
                            <text class="settings-card-meta">{row.detail}</text>
                        </column>
                        <text class="language-check" hidden={row.id ~= icon_theme_value}>{t('common.selected')}</text>
                    </button>
                {/for}
            </scroll>
            <GlassButton label={t('appearance.show_more')} onclick={onShowMoreIcons} hidden={icon_more_hidden} />
        </column>
        <column class="settings-group" hidden={not fonts_open}>
            <scroll class="settings-list resource-list">
                {#for row in font_rows key={row.name}}
                    <button class="resource-option language-option" class:language-option-active={row.name == font_value} style:font-family={row.family} onclick={onFontSelect(row.name)}>
                        <column class="settings-card-copy">
                            <text class="settings-card-title">{row.name}</text>
                            <text class="settings-card-meta">{row.detail}</text>
                        </column>
                        <text class="language-check" hidden={row.name ~= font_value}>{t('common.selected')}</text>
                    </button>
                {/for}
            </scroll>
            <GlassButton label={t('appearance.show_more')} onclick={onShowMoreFonts} hidden={font_more_hidden} />
        </column>

        <column class="settings-group" hidden={not has_wallpapers}>
            <text class="settings-section-title">{t('appearance.wallpaper')}</text>
            <row class="wallpaper-grid">
                {#for item in wallpaper_rows key={item.path}}
                    <button class="wallpaper-choice" class:wallpaper-choice-active={item.active} aria-pressed={item.active} aria-label={item.name} title={item.name} onclick={onWallpaper(item.path)}>
                        <image class="wallpaper-image" src={item.thumbnail} alt="" />
                    </button>
                {/for}
            </row>
        </column>

        <PrefsPage page="appearance_motion" />

        <column class="settings-group">
            <row class="settings-group-row">
                <text class="settings-group-label">{t('appearance.shell_scale')}</text>
                <slider class="appearance-size" min="70" max="200" step="5" value={shell_scale} onchange={onShellScale} onrelease={onShellScaleCommit} aria-label={t('appearance.shell_scale')} />
                <text class="settings-value">{tostring(shell_scale) .. "%"}</text>
                <GlassButton variant="ghost" label={t('appearance.reset')} onclick={onShellScaleReset} />
            </row>
            <row class="settings-group-row">
                <column class="settings-card-copy">
                    <text class="settings-group-label">{theme_scope_label}</text>
                    <text class="settings-section-copy" hidden={theme_coverage == ""}>{theme_coverage}</text>
                </column>
                <GlassButton variant="ghost" label={t('appearance.other_themes')} active={other_themes_open} onclick={onToggleThemes} hidden={not has_other_themes} />

                <GlassButton label={theme_pin_label} onclick={onThemePin} hidden={theme_pin_hidden} />
                <GlassButton label={shell_offer_label} onclick={onShellSwitch} hidden={shell_offer_hidden} />
                <GlassButton variant="ghost" label={t('appearance.base_size_reset')} onclick={onBaseSizeReset} />
            </row>
        </column>
        <column class="settings-section" hidden={glass_hidden}>
            <text class="settings-section-title">{t('appearance.glass')}</text>
            <text class="settings-section-copy">{t('appearance.glass.copy')}</text>
            <column class="settings-group">
                <row class="settings-group-row">
                    <box class="row-tile row-tile-cyan"><icon class="row-icon" name="texture" size="16" /></box>
                    <text class="settings-group-label">{t('appearance.glass.style')}</text>
                    <row class="glass-style-options" aria-label={t('appearance.glass.style')}>
                        <button class="glass-style-option" class:glass-style-option-active={glass_style == "theme"} onclick={onGlassPresetTheme}><text class="glass-style-label" class:glass-style-label-active={glass_style == "theme"}>{t('appearance.glass.style.theme')}</text></button>
                        <button class="glass-style-option" class:glass-style-option-active={glass_style == "liquid"} onclick={onGlassPresetLiquid}><text class="glass-style-label" class:glass-style-label-active={glass_style == "liquid"}>{t('appearance.glass.style.liquid')}</text></button>
                        <button class="glass-style-option" class:glass-style-option-active={glass_style == "soft"} onclick={onGlassPresetSoft}><text class="glass-style-label" class:glass-style-label-active={glass_style == "soft"}>{t('appearance.glass.style.soft')}</text></button>
                        <button class="glass-style-option" class:glass-style-option-active={glass_style == "frosted"} onclick={onGlassPresetFrosted}><text class="glass-style-label" class:glass-style-label-active={glass_style == "frosted"}>{t('appearance.glass.style.frosted')}</text></button>
                    </row>
                </row>
                <box class="settings-group-divider" />
                <row class="settings-group-row">
                    <box class="row-tile row-tile-blue"><icon class="row-icon" name="blur" size="16" /></box>
                    <text class="settings-group-label">{t('appearance.glass.blur')}</text>
                    <text class="settings-value">{glass_blur_label}</text>
                    <slider class="glass-strength" min="0" max="100" step="1" value="{glass_blur}" onchange={onGlassBlur} onrelease={onGlassBlurRelease} aria-label={t('appearance.glass.blur')} />
                </row>
                <box class="settings-group-divider" />
                <row class="settings-group-row">
                    <box class="row-tile row-tile-purple"><icon class="row-icon" name="water-drop" size="16" /></box>
                    <text class="settings-group-label">{t('appearance.glass.liquid')}</text>
                    <text class="settings-value">{glass_liquid_label}</text>
                    <slider class="glass-strength" min="0" max="100" step="1" value="{glass_liquid}" onchange={onGlassLiquid} onrelease={onGlassLiquidRelease} aria-label={t('appearance.glass.liquid')} />
                </row>
            </column>
        </column>
    </column>
</template>

<script lang="luau">
local GlassButton = require("@mesh/glass-controls")
local PrefsPage = require("./prefs-page.mesh")
local glass_backdrops = require("@mesh/glass-material/strength")
hidden = false

local theme = require("mesh.theme")
local debug_ok, debug_service = pcall(require, "mesh.debug")
if not debug_ok then debug_service = nil end
local settings_ok, settings_service = pcall(require, "mesh.settings")
if not settings_ok then settings_service = nil end
local packages_ok, packages = pcall(require, "mesh.packages")
if not packages_ok then packages = nil end
local raw_t = import("mesh.i18n", "t")
-- An empty or missing key yields no text instead of the "!!" miss marker.
local function t(key, ...)
    if key == nil or key == "" then return "" end
    return raw_t(key, ...)
end

local wallpapers_ok, wallpapers = pcall(require, "mesh.wallpapers")
if not wallpapers_ok then wallpapers = nil end

local CANVAS_ORDER = { nocturne = 1, paper = 2, tapedeck = 3, bubblegum = 4, ["liquid-glass"] = 5 }

local function canvas_order(id)
    return CANVAS_ORDER[string.match(id, ":([^:]+)$") or id] or 6
end

other_themes_open = false
has_other_themes = false
icons_open = false
fonts_open = false
icon_theme_name = ""
accent_value = ""
available_modes = {}
wallpaper_rows = {}
has_wallpapers = false
accents = {
    { name = "violet", color = "#a78bfa", foreground = "#181127" },
    { name = "blue", color = "#0a6fe0", foreground = "#ffffff" },
    { name = "green", color = "#8fe3c4", foreground = "#11271e" },
    { name = "pink", color = "#ff8dbd", foreground = "#34173f" },
    { name = "orange", color = "#f4a572", foreground = "#2a1a11" },
}

function hideTheme(row) return not row.canvas and not row.active and not other_themes_open end
function onToggleThemes() other_themes_open = not other_themes_open end
function onToggleIcons() icons_open = not icons_open end
function onToggleFonts() fonts_open = not fonts_open end
function onMode(mode) theme.set_mode(mode) end
function onWallpaper(path) theme.set_backdrop_image(path) end

function onAccent(name)
    for _, accent in ipairs(accents) do
        if accent.name == name then
            accent_value = accent.color
            theme.set_tokens({ ["color-primary"] = accent.color, ["color-on-primary"] = accent.foreground })
            return
        end
    end
end

function onAccentReset()
    accent_value = ""
    theme.set_tokens({ ["color-primary"] = mesh.json.null, ["color-on-primary"] = mesh.json.null })
end

effect(function()
    local rows = {}
    local current = theme.backdrop_image
    for _, item in ipairs(wallpapers and wallpapers.wallpapers or {}) do
        if item.thumbnail ~= "" then
            rows[#rows + 1] = { path = item.path, name = item.name, thumbnail = item.thumbnail, active = item.path == current }
            if #rows == 6 then break end
        end
    end
    wallpaper_rows = rows
    has_wallpapers = #rows > 0
end)

theme_value = "material"
theme_rows = {}
theme_scope_label = ""
theme_coverage = ""
theme_pin_label = ""
theme_pin_hidden = true
shell_offer_label = ""
shell_offer_hidden = true
shell_offer_profile = ""
glass_hidden = true
icon_theme_rows = {}
font_rows = {}
icon_theme_value = "hicolor"
font_value = "system-ui"
base_size = 14
shell_scale = 100
icon_more_hidden = true
font_more_hidden = true
glass_style = "theme"
glass_blur = 0
glass_liquid = 0
glass_blur_label = "0%"
glass_liquid_label = "0%"

local RESOURCE_PAGE_SIZE = 24
local icon_limit = RESOURCE_PAGE_SIZE
local font_limit = RESOURCE_PAGE_SIZE
local font_catalog = {}
local font_revision = nil
local font_loading = false

local function fallback_preview_palette(theme_id)
    local id = string.lower(tostring(theme_id or ""))
    local light = string.find(id, "light", 1, true) ~= nil
    if light then
        return {
            surface = "#f5f6fa",
            surface_container_low = "#e8e9ef",
            surface_container_high = "#d9dbe4",
            primary = "#6750a4",
            outline_variant = "#79747e",
            on_surface = "#1c1b1f",
        }
    end
    return {
        surface = "#17181c",
        surface_container_low = "#24252b",
        surface_container_high = "#34353d",
        primary = "#d0bcff",
        outline_variant = "#938f99",
        on_surface = "#e6e1e5",
    }
end

local function preview_palette(option)
    local fallback = fallback_preview_palette(option.id)
    local palette = type(option.palette) == "table" and option.palette or {}
    return {
        surface = tostring(palette.surface or fallback.surface),
        surface_container_low = tostring(
            palette.surface_container_low or fallback.surface_container_low
        ),
        surface_container_high = tostring(
            palette.surface_container_high or fallback.surface_container_high
        ),
        primary = tostring(palette.primary or fallback.primary),
        outline_variant = tostring(palette.outline_variant or fallback.outline_variant),
        on_surface = tostring(palette.on_surface or fallback.on_surface),
    }
end

local function installed_themes()
    local rows = {}
    local seen = {}
    local positions = {}

    local function add_theme(candidate)
        local id = type(candidate) == "table" and candidate.id or candidate
        id = tostring(id or "")
        if id == "" then return end

        local label = type(candidate) == "table"
            and tostring(candidate.label or id)
            or id
        local palette = type(candidate) == "table" and candidate.palette or nil
        local position = positions[id]
        if position then
            -- A later source may know more than an early partial registry
            -- snapshot. Enrich the existing row without creating duplicates.
            if rows[position].label == id and label ~= id then
                rows[position].label = label
            end
            if rows[position].palette == nil and palette ~= nil then
                rows[position].palette = palette
            end
            if type(candidate) == "table" then
                for _, field in ipairs({ "coverage", "modes", "recommends" }) do
                    if candidate[field] ~= nil then
                        rows[position][field] = candidate[field]
                    end
                end
            end
            return
        end

        local details = type(candidate) == "table" and candidate or {}
        rows[#rows + 1] = {
            id = id,
            label = label,
            palette = palette,
            coverage = details.coverage,
            modes = details.modes,
            recommends = details.recommends,
        }
        positions[id] = #rows
        seen[id] = true
    end

    local service_themes = theme and theme.themes or {}

    if type(service_themes) == "table" then
        for _, candidate in ipairs(service_themes) do
            add_theme(candidate)
        end
    end

    local available = theme and theme.available or {}
    if type(available) == "table" then
        for _, candidate in ipairs(available) do
            add_theme(candidate)
        end
    end

    -- The graph can enrich a provider snapshot that has only published its
    -- active theme so far. Debug is optional in isolated component hosts, so
    -- read it behind pcall rather than turning Appearance into a hard debug
    -- dependency.
    local graph = {}
    local graph_ok, graph_value = pcall(function()
        return debug_service and debug_service.module_graph or {}
    end)
    if graph_ok and type(graph_value) == "table" then
        graph = graph_value
    end
    for _, entry in ipairs(graph) do
        if entry.enabled ~= false then
            local provided = (entry.provides or {}).themes
            if type(provided) == "table" then
                for _, candidate in ipairs(provided) do
                    add_theme(candidate)
                end
            end
        end
    end

    return rows, seen
end

-- A theme names the composition it is designed for (`recommends.composition`,
-- e.g. `@mesh/glass`); the profile of the same short name is offered, never
-- switched to silently. Glass strength only applies to glass compositions.
local function sync_shell(option)
    local recommends = option and type(option.recommends) == "table" and option.recommends or {}
    local composition = tostring(recommends.composition or "")
    glass_hidden = composition ~= "@mesh/glass"
    shell_offer_hidden = true
    shell_offer_profile = ""
    local name = string.match(composition, "^@mesh/([%w%-_]+)$")
    if name == nil or packages == nil or packages.active_profile == name then return end
    for _, id in ipairs(packages.profiles or {}) do
        if id == name then
            shell_offer_profile = id
            shell_offer_label = t('appearance.theme.shell_switch') .. " " .. id
            shell_offer_hidden = false
            return
        end
    end
end

local function sync_theme(theme_id)
    theme_value = tostring(theme_id or "material")
    local installed, seen = installed_themes()

    -- Keep the current theme selectable while the module graph is still being
    -- published, or if it came from a theme source not represented there yet.
    if not seen[theme_value] then
        installed[#installed + 1] = { id = theme_value, label = theme_value }
    end

    table.sort(installed, function(left, right)
        local a, b = canvas_order(left.id), canvas_order(right.id)
        if a == b then return left.label < right.label end
        return a < b
    end)
    local rows, modes = {}, {}
    theme_coverage = ""
    local more = false
    for index, option in ipairs(installed) do
        local active = option.id == theme_value
        local canvas = canvas_order(option.id) < 6
        more = more or (not canvas and not active)
        rows[index] = { id = option.id, label = option.label, palette = preview_palette(option), active = active, canvas = canvas }
        if active then
            sync_shell(option)
            if type(option.coverage) == "table" then
                theme_coverage = tostring(option.coverage.tuned or 0) .. " " .. t('appearance.coverage.tuned')
                    .. " · " .. tostring(option.coverage.defaults or 0) .. " " .. t('appearance.coverage.defaults')
                    .. " · " .. tostring(option.coverage.independent or 0) .. " " .. t('appearance.coverage.independent')
                    .. " · " .. tostring((option.coverage.internal_selectors or 0) + (option.coverage.absent_targets or 0)) .. " " .. t('appearance.coverage.warnings')
            end
            for _, mode in ipairs(type(option.modes) == "table" and option.modes or {}) do
                local name = type(mode) == "table" and mode.name or mode
                if type(name) == "string" then
                    local label = name
                    if name == "light" or name == "dark" then label = t("appearance.mode." .. name) end
                    modes[#modes + 1] = { name = name, label = label, active = theme.mode == name }
                end
            end
        end
    end
    theme_rows = rows
    available_modes = modes
    has_other_themes = more
end



local function sync_system_resources()
    local resources = theme and theme.system_resources or {}
    icon_theme_value = type(resources.active_icon_theme) == "string" and resources.active_icon_theme or ""
    icon_theme_name = icon_theme_value
    font_value = type(resources.active_font_family) == "string" and resources.active_font_family or ""

    local icons = {}
    icon_more_hidden = true
    for index, candidate in ipairs(resources.icon_themes or {}) do
        if index <= icon_limit then
            local id = tostring(candidate.id or "")
            local inherits = candidate.inherits or {}
            icons[index] = {
                id = id,
                name = tostring(candidate.name or id),
                detail = #inherits > 0
                    and (id .. " · " .. t('appearance.inherits') .. " " .. table.concat(inherits, ", "))
                    or id,
            }
        else
            icon_more_hidden = false
        end
    end
    icon_theme_rows = icons
    for _, row in ipairs(icons) do if row.id == icon_theme_value then icon_theme_name = row.name end end

    if resources.font_revision ~= font_revision or font_revision == nil then
        font_catalog = resources.font_families or {}
        font_revision = resources.font_revision
        font_limit = RESOURCE_PAGE_SIZE
    end
    local fonts = {}
    font_more_hidden = true
    for index, candidate in ipairs(font_catalog) do
        if index <= font_limit then
            local name = tostring(candidate.name or "")
            local face_count = tonumber(candidate.face_count or 0) or 0
            local kind = candidate.monospace and t('appearance.font.monospace') or t('appearance.font.proportional')
            fonts[index] = {
                name = name,
                detail = kind .. " · " .. tostring(face_count) .. " " .. t('appearance.font.faces'),
                family = "'" .. string.gsub(name, "'", "\\'") .. "'",
            }
        else
            font_more_hidden = false
        end
    end
    if tonumber(resources.font_total or #font_catalog) > font_limit then
        font_more_hidden = false
    end
    font_rows = fonts
end

-- Glass material. Strength 100% is each tier's strongest glass; the saved
-- `glass.strength.*` overrides record the choice, and the backdrop overrides
-- apply it to every module that uses @mesh/glass-material.
local GLASS_PRESETS = {
    liquid = { blur = 10, liquid = 100 },
    soft = { blur = 45, liquid = 45 },
    frosted = { blur = 100, liquid = 0 },
}

local function stored_tokens()
    local namespaces = settings_service and settings_service.namespaces or {}
    local shell = type(namespaces) == "table" and namespaces.shell or {}
    local themed = type(shell) == "table" and shell.theme or {}
    return type(themed) == "table" and type(themed.tokens) == "table" and themed.tokens or {}
end

local function show_glass(style, blur, liquid)
    glass_style = style
    glass_blur = blur
    glass_liquid = liquid
    glass_blur_label = tostring(math.floor(blur + 0.5)) .. "%"
    glass_liquid_label = tostring(math.floor(liquid + 0.5)) .. "%"
end

local function sync_glass()
    local tokens = stored_tokens()
    local blur = tonumber(tokens["glass.strength.blur"])
    local liquid = tonumber(tokens["glass.strength.liquid"])
    if blur == nil or liquid == nil then
        show_glass("theme", glass_blur, glass_liquid)
        return
    end
    show_glass(tostring(tokens["glass.strength.style"] or "custom"), blur, liquid)
end

local function apply_glass(style, blur, liquid)
    show_glass(style, blur, liquid)
    local tokens = glass_backdrops(blur, liquid)
    tokens["glass.strength.style"] = style
    tokens["glass.strength.blur"] = blur
    tokens["glass.strength.liquid"] = liquid
    theme.set_tokens(tokens)
end

local function slider_number(value)
    if type(value) == "table" then value = value.value end
    return math.max(0, math.min(100, tonumber(value) or 0))
end

function onGlassPresetTheme()
    show_glass("theme", glass_blur, glass_liquid)
    local tokens = glass_backdrops(nil, nil, mesh.json.null)
    tokens["glass.strength.style"] = mesh.json.null
    tokens["glass.strength.blur"] = mesh.json.null
    tokens["glass.strength.liquid"] = mesh.json.null
    theme.set_tokens(tokens)
end

function onGlassPresetLiquid() apply_glass("liquid", GLASS_PRESETS.liquid.blur, GLASS_PRESETS.liquid.liquid) end
function onGlassPresetSoft() apply_glass("soft", GLASS_PRESETS.soft.blur, GLASS_PRESETS.soft.liquid) end
function onGlassPresetFrosted() apply_glass("frosted", GLASS_PRESETS.frosted.blur, GLASS_PRESETS.frosted.liquid) end

-- Every token write is a full settings transaction plus a theme rebuild, so a
-- drag shows its value immediately and commits only when the slider is released.
function onGlassBlur(value) show_glass("custom", slider_number(value), glass_liquid) end
function onGlassLiquid(value) show_glass("custom", glass_blur, slider_number(value)) end
function onGlassBlurRelease(value) apply_glass("custom", slider_number(value), glass_liquid) end
function onGlassLiquidRelease(value) apply_glass("custom", glass_blur, slider_number(value)) end

effect(function()
    local current_theme = "material"
    if theme then
        current_theme = theme.current or theme.theme_id or current_theme
        if theme.state then
            current_theme = theme.state.current or theme.state.theme_id or current_theme
        end
    end
    sync_system_resources()
    local namespaces = settings_service and settings_service.namespaces or {}
    local shell = namespaces.shell or {}
    base_size = tonumber((shell.fonts or {}).base_size) or 14
    shell_scale = tonumber((shell.fonts or {}).shell_scale) or 100
    sync_theme(current_theme)
    local pinned = theme and theme.scope == "profile"
    theme_scope_label = pinned and t('appearance.theme.pinned') or t('appearance.theme.shared')
    theme_pin_label = pinned and t('appearance.theme.unpin') or t('appearance.theme.pin')
    theme_pin_hidden = not (pinned or (theme and theme.can_pin))
    sync_glass()
    accent_value = stored_tokens()["color-primary"] or ""
end)

function onThemeSelect(theme_id)
    local selected = tostring(theme_id or "")
    if selected == "" then return end
    sync_theme(selected)
    theme.set_theme(selected)
end

function onShellSwitch()
    if shell_offer_profile == "" or packages == nil then return end
    packages.switch_profile(shell_offer_profile)
end

function onThemePin()
    theme.set_theme(theme_value, theme.scope == "profile" and "user" or "profile")
end

function onIconThemeSelect(theme_id)
    local selected = tostring(theme_id or "")
    if selected == "" then return end
    icon_theme_value = selected
    theme.set_icon_theme(selected)
end

function onBaseSize(value) base_size = math.clamp(math.floor((slider_number(value) or 14) + 0.5), 10, 32) end
function onBaseSizeCommit(value) onBaseSize(value) theme.set_font_size(base_size) end
function onBaseSizeReset() base_size = 14 theme.set_font_size(14) end

function onShellScale(value)
    if type(value) == "table" then value = value.value end
    shell_scale = math.clamp(math.floor((tonumber(value) or 100) + 0.5), 70, 200)
end
function onShellScaleCommit(value) onShellScale(value) theme.set_shell_scale(shell_scale) end
function onShellScaleReset() shell_scale = 100 theme.set_shell_scale(100) end

function onFontSelect(family)
    local selected = tostring(family or "")
    if selected == "" then return end
    font_value = selected
    theme.set_font_family(selected)
end

function onShowMoreIcons()
    icon_limit = icon_limit + RESOURCE_PAGE_SIZE
    sync_system_resources()
end

function onShowMoreFonts()
    if font_loading then return end
    local resources = theme and theme.system_resources or {}
    if resources.font_revision ~= nil and #font_catalog < tonumber(resources.font_total or 0) then
        font_loading = true
        task.spawn(function()
            local succeeded, completion = pcall(function()
                return theme.list_font_families(#font_catalog, RESOURCE_PAGE_SIZE):await()
            end)
            font_loading = false
            if not succeeded then return end
            local page = completion and completion.result or {}
            if page.ok ~= true or page.revision ~= font_revision then return end
            for _, candidate in ipairs(page.families or {}) do
                font_catalog[#font_catalog + 1] = candidate
            end
            font_limit = font_limit + RESOURCE_PAGE_SIZE
            sync_system_resources()
        end)
        return
    end
    font_limit = font_limit + RESOURCE_PAGE_SIZE
    sync_system_resources()
end

</script>

<style>
    .appearance-columns { width: 100%; gap: 14px; flex-wrap: wrap; align-items: flex-start; }
    .settings-group.appearance-card { width: auto; min-width: 0; max-width: 100%; flex-basis: 290px; flex-grow: 1; }
    .appearance-icon-picker { min-width: 0; padding: 6px 10px; border-radius: var(--glass-radius-control); }
    .appearance-size { min-width: 65px; flex-grow: 1; }
    .accent-options { gap: 6px; align-items: center; flex-wrap: wrap; }
    .accent-swatch { width: 20px; height: 20px; padding: 0; flex-shrink: 0; border-radius: var(--radius-full); }
    .accent-swatch-active { border: 2px solid var(--glass-settings-text); }
    .wallpaper-grid { width: 100%; gap: 10px; flex-wrap: wrap; }
    .wallpaper-choice { min-width: 80px; flex-basis: 14%; flex-grow: 1; height: 74px; padding: 0; overflow: hidden; border-radius: var(--glass-radius-control); }
    .wallpaper-choice-active { border: 2px solid var(--color-primary); }
    .wallpaper-image { width: 100%; height: 100%; object-fit: cover; }

    .theme-grid {
        width: 100%;
        gap: 14px;
        flex-wrap: wrap;
    }

    .theme-option {
        flex-direction: column;
        align-items: stretch;
        min-width: 112px;
        flex-basis: 18%;
        flex-grow: 1;
        gap: var(--spacing-sm);
        padding: var(--spacing-sm);
        border-radius: var(--glass-radius-card);
        border-width: var(--glass-border-width);
        border-style: solid;
        border-color: var(--glass-settings-rim);
        background: var(--glass-settings-inset);
        box-shadow: var(--glass-shadow-group);
        color: var(--glass-settings-text);
    }

    .theme-option-active,
    .theme-option-active:hover {
        background: transparent;
        background-image: var(--glass-settings-selected);
        border-color: var(--glass-control-rim-focus);
    }

    .theme-option:hover {
        background-image: linear-gradient(to bottom, var(--glass-control-fill-hover), var(--glass-control-fill-hover));
        border-color: var(--glass-control-rim-hover);
    }

    .theme-option:active {
        background: var(--glass-control-fill-pressed);
    }

    .theme-preview {
        width: 100%;
        height: 78px;
        overflow: hidden;
        border-radius: var(--radius-sm);
    }

    .theme-preview-sidebar {
        width: 30%;
        height: 100%;
        gap: 8px;
        padding: 6px;
    }

    .theme-preview-body {
        flex-grow: 1;
        gap: 6px;
        padding: 8px;
    }

    .theme-preview-dot {
        width: 10px;
        height: 10px;
        border-radius: var(--radius-full);
    }

    .theme-preview-line,
    .theme-preview-heading,
    .theme-preview-panel {
        border-radius: var(--radius-full);
    }

    .theme-preview-line {
        width: 100%;
        height: 5px;
    }

    .theme-preview-line-short {
        width: 68%;
    }

    .theme-preview-heading {
        width: 55%;
        height: 8px;
    }

    .theme-preview-panel {
        width: 100%;
        height: 32px;
        border-radius: var(--radius-sm);
    }

    .theme-option-copy {
        width: 100%;
        gap: 2px;
        padding-inline: var(--spacing-xs);
        padding-bottom: var(--spacing-xs);
    }


    .theme-title-row {
        width: 100%;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .theme-title {
        height: auto;
        color: var(--glass-settings-text);
        font-size: 13px;
        font-weight: 750;
    }


    /* A grouped card of rows, as in the reference system settings. */
    .settings-group {
        width: 100%;
        padding: var(--spacing-sm);
        border-radius: var(--glass-radius-card);
        border-width: var(--glass-border-width);
        border-style: solid;
        border-color: var(--glass-settings-rim);
        background: var(--glass-settings-inset);
        box-shadow: var(--glass-shadow-group);
    }

    .settings-group-row {
        width: 100%;
        min-height: 48px;
        align-items: center;
        gap: var(--spacing-md);
        padding-inline: var(--spacing-sm);
    }

    .settings-group-label {
        height: auto;
        flex-grow: 1;
        color: var(--glass-settings-text);
        font-size: var(--typography-size-sm);
        font-weight: 600;
    }

    .settings-group-divider {
        width: 100%;
        height: 1px;
        background: var(--glass-settings-rim);
    }

    .row-tile {
        width: 28px;
        height: 28px;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: var(--color-primary);
    }

    .row-tile-cyan { background: var(--color-info); }
    .row-tile-blue { background: var(--color-primary); }
    .row-tile-purple { background: var(--color-tertiary-container); }

    .row-icon {
        color: var(--color-on-primary);
    }

    .glass-style-options {
        flex-shrink: 0;
        gap: 2px;
        padding: 2px;
        border-radius: var(--radius-full);
        background: color-mix(in srgb, var(--glass-settings-text) 8%, transparent);
    }

    .glass-style-option {
        height: 28px;
        padding-inline: 12px;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-full);
        background: transparent;
        transition: background-color var(--animation-duration-short) var(--animation-curves-bezier-standard);
    }

    .glass-style-option:hover {
        background: color-mix(in srgb, var(--glass-settings-text) 6%, transparent);
    }

    .glass-style-option-active,
    .glass-style-option-active:hover {
        background: var(--glass-settings-inset);
        box-shadow: 0 1px 3px #0000001f;
    }

    .glass-style-label {
        height: auto;
        color: var(--glass-settings-text-muted);
        font-size: var(--typography-size-xs);
        font-weight: 600;
    }

    .glass-style-label-active {
        color: var(--color-primary);
    }

    .glass-strength {
        width: 200px;
        flex-shrink: 0;
    }

    .language-check {
        color: var(--glass-indicator);
        font-size: var(--typography-size-xs);
        font-weight: 800;
    }

    .language-option {
        width: 100%;
        min-height: 58px;
        align-items: center;
        justify-content: space-between;
        gap: var(--spacing-md);
        padding-inline: var(--spacing-md);
        border-radius: var(--radius-md);
        border-width: 1px;
        border-style: solid;
        border-color: var(--glass-settings-rim);
        background: var(--glass-settings-inset);
        color: var(--glass-settings-text);
        text-align: left;
    }

    .language-option:hover {
        background-image: linear-gradient(to bottom, var(--glass-control-fill-hover), var(--glass-control-fill-hover));
        border-color: var(--glass-control-rim-hover);
    }

    .language-option:active {
        background: var(--glass-control-fill-pressed);
    }

    .language-option-active,
    .language-option-active:hover {
        background: transparent;
        background-image: var(--glass-settings-selected);
        border-color: var(--glass-control-rim-focus);
    }

    .settings-segmented {
        align-self: flex-start;
        gap: var(--spacing-xs);
        padding: var(--spacing-xs);
        border-radius: var(--radius-full);
        border-width: 1px;
        border-style: solid;
        border-color: var(--glass-settings-rim);
        background: var(--glass-settings-inset);
    }

    .resource-list {
        height: auto;
        max-height: 360px;
        overflow-y: auto;
    }

</style>
