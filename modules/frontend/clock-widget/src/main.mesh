<template>
  <button
    class="clock-btn"
    onclick={onClockClick}
    title={clockLabel()}
    aria-label={clockLabel()}
  >
    <column class="clock-content">
      <text class="clock-time">{clockTime()}</text>
      <text class="clock-date">{clockDate()}</text>
    </column>
  </button>
</template>

<script lang="luau">
local t = import("mesh.i18n", "t")

clock_now = os.time()

task.spawn(function()
    while true do
        task.sleep((60 - os.time() % 60) * 1000)
        clock_now = os.time()
    end
end)

local function clockTime()
    return mesh.locale.format_time(clock_now)
end

local function clockDate()
    return mesh.locale.format_date(clock_now, "month_day")
end

local function clockLabel()
    return t("nav.clock_full_date", {
        date = mesh.locale.format_date(clock_now, "full"),
        time = mesh.locale.format_time(clock_now),
    })
end

function onClockClick()
    -- No calendar surface exists yet; wire this to a real surface toggle
    -- (shell.toggle-surface with its surface_id) once one ships.
end
</script>

<style>
.clock-btn {
    height: 100%;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    padding-inline: var(--spacing-sm);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-on-surface-variant);
    border-width: 2px;
    border-style: solid;
    border-color: transparent;
    transform: scale(1);
    text-wrap: none;
    transition-property: color, border-color, transform;
    transition-duration: var(--animation-duration-medium);
    transition-timing-function: var(--animation-curves-bezier-standard);
}

.clock-btn:hover {
    color: var(--color-on-surface);
    transform: scale(1.05);
}

.clock-btn:focus-visible {
    color: var(--color-on-surface);
    border-color: var(--color-primary);
}

.clock-btn:active {
    color: var(--color-primary);
    transform: scale(0.96);
}

.clock-content {
    align-items: center;
    gap: 0;
}

/* Themes give `text` a fixed 22px row. Two of those stack to 44px inside a
button with 24px of content, spilling past its border; size each line to its
own line-height instead. */
.clock-time,
.clock-date {
    height: auto;
}

.clock-time {
    color: inherit;
    font-size: 12px;
    font-weight: 700;
    text-wrap: none;
    line-height: 1.1;
}

.clock-date {
    color: inherit;
    font-size: 9px;
    font-weight: 500;
    text-wrap: none;
    opacity: 0.75;
    line-height: 1.1;
}
</style>
