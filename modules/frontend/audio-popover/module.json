{
  "name": "@mesh/audio-popover",
  "version": "0.1.0",
  "description": "Compact audio controls popover embedded in the navigation bar.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "component",
    "uses": {
      "interfaces": {
        "mesh.audio": ">=1.0"
      },
      "capabilities": ["service.audio.read", "service.audio.control"]
    },
    "entry": "src/main.mesh",
    "accessibility": {
      "role": "dialog",
      "label": "Audio controls",
      "description": "Compact audio controls popover"
    }
  }
}
