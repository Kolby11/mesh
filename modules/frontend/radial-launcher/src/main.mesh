<template>
    <box class="overlay">
        <button class="scrim" onclick={onClose} keybind="close" onkeybind={onEscape} aria-label={t("launcher.close")} tabindex="-1" />
        <button class="key-sink" keybind="search" onkeybind={onSearch} aria-label={t("launcher.search")} tabindex="-1" />
        <box class="stage" aria-label={t("launcher.title")}>
            {#for app in ring key={app.id}}
                <shape
                    class="wedge"
                    class:wedge-focused={app.focused}
                    type="sector"
                    start={app.start}
                    end={app.sweep_end}
                    inner="0.45"
                    role="button"
                    tabindex="0"
                    onclick={onLaunch(app.id)}
                    onpointerenter={onHint(app.name)}
                    onpointerleave={onHint("")}
                    title={app.name}
                    aria-label={app.name}
                >
                    <shape class="rim" class:rim-running={app.running} type="arc" start={app.start} end={app.sweep_end} />
                    <image class="wedge-art" style={app.art_style} src={app.icon} alt="" hidden={not app.has_file} />
                    <icon class="wedge-art" style={app.art_style} name="application-x-executable" size="44" hidden={app.has_file} />
                </shape>
            {/for}
                <shape class="wedge media-wedge" type="sector" start="197" end="231" inner="0.52" role="button" tabindex="0" onclick={previous} aria-label={t("launcher.previous")} title={t("launcher.previous")}>
                    <icon class="media-art" style="left: 116px; top: 347px;" name="media-skip-backward" size="22" />
                </shape>
                <shape class="wedge media-wedge" type="sector" start="163" end="197" inner="0.52" role="button" tabindex="0" onclick={toggle} aria-label={playing and t("launcher.pause") or t("launcher.play")} title={playing and t("launcher.pause") or t("launcher.play")}>
                    <icon class="media-art" style="left: 209px; top: 376px;" name={playing and "media-playback-pause" or "media-playback-start"} size="22" />
                </shape>
                <shape class="wedge media-wedge" type="sector" start="129" end="163" inner="0.52" role="button" tabindex="0" onclick={nextTrack} aria-label={t("launcher.next")} title={t("launcher.next")}>
                    <icon class="media-art" style="left: 302px; top: 347px;" name="media-skip-forward" size="22" />
                </shape>
            <shape class="hub" type="sector">
                <text class="hub-time">{clock_time}</text>
                <text class="hub-date">{clock_date}</text>
                <input class="hub-search" ref="search" value={query} oninput={onQuery} onkeydown={onSearchKey} placeholder={t("launcher.placeholder")} aria-label={t("launcher.search")} hidden={not searching} />
                <text class="hub-hint" hidden={searching}>{hint}</text>
            </shape>
        </box>
    </box>
</template>

<script lang="luau">
local t = import("mesh.i18n", "t")
local apps_service = require("mesh.apps")
local media = require("mesh.media")

local SURFACE = "@mesh/radial-launcher"
local SLOTS = 8
local ARC_START = 237
local ARC_SPAN = 246
local WEDGE_GAP = 1.5
local CENTRE = 260
local ART_RADIUS = 188
local ART_SIZE = 44

ring = {}
hint = ""
query = ""
searching = false
clock_time = ""
clock_date = ""
media_ready = false
playing = false

local function artStyle(degrees)
    local radians = math.rad(degrees)
    local x = CENTRE + ART_RADIUS * math.sin(radians) - ART_SIZE / 2
    local y = CENTRE - ART_RADIUS * math.cos(radians) - ART_SIZE / 2
    return string.format("left: %dpx; top: %dpx;", math.floor(x + 0.5), math.floor(y + 0.5))
end

local function sourceApps()
    if query == "" then
        return apps_service.apps or {}
    end
    local needle = string.lower(query)
    local matches = {}
    for _, app in apps_service.installed or {} do
        if string.find(string.lower(app.name or ""), needle, 1, true) then
            matches[#matches + 1] = app
        end
    end
    return matches
end

effect(function()
    local list = {}
    if apps_service.available then
        local width = ARC_SPAN / SLOTS
        for index, app in sourceApps() do
            if index > SLOTS then break end
            local from = ARC_START + (index - 1) * width
            list[index] = {
                id = app.id,
                name = app.name,
                icon = app.icon or "",
                has_file = string.sub(app.icon or "", 1, 1) == "/",
                running = app.running,
                focused = app.focused,
                start = from + WEDGE_GAP / 2,
                sweep_end = from + width - WEDGE_GAP / 2,
                art_style = artStyle(from + width / 2),
            }
        end
    end
    ring = list
end)

effect(function()
    media_ready = media.available == true
    playing = media_ready and media.state.state == "playing"
end)

local function updateClock()
    clock_time = mesh.locale.format_time(os.time())
    clock_date = mesh.locale.format_date(os.time(), "month_day")
end
updateClock()
task.spawn(function()
    while true do
        task.sleep((60 - os.time() % 60) * 1000)
        updateClock()
    end
end)

local function endSearch()
    searching = false
    query = ""
end

function onClose()
    endSearch()
    mesh.shell.hide_surface(SURFACE)
end
function onEscape()
    if searching then
        endSearch()
    else
        onClose()
    end
end
function onSearch()
    searching = true
    task.spawn(function()
        task.sleep(1)
        refs.search:focus()
    end)
end
function onQuery(value) query = tostring(value or "") end
function onSearchKey(event)
    if event and event.key == "Enter" and ring[1] then
        onLaunch(ring[1].id)
    end
end
function onHint(name) hint = name end
function onLaunch(id)
    apps_service.activate(id)
    onClose()
end
function previous() if media_ready then media.previous() end end
function toggle() if media_ready then media.play_pause() end end
function nextTrack() if media_ready then media.next() end end
</script>

<style>
    .overlay { width: 100%; height: 100%; justify-content: center; align-items: center; background: transparent; }
    .scrim { position: absolute; left: 0; top: 0; width: 100%; height: 100%; padding: 0; border-radius: 0; background: var(--color-scrim); opacity: 0.45; transition: opacity var(--animation-duration-short) var(--animation-curves-bezier-standard); }
    .scrim.mesh-surface-entering { opacity: 0; }
    .scrim.mesh-surface-exiting { opacity: 0; transition-duration: var(--animation-duration-fast); }

    .key-sink { position: absolute; left: 0; top: 0; width: 1px; height: 1px; padding: 0; background: transparent; opacity: 0; }

    .stage { position: relative; width: 520px; height: 520px; background: transparent; }

    /* Wedges are vector shapes: the box paints nothing, the background fills the
    sector and the border strokes it, and pointer hits land on the wedge only. */
    .wedge { position: absolute; left: 0; top: 0; width: 520px; height: 520px; background-color: var(--color-surface); border: 1px solid var(--color-outline-variant); }
    .wedge:hover, .wedge:focus-visible { background-color: var(--color-surface-variant); }
    .wedge-focused { border-color: var(--color-primary); }
    .wedge-art { position: absolute; width: 44px; height: 44px; }

    .rim { position: absolute; left: 0; top: 0; width: 520px; height: 520px; background: transparent; border: 0 solid var(--color-primary); }
    .rim-running { border-width: 3px; }

    .media-wedge { left: 40px; top: 40px; width: 440px; height: 440px; }
    .media-art { position: absolute; width: 22px; height: 22px; }

    .hub { position: absolute; left: 150px; top: 150px; width: 220px; height: 220px; padding: 20px; gap: 2px; flex-direction: column; justify-content: center; align-items: center; border: 2px solid var(--color-outline-variant); background: var(--color-surface); color: var(--color-on-surface); }
    .hub-time { height: 48px; font-size: 40px; font-weight: 700; }
    .hub-date { height: 20px; font-size: 14px; color: var(--color-on-surface-variant); }
    .hub-search { width: 160px; height: 30px; margin-top: 8px; padding: 4px 10px; font-size: 13px; border-radius: 999px; border: 1px solid var(--color-outline-variant); background: var(--color-surface-variant); color: var(--color-on-surface); }
    .hub-hint { height: 18px; margin-top: 8px; font-size: 12px; color: var(--color-primary); text-overflow: ellipsis; }
</style>
