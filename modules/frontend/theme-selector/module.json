{
  "name": "@mesh/theme-selector",
  "version": "0.1.0",
  "description": "Theme selection popover for the navigation bar.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "ui",
    "uses": {
      "interfaces": {
        "mesh.theme": ">=1.0"
      },
      "modules": {
        "@mesh/bubble-options": ">=0.1.0"
      },
      "resources": {
        "icons": [
          "@mesh/icons-material-symbols",
          "@mesh/icons-default"
        ]
      },
      "capabilities": [
        "theme.read",
        "locale.read",
        "service.theme.control"
      ]
    },
    "iconRequirements": {
      "required": [
        "palette",
        "weather-clear",
        "weather-clear-night"
      ]
    },
    "entry": "src/main.mesh",
    "i18n": {
      "defaultLocale": "en",
      "supportedLocales": ["en", "sk"]
    },
    "contributes": {
      "i18n": [
        { "id": "en", "locale": "en", "path": "config/i18n/en.json" },
        { "id": "sk", "locale": "sk", "path": "config/i18n/sk.json" }
      ]
    },
    "accessibility": {
      "role": "menu"
    }
  }
}
