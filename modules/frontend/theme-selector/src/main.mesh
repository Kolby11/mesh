<props>
{
    blur_enabled = { type = "bool", default = true, label = "Backdrop blur" },
    blur_radius = { type = "size", default = "var(--effect-backdrop-blur-popup-radius)", label = "Blur radius" },
    blur_background = { type = "color", default = "var(--effect-backdrop-blur-popup-background)", label = "Frosted background" },
}
</props>

<template>
    <popover
        open={open}
        class="theme-float-shell"
        aria-label="Select theme"
        anchor-ref="themeButton"
        anchor="bottom"
        gravity="bottom"
        open-on="hover"
    >
        <column class="theme-picker-content">
            <BubbleOptions
                label="Select theme"
                items={items}
                rotation={rotation}
                onselect={onSelectTheme}
                onscroll={onThemeScroll}
            />
            <column class="theme-picker-info">
                <text class="theme-picker-summary">{coverage_label}</text>
                <text class="theme-picker-summary">{scope_label}</text>
                <button class="theme-picker-pin" hidden={pin_hidden} onclick={onThemePin}>{pin_label}</button>
            </column>
        </column>
    </popover>
</template>

<script lang="luau">
local theme = require("mesh.theme")
local BubbleOptions = require("@mesh/bubble-options")
local t = import("mesh.i18n", "t")

coverage_label = ""
scope_label = ""
pin_label = ""
pin_hidden = true

-- Written by the core disclosure controller (`open-on="hover"`).
open = false
-- Whether the last render saw the popover open, so closing it re-centres the
-- ring once.
local was_open = false

-- One descriptor per visible slot; BubbleOptions owns its structural classes.
items = {}

-- Ring rotation token handed to BubbleOptions; see its `rotation` prop.
rotation = ""
local rotation_tick = 0
-- Index of the leftmost theme on screen. Three of the installed themes are
-- visible at a time and scrolling turns the rest through, so adding a theme
-- costs nothing in popover width.
local VISIBLE_SLOTS = 3
local window_start = 1
local window_centred = false
-- Optimistic selection: the theme this popover asked for, and the theme the
-- service was reporting when it asked. See `active_theme`.
local pending_theme = nil
local pending_theme_replaced = nil
local theme_changed = nil

-- Dark and light are modes of the default theme; quick settings switches them.
local THEME_DEFAULT = "mesh-default"
local THEME_GRUVBOX = "gruvbox-dark"
local THEME_NORD = "nord"
local THEME_MOCHA = "catppuccin-mocha"
local THEME_TOKYO = "tokyo-night"
local THEME_LIQUID = "liquid-glass"
local THEME_VITRUM = "vitrum"

current_theme = THEME_DEFAULT

-- Every installed theme, in ring order. Three of them fit on screen at once and
-- scrolling turns the rest through; each `core` class carries that theme's own
-- swatch colours so a bubble previews the palette it applies.
local THEME_OPTIONS = {
    { id = THEME_DEFAULT, core = "bubble-option-core-default", icon = "weather-clear-night" },
    { id = THEME_GRUVBOX, core = "bubble-option-core-gruvbox", icon = "palette" },
    { id = THEME_NORD, core = "bubble-option-core-nord", icon = "weather-snow" },
    { id = THEME_MOCHA, core = "bubble-option-core-mocha", icon = "palette" },
    { id = THEME_TOKYO, core = "bubble-option-core-tokyo", icon = "weather-clear-night" },
    { id = THEME_LIQUID, core = "bubble-option-core-liquid", icon = "weather-clear" },
    { id = THEME_VITRUM, core = "bubble-option-core-vitrum", icon = "weather-clear-night" },
}

local THEME_LABELS = {
    [THEME_DEFAULT] = "MESH Default",
    [THEME_GRUVBOX] = "Gruvbox",
    [THEME_NORD] = "Nord",
    [THEME_MOCHA] = "Catppuccin Mocha",
    [THEME_TOKYO] = "Tokyo Night",
    [THEME_LIQUID] = "Liquid Glass",
    [THEME_VITRUM] = "Vitrum",
}

-- The bubble stage routes both the wheel's `scroll` and the trackpad's
-- `twofingerscroll` here. A wheel sends one event per notch, but a trackpad
-- sends a continuous stream of small pixel deltas, so stepping the ring per
-- event would spin it. Trackpad travel accumulates and only spends a notch at
-- a time; the wheel keeps its one-step-per-event behaviour.
local TWO_FINGER_NOTCH = 40
local two_finger_travel = 0

local function scroll_step(event)
    local delta = event and event.delta or {}
    local dy = tonumber(delta.y) or 0
    if event ~= nil and event.type == "twofingerscroll" then
        if dy == 0 then
            return 0
        end
        -- Reversing direction should not first have to pay off travel banked
        -- the other way, or the ring stalls when the user changes their mind.
        if (dy > 0) ~= (two_finger_travel > 0) then
            two_finger_travel = 0
        end
        two_finger_travel += dy
        if math.abs(two_finger_travel) < TWO_FINGER_NOTCH then
            return 0
        end
        local step = two_finger_travel > 0 and 1 or -1
        two_finger_travel -= step * TWO_FINGER_NOTCH
        return step
    end
    return dy >= 0 and 1 or -1
end

local function build_option(option, current)
    local core_class = "bubble-option-core " .. option.core
    if option.id == current then
        core_class = core_class .. " bubble-option-core-active " .. option.core .. "-active"
    end

    return {
        id = option.id,
        core_class = core_class,
        icon_class = "bubble-option-icon",
        icon = option.icon,
        text_class = "bubble-option-text bubble-option-hidden",
        text = "",
        title = THEME_LABELS[option.id] or option.label or option.id,
        active = option.id == current,
    }
end

-- The ring offers the installed themes: shipped ones keep their tuned swatch,
-- and any other installed theme gets a generic bubble. Without a catalog the
-- shipped list stands in.
local function theme_options()
    local installed = theme and theme.themes
    if type(installed) ~= "table" or #installed == 0 then
        return THEME_OPTIONS
    end
    local present = {}
    for _, entry in installed do
        if type(entry) == "table" and type(entry.id) == "string" then
            present[entry.id] = entry
        end
    end
    local options = {}
    local known = {}
    for _, option in THEME_OPTIONS do
        known[option.id] = true
        if present[option.id] then
            options[#options + 1] = option
        end
    end
    for _, entry in installed do
        if type(entry) == "table" and type(entry.id) == "string" and not known[entry.id] then
            known[entry.id] = true
            options[#options + 1] = {
                id = entry.id,
                core = "bubble-option-core-generic",
                icon = "palette",
                label = tostring(entry.label or entry.id),
            }
        end
    end
    if #options == 0 then
        return THEME_OPTIONS
    end
    return options
end

local function normalize_index(index)
    local count = #theme_options()
    return ((index - 1) % count) + 1
end

local function sync_options(current)
    local next_items = {}
    local options = theme_options()
    for slot = 1, VISIBLE_SLOTS do
        local option = options[normalize_index(window_start + slot - 1)]
        next_items[slot] = build_option(option, current)
    end
    items = next_items
end

-- Put the active theme in the middle slot. Called when the ring is not being
-- browsed: on first paint and once the popover has closed, so the next open
-- starts centred rather than wherever the last scroll left it.
local function centre_window_on(theme_id)
    for index, option in theme_options() do
        if option.id == theme_id then
            window_start = normalize_index(index - 1)
            rotation = ""
            return
        end
    end
end

local function service_theme()
    if not theme then
        return THEME_DEFAULT
    end
    return theme.current or theme.theme_id or THEME_DEFAULT
end

-- Which theme the ring marks as active. Applying a theme is a round trip
-- through the shell, so a click marks the picked bubble immediately and holds
-- that mark until the service reports something other than the theme that was
-- active when the click happened — that is either our own theme arriving or a
-- change made elsewhere, and both are reasons to stop overriding.
local function active_theme()
    if pending_theme == nil then
        return service_theme()
    end
    if service_theme() ~= pending_theme_replaced then
        pending_theme = nil
        pending_theme_replaced = nil
        return service_theme()
    end
    return pending_theme
end

local function set_current_theme(theme_id)
    if current_theme == theme_id then
        return
    end
    current_theme = theme_id
    if theme_changed ~= nil then
        theme_changed:fire({ theme_id = theme_id })
    end
end

function init(self)
    theme_changed = self.ThemeChanged
    set_current_theme(active_theme())
end

effect(function(self)
    if was_open and not open then
        -- A selection the service never confirmed (rejected or a no-op) must
        -- not outlive the popover.
        pending_theme = nil
        pending_theme_replaced = nil
    end
    local current = active_theme()
    set_current_theme(current)
    if not window_centred then
        window_centred = true
        centre_window_on(current)
    end
    if was_open and not open then
        -- Closed: the next open starts from the active theme again.
        centre_window_on(current)
    end
    was_open = open
    sync_options(current)
    coverage_label = t('coverage.unavailable')
    for _, option in ipairs(theme.themes or {}) do
        if option.id == current and type(option.coverage) == "table" then
            local coverage = option.coverage
            coverage_label = tostring(coverage.tuned or 0) .. " " .. t('coverage.tuned')
                .. " · " .. tostring(coverage.defaults or 0) .. " " .. t('coverage.defaults')
                .. " · " .. tostring(coverage.independent or 0) .. " " .. t('coverage.independent')
                .. " · " .. tostring((coverage.internal_selectors or 0) + (coverage.absent_targets or 0)) .. " " .. t('coverage.warnings')
        end
    end
    local pinned = theme.scope == "profile"
    scope_label = pinned and t('theme.pinned') or t('theme.shared')
    pin_label = pinned and t('theme.unpin') or t('theme.pin')
    pin_hidden = not (pinned or theme.can_pin)
end)

-- Selecting a theme does not close the popover: it stays open so the user can
-- keep choosing until the pointer or keyboard focus leaves it.
function onSelectTheme(theme_id)
    pending_theme_replaced = service_theme()
    pending_theme = theme_id
    set_current_theme(theme_id)
    sync_options(theme_id)
    theme.set_theme(theme_id)
end

function onThemePin()
    theme.set_theme(active_theme(), theme.scope == "profile" and "user" or "profile")
end

-- Scrolling turns the ring one theme at a time.
function onThemeScroll(event)
    local step = scroll_step(event)
    if step == 0 then
        return
    end
    rotation_tick += 1
    if step > 0 then
        window_start = normalize_index(window_start + 1)
        rotation = "next-" .. rotation_tick
    else
        window_start = normalize_index(window_start - 1)
        rotation = "prev-" .. rotation_tick
    end
    sync_options(active_theme())
end

</script>

<style>
    .theme-picker-content {
        width: fit;
        align-items: center;
        gap: var(--spacing-sm);
        padding-bottom: var(--spacing-sm);
    }

    .theme-picker-summary {
        width: 100%;
        white-space: normal;
        font-size: var(--typography-size-xs);
        color: var(--color-on-surface);
    }

    .theme-picker-info {
        width: 220px;
        max-width: 100%;
        gap: var(--spacing-sm);
        padding: var(--spacing-sm);
        border-radius: var(--radius-md);
        background: var(--color-surface-container-high);
    }

    .theme-picker-pin {
        padding: var(--spacing-sm) var(--spacing-md);
        border-radius: var(--radius-md);
        background: var(--color-surface-container-high);
        color: var(--color-on-surface);
    }

    .theme-float-shell {
        /* Sized to the bounding box of the BubbleOptions content instead of a
        hardcoded size — <popover> isn't a container tag, so it needs the
        fit value explicitly (box/row/column default to it). */
        width: fit;
        height: fit;
        padding: 0;
        background: transparent;
        opacity: 1;
        transform: translateY(0px) scale(1);
        transition: transform 220ms var(--animation-curves-bezier-emphasized-decelerate),
        opacity 180ms var(--animation-curves-bezier-standard);
    }

    .theme-float-shell.mesh-surface-entering {
        opacity: 1;
        transform: translateY(-8px) scale(0.92);
    }

    .theme-float-shell.mesh-surface-exiting {
        opacity: 0;
        transform: translateY(-6px) scale(0.94);
        transition: transform 140ms var(--animation-curves-bezier-standard),
        opacity 180ms var(--animation-curves-bezier-standard);
    }
</style>
