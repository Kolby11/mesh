<props>
blur_enabled:    { type: "bool", default: true, label: "Backdrop blur" }
blur_radius:     { type: "size", default: "var(--effect-backdrop-blur-popup-radius)", label: "Blur radius" }
blur_background: { type: "color", default: "var(--effect-backdrop-blur-popup-background)", label: "Frosted background" }
</props>

<template>
    <box
        class="bubble-options-stage"
        style={bubbleStageStyle()}
        role="menu"
        onscroll={onscroll}
        ontwofingerscroll={onscroll}
        aria-label={label}
    >
        {#for item in items}
            <button
                class={bubbleOptionClass(item.id)}
                style={bubbleOptionStyle(item.id)}
                role="menuitemradio"
                aria-checked={item.active}
                onclick={onselect(item.id)}
                onpointerenter={onoptionpointerenter}
                onfocus={onoptionfocus}
                onblur={onoptionblur}
                onkeydown={onoptionkeydown}
                data-tooltip-disabled="true"
                title={item.title}
                aria-label={item.title}
            >
                <box class={bubbleMotionClass(item.id)}>
                    <box class={blurCoreClass(item.core_class)}>
                        <icon class={item.icon_class} name={item.icon} size="14" />
                        <text class={item.text_class}>{item.text}</text>
                    </box>
                </box>
            </button>
        {/for}
    </box>
</template>

<script lang="luau">
label = "Options"

-- Each entry: { id, core_class, icon_class, icon, text_class, text, title,
-- active }. This component owns layout and structural classes; callers only
-- describe the option's content and visual variant.
items = {}

-- Called with the selected item's `id` (onselect(item.id)).
onselect = nil
-- Receives both the wheel's `scroll` and the trackpad's `twofingerscroll`.
-- They are separate events with different delta scales — one event per notch
-- versus a continuous pixel stream — so the caller reads `event.type` and
-- notches the continuous one before stepping its ring.
onscroll = nil
-- Ring rotation feedback. Callers that cycle a window of options over a larger
-- set pass a token that changes on every scroll step: "next-<tick>" when the
-- ring turns one slot toward the end of the set, "prev-<tick>" toward the
-- start. The tick makes the token differ between consecutive steps in the same
-- direction, so the one-shot slide animation restarts instead of staying
-- finished on its last keyframe.
rotation = ""
onoptionpointerenter = nil
onoptionfocus = nil
onoptionblur = nil
onoptionkeydown = nil

local ITEM_SIZE = 36
-- Bubbles sit side by side with a hairline gap rather than overlapping: the
-- arc is shallow enough now that overlap would read as a pile, not a curve.
local HORIZONTAL_STEP = 38
local HORIZONTAL_PADDING = 10
local TOP_OFFSET = 8
-- How far the middle slot hangs below the outer ones. Kept small so the row
-- reads as a line with a slight sag — a hint of a circle, not a half-moon.
local ARC_DEPTH = 10
local BOTTOM_SLACK = 6

local function itemIndex(id)
    for index, item in items do
        if item.id == id then
            return index
        end
    end
    return 1
end

function bubbleStageStyle()
    local count = math.max(#items, 1)
    local width = HORIZONTAL_PADDING * 2 + ITEM_SIZE + HORIZONTAL_STEP * (count - 1)
    local height = TOP_OFFSET + ARC_DEPTH + ITEM_SIZE + BOTTOM_SLACK
    return "width: " .. width .. "px; height: " .. height .. "px;"
end

function bubbleOptionStyle(id)
    local count = math.max(#items, 1)
    local index = itemIndex(id)
    local left = HORIZONTAL_PADDING + HORIZONTAL_STEP * (index - 1)
    local top = TOP_OFFSET

    if count > 1 then
        local normalized = (2 * (index - 1) / (count - 1)) - 1
        top = TOP_OFFSET + ARC_DEPTH * (1 - normalized * normalized)
    end

    return string.format("left: %.2fpx; top: %.2fpx;", left, top)
end

-- Decode the caller's rotation token into direction and replay phase. Two
-- alternating phase names per variant is what makes the engine restart the
-- animation when consecutive steps go the same way.
local function rotationStep()
    if type(rotation) ~= "string" or rotation == "" then
        return nil
    end
    local direction, tick = string.match(rotation, "^(%a+)-(%d+)$")
    if direction ~= "next" and direction ~= "prev" then
        return nil
    end
    return direction, (tonumber(tick) or 0) % 2 == 0 and "a" or "b"
end

-- One step slides every bubble along the arc into the slot ahead of it, so the
-- row reads as a ring turning rather than a conveyor: each bubble starts at the
-- position of the neighbour it is replacing, which for the middle slot means
-- coming from higher up and for the outer slots from lower down.
--
-- Turning "next" moves content left, so slot 1 inherits slot 2's bubble, slot 2
-- inherits slot 3's, and slot 3 is where a new one appears; "prev" mirrors it.
-- Slots 1 and 3 sit at the same height, so they share one travel variant and
-- only the middle slot needs its own.
local function rotationClass(index)
    local direction, phase = rotationStep()
    if direction == nil or #items ~= 3 then
        return ""
    end
    local variant = index == 2 and "center" or "outer"
    return " bubble-options-rotate-" .. direction .. "-" .. variant .. "-" .. phase
end

function bubbleMotionClass(id)
    local index = itemIndex(id)
    if #items ~= 3 then
        return "bubble-options-motion"
    end
    local variants = { "left", "center", "right" }
    return "bubble-options-motion bubble-options-motion-" .. variants[index] .. rotationClass(index)
end

-- The bubble arriving from off the ring fades in; the one it displaced has
-- already left the item list, so the pair reads as one appearing and one
-- disappearing. The fade rides the button so the travel animation keeps the
-- motion box and the idle float keeps the core.
function bubbleOptionClass(id)
    local direction, phase = rotationStep()
    if direction == nil or #items ~= 3 then
        return "bubble-option"
    end
    local entering = direction == "next" and 3 or 1
    if itemIndex(id) ~= entering then
        return "bubble-option"
    end
    return "bubble-option bubble-option-arriving-" .. phase
end

function blurCoreClass(core_class)
    if props.blur_enabled then
        return core_class .. " bubble-option-core-blur"
    end
    return core_class
end
</script>

<style>
    .bubble-options-stage {
        /* One continuous popup-local hitbox spans the gaps between bubbles. */
        position: relative;
        overflow: visible;
    }

    .bubble-option {
        position: absolute;
        width: 36px;
        height: 36px;
        justify-content: center;
        align-items: center;
        padding: 0;
        border-radius: var(--radius-full);
        /* The button is a stationary hit target while its child animates in.
        It must not emit a paint primitive at the final resting position. */
        background: transparent;
        border-width: 0;
        opacity: 1;
        /* Overrides the theme's global background-color-first transition default. */
        transition: none;
    }

    .bubble-options-motion,
    .bubble-option-core {
        width: 36px;
        height: 36px;
        justify-content: center;
        align-items: center;
        border-radius: var(--radius-full);
    }

    .bubble-options-motion {
        opacity: 1;
        transform: translate(0px, 0px) scale(1);
        transition: transform 360ms var(--animation-curves-bezier-emphasized-decelerate),
        opacity 220ms var(--animation-curves-bezier-standard);
    }

    .bubble-options-motion-left {
        transition-delay: 0ms;
    }

    .bubble-options-motion-center {
        transition-delay: 45ms;
    }

    .bubble-options-motion-right {
        transition-delay: 90ms;
    }

    .bubble-options-motion-left.mesh-surface-entering {
        transform: translate(46px, 4px) scale(0.12);
    }

    .bubble-options-motion-left.mesh-surface-exiting {
        transform: translate(46px, 4px) scale(0.12);
        opacity: 0;
    }

    .bubble-options-motion-center.mesh-surface-entering {
        transform: translate(18px, -20px) scale(0.12);
    }

    .bubble-options-motion-center.mesh-surface-exiting {
        transform: translate(18px, -20px) scale(0.12);
        opacity: 0;
    }

    .bubble-options-motion-right.mesh-surface-entering {
        transform: translate(-10px, 4px) scale(0.12);
    }

    .bubble-options-motion-right.mesh-surface-exiting {
        transform: translate(-10px, 4px) scale(0.12);
        opacity: 0;
    }

    /* Ring rotation. `ARC_DEPTH` (10px) and `HORIZONTAL_STEP` (38px) in the
    script above set these offsets: one step moves a bubble one slot along the
    arc, and the middle slot sits `ARC_DEPTH` lower than the outer two, so a
    bubble entering the middle arrives from higher up while one entering an
    outer slot arrives from lower down. That height difference is what reads as
    rotation around a circle instead of a flat conveyor. */
    .bubble-options-rotate-next-outer-a,
    .bubble-options-rotate-next-outer-b,
    .bubble-options-rotate-next-center-a,
    .bubble-options-rotate-next-center-b,
    .bubble-options-rotate-prev-outer-a,
    .bubble-options-rotate-prev-outer-b,
    .bubble-options-rotate-prev-center-a,
    .bubble-options-rotate-prev-center-b {
        animation-duration: 300ms;
        animation-timing-function: var(--animation-curves-bezier-emphasized-decelerate);
        animation-iteration-count: 1;
        animation-fill-mode: none;
    }

    .bubble-options-rotate-next-outer-a {
        animation-name: bubble-options-arc-next-outer-a;
    }

    .bubble-options-rotate-next-outer-b {
        animation-name: bubble-options-arc-next-outer-b;
    }

    .bubble-options-rotate-next-center-a {
        animation-name: bubble-options-arc-next-center-a;
    }

    .bubble-options-rotate-next-center-b {
        animation-name: bubble-options-arc-next-center-b;
    }

    .bubble-options-rotate-prev-outer-a {
        animation-name: bubble-options-arc-prev-outer-a;
    }

    .bubble-options-rotate-prev-outer-b {
        animation-name: bubble-options-arc-prev-outer-b;
    }

    .bubble-options-rotate-prev-center-a {
        animation-name: bubble-options-arc-prev-center-a;
    }

    .bubble-options-rotate-prev-center-b {
        animation-name: bubble-options-arc-prev-center-b;
    }

    /* The bubble arriving from off the ring fades up as it travels. */
    .bubble-option-arriving-a,
    .bubble-option-arriving-b {
        animation-duration: 300ms;
        animation-timing-function: var(--animation-curves-bezier-standard);
        animation-iteration-count: 1;
        animation-fill-mode: none;
    }

    .bubble-option-arriving-a {
        animation-name: bubble-option-arriving-a;
    }

    .bubble-option-arriving-b {
        animation-name: bubble-option-arriving-b;
    }

    .bubble-options-motion.mesh-surface-exiting {
        transition: transform 180ms var(--animation-curves-bezier-emphasized-decelerate),
        opacity 140ms var(--animation-curves-bezier-standard);
    }

    .bubble-option-core {
        border-width: 2px;
        border-style: solid;
        border-color: transparent;
        /* No drop shadow: the core's frosted background is translucent, and the
        renderer paints the shadow disc *behind* the fill where it shows through
        the translucency as an opaque dark backing — hiding the compositor blur
        that should read as the button's background. */
        box-shadow: none;
        color: var(--color-on-surface);
        /* Frosted glass: translucent core over compositor-blurred backdrop
        (org_kde_kwin_blur on the promoted popup surface); also blurs any
        in-surface content painted beneath the bubble. */
        opacity: 1;
        /* Overrides the theme's global background-color-first transition default. */
        transition: border-color var(--animation-duration-short) var(--animation-curves-bezier-standard);
        animation-duration: 2800ms;
        animation-timing-function: ease-in-out;
        animation-iteration-count: infinite;
    }

    .bubble-option-core-blur {
        backdrop-filter: blur(prop(blur_radius));
    }

    .bubble-option-core.mesh-surface-exiting {
        animation-name: none;
    }

    .bubble-option-core-active {
        border-color: var(--color-primary);
    }

    .bubble-option-core:hover {
        border-color: var(--color-secondary);
    }

    .bubble-option-core-dark {
        background-color: #1d1b20;
        color: #6750a4;
        border-color: #49454f;
        animation-name: bubble-option-float-left;
        animation-delay: 360ms;
    }

    .bubble-option-core-dark-active {
        border-color: #6750a4;
    }

    .bubble-option-core-dark:hover {
        border-color: #ccc2dc;
    }

    .bubble-option-core-light {
        background-color: #f7f2fa;
        color: #6750a4;
        border-color: #cac4d0;
        animation-name: bubble-option-float-center;
        animation-delay: 430ms;
    }

    .bubble-option-core-light-active {
        border-color: #6750a4;
    }

    .bubble-option-core-light:hover {
        border-color: #625b71;
    }

    .bubble-option-core-gruvbox {
        background-color: #282828;
        color: #fabd2f;
        border-color: #504945;
        animation-name: bubble-option-float-right;
        animation-delay: 500ms;
    }

    .bubble-option-core-gruvbox-active {
        border-color: #fabd2f;
    }

    .bubble-option-core-gruvbox:hover {
        border-color: #83a598;
    }

    .bubble-option-core-nord {
        background-color: #2e3440;
        color: #88c0d0;
        border-color: #4c566a;
        animation-name: bubble-option-float-left;
        animation-delay: 360ms;
    }

    .bubble-option-core-nord-active {
        border-color: #ebcb8b;
    }

    .bubble-option-core-nord:hover {
        border-color: #8fbcbb;
    }

    .bubble-option-core-mocha {
        background-color: #1e1e2e;
        color: #cba6f7;
        border-color: #45475a;
        animation-name: bubble-option-float-center;
        animation-delay: 430ms;
    }

    .bubble-option-core-mocha-active {
        border-color: #f9e2af;
    }

    .bubble-option-core-mocha:hover {
        border-color: #89b4fa;
    }

    .bubble-option-core-tokyo {
        background-color: #1a1b26;
        color: #7aa2f7;
        border-color: #414868;
        animation-name: bubble-option-float-right;
        animation-delay: 500ms;
    }

    .bubble-option-core-tokyo-active {
        border-color: #e0af68;
    }

    .bubble-option-core-tokyo:hover {
        border-color: #bb9af7;
    }

    .bubble-option-core-solarized {
        background-color: #002b36;
        color: #2aa198;
        border-color: #17505d;
        animation-name: bubble-option-float-center;
        animation-delay: 400ms;
    }

    .bubble-option-core-solarized-active {
        border-color: #b58900;
    }

    .bubble-option-core-solarized:hover {
        border-color: #268bd2;
    }

    .bubble-option-core-language {
        background-color: prop(blur_background);
        color: var(--color-on-surface);
    }

    .bubble-option-core-language-left {
        animation-name: bubble-option-float-left;
        animation-delay: 360ms;
    }

    .bubble-option-core-language-center {
        animation-name: bubble-option-float-center;
        animation-delay: 430ms;
    }

    .bubble-option-core-language-right {
        animation-name: bubble-option-float-right;
        animation-delay: 500ms;
    }

    .bubble-option-icon {
        width: 18px;
        height: 18px;
        color: inherit;
        opacity: 1;
        transition: none;
    }

    .bubble-option-text {
        color: inherit;
        /* Sized for the language ring's flag emoji rather than a text label. */
        font-size: var(--typography-size-lg);
        font-weight: 700;
        line-height: 1;
        text-wrap: none;
        opacity: 1;
        transition: none;
    }

    .bubble-option-hidden {
        display: none;
    }

    @keyframes bubble-options-arc-next-outer-a {
        0% {
            transform: translate(38px, 10px) scale(0.88);
        }
        100% {
            transform: translate(0px, 0px) scale(1);
        }
    }

    @keyframes bubble-options-arc-next-center-a {
        0% {
            transform: translate(38px, -10px) scale(0.88);
        }
        100% {
            transform: translate(0px, 0px) scale(1);
        }
    }

    @keyframes bubble-options-arc-prev-outer-a {
        0% {
            transform: translate(-38px, 10px) scale(0.88);
        }
        100% {
            transform: translate(0px, 0px) scale(1);
        }
    }

    @keyframes bubble-options-arc-prev-center-a {
        0% {
            transform: translate(-38px, -10px) scale(0.88);
        }
        100% {
            transform: translate(0px, 0px) scale(1);
        }
    }

    @keyframes bubble-options-arc-next-outer-b {
        0% {
            transform: translate(38px, 10px) scale(0.88);
        }
        100% {
            transform: translate(0px, 0px) scale(1);
        }
    }

    @keyframes bubble-options-arc-next-center-b {
        0% {
            transform: translate(38px, -10px) scale(0.88);
        }
        100% {
            transform: translate(0px, 0px) scale(1);
        }
    }

    @keyframes bubble-options-arc-prev-outer-b {
        0% {
            transform: translate(-38px, 10px) scale(0.88);
        }
        100% {
            transform: translate(0px, 0px) scale(1);
        }
    }

    @keyframes bubble-options-arc-prev-center-b {
        0% {
            transform: translate(-38px, -10px) scale(0.88);
        }
        100% {
            transform: translate(0px, 0px) scale(1);
        }
    }

    @keyframes bubble-option-arriving-a {
        0% {
            opacity: 0;
        }
        55% {
            opacity: 0.65;
        }
        100% {
            opacity: 1;
        }
    }

    @keyframes bubble-option-arriving-b {
        0% {
            opacity: 0;
        }
        55% {
            opacity: 0.65;
        }
        100% {
            opacity: 1;
        }
    }

    @keyframes bubble-option-float-left {
        0% {
            transform: translate(0px, 0px) scale(1);
        }
        54% {
            transform: translate(-3px, -6px) scale(1.05);
        }
        100% {
            transform: translate(0px, 0px) scale(1);
        }
    }

    @keyframes bubble-option-float-center {
        0% {
            transform: translate(0px, 0px) scale(1);
        }
        54% {
            transform: translate(0px, -7px) scale(1.04);
        }
        100% {
            transform: translate(0px, 0px) scale(1);
        }
    }

    @keyframes bubble-option-float-right {
        0% {
            transform: translate(0px, 0px) scale(1);
        }
        54% {
            transform: translate(3px, -5px) scale(1.05);
        }
        100% {
            transform: translate(0px, 0px) scale(1);
        }
    }
</style>
