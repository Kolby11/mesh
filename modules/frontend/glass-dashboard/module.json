{
  "name": "@mesh/glass-dashboard",
  "version": "0.1.0",
  "description": "Liquid-glass dashboard overlay: system load, the current track with a live spectrum, notifications and weather.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "ui",
    "uses": {
      "optionalInterfaces": {
        "mesh.system": ">=1.0",
        "mesh.media": ">=1.0",
        "mesh.visualizer": ">=1.0",
        "mesh.notifications": ">=1.0",
        "mesh.weather": ">=1.0"
      },
      "modules": {
        "@mesh/glass-material": ">=0.1.0"
      },
      "resources": {
        "icons": [
          "@mesh/icons-material-symbols"
        ]
      },
      "capabilities": [
        "shell.surface",
        "theme.read",
        "locale.read",
        "service.system.read",
        "service.media.read",
        "service.media.control",
        "service.visualizer.read",
        "service.notifications.read",
        "service.notifications.control",
        "service.weather.read"
      ]
    },
    "entry": "src/main.mesh",
    "surface": {
      "anchor": "top",
      "layer": "overlay",
      "keyboard_mode": "exclusive",
      "visible_on_start": false
    },
    "provides": {
      "layout": [
        {
          "id": "main",
          "entrypoint": "src/main.mesh",
          "label": "Glass dashboard"
        }
      ]
    },
    "accessibility": {
      "role": "dialog"
    },
    "i18n": {
      "defaultLocale": "en"
    },
    "contributes": {
      "i18n": [
        { "id": "en", "locale": "en", "path": "config/i18n/en.json" },
        { "id": "sk", "locale": "sk", "path": "config/i18n/sk.json" }
      ],
      "keybinds": {
        "close": {
          "label": { "t": "keybind.close.label", "fallback": "Close dashboard" },
          "description": { "t": "keybind.close.description", "fallback": "Hide the dashboard" },
          "category": { "t": "keybind.category", "fallback": "Dashboard" },
          "trigger": { "kind": "shortcut", "key": "Escape" }
        }
      }
    }
  }
}
