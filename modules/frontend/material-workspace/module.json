{
  "name": "@mesh/material-workspace",
  "version": "0.1.0",
  "description": "Editable Material desktop with a persistent widget grid, picker, side rail and application dock.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "ui",
    "entry": "src/main.mesh",
    "uses": {
      "modules": {
        "@mesh/profile-switcher": ">=0.1.0"
      },
      "optionalInterfaces": {
        "mesh.apps": ">=1.0",
        "mesh.system": ">=1.0",
        "mesh.weather": ">=1.0",
        "mesh.media": ">=1.0"
      },
      "capabilities": [
        "shell.surface",
        "theme.read",
        "locale.read",
        "service.apps.read",
        "service.apps.launch",
        "service.system.read",
        "service.weather.read",
        "service.media.read",
        "service.media.control"
      ],
      "resources": {
        "icons": [
          "@mesh/icons-material-symbols"
        ]
      }
    },
    "surface": {
      "anchor": "top",
      "layer": "bottom",
      "keyboard_mode": "on_demand",
      "visible_on_start": true
    },
    "provides": {
      "layout": [
        {
          "id": "main",
          "entrypoint": "src/main.mesh",
          "label": "Material desktop"
        }
      ]
    },
    "i18n": {
      "defaultLocale": "en"
    },
    "contributes": {
      "i18n": [
        {
          "id": "en",
          "locale": "en",
          "path": "config/i18n/en.json"
        }
      ]
    }
  }
}
