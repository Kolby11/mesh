<template>
    <box class="wallpaper" aria-hidden="true" />
</template>

<style>
    /* The shell backdrop image (`shell.render.backdrop.image`), cover-fit and
    unrefracted. The refraction paints under the element's own background, so
    the background stays transparent. */
    .wallpaper {
        width: 100%;
        height: 100%;
        exclusive-zone: ignore;
        background: transparent;
        backdrop-filter: refract(0px 0px);
    }
</style>
