<template>
    <box class="wallpaper" aria-hidden="true" />
</template>

<style>
    /* The shell backdrop image (`shell.render.backdrop.image`), cover-fit and
    unrefracted. Glass on the background and bottom layers refracts this same
    image, so the wallpaper and what that glass bends agree. */
    .wallpaper {
        width: 100%;
        height: 100%;
        exclusive-zone: ignore;
        background: var(--color-background);
        backdrop-filter: refract(0px 0px);
    }
</style>
