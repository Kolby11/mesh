<props>
{
    card_width = { type = "size", default = "auto" },
    card_height = { type = "size", default = "auto" },
}
</props>

<template>
    <row style:width={props.card_width ~= "auto" and props.card_width or nil} style:height={props.card_height ~= "auto" and props.card_height or nil} class="media-card" class:media-card-idle={not has_track}>
        <box class="media-art-frame" class:track-next-a={swipe == "next-a"} class:track-next-b={swipe == "next-b"} class:track-previous-a={swipe == "previous-a"} class:track-previous-b={swipe == "previous-b"}>
            <image class="media-art" src={art} alt="Album artwork" hidden={art == ""} />
            <icon class="media-art-glyph" name="audio-x-generic" size="44" hidden={art ~= ""} />
        </box>
        <column class="media-body" class:track-next-a={swipe == "next-a"} class:track-next-b={swipe == "next-b"} class:track-previous-a={swipe == "previous-a"} class:track-previous-b={swipe == "previous-b"}>
            <text class="media-title">{title}</text>
            <text class="media-artist">{artist}</text>
            <row class="media-progress">
                <text class="media-time">{position_text}</text>
                <slider
                    class="media-seek"
                    value={position}
                    min="0"
                    max={length}
                    onpointerdown={onSeekStart}
                    onchange={onSeek}
                    onrelease={onSeekRelease}
                    disabled={not has_track}
                    aria-label="Seek"
                />
                <text class="media-time">{length_text}</text>
            </row>
            <row class="media-controls">
                <button class="media-ctl" ref="previousTrack" onclick={onPrevious} disabled={not has_track} aria-label="Previous track">
                    <icon class="media-ctl-glyph" name="media-skip-backward" size="16" />
                </button>
                <button class="media-ctl media-ctl-main" onclick={onToggle} disabled={not has_track} aria-label={playing and "Pause" or "Play"}>
                    <icon class="media-ctl-glyph media-ctl-glyph-main" name={playing and "media-playback-pause" or "media-playback-start"} size="16" />
                </button>
                <button class="media-ctl" ref="nextTrack" onclick={onNext} disabled={not has_track} aria-label="Next track">
                    <icon class="media-ctl-glyph" name="media-skip-forward" size="16" />
                </button>
            </row>
        </column>
    </row>
</template>

<script lang="luau">

local media = require("mesh.media")

has_track = false
playing = false
title = "Nothing playing"
artist = ""
album = ""
art = ""
position = 0
length = 1
position_text = "00:00"
length_text = "00:00"
swipe = ""
local last_track = ""
local direction = "next"
local swipe_count = 0
local swipe_task
local seek_dragging = false
local seek_track
local pending_seek
local seek_timeout

local function clock(seconds)
    seconds = math.max(0, math.floor(seconds or 0))
    return string.format("%02d:%02d", seconds // 60, seconds % 60)
end

local function position_now()
    local value = media.position or 0
    local sampled_at = tonumber(media.updated_at) or 0
    if media.state.state == "playing" and sampled_at > 0 then
        value += math.max(0, os.time() - sampled_at)
    end
    local total = media.length or 0
    return total > 0 and math.min(value, total) or value
end

local function update_progress()
    if seek_dragging then return end
    local actual = position_now()
    if pending_seek then
        if math.abs(actual - pending_seek) > 2 then return end
        pending_seek = nil
        if seek_timeout then task.cancel(seek_timeout) end
        seek_timeout = nil
    end
    position = math.floor(actual)
    position_text = clock(position)
end

effect(function()
    local track = table.concat({ media.player or "", media.title or "", media.artist or "", media.album or "" }, "\t")
    if track ~= last_track then
        seek_dragging = false
        pending_seek = nil
        if seek_timeout then task.cancel(seek_timeout) end
        seek_timeout = nil
        if last_track ~= "" and (media.title or "") ~= "" then
            swipe_count += 1
            swipe = direction .. (swipe_count % 2 == 0 and "-a" or "-b")
            if swipe_task then task.cancel(swipe_task) end
            swipe_task = task.delay(240, function() swipe = "" end)
        end
        last_track = track
        direction = "next"
    end
    has_track = media.available == true and (media.title or "") ~= ""
    playing = has_track and media.state.state == "playing"
    title = has_track and media.title or "Nothing playing"
    artist = has_track and (media.artist or "") or ""
    album = media.album or ""
    art = has_track and (media.art_path or "") or ""
    length = math.max(1, math.floor(media.length or 0))
    length_text = clock(media.length)
    update_progress()
end)

task.spawn(function()
    while true do
        task.sleep(1000)
        if playing then
            update_progress()
        end
    end
end)

local function seek_value(value)
    local target = tonumber(type(value) == "table" and value.value or value)
    if not target or target ~= target then return nil end
    return math.clamp(target, 0, length)
end

local function commit_seek(target)
    pending_seek = target
    position = target
    position_text = clock(target)
    if seek_timeout then task.cancel(seek_timeout) end
    seek_timeout = task.delay(2500, function()
        pending_seek = nil
        seek_timeout = nil
        update_progress()
    end)
    media.seek(target)
end

function onSeekStart()
    seek_dragging = true
    seek_track = last_track
    pending_seek = nil
    if seek_timeout then task.cancel(seek_timeout) end
    seek_timeout = nil
end

function onSeek(value)
    local target = seek_value(value)
    if not target then return end
    position = target
    position_text = clock(target)
    if not seek_dragging then commit_seek(target) end
end

function onSeekRelease(value)
    local was_dragging = seek_dragging
    seek_dragging = false
    local target = seek_value(value)
    if was_dragging and seek_track == last_track and target then
        commit_seek(target)
    else
        update_progress()
    end
end

function onPrevious()
    direction = "previous"
    media.previous()
end

function onToggle()
    media.play_pause()
end

function onNext()
    direction = "next"
    media.next()
end
</script>

<style>
    .media-card {
        width: 480px;
        height: 186px;
        gap: 18px;
        padding: 18px;
        align-items: center;
        border-radius: 25px;
        border: 1px solid var(--glass-rim);
        background-image: var(--glass-surface-media);
        box-shadow: var(--glass-shadow-card);
        backdrop-filter: var(--glass-backdrop-card);
        opacity: 1;
        overflow: hidden;
        animation: media-card-in 520ms cubic-bezier(0.05, 0.7, 0.1, 1) both;
    }


    .track-next-a { animation: track-next-a 240ms cubic-bezier(0.05, 0.7, 0.1, 1) both; }
    @keyframes track-next-a {
        0% { opacity: 0; transform: translateX(32px); }
        100% { opacity: 1; transform: translateX(0px); }
    }
    .track-next-b { animation: track-next-b 240ms cubic-bezier(0.05, 0.7, 0.1, 1) both; }
    @keyframes track-next-b {
        0% { opacity: 0; transform: translateX(32px); }
        100% { opacity: 1; transform: translateX(0px); }
    }
    .track-previous-a { animation: track-previous-a 240ms cubic-bezier(0.05, 0.7, 0.1, 1) both; }
    @keyframes track-previous-a {
        0% { opacity: 0; transform: translateX(-32px); }
        100% { opacity: 1; transform: translateX(0px); }
    }
    .track-previous-b { animation: track-previous-b 240ms cubic-bezier(0.05, 0.7, 0.1, 1) both; }
    @keyframes track-previous-b {
        0% { opacity: 0; transform: translateX(-32px); }
        100% { opacity: 1; transform: translateX(0px); }
    }

    .media-card-idle {
        opacity: 0.88;
    }

    .media-art-frame {
        width: 142px;
        height: 100%;
        max-height: 142px;
        flex-shrink: 0;
        justify-content: center;
        align-items: center;
        border-radius: 20px;
        border: 1px solid var(--glass-rim-inset);
        background: var(--glass-fill-artwork);
        box-shadow: var(--glass-shadow-artwork);
        overflow: hidden;
    }

    .media-art {
        width: 142px;
        height: 142px;
        border-radius: 20px;
    }

    .media-art-glyph {
        width: 62px;
        height: 62px;
        color: var(--glass-text-artwork);
    }

    .media-body {
        height: 100%;
        flex-grow: 1;
        min-width: 0;
        gap: 2px;
        justify-content: center;
    }

    .media-title {
        height: 36px;
        font-size: 22px;
        font-weight: 600;
        color: var(--glass-text-heading);
        text-overflow: ellipsis;
    }

    .media-artist {
        height: 25px;
        font-size: 14px;
        color: var(--glass-text-muted);
        text-overflow: ellipsis;
    }

    .media-progress {
        height: 34px;
        margin-top: 6px;
        align-items: center;
        gap: 11px;
    }

    .media-time {
        height: 22px;
        font-size: 11px;
        font-weight: 500;
        color: var(--glass-text);
    }

    .media-seek {
        flex-grow: 1;
        height: 31px;
        padding: 0;
        color: var(--glass-text-control);
    }

    .media-controls {
        height: 45px;
        margin-top: 6px;
        align-items: center;
        gap: 13px;
    }

    .media-ctl {
        width: 45px;
        height: 42px;
        padding: 0;
        justify-content: center;
        align-items: center;
        border-radius: 11px;
        border: 1px solid var(--glass-rim-control);
        background-image: var(--glass-surface-control);
    }



    .media-ctl-glyph {
        width: 22px;
        height: 22px;
        color: var(--glass-text-strong);
    }

    @keyframes media-card-in {
        0% {
            opacity: 0;
            transform: translateY(24px) scale(0.96);
        }
        100% {
            opacity: 1;
            transform: translateY(0px) scale(1);
        }
    }

    /* Motion: one vocabulary for the whole shell, all from theme tokens.
    Containers lift by --animation-lift-hover and brighten their rim; controls
    scale by --animation-scale-hover/-press and ring with the focus token. */

    .media-card {
        transform: translateY(0px);
        transition-property: transform, border-color, opacity;
        transition-duration: var(--animation-duration-medium);
        transition-timing-function: var(--animation-curves-bezier-emphasized-decelerate);
    }

    .media-card:hover {
        transform: translateY(var(--animation-lift-hover));
        border-color: var(--glass-rim-hover);
    }

    .media-ctl {
        transform: scale(1);
        transition-property: transform, background-color, border-color, opacity;
        transition-duration: var(--animation-duration-short);
        transition-timing-function: var(--animation-curves-bezier-emphasized-decelerate);
    }

    .media-ctl:hover {
        border-color: var(--glass-rim-hover);
        transform: scale(var(--animation-scale-hover));
    }

    .media-ctl:focus-visible {
        transform: scale(var(--animation-scale-hover));
    }

    .media-ctl:active {
        transform: scale(var(--animation-scale-press));
        transition-duration: var(--animation-duration-fast);
    }
    .media-ctl-main { width: 56px; border-radius: 999px; background-image: var(--glass-surface-active); }
    .media-ctl-glyph-main { color: var(--glass-text-on-accent); }
    @container (max-width: 800px) {
        .media-card { width: 360px; height: 168px; gap: 12px; padding: 14px; }
        .media-art-frame { width: 112px; height: 100%; max-height: 132px; }
        .media-art { width: 112px; height: 132px; }
        .media-title { height: 30px; font-size: 18px; }
        .media-artist { height: 22px; }
        .media-progress { height: 28px; margin-top: 2px; }
        .media-controls { height: 38px; margin-top: 2px; gap: 8px; }
        .media-ctl { height: 36px; }
    }
</style>
