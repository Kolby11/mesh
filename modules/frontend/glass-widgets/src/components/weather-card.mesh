<template>
    <column class="weather-card" class:weather-card-idle={not available}>
        <row class="weather-top">
            <icon class="weather-hero" name={glyph} size="72" />
            <column class="weather-place">
                <text class="weather-location">{location}</text>
                <text class="weather-condition">{condition}</text>
            </column>
        </row>
        <row class="weather-bottom">
            <column class="weather-now">
                <row class="weather-temp-row">
                    <text class="weather-temp">{temperature}</text>
                    <text class="weather-degree">°</text>
                </row>
                <text class="weather-feels">{feels}</text>
            </column>
            <row class="weather-forecast">
                {#for point in forecast key={point.key}}
                    <column class="weather-point">
                        <text class="weather-point-temp">{point.temperature}</text>
                        <icon class="weather-point-glyph" name={point.glyph} size="26" />
                        <text class="weather-point-time">{point.time}</text>
                    </column>
                {/for}
            </row>
        </row>
    </column>
</template>

<script lang="luau">
local weather = require("mesh.weather")

local GLYPHS = {
    clear = "weather-clear",
    ["partly-cloudy"] = "weather-few-clouds",
    cloudy = "weather-overcast",
    fog = "weather-fog",
    drizzle = "weather-showers-scattered",
    rain = "weather-showers",
    snow = "weather-snow",
    storm = "weather-storm",
}

local LABELS = {
    clear = "Clear", ["partly-cloudy"] = "Partly cloudy", cloudy = "Cloudy", fog = "Fog",
    drizzle = "Drizzle", rain = "Rain", snow = "Snow", storm = "Thunderstorm",
}

available = false
glyph = GLYPHS.cloudy
location = "Weather"
condition = "Loading…"
temperature = "--"
feels = ""
forecast = {}

local function hour(time)
    local ok, value = pcall(os.date, "%H:00", time)
    return ok and value or ""
end

effect(function()
    available = weather.available == true
    if not available then
        location = "Weather"
        condition = "Waiting for forecast"
        temperature = "--"
        feels = ""
        forecast = {}
        return
    end
    local state = weather.condition or "cloudy"
    glyph = (state == "clear" and weather.is_day == false) and "weather-clear-night" or GLYPHS[state] or GLYPHS.cloudy
    location = (weather.location or "") ~= "" and weather.location or "Here"
    condition = LABELS[state] or state
    temperature = tostring(math.floor((weather.temperature or 0) + 0.5))
    feels = "Feels " .. tostring(math.floor((weather.feels_like or 0) + 0.5)) .. "°"
    local points = {}
    for index, point in weather.hourly or {} do
        if index > 3 then break end
        points[#points + 1] = {
            key = index,
            temperature = tostring(math.floor((point.temperature or 0) + 0.5)) .. "°",
            glyph = GLYPHS[point.condition] or GLYPHS.cloudy,
            time = hour(point.time),
        }
    end
    forecast = points
end)
</script>

<style>
    .weather-card {
        width: 384px;
        height: 268px;
        gap: 0;
        padding: 22px 24px;
        justify-content: space-between;
        border-radius: 25px;
        border: 1px solid var(--glass-rim);
        background-image: var(--glass-surface-weather);
        box-shadow: var(--glass-shadow-card);
        backdrop-filter: blur(14px) refract(22px 18px) dispersion(1.2px);
        opacity: 1;
        animation: weather-card-in 620 cubic-bezier(0.05, 0.7, 0.1, 1) both;
    }


    .weather-card-idle {
        opacity: 0.88;
    }

    .weather-top {
        width: 100%;
        justify-content: space-between;
        align-items: flex-start;
    }

    .weather-hero {
        width: 66px;
        height: 66px;
        color: var(--glass-text-caption);
    }

    .weather-place {
        gap: 0;
        align-items: flex-end;
    }

    .weather-location {
        height: 34px;
        font-size: 14px;
        font-weight: 600;
        color: var(--glass-text-heading);
        text-align: right;
    }

    .weather-condition {
        height: 28px;
        font-size: 18px;
        color: var(--glass-text-muted);
        text-align: right;
    }

    .weather-bottom {
        width: 100%;
        justify-content: space-between;
        align-items: flex-end;
    }

    .weather-now {
        gap: 2px;
    }

    .weather-temp-row {
        gap: 2px;
        align-items: flex-start;
    }

    .weather-temp {
        height: 84px;
        font-size: 64px;
        font-weight: 700;
        line-height: 1.1;
        color: var(--glass-text-strong);
    }

    .weather-degree {
        height: 50px;
        font-size: 42px;
        font-weight: 700;
        color: var(--glass-text-strong);
    }

    .weather-feels {
        height: 25px;
        font-size: 17px;
        font-weight: 500;
        color: var(--glass-text-muted);
    }

    .weather-forecast {
        gap: 12px;
        align-items: flex-end;
    }

    .weather-point {
        gap: 6px;
        align-items: center;
    }


    .weather-point-temp {
        height: 28px;
        font-size: 15px;
        font-weight: 600;
        color: var(--glass-text-heading);
    }

    .weather-point-glyph {
        width: 26px;
        height: 26px;
        color: var(--glass-text-cool);
    }

    .weather-point-time {
        height: 22px;
        font-size: 11px;
        font-weight: 500;
        color: var(--glass-text);
    }

    @keyframes weather-card-in {
        0% {
            opacity: 0;
            transform: translateY(28px) scale(0.96);
        }
        100% {
            opacity: 1;
            transform: translateY(0px) scale(1);
        }
    }

    /* Motion: one vocabulary for the whole shell, all from theme tokens.
    Containers lift by --animation-lift-hover and brighten their rim; controls
    scale by --animation-scale-hover/-press and ring with the focus token. */

    .weather-card {
        transform: translateY(0px);
        transition-property: transform, border-color, opacity;
        transition-duration: var(--animation-duration-medium);
        transition-timing-function: var(--animation-curves-bezier-emphasized-decelerate);
    }

    .weather-card:hover {
        transform: translateY(var(--animation-lift-hover));
        border-color: var(--glass-rim-hover);
    }

    .weather-point {
        transform: translateY(0px);
        transition-property: transform, border-color, opacity;
        transition-duration: var(--animation-duration-medium);
        transition-timing-function: var(--animation-curves-bezier-emphasized-decelerate);
    }

    .weather-point:hover {
        transform: translateY(var(--animation-lift-hover));
        border-color: var(--glass-rim-hover);
    }
    @container (max-width: 800px) {
        .weather-card { width: 360px; height: 248px; }
    }
</style>
