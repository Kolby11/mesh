<props>
{
    desktop_layout = { type = "enum", options = { "islands", "floating", "paper", "tapedeck", "rail" }, default = "islands" },
}
</props>

<template>
    {#if props.desktop_layout == "islands"}
    <row class="bar">
        <row class="cluster cluster-start">
            <row class="pill pill-tight">
                <button class="glyph-btn" onclick={onSettings} title="Settings" aria-label="Settings">
                    <icon class="glyph" name="settings" size="15" />
                </button>
                <button class="glyph-btn" onclick={onDashboard} title={t("bar.dashboard")} aria-label={t("bar.dashboard")}>
                    <icon class="glyph" name="view-dashboard" size="15" />
                </button>
                <button class="glyph-btn" onclick={onWallpapers} title={t("bar.wallpapers")} aria-label={t("bar.wallpapers")}>
                    <icon class="glyph" name="preferences-desktop-wallpaper" size="15" />
                </button>
                <ProfileSwitcher trigger_hover="var(--glass-hover)" />
            </row>
            <Clock />
            <Workspaces />
        </row>

        <row class="cluster cluster-center">
            <NowPlaying />
            <Recorder />
            <Weather />
        </row>

        <row class="cluster cluster-end">
            <row class="pill">
                <button class="glyph-btn" ref="notificationsTrigger" aria-haspopup="true" aria-label={t("notifications.title")} title={t("notifications.title")}>
                    <icon class="glyph" name="notifications" size="16" />
                    <NotificationCenter />
                </button>
            </row>
            <Status />
        </row>
    </row>
    {:else}
        <row class="desktop-bar" class:floating={props.desktop_layout == "floating"} class:paper={props.desktop_layout == "paper"} class:taskbar={props.desktop_layout == "tapedeck"} class:rail={props.desktop_layout == "rail"}>
            <row class="start" class:rail-group={props.desktop_layout == "rail"}>
                <button class="bar-button app-menu" class:rail-button={props.desktop_layout == "rail"} class:rail-menu={props.desktop_layout == "rail"} class:task-chrome={props.desktop_layout == "tapedeck"} ref="glassLauncher" title={t("desktop.apps")} aria-label={t("desktop.apps")} aria-haspopup="true">
                    {#if props.desktop_layout == "paper"}
                        <text class="brand">Mesh</text>
                    {:else}
                        <icon name="view-grid" size="18" />
                        <text hidden={props.desktop_layout ~= "tapedeck"}>{t("desktop.apps")}</text>
                    {/if}
                    <Launcher side={props.desktop_layout == "rail" and "right" or "bottom"} />
                </button>
                {#if props.desktop_layout == "paper"}
                    <button class="bar-button menu-action" onclick={onSettings}><text>{t("controls.settings")}</text></button>
                    <button class="bar-button menu-action" onclick={onDashboard}><text>{t("bar.dashboard")}</text></button>
                    <button class="bar-button menu-action" onclick={onWallpapers}><text>{t("bar.wallpapers")}</text></button>
                {/if}
                <box class="switcher-slot">
                    <ProfileSwitcher trigger_hover="var(--glass-hover)" trigger_color={props.desktop_layout == "rail" and "var(--color-inverse-on-surface)" or "var(--color-on-surface)"} side={props.desktop_layout == "rail" and "right" or "bottom"} />
                </box>
            </row>

            {#if props.desktop_layout == "tapedeck"}
                <row class="task-list" hidden={tasks[1] == nil}>
                    {#for app in tasks key={app.id}}
                        <button class="bar-button task task-chrome" class:task-active={app.focused} onclick={onActivate(app.id)} title={app.name} aria-label={app.name} aria-pressed={app.focused}>
                            {#if app.icon ~= ""}
                                <image class="task-icon" src={app.icon} alt="" />
                            {:else}
                                <icon name="application-x-executable" size="16" />
                            {/if}
                            <text class="task-name">{app.name}</text>
                        </button>
                    {/for}
                </row>
            {:else}
                <Workspaces layout={props.desktop_layout} />
            {/if}

            {#if props.desktop_layout == "floating"}
                <text class="window-title">{window_title}</text>
            {/if}
            <box class="spacer" />

            {#if props.desktop_layout == "floating"}
                <Clock compact={true} />
                <box class="spacer" />
            {/if}

            <row class="end" class:rail-group={props.desktop_layout == "rail"}>
                <button class="bar-button" class:rail-button={props.desktop_layout == "rail"} ref="notificationsTrigger" title={t("notifications.title")} aria-label={t("notifications.title")} aria-haspopup="true">
                    <icon name="notifications" size="17" />
                    <NotificationCenter rail={props.desktop_layout == "rail"} />
                </button>
                <Status compact={true} rail={props.desktop_layout == "rail"} />
                {#if props.desktop_layout ~= "floating"}
                    <Clock compact={true} rail={props.desktop_layout == "rail"} lcd={props.desktop_layout == "tapedeck"} />
                {/if}
            </row>
        </row>
    {/if}
</template>

<script lang="luau">
local Launcher = require("@mesh/app-launcher")
local apps = require("mesh.apps")
local Clock = require("./components/clock.mesh")
local Workspaces = require("./components/workspaces.mesh")
local NowPlaying = require("./components/now-playing.mesh")
local Recorder = require("./components/recorder.mesh")
local Weather = require("./components/weather.mesh")
local Status = require("./components/status.mesh")
local NotificationCenter = require("./components/notification-center.mesh")
local ProfileSwitcher = require("@mesh/profile-switcher")
local t = import("mesh.i18n", "t")
local theme = require("mesh.theme")
local wm = require("mesh.wm")
local settings_ok, settings_service = pcall(require, "mesh.settings")
if not settings_ok then settings_service = nil end

-- Solid themes declare no compositor glass; the plugin draws behind these
-- surfaces only when the active theme wants it. Reading `wm.available`
-- reapplies it when the provider (re)starts.
effect(function()
    local wanted = theme.compositor_glass
    if wm.available and wanted ~= nil then wm.set_glass_enabled(wanted) end
end)

-- Surfaces above windows are drawn by the compositor's glass plugin, which
-- takes its strength from the provider rather than from the style tokens that
-- Settings saves. A negative strength restores the compositor's own presets.
local function saved_glass_strength()
    local namespaces = settings_service and settings_service.namespaces
    local shell = type(namespaces) == "table" and namespaces.shell
    local themed = type(shell) == "table" and shell.theme
    local tokens = type(themed) == "table" and themed.tokens
    if type(tokens) ~= "table" then return -1, -1 end
    local blur = tonumber(tokens["glass.strength.blur"])
    local liquid = tonumber(tokens["glass.strength.liquid"])
    if blur == nil or liquid == nil then return -1, -1 end
    return blur, liquid
end

local applied_glass = nil
effect(function()
    local blur, liquid = saved_glass_strength()
    if not wm.available then
        applied_glass = nil
        return
    end
    local key = tostring(blur) .. "/" .. tostring(liquid)
    if key == applied_glass then return end
    applied_glass = key
    wm.set_glass_strength(blur, liquid)
end)

function onSettings()
    mesh.shell.show_surface("@mesh/settings")
end

function onDashboard()
    mesh.shell.toggle_surface("@mesh/glass-dashboard")
end

function onWallpapers()
    mesh.shell.toggle_surface("@mesh/wallpaper-parallax")
end

window_title = ""
tasks = {}

effect(function()
    if props.desktop_layout == "floating" then
        local window = wm.active_window
        window_title = window and window.title or ""
    elseif props.desktop_layout == "tapedeck" then
        local running = {}
        for _, app in apps.apps or {} do
            if app.running then
                running[#running + 1] = {
                    id = app.id,
                    name = app.name,
                    focused = app.focused,
                    icon = string.sub(app.icon or "", 1, 1) == "/" and app.icon or "",
                }
            end
        end
        tasks = running
    end
end)

function onActivate(id) apps.activate(id) end
</script>

<style>

    /* The bar itself is clear: only the pills are glass, so the wallpaper
    shows between clusters as in a floating island layout. The root margin
    becomes the layer-shell margin and the surface ends at the border box, so
    part of the inset is padding: focus outlines and pill shadows at the ends
    would otherwise fall outside the buffer. */
    .bar {
        width: 100%;
        height: 48px;
        margin: 10px 12px 0;
        padding-inline: 6px;
        justify-content: space-between;
        align-items: center;
        gap: 11px;
        background: transparent;
        color: var(--glass-text);
    }

    .cluster {
        height: 100%;
        flex-grow: 0;
        flex-shrink: 0;
        min-width: 0;
        align-items: center;
        gap: 8px;
    }

    .cluster-start {
        justify-content: flex-start;
    }

    .cluster-center {
        flex-grow: 1;
        flex-shrink: 1;
        justify-content: center;
    }

    .cluster-end {
        justify-content: flex-end;
    }

    .pill {
        height: 36px;
        align-items: center;
        gap: 2px;
        padding-inline: 6px;
        border-radius: var(--glass-radius-bar);
        border: var(--glass-border-width) solid var(--glass-rim);
        background-image: var(--glass-surface-pill);
        box-shadow: var(--glass-shadow-pill);
        backdrop-filter: var(--glass-backdrop-pill);
    }

    .glyph-btn {
        width: 31px;
        height: 31px;
        padding: 0;
        justify-content: center;
        align-items: center;
        border-radius: 999px;
        background: transparent;
        color: var(--glass-text);
    }



    .glyph {
        width: 21px;
        height: 21px;
        color: var(--glass-text);
    }

    /* Motion: one vocabulary for the whole shell, all from theme tokens.
    Containers lift by --animation-lift-hover and brighten their rim; controls
    scale by --animation-scale-hover/-press and ring with the focus token. */

    .pill {
        transform: translateY(0px);
        transition-property: transform, border-color, opacity;
        transition-duration: var(--animation-duration-medium);
        transition-timing-function: var(--animation-curves-bezier-emphasized-decelerate);
    }

    .pill:hover {
        transform: translateY(var(--animation-lift-hover));
        border-color: var(--glass-rim-hover);
    }

    .glyph-btn {
        border-width: 1px;
        border-style: solid;
        border-color: transparent;
        transform: scale(1);
        transition-property: transform, background-color, border-color, opacity;
        transition-duration: var(--animation-duration-short);
        transition-timing-function: var(--animation-curves-bezier-emphasized-decelerate);
    }

    .glyph-btn:hover {
        background-color: var(--glass-hover);
        transform: scale(var(--animation-scale-hover));
    }

    .glyph-btn:focus-visible {
        transform: scale(var(--animation-scale-hover));
    }

    .glyph-btn:active {
        transform: scale(var(--animation-scale-press));
        transition-duration: var(--animation-duration-fast);
    }
    .cluster { animation: island-in 420ms var(--animation-curves-bezier-emphasized-decelerate) both; }
    .cluster-center { animation-delay: 65ms; }
    .cluster-end { animation-delay: 120ms; }
    @keyframes island-in {
        from { opacity: 0; transform: translateY(-16px) scale(0.96); }
        to { opacity: 1; transform: translateY(0px) scale(1); }
    }
    @container (max-width: 1500px) {
        .bar { gap: 6px; margin: 8px 4px 0; }
        .cluster { gap: 5px; }
    }
    @container (max-width: 1100px) {
        .cluster-center { display: none; }
    }

    .desktop-bar {
        width: 100%;
        height: 46px;
        align-items: center;
        gap: 10px;
        padding-inline: 12px;
        color: var(--glass-text);
    }

    .floating {
        margin: 12px 14px 0;
        border-radius: var(--glass-radius-bar);
        border: var(--glass-border-width) solid var(--glass-rim);
        background-image: var(--glass-surface-pill);
        backdrop-filter: var(--glass-backdrop-pill);
    }

    .paper {
        height: 34px;
        padding-inline: 18px;
        background: var(--color-surface);
        border-bottom: 1px solid var(--color-outline);
    }

    .taskbar {
        height: 36px;
        padding-inline: 6px;
        gap: 6px;
        background: var(--color-surface-container);
        box-shadow: var(--glass-shadow-pill);
    }

    .rail {
        width: 74px;
        height: 100%;
        margin: 16px 0 16px 16px;
        padding: 14px 0;
        flex-direction: column;
        gap: 12px;
        border-radius: 37px;
        background: var(--color-inverse-surface);
        color: var(--color-inverse-on-surface);
    }

    .start, .end {
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
    }

    .rail-group {
        flex-direction: column;
        gap: 6px;
    }

    .switcher-slot { width: 28px; height: 28px; flex-shrink: 0; }

    .bar-button {
        min-width: 28px;
        height: 26px;
        padding: 0 8px;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border-radius: var(--glass-radius-control);
        background: transparent;
        color: inherit;
        font-size: 13px;
        font-weight: 600;
    }

    .bar-button:hover { background: var(--glass-hover); }
    .brand { font-family: var(--typography-family-brand); font-size: 15px; }
    .rail-button { width: 40px; height: 36px; border-radius: 999px; }
    .rail-menu {
        width: 44px;
        height: 44px;
        background: var(--color-primary);
        color: var(--color-on-primary);
    }

    .task-list {
        min-width: 0;
        align-items: center;
        gap: 6px;
        border-left: 1px solid var(--color-outline);
        padding-left: 6px;
        overflow: hidden;
    }

    .task-chrome {
        background-image: var(--glass-surface-pill);
        box-shadow: var(--glass-shadow-pill);
    }

    .task-active {
        background-image: none;
        background-color: var(--color-surface-container-highest);
        box-shadow: inset 1px 1px 0 var(--glass-rim-inset);
    }

    .task { width: 180px; min-width: 38px; justify-content: flex-start; }
    .task-icon { width: 16px; height: 16px; flex-shrink: 0; }
    .task-name, .window-title { min-width: 0; max-width: 240px; text-overflow: ellipsis; }
    .window-title { color: var(--glass-text-muted); font-size: 13px; }
    .spacer { flex-grow: 1; }

    @container (max-width: 760px) {
        .desktop-bar { gap: 5px; }
        .window-title, .menu-action { display: none; }
    }
</style>
