<template>
    <row class="bar">
        <row class="cluster cluster-start">
            <row class="pill pill-tight">
                <button class="glyph-btn" onclick={onSettings} title="Settings" aria-label="Settings">
                    <icon class="glyph" name="settings" size="15" />
                </button>
                <button class="glyph-btn" onclick={onDashboard} title={t("bar.dashboard")} aria-label={t("bar.dashboard")}>
                    <icon class="glyph" name="view-dashboard" size="15" />
                </button>
                <button class="glyph-btn" onclick={onWallpapers} title={t("bar.wallpapers")} aria-label={t("bar.wallpapers")}>
                    <icon class="glyph" name="preferences-desktop-wallpaper" size="15" />
                </button>
                <ProfileSwitcher trigger_hover="var(--glass-hover)" />
            </row>
            <Clock />
            <Workspaces />
        </row>

        <row class="cluster cluster-center">
            <NowPlaying />
            <Recorder />
            <Weather />
        </row>

        <row class="cluster cluster-end">
            <Status />
        </row>
    </row>
</template>

<script lang="luau">
local Clock = require("./components/clock.mesh")
local Workspaces = require("./components/workspaces.mesh")
local NowPlaying = require("./components/now-playing.mesh")
local Recorder = require("./components/recorder.mesh")
local Weather = require("./components/weather.mesh")
local Status = require("./components/status.mesh")
local ProfileSwitcher = require("@mesh/profile-switcher")
local t = import("mesh.i18n", "t")
local theme = require("mesh.theme")
local wm = require("mesh.wm")
local settings_ok, settings_service = pcall(require, "mesh.settings")
if not settings_ok then settings_service = nil end

-- Solid themes declare no compositor glass; the plugin draws behind these
-- surfaces only when the active theme wants it. Reading `wm.available`
-- reapplies it when the provider (re)starts.
effect(function()
    local wanted = theme.compositor_glass
    if wm.available and wanted ~= nil then wm.set_glass_enabled(wanted) end
end)

-- Surfaces above windows are drawn by the compositor's glass plugin, which
-- takes its strength from the provider rather than from the style tokens that
-- Settings saves. A negative strength restores the compositor's own presets.
local function saved_glass_strength()
    local namespaces = settings_service and settings_service.namespaces
    local shell = type(namespaces) == "table" and namespaces.shell
    local themed = type(shell) == "table" and shell.theme
    local tokens = type(themed) == "table" and themed.tokens
    if type(tokens) ~= "table" then return -1, -1 end
    local blur = tonumber(tokens["glass.strength.blur"])
    local liquid = tonumber(tokens["glass.strength.liquid"])
    if blur == nil or liquid == nil then return -1, -1 end
    return blur, liquid
end

local applied_glass = nil
effect(function()
    local blur, liquid = saved_glass_strength()
    if not wm.available then
        applied_glass = nil
        return
    end
    local key = tostring(blur) .. "/" .. tostring(liquid)
    if key == applied_glass then return end
    applied_glass = key
    wm.set_glass_strength(blur, liquid)
end)

function onSettings()
    mesh.shell.show_surface("@mesh/settings")
end

function onDashboard()
    mesh.shell.toggle_surface("@mesh/glass-dashboard")
end

function onWallpapers()
    mesh.shell.toggle_surface("@mesh/wallpaper-parallax")
end

</script>

<style>
    /* The bar itself is clear: only the pills are glass, so the wallpaper
    shows between clusters as in a floating island layout. The root margin
    becomes the layer-shell margin and the surface ends at the border box, so
    part of the inset is padding: focus outlines and pill shadows at the ends
    would otherwise fall outside the buffer. */
    .bar {
        width: 100%;
        height: 48px;
        margin: 10px 12px 0;
        padding-inline: 6px;
        justify-content: space-between;
        align-items: center;
        gap: 11px;
        background: transparent;
        color: var(--glass-text);
    }

    .cluster {
        height: 100%;
        flex-grow: 0;
        flex-shrink: 0;
        min-width: 0;
        align-items: center;
        gap: 8px;
    }

    .cluster-start {
        justify-content: flex-start;
    }

    .cluster-center {
        flex-grow: 1;
        flex-shrink: 1;
        justify-content: center;
    }

    .cluster-end {
        justify-content: flex-end;
    }

    .pill {
        height: 36px;
        align-items: center;
        gap: 2px;
        padding-inline: 6px;
        border-radius: 999px;
        border: 1px solid var(--glass-rim);
        background-image: var(--glass-surface-pill);
        box-shadow: var(--glass-shadow-pill);
        backdrop-filter: var(--glass-backdrop-pill);
    }

    .glyph-btn {
        width: 31px;
        height: 31px;
        padding: 0;
        justify-content: center;
        align-items: center;
        border-radius: 999px;
        background: transparent;
        color: var(--glass-text);
    }



    .glyph {
        width: 21px;
        height: 21px;
        color: var(--glass-text);
    }

    /* Motion: one vocabulary for the whole shell, all from theme tokens.
    Containers lift by --animation-lift-hover and brighten their rim; controls
    scale by --animation-scale-hover/-press and ring with the focus token. */

    .pill {
        transform: translateY(0px);
        transition-property: transform, border-color, opacity;
        transition-duration: var(--animation-duration-medium);
        transition-timing-function: var(--animation-curves-bezier-emphasized-decelerate);
    }

    .pill:hover {
        transform: translateY(var(--animation-lift-hover));
        border-color: var(--glass-rim-hover);
    }

    .glyph-btn {
        border-width: 1px;
        border-style: solid;
        border-color: transparent;
        transform: scale(1);
        transition-property: transform, background-color, border-color, opacity;
        transition-duration: var(--animation-duration-short);
        transition-timing-function: var(--animation-curves-bezier-emphasized-decelerate);
    }

    .glyph-btn:hover {
        background-color: var(--glass-hover);
        transform: scale(var(--animation-scale-hover));
    }

    .glyph-btn:focus-visible {
        transform: scale(var(--animation-scale-hover));
    }

    .glyph-btn:active {
        transform: scale(var(--animation-scale-press));
        transition-duration: var(--animation-duration-fast);
    }
    .cluster { animation: island-in 420ms var(--animation-curves-bezier-emphasized-decelerate) both; }
    .cluster-center { animation-delay: 65ms; }
    .cluster-end { animation-delay: 120ms; }
    @keyframes island-in {
        from { opacity: 0; transform: translateY(-16px) scale(0.96); }
        to { opacity: 1; transform: translateY(0px) scale(1); }
    }
    @container (max-width: 1500px) {
        .bar { gap: 6px; margin: 8px 4px 0; }
        .cluster { gap: 5px; }
    }
    @container (max-width: 1100px) {
        .cluster-center { display: none; }
    }
</style>
