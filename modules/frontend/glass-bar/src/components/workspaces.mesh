<props>
{
    layout = { type = "enum", options = { "islands", "floating", "paper", "rail" }, default = "islands" },
}
</props>

<template>
    <row class="pill" class:compact={props.layout ~= "islands"} class:rail={props.layout == "rail"} onpointerleave={onLeave}>
        {#for workspace in items key={workspace.id}}
            <button
                class="ws"
                class:ws-compact={props.layout ~= "islands"}
                class:ws-numbered={props.layout == "paper"}
                class:ws-rail={props.layout == "rail"}
                class:ws-active={workspace.active}
                class:ws-active-right={props.layout == "islands" and workspace.active and direction == "right"}
                class:ws-active-left={props.layout == "islands" and workspace.active and direction == "left"}
                class:ws-occupied={workspace.occupied}
                onclick={onSwitch(workspace.id)}
                title={workspace.label}
                aria-label={workspace.label}
                aria-pressed={workspace.active}
            >
                {#if props.layout == "paper"}
                    <text>{workspace.id}</text>
                {/if}
            </button>
        {/for}
    </row>
</template>

<script lang="luau">
local wm = require("mesh.wm")
local t = import("mesh.i18n", "t")

-- A fixed strip of slots, like the reference rice: empty workspaces still
-- show as dim dots so the active pill visibly travels between positions.
local function default_slots()
    if props.layout == "paper" or props.layout == "rail" then return 4 end
    if props.layout == "floating" then return 5 end
    return 6
end

items = {}
direction = "right"
local previous_active = nil

effect(function()
    local occupied = {}
    local highest = default_slots()
    local current_active = wm.active_workspace
    if wm.available then
        for _, workspace in wm.workspaces do
            if workspace.id > 0 then
                occupied[workspace.id] = (workspace.windows or 0) > 0
                highest = math.max(highest, workspace.id)
            end
        end
    end

    if previous_active ~= nil and current_active ~= nil and previous_active ~= current_active then
        if current_active < previous_active then
            direction = "left"
        else
            direction = "right"
        end
    end
    previous_active = current_active

    local list = {}
    for id = 1, math.min(highest, 10) do
        list[#list + 1] = {
            id = id,
            label = t("workspace.label", { id = tostring(id) }),
            active = current_active == id,
            occupied = occupied[id] == true,
        }
    end
    items = list
end)

function onSwitch(id)
    if previous_active ~= nil and id ~= previous_active then
        if id < previous_active then
            direction = "left"
        else
            direction = "right"
        end
    end
    wm.focus_workspace(id)
end

function onLeave() end
</script>

<style>
    .pill {
        height: 36px;
        align-items: center;
        gap: 7px;
        padding-inline: 13px;
        border-radius: 999px;
        border: 1px solid var(--glass-rim);
        background-image: var(--glass-surface-pill);
        box-shadow: var(--glass-shadow-pill);
        backdrop-filter: var(--glass-backdrop-pill);
    }

    /* Width is the animated property: the active dot stretches into a pill
    while its neighbour shrinks back, which reads as the pill sliding. */
    .ws {
        width: 13px;
        height: 13px;
        padding: 0;
        border-radius: 999px;
        background: var(--glass-fill-subtle);
    }

    .ws-occupied {
        background: var(--glass-fill-occupied);
    }

    /* Motion: one vocabulary for the whole shell, all from theme tokens.
    Containers lift by --animation-lift-hover and brighten their rim; controls
    scale by --animation-scale-hover/-press and ring with the focus token. */

    .pill {
        transform: translateY(0px);
        transition-property: transform, border-color, opacity;
        transition-duration: var(--animation-duration-medium);
        transition-timing-function: var(--animation-curves-bezier-emphasized-decelerate);
    }

    .pill:hover {
        transform: translateY(var(--animation-lift-hover));
        border-color: var(--glass-rim-hover);
    }

    .ws {
        border-width: 1px;
        border-style: solid;
        border-color: transparent;
        transform: scale(1);
        transition-property: transform, background-color, border-color, opacity;
        transition-duration: var(--animation-duration-short);
        transition-timing-function: var(--animation-curves-bezier-emphasized-decelerate);
    }

    .ws:hover {
        background-color: var(--glass-fill-hover);
        transform: scale(var(--animation-scale-hover));
        transform-origin: center center;
    }

    .ws:focus-visible {
        transform: scale(var(--animation-scale-hover));
    }

    .ws:active {
        transform: scale(var(--animation-scale-press));
        transition-duration: var(--animation-duration-fast);
    }

    /* The active dot stretches into a pill while the old one shrinks back,
    which reads as the pill sliding; width rides the same token timing. */
    .ws {
        transition-property: width, transform, background-color, border-color, opacity;
        transition-duration: var(--animation-duration-medium);
    }

    .ws-active,
    .ws-active:hover {
        width: 42px;
        background-image: var(--glass-surface-active);
    }

    .ws-active-right {
        transform-origin: left center;
        animation: ws-scale-right var(--animation-duration-medium) var(--animation-curves-bezier-emphasized-decelerate);
    }

    .ws-active-left {
        transform-origin: right center;
        animation: ws-scale-left var(--animation-duration-medium) var(--animation-curves-bezier-emphasized-decelerate);
    }

    @keyframes ws-scale-right {
        0% {
            transform: scaleX(0.35) scaleY(0.7);
        }
        60% {
            transform: scaleX(1.06) scaleY(1.06);
        }
        100% {
            transform: scale(1);
        }
    }

    @keyframes ws-scale-left {
        0% {
            transform: scaleX(0.35) scaleY(0.7);
        }
        60% {
            transform: scaleX(1.06) scaleY(1.06);
        }
        100% {
            transform: scale(1);
        }
    }

    .compact {
        height: fit;
        padding: 0;
        gap: 4px;
        border: 0;
        background-image: none;
        box-shadow: none;
        backdrop-filter: none;
        transform: none;
    }

    .ws-compact { width: 22px; height: 22px; }
    .ws-compact.ws-active { width: 28px; background-image: none; background-color: var(--color-primary); }
    .ws-numbered {
        width: 22px;
        justify-content: center;
        align-items: center;
        color: var(--color-on-surface);
        background: transparent;
        font-size: 12px;
    }
    .ws-numbered.ws-active { color: var(--color-primary); font-weight: 700; }
    .rail { flex-direction: column; gap: 6px; }
    .ws-rail { width: 24px; height: 22px; background: var(--color-secondary); }
    .ws-rail.ws-active { width: 24px; height: 34px; background: var(--color-primary); }
</style>
