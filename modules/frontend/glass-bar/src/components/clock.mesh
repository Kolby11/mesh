<props>
{
    compact = { type = "bool", default = false },
    rail = { type = "bool", default = false },
    lcd = { type = "bool", default = false },
}
</props>

<template>
    {#if props.compact}
        <button class="clock-compact" class:clock-rail={props.rail} class:clock-lcd={props.lcd}
            ref="glassCalendar" title={full_label} aria-label={full_label} aria-haspopup="true">
            {#if props.rail}
                <text>{hours}</text>
                <text>{minutes}</text>
            {:else}
                <text>{compact_label}</text>
            {/if}
            <Calendar rail={props.rail} />
        </button>
    {:else}
    <row class="clock-group">
        <button class="pill pill-clock" ref="glassCalendar" title={full_label} aria-label={full_label}>
            <text class="big">{hours}</text>
            <column class="stack">
                <text class="small">{minutes}</text>
                <text class="small small-dim">{seconds}</text>
                <text class="small small-dim" hidden={meridiem == ""}>{meridiem}</text>
            </column>
            <Calendar />
        </button>
        <row class="pill pill-clock" title={full_label} aria-label={full_label}>
            <text class="big">{day}</text>
            <column class="stack">
                <text class="small">{weekday}</text>
                <text class="small small-dim">{month}</text>
            </column>
        </row>
    </row>
    {/if}
</template>

<script lang="luau">
local Calendar = require("./calendar.mesh")
local settings_ok, settings_service = pcall(require, "mesh.settings")
if not settings_ok then settings_service = nil end
-- Preferences the Settings module stores under its own namespace.
local function pref(name, fallback)
    local ns = settings_service and settings_service.namespaces and settings_service.namespaces["@mesh/settings"]
    local global = ns and ns.props and ns.props.global
    if global and global[name] ~= nil then return global[name] end
    return fallback
end
hours = "--"
minutes = "--"
seconds = "--"
meridiem = ""
day = "--"
weekday = ""
month = ""
full_label = ""
compact_label = ""

local function date(pattern, now)
    local ok, value = pcall(os.date, pattern, now)
    return ok and value or ""
end

local function tick()
    local now = os.time()
    if pref("clock_24h", true) then
        hours = date("%H", now)
        meridiem = ""
    else
        hours = date("%I", now)
        meridiem = date("%p", now)
    end
    minutes = date("%M", now)
    seconds = date("%S", now)
    day = date("%d", now)
    weekday = string.upper(date("%a", now))
    month = string.upper(date("%b", now))
    local time = mesh.locale.format_time(now)
    full_label = mesh.locale.format_date(now, "full") .. " " .. time
    compact_label = mesh.locale.format_date(now, "short") .. "  " .. time
end

effect(function()
    local _ = settings_service and settings_service.namespaces
    tick()
end)
task.spawn(function()
    while true do
        task.sleep(1000)
        tick()
    end
end)
</script>

<style>
    .clock-compact {
        flex-shrink: 0;
        height: 26px;
        padding-inline: 8px;
        align-items: center;
        justify-content: center;
        color: var(--glass-text);
        background: transparent;
        font-size: 13px;
        font-weight: 700;
    }

    .clock-compact:hover { background: var(--glass-hover); }
    .clock-rail { flex-direction: column; height: 36px; padding: 0 8px; color: var(--color-inverse-on-surface); }
    .clock-lcd {
        font-family: var(--typography-family-plain);
        background: var(--color-inverse-surface);
        color: var(--color-inverse-on-surface);
        border-radius: 0;
        box-shadow: inset 1px 1px 0 var(--glass-rim-inset);
    }

    .clock-group {
        height: 100%;
        align-items: center;
        gap: 8px;
    }

    .pill {
        height: 36px;
        align-items: center;
        border-radius: 999px;
        border: 1px solid var(--glass-rim);
        background-color: transparent;
        background-image: var(--glass-surface-pill);
        box-shadow: var(--glass-shadow-pill);
        backdrop-filter: var(--glass-backdrop-pill);
    }

    .pill-clock {
        gap: 4px;
        padding-inline: 14px 11px;
        transition: background-color 200 cubic-bezier(0.2, 0, 0, 1);
    }


    .big {
        height: 28px;
        font-size: 21px;
        font-weight: 600;
        line-height: 1.2;
        color: var(--glass-text);
    }

    .stack {
        gap: 0;
        justify-content: center;
    }

    .small {
        height: 13px;
        font-size: 10px;
        font-weight: 600;
        line-height: 1.2;
        color: var(--glass-text);
    }

    .small-dim {
        color: var(--glass-text-muted);
    }

    /* Motion: one vocabulary for the whole shell, all from theme tokens.
    Containers lift by --animation-lift-hover and brighten their rim; controls
    scale by --animation-scale-hover/-press and ring with the focus token. */

    .pill {
        transform: translateY(0px);
        transition-property: transform, border-color, opacity;
        transition-duration: var(--animation-duration-medium);
        transition-timing-function: var(--animation-curves-bezier-emphasized-decelerate);
    }

    .pill:hover {
        transform: translateY(var(--animation-lift-hover));
        border-color: var(--glass-rim-hover);
    }
</style>
