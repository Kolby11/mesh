<template>
    <row class="clock-group">
        <row class="pill pill-clock" title={full_label} aria-label={full_label}>
            <text class="big">{hours}</text>
            <column class="stack">
                <text class="small">{minutes}</text>
                <text class="small small-dim">{seconds}</text>
            </column>
        </row>
        <row class="pill pill-clock" title={full_label} aria-label={full_label}>
            <text class="big">{day}</text>
            <column class="stack">
                <text class="small">{weekday}</text>
                <text class="small small-dim">{month}</text>
            </column>
        </row>
    </row>
</template>

<script lang="luau">
hours = "--"
minutes = "--"
seconds = "--"
day = "--"
weekday = ""
month = ""
full_label = ""

local function date(pattern, now)
    local ok, value = pcall(os.date, pattern, now)
    return ok and value or ""
end

local function tick()
    local now = os.time()
    hours = date("%H", now)
    minutes = date("%M", now)
    seconds = date("%S", now)
    day = date("%d", now)
    weekday = string.upper(date("%a", now))
    month = string.upper(date("%b", now))
    full_label = mesh.locale.format_date(now, "full") .. " " .. mesh.locale.format_time(now)
end

tick()
task.spawn(function()
    while true do
        task.sleep(1000)
        tick()
    end
end)
</script>

<style>
    .clock-group {
        height: 100%;
        align-items: center;
        gap: 8px;
    }

    .pill {
        height: 36px;
        align-items: center;
        border-radius: 999px;
        border: 1px solid var(--glass-rim);
        background-image: linear-gradient(to bottom, #b468ff4d, #7a2ee033);
        box-shadow: 0 4px 14px #14003259;
        backdrop-filter: blur(5px) refract(12px 11px) dispersion(1.5px);
    }

    .pill-clock {
        gap: 4px;
        padding-inline: 14px 11px;
        transition: background-color 200 cubic-bezier(0.2, 0, 0, 1);
    }


    .big {
        height: 28px;
        font-size: 21px;
        font-weight: 600;
        line-height: 1.2;
        color: #f5ecff;
    }

    .stack {
        gap: 0;
        justify-content: center;
    }

    .small {
        height: 13px;
        font-size: 10px;
        font-weight: 600;
        line-height: 1.2;
        color: #f5ecff;
    }

    .small-dim {
        color: #e3cdfa;
    }

    /* Motion: one vocabulary for the whole shell, all from theme tokens.
    Containers lift by --animation-lift-hover and brighten their rim; controls
    scale by --animation-scale-hover/-press and ring with the focus token. */

    .pill {
        transform: translateY(0px);
        transition-property: transform, border-color, opacity;
        transition-duration: var(--animation-duration-medium);
        transition-timing-function: var(--animation-curves-bezier-emphasized-decelerate);
    }

    .pill:hover {
        transform: translateY(var(--animation-lift-hover));
        border-color: var(--glass-rim-hover);
    }
</style>
