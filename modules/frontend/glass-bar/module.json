{
  "name": "@mesh/glass-bar",
  "version": "0.1.0",
  "description": "Floating top bar of liquid-glass pills: launcher, clock, date, workspaces, now playing, recording, weather and system status.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "ui",
    "uses": {
      "interfaces": {
        "mesh.wm": ">=1.2",
        "mesh.theme": ">=1.0",
        "mesh.audio": ">=1.0",
        "mesh.power": ">=1.0"
      },
      "optionalInterfaces": {
        "mesh.media": ">=1.0",
        "mesh.settings": ">=1.0",
        "mesh.weather": ">=1.0",
        "mesh.network": ">=1.0",
        "mesh.recorder": ">=1.0",
        "mesh.brightness": ">=1.0"
      },
      "resources": {
        "icons": [
          "@mesh/icons-material-symbols"
        ]
      },
      "capabilities": [
        "shell.surface",
        "theme.read",
        "locale.read",
        "service.wm.read",
        "service.wm.control",
        "service.audio.read",
        "service.audio.control",
        "service.power.read",
        "service.media.read",
        "service.media.control",
        "service.weather.read",
        "service.network.read",
        "service.recorder.read",
        "service.recorder.control",
        "service.settings.read",
        "service.brightness.read",
        "service.brightness.control"
      ],
      "modules": {
        "@mesh/glass-material": ">=0.1.0",
        "@mesh/profile-switcher": ">=0.1.0",
        "@mesh/volume-presentation": ">=0.1.0"
      }
    },
    "entry": "src/main.mesh",
    "surface": {
      "anchor": "top",
      "layer": "top",
      "keyboard_mode": "on_demand",
      "visible_on_start": true
    },
    "provides": {
      "layout": [
        {
          "id": "main",
          "entrypoint": "src/main.mesh",
          "label": "Glass bar"
        }
      ]
    },
    "accessibility": {
      "role": "toolbar"
    },
    "i18n": {
      "defaultLocale": "en"
    },
    "contributes": {
      "i18n": [
        {
          "id": "en",
          "locale": "en",
          "path": "config/i18n/en.json"
        },
        {
          "id": "sk",
          "locale": "sk",
          "path": "config/i18n/sk.json"
        }
      ]
    }
  }
}
