<template>
  <row class="window-title-row">
    <text class="wt-text">{windowTitle()}</text>
  </row>
</template>

<script lang="luau">
local wm = require("mesh.wm")

local function windowTitle()
    local window = wm and wm.active_window
    local title = window and window.title or ""
    if title == "" then return "Desktop" end
    if (utf8.len(title) or #title) > 36 then
        return string.sub(title, 1, (utf8.offset(title, 35) or 35) - 1) .. "…"
    end
    return title
end
</script>

<style>
.window-title-row {
    align-items: center;
    justify-content: center;
    min-width: 60px;
    max-width: 240px;
    flex-shrink: 1;
    padding-inline: var(--spacing-xs);
    height: 24px;
    border-radius: var(--radius-md);
    background: transparent;
}

.wt-text {
    color: var(--color-on-surface-variant);
    font-size: var(--typography-size-sm);
    font-weight: 500;
    text-wrap: none;
    transition: color var(--animation-duration-medium) var(--animation-curves-bezier-standard);
}

@container (max-width: 900px) {
    .window-title-row {
        max-width: 160px;
    }
}

@container (max-width: 720px) {
    .window-title-row {
        display: none;
    }
}
</style>
