{
  "name": "@mesh/glass-dock",
  "version": "0.1.0",
  "description": "Bottom liquid-glass dock of pinned and running applications with a lift-on-hover animation.",
  "mesh": {
    "apiVersion": "0.1",
    "kind": "ui",
    "uses": {
      "interfaces": {
        "mesh.apps": ">=1.0"
      },
      "modules": {
        "@mesh/glass-material": ">=0.1.0",
        "@mesh/radial-launcher": ">=0.1.0"
      },
      "capabilities": [
        "shell.surface",
        "theme.read",
        "service.apps.read",
        "service.apps.launch",
        "locale.read"
      ],
      "resources": {
        "icons": [
          "@mesh/icons-material-symbols"
        ]
      }
    },
    "entry": "src/main.mesh",
    "surface": {
      "anchor": "bottom",
      "layer": "top",
      "keyboard_mode": "on_demand",
      "visible_on_start": true
    },
    "provides": {
      "layout": [
        {
          "id": "main",
          "entrypoint": "src/main.mesh",
          "label": "Glass dock"
        }
      ]
    },
    "accessibility": {
      "role": "toolbar"
    },
    "i18n": {
      "defaultLocale": "en"
    },
    "contributes": {
      "i18n": [
        {
          "id": "en",
          "locale": "en",
          "path": "config/i18n/en.json"
        },
        {
          "id": "sk",
          "locale": "sk",
          "path": "config/i18n/sk.json"
        }
      ],
      "keybinds": {
        "radial": {
          "label": {
            "t": "keybind.radial.label",
            "fallback": "Radial launcher"
          },
          "description": {
            "t": "keybind.radial.description",
            "fallback": "Show or hide the radial launcher of apps"
          },
          "category": {
            "t": "keybind.category",
            "fallback": "Dock"
          },
          "trigger": {
            "kind": "auto"
          }
        }
      }
    },
    "icons": {
      "ignore_shell_default": true
    }
  }
}
