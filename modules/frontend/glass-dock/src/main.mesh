<props>
{
    icon_size = { type = "number", default = 48, min = 32, max = 96, step = 2, label = "Icon size" },
}
</props>

<template>
    <row class="dock-shell">
        <box class="flare flare-left" aria-hidden="true">
            <box class="flare-cut flare-cut-left" />
        </box>
        <row class="dock" onpointerleave={onLeave}>
            <column class="slot launcher-slot">
                <button class="tile launcher-tile" ref="glassLauncher" aria-label={t("launcher.title")} title={t("launcher.title")}>
                    <icon class="launcher-glyph" name="system-search" size="30" />
                    <Launcher />
                </button>
                <box class="dot" />
            </column>
            <box class="dock-divider" />
            {#for app in apps key={app.id}}
                <column class="slot">
                    <button
                        class="tile"
                        ref={app.id}
                        class:tile-focused={app.focused}
                        class:tile-hovered={app.hovered}
                        class:tile-neighbor={app.neighbor}
                        onpointerenter={onHover(app.index)}
                        onclick={onActivate(app.id)}
                        title={app.name}
                        aria-label={app.name}
                    >
                        <image class="app-icon" src={app.icon} alt="" hidden={not app.has_file} />
                        <icon class="app-icon app-glyph" name="application-x-executable" size="64" hidden={app.has_file} />
                    </button>
                    <box class="dot" class:dot-running={app.running} class:dot-focused={app.focused} />
                </column>
            {/for}
        </row>
        <box class="flare flare-right" aria-hidden="true">
            <box class="flare-cut flare-cut-right" />
        </box>
    </row>
</template>

<script lang="luau">
local t = import("mesh.i18n", "t")
local apps_service = require("mesh.apps")
local Launcher = require("./components/launcher.mesh")
hovered_index = 0

apps = {}

effect(function()
    local list = {}
    if apps_service.available then
        for index, app in apps_service.apps do
            list[#list + 1] = {
                id = app.id,
                index = index,
                hovered = hovered_index == index,
                neighbor = hovered_index > 0 and math.abs(hovered_index - index) == 1,
                name = app.name,
                icon = app.icon,
                has_file = string.sub(app.icon or "", 1, 1) == "/",
                running = app.running,
                focused = app.focused,
            }
        end
    end
    apps = list
end)

function onHover(index) hovered_index = index end
function onLeave() hovered_index = 0 end

function onActivate(id)
    apps_service.activate(id)
end
</script>

<style>
    /* The layer surface spans the output's width (bottom anchor); this row
    centers the shelf and seats it on the screen edge. */
    .dock-shell {
        width: 100%;
        padding-top: 24px;
        justify-content: center;
        align-items: flex-end;
        gap: 0;
        background: transparent;
        animation: dock-in 560 cubic-bezier(0.05, 0.7, 0.1, 1) both;
    }

    /* A glass shelf standing on the screen edge: rounded shoulders on top,
    square to the floor, where the flares below curve it into the edge. */
    .dock {
        height: 90px;
        padding: 10px 14px 6px;
        gap: 8px;
        align-items: flex-start;
        border-radius: 30px 30px 0 0;
        border-width: 1px 1px 0 1px;
        border-color: var(--glass-rim);
        background-image: var(--glass-surface-dock);
        box-shadow: var(--glass-shadow-dock);
        backdrop-filter: blur(14px) refract(18px 16px) dispersion(1.2px);
    }

    /* Concave feet. Each flare is a square of the same glass with a
    quarter-round cut-out that paints the plain backdrop source
    (`refract(0px 0px)`), so the shelf sweeps outward into the floor. */
    .flare {
        position: relative;
        width: 30px;
        height: 30px;
        flex-shrink: 0;
        background-image: var(--glass-surface-flare);
        backdrop-filter: blur(8px) refract(0px 0px);
    }

    .flare-cut {
        position: absolute;
        top: 0;
        width: 30px;
        height: 30px;
        backdrop-filter: refract(0px 0px);
    }

    .flare-cut-left {
        left: 0;
        border-radius: 0 0 30px 0;
    }

    .flare-cut-right {
        left: 0;
        border-radius: 0 0 0 30px;
    }

    .slot {
        gap: 4px;
        align-items: center;
    }

    /* Each app sits on its own small glass lens, lighter than the shelf; the
    focused app's lens takes the theme accent. */
    .tile {
        width: 64px;
        height: 64px;
        padding: 0;
        justify-content: center;
        align-items: center;
        border-radius: 17px;
        border: 1px solid var(--glass-fill-subtle);
        /* A colour with any alpha counts as authored; alpha 0 would let the
        theme's opaque `button` fill paint over the glass. */
        background-color: var(--glass-fill-lens);
        background-image: var(--glass-surface-lens);
        box-shadow: var(--glass-shadow-lens);
        backdrop-filter: refract(8px 8px);
    }

    .tile-focused,
    .tile-focused:hover {
        border-color: var(--glass-rim-focused);
        background-image: var(--glass-surface-focused);
    }

    .app-icon {
        width: prop(icon_size);
        height: prop(icon_size);
    }

    .app-glyph {
        color: var(--glass-text);
    }

    .dot {
        width: 5px;
        height: 5px;
        border-radius: 999px;
        background: transparent;
        transition-property: background-color, width;
        transition-duration: var(--animation-duration-medium);
        transition-timing-function: var(--animation-curves-bezier-emphasized-decelerate);
    }

    .dot-running {
        background: var(--glass-text);
    }

    @keyframes dock-in {
        0% {
            opacity: 0;
            transform: translateY(56px);
        }
        100% {
            opacity: 1;
            transform: translateY(0px);
        }
    }

    /* Motion: one vocabulary for the whole shell, all from theme tokens.
    Containers brighten their rim; controls scale by
    --animation-scale-hover/-press and ring with the focus token. */

    .dock {
        transition-property: border-color, opacity;
        transition-duration: var(--animation-duration-medium);
        transition-timing-function: var(--animation-curves-bezier-emphasized-decelerate);
    }

    .dock:hover {
        border-color: var(--glass-rim-hover);
    }

    .tile {
        transform: scale(1);
        transition-property: transform, background-color, border-color, opacity;
        transition-duration: var(--animation-duration-short);
        transition-timing-function: var(--animation-curves-bezier-emphasized-decelerate);
    }

    .tile:hover {
        border-color: var(--glass-rim-hover);
        transform: translateY(-12px) scale(1.22);
    }

    .tile:focus-visible {
        border-color: var(--color-focus-ring);
        transform: translateY(-12px) scale(1.22);
    }

    .tile:active {
        transform: translateY(-6px) scale(0.96);
        transition-duration: var(--animation-duration-fast);
    }
    .tile-neighbor { transform: translateY(-4px) scale(1.08); }
    .tile-hovered { transform: translateY(-12px) scale(1.22); }
    .dot-focused { width: 14px; background: var(--glass-indicator); }
    .launcher-glyph { width: 30px; height: 30px; color: var(--glass-text-heading); }
    .launcher-tile { background-image: var(--glass-surface-control); }
    .dock-divider { width: 1px; height: 44px; margin: 10px 6px; background: var(--glass-rim); }
    @container (max-width: 900px) {
        .tile { width: 50px; height: 54px; border-radius: 14px; }
        .app-icon { width: 38px; height: 38px; }
        .dock { height: 78px; gap: 5px; padding-inline: 10px; }
    }
</style>
