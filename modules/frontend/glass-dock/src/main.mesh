<props>
{
    desktop_layout = { type = "enum", options = { "shelf", "floating", "paper", "tapedeck", "rail" }, default = "shelf" },
    icon_size = { type = "number", default = 48, min = 32, max = 96, step = 2, label = "Icon size" },
}
</props>

<template>
    <row class="dock-shell" class:compact-shelf={props.desktop_layout ~= "shelf"}
        class:floating-shelf={props.desktop_layout == "floating"} class:paper-shelf={props.desktop_layout == "paper"}
        class:app-rail={props.desktop_layout == "rail"}>
        <box class="flare flare-left" class:compact-flare={props.desktop_layout ~= "shelf"} aria-hidden="true" />
        <row class="dock" class:compact-dock={props.desktop_layout ~= "shelf"} class:app-rail-dock={props.desktop_layout == "rail"} class:floating-dock={props.desktop_layout == "floating"} class:paper-dock={props.desktop_layout == "paper"} class:retro-dock={props.desktop_layout == "tapedeck"} onpointerleave={onLeave}>
            <column class="slot launcher-slot" class:compact-slot={props.desktop_layout ~= "shelf"}>
                <button class="tile launcher-tile" class:compact-tile={props.desktop_layout ~= "shelf"} class:rail-tile={props.desktop_layout == "rail"} class:floating-tile={props.desktop_layout == "floating"} class:paper-tile={props.desktop_layout == "paper"} ref="glassLauncher" aria-label={t("launcher.title")} title={t("launcher.title")}>
                    <icon class="launcher-glyph" class:rail-glyph={props.desktop_layout == "rail"} class:compact-glyph={props.desktop_layout ~= "shelf"} name="system-search" size="30" />
                    <Launcher side={props.desktop_layout == "rail" and "left" or "top"} />
                </button>
                <box class="dot" class:rail-dot={props.desktop_layout == "rail"} />
            </column>
            <column class="slot" class:compact-slot={props.desktop_layout ~= "shelf"}>
                <button class="tile" class:compact-tile={props.desktop_layout ~= "shelf"} class:rail-tile={props.desktop_layout == "rail"} class:floating-tile={props.desktop_layout == "floating"} class:paper-tile={props.desktop_layout == "paper"} aria-label={t("launcher.radial")} title={t("launcher.radial")} onclick={onRadial} keybind="radial" onkeybind={onRadial}>
                    <icon class="launcher-glyph" class:rail-glyph={props.desktop_layout == "rail"} class:compact-glyph={props.desktop_layout ~= "shelf"} name="view-grid" size="30" />
                </button>
                <box class="dot" class:rail-dot={props.desktop_layout == "rail"} />
            </column>
            <box class="dock-divider" class:compact-divider={props.desktop_layout ~= "shelf"} class:rail-divider={props.desktop_layout == "rail"} />
            {#for app in apps key={app.id}}
                <column class="slot" class:compact-slot={props.desktop_layout ~= "shelf"}>
                    <button
                        class="tile" class:compact-tile={props.desktop_layout ~= "shelf"} class:rail-tile={props.desktop_layout == "rail"} class:floating-tile={props.desktop_layout == "floating"} class:paper-tile={props.desktop_layout == "paper"}
                        ref={app.id}
                        class:tile-focused={app.focused}
                        class:tile-hovered={app.hovered}
                        class:tile-neighbor={app.neighbor}
                        onpointerenter={onHover(app.index)}
                        onclick={onActivate(app.id)}
                        title={app.name}
                        aria-label={app.name}
                    >
                        <image class="app-icon" class:compact-icon={props.desktop_layout ~= "shelf"} src={app.icon} alt="" hidden={not app.has_file} />
                        <icon class="app-icon app-glyph" class:rail-glyph={props.desktop_layout == "rail"} class:compact-icon={props.desktop_layout ~= "shelf"} name="application-x-executable" size="64" hidden={app.has_file} />
                    </button>
                    <box class="dot" class:rail-dot={props.desktop_layout == "rail"} class:dot-running={app.running} class:dot-focused={app.focused} />
                </column>
            {/for}
        </row>
        <box class="flare flare-right" class:compact-flare={props.desktop_layout ~= "shelf"} aria-hidden="true" />
    </row>
</template>

<script lang="luau">
local t = import("mesh.i18n", "t")
local apps_service = require("mesh.apps")
local Launcher = require("@mesh/app-launcher")
hovered_index = 0

apps = {}

effect(function()
    local list = {}
    if apps_service.available then
        for index, app in apps_service.apps do
            list[#list + 1] = {
                id = app.id,
                index = index,
                hovered = hovered_index == index,
                neighbor = hovered_index > 0 and math.abs(hovered_index - index) == 1,
                name = app.name,
                icon = app.icon,
                has_file = string.sub(app.icon or "", 1, 1) == "/",
                running = app.running,
                focused = app.focused,
            }
        end
    end
    apps = list
end)

function onHover(index) hovered_index = index end
function onLeave() hovered_index = 0 end
function onRadial() mesh.shell.toggle_surface("@mesh/radial-launcher") end

function onActivate(id)
    apps_service.activate(id)
end
</script>

<style>
    /* The layer surface spans the output's width (bottom anchor); this row
    centers the shelf and seats it on the screen edge. */
    .dock-shell {
        width: 100%;
        padding-top: 24px;
        justify-content: center;
        align-items: flex-end;
        gap: 0;
        background: transparent;
        animation: dock-in 560 cubic-bezier(0.05, 0.7, 0.1, 1) both;
    }

    /* A glass shelf standing on the screen edge: rounded shoulders on top,
    square to the floor, where the flares below curve it into the edge. */
    .dock {
        height: 90px;
        padding: 10px 14px 6px;
        gap: 8px;
        align-items: flex-start;
        border-radius: var(--glass-radius-window) var(--glass-radius-window) 0 0;
        border-width: var(--glass-border-width) var(--glass-border-width) 0 var(--glass-border-width);
        border-color: var(--glass-rim);
        background-image: var(--glass-surface-dock);
        box-shadow: var(--glass-shadow-dock);
        backdrop-filter: var(--glass-backdrop-dock);
    }

    /* Concave feet: squares of the same glass whose upper outer corner is
    scooped out, so the shelf sweeps outward into the floor. */
    .flare {
        width: 30px;
        height: 30px;
        flex-shrink: 0;
        corner-shape: scoop;
        background-image: var(--glass-surface-flare);
        backdrop-filter: var(--glass-backdrop-flare);
    }

    .flare-left {
        border-top-left-radius: var(--glass-radius-window);
    }

    .flare-right {
        border-top-right-radius: var(--glass-radius-window);
    }

    .slot {
        gap: 4px;
        align-items: center;
    }

    /* Each app sits on its own small glass lens, lighter than the shelf; the
    focused app's lens takes the theme accent. */
    .tile {
        width: 64px;
        height: 64px;
        padding: 0;
        justify-content: center;
        align-items: center;
        border-radius: var(--glass-radius-card);
        border: 1px solid transparent;
        /* A colour with any alpha counts as authored; alpha 0 would let the
        theme's opaque `button` fill paint over the glass. */
        background-color: var(--glass-fill-lens);
        background-image: var(--glass-surface-lens);
        box-shadow: var(--glass-shadow-lens);
        backdrop-filter: var(--glass-backdrop-lens);
    }

    .tile-focused,
    .tile-focused:hover {
        background-image: var(--glass-surface-focused);
    }

    .app-icon {
        width: prop(icon_size);
        height: prop(icon_size);
    }

    .app-glyph {
        color: var(--glass-text);
    }

    .dot {
        width: 5px;
        height: 5px;
        border-radius: 999px;
        background: transparent;
        transition-property: background-color, width;
        transition-duration: var(--animation-duration-medium);
        transition-timing-function: var(--animation-curves-bezier-emphasized-decelerate);
    }

    .dot-running {
        background: var(--glass-text);
    }

    @keyframes dock-in {
        0% {
            opacity: 0;
            transform: translateY(56px);
        }
        100% {
            opacity: 1;
            transform: translateY(0px);
        }
    }

    /* Motion: one vocabulary for the whole shell, all from theme tokens.
    Containers brighten their rim; controls scale by
    --animation-scale-hover/-press and ring with the focus token. */

    .dock {
        transition-property: border-color, opacity;
        transition-duration: var(--animation-duration-medium);
        transition-timing-function: var(--animation-curves-bezier-emphasized-decelerate);
    }

    .dock:hover {
        border-color: var(--glass-rim-hover);
    }

    /* The lift is the dock's signature motion: a medium duration on the
    emphasized curve, so the rise and magnification read as movement rather
    than the near-instant jump of the decelerate curve. */
    .tile {
        transform: scale(1);
        transition-property: transform, background-color, border-color, opacity;
        transition-duration: var(--animation-duration-medium);
        transition-timing-function: var(--animation-curves-bezier-emphasized);
    }

    .tile:hover {
        background-image: var(--glass-surface-focused);
        transform: translateY(-12px) scale(1.22);
    }

    .tile:focus-visible {
        transform: translateY(-12px) scale(1.22);
    }

    .tile:active {
        transform: translateY(-6px) scale(0.96);
        transition-duration: var(--animation-duration-fast);
    }
    .tile-neighbor { transform: translateY(-4px) scale(1.08); }
    .tile-hovered { transform: translateY(-12px) scale(1.22); }
    .dot-focused { width: 14px; background: var(--glass-indicator); }
    .launcher-glyph { width: 30px; height: 30px; color: var(--glass-text-heading); }
    .launcher-tile { background-image: var(--glass-surface-control); }
    .dock-divider { width: 1px; height: 44px; margin: 10px 6px; background: var(--glass-rim); }
    @container (max-width: 900px) {
        .tile { width: 50px; height: 54px; border-radius: var(--glass-radius-card); }
        .app-icon { width: 38px; height: 38px; }
        .dock { height: 78px; gap: 5px; padding-inline: 10px; }
    }

    .compact-shelf {
        padding-top: 0;
        margin-bottom: 14px;
        animation: none;
    }

    .compact-dock {
        height: fit;
        padding: 6px;
        gap: 6px;
        align-items: center;
        border: var(--glass-border-width) solid var(--glass-rim);
        border-radius: var(--glass-radius-window);
    }

    .compact-flare { display: none; }
    .compact-tile { width: 44px; height: 44px; border-radius: var(--glass-radius-control); }
    .compact-icon { width: 30px; height: 30px; }
    .compact-glyph { width: 22px; height: 22px; }
    .compact-divider { height: 28px; margin: 0 2px; }
    .compact-slot { gap: 2px; }
    .compact-tile:hover, .compact-tile:focus-visible { transform: scale(1.06); }
    .compact-tile.tile-neighbor { transform: none; }

    .floating-shelf { margin-bottom: 16px; }
    .floating-dock { padding: 10px 14px; gap: 10px; }
    .floating-tile { width: 52px; height: 52px; border-radius: var(--glass-radius-card); }
    .paper-shelf { margin-bottom: 20px; }
    .paper-dock { gap: 2px; box-shadow: none; background: var(--color-surface); }
    .paper-tile { box-shadow: none; }
    .retro-dock { background: var(--color-surface-container); }

    .app-rail {
        width: fit;
        height: fit;
        margin: 0 16px 0 0;
        align-items: flex-start;
        exclusive-zone: none;
    }

    .app-rail-dock {
        width: 74px;
        flex-direction: column;
        padding: 14px 0;
        gap: 8px;
        border: 0;
        border-radius: 37px;
        background: var(--color-inverse-surface);
        box-shadow: none;
        backdrop-filter: none;
    }

    .rail-divider { width: 32px; height: 1px; }
    .rail-tile {
        width: 46px;
        height: 46px;
        border-radius: var(--glass-radius-card);
        background-color: var(--color-on-surface-variant);
        background-image: none;
        box-shadow: none;
        backdrop-filter: none;
    }
    .rail-tile.tile-focused, .rail-tile.launcher-tile { background-color: var(--color-primary); }
    .rail-glyph { color: var(--rail-foreground, var(--color-inverse-on-surface)); }
    .rail-dot.dot-running { background: var(--color-inverse-on-surface); }
    .rail-tile.tile-focused, .rail-tile.launcher-tile { --rail-foreground: var(--color-on-primary); }
</style>
