{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/core/shell/src/shell/service.rs | sed -n '1,80p'; nl -ba crates/core/runtime/scripting/src/context/runtime/host_api.rs | sed -n '110,185p'; nl -ba crates/core/runtime/scripting/src/host_api.rs | sed -n '1,110p'\"","aggregated_output":"     1\tuse super::types::CoreRequest;\n     2\tuse mesh_core_capability::Capability;\n     3\tuse mesh_core_scripting::{OperationRegistry, OperationRejection, PublishedEvent, ScriptState};\n     4\tpub(super) use mesh_core_service::service_name_from_interface;\n     5\tpub(super) use mesh_core_service::service_name_from_interface_cow;\n     6\tuse std::borrow::Borrow;\n     7\tuse std::collections::HashMap;\n     8\tuse std::collections::hash_map::DefaultHasher;\n     9\tuse std::hash::{Hash, Hasher};\n    10\tuse std::sync::{Arc, OnceLock, RwLock};\n    11\t\n    12\t/// Bundle of interned capability values derived from an interface name.\n    13\t///\n    14\t/// The shell does a per-service-event capability check on every component\n    15\t/// runtime. Constructing the three `Capability` values from formatted\n    16\t/// strings showed up in profiling as a hot allocation. This struct lets the\n    17\t/// caller compute them once per interface and pass borrowed refs through\n    18\t/// the inner loop.\n    19\tpub(super) struct ServiceCapabilities {\n    20\t    pub service_name: String,\n    21\t    pub read: Capability,\n    22\t    pub control: Capability,\n    23\t    pub theme: Option<Capability>,\n    24\t    pub locale: Option<Capability>,\n    25\t}\n    26\t\n    27\t/// Get (or build) the interned capability bundle for a given interface.\n    28\t///\n    29\t/// Returns `Arc<ServiceCapabilities>` so the lock is released before the\n    30\t/// caller iterates over runtimes. The set of interfaces is bounded and\n    31\t/// stable in steady state, so the cache does not need eviction.\n    32\tpub(super) fn service_capabilities(interface: &str) -> Arc<ServiceCapabilities> {\n    33\t    static CACHE: OnceLock<RwLock<HashMap<String, Arc<ServiceCapabilities>>>> = OnceLock::new();\n    34\t    let cache = CACHE.get_or_init(|| RwLock::new(HashMap::new()));\n    35\t\n    36\t    if let Ok(guard) = cache.read() {\n    37\t        if let Some(entry) = guard.get(interface) {\n    38\t            return Arc::clone(entry);\n    39\t        }\n    40\t    }\n    41\t\n    42\t    let service_name = service_name_from_interface(interface);\n    43\t    let entry = Arc::new(ServiceCapabilities {\n    44\t        read: Capability::new(format!(\"service.{service_name}.read\")),\n    45\t        control: Capability::new(format!(\"service.{service_name}.control\")),\n    46\t        theme: (interface == \"mesh.theme\").then(|| Capability::new(\"theme.read\")),\n    47\t        locale: (interface == \"mesh.locale\").then(|| Capability::new(\"locale.read\")),\n    48\t        service_name,\n    49\t    });\n    50\t\n    51\t    if let Ok(mut guard) = cache.write() {\n    52\t        guard\n    53\t            .entry(interface.to_string())\n    54\t            .or_insert_with(|| Arc::clone(&entry));\n    55\t    }\n    56\t\n    57\t    entry\n    58\t}\n    59\t\n    60\t/// The host-owned trace of which service last delivered an update.\n    61\tpub(super) fn service_update_metadata(\n    62\t    service_name: &str,\n    63\t    source_module: &str,\n    64\t) -> serde_json::Value {\n    65\t    serde_json::json!({ \"name\": service_name, \"source_module\": source_module })\n    66\t}\n    67\t\n    68\t/// Seed a component's script state with default values before the first\n    69\t/// service update arrives. This prevents template crashes on first render.\n    70\t///\n    71\t/// Prefer [`seed_service_context`] for a live runtime: template expressions are\n    72\t/// Luau closures over the context's `_ENV`, so a value that reaches only\n    73\t/// `ScriptState` is invisible to `{last_service_update.name}`.\n    74\tpub(super) fn seed_service_state(state: &mut ScriptState) {\n    75\t    state.set(\"last_service_update\", service_update_metadata(\"\", \"\"));\n    76\t}\n    77\t\n    78\t/// Seed `last_service_update` into both a context's script state and its `_ENV`.\n    79\tpub(super) fn seed_service_context(\n    80\t    script_ctx: &mut mesh_core_scripting::ScriptContext,\n   110\t        mesh_ui_api\n   111\t            .set(\n   112\t                \"request_redraw\",\n   113\t                self.lua()\n   114\t                    .create_function(move |_lua, ()| {\n   115\t                        pending_redraw.store(true, Ordering::Release);\n   116\t                        Ok(())\n   117\t                    })\n   118\t                    .map_err(lua_err)?,\n   119\t            )\n   120\t            .map_err(lua_err)\n   121\t    }\n   122\t\n   123\t    fn install_locale_api(&mut self, mesh_locale: &Table) -> Result<(), ScriptError> {\n   124\t        let service_context_state = Arc::clone(&self.service_context_state);\n   125\t        mesh_locale\n   126\t            .set(\n   127\t                \"current\",\n   128\t                self.lua()\n   129\t                    .create_function(move |_lua, ()| {\n   130\t                        let locale = {\n   131\t                            let state = service_context_state.lock().unwrap();\n   132\t                            state\n   133\t                                .field(\"locale\", \"locale\")\n   134\t                                .or_else(|| state.field(\"locale\", \"current\"))\n   135\t                        }\n   136\t                        .and_then(|value| value.as_str().map(str::to_owned));\n   137\t                        Ok(locale.unwrap_or_else(|| \"en\".to_string()))\n   138\t                    })\n   139\t                    .map_err(lua_err)?,\n   140\t            )\n   141\t            .map_err(lua_err)?;\n   142\t\n   143\t        let published_events_for_locale = Arc::clone(&self.shared_published_events);\n   144\t        let pending_side_channels_for_locale = Arc::clone(&self.pending_side_channels);\n   145\t        let module_id_for_locale = self.module_id.clone();\n   146\t        let capabilities_for_locale = self.capabilities.clone();\n   147\t        mesh_locale\n   148\t            .set(\n   149\t                \"set\",\n   150\t                self.lua()\n   151\t                    .create_function(move |_lua, locale: String| {\n   152\t                        Self::queue_authorized_event(\n   153\t                            &published_events_for_locale,\n   154\t                            &pending_side_channels_for_locale,\n   155\t                            \"shell.set-locale\".to_string(),\n   156\t                            serde_json::json!({ \"locale\": locale }),\n   157\t                            &module_id_for_locale,\n   158\t                            &capabilities_for_locale,\n   159\t                        )\n   160\t                    })\n   161\t                    .map_err(lua_err)?,\n   162\t            )\n   163\t            .map_err(lua_err)\n   164\t    }\n   165\t\n   166\t    fn install_log_api(&mut self, mesh_log: &Table) -> Result<(), ScriptError> {\n   167\t        let module_id = self.module_id.clone();\n   168\t        mesh_log\n   169\t            .set(\n   170\t                \"info\",\n   171\t                self.lua()\n   172\t                    .create_function(move |_lua, message: String| {\n   173\t                        tracing::info!(\"{}: {}\", module_id, message);\n   174\t                        Ok(())\n   175\t                    })\n   176\t                    .map_err(lua_err)?,\n   177\t            )\n   178\t            .map_err(lua_err)?;\n   179\t        let module_id = self.module_id.clone();\n   180\t        mesh_log\n   181\t            .set(\n   182\t                \"warn\",\n   183\t                self.lua()\n   184\t                    .create_function(move |_lua, message: String| {\n   185\t                        tracing::warn!(\"{}: {}\", module_id, message);\n     1\t/// Host API injection — exposes MESH subsystems to Luau scripts.\n     2\t///\n     3\t/// This module injects a `mesh` global table into the Luau VM with sub-tables\n     4\t/// for each subsystem the module has capability to access.\n     5\t///\n     6\t/// The injected API:\n     7\t///\n     8\t/// ```text\n     9\t/// require(\"mesh.<service>\") → interface proxy\n    10\t/// require(\"mesh.<service>\").state → active provider latest state table\n    11\t/// mesh.theme.token(name)      → value          (requires theme.read)\n    12\t/// mesh.theme.tokens(group)    → table          (requires theme.read)\n    13\t/// mesh.theme.on_change(cb)    → subscription   (requires theme.read)\n    14\t/// mesh.locale.current()       → string         (requires locale.read)\n    15\t/// mesh.locale.translate(key)  → string         (requires locale.read)\n    16\t/// mesh.locale.set(locale)     → publishes locale change request (requires locale.write)\n    17\t/// mesh.config()               → table          (backend helper; full module settings)\n    18\t/// mesh.exec(program, args)    → table          (backend helper)\n    19\t/// mesh.service.set_poll_interval(ms)           (backend helper)\n    20\t/// mesh.events.subscribe(ch, cb) → subscription\n    21\t/// mesh.events.publish(ch, payload)\n    22\t/// mesh.ui.request_redraw()\n    23\t/// mesh.log(level, msg)\n    24\t/// mesh.log.debug(msg)\n    25\t/// mesh.log.info(msg)\n    26\t/// mesh.log.warn(msg)\n    27\t/// mesh.log.error(msg)\n    28\t/// ```\n    29\tuse mesh_core_capability::{Capability, CapabilitySet};\n    30\tuse mesh_core_service::{InterfaceContract, service_name_from_interface};\n    31\tuse std::collections::HashSet;\n    32\t\n    33\t/// Describes what host APIs should be injected based on capabilities.\n    34\t#[derive(Debug)]\n    35\tpub struct HostApiManifest {\n    36\t    pub has_theme_read: bool,\n    37\t    pub has_locale_read: bool,\n    38\t    pub has_locale_write: bool,\n    39\t    pub interface_capabilities: Vec<String>,\n    40\t    pub service_capabilities: Vec<String>,\n    41\t    pub has_events: bool,\n    42\t}\n    43\t\n    44\timpl HostApiManifest {\n    45\t    /// Build the manifest from a capability set.\n    46\t    pub fn from_capabilities(caps: &CapabilitySet) -> Self {\n    47\t        let has_theme_read = caps.is_granted(&Capability::new(\"theme.read\"));\n    48\t        let has_locale_read = caps.is_granted(&Capability::new(\"locale.read\"));\n    49\t        let has_locale_write = caps.is_granted(&Capability::new(\"locale.write\"));\n    50\t\n    51\t        let mut service_capabilities = Vec::new();\n    52\t        let mut interface_capabilities = Vec::new();\n    53\t        let mut seen_interfaces = HashSet::new();\n    54\t        for cap in caps.granted() {\n    55\t            let id = cap.id();\n    56\t            let Some(service_name) = service_name_from_capability(id) else {\n    57\t                continue;\n    58\t            };\n    59\t            service_capabilities.push(id.to_string());\n    60\t            if seen_interfaces.insert(service_name.to_string()) {\n    61\t                interface_capabilities.push(format!(\"mesh.{service_name}\"));\n    62\t            }\n    63\t        }\n    64\t\n    65\t        Self {\n    66\t            has_theme_read,\n    67\t            has_locale_read,\n    68\t            has_locale_write,\n    69\t            interface_capabilities,\n    70\t            service_capabilities,\n    71\t            has_events: true, // Events are always available.\n    72\t        }\n    73\t    }\n    74\t}\n    75\t\n    76\t/// Creates interface proxy tables for Luau scripts: async service methods\n    77\t/// become callable functions, capability-checked before each call.\n    78\t#[derive(Debug)]\n    79\tpub struct InterfaceProxy;\n    80\t\n    81\timpl InterfaceProxy {\n    82\t    /// Interfaces the module's capabilities reach — `service.audio.read`\n    83\t    /// yields `[\"mesh.audio\"]`.\n    84\t    pub fn available_interfaces(caps: &CapabilitySet) -> Vec<String> {\n    85\t        let mut interfaces = Vec::new();\n    86\t        let mut seen = HashSet::new();\n    87\t        for cap in caps.granted() {\n    88\t            if let Some(service_name) = service_name_from_capability(cap.id())\n    89\t                && seen.insert(service_name.to_string())\n    90\t            {\n    91\t                interfaces.push(format!(\"mesh.{service_name}\"));\n    92\t            }\n    93\t        }\n    94\t        interfaces\n    95\t    }\n    96\t\n    97\t    /// Normalize a short service name or fully-qualified interface name.\n    98\t    pub fn canonical_name(name: &str) -> String {\n    99\t        if name.contains('.') {\n   100\t            name.to_string()\n   101\t        } else {\n   102\t            format!(\"mesh.{name}\")\n   103\t        }\n   104\t    }\n   105\t\n   106\t    /// Whether the capability set can read an interface.\n   107\t    pub fn can_read(caps: &CapabilitySet, interface: &str) -> bool {\n   108\t        if let Some(service_name) = interface.strip_prefix(\"mesh.\") {\n   109\t            return Self::can_read_service(caps, service_name);\n   110\t        }\n","exit_code":0,"status":"completed"}}
