{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"sed -n '1,280p' modules/frontend/theme-selector/src/main.mesh && sed -n '1,210p' modules/frontend/quick-settings/src/main.mesh\"","aggregated_output":"<props>\nblur_enabled:    { type: \"bool\", default: true, label: \"Backdrop blur\" }\nblur_radius:     { type: \"size\", default: \"var(--effect-backdrop-blur-popup-radius)\", label: \"Blur radius\" }\nblur_background: { type: \"color\", default: \"var(--effect-backdrop-blur-popup-background)\", label: \"Frosted background\" }\n</props>\n\n<template>\n    <popover\n        open={open}\n        class=\"theme-float-shell\"\n        aria-label=\"Select theme\"\n        anchor-ref=\"themeButton\"\n        anchor=\"bottom\"\n        gravity=\"bottom\"\n        onpointerenter={onPopoverEnter}\n        onpointerleave={onPopoverLeave}\n    >\n        <BubbleOptions\n            label=\"Select theme\"\n            items={items}\n            rotation={rotation}\n            onselect={onSelectTheme}\n            onscroll={onThemeScroll}\n            onoptionpointerenter={onOptionPointerEnter}\n            onoptionfocus={onOptionFocus}\n            onoptionblur={onOptionBlur}\n            onoptionkeydown={onOptionKeyDown}\n        />\n    </popover>\n</template>\n\n<script lang=\"luau\">\nlocal theme = require(\"mesh.theme\")\nlocal BubbleOptions = require(\"../../shared/components/bubble-options.mesh\")\n\nopen = false\nlocal CLOSE_BRIDGE_KEY = \"theme-popover-close\"\nlocal CLOSE_BRIDGE_DELAY_MS = 400\n\nlocal function cancel_bridge_close()\n    mesh.events.publish(\"shell.cancel-handler\", { key = CLOSE_BRIDGE_KEY })\nend\n\nlocal function schedule_bridge_close()\n    mesh.events.publish(\"shell.schedule-handler\", {\n        key = CLOSE_BRIDGE_KEY,\n        handler = \"closeThemePopoverBridge\",\n        delay_ms = CLOSE_BRIDGE_DELAY_MS,\n    })\nend\n\n-- One descriptor per visible slot; BubbleOptions owns its structural classes.\nitems = {}\n\n-- Ring rotation token handed to BubbleOptions; see its `rotation` prop.\nrotation = \"\"\nlocal rotation_tick = 0\n-- Index of the leftmost theme on screen. Three of the installed themes are\n-- visible at a time and scrolling turns the rest through, so adding a theme\n-- costs nothing in popover width.\nlocal VISIBLE_SLOTS = 3\nlocal window_start = 1\nlocal window_centred = false\n-- Whether the pointer is currently over the popover, so focus loss can tell a\n-- keyboard dismissal apart from a click that merely moved focus between bubbles.\nlocal pointer_inside = false\n-- Optimistic selection: the theme this popover asked for, and the theme the\n-- service was reporting when it asked. See `active_theme`.\nlocal pending_theme = nil\nlocal pending_theme_replaced = nil\nlocal theme_changed = nil\n\nlocal THEME_DARK = \"mesh-default-dark\"\nlocal THEME_LIGHT = \"mesh-default-light\"\nlocal THEME_GRUVBOX = \"gruvbox-dark\"\nlocal THEME_NORD = \"nord\"\nlocal THEME_MOCHA = \"catppuccin-mocha\"\nlocal THEME_TOKYO = \"tokyo-night\"\nlocal THEME_SOLARIZED = \"solarized-dark\"\n\ncurrent_theme = THEME_DARK\n\n-- Every installed theme, in ring order. Three of them fit on screen at once and\n-- scrolling turns the rest through; each `core` class carries that theme's own\n-- swatch colours so a bubble previews the palette it applies.\nlocal THEME_OPTIONS = {\n    { id = THEME_DARK, core = \"bubble-option-core-dark\", icon = \"weather-clear-night\" },\n    { id = THEME_LIGHT, core = \"bubble-option-core-light\", icon = \"weather-clear\" },\n    { id = THEME_GRUVBOX, core = \"bubble-option-core-gruvbox\", icon = \"palette\" },\n    { id = THEME_NORD, core = \"bubble-option-core-nord\", icon = \"weather-snow\" },\n    { id = THEME_MOCHA, core = \"bubble-option-core-mocha\", icon = \"palette\" },\n    { id = THEME_TOKYO, core = \"bubble-option-core-tokyo\", icon = \"weather-clear-night\" },\n    { id = THEME_SOLARIZED, core = \"bubble-option-core-solarized\", icon = \"weather-clear\" },\n}\n\nlocal THEME_LABELS = {\n    [THEME_DARK] = \"Default Dark\",\n    [THEME_LIGHT] = \"Default Light\",\n    [THEME_GRUVBOX] = \"Gruvbox\",\n    [THEME_NORD] = \"Nord\",\n    [THEME_MOCHA] = \"Catppuccin Mocha\",\n    [THEME_TOKYO] = \"Tokyo Night\",\n    [THEME_SOLARIZED] = \"Solarized Dark\",\n}\n\n-- The bubble stage routes both the wheel's `scroll` and the trackpad's\n-- `twofingerscroll` here. A wheel sends one event per notch, but a trackpad\n-- sends a continuous stream of small pixel deltas, so stepping the ring per\n-- event would spin it. Trackpad travel accumulates and only spends a notch at\n-- a time; the wheel keeps its one-step-per-event behaviour.\nlocal TWO_FINGER_NOTCH = 40\nlocal two_finger_travel = 0\n\nlocal function scroll_step(event)\n    local delta = event and event.delta or {}\n    local dy = tonumber(delta.y) or 0\n    if event ~= nil and event.type == \"twofingerscroll\" then\n        if dy == 0 then\n            return 0\n        end\n        -- Reversing direction should not first have to pay off travel banked\n        -- the other way, or the ring stalls when the user changes their mind.\n        if (dy > 0) ~= (two_finger_travel > 0) then\n            two_finger_travel = 0\n        end\n        two_finger_travel += dy\n        if math.abs(two_finger_travel) < TWO_FINGER_NOTCH then\n            return 0\n        end\n        local step = two_finger_travel > 0 and 1 or -1\n        two_finger_travel -= step * TWO_FINGER_NOTCH\n        return step\n    end\n    return dy >= 0 and 1 or -1\nend\n\nlocal function build_option(option, current)\n    local core_class = \"bubble-option-core \" .. option.core\n    if option.id == current then\n        core_class = core_class .. \" bubble-option-core-active \" .. option.core .. \"-active\"\n    end\n\n    return {\n        id = option.id,\n        core_class = core_class,\n        icon_class = \"bubble-option-icon\",\n        icon = option.icon,\n        text_class = \"bubble-option-text bubble-option-hidden\",\n        text = \"\",\n        title = THEME_LABELS[option.id],\n        active = option.id == current,\n    }\nend\n\nlocal function normalize_index(index)\n    local count = #THEME_OPTIONS\n    return ((index - 1) % count) + 1\nend\n\nlocal function sync_options(current)\n    local next_items = {}\n    for slot = 1, VISIBLE_SLOTS do\n        local option = THEME_OPTIONS[normalize_index(window_start + slot - 1)]\n        next_items[slot] = build_option(option, current)\n    end\n    items = next_items\nend\n\n-- Put the active theme in the middle slot. Called when the ring is not being\n-- browsed: on first paint and once the popover has closed, so the next open\n-- starts centred rather than wherever the last scroll left it.\nlocal function centre_window_on(theme_id)\n    for index, option in THEME_OPTIONS do\n        if option.id == theme_id then\n            window_start = normalize_index(index - 1)\n            rotation = \"\"\n            return\n        end\n    end\nend\n\nlocal function service_theme()\n    if not theme then\n        return THEME_DARK\n    end\n    return theme.current or theme.theme_id or THEME_DARK\nend\n\n-- Which theme the ring marks as active. Applying a theme is a round trip\n-- through the shell, so a click marks the picked bubble immediately and holds\n-- that mark until the service reports something other than the theme that was\n-- active when the click happened — that is either our own theme arriving or a\n-- change made elsewhere, and both are reasons to stop overriding.\nlocal function active_theme()\n    if pending_theme == nil then\n        return service_theme()\n    end\n    if service_theme() ~= pending_theme_replaced then\n        pending_theme = nil\n        pending_theme_replaced = nil\n        return service_theme()\n    end\n    return pending_theme\nend\n\nlocal function set_current_theme(theme_id)\n    if current_theme == theme_id then\n        return\n    end\n    current_theme = theme_id\n    if theme_changed ~= nil then\n        theme_changed:fire({ theme_id = theme_id })\n    end\nend\n\nfunction init(self)\n    theme_changed = self.ThemeChanged\n    set_current_theme(active_theme())\nend\n\nfunction render(self)\n    local current = active_theme()\n    set_current_theme(current)\n    if not window_centred then\n        window_centred = true\n        centre_window_on(current)\n    end\n    sync_options(current)\nend\n\n-- Selecting a theme does not close the popover: it stays open so the user can\n-- keep choosing. It closes on pointer leave (onPopoverLeave) or, for keyboard\n-- activation, on focus leave.\nfunction onSelectTheme(theme_id)\n    pending_theme_replaced = service_theme()\n    pending_theme = theme_id\n    set_current_theme(theme_id)\n    sync_options(theme_id)\n    mesh.events.publish(\"mesh.theme.set_theme\", { theme_id = theme_id })\nend\n\n-- Scrolling turns the ring one theme at a time, and keeps the popover alive:\n-- browsing the bubbles is a way of choosing, not of leaving.\nfunction onThemeScroll(event)\n    cancel_bridge_close()\n    local step = scroll_step(event)\n    if step == 0 then\n        return\n    end\n    rotation_tick += 1\n    if step > 0 then\n        window_start = normalize_index(window_start + 1)\n        rotation = \"next-\" .. rotation_tick\n    else\n        window_start = normalize_index(window_start - 1)\n        rotation = \"prev-\" .. rotation_tick\n    end\n    sync_options(active_theme())\nend\n\nfunction onPopoverEnter(event)\n    pointer_inside = true\n    cancel_bridge_close()\n    self.PopoverEnter:fire(event)\nend\n\nfunction onPopoverLeave()\n    pointer_inside = false\n    schedule_bridge_close()\n    self.PopoverLeave:fire()\nend\n\nfunction onOptionFocus(event)\n    cancel_bridge_close()\n    self.PopoverEnter:fire(event)\nend\n\nfunction onOptionPointerEnter(event)\n    pointer_inside = true\n    cancel_bridge_close()\n<template>\n  <popover\n    open={open}\n    class=\"qs-shell\"\n    aria-label=\"Quick Settings\"\n    anchor-ref=\"settingsButton\"\n    anchor=\"bottom\"\n    gravity=\"bottom\"\n    onpointerenter={onPopoverEnter}\n    onpointerleave={onPopoverLeave}\n  >\n    <column class=\"qs-panel\">\n\n      <row class=\"qs-header\">\n        <text class=\"qs-title\">Quick Settings</text>\n      </row>\n\n      <row class=\"qs-control-row\">\n        <icon class=\"qs-row-icon\" name=\"{volume_icon}\" size=\"18\" />\n        <slider\n          class=\"qs-slider\"\n          value=\"{volume_percent}\"\n          onchange={onVolumeChange}\n          min=\"0\"\n          max=\"100\"\n          aria-label=\"Volume\"\n        />\n        <text class=\"qs-row-value\">{volume_label}</text>\n      </row>\n\n      <row class=\"qs-control-row\">\n        <icon class=\"qs-row-icon\" name=\"weather-clear\" size=\"18\" />\n        <slider\n          class=\"qs-slider\"\n          value=\"{brightness_level}\"\n          onchange={onBrightnessChange}\n          min=\"0\"\n          max=\"100\"\n          aria-label=\"Brightness\"\n        />\n        <text class=\"qs-row-value\">{brightness_label}</text>\n      </row>\n\n      <separator class=\"qs-sep\" />\n\n      <row class=\"qs-section-row\">\n        <text class=\"qs-section-label\">Theme</text>\n        <row class=\"qs-chip-row\">\n          <button class=\"{theme_dark_class}\" onclick={onThemeDark}><text class=\"qs-chip-text\">Dark</text></button>\n          <button class=\"{theme_light_class}\" onclick={onThemeLight}><text class=\"qs-chip-text\">Light</text></button>\n        </row>\n      </row>\n\n      <row class=\"qs-section-row\">\n        <text class=\"qs-section-label\">Language</text>\n        <row class=\"qs-chip-row\">\n          <button class=\"{lang_en_class}\" onclick={onLangEn}><text class=\"qs-chip-text\">English</text></button>\n          <button class=\"{lang_sk_class}\" onclick={onLangSk}><text class=\"qs-chip-text\">Slovak</text></button>\n        </row>\n      </row>\n\n    </column>\n  </popover>\n</template>\n\n<script lang=\"luau\">\nopen = false\nvolume_percent   = 0\nvolume_label     = \"0%\"\nvolume_icon      = \"audio-volume-muted\"\n\nbrightness_level = 100\nbrightness_label = \"100%\"\n\ntheme_dark_class  = \"qs-chip qs-chip-active\"\ntheme_light_class = \"qs-chip\"\n\nlang_en_class = \"qs-chip qs-chip-active\"\nlang_sk_class = \"qs-chip\"\n\nlocal audio      = require(\"mesh.audio\")\nlocal brightness = require(\"mesh.brightness\")\nlocal theme      = require(\"mesh.theme\")\n\nlocal function volume_icon_for(percent, muted)\n    if muted or percent == 0 then return \"audio-volume-muted\"\n    elseif percent < 34 then return \"audio-volume-low\"\n    elseif percent < 67 then return \"audio-volume-medium\"\n    else return \"audio-volume-high\"\n    end\nend\n\nlocal function sync_volume(percent, muted)\n    volume_percent = percent\n    volume_label   = string.format(\"%d%%\", percent)\n    volume_icon    = volume_icon_for(percent, muted)\nend\n\nlocal function sync_theme(is_dark)\n    if is_dark then\n        theme_dark_class  = \"qs-chip qs-chip-active\"\n        theme_light_class = \"qs-chip\"\n    else\n        theme_dark_class  = \"qs-chip\"\n        theme_light_class = \"qs-chip qs-chip-active\"\n    end\nend\n\nlocal function sync_lang(is_sk)\n    if is_sk then\n        lang_en_class = \"qs-chip\"\n        lang_sk_class = \"qs-chip qs-chip-active\"\n    else\n        lang_en_class = \"qs-chip qs-chip-active\"\n        lang_sk_class = \"qs-chip\"\n    end\nend\n\nfunction render(self)\n    if audio and audio.available then\n        local p = math.max(0, math.min(100, math.floor(tonumber(audio.percent) or 0)))\n        sync_volume(p, audio.muted or false)\n    end\n\n    if brightness and brightness.level ~= nil then\n        brightness_level = math.max(0, math.min(100, math.floor(tonumber(brightness.level) or 100)))\n        brightness_label = string.format(\"%d%%\", brightness_level)\n    end\n\n    if theme then\n        local is_dark = true\n        if theme.is_dark ~= nil then\n            is_dark = theme.is_dark == true\n        elseif theme.current then\n            is_dark = string.find(theme.current, \"dark\", 1, true) ~= nil\n        end\n        sync_theme(is_dark)\n    end\n\n    local locale = mesh.locale.current()\n    local is_sk  = locale == \"sk\" or string.find(locale or \"\", \"sk-\", 1, true) == 1\n    sync_lang(is_sk)\nend\n\nfunction onVolumeChange(event)\n    local val = math.max(0, math.min(100, math.floor(tonumber(event.value) or 0)))\n    sync_volume(val, false)\n    if audio and type(audio.set_volume) == \"function\" then\n        audio.set_volume(\"default\", val)\n    end\nend\n\nfunction onBrightnessChange(event)\n    -- mesh.brightness is optional; without a provider the slider only\n    -- reflects local state and applies nothing.\n    if not brightness then\n        return\n    end\n    local val = math.max(0, math.min(100, math.floor(tonumber(event.value) or 100)))\n    brightness_level = val\n    brightness_label = string.format(\"%d%%\", val)\n    brightness.set(val)\nend\n\nfunction onThemeDark()\n    sync_theme(true)\n    mesh.events.publish(\"mesh.theme.set_theme\", { theme_id = \"mesh-default-dark\" })\nend\n\nfunction onThemeLight()\n    sync_theme(false)\n    mesh.events.publish(\"mesh.theme.set_theme\", { theme_id = \"mesh-default-light\" })\nend\n\nfunction onLangEn()\n    sync_lang(false)\n    mesh.locale.set(\"en\")\nend\n\nfunction onLangSk()\n    sync_lang(true)\n    mesh.locale.set(\"sk\")\nend\n\nfunction onPopoverEnter(event)\n    self.PopoverEnter:fire(event)\nend\n\nfunction onPopoverLeave(event)\n    self.PopoverLeave:fire(event)\nend\n</script>\n\n<style>\n.qs-shell {\n    /* Sized to the bounding box of the panel instead of a hardcoded size —\n    <popover> isn't a container tag, so it needs the fit value explicitly\n    (box/row/column default to it). `fit-content` is not the same thing: it\n    maps to Taffy `auto`, which the surface root's `align-items: stretch`\n    then pins to the *available* width. A promoted popover's first paint has\n    only the 1x1 placeholder to measure against, so `fit-content` collapsed\n    this panel to a 1px sliver and kept it there. */\n    width: fit;\n    height: fit;\n    padding: var(--spacing-xs);\n    background: transparent;\n    opacity: 1;\n    transition: opacity var(--animation-duration-short) var(--animation-curves-bezier-standard);\n}\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"sed -n '520,610p' crates/core/shell/src/shell/discovery.rs && sed -n '1,120p' crates/core/runtime/scripting/src/host_api.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"sed -n '520,610p' crates/core/shell/src/shell/discovery.rs && sed -n '1,120p' crates/core/runtime/scripting/src/host_api.rs\"","aggregated_output":"                    \"uninstall\",\n                    &[(\"module_id\", \"string\"), (\"force\", \"boolean?\")],\n                ),\n            ],\n        ));\n        interfaces.register_contract(builtin_contract(\n            \"mesh.composition\",\n            &[\n                (\"profile_id\", \"string\"),\n                (\"generation\", \"string\"),\n                (\"roots\", \"object[]\"),\n                (\"slots\", \"object[]\"),\n                (\"palette\", \"object[]\"),\n            ],\n            &[\n                (\n                    \"apply_node_slot\",\n                    &[\n                        (\"profile_id\", \"string\"),\n                        (\"root_instance\", \"string\"),\n                        (\"slot\", \"string\"),\n                        (\"nodes\", \"object[]\"),\n                        (\"expected_generation\", \"string\"),\n                    ],\n                ),\n                (\n                    \"reset_node_slot\",\n                    &[\n                        (\"profile_id\", \"string\"),\n                        (\"root_instance\", \"string\"),\n                        (\"slot\", \"string\"),\n                        (\"expected_generation\", \"string\"),\n                    ],\n                ),\n            ],\n        ));\n        interfaces.register(InterfaceProvider {\n            interface: mesh_core_debug::DEBUG_INTERFACE.to_string(),\n            version: Some(\"1.0\".to_string()),\n            base_module: Some(\"@mesh/debug\".to_string()),\n            provider_module: mesh_core_debug::DEBUG_SOURCE_MODULE_ID.to_string(),\n            backend_name: \"Shell\".to_string(),\n            priority: 100,\n        });\n        interfaces.register(InterfaceProvider {\n            interface: \"mesh.theme\".to_string(),\n            version: Some(\"1.0\".to_string()),\n            base_module: Some(\"@mesh/theme-interface\".to_string()),\n            provider_module: \"@mesh/shell\".to_string(),\n            backend_name: \"Shell Theme\".to_string(),\n            priority: 200,\n        });\n        interfaces.register(InterfaceProvider {\n            interface: \"mesh.locale\".to_string(),\n            version: Some(\"1.0\".to_string()),\n            base_module: Some(\"@mesh/locale-interface\".to_string()),\n            provider_module: \"@mesh/shell\".to_string(),\n            backend_name: \"Shell Locale\".to_string(),\n            priority: 200,\n        });\n        interfaces.register(InterfaceProvider {\n            interface: \"mesh.settings\".to_string(),\n            version: Some(\"1.0\".to_string()),\n            base_module: Some(\"@mesh/settings-interface\".to_string()),\n            provider_module: \"@mesh/shell\".to_string(),\n            backend_name: \"Shell Settings Store\".to_string(),\n            priority: 200,\n        });\n        interfaces.register(InterfaceProvider {\n            interface: \"mesh.packages\".to_string(),\n            version: Some(\"1.0\".to_string()),\n            base_module: Some(\"@mesh/packages-interface\".to_string()),\n            provider_module: \"@mesh/shell\".to_string(),\n            backend_name: \"Shell Package Graph\".to_string(),\n            priority: 200,\n        });\n        interfaces.register(InterfaceProvider {\n            interface: \"mesh.composition\".to_string(),\n            version: Some(\"1.0\".to_string()),\n            base_module: Some(\"@mesh/composition-interface\".to_string()),\n            provider_module: \"@mesh/shell\".to_string(),\n            backend_name: \"Shell Composition\".to_string(),\n            priority: 200,\n        });\n\n        let now = std::time::Instant::now();\n\n        Self {\n            config,\n            settings,\n            settings_store,\n/// Host API injection — exposes MESH subsystems to Luau scripts.\n///\n/// This module injects a `mesh` global table into the Luau VM with sub-tables\n/// for each subsystem the module has capability to access.\n///\n/// The injected API:\n///\n/// ```text\n/// require(\"mesh.<service>\") → interface proxy\n/// require(\"mesh.<service>\").state → active provider latest state table\n/// mesh.theme.token(name)      → value          (requires theme.read)\n/// mesh.theme.tokens(group)    → table          (requires theme.read)\n/// mesh.theme.on_change(cb)    → subscription   (requires theme.read)\n/// mesh.locale.current()       → string         (requires locale.read)\n/// mesh.locale.translate(key)  → string         (requires locale.read)\n/// mesh.locale.set(locale)     → publishes locale change request (requires locale.write)\n/// mesh.config()               → table          (backend helper; full module settings)\n/// mesh.exec(program, args)    → table          (backend helper)\n/// mesh.service.set_poll_interval(ms)           (backend helper)\n/// mesh.events.subscribe(ch, cb) → subscription\n/// mesh.events.publish(ch, payload)\n/// mesh.ui.request_redraw()\n/// mesh.log(level, msg)\n/// mesh.log.debug(msg)\n/// mesh.log.info(msg)\n/// mesh.log.warn(msg)\n/// mesh.log.error(msg)\n/// ```\nuse mesh_core_capability::{Capability, CapabilitySet};\nuse mesh_core_service::{InterfaceContract, service_name_from_interface};\nuse std::collections::HashSet;\n\n/// Describes what host APIs should be injected based on capabilities.\n#[derive(Debug)]\npub struct HostApiManifest {\n    pub has_theme_read: bool,\n    pub has_locale_read: bool,\n    pub has_locale_write: bool,\n    pub interface_capabilities: Vec<String>,\n    pub service_capabilities: Vec<String>,\n    pub has_events: bool,\n}\n\nimpl HostApiManifest {\n    /// Build the manifest from a capability set.\n    pub fn from_capabilities(caps: &CapabilitySet) -> Self {\n        let has_theme_read = caps.is_granted(&Capability::new(\"theme.read\"));\n        let has_locale_read = caps.is_granted(&Capability::new(\"locale.read\"));\n        let has_locale_write = caps.is_granted(&Capability::new(\"locale.write\"));\n\n        let mut service_capabilities = Vec::new();\n        let mut interface_capabilities = Vec::new();\n        let mut seen_interfaces = HashSet::new();\n        for cap in caps.granted() {\n            let id = cap.id();\n            let Some(service_name) = service_name_from_capability(id) else {\n                continue;\n            };\n            service_capabilities.push(id.to_string());\n            if seen_interfaces.insert(service_name.to_string()) {\n                interface_capabilities.push(format!(\"mesh.{service_name}\"));\n            }\n        }\n\n        Self {\n            has_theme_read,\n            has_locale_read,\n            has_locale_write,\n            interface_capabilities,\n            service_capabilities,\n            has_events: true, // Events are always available.\n        }\n    }\n}\n\n/// Creates interface proxy tables for Luau scripts: async service methods\n/// become callable functions, capability-checked before each call.\n#[derive(Debug)]\npub struct InterfaceProxy;\n\nimpl InterfaceProxy {\n    /// Interfaces the module's capabilities reach — `service.audio.read`\n    /// yields `[\"mesh.audio\"]`.\n    pub fn available_interfaces(caps: &CapabilitySet) -> Vec<String> {\n        let mut interfaces = Vec::new();\n        let mut seen = HashSet::new();\n        for cap in caps.granted() {\n            if let Some(service_name) = service_name_from_capability(cap.id())\n                && seen.insert(service_name.to_string())\n            {\n                interfaces.push(format!(\"mesh.{service_name}\"));\n            }\n        }\n        interfaces\n    }\n\n    /// Normalize a short service name or fully-qualified interface name.\n    pub fn canonical_name(name: &str) -> String {\n        if name.contains('.') {\n            name.to_string()\n        } else {\n            format!(\"mesh.{name}\")\n        }\n    }\n\n    /// Whether the capability set can read an interface.\n    pub fn can_read(caps: &CapabilitySet, interface: &str) -> bool {\n        if let Some(service_name) = interface.strip_prefix(\"mesh.\") {\n            return Self::can_read_service(caps, service_name);\n        }\n        true\n    }\n\n    /// Whether a context may receive the Rust-owned snapshot for a service.\n    /// Control access implies read access, matching interface resolution.\n    pub fn can_read_service(caps: &CapabilitySet, service_name: &str) -> bool {\n        match service_name {\n            \"theme\" => caps.is_granted(&Capability::new(\"theme.read\")),\n            \"locale\" => caps.is_granted(&Capability::new(\"locale.read\")),\n            _ => {\n","exit_code":0,"status":"completed"}}
