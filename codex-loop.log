"/run/current-system/sw/bin/bash -lc \\\"nl -ba crates/core/runtime/scripting/src/context/runtime/helpers.rs | sed -n '1,230p'\\\"\",\"aggregated_output\":\"     1\\tuse super::super::lookup::lua_value_to_string;\\n     2\\tuse super::super::proxy::create_event_channel;\\n     3\\tuse mesh_core_locale::{CatalogEntry, LocalizedTextResolution};\\n     4\\tuse mlua::{Function, Lua, MultiValue, Table, Value as LuaValue, Variadic};\\n     5\\tuse serde_json::Value;\\n     6\\tuse std::collections::{HashMap, HashSet};\\n     7\\tuse std::sync::{\\n     8\\t    Arc, Mutex,\\n     9\\t    atomic::{AtomicBool, Ordering},\\n    10\\t};\\n    11\\t\\n    12\\tpub(super) fn is_lifecycle_handler(name: &str) -> bool {\\n    13\\t    matches!(name, \\\"init\\\" | \\\"render\\\" | \\\"mount\\\" | \\\"unmount\\\" | \\\"onRender\\\")\\n    14\\t}\\n    15\\t\\n    16\\tpub(super) fn is_proxyable_lua_scalar(value: &LuaValue) -> bool {\\n    17\\t    matches!(\\n    18\\t        value,\\n    19\\t        LuaValue::Boolean(_) | LuaValue::Integer(_) | LuaValue::Number(_) | LuaValue::String(_)\\n    20\\t    )\\n    21\\t}\\n    22\\t\\n    23\\tpub(super) fn lua_scalar_matches_json(lua_value: &LuaValue, json_value: &Value) -> bool {\\n    24\\t    match (lua_value, json_value) {\\n    25\\t        (LuaValue::Boolean(left), Value::Bool(right)) => left == right,\\n    26\\t        (LuaValue::Integer(left), Value::Number(right)) => right.as_i64() == Some(*left),\\n    27\\t        (LuaValue::Number(left), Value::Number(right)) => {\\n    28\\t            right.as_f64().is_some_and(|right| left == &right)\\n    29\\t        }\\n    30\\t        (LuaValue::String(left), Value::String(right)) => left\\n    31\\t            .to_str()\\n    32\\t            .ok()\\n    33\\t            .is_some_and(|left| left.as_ref() == right),\\n    34\\t        _ => false,\\n    35\\t    }\\n    36\\t}\\n    37\\t\\n    38\\tpub(super) fn is_reserved_runtime_hook(name: &str) -> bool {\\n    39\\t    is_lifecycle_handler(name)\\n    40\\t}\\n    41\\t\\n    42\\t/// Gate for the live `bind:this` proxy: hide host internals so only the child's\\n    43\\t/// public values and functions cross the boundary. `denylist` is the child's\\n    44\\t/// `builtin_globals` (`self`, `module`, `mesh`, `require`, the `__mesh_*`\\n    45\\t/// sentinels installed before user script execution).\\n    46\\tpub(super) fn is_denied_binding_key(key: &str, denylist: &HashSet<String>) -> bool {\\n    47\\t    key.starts_with(\\\"__\\\") || is_reserved_runtime_hook(key) || denylist.contains(key)\\n    48\\t}\\n    49\\t\\n    50\\t/// Resolve (or lazily create) a `self.<Event>` channel.\\n    51\\t///\\n    52\\t/// The registry lives on the per-instance `_ENV` table (`scope`) so two\\n    53\\t/// instances of the same component keep independent `self` channels when they\\n    54\\t/// share one thread VM.\\n    55\\tpub(super) fn self_event_channel(\\n    56\\t    lua: &Lua,\\n    57\\t    scope: &Table,\\n    58\\t    event_name: &str,\\n    59\\t) -> mlua::Result<Table> {\\n    60\\t    let registry = match scope.raw_get::<LuaValue>(\\\"__mesh_self_event_channels\\\")? {\\n    61\\t        LuaValue::Table(table) => table,\\n    62\\t        _ => {\\n    63\\t            let table = lua.create_table()?;\\n    64\\t            scope.raw_set(\\\"__mesh_self_event_channels\\\", table.clone())?;\\n    65\\t            table\\n    66\\t        }\\n    67\\t    };\\n    68\\t    match registry.raw_get::<LuaValue>(event_name)? {\\n    69\\t        LuaValue::Table(channel) => Ok(channel),\\n    70\\t        _ => {\\n    71\\t            let channel = create_event_channel(lua, None, None)?;\\n    72\\t            registry.raw_set(event_name, channel.clone())?;\\n    73\\t            Ok(channel)\\n    74\\t        }\\n    75\\t    }\\n    76\\t}\\n    77\\t\\n    78\\t/// Wrap a child's `self.<Event>` channel for a parent holding a live\\n    79\\t/// `bind:this` reference to that child.\\n    80\\t///\\n    81\\t/// The parent subscribes with a closure over its own `_ENV` and the child fires\\n    82\\t/// it synchronously in the shared VM, so the parent's Lua state changes without\\n    83\\t/// the shell dispatching a handler and its Rust-side state would stay stale.\\n    84\\t/// Wrapping each registered callback flags the *parent* as externally accessed\\n    85\\t/// when the callback runs, which is what the post-handler neighbour resync\\n    86\\t/// keys on — the mirror of the wrapper in the proxy's `__index`, which flags\\n    87\\t/// the *child*.\\n    88\\t///\\n    89\\t/// Everything but `on`/`subscribe` falls through to the real channel, so both\\n    90\\t/// sides share one subscriber list. Wrappers are memoized per event name.\\n    91\\tpub(super) fn parent_subscription_channel(\\n    92\\t    lua: &Lua,\\n    93\\t    channel: &Table,\\n    94\\t    wrappers: &Table,\\n    95\\t    event_name: &str,\\n    96\\t    parent_accessed: &Arc<AtomicBool>,\\n    97\\t) -> mlua::Result<Table> {\\n    98\\t    if let LuaValue::Table(existing) = wrappers.raw_get::<LuaValue>(event_name)? {\\n    99\\t        return Ok(existing);\\n   100\\t    }\\n   101\\t\\n   102\\t    let wrapper = lua.create_table()?;\\n   103\\t    let meta = lua.create_table()?;\\n   104\\t    meta.set(\\\"__index\\\", channel.clone())?;\\n   105\\t    wrapper.set_metatable(Some(meta))?;\\n   106\\t\\n   107\\t    let target = channel.clone();\\n   108\\t    let accessed = Arc::clone(parent_accessed);\\n   109\\t    let subscribe = lua.create_function(move |lua, (_wrapper, callback): (Table, Function)| {\\n   110\\t        let accessed = Arc::clone(&accessed);\\n   111\\t        let tracked = lua.create_function(move |_lua, args: Variadic<LuaValue>| {\\n   112\\t            accessed.store(true, Ordering::Release);\\n   113\\t            callback.call::<MultiValue>(args)\\n   114\\t        })?;\\n   115\\t        target\\n   116\\t            .get::<Function>(\\\"subscribe\\\")?\\n   117\\t            .call::<LuaValue>((target.clone(), tracked))\\n   118\\t    })?;\\n   119\\t    wrapper.set(\\\"subscribe\\\", subscribe.clone())?;\\n   120\\t    wrapper.set(\\\"on\\\", subscribe)?;\\n   121\\t\\n   122\\t    wrappers.raw_set(event_name, wrapper.clone())?;\\n   123\\t    Ok(wrapper)\\n   124\\t}\\n   125\\t\\n   126\\tpub(super) fn create_i18n_library(\\n   127\\t    lua: &Lua,\\n   128\\t    translations: Arc<Mutex<HashMap<String, CatalogEntry>>>,\\n   129\\t    locale: Arc<Mutex<String>>,\\n   130\\t) -> mlua::Result<Table> {\\n   131\\t    let exports = lua.create_table()?;\\n   132\\t    exports.set(\\n   133\\t        \\\"t\\\",\\n   134\\t        lua.create_function(move |_lua, (key, values): (LuaValue, Option<Table>)| {\\n   135\\t            let key = match key {\\n   136\\t                LuaValue::String(value) => value.to_str()?.to_string(),\\n   137\\t                other => lua_value_to_string(other),\\n   138\\t            };\\n   139\\t            let mut args = HashMap::new();\\n   140\\t            if let Some(values) = values {\\n   141\\t                for pair in values.pairs::<String, LuaValue>() {\\n   142\\t                    let (name, value) = pair?;\\n   143\\t                    args.insert(name, lua_value_to_string(value));\\n   144\\t                }\\n   145\\t            }\\n   146\\t            let locale = locale.lock().unwrap().clone();\\n   147\\t            let translated = translations\\n   148\\t                .lock()\\n   149\\t                .unwrap()\\n   150\\t                .get(&key)\\n   151\\t                .and_then(|entry| entry.render(&locale, &args))\\n   152\\t                .unwrap_or_else(|| LocalizedTextResolution::missing_marker(&key));\\n   153\\t            Ok(translated)\\n   154\\t        })?,\\n   155\\t    )?;\\n   156\\t    Ok(exports)\\n   157\\t}\\n   158\\t\\n   159\\tpub(super) fn resolve_host_api(mesh: &Table, module: &str) -> mlua::Result<Option<Table>> {\\n   160\\t    if module.contains('@') {\\n   161\\t        return Ok(None);\\n   162\\t    }\\n   163\\t    let Some(api_name) = module.strip_prefix(\\\"mesh.\\\") else {\\n   164\\t        return Ok(None);\\n   165\\t    };\\n   166\\t    match api_name {\\n   167\\t        \\\"events\\\" | \\\"ui\\\" | \\\"log\\\" | \\\"popover\\\" | \\\"locale\\\" => mesh.get(api_name).map(Some),\\n   168\\t        _ => Ok(None),\\n   169\\t    }\\n   170\\t}\\n   171\\t\\n   172\\tpub(super) fn is_component_definition_specifier(module: &str) -> bool {\\n   173\\t    module.ends_with(\\\".mesh\\\")\\n   174\\t        || module.starts_with(\\\"./\\\")\\n   175\\t        || module.starts_with(\\\"../\\\")\\n   176\\t        || (module.starts_with(\\\"@\\\") && !module[1..].contains('@'))\\n   177\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n+{\"type\":\"item.started\",\"item\":{\"id\":\"item_31\",\"type\":\"command_execution\",\"command\":\"/run/current-system/sw/bin/bash -lc \\\"nl -ba crates/core/runtime/scripting/src/context/state.rs | sed -n '430,540p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n+{\"type\":\"item.completed\",\"item\":{\"id\":\"item_31\",\"type\":\"command_execution\",\"command\":\"/run/current-system/sw/bin/bash -lc \\\"nl -ba crates/core/runtime/scripting/src/context/state.rs | sed -n '430,540p'\\\"\",\"aggregated_output\":\"   430\\t    fn get_ref<'a>(&'a self, name: &str) -> Option<&'a Value> {\\n   431\\t        if self.proxies.contains_key(name) {\\n   432\\t            return None;\\n   433\\t        }\\n   434\\t        self.variables.get(name).map(Arc::as_ref)\\n   435\\t    }\\n   436\\t\\n   437\\t    fn keys(&self) -> Vec<String> {\\n   438\\t        // Proxies may shadow local variables.\\n   439\\t        let mut keys: Vec<String> = self.variables.keys().cloned().collect();\\n   440\\t        for key in self.proxies.keys() {\\n   441\\t            if !self.variables.contains_key(key) {\\n   442\\t                keys.push(key.clone());\\n   443\\t            }\\n   444\\t        }\\n   445\\t        keys\\n   446\\t    }\\n   447\\t}\\n   448\\t\\n   449\\t// A lightweight proxy that forwards get/set operations to host-provided\\n   450\\t// closures.\\n   451\\tstruct Proxy {\\n   452\\t    getter: Box<dyn Fn() -> Value + Send + Sync + 'static>,\\n   453\\t    setter: Option<Box<dyn Fn(Value) + Send + Sync + 'static>>,\\n   454\\t}\\n   455\\t\\n   456\\timpl Clone for ScriptState {\\n   457\\t    fn clone(&self) -> Self {\\n   458\\t        Self {\\n   459\\t            variables: self.variables.clone(),\\n   460\\t            dirty: self.dirty,\\n   461\\t            proxies: HashMap::new(), // proxies are host-registered and not cloned\\n   462\\t            host_value_fingerprints: self.host_value_fingerprints.clone(),\\n   463\\t            snapshot_generation: self.snapshot_generation,\\n   464\\t            cached_snapshot: Mutex::new(None),\\n   465\\t            mutation_generation: self.mutation_generation,\\n   466\\t        }\\n   467\\t    }\\n   468\\t}\\n   469\\t\\n   470\\timpl fmt::Debug for ScriptState {\\n   471\\t    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\\n   472\\t        f.debug_struct(\\\"ScriptState\\\")\\n   473\\t            .field(\\\"variables\\\", &self.variables)\\n   474\\t            .field(\\\"dirty\\\", &self.dirty)\\n   475\\t            .field(\\\"proxies_count\\\", &self.proxies.len())\\n   476\\t            .finish()\\n   477\\t    }\\n   478\\t}\\n   479\\t\\n   480\\t/// A `VariableStore` that combines script state with locale engine access.\\n   481\\t///\\n   482\\t/// Pass this to `build_preview_tree_with_state` so that template expressions\\n   483\\t/// like `{t(\\\"greeting\\\")}` resolve through the active locale engine.\\n   484\\tpub struct LocaleBoundState<'state, 'locale> {\\n   485\\t    state: &'state ScriptState,\\n   486\\t    translator: ModuleTranslator<'locale>,\\n   487\\t}\\n   488\\t\\n   489\\timpl<'state, 'locale> LocaleBoundState<'state, 'locale> {\\n   490\\t    pub fn new(state: &'state ScriptState, translator: ModuleTranslator<'locale>) -> Self {\\n   491\\t        Self { state, translator }\\n   492\\t    }\\n   493\\t}\\n   494\\t\\n   495\\timpl VariableStore for LocaleBoundState<'_, '_> {\\n   496\\t    fn get(&self, name: &str) -> Option<Value> {\\n   497\\t        self.state.get(name)\\n   498\\t    }\\n   499\\t\\n   500\\t    fn get_ref<'b>(&'b self, name: &str) -> Option<&'b Value> {\\n   501\\t        self.state.get_ref(name)\\n   502\\t    }\\n   503\\t\\n   504\\t    fn keys(&self) -> Vec<String> {\\n   505\\t        self.state.keys()\\n   506\\t    }\\n   507\\t\\n   508\\t    fn translate(&self, key: &str) -> Option<String> {\\n   509\\t        Some(self.translator.resolve(key, None).text)\\n   510\\t    }\\n   511\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n+{\"type\":\"item.started\",\"item\":{\"id\":\"item_32\",\"type\":\"command_execution\",\"command\":\"/run/current-system/sw/bin/bash -lc \\\"nl -ba crates/core/shell/src/shell/runtime/debug.rs | sed -n '1280,1335p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n+{\"type\":\"item.completed\",\"item\":{\"id\":\"item_32\",\"type\":\"command_execution\",\"command\":\"/run/current-system/sw/bin/bash -lc \\\"nl -ba crates/core/shell/src/shell/runtime/debug.rs | sed -n '1280,1335p'\\\"\",\"aggregated_output\":\"  1280\\t        \\\"surface\\\": entry.surface_entrypoint.as_ref().map(|entrypoint| serde_json::json!({\\n  1281\\t            \\\"entrypoint\\\": entrypoint,\\n  1282\\t            \\\"settings_namespace\\\": entry.surface_settings_namespace.as_ref(),\\n  1283\\t            \\\"accessibility_role\\\": entry.surface_accessibility_role.as_ref(),\\n  1284\\t            \\\"accessibility_label\\\": entry.surface_accessibility_label.as_ref(),\\n  1285\\t            \\\"size_policy\\\": entry.surface_size_policy.as_ref(),\\n  1286\\t            \\\"layout_label\\\": entry.surface_layout_label.as_ref(),\\n  1287\\t            \\\"layout_label_key\\\": entry.surface_layout_label_key.as_ref(),\\n  1288\\t            \\\"layout_label_fallback\\\": entry.surface_layout_label_fallback.as_ref(),\\n  1289\\t        })),\\n  1290\\t        \\\"diagnostics\\\": entry.diagnostics,\\n  1291\\t        \\\"health\\\": entry.health,\\n  1292\\t    })\\n  1293\\t}\\n  1294\\t\\n  1295\\tfn sorted_keys<T>(map: &std::collections::HashMap<String, T>) -> Vec<String> {\\n  1296\\t    let mut keys = map.keys().cloned().collect::<Vec<_>>();\\n  1297\\t    keys.sort();\\n  1298\\t    keys\\n  1299\\t}\\n  1300\\t\\n  1301\\tfn resolve_debug_manifest_text(\\n  1302\\t    locale: &mesh_core_locale::LocaleEngine,\\n  1303\\t    module_id: &str,\\n  1304\\t    text: &mesh_core_module::LocalizedText,\\n  1305\\t) -> mesh_core_locale::LocalizedTextResolution {\\n  1306\\t    match text {\\n  1307\\t        mesh_core_module::LocalizedText::Literal(value) => {\\n  1308\\t            mesh_core_locale::LocalizedTextResolution::literal(\\n  1309\\t                module_id,\\n  1310\\t                value,\\n  1311\\t                locale.catalog_snapshot().revision(),\\n  1312\\t            )\\n  1313\\t        }\\n  1314\\t        mesh_core_module::LocalizedText::Translation { key, fallback } => {\\n  1315\\t            let translator = locale.module_translator(module_id);\\n  1316\\t            translator.resolve(key, Some(fallback))\\n  1317\\t        }\\n  1318\\t    }\\n  1319\\t}\\n  1320\\t\\n  1321\\t/// Bounded, order-stable samples for consumers that need an event stream rather\\n  1322\\t/// than aggregate stage summaries. Surface samples are sourced from their\\n  1323\\t/// per-surface buckets so records duplicated into the shell roll-up appear once.\\n  1324\\tfn profiling_stream_json(snapshot: &mesh_core_debug::ProfilingSnapshot) -> serde_json::Value {\\n  1325\\t    let mut samples = Vec::new();\\n  1326\\t    for summary in &snapshot.shell.stages {\\n  1327\\t        samples.extend(\\n  1328\\t            summary\\n  1329\\t                .recent_samples\\n  1330\\t                .iter()\\n  1331\\t                .filter(|sample| sample.surface_id.is_none())\\n  1332\\t                .map(|sample| serde_json::to_value(sample).expect(\\\"profiling sample serializes\\\")),\\n  1333\\t        );\\n  1334\\t    }\\n  1335\\t    for surface in &snapshot.surfaces {\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n+{\"type\":\"item.started\",\"item\":{\"id\":\"item_33\",\"type\":\"command_execution\",\"command\":\"/run/current-system/sw/bin/bash -lc \\\"nl -ba crates/core/foundation/locale/src/lib.rs | sed -n '1210,1450p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n+{\"type\":\"item.completed\",\"item\":{\"id\":\"item_33\",\"type\":\"command_execution\",\"command\":\"/run/current-system/sw/bin/bash -lc \\\"nl -ba crates/core/foundation/locale/src/lib.rs | sed -n '1210,1450p'\\\"\",\"aggregated_output\":\"  1210\\t    let script = locale\\n  1211\\t        .split('-')\\n  1212\\t        .find(|part| part.len() == 4)\\n  1213\\t        .unwrap_or_default();\\n  1214\\t    if matches!(\\n  1215\\t        language,\\n  1216\\t        \\\"ar\\\" | \\\"dv\\\" | \\\"fa\\\" | \\\"he\\\" | \\\"ku\\\" | \\\"ps\\\" | \\\"sd\\\" | \\\"ug\\\" | \\\"ur\\\" | \\\"yi\\\"\\n  1217\\t    ) || matches!(script, \\\"Arab\\\" | \\\"Hebr\\\" | \\\"Nkoo\\\" | \\\"Rohg\\\" | \\\"Syrc\\\" | \\\"Thaa\\\")\\n  1218\\t    {\\n  1219\\t        LocaleDirection::Rtl\\n  1220\\t    } else {\\n  1221\\t        LocaleDirection::Ltr\\n  1222\\t    }\\n  1223\\t}\\n  1224\\t\\n  1225\\t/// Interpolates `{name}` placeholders in one walk, so cost is O(template_len)\\n  1226\\t/// regardless of how many args are supplied.\\n  1227\\tfn interpolate(template: &str, args: &HashMap<String, String>) -> Option<String> {\\n  1228\\t    let mut result = String::with_capacity(template.len());\\n  1229\\t    let mut remaining = template;\\n  1230\\t    while let Some(open) = remaining.find('{') {\\n  1231\\t        result.push_str(&remaining[..open]);\\n  1232\\t        let after_open = &remaining[open + 1..];\\n  1233\\t        if let Some(close) = after_open.find('}') {\\n  1234\\t            let name = &after_open[..close];\\n  1235\\t            match args.get(name) {\\n  1236\\t                Some(value) => result.push_str(value),\\n  1237\\t                None => {\\n  1238\\t                    result.push('{');\\n  1239\\t                    result.push_str(name);\\n  1240\\t                    result.push('}');\\n  1241\\t                }\\n  1242\\t            }\\n  1243\\t            remaining = &after_open[close + 1..];\\n  1244\\t        } else {\\n  1245\\t            result.push_str(&remaining[open..]);\\n  1246\\t            return Some(result);\\n  1247\\t        }\\n  1248\\t    }\\n  1249\\t    result.push_str(remaining);\\n  1250\\t    Some(result)\\n  1251\\t}\\n  1252\\t\\n  1253\\t#[cfg(test)]\\n  1254\\tmod tests {\\n  1255\\t    use super::*;\\n  1256\\t\\n  1257\\t    #[test]\\n  1258\\t    fn basic_translation() {\\n  1259\\t        let mut engine = LocaleEngine::new(\\\"en\\\");\\n  1260\\t        engine.load_core_translations(TranslationSet {\\n  1261\\t            locale: \\\"en\\\".to_string(),\\n  1262\\t            messages: HashMap::from([\\n  1263\\t                (\\\"greeting\\\".to_string(), \\\"Hello, {name}!\\\".to_string()),\\n  1264\\t                (\\\"bye\\\".to_string(), \\\"Goodbye\\\".to_string()),\\n  1265\\t            ]),\\n  1266\\t        });\\n  1267\\t\\n  1268\\t        assert_eq!(engine.core_translator().translate(\\\"bye\\\"), Some(\\\"Goodbye\\\"));\\n  1269\\t\\n  1270\\t        let args = HashMap::from([(\\\"name\\\".to_string(), \\\"World\\\".to_string())]);\\n  1271\\t        assert_eq!(\\n  1272\\t            engine.core_translator().translate_with(\\\"greeting\\\", &args),\\n  1273\\t            Some(\\\"Hello, World!\\\".to_string())\\n  1274\\t        );\\n  1275\\t    }\\n  1276\\t\\n  1277\\t    #[test]\\n  1278\\t    fn fallback_chain() {\\n  1279\\t        let mut engine = LocaleEngine::new(\\\"fr\\\");\\n  1280\\t        engine.load_core_translations(TranslationSet {\\n  1281\\t            locale: \\\"en\\\".to_string(),\\n  1282\\t            messages: HashMap::from([(\\\"ok\\\".to_string(), \\\"OK\\\".to_string())]),\\n  1283\\t        });\\n  1284\\t\\n  1285\\t        assert_eq!(engine.core_translator().translate(\\\"ok\\\"), Some(\\\"OK\\\"));\\n  1286\\t    }\\n  1287\\t\\n  1288\\t    #[test]\\n  1289\\t    fn effective_module_catalog_matches_scoped_lookup_precedence() {\\n  1290\\t        let mut engine = LocaleEngine::with_fallback_locale(\\\"sk\\\", \\\"en\\\");\\n  1291\\t        engine.load_core_translations(TranslationSet {\\n  1292\\t            locale: \\\"sk\\\".to_string(),\\n  1293\\t            messages: HashMap::from([\\n  1294\\t                (\\\"shared\\\".to_string(), \\\"global-sk\\\".to_string()),\\n  1295\\t                (\\\"global\\\".to_string(), \\\"iba-global\\\".to_string()),\\n  1296\\t            ]),\\n  1297\\t        });\\n  1298\\t        engine.load_core_translations(TranslationSet {\\n  1299\\t            locale: \\\"en\\\".to_string(),\\n  1300\\t            messages: HashMap::from([(\\\"shared\\\".to_string(), \\\"global-en\\\".to_string())]),\\n  1301\\t        });\\n  1302\\t        engine.load_module_translations(\\n  1303\\t            \\\"@mesh/example\\\",\\n  1304\\t            TranslationSet {\\n  1305\\t                locale: \\\"en\\\".to_string(),\\n  1306\\t                messages: HashMap::from([(\\\"shared\\\".to_string(), \\\"module-en\\\".to_string())]),\\n  1307\\t            },\\n  1308\\t        );\\n  1309\\t\\n  1310\\t        let translator = engine.module_translator(\\\"@mesh/example\\\");\\n  1311\\t        assert_eq!(translator.translate(\\\"shared\\\"), Some(\\