panel\": { \"props\": { \"global\": { \"density\": \"compact\" } } }\n    84\t                }\n    85\t            }\"#,\n    86\t        )\n    87\t        .unwrap();\n    88\t\n    89\t        let effective = effective_profile_settings(shared.clone(), Some(&profile)).unwrap();\n    90\t        assert_eq!(effective.shell().theme.active, \"mesh-default-dark\");\n    91\t        assert_eq!(\n    92\t            effective.namespace(\"@test/panel\")[\"props\"][\"global\"][\"density\"],\n    93\t            \"compact\"\n    94\t        );\n    95\t        assert_eq!(shared.shell().theme.active, \"mesh-default-light\");\n    96\t    }\n    97\t\n    98\t    #[test]\n    99\t    fn module_prop_updates_preserve_siblings_and_reset_sparsely() {\n   100\t        let mut namespace = serde_json::json!({\n   101\t            \"surface\": { \"anchor\": \"top\" },\n   102\t            \"props\": { \"global\": { \"density\": \"compact\" } }\n   103\t        });\n   104\t\n   105\t        update_module_prop_override(\n   106\t            &mut namespace,\n   107\t            None,\n   108\t            \"blur_enabled\",\n   109\t            Some(serde_json::json!(false)),\n   110\t        );\n   111\t        assert_eq!(\n   112\t            namespace[\"props\"][\"global\"],\n   113\t            serde_json::json!({ \"density\": \"compact\", \"blur_enabled\": false })\n   114\t        );\n   115\t\n   116\t        update_module_prop_override(&mut namespace, None, \"blur_enabled\", None);\n   117\t        update_module_prop_override(&mut namespace, None, \"density\", None);\n   118\t        assert!(namespace.get(\"props\").is_none());\n   119\t        assert_eq!(namespace[\"surface\"][\"anchor\"], serde_json::json!(\"top\"));\n   120\t    }\n   121\t\n   122\t    #[test]\n   123\t    fn instance_prop_updates_preserve_global_values_and_prune_empty_scopes() {\n   124\t        let mut namespace = serde_json::json!({\n   125\t            \"props\": { \"global\": { \"density\": \"compact\" } }\n   126\t        });\n   127\t        update_module_prop_override(\n   128\t            &mut namespace,\n   129\t            Some(\"@test/panel#bottom\"),\n   130\t            \"density\",\n   131\t            Some(serde_json::json!(\"comfortable\")),\n   132\t        );\n   133\t        assert_eq!(\n   134\t            namespace[\"props\"][\"instances\"][\"@test/panel#bottom\"][\"density\"],\n   135\t            \"comfortable\"\n   136\t        );\n   137\t\n   138\t        update_module_prop_override(&mut namespace, Some(\"@test/panel#bottom\"), \"density\", None);\n   139\t        assert!(namespace[\"props\"].get(\"instances\").is_none());\n   140\t        assert_eq!(namespace[\"props\"][\"global\"][\"density\"], \"compact\");\n   141\t    }\n   142\t\n   143\t    #[test]\n   144\t    fn instance_surface_override_is_scoped_to_the_profile_root_key() {\n   145\t        let shared = SettingsStore::from_value(\n   146\t            \"/tmp/shared-settings.json\",\n   147\t            serde_json::json!({ \"@test/panel\": { \"surface\": { \"anchor\": \"top\" } } }),\n   148\t        )\n   149\t        .unwrap();\n   150\t        let profile = ShellProfile::from_json_str(\n   151\t            r#\"{\n   152\t                \"schemaVersion\": 3,\n   153\t                \"roots\": {\n   154\t                    \"@test/panel#bottom\": {\n   155\t                        \"module\": \"@test/panel\",\n   156\t                        \"surface\": { \"anchor\": \"bottom\" }\n   157\t                    }\n   158\t                }\n   159\t            }\"#,\n   160\t        )\n   161\t        .unwrap();\n   162\t\n   163\t        let effective = effective_profile_settings(shared, Some(&profile)).unwrap();\n   164\t        assert_eq!(\n   165\t            effective.namespace(\"@test/panel#bottom\")[\"surface\"][\"anchor\"],\n   166\t            \"bottom\"\n   167\t        );\n   168\t        assert_eq!(\n   169\t            effective.namespace(\"@test/panel#other\")[\"surface\"][\"anchor\"],\n   170\t            \"top\"\n   171\t        );\n   172\t    }\n   173\t}\n   174\t\n   175\tpub(super) struct PendingProfileSwitch {\n   176\t    profile_id: String,\n   177\t    graph: InstalledModuleGraph,\n   178\t    locale: LocaleEngine,\n   179\t    settings: Arc<SettingsStore>,\n   180\t    prepared_theme: Option<(mesh_core_theme::Theme, ThemeWatchState)>,\n   181\t    catalog: FrontendCatalog,\n   182\t    desired_surfaces: HashSet<String>,\n   183\t    desired_providers: HashMap<String, String>,\n   184\t    prepared_frontends: Vec<PreparedProfileFrontend>,\n   185\t    candidate_backends: HashMap<String, BackendRuntimeSlot>,\n   186\t    waiting_backends: HashSet<String>,\n   187\t    candidate_started: HashSet<String>,\n   188\t    candidate_initial_states: HashMap<String, serde_json::Value>,\n   189\t}\n   190\t\n   191\timpl Shell {\n   192\t    pub(in crate::shell) fn profile_candidate_is_pending(\n   193\t        &self,\n   194\t        interface: &str,\n   195\t        provider_id: &str,\n   196\t    ) -> bool {\n   197\t        self.pending_profile_switch\n   198\t            .as_ref()\n   199\t            .and_then(|pending| pending.candidate_backends.get(interface))\n   200\t            .is_some_and(|slot| {\n   201\t                *slot\n   202\t                    .event_provider_id\n   203\t                    .read()\n   204\t                    .unwrap_or_else(|poisoned| poisoned.into_inner())\n   205\t                    == provider_id\n   206\t            })\n   207\t    }\n   208\t\n   209\t    pub(in crate::shell) fn apply_node_slot_edit(\n   210\t        &mut self,\n   500\t            .ok()\n   501\t            .and_then(|metadata| metadata.modified().ok());\n   502\t        self.apply_settings_to_components()?;\n   503\t        self.components_want_render = true;\n   504\t        Ok(VecDeque::new())\n   505\t    }\n   506\t\n   507\t    pub(in crate::shell) fn apply_switch_profile(\n   508\t        &mut self,\n   509\t        profile_id: &str,\n   510\t    ) -> VecDeque<CoreRequest> {\n   511\t        if self.pending_profile_switch.is_some() {\n   512\t            self.reject_profile_switch(\n   513\t                profile_id,\n   514\t                \"another profile switch is already being prepared\".into(),\n   515\t            );\n   516\t            return VecDeque::new();\n   517\t        }\n   518\t        if !self.pending_backend_runtimes.is_empty() {\n   519\t            self.reject_profile_switch(\n   520\t                profile_id,\n   521\t                \"a provider switch is already being prepared\".into(),\n   522\t            );\n   523\t            return VecDeque::new();\n   524\t        }\n   525\t\n   526\t        let graph_path = self.installed_module_graph_path();\n   527\t        let paths = match ProfilePaths::from_root_graph(&graph_path) {\n   528\t            Ok(paths) => paths,\n   529\t            Err(error) => {\n   530\t                self.reject_profile_switch(profile_id, error.to_string());\n   531\t                return VecDeque::new();\n   532\t            }\n   533\t        };\n   534\t        let profile = match paths.load(profile_id) {\n   535\t            Ok(profile) => profile,\n   536\t            Err(error) => {\n   537\t                self.reject_profile_switch(profile_id, error.to_string());\n   538\t                return VecDeque::new();\n   539\t            }\n   540\t        };\n   541\t        let graph = match load_installed_module_graph_for_profile(&graph_path, &profile) {\n   542\t            Ok(graph) => graph,\n   543\t            Err(error) => {\n   544\t                self.reject_profile_switch(profile_id, error.to_string());\n   545\t                return VecDeque::new();\n   546\t            }\n   547\t        };\n   548\t        let shared = match SettingsStore::load() {\n   549\t            Ok(settings) => settings,\n   550\t            Err(error) => {\n   551\t                self.reject_profile_switch(profile_id, error.to_string());\n   552\t                return VecDeque::new();\n   553\t            }\n   554\t        };\n   555\t        let settings = match super::discovery::effective_profile_settings(shared, Some(&profile)) {\n   556\t            Ok(mut settings) => {\n   557\t                if let Err(error) =\n   558\t                    super::discovery::register_graph_settings_schemas(&mut settings, &graph)\n   559\t                {\n   560\t                    self.reject_profile_switch(\n   561\t                        profile_id,\n   562\t                        format!(\"failed to register candidate settings schemas: {error}\"),\n   563\t                    );\n   564\t                    return VecDeque::new();\n   565\t                }\n   566\t                Arc::new(settings)\n   567\t            }\n   568\t            Err(error) => {\n   569\t                self.reject_profile_switch(profile_id, error.to_string());\n   570\t                return VecDeque::new();\n   571\t            }\n   572\t        };\n   573\t\n   574\t        let locale = match self.prepare_locale_for_settings(settings.shell(), &graph) {\n   575\t            Ok(locale) => locale,\n   576\t            Err(error) => {\n   577\t                self.reject_profile_switch(\n   578\t                    profile_id,\n   579\t                    format!(\"candidate locale catalogs are invalid: {error}\"),\n   580\t                );\n   581\t                return VecDeque::new();\n   582\t            }\n   583\t        };\n   584\t\n   585\t        let previous_catalog = self.frontend_catalog.snapshot().catalog;\n   586\t        let catalog = match FrontendCatalog::from_modules_reusing(\n   587\t            &self.modules,\n   588\t            Some(&graph),\n   589\t            Some(&previous_catalog),\n   590\t        ) {\n   591\t            Ok(catalog) => catalog,\n   592\t            Err(error) => {\n   593\t                self.reject_profile_switch(profile_id, error.to_string());\n   594\t                return VecDeque::new();\n   595\t            }\n   596\t        };\n   597\t        let temporary_catalog = FrontendCatalogHandle::from(catalog.clone());\n   598\t        let entries = catalog\n   599\t            .top_level_surfaces()\n   600\t            .into_iter()\n   601\t            .map(|entry| (entry.compiled.manifest.package.id.clone(), entry))\n   602\t            .collect::<HashMap<_, _>>();\n   603\t        let desired_surfaces = profile\n   604\t            .roots\n   605\t            .iter()\n   606\t            .filter(|(_, root)| root.active)\n   607\t            .map(|(instance_id, _)| instance_id.clone())\n   608\t            .collect::<HashSet<_>>();\n   609\t        let existing_surfaces = self\n   610\t            .components\n   611\t            .iter()\n   612\t            .map(|runtime| runtime.surface_id.clone())\n   613\t            .collect::<HashSet<_>>();\n   614\t        let mut prepared_frontends = Vec::new();\n   615\t        for (instance_id, root) in profile.roots.iter().filter(|(_, root)| root.active) {\n   616\t            if existing_surfaces.contains(instance_id) {\n   617\t                continue;\n   618\t            }\n   619\t            let Some(entry) = entries.get(&root.module) else {\n   620\t                self.reject_profile_switch(\n   620\t                self.reject_profile_switch(\n   621\t                    profile_id,\n   622\t                    format!(\"profile root {instance_id} has no mountable frontend entrypoint\"),\n   623\t                );\n   624\t                return VecDeque::new();\n   625\t            };\n   626\t            let mut component = FrontendSurfaceComponent::new(\n   627\t                entry.compiled.clone(),\n   628\t                entry.module_dir.clone(),\n   629\t                temporary_catalog.clone(),\n   630\t                Arc::new(self.interfaces.resolved_catalog()),\n   631\t                settings.clone(),\n   632\t            )\n   633\t            .with_effective_capabilities(self.effective_capabilities.clone())\n   634\t            .with_instance_id(instance_id)\n   635\t            .with_locale_catalog_snapshot(locale.catalog_snapshot());\n   636\t            let diagnostics = self\n   637\t                .diagnostics\n   638\t                .register_instance(root.module.clone(), instance_id.clone());\n   639\t            let mut requests = match component.mount(ComponentContext {\n   640\t                component_id: root.module.clone(),\n   641\t                surface_id: instance_id.clone(),\n   642\t                diagnostics,\n   643\t            }) {\n   644\t                Ok(requests) => VecDeque::from(requests),\n   645\t                Err(error) => {\n   646\t                    self.reject_profile_switch(profile_id, error.to_string());\n   647\t                    return VecDeque::new();\n   648\t                }\n   649\t            };\n   650\t            if let Err(error) = component.locale_changed(&locale) {\n   651\t                self.reject_profile_switch(profile_id, error.to_string());\n   652\t                return VecDeque::new();\n   653\t            }\n   654\t            for state in self.latest_service_state.values() {\n   655\t                let event = ServiceEvent::Updated {\n   656\t                    service: state.interface.clone(),\n   657\t                    source_module: state.provider_id.clone(),\n   658\t                    payload: state.state.clone(),\n   659\t                };\n   660\t                if component.observes_service_event(&event) {\n   661\t                    match component.handle_service_event(&event) {\n   662\t                        Ok(next) => requests.extend(next),\n   663\t                        Err(error) => {\n   664\t                            self.reject_profile_switch(profile_id, error.to_string());\n   665\t                            return VecDeque::new();\n   666\t                        }\n   667\t                    }\n   668\t                }\n   669\t            }\n   670\t            prepared_frontends.push(PreparedProfileFrontend {\n   671\t                component,\n   672\t                requests,\n   673\t            });\n   674\t        }\n   675\t\n   676\t        let (mut candidates, statuses) = backend_launch_candidates_from_graph_with_capabilities(\n   677\t            &graph,\n   678\t            &self.modules,\n   679\t            &settings,\n   680\t            &self.interfaces,\n   681\t            Some(&self.effective_capabilities),\n   682\t        );\n   683\t        if let Some(status) = statuses.iter().find(|status| {\n   684\t            !matches!(\n   685\t                status.status,\n   686\t                \"optional_backend_unavailable\" | \"optional_backend_inactive\"\n   687\t            )\n   688\t        }) {\n   689\t            self.reject_profile_switch(profile_id, status.message.clone());\n   690\t            return VecDeque::new();\n   691\t        }\n   692\t        let theme_changed = self.settings.theme != settings.shell().theme\n   693\t            || self.settings.fonts != settings.shell().fonts;\n   694\t        let prepared_theme = if theme_changed {\n   695\t            if graph.theme_catalog().is_empty() {\n   696\t                let (engine, watch) = load_active_theme(settings.shell());\n   697\t                Some((engine.active().clone(), watch))\n   698\t            } else {\n   699\t                match prepare_theme_for_graph(settings.shell(), &graph) {\n   700\t                    Ok(prepared) => Some(prepared),\n   701\t                    Err(error) => {\n   702\t                        self.reject_profile_switch(\n   703\t                            profile_id,\n   704\t                            format!(\"candidate theme is invalid: {error}\"),\n   705\t                        );\n   706\t                        return VecDeque::new();\n   707\t                    }\n   708\t                }\n   709\t            }\n   710\t        } else {\n   711\t            None\n   712\t        };\n   713\t        let candidate_theme_id = prepared_theme\n   714\t            .as_ref()\n   715\t            .map(|(theme, _)| theme.id.clone())\n   716\t            .unwrap_or_else(|| self.theme.active().id.clone());\n   717\t        for candidate in &mut candidates {\n   718\t            Self::apply_runtime_settings(\n   719\t                candidate,\n   720\t                &candidate_theme_id,\n   721\t                &settings.shell().i18n.locale,\n   722\t            );\n   723\t        }\n   724\t        let desired_providers = candidates\n   725\t            .iter()\n   726\t            .map(|candidate| (candidate.interface.clone(), candidate.module_id.clone()))\n   727\t            .collect::<HashMap<_, _>>();\n   728\t        let current_configs = self\n   729\t            .installed_module_graph\n   730\t            .as_ref()\n   731\t            .map(|current_graph| {\n   732\t                let (mut current, _) = backend_launch_candidates_from_graph_with_capabilities(\n   733\t                    current_graph,\n   734\t                    &self.modules,\n   735\t                    &self.settings_store,\n   736\t                    &self.interfaces,\n   737\t                    Some(&self.effective_capabilities),\n   738\t                );\n   739\t                for candidate in &mut current {\n   740\t                    self.apply_shell_runtime_settings(candidate);\n   741\t                }\n   742\t                current\n   743\t                    .into_iter()\n   744\t                    .map(|candidate| {\n   745\t                        (\n   746\t                            candidate.interface,\n   747\t                            (candidate.module_id, candidate.settings),\n   748\t                        )\n   749\t                    })\n   750\t                    .collect::<HashMap<_, _>>()\n   751\t            })\n   752\t            .unwrap_or_default();\n   753\t        let changed = candidates\n   754\t            .into_iter()\n   755\t            .filter(|candidate| {\n   756\t                let running_matches = self\n   757\t                    .backend_runtimes\n   758\t                    .get(&candidate.interface)\n   759\t                    .is_some_and(|running| running.provider_id == candidate.module_id);\n   760\t                let config_matches = current_configs.get(&candidate.interface).is_some_and(\n   760\t                let config_matches = current_configs.get(&candidate.interface).is_some_and(\n   761\t                    |(provider_id, settings)| {\n   762\t                        provider_id == &candidate.module_id && settings == &candidate.settings\n   763\t                    },\n   764\t                );\n   765\t                !(running_matches && config_matches)\n   766\t            })\n   767\t            .collect::<Vec<_>>();\n   768\t\n   769\t        let mut pending = PendingProfileSwitch {\n   770\t            profile_id: profile_id.to_string(),\n   771\t            graph,\n   772\t            locale,\n   773\t            settings,\n   774\t            prepared_theme,\n   775\t            catalog,\n   776\t            desired_surfaces,\n   777\t            desired_providers,\n   778\t            prepared_frontends,\n   779\t            candidate_backends: HashMap::new(),\n   780\t            waiting_backends: HashSet::new(),\n   781\t            candidate_started: HashSet::new(),\n   782\t            candidate_initial_states: HashMap::new(),\n   783\t        };\n   784\t        if !changed.is_empty() {\n   785\t            let Some(ctx) = self.backend_respawn.clone() else {\n   786\t                self.reject_profile_switch(\n   787\t                    profile_id,\n   788\t                    \"backend runtime is unavailable while candidate providers need preparation\"\n   789\t                        .into(),\n   790\t                );\n   791\t                return VecDeque::new();\n   792\t            };\n   793\t            for candidate in changed {\n   794\t                let interface = candidate.interface.clone();\n   795\t                let event_provider_id = format!(\n   796\t                    \"@mesh/profile-candidate/{}/{}/{}\",\n   797\t                    profile_id, interface, candidate.module_id\n   798\t                );\n   799\t                let slot = self.start_backend_candidate_with_event_id(\n   800\t                    &ctx.handle,\n   801\t                    ctx.tx.clone(),\n   802\t                    candidate,\n   803\t                    ctx.eventfd_fd,\n   804\t                    event_provider_id,\n   805\t                );\n   806\t                pending.waiting_backends.insert(interface.clone());\n   807\t                pending.candidate_backends.insert(interface, slot);\n   808\t            }\n   809\t        }\n   810\t\n   811\t        self.pending_profile_switch = Some(pending);\n   812\t        if self\n   813\t            .pending_profile_switch\n   814\t            .as_ref()\n   815\t            .is_some_and(|pending| pending.waiting_backends.is_empty())\n   816\t        {\n   817\t            return self.commit_pending_profile_switch();\n   818\t        }\n   819\t        tracing::info!(\n   820\t            profile_id,\n   821\t            \"profile candidate prepared; waiting for backend readiness\"\n   822\t        );\n   823\t        VecDeque::new()\n   824\t    }\n   825\t\n   826\t    pub(in crate::shell) fn handle_profile_backend_lifecycle(\n   827\t        &mut self,\n   828\t        interface: &str,\n   829\t        provider_id: &str,\n   830\t        status: BackendRuntimeStatus,\n   831\t    ) -> bool {\n   832\t        let needs_initial_state = self.service_requires_initial_state(interface);\n   833\t        let Some(pending) = self.pending_profile_switch.as_mut() else {\n   834\t            return false;\n   835\t        };\n   836\t        let is_candidate = pending\n   837\t            .candidate_backends\n   838\t            .get(interface)\n   839\t            .is_some_and(|slot| {\n   840\t                *slot\n   841\t                    .event_provider_id\n   842\t                    .read()\n   843\t                    .unwrap_or_else(|poisoned| poisoned.into_inner())\n   844\t                    == provider_id\n   845\t            });\n   846\t        if !is_candidate {\n   847\t            return false;\n   848\t        }\n   849\t        if status == BackendRuntimeStatus::Running {\n   850\t            pending.candidate_started.insert(interface.to_string());\n   851\t            if !needs_initial_state || pending.candidate_initial_states.contains_key(interface) {\n   852\t                pending.waiting_backends.remove(interface);\n   853\t            }\n   854\t            if pending.waiting_backends.is_empty() {\n   855\t                let requests = self.commit_pending_profile_switch();\n   856\t                self.deferred_requests.extend(requests);\n   857\t            }\n   858\t        } else if matches!(\n   859\t            status,\n   860\t            BackendRuntimeStatus::InitFailed\n   861\t                | BackendRuntimeStatus::Failed\n   862\t                | BackendRuntimeStatus::Stopped\n   863\t        ) {\n   864\t            self.abort_pending_profile_switch(format!(\n   865\t                \"provider {provider_id} failed to initialize for {interface}\"\n   866\t            ));\n   867\t        }\n   868\t        true\n   869\t    }\n   870\t\n   871\t    pub(in crate::shell) fn capture_profile_backend_update(\n   872\t        &mut self,\n   873\t        interface: &str,\n   874\t        provider_id: &str,\n   875\t        event: ServiceEvent,\n   876\t    ) -> bool {\n   877\t        let Some(pending) = self.pending_profile_switch.as_ref() else {\n   878\t            return false;\n   879\t        };\n   880\t        let Some(candidate) = pending.candidate_backends.get(interface) else {\n   881\t            return false;\n   882\t        };\n   883\t        let is_candidate = candidate\n   884\t            .event_provider_id\n   885\t            .read()\n   886\t            .unwrap_or_else(|poisoned| poisoned.into_inner())\n   887\t            .as_str()\n   888\t            == provider_id;\n   889\t        if !is_candidate {\n   890\t            return false;\n   891\t        }\n   892\t        let actual_provider_id = candidate.provider_id.clone();\n   893\t        let ServiceEvent::Updated { payload, .. } = self.normalize_service_event(event) else {\n   894\t            return true;\n   895\t        };\n   896\t        if !self.validate_service_state_shape(interface, &actual_provider_id, &payload) {\n   897\t            self.abort_pending_profile_switch(format!(\n   898\t                \"provider {actual_provider_id} emitted an invalid initial service snapshot for {interface}\"\n   899\t            ));\n   900\t            return true;\n   901\t        }\n   902\t        let should_commit = if let Some(pending) = self.pending_profile_switch.as_mut() {\n   903\t            pending\n   904\t                .candidate_initial_states\n   905\t                .insert(interface.to_string(), payload);\n   906\t            if pending.candidate_started.contains(interface) {\n   907\t                pending.waiting_backends.remove(interface);\n   908\t            }\n   909\t            pending.waiting_backends.is_empty()\n   910\t        } else {\n   911\t            false\n   912\t        };\n   913\t        if should_commit {\n   914\t            let requests = self.commit_pending_profile_switch();\n   915\t            self.deferred_requests.extend(requests);\n   916\t        }\n   917\t        tracing::debug!(interface, provider_id, \"buffered prepared profile snapshot\");\n   918\t        true\n   919\t    }\n   920\t\n   921\t    fn commit_pending_profile_switch(&mut self) -> VecDeque<CoreRequest> {\n   922\t        let Some(mut pending) = sel