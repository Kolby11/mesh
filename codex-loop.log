ned);\n    39\t            let fallback = localized\n    40\t                .get(\"fallback\")\n    41\t                .and_then(serde_json::Value::as_str)\n    42\t                .map(str::to_owned);\n    43\t            if let Some(text) = key\n    44\t                .as_deref()\n    45\t                .and_then(|key| translator.translate(key))\n    46\t                .or(fallback.as_deref())\n    47\t            {\n    48\t                *value = serde_json::Value::String(text.to_string());\n    49\t            }\n    50\t        }\n    51\t    }\n    52\t    schema\n    53\t}\n    54\t\n    55\tpub(super) struct PreparedProfileFrontend {\n    56\t    component: FrontendSurfaceComponent,\n    57\t    requests: VecDeque<CoreRequest>,\n    58\t}\n    59\t\n    60\t#[cfg(test)]\n    61\tmod tests {\n    62\t    use super::super::discovery::effective_profile_settings;\n    63\t    use super::update_module_prop_override;\n    64\t    use mesh_core_config::SettingsStore;\n    65\t    use mesh_core_module::package::ShellProfile;\n    66\t\n    67\t    #[test]\n    68\t    fn profile_preferences_layer_over_shared_settings_without_mutating_them() {\n    69\t        let shared = SettingsStore::from_value(\n    70\t            \"/tmp/shared-settings.json\",\n    71\t            serde_json::json!({\n    72\t                \"shell\": { \"theme\": { \"active\": \"mesh-default-light\" } },\n    73\t                \"@test/panel\": { \"props\": { \"global\": { \"density\": \"comfortable\" } } }\n    74\t            }),\n    75\t        )\n    76\t        .unwrap();\n    77\t        let profile = ShellProfile::from_json_str(\n    78\t            r#\"{\n    79\t                \"schemaVersion\": 3,\n    80\t                \"roots\": {},\n    81\t                \"settings\": {\n    82\t                    \"shell\": { \"theme\": { \"active\": \"mesh-default-dark\" } },\n    83\t                    \"@test/panel\": { \"props\": { \"global\": { \"density\": \"compact\" } } }\n    84\t                }\n    85\t            }\"#,\n    86\t        )\n    87\t        .unwrap();\n    88\t\n    89\t        let effective = effective_profile_settings(shared.clone(), Some(&profile)).unwrap();\n    90\t        assert_eq!(effective.shell().theme.active, \"mesh-default-dark\");\n    91\t        assert_eq!(\n    92\t            effective.namespace(\"@test/panel\")[\"props\"][\"global\"][\"density\"],\n    93\t            \"compact\"\n    94\t        );\n    95\t        assert_eq!(shared.shell().theme.active, \"mesh-default-light\");\n    96\t    }\n    97\t\n    98\t    #[test]\n    99\t    fn module_prop_updates_preserve_siblings_and_reset_sparsely() {\n   100\t        let mut namespace = serde_json::json!({\n   101\t            \"surface\": { \"anchor\": \"top\" },\n   102\t            \"props\": { \"global\": { \"density\": \"compact\" } }\n   103\t        });\n   104\t\n   105\t        update_module_prop_override(\n   106\t            &mut namespace,\n   107\t            None,\n   108\t            \"blur_enabled\",\n   109\t            Some(serde_json::json!(false)),\n   110\t        );\n   111\t        assert_eq!(\n   112\t            namespace[\"props\"][\"global\"],\n   113\t            serde_json::json!({ \"density\": \"compact\", \"blur_enabled\": false })\n   114\t        );\n   115\t\n   116\t        update_module_prop_override(&mut namespace, None, \"blur_enabled\", None);\n   117\t        update_module_prop_override(&mut namespace, None, \"density\", None);\n   118\t        assert!(namespace.get(\"props\").is_none());\n   119\t        assert_eq!(namespace[\"surface\"][\"anchor\"], serde_json::json!(\"top\"));\n   120\t    }\n   121\t\n   122\t    #[test]\n   123\t    fn instance_prop_updates_preserve_global_values_and_prune_empty_scopes() {\n   124\t        let mut namespace = serde_json::json!({\n   125\t            \"props\": { \"global\": { \"density\": \"compact\" } }\n   126\t        });\n   127\t        update_module_prop_override(\n   128\t            &mut namespace,\n   129\t            Some(\"@test/panel#bottom\"),\n   130\t            \"density\",\n   131\t            Some(serde_json::json!(\"comfortable\")),\n   132\t        );\n   133\t        assert_eq!(\n   134\t            namespace[\"props\"][\"instances\"][\"@test/panel#bottom\"][\"density\"],\n   135\t            \"comfortable\"\n   136\t        );\n   137\t\n   138\t        update_module_prop_override(&mut namespace, Some(\"@test/panel#bottom\"), \"density\", None);\n   139\t        assert!(namespace[\"props\"].get(\"instances\").is_none());\n   140\t        assert_eq!(namespace[\"props\"][\"global\"][\"density\"], \"compact\");\n   141\t    }\n   142\t\n   143\t    #[test]\n   144\t    fn instance_surface_override_is_scoped_to_the_profile_root_key() {\n   145\t        let shared = SettingsStore::from_value(\n   146\t            \"/tmp/shared-settings.json\",\n   147\t            serde_json::json!({ \"@test/panel\": { \"surface\": { \"anchor\": \"top\" } } }),\n   148\t        )\n   149\t        .unwrap();\n   150\t        let profile = ShellProfile::from_json_str(\n   151\t            r#\"{\n   152\t                \"schemaVersion\": 3,\n   153\t                \"roots\": {\n   154\t                    \"@test/panel#bottom\": {\n   155\t                        \"module\": \"@test/panel\",\n   156\t                        \"surface\": { \"anchor\": \"bottom\" }\n   157\t                    }\n   158\t                }\n   159\t            }\"#,\n   160\t        )\n   161\t        .unwrap();\n   162\t\n   163\t        let effective = effective_profile_settings(shared, Some(&profile)).unwrap();\n   164\t        assert_eq!(\n   165\t            effective.namespace(\"@test/panel#bottom\")[\"surface\"][\"anchor\"],\n   166\t            \"bottom\"\n   167\t        );\n   168\t        assert_eq!(\n   169\t            effective.namespace(\"@test/panel#other\")[\"surface\"][\"anchor\"],\n   170\t            \"top\"\n   171\t        );\n   172\t    }\n   173\t}\n   174\t\n   175\tpub(super) struct PendingProfileSwitch {\n   176\t    profile_id: String,\n   177\t    graph: InstalledModuleGraph,\n   178\t    settings: Arc<SettingsStore>,\n   179\t    prepared_theme: Option<(mesh_core_theme::Theme, ThemeWatchState)>,\n   180\t    catalog: FrontendCatalog,\n   181\t    desired_surfaces: HashSet<String>,\n   182\t    desired_providers: HashMap<String, String>,\n   183\t    prepared_frontends: Vec<PreparedProfileFrontend>,\n   184\t    candidate_backends: HashMap<String, BackendRuntimeSlot>,\n   185\t    waiting_backends: HashSet<String>,\n   186\t    candidate_started: HashSet<String>,\n   187\t    candidate_initial_states: HashMap<String, serde_json::Value>,\n   188\t}\n   189\t\n   190\timpl Shell {\n   191\t    pub(in crate::shell) fn profile_candidate_is_pending(\n   192\t        &self,\n   193\t        interface: &str,\n   194\t        provider_id: &str,\n   195\t    ) -> bool {\n   196\t        self.pending_profile_switch\n   197\t            .as_ref()\n   198\t            .and_then(|pending| pending.candidate_backends.get(interface))\n   199\t            .is_some_and(|slot| {\n   200\t                *slot\n   201\t                    .event_provider_id\n   202\t                    .read()\n   203\t                    .unwrap_or_else(|poisoned| poisoned.into_inner())\n   204\t                    == provider_id\n   205\t            })\n   206\t    }\n   207\t\n   208\t    pub(in crate::shell) fn apply_node_slot_edit(\n   209\t        &mut self,\n   210\t        profile_id: &str,\n   211\t        root_instance: &str,\n   212\t        slot: &str,\n   213\t        nodes: Option<serde_json::Value>,\n   214\t        expected_generation: &str,\n   215\t    ) -> Result<VecDeque<CoreRequest>, ShellRunError> {\n   216\t        if self.pending_profile_switch.is_some() {\n   217\t            return Err(ShellRunError::Package(\n   218\t                \"node edit rejected while a profile switch is pending\".into(),\n   219\t            ));\n   220\t        }\n   220\t        }\n   221\t        let graph_path = self.installed_module_graph_path();\n   222\t        let paths = ProfilePaths::from_root_graph(&graph_path)?;\n   223\t        let mut profile = paths.load(profile_id)?;\n   224\t        let generation = profile_generation(&profile)?;\n   225\t        if generation != expected_generation {\n   226\t            return Err(ShellRunError::Package(format!(\n   227\t                \"node_edit_generation_conflict: expected {expected_generation}, current {generation}\"\n   228\t            )));\n   229\t        }\n   230\t\n   231\t        match nodes {\n   232\t            Some(nodes) => {\n   233\t                let nodes: Vec<ComponentPlacement> =\n   234\t                    serde_json::from_value(nodes).map_err(|error| {\n   235\t                        ShellRunError::Package(format!(\"invalid_node_props: {error}\"))\n   236\t                    })?;\n   237\t                profile\n   238\t                    .node_slots\n   239\t                    .entry(root_instance.to_string())\n   240\t                    .or_default()\n   241\t                    .insert(slot.to_string(), NodeSlotOverride { nodes });\n   242\t            }\n   243\t            None => {\n   244\t                if let Some(slots) = profile.node_slots.get_mut(root_instance) {\n   245\t                    slots.remove(slot);\n   246\t                    if slots.is_empty() {\n   247\t                        profile.node_slots.remove(root_instance);\n   248\t                    }\n   249\t                }\n   250\t            }\n   251\t        }\n   252\t        profile.validate()?;\n   253\t        let candidate = load_installed_module_graph_for_profile(&graph_path, &profile)?;\n   254\t        let previous_catalog = self.frontend_catalog.snapshot().catalog;\n   255\t        FrontendCatalog::from_modules_reusing(\n   256\t            &self.modules,\n   257\t            Some(&candidate),\n   258\t            Some(&previous_catalog),\n   259\t        )?;\n   260\t\n   261\t        paths.save(profile_id, &profile)?;\n   262\t        if self.active_profile_id.as_deref() == Some(profile_id) {\n   263\t            return Ok(self.apply_switch_profile(profile_id));\n   264\t        }\n   265\t        Ok(VecDeque::new())\n   266\t    }\n   267\t\n   268\t    pub(in crate::shell) fn sync_composition_service_state(\n   269\t        &mut self,\n   270\t    ) -> Result<VecDeque<CoreRequest>, ShellRunError> {\n   271\t        let Some(profile_id) = self.active_profile_id.clone() else {\n   272\t            return self.broadcast_service_event(ServiceEvent::Updated {\n   273\t                service: \"mesh.composition\".into(),\n   274\t                source_module: \"@mesh/shell\".into(),\n   275\t                payload: serde_json::json!({\n   276\t                    \"profile_id\": \"\",\n   277\t                    \"generation\": \"\",\n   278\t                    \"roots\": [],\n   279\t                    \"slots\": [],\n   280\t                    \"palette\": [],\n   281\t                }),\n   282\t            });\n   283\t        };\n   284\t        let paths = ProfilePaths::from_root_graph(&self.installed_module_graph_path())?;\n   285\t        let profile_delta = paths.load(&profile_id)?;\n   286\t        let generation = profile_generation(&profile_delta)?;\n   287\t        let graph = self.load_installed_module_graph_cached()?.clone();\n   288\t        let manifests = graph\n   289\t            .modules()\n   290\t            .into_iter()\n   291\t            .map(|module| &module.manifest)\n   292\t            .collect::<Vec<_>>();\n   293\t        let profile =\n   294\t            mesh_core_module::package::resolve_composition(&profile_delta, manifests)?.to_profile();\n   295\t        let catalog = self.frontend_catalog.snapshot().catalog;\n   296\t        let mut roots = Vec::new();\n   297\t        let mut slots = Vec::new();\n   298\t        let mut palette = Vec::new();\n   299\t\n   300\t        for (root_instance, root) in &profile.roots {\n   301\t            roots.push(serde_json::json!({\n   302\t                \"instance\": root_instance,\n   303\t                \"module\": root.module,\n   304\t                \"active\": root.active,\n   305\t            }));\n   306\t            if !root.active {\n   307\t                continue;\n   308\t            }\n   309\t            let Some(host) = catalog.modules.get(&root.module) else {\n   310\t                continue;\n   311\t            };\n   312\t            for descriptor in customizable_slots(&host.compiled.component) {\n   313\t                let Some(point) = descriptor.extension_point.as_deref() else {\n   314\t                    continue;\n   315\t                };\n   316\t                let slot_name = descriptor.name.as_deref().unwrap_or_default();\n   317\t                let hosted = host.compiled.manifest.hosted_extension_points.get(point);\n   318\t                let defaults = hosted\n   319\t                    .and_then(|hosted| hosted.slots.get(slot_name))\n   320\t                    .map(|slot| slot.defaults.clone())\n   321\t                    .unwrap_or_default();\n   322\t                let effective = catalog\n   323\t                    .node_slot_placement(root_instance, slot_name)\n   324\t                    .map(|slot| serde_json::to_value(&slot.nodes))\n   325\t                    .transpose()\n   326\t                    .map_err(|error| ShellRunError::Package(error.to_string()))?\n   327\t                    .unwrap_or_else(|| {\n   328\t                        serde_json::Value::Array(\n   329\t                            defaults\n   330\t                                .iter()\n   331\t                                .enumerate()\n   332\t                                .map(|(index, reference)| {\n   333\t                                    serde_json::json!({\n   334\t                                        \"id\": format!(\"default-{index}\"),\n   335\t                                        \"use\": reference,\n   336\t                                        \"props\": {},\n   337\t                                    })\n   338\t                                })\n   339\t                                .collect(),\n   340\t                        )\n   341\t                    });\n   342\t                slots.push(serde_json::json!({\n   343\t                    \"root_instance\": root_instance,\n   344\t                    \"name\": slot_name,\n   345\t                    \"contract\": point,\n   346\t                    \"layout\": hosted.and_then(|hosted| hosted.layout.clone()).unwrap_or_else(|| \"row\".into()),\n   347\t                    \"max\": hosted.and_then(|hosted| hosted.max),\n   348\t                    \"defaults\": defaults,\n   349\t                    \"nodes\": effective,\n   350\t                    \"overridden\": catalog.node_slot_placement(root_instance, slot_name).is_some(),\n   351\t                }));\n   352\t                for contribution in catalog.extension_point_contributions_for(&root.module, point) {\n   353\t                    let compiled = catalog\n   354\t                        .contribution_entry(\n   355\t                            &contribution.source_module_id,\n   356\t                            &contribution.contribution_id,\n   357\t                        )\n   358\t                        .expect(\"resolved contribution is compiled\");\n   359\t                    let props_schema = mesh_core_component::props_settings_schema(\n   360\t                        compiled.component.props.as_ref(),\n   361\t                    )\n   362\t                    .map(|schema| {\n   363\t                        resolve_component_props_schema(\n   364\t                            schema,\n   365\t                            &self\n   366\t                                .locale\n   367\t                                .module_translator(&contribution.source_module_id),\n   368\t                        )\n   369\t                    });\n   370\t                    palette.push(serde_json::json!({\n   371\t                        \"contract\": point,\n   372\t                        \"use\": format!(\"{}:{}\", contribution.source_module_id, contribution.contribution_id),\n   373\t                        \"module\": contribution.source_module_id,\n   374\t                        \"id\": contribution.contribution_id,\n   375\t                        \"props_schema\": props_schema,\n   376\t                    }));\n   377\t                }\n   378\t            }\n   379\t        }\n   380\t        palette.sort_by(|left, right| left[\"use\"].as_str().cmp(&right[\"use\"].as_str()));\n   381\t        palette.dedup_by(|left, right| left[\"use\"] == right[\"use\"]);\n   382\t\n   383\t        self.broadcast_service_event(ServiceEvent::Updated {\n   384\t            service: \"mesh.composition\".into(),\n   385\t            source_module: \"@mesh/shell\".into(),\n   386\t            payload: serde_json::json!({\n   387\t                \"profile_id\": profile_id,\n   388\t                \"generation\": generation,\n   389\t                \"roots\": roots,\n   390\t                \"slots\": slots,\n   391\t                \"palette\": palette,\n   392\t            }),\n   393\t        })\n   394\t    }\n   395\t\n   396\t    pub(in crate::shell) fn apply_set_module_prop(\n   397\t        &mut self,\n   398\t        module_id: &str,\n   399\t        instance_id: Option<&str>,\n   400\t        prop: &str,\n   401\t        value: Option<serde_json::Value>,\n   402\t    ) -> Result<VecDeque<CoreRequest>, ShellRunError> {\n   403\t        let catalog = self.frontend_catalog.snapshot();\n   404\t        let definition = catalog\n   405\t            .catalog\n   406\t            .module(module_id)\n   407\t            .and_then(|entry| entry.compiled.component.props.as_ref())\n   408\t            .and_then(|block| {\n   409\t                block\n   410\t                    .props\n   411\t                    .iter()\n   412\t                    .find(|definition| definition.name == prop)\n   413\t            })\n   414\t            .filter(|definition| definition.expose)\n   415\t            .cloned()\n   416\t            .ok_or_else(|| ShellRunError::FrontendComposition {\n   417\t                message: format!(\n   418\t                    \"module '{module_id}' does not expose a configurable prop named '{prop}'\"\n   419\t                ),\n   420\t            })?;\n   421\t\n   422\t        if let Some(instance_id) = instance_id\n   423\t            && !self.components.iter().any(|runtime| {\n   424\t                runtime.surface_id == instance_id && runtime.component.id() == module_id\n   425\t            })\n   426\t        {\n   427\t            return Err(ShellRunError::FrontendComposition {\n   428\t                message: format!(\"'{instance_id}' is not a live instance of module '{module_id}'\"),\n   429\t            });\n   430\t        }\n   431\t\n   432\t        let settings_path = instance_id\n   433\t            .map(|id| format!(\"props.instances.{id}\"))\n   434\t            .unwrap_or_else(|| \"props.global\".to_string());\n   435\t\n   436\t        if let Some(value) = value.as_ref() {\n   437\t            let parsed = mesh_core_component::json_to_prop_value_ref(value).ok_or_else(|| {\n   438\t                ShellRunError::FrontendComposition {\n   439\t                    message: format!(\n   440\t                        \"setting {module_id}.{settings_path}.{prop} must be a string, number, or boolean\"\n   441\t                    ),\n   442\t                }\n   443\t            })?;\n   444\t            mesh_core_component::validate_prop_value(&definition, &parsed).map_err(|error| {\n   445\t                ShellRunError::FrontendComposition {\n   446\t                    message: format!(\"invalid setting {module_id}.{settings_path}.{prop}: {error}\"),\n   447\t                }\n   448\t            })?;\n   449\t        }\n   450\t\n   451\t        let effective = if let Some(profile_id) = self.active_profile_id.clone() {\n   452\t            let paths = ProfilePaths::from_root_graph(&self.installed_module_graph_path())?;\n   453\t            let mut profile = paths.load(&profile_id)?;\n   454\t            let namespace = profile\n   455\t                .settings\n   456\t                .entry(module_id.to_string())\n   457\t                .or_insert_with(|| serde_json::json!({}));\n   458\t            update_module_prop_override(namespace, instance_id, prop, value);\n   459\t            if namespace.as_object().is_some_and(serde_json::Map::is_empty) {\n   460\t                profile.settings.remove(module_id);\n   461\t            }\n   462\t            paths.save(&profile_id, &profile)?;\n   463\t            let shared =\n   464\t                SettingsStore::load().map_err(|error| ShellRunError::FrontendComposition {\n   465\t                    message: format!(\"failed to reload shared settings: {error}\"),\n   466\t                })?;\n   467\t            super::discovery::effective_profile_settings(shared, Some(&profile)).map_err(\n   468\t                |error| ShellRunError::FrontendComposition {\n   469\t                    message: format!(\"failed to resolve updated profile settings: {error}\"),\n   470\t                },\n   471\t            )?\n   472\t        } else {\n   473\t            let mut shared =\n   474\t                SettingsStore::load().map_err(|error| ShellRunError::FrontendComposition {\n   475\t                    message: format!(\"failed to load settings for update: {error}\"),\n   476\t                })?;\n   477\t            let mut namespace = shared.namespace(module_id);\n   478\t            update_module_prop_override(&mut namespace, instance_id, prop, value);\n   479\t            shared.set_namespace(module_id, namespace);\n   480\t            shared\n   481\t                .save()\n   482\t                .map_err(|error| ShellRunError::FrontendComposition {\n   483\t                    message: format!(\"failed to save settings: {error}\"),\n   484\t                })?;\n   485\t            shared\n   486\t        };\n   487\t\n   488\t        let mut effective = effective;\n   489\t        if let Some(graph) = self.installed_module_graph.as_ref() {\n   490\t            super::discovery::register_graph_settings_schemas(&mut effective, graph).map_err(\n   491\t                |error| ShellRunError::FrontendComposition {\n   492\t                    message: format!(\"failed to register settings schemas: {error}\"),\n   493\t                },\n   494\t            )?;\n   495\t        }\n   496\t        self.settings_store = Arc::new(effective);\n   497\t        self.settings = self.settings_store.shell().clone();\n   498\t        self.settings_watch.modified_at = std::fs::metadata(&self.settings_watch.path)\n   499\t            .ok()\n   500\t            .and_then(|metadata| metadata.modified().ok());\n   501\t        self.apply_settings_to_components()?;\n   502\t        self.components_want_render = true;\n   503\t        Ok(VecDeque::new())\n   504\t    }\n   505\t\n   506\t    pub(in crate::shell) fn apply_switch_profile(\n   507\t        &mut self,\n   508\t        profile_id: &str,\n   509\t    ) -> VecDeque<CoreRequest> {\n   510\t        if self.pending_profile_switch.is_some() {\n   511\t            self.reject_profile_switch(\n   512\t                profile_id,\n   513\t                \"another profile switch is already being prepared\".into(),\n   514\t            );\n   515\t            return VecDeque::new();\n   516\t        }\n   517\t        if !self.pending_backend_runtimes.is_empty() {\n   518\t            self.reject_profile_switch(\n   519\t                profile_id,\n   520\t                \"a provider switch is already being prepared\".into(),\n   521\t            );\n   522\t            return VecDeque::new();\n   523\t        }\n   524\t\n   525\t        let graph_path = self.installed_module_graph_path();\n   526\t        let paths = match ProfilePaths::from_root_graph(&graph_path) {\n   527\t            Ok(paths) => paths,\n   528\t            Err(error) => {\n   529\t                self.reject_profile_switch(profile_id, error.to_string());\n   530\t                return VecDeque::new();\n   531\t            }\n   532\t        };\n   533\t        let profile = match paths.load(profile_id) {\n   534\t            Ok(profile) => profile,\n   535\t            Err(error) => {\n   536\t                self.reject_profile_switch(profile_id, error.to_string());\n   537\t                return VecDeque::new();\n   538\t            }\n   539\t        };\n   540\t        let graph = match load_installed_module_graph_for_profile(&graph_path, &profile) {\n   541\t            Ok(graph) => graph,\n   542\t            Err(error) => {\n   543\t                self.reject_profile_switch(profile_id, error.to_string());\n   544\t                return VecDeque::new();\n   545\t            }\n   546\t        };\n   547\t        let shared = match SettingsStore::load() {\n   548\t            Ok(settings) => settings,\n   549\t            Err(error) => {\n   550\t                self.reject_profile_switch(profile_id, error.to_string());\n   551\t                return VecDeque::new();\n   552\t            }\n   553\t        };\n   554\t        let settings = match super::discovery::effective_profile_settings(shared, Some(&profile)) {\n   555\t            Ok(mut settings) => {\n   556\t                if let Err(error) =\n   557\t                    super::discovery::register_graph_settings_schemas(&mut settings, &graph)\n   558\t                {\n   559\t                    self.reject_profile_switch(\n   560\t                        profile_id,\n   561\t                        format!(\"failed to register candidate settings sch