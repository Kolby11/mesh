t            .is_some_and(|slot| {\n   827\t                *slot\n   828\t                    .event_provider_id\n   829\t                    .read()\n   830\t                    .unwrap_or_else(|poisoned| poisoned.into_inner())\n   831\t                    == provider_id\n   832\t            });\n   833\t        if !is_candidate {\n   834\t            return false;\n   835\t        }\n   836\t        if status == BackendRuntimeStatus::Running {\n   837\t            pending.candidate_started.insert(interface.to_string());\n   838\t            if !needs_initial_state || pending.candidate_initial_states.contains_key(interface) {\n   839\t                pending.waiting_backends.remove(interface);\n   840\t            }\n   841\t            if pending.waiting_backends.is_empty() {\n   842\t                let requests = self.commit_pending_profile_switch();\n   843\t                self.deferred_requests.extend(requests);\n   844\t            }\n   845\t        } else if matches!(\n   846\t            status,\n   847\t            BackendRuntimeStatus::InitFailed\n   848\t                | BackendRuntimeStatus::Failed\n   849\t                | BackendRuntimeStatus::Stopped\n   850\t        ) {\n   851\t            self.abort_pending_profile_switch(format!(\n   852\t                \"provider {provider_id} failed to initialize for {interface}\"\n   853\t            ));\n   854\t        }\n   855\t        true\n   856\t    }\n   857\t\n   858\t    pub(in crate::shell) fn capture_profile_backend_update(\n   859\t        &mut self,\n   860\t        interface: &str,\n   861\t        provider_id: &str,\n   862\t        event: ServiceEvent,\n   863\t    ) -> bool {\n   864\t        let Some(pending) = self.pending_profile_switch.as_ref() else {\n   865\t            return false;\n   866\t        };\n   867\t        let Some(candidate) = pending.candidate_backends.get(interface) else {\n   868\t            return false;\n   869\t        };\n   870\t        let is_candidate = 