ng(),\n   284\t                role,\n   285\t            })\n   286\t        }\n   287\t        \"shell.toggle-surface\" => event\n   288\t            .payload\n   289\t            .get(\"surface_id\")\n   290\t            .and_then(|v| v.as_str())\n   291\t            .map(|id| CoreRequest::ToggleSurface {\n   292\t                surface_id: id.to_string(),\n   293\t            }),\n   294\t        \"shell.position-surface\" => {\n   295\t            let surface_id = event.payload.get(\"surface_id\").and_then(|v| v.as_str())?;\n   296\t            let margin_top = payload_i32(&event.payload, \"margin_top\")?;\n   297\t            let margin_left = payload_i32(&event.payload, \"margin_left\")?;\n   298\t            Some(CoreRequest::PositionSurface {\n   299\t                surface_id: surface_id.to_string(),\n   300\t                margin_top,\n   301\t                margin_left,\n   302\t            })\n   303\t        }\n   304\t        \"shell.activate-popover\" => {\n   305\t            let surface_id = event.payload.get(\"surface_id\").and_then(|v| v.as_str())?;\n   306\t            let trigger_surface = event\n   307\t                .payload\n   308\t                .get(\"trigger_surface\")\n   309\t                .and_then(|v| v.as_str())?;\n   310\t            let trigger_key = event.payload.get(\"trigger_key\").and_then(|v| v.as_str())?;\n   311\t            let focus = event\n   312\t                .payload\n   313\t                .get(\"focus\")\n   314\t                .and_then(|v| v.as_bool())\n   315\t                .unwrap_or(true);\n   316\t            Some(CoreRequest::ActivatePopover {\n   317\t                surface_id: surface_id.to_string(),\n   318\t                trigger_surface: trigger_surface.to_string(),\n   319\t                trigger_key: trigger_key.to_string(),\n   320\t                focus,\n   321\t            })\n   322\t        }\n   323\t        // Emitted by the `mesh.locale.set` host API, which enforces\n   324\t        // `locale.write` before it publishes. The gate is at that boundary, so\n   325\t        // this arm stays a plain channel rather than becoming a service method\n   326\t        // — a second route in would mean two capability names for one write.\n   327\t        \"shell.set-locale\" => event\n   328\t            .payload\n   329\t            .get(\"locale\")\n   330\t            .and_then(|v| v.as_str())\n   331\t            .map(|locale| CoreRequest::SetLocale {\n   332\t                locale: locale.to_string(),\n   333\t            }),\n   334\t        \"shell.toggle-debug-overlay\" => Some(CoreRequest::ToggleDebugOverlay),\n   335\t        \"shell.toggle-debug-layout-bounds\" => Some(CoreRequest::ToggleDebugLayoutBounds),\n   336\t        \"shell.toggle-debug-element-picker\" => Some(CoreRequest::ToggleDebugElementPicker),\n   337\t        \"shell.open-debug-source\" if event.source_module_id == \"@mesh/debug-inspector\" => {\n   338\t            let path = event.payload.get(\"path\").and_then(|value| value.as_str())?;\n   339\t            let line = event\n   340\t                .payload\n   341\t                .get(\"line\")\n   342\t                .and_then(|value| value.as_u64())\n   343\t                .unwrap_or(1)\n   344\t                .clamp(1, u64::from(u32::MAX)) as u32;\n   345\t            Some(CoreRequest::OpenDebugSource {\n   346\t                path: path.to_string(),\n   347\t                line,\n   348\t            })\n   349\t        }\n   350\t        \"shell.toggle-debug-profiling\" => Some(CoreRequest::ToggleDebugProfiling),\n   850\t                            constraint: PopupConstraint::default(),\n   851\t                            offset: (0, 0),\n   852\t                        },\n   853\t                        grab: false,\n   854\t                        grab_serial: None,\n   855\t                    };\n   856\t                    // Legacy path: this promotes a *separate* popover module's\n   857\t                    // own parent surface into an xdg_popup. The newer model\n   858\t                    // (auto-derived child surfaces from in-tree `<popover open>`\n   859\t                    // nodes of a single component VM) supersedes this; kept for\n   860\t                    // shipped separate-module popovers during the transition.\n   861\t                    if let Some(idx) = self.component_index_for_surface(&surface_id) {\n   862\t                        self.components[idx].parent.popup_parent_surface =\n   863\t                            Some(trigger_surface.clone());\n   864\t                        self.components[idx].parent.popup_config = Some(popup_config);\n   865\t                        self.components[idx].parent.last_popup_size = None;\n   866\t                        self.components[idx].component.set_popup_promoted(true);\n   867\t                    }\n   868\t                    tracing::info!(\n   869\t                        \"ActivatePopover: promoting {surface_id} as xdg_popup child of {trigger_surface} trigger_rect=({anchor_x},{anchor_w}) bar_h={trigger_exclusive_zone}\"\n   870\t                    );\n   871\t                }\n   872\t\n   873\t                let mut emitted = self.sibling_popover_hides(&surface_id, &trigger_surface);\n   874\t                emitted.push_back(CoreRequest::ShowSurface {\n   875\t                    surface_id: surface_id.clone(),\n   876\t                });\n   877\t                if focus && !trigger_surface.is_empty() && !trigger_key.is_empty() {\n   878\t                    emitted.push_back(CoreRequest::TransferTabFocus {\n   879\t                        from_surface: trigger_surface.clone(),\n   880\t                        to_surface: surface_id.clone(),\n   881\t                        target: TabFocusTarget::First,\n   882\t                        return_target: Some((trigger_surface, trigger_key)),\n   883\t                        target_closes_on_leave: true,\n   884\t                        close_source: None,\n   885\t                    });\n   886\t                }\n   887\t                Ok(emitted)\n   888\t            }\n   889\t            CoreRequest::TransferTabFocus {\n   890\t                from_surface,\n   891\t                to_surface,\n   892\t                target,\n   893\t                return_target,\n   894\t                target_closes_on_leave,\n   895\t                close_source,\n   896\t            } => self.apply_transfer_tab_focus(\n   897\t                &from_surface,\n   898\t                &to_surface,\n   899\t                target,\n   900\t                return_target,\n   901\t                target_closes_on_leave,\n   902\t                close_source,\n   903\t            ),\n   904\t            CoreRequest::SetTheme { theme_id } => self.apply_set_theme(&theme_id),\n   905\t            CoreRequest::SetLocale { locale } => self.apply_set_locale(&locale),\n   906\t            CoreRequest::SetIconTheme { theme_id } => self.apply_set_icon_theme(&theme_id),\n   907\t            CoreRequest::SetFontFamily { family } => self.apply_set_font_family(&family),\n   908\t            CoreRequest::SetProvider {\n   909\t                interface,\n   910\t                provider_id,\n   911\t            } => {\n   912\t                self.apply_set_provider(&interface, &provider_id);\n   913\t                Ok(VecDeque::new())\n   914\t            }\n   915\t            CoreRequest::SetModuleEnabled { module_id, enabled } => {\n   916\t                Ok(self.apply_set_module_enabled(&module_id, enabled))\n   917\t            }\n   918\t            CoreRequest::InstallModule {\n   919\t                source,\n   920\t                profile_id,\n   921\t                available_only,\n   922\t                allow_elevated,\n   923\t                allow_high,\n   924\t            } => self.apply_install_module(\n   925\t                &source,\n   926\t                profile_id.as_deref(),\n   927\t   