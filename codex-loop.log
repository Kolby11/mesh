                );\\n    58\\t            }\\n    59\\t        }\\n    60\\t    }\\n    61\\t\\n    62\\t    /// Inject the generic `__shell` context into every backend's settings:\\n    63\\t    /// ambient shell-owned state (active theme, locale) any provider may read\\n    64\\t    /// via `mesh.config().__shell`. This is deliberately service-agnostic —\\n    65\\t    /// core never injects per-interface values.\\n    66\\t    pub(in crate::shell) fn apply_shell_runtime_settings(\\n    67\\t        &self,\\n    68\\t        candidate: &mut BackendLaunchCandidate,\\n    69\\t    ) {\\n    70\\t        Self::apply_runtime_settings(candidate, &self.theme.active().id, self.locale.current());\\n    71\\t    }\\n    72\\t\\n    73\\t    pub(in crate::shell) fn apply_runtime_settings(\\n    74\\t        candidate: &mut BackendLaunchCandidate,\\n    75\\t        theme: &str,\\n    76\\t        locale: &str,\\n    77\\t    ) {\\n    78\\t        let shell_context = serde_json::json!({\\n    79\\t            \\\"theme\\\": theme,\\n    80\\t            \\\"locale\\\": locale,\\n    81\\t        });\\n    82\\t        if let Some(settings) = candidate.settings.as_object_mut() {\\n    83\\t            settings.insert(\\\"__shell\\\".to_string(), shell_context);\\n    84\\t        } else {\\n    85\\t            candidate.settings = serde_json::json!({ \\\"__shell\\\": shell_context });\\n    86\\t        }\\n    87\\t    }\\n    88\\t\\n    89\\t    pub(in crate::shell) fn spawn_backend_candidate(\\n    90\\t        &mut self,\\n    91\\t        runtime: &tokio::runtime::Handle,\\n    92\\t        tx: mpsc::UnboundedSender<ShellMessage>,\\n    93\\t        candidate: BackendLaunchCandidate,\\n    94\\t        eventfd_fd: std::os::unix::io::RawFd,\\n    95\\t    ) {\\n    96\\t        let interface = candidate.interface.clone();\\n    97\\t        let slot = self.start_backend_candidate(runtime, tx, candidate, eventfd_fd);\\n    98\\t        self.replace_backend_runtime(interface, slot);\\n    99\\t    }\\n   100\\t\\n   101\\t    /// Start a backend without publishing it as the active command handler.\\n   102\\t    /// Provider switches use this to keep the old runtime serving until the\\n   103\\t    /// candidate has completed its script initialization.\\n   104\\t    pub(in crate::shell) fn start_backend_candidate(\\n   105\\t        &mut self,\\n   106\\t        runtime: &tokio::runtime::Handle,\\n   107\\t        tx: mpsc::UnboundedSender<ShellMessage>,\\n   108\\t        candidate: BackendLaunchCandidate,\\n   109\\t        eventfd_fd: std::os::unix::io::RawFd,\\n   110\\t    ) -> BackendRuntimeSlot {\\n   111\\t        let event_provider_id = candidate.module_id.clone();\\n   112\\t        self.start_backend_candidate_with_event_id(\\n   113\\t            runtime,\\n   114\\t            tx,\\n   115\\t            candidate,\\n   116\\t            eventfd_fd,\\n   117\\t            event_provider_id,\\n   118\\t        )\\n   119\\t    }\\n   120\\t\\n   121\\t    pub(in crate::shell) fn start_backend_candidate_with_event_id(\\n   122\\t        &mut self,\\n   123\\t        runtime: &tokio::runtime::Handle,\\n   124\\t        tx: mpsc::UnboundedSender<ShellMessage>,\\n   125\\t        candidate: BackendLaunchCandidate,\\n   126\\t        eventfd_fd: std::os::unix::io::RawFd,\\n   127\\t        initial_event_provider_id: String,\\n   128\\t    ) -> BackendRuntimeSlot {\\n   129\\t        if let Some(module) = self.modules.get_mut(&candidate.module_id) {\\n   130\\t            module.clear_quarantine();\\n   131\\t            if let Err(error) = module.mark_loaded() {\\n   132\\t                tracing::debug!(\\n   133\\t                    module_id = candidate.module_id.as_str(),\\n   134\\t                    \\\"backend candidate did not enter loaded state: {error}\\\"\\n   135\\t                );\\n   136\\t            }\\n   137\\t        }\\n   138\\t        let (cmd_tx, cmd_rx) = mpsc::unbounded_channel();\\n   139\\t\\n