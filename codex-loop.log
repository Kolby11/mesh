4\t    append(\"en\");\n  1205\t    chain\n  1206\t}\n  1207\t\n  1208\tfn direction_for(locale: &str) -> LocaleDirection {\n  1209\t    let language = locale.split('-').next().unwrap_or_default();\n  1210\t    let script = locale\n","exit_code":0,"status":"completed"}}
