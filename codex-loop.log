.manifest.mesh.capabilities.required.clone(),\n   473\t                    optional_capabilities: module.manifest.mesh.capabilities.optional.clone(),\n   474\t                    surface_entrypoint: frontend_surface.map(|surface| surface.path.clone()),\n   475\t                    surface_settings_namespace: frontend_surface\n   476\t                        .and_then(|surface| surface.settings_namespace.clone()),\n   477\t                    surface_accessibility_role: frontend_surface\n   478\t                        .and_then(|surface| surface.accessibility.as_ref())\n   479\t                        .and_then(|accessibility| accessibility.role.clone()),\n   480\t                    surface_accessibility_label: frontend_surface\n   481\t                        .and_then(|surface| surface.accessibility.as_ref())\n   482\t                        .and_then(|accessibility| accessibility.label.clone()),\n   483\t                    // Surface sizing is CSS content-measured for every surface\n   484\t                    // now; there is no manifest size-policy to report.\n   485\t                    surface_size_policy: None,\n   486\t                    surface_layout_label: surface_layout_label\n   487\t                        .as_ref()\n   488\t                        .map(|resolved| resolved.text.clone()),\n   489\t                    surface_layout_label_key: surface_layout_label\n   490\t                        .as_ref()\n   491\t                        .and_then(|resolved| resolved.key.clone()),\n   492\t                    surface_layout_label_fallback: surface_layout_label\n   493\t                        .as_ref()\n   494\t                        .and_then(|resolved| resolved.fallback.clone()),\n   495\t                    provides_interfaces,\n   496\t                    provides_interface_labels,\n   497\t                    provides_settings,\n   498\t                    settings_schema: module_settings.map(|settings| settings.schema.clone()),\n   499\t     