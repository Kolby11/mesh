 234\t            let message = format!(\n   235\t                \"cannot select provider {provider_id}: it is not an enabled provider for {interface}\"\n   236\t            );\n   237\t            tracing::warn!(interface, provider_id, \"{message}\");\n   238\t            self.diagnostics.record_lifecycle_error(\n   239\t                \"@mesh/settings\".to_string(),\n   240\t                \"invalid_provider_selection\",\n   241\t                message,\n   242\t            );\n   243\t            return;\n   244\t        };\n   245\t\n   246\t        if self\n   247\t            .pending_backend_runtimes\n   248\t            .get(interface)\n   249\t            .is_some_and(|pending| pending.slot.provider_id == provider_id)\n   250\t        {\n   251\t            tracing::debug!(\n   252\t                interface,\n   253\t                provider_id,\n   254\t                \"backend provider switch is already pending\"\n   255\t            );\n   256\t            return;\n   257\t        }\n   258\t        if self\n   259\t            .backend_runtimes\n   260\t            .get(interface)\n   261\t            .is_some_and(|slot| slot.provider_id == provider_id)\n   262\t        {\n   263\t            if let Some(pending) = self.pending_backend_runtimes.remove(interface) {\n   264\t                pending.slot.task.abort();\n   265\t                self.record_backend_runtime_status(\n   266\t                    pending.slot.interface,\n   267\t                    pending.slot.provider_id,\n   268\t                    BackendRuntimeStatus::Stopped,\n   269\t                    \"provider switch cancelled\".to_string(),\n   270\t                );\n   271\t            }\n   272\t            if graph\n   273\t                .active_provider(interface)\n   274\t                .is_some_and(|active| active.module_id == provider_id)\n   275\t            {\n   276\t                tracing::debug!(interface, provider_id, \"backend provider is already active\");\n   277\t                return;\n   278\t            }\n   279\t            match crate::shell::module_config::write_composed_provider_selection(\n   280\t                &graph_path,\n   281\t                interface,\n   282\t                provider_id,\n   283\t            ) {\n   284\t                Ok(()) => {\n   285\t                    match self.load_installed_module_graph_candidate() {\n   286\t                        Ok(candidate) => self.commit_installed_module_graph(candidate),\n   287\t                        Err(error) => {\n   288\t                            let message = format!(\n   289\t                                \"provider selection for {interface} was saved but the candidate graph could not be loaded: {error}\"\n   290\t                            );\n   291\t                            tracing::warn!(interface, provider_id, \"{message}\");\n   292\t                            self.diagnostics.record_lifecycle_error(\n   293\t                                \"@mesh/settings\".to_string(),\n   294\t                                \"provider_selection_graph_reload_failed\",\n   295\t                                message,\n   296\t                            );\n   297\t                        }\n   298\t                    }\n   299\t                    tracing::info!(\n   300\t                        interface,\n   301\t                        provider_id,\n   302\t                        \"saved selection for the already-running provider\"\n   303\t                    );\n   304\t                }\n   305\t                Err(error) => {\n   306\t                    let message =\n   307\t                        format!(\"failed to save provider {provider_id} for {interface}: {error}\");\n   308\t                    tracing::warn!(interface, provider_id, \"{message}\");\n   309\t                    self.diagnostics.record_lifecycle_error(\n   310\t                        \"@mesh/settings\".to_string(),\n   311\t                        \"provider_selection_write_failed\",\n   312\t                        message,\n   313\t                    );\n   314\t                }\n   315\t            }\n   316\t            return;\n   317\t        }\n   318\t        let Some(ctx) = self.backend_respawn.clone() else {\n   319\t            let message = format!(\n   320\t                \"cannot switch provider {provider_id} for {interface}: backend runtime is unavailable\"\n","exit_code":0,"status":"completed"}}
