{"type":"item.completed","item":{"id":"item_68","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/core/foundation/diagnostics/src/lib.rs | sed -n '130,230p'\"","aggregated_output":"   130\t\n   131\t    /// Record or refresh one stable issue. The code, not the message, is the\n   132\t    /// identity, so changing details updates one row instead of appending a\n   133\t    /// duplicate. The return value is true only when the issue became active.\n   134\t    pub fn record_issue(\n   135\t        &self,\n   136\t        issue_code: impl Into<String>,\n   137\t        severity: IssueSeverity,\n   138\t        message: impl Into<String>,\n   139\t    ) -> bool {\n   140\t        let issue_code = issue_code.into();\n   141\t        let message = message.into();\n   142\t        let now = SystemTime::now();\n   143\t        let mut state = self.state.lock().unwrap();\n   144\t        if let Some(issue) = state.issues.get_mut(&issue_code) {\n   145\t            let newly_active = !issue.active;\n   146\t            let previous_severity = issue.severity;\n   147\t            if newly_active {\n   148\t                issue.severity = severity;\n   149\t            } else {\n   150\t                issue.severity = issue.severity.max(severity);\n   151\t            }\n   152\t            issue.message = message;\n   153\t            issue.last_seen = now;\n   154\t            issue.count = issue.count.saturating_add(1);\n   155\t            issue.active = true;\n   156\t            if issue.severity == IssueSeverity::Error\n   157\t                && (newly_active || previous_severity != IssueSeverity::Error)\n   158\t            {\n   159\t                state.error_count = state.error_count.saturating_add(1);\n   160\t            }\n   161\t            return newly_active;\n   162\t        }\n   163\t\n   164\t        if severity == IssueSeverity::Error {\n   165\t            state.error_count = state.error_count.saturating_add(1);\n   166\t        }\n   167\t        state.issues.insert(\n   168\t            issue_code.clone(),\n   169\t            DiagnosticIssue {\n   170\t                module_id: self.module_id.clone(),\n   171\t                instance_id: self.instance_id.clone(),\n   172\t                issue_code,\n   173\t                severity,\n   174\t                message,\n   175\t                first_seen: now,\n   176\t                last_seen: now,\n   177\t                count: 1,\n   178\t                active: true,\n   179\t            },\n   180\t        );\n   181\t        true\n   182\t    }\n   183\t\n   184\t    pub fn resolve_issue(&self, issue_code: &str) -> bool {\n   185\t        let mut state = self.state.lock().unwrap();\n   186\t        let Some(issue) = state.issues.get_mut(issue_code) else {\n   187\t            return false;\n   188\t        };\n   189\t        if !issue.active {\n   190\t            return false;\n   191\t        }\n   192\t        issue.active = false;\n   193\t        issue.last_seen = SystemTime::now();\n   194\t        true\n   195\t    }\n   196\t\n   197\t    pub fn record_handler_error(\n   198\t        &self,\n   199\t        component_id: impl Into<String>,\n   200\t        handler_name: impl Into<String>,\n   201\t        message: impl Into<String>,\n   202\t    ) -> bool {\n   203\t        let component_id = component_id.into();\n   204\t        let handler_name = handler_name.into();\n   205\t        self.record_issue(\n   206\t            format!(\"handler:{component_id}:{handler_name}\"),\n   207\t            IssueSeverity::Error,\n   208\t            format!(\n   209\t                \"handler '{handler_name}' failed in component '{component_id}': {}\",\n   210\t                message.into()\n   211\t            ),\n   212\t        )\n   213\t    }\n   214\t\n   215\t    pub fn record_missing_icon(\n   216\t        &self,\n   217\t        semantic_name: impl Into<String>,\n   218\t        tried: Vec<String>,\n   219\t    ) -> bool {\n   220\t        let semantic_name = semantic_name.into();\n   221\t        let details = if tried.is_empty() {\n   222\t            \"no configured candidates\".to_string()\n   223\t        } else {\n   224\t            format!(\"tried {}\", tried.join(\", \"))\n   225\t        };\n   226\t        self.record_issue(\n   227\t            format!(\"missing-icon:{semantic_name}\"),\n   228\t            IssueSeverity::Warning,\n   229\t            format!(\n   230\t                \"missing icon '{semantic_name}' for module '{}': {details}\",\n","exit_code":0,"status":"completed"}}
