   }\\n   231\\t    }\\n   232\\t}\\n   233\\t\\n   234\\t/// The source that supplied an effective translation for a module/key pair.\\n   235\\t/// This is retained in the immutable catalog snapshot for `which`/debug\\n   236\\t/// consumers and diagnostics.\\n   237\\t#[derive(Debug, Clone, PartialEq, Eq, Serialize)]\\n   238\\tpub struct CatalogProvenance {\\n   239\\t    pub kind: CatalogSourceKind,\\n   240\\t    pub owner_module_id: String,\\n   241\\t    pub target_module_id: String,\\n   242\\t    pub contribution_id: String,\\n   243\\t    pub locale: String,\\n   244\\t    pub path: PathBuf,\\n   245\\t}\\n   246\\t\\n   247\\t/// The one resolved representation shared by localized metadata and runtime\\n   248\\t/// lookups. `text` is always display-safe: it is the winning translation, the\\n   249\\t/// declared fallback, or the visible `!!key` miss marker. A missing result\\n   250\\t/// retains the owner and catalog snapshot identity so callers can report it\\n   251\\t/// without reconstructing lookup state.\\n   252\\t#[derive(Debug, Clone, PartialEq, Eq, Serialize)]\\n   253\\tpub struct LocalizedTextResolution {\\n   254\\t    pub owner_module_id: String,\\n   255\\t    pub key: Option<String>,\\n   256\\t    pub text: String,\\n   257\\t    pub fallback: Option<String>,\\n   258\\t    pub field_path: Option<String>,\\n   259\\t    pub source: Option<CatalogProvenance>,\\n   260\\t    pub snapshot_revision: u64,\\n   261\\t    pub missing: bool,\\n   262\\t}\\n   263\\t\\n   264\\timpl LocalizedTextResolution {\\n   265\\t    pub fn literal(\\n   266\\t        owner_module_id: impl Into<String>,\\n   267\\t        text: impl Into<String>,\\n   268\\t        revision: u64,\\n   269\\t    ) -> Self {\\n   270\\t        Self {\\n   271\\t            owner_module_id: owner_module_id.into(),\\n   272\\t            key: None,\\n   273\\t            text: text.into(),\\n   274\\t            fallback: None,\\n   275\\t            field_path: None,\\n   27