         .parent()\n    35\t            .ok_or_else(|| package_error(\"root module graph has no parent directory\"))?;\n    36\t        let mut transaction = PackageTransaction::begin(config_dir, \"install\")\n    37\t            .map_err(|error| package_error(error.to_string()))?;\n    38\t        let root = RootModuleGraphManifest::from_path(&graph_path)\n    39\t            .map_err(|error| package_error(error.to_string()))?;\n    40\t        let modules_dir = config_dir.join(&root.modules_dir);\n    41\t        transaction\n    42\t            .protect_package_state(&graph_path, &modules_dir)\n    43\t            .map_err(|error| package_error(error.to_string()))?;\n    44\t        let mut staged = stage_module_source(source, &transaction.staging_dir())?;\n    45\t        let manifest = ModuleManifest::from_path(&staged.path().join(\"module.json\"))\n    46\t            .map_err(|error| package_error(error.to_string()))?;\n    47\t        check_install_capabilities(&manifest, allow_elevated, allow_high)?;\n    48\t        let signature = load_module_signature(staged.path())\n    49\t            .map_err(|error| package_error(error.to_string()))?;\n    50\t        let digest =\n    51\t            module_tree_digest(staged.path()).map_err(|error| package_error(error.to_string()))?;\n    52\t        let trust = if signature.is_some() {\n    53\t            TrustTier::Verified\n    54\t        } else {\n    55\t            TrustTier::for_source(\n    56\t                &manifest.name,\n    57\t                matches!(&staged, StagedModuleSource::Git { .. }),\n    58\t            )\n    59\t        };\n    60\t        if let Err(error) = root.trust_policy.validate_candidate(\n    61\t            &manifest.name,\n    62\t            &manifest.version,\n    63\t            &digest,\n    64\t            trust,\n    65\t            signature.as_ref(),\n    66\t        ) {\n    67\t            return Err(package_error(format!(\n    68\t                \"module {} prove