t            return true;\n   901\t        }\n   902\t        let should_commit = if let Some(pending) = self.pending_profile_switch.as_mut() {\n   903\t            pending\n   904\t                .candidate_initial_states\n   905\t                .insert(interface.to_string(), payload);\n   906\t            if pending.candidate_started.contains(interface) {\n   907\t                pending.waiting_backends.remove(interface);\n   908\t            }\n   909\t            pending.waiting_backends.is_empty()\n   910\t        } else {\n   911\t            false\n   912\t        };\n   913\t        if should_commit {\n   914\t            let requests = self.commit_pending_profile_switch();\n   915\t            self.deferred_requests.extend(requests);\n   916\t        }\n   917\t        tracing::debug!(interface, provider_id, \"buffered prepared profile snapshot\");\n   918\t        true\n   919\t    }\n   920\t\n   921\t    fn commit_pending_profile_switch(&mut self) -> VecDeque<CoreRequest> {\n   922\t        let Some(mut pending) = self.pending_profile_switch.take() else {\n   923\t            return VecDeque::new();\n   924\t        };\n   925\t        let paths = match ProfilePaths::from_root_graph(&self.installed_module_graph_path()) {\n   926\t            Ok(paths) => paths,\n   927\t            Err(error) => {\n   928\t                self.abort_profile_candidate(pending, error.to_string());\n   929\t                return VecDeque::new();\n   930\t            }\n   931\t        };\n   932\t        if let Err(error) = paths.set_active(&pending.profile_id) {\n   933\t            self.abort_profile_candidate(pending, error.to_string());\n   934\t            return VecDeque::new();\n   935\t        }\n   936\t\n   937\t        self.frontend_catalog.replace(pending.catalog, None);\n   938\t        for prepared in &mut pending.prepared_frontends {\n   939\t            prepared\n   940\t                .component\n   941\t                .adopt_frontend_catalog(self.frontend_catalog.clone());\n   942\t        }\n   943\t        for index in (0..self.components.len()).rev() {\n   944\t            if !pending\n   945\t                .desired_surfaces\n   946\t                .contains(&self.components[index].surface_id)\n   947\t            {\n   948\t                self.remove_profile_component(index);\n   949\t            }\n   950\t        }\n   951\t        let mut requests = VecDeque::new();\n   952\t        for prepared in pending.prepared_frontends {\n   953\t            requests.extend(prepared.requests);\n   954\t            self.register_component(Box::new(prepared.component));\n   955\t        }\n   956\t        let initial_states = std::mem::take(&mut pending.candidate_initial_states);\n   957\t        let mut prepared_states = Vec::new();\n   958\t        let mut ready_providers = Vec::new();\n   959\t\n   960\t        let obsolete = self\n   961\t            .backend_runtimes\n   962\t            .keys()\n   963\t            .filter(|interface| !pending.desired_providers.contains_key(*interface))\n   964\t            .cloned()\n   965\t            .collect::<Vec<_>>();\n   966\t        for interface in obsolete {\n   967\t            self.stop_backend_runtime(&interface);\n   968\t        }\n   969\t        for (interface, slot) in pending.candidate_backends {\n   970\t            let initial_state = initial_states.get(&interface).cloned();\n   971\t            let provider_id = slot.provider_id.clone();\n   972\t            *slot\n   973\t                .event_provider_id\n   974\t                .write()\n   975\t                .unwrap_or_else(|poisoned| poisoned.into_inner()) = slot.provider_id.clone();\n   976\t            self.backend_supervision.remove(&interface);\n   977\t            self.replace_backend_runtime(interface.clone(), slot);\n   978\t            self.note_backend_running(&interface);\n   979\t            ready_providers.push((interface.clone(), provider_id.clone()));\n   980\t            if let Some(payload) = initial_state {\n   981\t                prepared_states.push((interface, provider_id, payload));\n   982\t            }\n   983\t        }\n   984\t\n   985\t        let old_theme = self.settings.theme.clone();\n   986\t        let old_fonts = self.settings.fonts.clone();\n   987\t        let old_locale = self.settings.i18n.clone();\n   988\t        let old_locale_catalog_revision = self.locale.catalog_snapshot().revision();\n   989\t        let prepared_theme = pending.prepared_theme.take();\n   990\t        self.settings_store = pending.settings;\n   991\t        self.settings = self.settings_store.shell().clone();\n   992\t        mesh_core_icon::set_default_shell_pack(self.settings.icons.default_pack.clone());\n   993\t        mesh_core_render::set_blur_quality(blur_quality_from_settings(&self.settings.render.blur));\n   994\t        if old_theme != self.settings.theme || old_fonts != self.settings.fonts {\n   995\t            let (theme, watch) = prepared_theme\n   996\t                .map(|(theme, watch)| (self.theme.with_active(theme), watch))\n   997\t                .unwrap_or_else(|| {\n   998\t                    let (theme, watch) = load_active_theme(&self.settings);\n   999\t                    (theme, watch)\n  1000\t                });\n  1001\t            self.theme = theme;\n  1002\t            self.theme_watch = watch;\n  1003\t            if let Err(error) = self.mark_components_theme_changed() {\n  1004\t                tracing::warn!(\"profile theme refresh failed after commit: {error}\");\n  1005\t            }\n  1006\t            if let Ok(next) = self.sync_theme_service_state() {\n  1007\t                requests.extend(next);\n  1008\t            }\n  1009\t        }\n  1010\t        self.locale = pending.locale;\n  1011\t        if old_locale.locale != self.settings.i18n.locale\n  1012\t            || old_locale.fallback_locale != self.settings.i18n.fallback_locale\n  1013\t            || old_locale_catalog_revision != self.locale.catalog_snapshot().revision()\n  1014\t        {\n  1015\t            if let Err(error) = self.mark_components_locale_changed() {\n  1016\t                tracing::warn!(\"profile locale refresh failed after commit: {error}\");\n  1017\t            }\n  1018\t            if let Ok(next) = self.sync_locale_service_state() {\n  1019\t                requests.extend(next);\n  1020\t            }\n  1021\t        }\n  1022\t        if let Err(error) = self.apply_settings_to_components() {\n  1023\t            tracing::warn!(\"profile settings refresh failed after commit: {error}\");\n  1024\t        }\n  1025\t\n  1026\t        self.installed_module_graph = Some(pending.graph);\n  1027\t        self.active_profile_id = Some(pending.profile_id.clone());\n  1028\t        let active_graph = self\n  1029\t            .installed_module_graph\n  1030\t            .as_ref()\n  1031\t            .expect(\"candidate graph was installed\")\n  1032\t            .clone();\n  1033\t        self.register_interfaces_from_graph(&active_graph);\n  1034\t        for (interface, provider_id, payload) in prepared_states {\n  1035\t            let event = ServiceEvent::Updated {\n  1036\t                service: interface,\n  1037\t                source_module: provider_id,\n  1038\t                payload,\n  1039\t            };\n  1040\t            if self.record_latest_service_state(&event) {\n  1041\t                match self.deliver_service_event(&event) {\n  1042\t                    Ok(next) => requests.extend(next),\n  1043\t                    Err(error) => {\n  1044\t                        tracing::warn!(\"failed to deliver prepared profile service state: {error}\")\n  1045\t                    }\n  1046\t                }\n  1047\t            }\n  1048\t        }\n  1049\t        for (interface, provider_id) in ready_providers {\n  1050\t            self.publish_backend_health(\n","exit_code":0,"status":"completed"}}
