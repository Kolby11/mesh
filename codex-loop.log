\t    }\\n  1186\\t    parents\\n  1187\\t}\\n  1188\\t\\n  1189\\tfn complete_fallback_chain(active: &str, fallback: &str) -> Vec<String> {\\n  1190\\t    let mut chain = Vec::new();\\n  1191\\t    let mut append = |locale: &str| {\\n  1192\\t        if !chain.iter().any(|existing| existing == locale) {\\n  1193\\t            chain.push(locale.to_string());\\n  1194\\t        }\\n  1195\\t    };\\n  1196\\t    append(active);\\n  1197\\t    for parent in locale_parents(active) {\\n  1198\\t        append(&parent);\\n  1199\\t    }\\n  1200\\t    append(fallback);\\n  1201\\t    for parent in locale_parents(fallback) {\\n  1202\\t        append(&parent);\\n  1203\\t    }\\n  1204\\t    append(\\\"en\\\");\\n  1205\\t    chain\\n  1206\\t}\\n  1207\\t\\n  1208\\tfn direction_for(locale: &str) -> LocaleDirection {\\n  1209\\t    let language = locale.split('-').next().unwrap_or_default();\\n  1210\\t    let script = locale\\n  1211\\t        .split('-')\\n  1212\\t        .find(|part| part.len() == 4)\\n  1213\\t        .unwrap_or_default();\\n  1214\\t    if matches!(\\n  1215\\t        language,\\n  1216\\t        \\\"ar\\\" | \\\"dv\\\" | \\\"fa\\\" | \\\"he\\\" | \\\"ku\\\" | \\\"ps\\\" | \\\"sd\\\" | \\\"ug\\\" | \\\"ur\\\" | \\\"yi\\\"\\n  1217\\t    ) || matches!(script, \\\"Arab\\\" | \\\"Hebr\\\" | \\\"Nkoo\\\" | \\\"Rohg\\\" | \\\"Syrc\\\" | \\\"Thaa\\\")\\n  1218\\t    {\\n  1219\\t        LocaleDirection::Rtl\\n  1220\\t    } else {\\n  1221\\t        LocaleDirection::Ltr\\n  1222\\t    }\\n  1223\\t}\\n  1224\\t\\n  1225\\t/// Interpolates `{name}` placeholders in one walk, so cost is O(template_len)\\n  1226\\t/// regardless of how many args are supplied.\\n  1227\\tfn interpolate(template: &str, args: &HashMap<String, String>) -> Option<String> {\\n  1228\\t    let mut result = String::with_capacity(template.len());\\n  1229\\t    let mut remaining = template;\\n  1230\\t    while let Some(open) = remaining.find('{') {\\n  1231\\t        result.push_str