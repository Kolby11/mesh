{"type":"item.completed","item":{"id":"item_66","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"sed -n '1,75p' crates/core/shell/src/shell/component/tests/restyle/preservation.rs && rg -n '__mesh_svc|service_payload_marker_for_test|benchmark_service_payload_table_access|benchmark_service_payload_marker_probes' crates -g '*.rs'\"","aggregated_output":"use super::*;\n\n#[test]\nfn state_preservation_restyle_service_payload_survives_hover_restyle() {\n    let mut component = test_frontend_component(\n        r#\"\n<template>\n  <button />\n</template>\n<script lang=\"luau\">\n-- Track whenever a reactive global is updated to detect accidental wipes.\nvol_pct = -1\nfunction render()\n    -- Read directly from the service state table if it exists.\n    if __mesh_svc_audio then\n        vol_pct = __mesh_svc_audio.percent or -1\n    end\nend\n</script>\n\"#,\n    );\n\n    let theme = default_theme();\n    let mut buffer = PixelBuffer::new(240, 80);\n\n    // First paint — no service payload yet.\n    component\n        .paint(&theme, SurfaceExtent::unpadded(240, 80), &mut buffer, 1.0)\n        .unwrap();\n\n    // Apply a service payload directly to the ScriptContext, simulating a\n    // backend service emit reaching the frontend runtime.\n    {\n        let mut runtimes = component.runtimes.lock().unwrap();\n        let runtime = runtimes.get_mut(component.id()).unwrap();\n        runtime\n            .script_ctx\n            .apply_service_payload(\"audio\", &serde_json::json!({ \"percent\": 72 }));\n        // Mark render hooks pending so render fires on next paint.\n    }\n    component.render_hooks_pending = true;\n    component.dirty = true;\n\n    // First paint with the service payload — render fires, vol_pct == 72.\n    component\n        .paint(&theme, SurfaceExtent::unpadded(240, 80), &mut buffer, 1.0)\n        .unwrap();\n    let pct_after_payload = runtime_number(&component, \"vol_pct\");\n    assert!(\n        (pct_after_payload - 72.0).abs() < 0.1,\n        \"vol_pct should be 72 after service payload applied, got {pct_after_payload}\"\n    );\n\n    // Trigger a pseudo-state restyle by setting hover (no service re-emit).\n    component.hovered_key = Some(\"root/0\".into());\n    component.hovered_path = [\"root\", \"root/0\"].map(runtime_node_id_for_key).to_vec();\n    component.dirty = true;\n    component\n        .paint(&theme, SurfaceExtent::unpadded(240, 80), &mut buffer, 1.0)\n        .unwrap();\n\n    // vol_pct must still reflect the last service update, not be wiped.\n    let pct_after_hover_restyle = runtime_number(&component, \"vol_pct\");\n    assert!(\n        (pct_after_hover_restyle - 72.0).abs() < 0.1,\n        \"service payload must survive a hover-triggered restyle; vol_pct={pct_after_hover_restyle}\"\n    );\n\n    // The hovered button should show :hover state in the tree.\n    let tree = component.last_tree.as_ref().unwrap();\n    assert!(\n        node_by_mesh_key(tree, \"root/0\").state.hovered,\n        \"button must be marked hovered after restyle\"\n    );\n}\ncrates/core/shell/src/shell/component/tests/restyle/preservation.rs:15:    if __mesh_svc_audio then\ncrates/core/shell/src/shell/component/tests/restyle/preservation.rs:16:        vol_pct = __mesh_svc_audio.percent or -1\ncrates/core/runtime/scripting/src/context/runtime/benchmarks.rs:54:    pub fn service_payload_marker_for_test(&mut self, service: &str) -> Option<Vec<u8>> {\ncrates/core/runtime/scripting/src/context/runtime/benchmarks.rs:64:    pub(crate) fn benchmark_service_payload_marker_probes(\ncrates/core/runtime/scripting/src/context/runtime/benchmarks.rs:117:    pub(crate) fn benchmark_service_payload_table_access(\ncrates/core/runtime/scripting/src/context/tests/interface_proxy.rs:325:    let first_marker = first.service_payload_marker_for_test(\"audio\").unwrap();\ncrates/core/runtime/scripting/src/context/tests/interface_proxy.rs:344:        second.service_payload_marker_for_test(\"audio\"),\nc