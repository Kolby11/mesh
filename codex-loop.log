0\t        runtime: &mut EmbeddedFrontendRuntime,\n   251\t    ) {\n   252\t        let Some(diagnostics) = diagnostics else {\n   253\t            return;\n   254\t        };\n   255\t        for diagnostic in runtime.script_ctx.drain_diagnostics() {\n   256\t            diagnostics.error(format!(\n   257\t                \"interface '{}' unavailable for '{}': {}\",\n   258\t                diagnostic.interface, diagnostic.module_id, diagnostic.reason\n   259\t            ));\n   260\t        }\n   261\t    }\n   262\t\n   263\t    pub(super) fn runtime_state(\n   264\t        &self,\n   265\t        instance_key: &str,\n   266\t    ) -> Option<Arc<mesh_core_scripting::ScriptState>> {\n   267\t        let mut runtimes = self.runtimes.lock().unwrap();\n   268\t        let runtime = runtimes.get_mut(instance_key)?;\n   269\t        let generation = runtime.script_ctx.state().mutation_generation();\n   270\t        if let Some((cached_generation, cached)) = runtime.cached_state_clone.as_ref()\n   271\t            && *cached_generation == generation\n   272\t        {\n   273\t            return Some(Arc::clone(cached));\n   274\t        }\n   275\t        let snapshot = Arc::new(runtime.script_ctx.state().clone());\n   276\t        runtime.cached_state_clone = Some((generation, Arc::clone(&snapshot)));\n   277\t        Some(snapshot)\n   278\t    }\n   279\t\n   280\t    pub(super) fn load_graph_i18n_catalogs(&mut self) {\n   281\t        let mut candidate = mesh_core_locale::LocaleEngine::with_fallback_locale(\n   282\t            self.locale.current(),\n   283\t            self.locale.fallback_locale(),\n   284\t        );\n   285\t        candidate.replace_selection(self.locale.selection());\n   286\t        let mut rejected = false;\n   287\t        for (module_id, locale, path) in &self.graph_i18n_catalogs {\n   288\t            let Ok(content) = std::fs::read_to_string(path) else {\n   289\t                tracing::warn!(\n   290\t                    \"module '{}': failed to read graph i18n catalog {}\",\n   291\t                    self.id(),\n   292\t                    path.display()\n   293\t                );\n   294\t                rejected = true;\n   295\t                continue;\n   296\t            };\n   297\t            let value: serde_json::Value = match serde_json::from_str(&content) {\n   298\t                Ok(value) => value,\n   299\t                Err(_) => {\n   300\t                    tracing::warn!(\n   301\t                        \"module '{}': failed to parse graph i18n catalog {}\",\n   302\t                        self.id(),\n   303\t                        path.display()\n   304\t                    );\n   305\t                    rejected = true;\n   306\t                    continue;\n   307\t                }\n   308\t            };\n   309\t            let catalog = mesh_core_locale::compile_catalog(locale.clone(), &value);\n   310\t            for diagnostic in &catalog.diagnostics {\n   311\t                tracing::warn!(\n   312\t                    \"module '{}': i18n catalog '{}' entry '{}': {}\",\n   313\t                    self.id(),\n   314\t                    path.display(),\n   315\t                    diagnostic.key,\n   316\t                    diagnostic.message\n   317\t                );\n   318\t            }\n   319\t            tracing::debug!(\n   320\t                \"module '{}': loaded {} graph translations for locale '{}'\",\n   321\t                self.id(),\n   322\t                catalog.messages.len(),\n   323\t                locale\n   324\t            );\n   325\t            candidate.load_module_catalog(module_id, catalog);\n   326\t        }\n   327\t        if rejected {\n   328\t            tracing::warn!(\n   329\t                \"module '{}': retaining last-known-good locale catalog snapshot\",\n   330\t                self.id()\n   331\t            );\n   332\t        } else {\n   333\t            self.locale\n   334\t                .replace