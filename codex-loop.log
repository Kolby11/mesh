s for author-declared customizable slots.\n    34\t    #[serde(default)]\n    35\t    pub node_slots: BTreeMap<String, BTreeMap<String, super::NodeSlotOverride>>,\n    36\t    /// Sparse preference overrides layered over the shared settings store.\n    37\t    /// Keys use the same namespaces as `settings.json`; durable module data is\n    38\t    /// deliberately not stored here.\n    39\t    #[serde(default)]\n    40\t    pub settings: BTreeMap<String, serde_json::Value>,\n    41\t}\n    42\t\n    43\t#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]\n    44\t#[serde(rename_all = \"camelCase\", deny_unknown_fields)]\n    45\tpub struct ProfileRootInstance {\n    46\t    /// Omitted in a sparse override; the profile key supplies the module id\n    47\t    /// during load.  Keeping the field optional on input lets `{ \"active\":\n    48\t    /// false }` deactivate an inherited root without repeating its identity.\n    49\t    #[serde(default, skip_serializing_if = \"String::is_empty\")]\n    50\t    pub module: String,\n    51\t    #[serde(default = \"default_entrypoint\")]\n    52\t    pub entrypoint: String,\n    53\t    #[serde(default = \"default_true\")]\n    54\t    pub active: bool,\n    55\t    /// Sparse per-instance placement override. Omission inherits `mesh.surface`.\n    56\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    57\t    pub surface: Option<SurfaceLayoutSection>,\n    58\t}\n    59\t\n    60\t#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]\n    61\t#[serde(rename_all = \"camelCase\", deny_unknown_fields)]\n    62\tpub struct ProfileResources {\n    63\t    #[serde(default, skip_serializing_if = \"Option::is_none\")]\n    64\t    pub theme: Option<String>,\n    65\t    #[serde(default)]\n    66\t    pub icons: Vec<String>,\n    67\t    #[serde(default)]\n    68\t    pub fonts: Vec<String>,\n    69\t    #[serde(default)]\n    70\t    pub languages: Vec<String>,\n    71\t}\n    72\t\n    73\tfn default_profile_schema_version() -> u32 {\n    74\t    PROFILE_SCHEMA_VERSION\n    75\t}\n    76\t\n    77\tfn default_entrypoint() -> String {\n    78\t    \"main\".into()\n    79\t}\n    80\t\n    81\tfn default_true() -> bool {\n    82\t    true\n    83\t}\n    84\t\n    85\tfn validate_unique_ordered_ids(field: &str, values: &[String]) -> Result<(), ModuleManifestError> {\n    86\t    let mut seen = HashSet::new();\n    87\t    for value in values {\n    88\t        if !seen.insert(value) {\n    89\t            return Err(ModuleManifestError::Validation(format!(\n    90\t                \"{field} contains duplicate module '{value}', which would make precedence ambiguous\"\n    91\t            )));\n    92\t        }\n    93\t    }\n    94\t    Ok(())\n    95\t}\n    96\t\n    97\timpl Default for ProfileRootInstance {\n    98\t    fn default() -> Self {\n    99\t        Self {\n   100\t            module: String::new(),\n   101\t            entrypoint: default_entrypoint(),\n   102\t            active: true,\n   103\t            surface: None,\n   104\t        }\n   105\t    }\n   106\t}\n   107\t\n   108\timpl ShellProfile {\n   109\t    pub fn new() -> Self {\n   110\t        Self {\n   111\t            schema_version: PROFILE_SCHEMA_VERSION,\n   112\t            ..Self::default()\n   113\t        }\n   114\t    }\n   115\t\n   116\t    pub fn from_json_str(input: &str) -> Result<Self, ModuleManifestError> {\n   117\t        let mut profile: Self =\n   118\t            serde_json::from_str(input).map_err(|source| ModuleManifestError::Json {\n   119\t                path: PathBuf::from(\"<profile>\"),\n   120\t                source,\n   121\t            })?;\n   122\t        profile.normalize_sparse_roots();\n   123\t        profile.validate()?;\n   124\t        Ok(profile)\n   125\t    }\n   126\t\n   127\t    pub fn from_path(path: &Path) -> Result<Self, ModuleManifestError> {\n   128\t        super::validate_regular_file(path, \"shell profile\")?;\n   129\t        let content = fs::read_to_string(path).map_err(|source| ModuleManifestError::Io {\n   130\t            path: path.to_path_buf(),\n   131\t            source,\n   132\t        })?;\n   133\t        let mut profile: Self =\n   134\t            serde_json::from_str(&content).map_err(|source| ModuleManifestError::Json {\n   135\t                path: path.to_path_buf(),\n   136\t                source,\n   137\t            })?;\n   138\t        profile.normalize_sparse_roots();\n   139\t        profile.validate()?;\n   140\t        Ok(profile)\n   141\t    }\n   142\t\n   143\t    fn normalize_sparse_roots(&mut self) {\n   144\t        for (instance_id, instance) in &mut self.roots {\n   145\t            if instance.module.is_empty()\n   146\t                && let Some((module, _)) = instance_id.rsplit_once('#')\n   147\t            {\n   148\t                instance.module = module.to_string();\n   149\t            }\n   150\t        }\n   151\t    }\n   152\t\n   153\t    /// This profile's own decisions, as a composition layer.\n   154\t    pub fn as_composition_spec(&self) -> super::CompositionSpec {\n   155\t        super::CompositionSpec {\n   156\t            roots: self.roots.clone(),\n   157\t            background_services: self.background_services.clone(),\n   158\t            providers: self.providers.clone(),\n   159\t            resources: self.resources.clone(),\n   160\t            slots: BTreeMap::new(),\n   161\t            node_slots: self.node_slots.clone(),\n   162\t            settings: self.settings.clone(),\n   163\t        }\n   164\t    }\n   165\t\n   166\t    pub fn validate(&self) -> Result<(), ModuleManifestError> {\n   167\t        if self.schema_version != PROFILE_SCHEMA_VERSION {\n   168\t            return Err(ModuleManifestError::Validation(format!(\n   169\t                \"unsupported profile schemaVersion {}; supported version is {PROFILE_SCHEMA_VERSION}. \\\n   170\t                 Schema 3 adds sparse nodeSlots; set \\\"schemaVersion\\\": {PROFILE_SCHEMA_VERSION} to migrate an otherwise valid profile\",\n   171\t                self.schema_version\n   172\t            )));\n   173\t        }\n   174\t        for (instance_id, instance) in &self.roots {\n   175\t            validate_instance_id(instance_id, &instance.module)?;\n   176\t            if instance.entrypoint.trim().is_empty() {\n   177\t                return Err(ModuleManifestError::Validation(format!(\n   178\t                    \"profile root {instance_id} has an empty entrypoint\"\n   179\t                )));\n   180\t            }\n   181\t        }\n   182\t        if let Some(from) = &self.from {\n   183\t            validate_module_ids([&from.module].into_iter(), \"from\")?;\n   184\t        }\n   185\t        validate_module_ids(self.background_services.iter(), \"backgroundServices\")?;\n   186\t        validate_module_ids(self.providers.values(), \"providers\")?;\n   187\t        validate_module_ids(\n   188\t            self.resources\n   189\t                .theme\n   190\t                .iter()\n   191\t                .chain(self.resources.icons.iter())\n   192\t                .chain(self.resources.fonts.iter())\n   193\t                .chain(self.resources.languages.iter()),\n   194\t            \"resources\",\n   195\t        )?;\n   196\t        validate_unique_ordered_ids(\"resources.languages\", &self.resources.languages)?;\n   197\t        for (instance_id, slots) in &self.node_slots {\n   198\t            if instance_id.trim().is_empty() {\n   199\t                return Err(ModuleManifestError::Validation(\n   200\t                    \"nodeSlots cannot contain an empty root instance id\".into(),\n   201\t                ));\n   202\t            }\n   203\t            for (slot_name, slot) in slots {\n   204\t                if slot_name.trim().is_empty() {\n   205\t                    return Err(ModuleManifestError::Validation(format!(\n   206\t                        \"nodeSlots.{instance_id} cannot contain an empty slot name\"\n   207\t                    )));\n   208\t                }\n   209\t                let mut ids = HashSet::new();\n   210\t                for node in &slot.nodes {\n   211\t                    if node.id.trim().is_empty() || !ids.insert(node.id.as_str()) {\n   212\t                        return Err(ModuleManifestError::Validation(format!(\n   213\t                            \"nodeSlots.{instance_id}.{slot_name} has an empty or duplicate placement id '{}'\",\n   214\t                            node.id\n   215\t                        )));\n   216\t                    }\n   217\t                    let Some((module, contribution)) = node.contribution.rsplit_once(':') else {\n   218\t                        return Err(ModuleManifestError::Validation(format!(\n   219\t                            \"node placement '{}' must use module-id:contribution-id\",\n   220\t                            node.contribution\n   221\t                        )));\n   222\t                    };\n   223\t                    let module = module.to_string();\n   224\t                    validate_module_ids([&module].into_iter(), \"nodeSlots\")?;\n   225\t                    if contribution.trim().is_empty() {\n   226\t                        return Err(ModuleManifestError::Validation(format!(\n   227\t                            \"node placement '{}' has an empty contribution id\",\n   228\t                            node.contribution\n   229\t                        )));\n   230\t                    }\n   231\t                }\n   232\t            }\n   233\t        }\n   234\t        for (namespace, value) in &self.settings {\n   235\t            if namespace != \"shell\" && !namespace.starts_with('@') && !namespace.contains('.') {\n   236\t                return Err(ModuleManifestError::Validation(format!(\n   237\t                    \"profile settings key '{namespace}' is not a shell, module, instance, or interface namespace\"\n   238\t                )));\n   239\t            }\n   240\t            if !value.is_object() {\n   241\t                return Err(ModuleManifestError::Validation(format!(\n   242\t                    \"profile settings namespace '{namespace}' must contain an object\"\n   243\t                )));\n   244\t            }\n   245\t        }\n   246\t        Ok(())\n   247\t    }\n   248\t\n   249\t    pub fn add_frontend(\n   250\t        &mut self,\n   251\t        manifest: &ModuleManifest,\n   252\t    ) -> Result<String, ModuleManifestError> {\n   253\t        if manifest.mesh.kind != ModuleKind::Frontend {\n   254\t            return Err(ModuleManifestError::Validation(format!(\n   255\t                \"{} is {:?}; only frontend modules create profile root instances\",\n   256\t                manifest.name, manifest.mesh.kind\n   257\t            )));\n   258\t        }\n   259\t        let instance_id = format!(\"{}#default\", manifest.name);\n   260\t        self.roots\n   460\t            entry.enabled = active.contains(module_id);\n   461\t        }\n   462\t        root.disabled.clear();\n   463\t        root.providers = self.providers.clone().into_iter().collect();\n   464\t        root.theme = self\n   465\t            .resources\n   466\t            .theme\n   467\t            .as_ref()\n   468\t            .map(|active| RootThemeSelection {\n   469\t                active: active.clone(),\n   470\t                mode: None,\n   471\t            });\n   472\t        root.layout = self\n   473\t            .roots\n   474\t            .values()\n   475\t            .find(|instance| instance.active)\n   476\t            .map(|instance| RootLayoutSelection {\n   477\t                entrypoint: format!(\"{}:{}\", instance.module, instance.entrypoint),\n   478\t            });\n   479\t        root.validate()\n   480\t    }\n   481\t}\n   482\t\n   483\timpl Default for ShellProfile {\n   484\t    fn default() -> Self {\n   485\t        Self {\n   486\t            schema_version: PROFILE_SCHEMA_VERSION,\n   487\t            from: None,\n   488\t            roots: BTreeMap::new(),\n   489\t            background_services: BTreeSet::new(),\n   490\t            providers: BTreeMap::new(),\n   491\t            resources: ProfileResources::default(),\n   492\t            node_slots: BTreeMap::new(),\n   493\t            settings: BTreeMap::new(),\n   494\t        }\n   495\t    }\n   496\t}\n   497\t\n   498\t#[derive(Debug, Clone)]\n   499\tpub struct ProfilePaths {\n   500\t    config_dir: PathBuf,\n   501\t}\n   502\t\n   503\timpl ProfilePaths {\n   504\t    pub fn from_root_graph(root_graph_path: &Path) -> Result<Self, ModuleManifestError> {\n   505\t        let config_dir = root_graph_path.parent().ok_or_else(|| {\n   506\t            ModuleManifestError::Validation(format!(\n   507\t                \"root module graph has no parent directory: {}\",\n   508\t                root_graph_path.display()\n   509\t            ))\n   510\t        })?;\n   511\t        Ok(Self {\n   512\t            config_dir: config_dir.to_path_buf(),\n   513\t        })\n   514\t    }\n   515\t\n   516\t    pub fn profiles_dir(&self) -> PathBuf {\n   517\t        self.config_dir.join(\"profiles\")\n   518\t    }\n   519\t\n   520\t    pub fn active_profile_path(&self) -> PathBuf {\n   521\t        self.config_dir.join(\"active-profile\")\n   522\t    }\n   523\t\n   524\t    pub fn profile_path(&self, profile_id: &str) -> Result<PathBuf, ModuleManifestError> {\n   525\t        validate_profile_id(profile_id)?;\n   526\t        Ok(self.profiles_dir().join(format!(\"{profile_id}.json\")))\n   527\t    }\n   528\t\n   529\t    pub fn active_profile_id(&self) -> Result<Option<String>, ModuleManifestError> {\n   530\t        let path = self.active_profile_path();\n   531\t        if !path.exists() {\n   532\t            return Ok(None);\n   533\t        }\n   534\t        super::validate_regular_file(&path, \"active profile pointer\")?;\n   535\t        let profile_id =\n   536\t            fs::read_to_string(&path).map_err(|source| ModuleManifestError::Io { path, source })?;\n   537\t        let profile_id = profile_id.trim();\n   538\t        validate_profile_id(profile_id)?;\n   539\t        Ok(Some(profile_id.to_string()))\n   540\t    }\n   541\t\n   542\t    pub fn load(&self, profile_id: &str) -> Result<ShellProfile, ModuleManifestError> {\n   543\t        ShellProfile::from_path(&self.profile_path(profile_id)?)\n   544\t    }\n   545\t\n   546\t    pub fn load_or_default(&self, profile_id: &str) -> Result<ShellProfile, ModuleManifestError> {\n   547\t        let path = self.profile_path(profile_id)?;\n   548\t        if fs::symlink_metadata(&path)\n   549\t            .map(|metadata| metadata.file_type().is_symlink())\n   550\t            .unwrap_or(false)\n   551\t        {\n   552\t            return Err(ModuleManifestError::Validation(format!(\n   553\t                \"shell profile {} must not be a symlink\",\n   554\t                path.display()\n   555\t            )));\n   556\t        }\n   557\t        if path.exists() {\n   558\t            ShellProfile::from_path(&path)\n   559\t        } else {\n   560\t            Ok(ShellProfile::new())\n   561\t        }\n   562\t    }\n   563\t\n   564\t    pub fn load_active(&self) -> Result<Option<(String, ShellProfile)>, ModuleManifestError> {\n   565\t        let Some(profile_id) = self.active_profile_id()? else {\n   566\t            return Ok(None);\n   567\t        };\n   568\t        let profile = self.load(&profile_id)?;\n   569\t        Ok(Some((profile_id, profile)))\n   570\t    }\n   571\t\n   572\t    pub fn save(\n   573\t        &self,\n   574\t        profile_id: &str,\n   575\t        profile: &ShellProfile,\n   576\t    ) -> Result<(), ModuleManifestError> {\n   577\t        profile.validate()?;\n   578\t        let path = self.profile_path(profile_id)?;\n   579\t        let mut content =\n   580\t            serde_json::to_string_pretty(profile).map_err(|source| ModuleManifestError::Json {\n   760\t                (\"@me/panel\", ModuleKind::Frontend),\n   761\t                (\"@me/component\", ModuleKind::Component),\n   762\t                (\"@me/audio\", ModuleKind::Backend),\n   763\t                (\"@me/unrelated\", ModuleKind::Library),\n   764\t            ]\n   765\t            .into_iter()\n   766\t            .map(|(id, kind)| {\n   767\t                (\n   768\t                    id.to_string(),\n   769\t                    super::super::InstalledModuleEntry {\n   770\t                        kind,\n   771\t                        path: id.trim_start_matches(\"@me/\").into(),\n   772\t                        enabled: true,\n   773\t                    },\n   774\t                )\n   775\t            })\n   776\t            .collect(),\n   777\t            disabled: Vec::new(),\n   778\t            providers: HashMap::new(),\n   779\t            layout: None,\n   780\t            theme: None,\n   781\t        };\n   782\t        let unrelated = manifest(\n   783\t            r#\"{\"name\":\"@me/unrelated\",\"version\":\"1\",\"mesh\":{\"apiVersion\":\"0.1\",\"kind\":\"library\"}}\"#,\n   784\t        );\n   785\t        profile\n   786\t            .apply_to_root(&mut root, &[frontend, component, backend, unrelated])\n   787\t            .unwrap();\n   788\t        assert!(root.modules[\"@me/panel\"].enabled);\n   789\t        assert!(root.modules[\"@me/component\"].enabled);\n   790\t        assert!(root.modules[\"@me/audio\"].enabled);\n   791\t        assert!(!root.modules[\"@me/unrelated\"].enabled);\n   792\t        assert_eq!(\n   793\t            root.layout.unwrap().entrypoint,\n   794\t            \"@me/panel:main\".to_string()\n   795\t        );\n   796\t    }\n   797\t\n   798\t    #[test]\n   799\t    fn sparse_root_overrides_inherit_the_module_from_the_instance_key() {\n   800\t        let profile = ShellProfile::from_json_str(\n   801\t            r#\"{\"schemaVersion\":3,\"roots\":{\"@me/panel#top\":{\"active\":false}}}\"#,\n   802\t        )\n   803\t        .unwrap();\n   804\t        let root = &profile.roots[\"@me/panel#top\"];\n   805\t        assert_eq!(root.module, \"@me/panel\");\n   806\t        assert!(!root.active);\n   807\t    }\n   808\t\n   809\t    #[test]\n   810\t    fn composition_activation_includes_the_composition_and_its_dependency_closure() {\n   811\t        let composition = manifest(\n   812\t            r#\"{\"name\":\"@me/desk\",\"version\":\"1.0.0\",\"mesh\":{\"apiVersion\":\"0.1\",\"kind\":\"composition\",\"uses\":{\"modules\":{\"@me/helpers\":\"^1.0.0\"}},\"compose\":{\"roots\":{\"@me/panel#top\":{\"module\":\"@me/panel\"}}}}}\"#,\n   813\t        );\n   814\t        let panel = manifest(\n   815\t            r#\"{\"name\":\"@me/panel\",\"version\":\"1.0.0\",\"mesh\":{\"apiVersion\":\"0.1\",\"kind\":\"frontend\",\"entry\":\"main.mesh\"}}\"#,\n   816\t        );\n   817\t        let helpers = manifest(\n   818\t            r#\"{\"name\":\"@me/helpers\",\"version\":\"1.2.0\",\"mesh\":{\"apiVersion\":\"0.1\",\"kind\":\"library\"}}\"#,\n   819\t        );\n   820\t        let profile = ShellProfile::from_json_str(\n   821\t            r#\"{\"schemaVersion\":3,\"from\":{\"module\":\"@me/desk\",\"version\":\"1.0.0\"}}\"#,\n   822\t        )\n   823\t        .unwrap();\n   824\t        let active = profile\n   825\t            .active_module_ids([&composition, &panel, &helpers])\n   826\t            .unwrap();\n   827\t        assert!(active.contains(\"@me/desk\"));\n   828\t        assert!(active.contains(\"@me/panel\"));\n   829\t        assert!(active.contains(\"@me/helpers\"));\n   830\t    }\n   831\t\n   832\t    #[test]\n   833\t    fn inactive_root_node_slots_do_not_activate_their_contributions() {\n   834\t        let composition = manifest(\n   835\t            r#\"{\"name\":\"@me/desk\",\"version\":\"1.0.0\",\"mesh\":{\"apiVersion\":\"0.1\",\"kind\":\"composition\",\"compose\":{\"roots\":{\"@me/panel#top\":{\"module\":\"@me/panel\"}},\"nodeSlots\":{\"@me/panel#top\":{\"start\":{\"nodes\":[{\"id\":\"clock\",\"use\":\"@me/items:clock\"}]}}}}}}\"#,\n   836\t        );\n   837\t        let panel = manifest(\n   838\t            r#\"{\"name\":\"@me/panel\",\"version\":\"1.0.0\",\"mesh\":{\"apiVersion\":\"0.1\",\"kind\":\"frontend\",\"entry\":\"main.mesh\"}}\"#,\n   839\t        );\n   840\t        let items = manifest(\n   841\t            r#\"{\"name\":\"@me/items\",\"version\":\"1.0.0\",\"mesh\":{\"apiVersion\":\"0.1\",\"kind\":\"component\",\"entry\":\"main.mesh\"}}\"#,\n   842\t        );\n   843\t        let profile = ShellProfile::from_json_str(\n   844\t            r#\"{\"schemaVersion\":3,\"from\":{\"module\":\"@me/desk\",\"version\":\"1.0.0\"},\"roots\":{\"@me/panel#top\":{\"active\":false},\"@me/gone#default\":{\"active\":true}}}\"#,\n   845\t        )\n   846\t        .unwrap();\n   847\t        let active = profile\n   848\t            .active_module_ids([&composition, &panel, &items])\n   849\t            .unwrap();\n   850\t        assert!(active.contains(\"@me/desk\"));\n   851\t        assert!(!active.contains(\"@me/panel\"));\n   852\t        assert!(!active.contains(\"@me/items\"));\n   853\t        assert!(!active.contains(\"@me/gone\"));\n   854\t    }\n   855\t\n   856\t    #[test]\n   857\t    fn profile_paths_reject_traversal() {\n   858\t        let paths = ProfilePaths::from_root_graph(Path::new(\"/tmp/mesh/module.json\")).unwrap();\n   859\t        assert!(paths.profile_path(\"../outside\").is_err());\n   860\t    }\n   861\t\n   862\t    #[test]\n   863\t    fn profile_settings_are_sparse_namespaced_objects() {\n   864\t        let profile = ShellProfile::from_json_str(\n   865\t            r#\"{\n   866\t                \"schemaVersion\": 3,\n   867\t                \"settings\": {\n   868\t                    \"shell\": { \"i18n\": { \"locale\": \"sk-SK\" } },\n   869\t                    \"@me/panel#work\": { \"props\": { \"global\": { \"dense\": true } } }\n   870\t                }\n   871\t            }\"#,\n   872\t        )\n   873\t        .unwrap();\n   874\t        assert_eq!(profile.settings[\"shell\"][\"i18n\"][\"locale\"], \"sk-SK\");\n   875\t        assert!(\n   876\t            ShellProfile::from_json_str(\n   877\t                r#\"{\"schemaVersion\":3,\"settings\":{\"shell\":\"not-an-object\"}}\"#\n   878\t            )\n   879\t            .is_err()\n   880\t        );\n   881\t    }\n   882\t\n   883\t    #[test]\n   884\t    fn schema_two_profiles_receive_a_focused_node_slots_migration_diagnostic() {\n   885\t        let error = ShellProfile::from_json_str(r#\"{\"schemaVersion\":2,\"roots\":{}}\"#)\n   886\t            .expect_err(\"schema 2 must not be accepted as a compatibility input\")\n   887\t            .to_string();\n   888\t        assert!(error.contains(\"Schema 3 adds sparse nodeSlots\"), \"{error}\");\n   889\t        assert!(error.contains(\"\\\"schemaVersion\\\": 3\"), \"{error}\");\n   890\t    }\n   891\t\n   892\t    #[test]\n   893\t    fn node_slot_placements_reject_duplicate_ids_and_invalid_references() {\n   894\t        let duplicate = ShellProfile::from_json_str(\n   895\t            r#\"{\n   896\t                \"schemaVersion\": 3,\n   897\t                \"nodeSlots\": {\"@me/panel#top\":{\"start\":{\"nodes\":[\n   898\t                    {\"id\":\"clock\",\"use\":\"@me/clock:small\"},\n   899\t                    {\"id\":\"clock\",\"use\":\"@me/clock:large\"}\n   900\t                ]}}}\n   901\t            }\"#,\n   902\t        )\n   903\t        .expect_err(\"placement ids are slot-local stable identities\")\n   904\t        .to_string();\n   905\t        assert!(duplicate.contains(\"duplicate placement id\"), \"{duplicate}\");\n   906\t\n   907\t        let invalid = ShellProfile::from_json_str(\n   908\t            r#\"{\n   909\t                \"schemaVersion\": 3,\n   910\t                \"nodeSlots\": {\"@me/panel#top\":{\"start\":{\"nodes\":[\n   911\t                    {\"id\":\"clock\",\"use\":\"not-a-contribution\"}\n   912\t                ]}}}\n   913\t            }\"#,\n   914\t        )\n   915\t        .expect_err(\"placements must reference public contributions\")\n   916\t        .to_string();\n   917\t        assert!(invalid.contains(\"module-id:contribution-id\"), \"{invalid}\");\n   918\t    }\n   919\t\n   920\t    #[test]\n","exit_code":0,"status":"completed"}}
