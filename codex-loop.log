/src/lib.rs:804:                    CatalogSourceKind::ModuleBundled => 1,\ncrates/core/foundation/locale/src/lib.rs:809:        Ok(PreparedLocaleCatalogSnapshot {\ncrates/core/foundation/locale/src/lib.rs:838:    /// Load a catalog owned by the explicit core domain.\ncrates/core/foundation/locale/src/lib.rs:840:        let locale = catalog_locale(&set.locale);\ncrates/core/foundation/locale/src/lib.rs:841:        let catalogs = Arc::make_mut(&mut self.catalogs);\ncrates/core/foundation/locale/src/lib.rs:842:        catalogs.core.entry(locale).or_default().extend(\ncrates/core/foundation/locale/src/lib.rs:845:                .map(|(key, value)| (key, CatalogEntry::Text(value))),\ncrates/core/foundation/locale/src/lib.rs:847:        catalogs.revision = catalogs.revision.saturating_add(1);\ncrates/core/foundation/locale/src/lib.rs:850:    pub fn load_core_catalog(&mut self, catalog: CompiledCatalog) {\ncrates/core/foundation/locale/src/lib.rs:851:        let locale = catalog_locale(&catalog.locale);\ncrates/core/foundation/locale/src/lib.rs:852:        let catalogs = Arc::make_mut(&mut self.catalogs);\ncrates/core/foundation/locale/src/lib.rs:853:        catalogs\ncrates/core/foundation/locale/src/lib.rs:857:            .extend(catalog.messages);\ncrates/core/foundation/locale/src/lib.rs:858:        catalogs.revision = catalogs.revision.saturating_add(1);\ncrates/core/foundation/locale/src/lib.rs:872:    /// Load a catalog owned by one module. It is never copied into the core\ncrates/core/foundation/locale/src/lib.rs:875:        let locale = catalog_locale(&set.locale);\ncrates/core/foundation/locale/src/lib.rs:876:        let catalogs = Arc::make_mut(&mut self.catalogs);\ncrates/core/foundation/locale/src/lib.rs:877:        catalogs\ncrates/core/foundation/locale/src/lib.rs:883:            .push(CatalogLayer {\ncrates/core/foundation/locale/src/lib.rs:884:                source: CatalogProvenance {\ncrates/core/foundation/locale/src/lib.rs:885:                    kin