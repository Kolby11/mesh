ls_invalid: true,\n  1167\t            locale: LocaleEngine::new(\"en\"),\n  1168\t            interface_catalog: interface_catalog.into(),\n  1169\t            last_tree: None,\n  1170\t            intrinsic_layout_cache: IntrinsicLayoutCache::default(),\n  1171\t            layout_state: PerSurfaceLayoutState::default(),\n  1172\t            retained_tree: RetainedWidgetTree::default(),\n  1173\t            retained_update_dirty_roots: None,\n  1174\t            #[cfg(test)]\n  1175\t            force_full_retained_update: false,\n  1176\t            animation_only_dirty: false,\n  1177\t            node_service_field_deps: NodeServiceFieldDependencies::default(),\n  1178\t            pending_service_template_nodes: None,\n  1179\t            selective_service_build_supported,\n  1180\t            #[cfg(test)]\n  1181\t            last_template_build_reused_nodes: 0,\n  1182\t            #[cfg(test)]\n  1183\t            force_full_template_build: false,\n  1184\t            retained_display_list: RetainedDisplayList::default(),\n  1185\t            child_display_lists: RefCell::new(ChildDisplayListCache::default()),\n  1115\t    fn locale_changed(&mut self, locale: &LocaleEngine) -> Result<(), ComponentError> {\n  1116\t        tracing::debug!(\"locale_changed for component '{}'\", self.id());\n  1117\t        self.locale.replace_selection(locale.selection());\n  1118\t        let selection = locale.selection();\n  1119\t        let payload = serde_json::json!({\n  1120\t            \"locale\": locale.current(),\n  1121\t            \"current\": locale.current(),\n  1122\t            \"chain\": selection.chain(),\n  1123\t            \"direction\": selection.direction().as_str(),\n  1124\t            \"revision\": selection.revision().to_string(),\n  1125\t        });\n  1126\t        let mut generations = Vec::new();\n  1127\t        for (instance_key, runtime) in self.runtimes.lock().unwrap().iter_mut() {\n  1128\t            let translator = self.locale.module_translator(&runtime.script_ctx.module_id);\n  1129\t            runtime.script_ctx.set_i18n_translator(&translator);\n  1130\t            runtime.script_ctx.apply_service_payload(\"locale\", &payload);\n  1131\t            if script_has_service_read(&runtime.script_ctx, \"mesh.locale\", \"locale\") {\n  1132\t                apply_service_update_with_name(\n  1133\t                    runtime.script_ctx.state_mut(),\n  1134\t                    true,\n  1135\t                    \"locale\",\n  1136\t                    \"@mesh/shell\",\n  1137\t                    &payload,\n  1138\t                );\n  1139\t            }\n  1140\t            generations.push((\n  1141\t                instance_key.clone(),\n  1142\t                runtime.script_ctx.state().mutation_generation(),\n  1143\t            ));\n  1144\t        }\n  1145\t        for (instance_key, generation) in generations {\n  1146\t            self.sync_runtime_generation(&instance_key, generation);\n  1147\t        }\n  1148\t        self.reset_render_caches();\n  1149\t        self.render_hooks_pending = true;\n  1150\t        self.surface_pixels_invalid = true;\n  1151\t        self.invalidate_script_state();\n  1152\t        Ok(())\n  1153\t    }\n  1154\t\n  1155\t    fn source_path(&self) -> Option<&Path> {\n  1156\t        Some(self.compiled.source_path.as_path())\n  1157\t    }\n  1158\t\n  1159\t    fn watched_source_paths(&self) -> Vec<PathBuf> {\n  1160\t        self.compiled.watched_paths.clone()\n  1161\t    }\n  1162\t\n  1163\t    fn apply_settings(\n  1164\t        &mut self,\n  1165\t        settings: &Arc<mesh_core_config::SettingsStore>,\n  1166\t    ) -> Result<bool, ComponentError> {\n  1167\t        self.settings = settings.clone();\n  1168\t        let settings_state = resolve_frontend_module_settings_with_props(\n  1169\t            &self.settings_namespace,\n  1170\t            self.settings.namespace(&self.settings_namespace),\n  1171\t            &self.compiled.manifest,\n  1172\t            self.compiled.component.props.as_ref(),\n  1173\t        );\n  1174\t        // Only what this save introduced: re-reporting the rest on every write\n  1175\t        // would bury the one line the user is trying to fix.\n","exit_code":0,"status":"completed"}}
