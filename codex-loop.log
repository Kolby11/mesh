ng may have been a popover triggered from\\n   102\\t            // this surface — drop its registration so a stale Tab doesn't\\n   103\\t            // try to re-enter it.\\n   104\\t            if !visible && surface_id != self.surface_id() {\\n   105\\t                self.triggered_popovers\\n   106\\t                    .retain(|_, target| target != surface_id);\\n   107\\t            }\\n   108\\t            // Sync portal bookkeeping when an OTHER surface's visibility\\n   109\\t            // changes. This handles two cases:\\n   110\\t            //   1. Shell hides a popover via Tab transfer — the trigger\\n   111\\t            //      surface's Lua may still think the popover is open, so\\n   112\\t            //      a click would emit a redundant Hide.\\n   113\\t            //   2. Surface shown via a non-portal path (mesh.popover.activate)\\n   114\\t            //      bypassing tick()'s bookkeeping — the next tick would\\n   115\\t            //      otherwise re-emit a stale HideSurface from the previous\\n   116\\t            //      paint's pending_surface_states.\\n   117\\t            // Update last_surface_states whenever this component owns a\\n   118\\t            // portal binding for the surface (not just when the key was\\n   119\\t            // already present), and clear any stale pending state so the\\n   120\\t            // next tick's diff is honest.\\n   121\\t            if surface_id != self.surface_id() {\\n   122\\t                let portal_tracks = self\\n   123\\t                    .portal_hidden_bindings\\n   124\\t                    .borrow()\\n   125\\t                    .contains_key(surface_id);\\n   126\\t                if portal_tracks || self.last_surface_states.contains_key(surface_id) {\\n   127\\t                    self.last_surface_states\\n   128\\t                        .insert(surface_id.clone(), *visible);\\n   129\\t                    self.pending_surface_states.borrow_mut().remove(surface_id);\\n  