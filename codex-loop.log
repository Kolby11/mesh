lf) {\\n   109\\t        self.flush_storage();\\n   110\\t        self.uninit();\\n   111\\t    }\\n   112\\t}\\n   113\\t\\n   114\\timpl ScriptContext {\\n   115\\t    pub(super) fn lua(&self) -> &Lua {\\n   116\\t        self.vm\\n   117\\t            .as_ref()\\n   118\\t            .expect(\\\"ScriptContext not initialized — call ensure_initialized first\\\")\\n   119\\t            .lua()\\n   120\\t    }\\n   121\\t\\n   122\\t    /// Attach the surface's handle so all of its component instances share one\\n   123\\t    /// thread realm. No effect once the context is initialized.\\n   124\\t    pub fn attach_shared_vm(&mut self, vm: &SurfaceVm) {\\n   125\\t        if self.vm.is_some() {\\n   126\\t            return;\\n   127\\t        }\\n   128\\t        self.shared_vm = Some(vm.handle());\\n   129\\t        self.shared_element_metrics = Arc::clone(&vm.element_metrics);\\n   130\\t    }\\n   300\\t            shared_diagnostics: Arc::new(Mutex::new(Vec::new())),\\n   301\\t            element_actions: Vec::new(),\\n   302\\t            shared_element_actions: Arc::new(Mutex::new(Vec::new())),\\n   303\\t            storage: Arc::new(Mutex::new(storage)),\\n   304\\t            tracked_storage_keys: Arc::new(Mutex::new(HashSet::new())),\\n   305\\t            changed_storage_keys: Arc::new(Mutex::new(HashSet::new())),\\n   306\\t            tracking_storage_reads: Arc::new(AtomicBool::new(false)),\\n   307\\t            pending_side_channels: Arc::new(AtomicBool::new(false)),\\n   308\\t            pending_redraw: Arc::new(AtomicBool::new(false)),\\n   309\\t            live_binding_external_accessed: Arc::new(AtomicBool::new(false)),\\n   310\\t            last_element_metrics_fingerprint: None,\\n   311\\t            shared_element_metrics: Arc::new(Mutex::new(ElementMetricsStore::default())),\\n   312\\t            cached_self_table: None,\\n   313\\t            service_context_state: Arc::new(Mutex::new(ServiceContextState::default())),\\n   314\\t            service_call_completions: Arc::new(Mutex::new(HashMap::new())),\\n   315\\t            i18n_translations: Arc::new(Mutex::new(HashMap::new())),\\n   316\\t            i18n_locale: Arc::new(Mutex::new(\\\"en\\\".into())),\\n   317\\t        })\\n   318\\t    }\\n   319\\t\\n   320\\t    pub fn set_interface_catalog(&mut self, catalog: impl Into<Arc<InterfaceCatalog>>) {\\n   321\\t        self.interface_catalog = catalog.into();\\n   322\\t    }\\n   323\\t\\n   324\\t    pub fn set_optional_interfaces(&mut self, interfaces: HashSet<String>) {\\n   325\\t        self.optional_interfaces = Arc::new(interfaces);\\n   326\\t    }\\n   327\\t\\n   328\\t    /// Replace the catalog behind `mesh.i18n.t()`. Existing Luau handles share\\n   329\\t    /// the map, so a locale switch takes effect immediately.\\n   330\\t    pub fn set_i18n_translations(&mut self, translations: HashMap<String, String>) {\\n   331\\t        *self.i18n_translations.lock().unwrap() = translations\\n   332\\t            .into_iter()\\n   333\\t            .map(|(key, value)| (key, CatalogEntry::Text(value)))\\n   334\\t            .collect();\\n   335\\t        *self.i18n_locale.lock().unwrap() = \\\"en\\\".into();\\n   336\\t    }\\n   337\\t\\n   338\\t    /// Replace the catalog behind `mesh.i18n.t()` with the owning module's\\n   339\\t    /// scoped translator snapshot.\\n   340\\t    pub fn set_i18n_translator(&mut self, translator: &ModuleTranslator<'_>) {\\n   341\\t        *self.i18n_translations.lock().unwrap() = translator.entries();\\n   342\\t        *self.i18n_locale.lock().unwrap() = translator.locale().to_string();\\n   343\\t    }\\n   344\\t\\n   345\\t    /// Clone the thread VM, create a per-component `_ENV`, install host APIs,\\n   346\\t    /// and populate `builtin_globals`. Idempotent.\\n   347\\t    pub(super) fn ensure_initialized(&mut self) -> Result<(), ScriptError> {\\n   348\\t        if self.vm.is_some() {\\n   349\\t            return Ok(());\\n   350\\t        }\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n+{\"type\":\"item.started\",\"item\":{\"id\":\"item_35\",\"type\":\"command_execution\",\"command\":\"/run/current-system/sw/bin/bash -lc \\\"nl -ba crates/core/foundation/locale/src/lib.rs | sed -n '1020,1210p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n+{\"type\":\"item.completed\",\"item\":{\"id\":\"item_35\",\"type\":\"command_execution\",\"command\":\"/run/current-system/sw/bin/bash -lc \\\"nl -ba crates/core/foundation/locale/src/lib.rs | sed -n '1020,1210p'\\\"\",\"aggregated_output\":\"  1020\\t    fn effective_core_translations(&self) -> HashMap<String, String> {\\n  1021\\t        let mut messages = HashMap::new();\\n  1022\\t        for locale in self.selection.chain().iter().rev() {\\n  1023\\t            if let Some(catalog) = self.catalogs.core.get(locale) {\\n  1024\\t                messages.extend(catalog.iter().filter_map(|(key, entry)| {\\n  1025\\t                    entry\\n  1026\\t                        .default_text()\\n  1027\\t                        .map(|value| (key.clone(), value.to_string()))\\n  1028\\t                }));\\n  1029\\t            }\\n  1030\\t        }\\n  1031\\t        messages\\n  1032\\t    }\\n  1033\\t\\n  1034\\t    fn effective_module_translations(&self, module_id: &str) -> HashMap<String, String> {\\n  1035\\t        let mut messages = HashMap::new();\\n  1036\\t        for key in self.module_keys(module_id) {\\n  1037\\t            if let Some(entry) = self.translate_in_module(&key, module_id)\\n  1038\\t                && let Some(value) = entry.default_text()\\n  1039\\t            {\\n  1040\\t                messages.insert(key, value.to_string());\\n  1041\\t            }\\n  1042\\t        }\\n  1043\\t        messages\\n  1044\\t    }\\n  1045\\t\\n  1046\\t    fn effective_module_entries(&self, module_id: &str) -> HashMap<String, CatalogEntry> {\\n  1047\\t        let mut messages = HashMap::new();\\n  1048\\t        for key in self.module_keys(module_id) {\\n  1049\\t            if let Some(entry) = self.translate_in_module(&key, module_id) {\\n  1050\\t                messages.insert(key, entry.clone());\\n  1051\\t            }\\n  1052\\t        }\\n  1053\\t        messages\\n  1054\\t    }\\n  1055\\t\\n  1056\\t    fn module_keys(&self, module_id: &str) -> BTreeSet<String> {\\n  1057\\t        self.catalogs\\n  1058\\t            .modules\\n  1059\\t            .get(module_id)\\n  1060\\t            .into_iter()\\n  1061\\t            .flat_map(|locales| locales.values())\\n  1062\\t            .flat_map(|layers| layers.iter())\\n  1063\\t            .flat_map(|layer| layer.messages.keys().cloned())\\n  1064\\t            .collect()\\n  1065\\t    }\\n  1066\\t\\n  1067\\t    pub fn source_for(&self, module_id: &str, key: &str) -> Option<&CatalogProvenance> {\\n  1068\\t        self.source_for_module(key, module_id)\\n  1069\\t    }\\n  1070\\t\\n  1071\\t    pub fn fallback_chain(&self) -> &[String] {\\n  1072\\t        self.selection.chain()\\n  1073\\t    }\\n  1074\\t}\\n  1075\\t\\n  1076\\tfn catalog_locale(locale: &str) -> String {\\n  1077\\t    canonicalize_locale_tag(locale).unwrap_or_else(|_| locale.trim().to_string())\\n  1078\\t}\\n  1079\\t\\n  1080\\tfn canonicalize_locale_tag(raw: &str) -> Result<String, LocaleError> {\\n  1081\\t    let raw = raw.trim();\\n  1082\\t    if raw.is_empty() {\\n  1083\\t        return Err(LocaleError::EmptyTag);\\n  1084\\t    }\\n  1085\\t    let parts = raw.split('-').collect::<Vec<_>>();\\n  1086\\t    if parts.iter().any(|part| part.is_empty()) {\\n  1087\\t        return Err(LocaleError::InvalidTag {\\n  1088\\t            tag: raw.to_string(),\\n  1089\\t        });\\n  1090\\t    }\\n  1091\\t\\n  1092\\t    let language = parts[0];\\n  1093\\t    if !(2..=8).contains(&language.len()) || !language.chars().all(|ch| ch.is_ascii_alphabetic()) {\\n  1094\\t        return Err(LocaleError::InvalidTag {\\n  1095\\t            tag: raw.to_string(),\\n  1096\\t        });\\n  1097\\t    }\\n  1098\\t    let mut normalized = vec![language.to_ascii_lowercase()];\\n  1099\\t    let mut index = 1;\\n  1100\\t\\n  1101\\t    if parts\\n  1102\\t        .get(index)\\n  1103\\t        .is_some_and(|part| part.len() == 4 && part.chars().all(|ch| ch.is_ascii_alphabetic()))\\n  1104\\t    {\\n  1105\\t        let script = parts[index];\\n  1106\\t        let mut chars = script.chars();\\n  1107\\t        let first = chars.next().expect(\\\"script is nonempty\\\");\\n  1108\\t        normalized.push(format!(\\n  1109\\t            \\\"{}{}\\\",\\n  1110\\t            first.to_ascii_uppercase(),\\n  1111\\t            chars.as_str().to_ascii_lowercase()\\n  1112\\t        ));\\n  1113\\t        index += 1;\\n  1114\\t    }\\n  1115\\t\\n  1116\\t    if parts.get(index).is_some_and(|part| {\\n  1117\\t        (part.len() == 2 && part.chars().all(|ch| ch.is_ascii_alphabetic()))\\n  1118\\t            || (part.len() == 3 && part.chars().all(|ch| ch.is_ascii_digit()))\\n  1119\\t    }) {\\n  1120\\t        normalized.push(if parts[index].chars().all(|ch| ch.is_ascii_digit()) {\\n  1121\\t            parts[index].to_string()\\n  1122\\t        } else {\\n  1123\\t            parts[index].to_ascii_uppercase()\\n  1124\\t        });\\n  1125\\t        index += 1;\\n  1126\\t    }\\n  1127\\t\\n  1128\\t    while index < parts.len() {\\n  1129\\t        let part = parts[index];\\n  1130\\t        if part.len() == 1 {\\n  1131\\t            if !part.chars().all(|ch| ch.is_ascii_alphanumeric()) {\\n  1132\\t                return Err(LocaleError::InvalidTag {\\n  1133\\t                    tag: raw.to_string(),\\n  1134\\t                });\\n  1135\\t            }\\n  1136\\t            normalized.push(part.to_ascii_lowercase());\\n  1137\\t            index += 1;\\n  1138\\t            let extension_start = index;\\n  1139\\t            while index < parts.len() && parts[index].len() != 1 {\\n  1140\\t                let extension = parts[index];\\n  1141\\t                if !(2..=8).contains(&extension.len())\\n  1142\\t                    || !extension.chars().all(|ch| ch.is_ascii_alphanumeric())\\n  1143\\t                {\\n  1144\\t                    return Err(LocaleError::InvalidTag {\\n  1145\\t                        tag: raw.to_string(),\\n  1146\\t                    });\\n  1147\\t                }\\n  1148\\t                normalized.push(extension.to_ascii_lowercase());\\n  1149\\t                index += 1;\\n  1150\\t            }\\n  1151\\t            if index == extension_start {\\n  1152\\t                return Err(LocaleError::InvalidTag {\\n  1153\\t                    tag: raw.to_string(),\\n  1154\\t                });\\n  1155\\t            }\\n  1156\\t            continue;\\n  1157\\t        }\\n  1158\\t\\n  1159\\t        let is_variant = (5..=8).contains(&part.len())\\n  1160\\t            && part.chars().all(|ch| ch.is_ascii_alphanumeric())\\n  1161\\t            || (part.len() == 4\\n  1162\\t                && part.chars().next().is_some_and(|ch| ch.is_ascii_digit())\\n  1163\\t                && part.chars().all(|ch| ch.is_ascii_alphanumeric()));\\n  1164\\t        if !is_variant {\\n  1165\\t            return Err(LocaleError::InvalidTag {\\n  1166\\t                tag: raw.to_string(),\\n  1167\\t            });\\n  1168\\t        }\\n  1169\\t        normalized.push(part.to_ascii_lowercase());\\n  1170\\t        index += 1;\\n  1171\\t    }\\n  1172\\t\\n  1173\\t    Ok(normalized.join(\\\"-\\\"))\\n  1174\\t}\\n  1175\\t\\n  1176\\tfn locale_parents(locale: &str) -> Vec<String> {\\n  1177\\t    let mut parts = locale.split('-').collect::<Vec<_>>();\\n  1178\\t    if let Some(extension_index) = parts.iter().position(|part| part.len() == 1) {\\n  1179\\t        parts.truncate(extension_index);\\n  1180\\t    }\\n  1181\\t    let mut parents = Vec::new();\\n  1182\\t    while parts.len() > 1 {\\n  1183\\t        parts.pop();\\n  1184\\t        parents.push(parts.join(\\\"-\\\"));\\n  1185\\t    }\\n  1186\\t    parents\\n  1187\\t}\\n  1188\\t\\n  1189\\tfn complete_fallback_chain(active: &str, fallback: &str) -> Vec<String> {\\n  1190\\t    let mut chain = Vec::new();\\n  1191\\t    let mut append = |locale: &str| {\\n  1192\\t        if !chain.iter().any(|existing| existing == locale) {\\n  1193\\t            chain.push(locale.to_string());\\n  1194\\t        }\\n  1195\\t    };\\n  1196\\t    append(active);\\n  1197\\t    for parent in locale_parents(active) {\\n  1198\\t        append(&parent);\\n  1199\\t    }\\n  1200\\t    append(fallback);\\n  1201\\t    for parent in locale_parents(fallback) {\\n  1202\\t        append(&parent);\\n  1203\\t    }\\n  1204\\t    append(\\\"en\\\");\\n  1205\\t    chain\\n  1206\\t}\\n  1207\\t\\n  1208\\tfn direction_for(locale: &str) -> LocaleDirection {\\n  1209\\t    let language = locale.split('-').next().unwrap_or_default();\\n  1210\\t    let script = locale\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n+{\"type\":\"item.started\",\"item\":{\"id\":\"item_36\",\"type\":\"command_execution\",\"command\":\"/run/current-system/sw/bin/bash -lc \\\"sed -n '280,520p' .planning/log/sections/05-localization-i18n/improvements.md\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n+{\"type\":\"item.completed\",\"item\":{\"id\":\"item_36\",\"type\":\"command_execution\",\"command\":\"/run/current-system/sw/bin/bash -lc \\\"sed -n '280,520p' .planning/log/sections/05-localization-i18n/improvements.md\\\"\",\"aggregated_output\":\"3. Introduce typed catalog entries, per-entry diagnostics, limits, contained\\n   source handles, and the immutable central snapshot.\\n4. Remove the global pool and pass module-scoped translators through every\\n   template, script, manifest, props, settings, and debug surface.\\n5. Implement language-pack composition and per-module terminal defaults with\\n   provenance and deterministic precedence.\\n6. Route startup, settings/service writes, profile/graph changes, and catalog\\n   reload through one durable prepare/commit coordinator.\\n7. Align `mesh.i18n`, `mesh.locale`, service state/events, capabilities, LSP,\\n   and CLI with one generated contract; add formatting and directionality.\\n8. Add catalog watches, narrow invalidation by translator generation/key\\n   dependencies, system-locale policy, extraction, missing-key, and `which`\\n   tooling.\\n\\n## Required regression coverage\\n\\n- A module never resolves another module's catalog key, regardless of graph or\\n  load order; explicit interface catalogs remain independently scoped.\\n- BCP 47 tags normalize and derive parents (`zh-Hant-TW → zh-Hant → zh`), stale\\n  active locales never remain in the chain, and each module default is terminal\\n  only for that module.\\n- String and plural/select entries coexist in one file; Slovak and English\\n  categories, placeholder consistency, malformed sibling isolation, and size\\n  limits are covered.\\n- Two targeted packs shadow one module key in configured order; unrelated or\\n  disabled packs do not participate; provenance identifies the winner.\\n- Manual locale selection persists in the correct profile/settings scope and\\n  survives restart; stale revisions and invalid tags do not mutate live state.\\n- Catalog edits, graph enable/disable, and profile switches refresh retained and\\n  new surfaces on one revision; an invalid candidate retains the old snapshot.\\n- Catalog paths cannot escape through absolute, parent, or symlink traversal;\\n  catalog bytes are read and parsed once per snapshot rather than once per\\n  surface.\\n- Templates, existing Luau `t()` handles, manifests, props, generated settings,\\n  and debug data resolve the same module/revision and emit `!!key` plus one\\n  structured miss diagnostic.\\n- Runtime, service, documentation, and LSP APIs agree; `locale.read` and\\n  `locale.write` denial is enforced consistently.\\n- `<i18n>` is either compiled with documented precedence or rejected explicitly;\\n  CLI/LSP locale discovery follows canonical graph contributions.\\n\\n## Verification\\n\\nFour Luna xhigh review passes reconstructed the flow, challenged its logical\\norder and feature model, inspected concrete code defects, and audited catalog,\\nfilesystem, capability, and tooling boundaries. No reviewer edited production\\ncode.\\n\\nExecuted locally with `nix develop`:\\n\\n```text\\nmesh-core-locale: 3 passed\\nmesh-core-scripting import slice: 20 passed\\nmesh-core-module i18n slice: 3 passed\\nmesh-core-shell locale slice: 7 passed, 1 failed before its localization\\nassertion on the already-recorded legacy mesh.surfaceLayout fixture baseline\\n```\\n\\nThe passing suites validate isolated current behavior but do not cover the\\ncross-boundary failures above. No production code was changed by this audit.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n+{\"type\":\"item.started\",\"item\":{\"id\":\"item_37\",\"type\":\"command_execution\",\"command\":\"/run/current-system/sw/bin/bash -lc \\\"nl -ba crates/core/shell/src/shell/discovery.rs | sed -n '1,130p;850,950p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n+{\"type\":\"item.completed\",\"item\":{\"id\":\"item_37\",\"type\":\"command_execution\",\"command\":\"/run/current-system/sw/bin/bash -lc \\\"nl -ba crates/core/shell/src/shell/discovery.rs | sed -n '1,130p;850,950p'\\\"\",\"aggregated_output\":\"     1\\tuse super::component::{FrontendCatalog, FrontendCatalogHandle, FrontendSurfaceComponent};\\n     2\\tuse super::*;\\n     3\\tuse mesh_core_module::ModuleHealthRecord;\\n     4\\tuse rayon::prelude::*;\\n     5\\tuse std::collections::{BTreeMap, HashMap, HashSet};\\n     6\\t\\n     7\\tconst BUILTIN_DEBUG_INSPECTOR_ID: &str = \\\"@mesh/debug-inspector\\\";\\n     8\\t\\n     9\\tpub(in crate::shell) fn installed_module_graph_path() -> PathBuf {\\n    10\\t    if let Ok(path) = std::env::var(\\\"MESH_MODULE_GRAPH_PATH\\\")\\n    11\\t        && !path.trim().is_empty()\\n    12\\t    {\\n    13\\t        return PathBuf::from(path);\\n    14\\t    }\\n    15\\t    PathBuf::from(env!(\\\"CARGO_MANIFEST_DIR\\\"))\\n    16\\t        .join(\\\"../../..\\\")\\n    17\\t        .join(\\\"config/module.json\\\")\\n    18\\t}\\n    19\\t\\n    20\\tfn load_installed_module_graph_candidate(\\n    21\\t    root_module_graph_path: &Path,\\n    22\\t) -> Result<InstalledModuleGraph, mesh_core_module::package::ModuleManifestError> {\\n    23\\t    load_installed_module_graph(root_module_graph_path)\\n    24\\t}\\n    25\\t\\n    26\\tpub(in crate::shell) fn graph_i18n_catalog_sources(\\n    27\\t    graph: &InstalledModuleGraph,\\n    28\\t) -> (\\n    29\\t    Vec<mesh_core_locale::CatalogSource>,\\n    30\\t    HashMap<String, String>,\\n    31\\t) {\\n    32\\t    let selected_packs = graph\\n    33\\t        .language_pack_chain()\\n    34\\t        .iter()\\n    35\\t        .cloned()\\n    36\\t        .collect::<HashSet<_>>();\\n    37\\t    let mut bundled = graph\\n    38\\t        .contributed_i18n()\\n    39\\t        .iter()\\n    40\\t        .filter(|catalog| {\\n    41\\t            catalog.target_module_id == catalog.module_id\\n    42\\t                && !graph\\n    43\\t                    .module(&catalog.module_id)\\n    44\\t                    .is_some_and(|module| module.kind == mesh_core_module::ModuleKind::LanguagePack)\\n    45\\t        })\\n    46\\t        .collect::<Vec<_>>();\\n    47\\t    bundled.sort_by(|left, right| {\\n    48\\t        left.target_module_id\\n    49\\t            .cmp(&right.target_module_id)\\n    50\\t            .then_with(|| left.locale.cmp(&right.locale))\\n    51\\t            .then_with(|| left.id.cmp(&right.id))\\n    52\\t    });\\n    53\\t\\n    54\\t    let mut sources = bundled\\n    55\\t        .into_iter()\\n    56\\t        .filter_map(|catalog| {\\n    57\\t            let module_dir = catalog.source.manifest_path.parent()?;\\n    58\\t            Some(mesh_core_locale::CatalogSource::module(\\n    59\\t                catalog.module_id.clone(),\\n    60\\t                catalog.id.clone(),\\n    61\\t                catalog.locale.clone(),\\n    62\\t                module_dir.join(&catalog.path),\\n    63\\t            ))\\n    64\\t        })\\n    65\\t        .collect::<Vec<_>>();\\n    66\\t\\n    67\\t    for pack_module_id in graph.language_pack_chain() {\\n    68\\t        let mut pack_catalogs = graph\\n    69\\t            .contributed_i18n()\\n    70\\t            .iter()\\n    71\\t            .filter(|catalog| {\\n    72\\t                catalog.module_id == *pack_module_id\\n    73\\t                    && selected_packs.contains(&catalog.module_id)\\n    74\\t                    && catalog.target_module_id != catalog.module_id\\n    75\\t                    && graph\\n    76\\t                        .module(&catalog.target_module_id)\\n    77\\t                        .is_some_and(|module| module.enabled)\\n    78\\t            })\\n    79\\t            .collect::<Vec<_>>();\\n    80\\t        pack_catalogs.sort_by(|left, right| left.id.cmp(&right.id));\\n    81\\t        for catalog in pack_catalogs {\\n    82\\t            let Some(module_dir) = catalog.source.manifest_path.parent() else {\\n    83\\t                continue;\\n    84\\t            };\\n    85\\t            sources.push(mesh_core_locale::CatalogSource::language_pack(\\n    86\\t                catalog.module_id.clone(),\\n    87\\t                catalog.target_module_id.clone(),\\n    88\\t                catalog.id.clone(),\\n    89\\t                catalog.locale.clone(),\\n    90\\t                module_dir.join(&catalog.path),\\n    91\\t            ));\\n    92\\t        }\\n    93\\t    }\\n    94\\t\\n    95\\t    let defaults = graph\\n    96\\t        .modules()\\n    97\\t        .into_iter()\\n    98\\t        .filter(|module| module.enabled)\\n    99\\t        .filter_map(|module| {\\n   100\\t            module\\n   101\\t                .manifest\\n   102\\t                .mesh\\n   103\\t                .i18n\\n   104\\t                .default_locale\\n   105\\t                .clone()\\n   106\\t                .map(|locale| (module.id.clone(), locale))\\n   107\\t        })\\n   108\\t        .collect();\\n   109\\t    (sources, defaults)\\n   110\\t}\\n   111\\t\\n   112\\tfn log_locale_catalog_diagnostics(diagnostics: &[mesh_core_locale::CatalogSourceDiagnostics]) {\\n   113\\t    for source in diagnostics {\\n   114\\t        for diagnostic in &source.diagnostics {\\n   115\\t            tracing::warn!(\\n   116\\t                module_id = %source.module_id,\\n   117\\t                locale = %source.locale,\\n   118\\t                path = %source.path.display(),\\n   119\\t                key = %diagnostic.key,\\n   120\\t                \\\"locale catalog entry rejected: {}\\\",\\n   121\\t                diagnostic.message,\\n   122\\t            );\\n   123\\t        }\\n   124\\t    }\\n   125\\t}\\n   126\\t\\n   127\\t/// Layer a profile's sparse preferences and per-instance surface overrides on\\n   128\\t/// top of shared user defaults. The shared document remains untouched.\\n   129\\tpub(in crate::shell) fn effective_profile_settings(\\n   130\\t    shared: SettingsStore,\\n   850\\t    }\\n   851\\t\\n   852\\t    pub(in crate::shell) fn load_installed_module_graph_cached(\\n   853\\t        &mut self,\\n   854\\t    ) -> Result<&InstalledModuleGraph, mesh_core_module::package::ModuleManifestError> {\\n   855\\t        if self.installed_module_graph.is_none() {\\n   856\\t            let graph_path = self.installed_module_graph_path();\\n   857\\t            let candidate = load_installed_module_graph_candidate(&graph_path)?;\\n   858\\t            let locale = self.prepare_locale_for_graph(&candidate).map_err(|error| {\\n   859\\t                mesh_core_module::packa