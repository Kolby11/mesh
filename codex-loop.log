{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/core/shell/src/shell/discovery.rs | sed -n '900,1145p'; nl -ba crates/core/shell/src/shell/discovery.rs | sed -n '1180,1325p'\"","aggregated_output":"   900\t        let active_graph = self.load_installed_module_graph_cached()?.clone();\n   901\t        self.sync_module_graph_health(&active_graph);\n   902\t        let mut effective_capabilities = HashMap::with_capacity(self.modules.len());\n   903\t        for (module_id, module) in &self.modules {\n   904\t            if !active_graph\n   905\t                .module(module_id)\n   906\t                .is_some_and(|node| node.enabled)\n   907\t            {\n   908\t                continue;\n   909\t            }\n   910\t            let effective = self.capability_policy.resolve(\n   911\t                module_id,\n   912\t                &module.manifest.capabilities.required,\n   913\t                &module.manifest.capabilities.optional,\n   914\t            )?;\n   915\t            effective_capabilities.insert(module_id.clone(), effective);\n   916\t        }\n   917\t        self.effective_capabilities = Arc::new(effective_capabilities);\n   918\t        let ids: Vec<String> = self.modules.keys().cloned().collect();\n   919\t        for id in ids {\n   920\t            if let Some(module) = self.modules.get_mut(&id) {\n   921\t                if module.state == ModuleState::Discovered && active_graph.module(&id).is_some() {\n   922\t                    if let Err(e) = module.transition(ModuleState::Resolved) {\n   923\t                        tracing::warn!(\"failed to resolve module {id}: {e}\");\n   924\t                    }\n   925\t                }\n   926\t            }\n   927\t        }\n   928\t        Ok(())\n   929\t    }\n   930\t\n   931\t    pub fn module(&self, id: &str) -> Option<&ModuleInstance> {\n   932\t        self.modules.get(id)\n   933\t    }\n   934\t\n   935\t    pub fn modules(&self) -> impl Iterator<Item = (&str, ModuleState)> {\n   936\t        self.modules\n   937\t            .iter()\n   938\t            .map(|(id, inst)| (id.as_str(), inst.state))\n   939\t    }\n   940\t\n   941\t    pub(super) fn load_frontend_components(&mut self) -> Result<(), ShellRunError> {\n   942\t        if !self.components.is_empty() {\n   943\t            return Ok(());\n   944\t        }\n   945\t\n   946\t        let graph = self.load_installed_module_graph_cached()?.clone();\n   947\t        let frontend_catalog = FrontendCatalog::from_modules(&self.modules, Some(&graph))?;\n   948\t        self.frontend_catalog.replace(frontend_catalog, None);\n   949\t        let frontend_catalog = self.frontend_catalog.snapshot().catalog;\n   950\t        let enabled_frontends = self.installed_enabled_frontend_ids();\n   951\t        let graph_i18n_catalogs = self.graph_i18n_catalog_paths();\n   952\t        let interface_catalog = std::sync::Arc::new(self.interfaces.resolved_catalog());\n   953\t        if let Some(profile_id) = self.active_profile_id.clone() {\n   954\t            let paths = mesh_core_module::package::ProfilePaths::from_root_graph(\n   955\t                &self.installed_module_graph_path(),\n   956\t            )?;\n   957\t            let profile = paths.load(&profile_id)?;\n   958\t            let entries = frontend_catalog\n   959\t                .top_level_surfaces()\n   960\t                .into_iter()\n   961\t                .map(|entry| (entry.compiled.manifest.package.id.clone(), entry))\n   962\t                .collect::<HashMap<_, _>>();\n   963\t            for (instance_id, root) in profile.roots.iter().filter(|(_, root)| root.active) {\n   964\t                let entry = entries.get(&root.module).ok_or_else(|| {\n   965\t                    ShellRunError::FrontendComposition {\n   966\t                        message: format!(\n   967\t                            \"profile root {instance_id} has no mountable frontend entrypoint\"\n   968\t                        ),\n   969\t                    }\n   970\t                })?;\n   971\t                self.register_component(Box::new(\n   972\t                    FrontendSurfaceComponent::new(\n   973\t                        entry.compiled.clone(),\n   974\t                        entry.module_dir.clone(),\n   975\t                        self.frontend_catalog.clone(),\n   976\t                        interface_catalog.clone(),\n   977\t                        self.settings_store.clone(),\n   978\t                    )\n   979\t                    .with_effective_capabilities(self.effective_capabilities.clone())\n   980\t                    .with_instance_id(instance_id)\n   981\t                    .with_graph_i18n_catalogs(graph_i18n_catalogs.clone()),\n   982\t                ));\n   983\t            }\n   984\t            return Ok(());\n   985\t        }\n   986\t        for entry in frontend_catalog.top_level_surfaces_filtered(Some(&enabled_frontends)) {\n   987\t            self.register_component(Box::new(\n   988\t                FrontendSurfaceComponent::new(\n   989\t                    entry.compiled,\n   990\t                    entry.module_dir,\n   991\t                    self.frontend_catalog.clone(),\n   992\t                    interface_catalog.clone(),\n   993\t                    self.settings_store.clone(),\n   994\t                )\n   995\t                .with_effective_capabilities(self.effective_capabilities.clone())\n   996\t                .with_graph_i18n_catalogs(graph_i18n_catalogs.clone()),\n   997\t            ));\n   998\t        }\n   999\t\n  1000\t        Ok(())\n  1001\t    }\n  1002\t\n  1003\t    pub(in crate::shell) fn activate_frontend_module(\n  1004\t        &mut self,\n  1005\t        module_id: &str,\n  1006\t        graph: &InstalledModuleGraph,\n  1007\t    ) -> Result<VecDeque<CoreRequest>, ShellRunError> {\n  1008\t        let previous_catalog = self.frontend_catalog.snapshot().catalog;\n  1009\t        let catalog = FrontendCatalog::from_modules_reusing(\n  1010\t            &self.modules,\n  1011\t            Some(graph),\n  1012\t            Some(&previous_catalog),\n  1013\t        )?;\n  1014\t        let entry = catalog\n  1015\t            .top_level_surfaces()\n  1016\t            .into_iter()\n  1017\t            .find(|entry| entry.compiled.manifest.package.id == module_id);\n  1018\t        let previous_catalog = self.frontend_catalog.replace(catalog, None);\n  1019\t\n  1020\t        let Some(entry) = entry else {\n  1021\t            // Widgets and component-only frontend packages own no surface.\n  1022\t            self.sync_frontend_catalog_components();\n  1023\t            return Ok(VecDeque::new());\n  1024\t        };\n  1025\t        let instance_ids = if let Some(profile_id) = &self.active_profile_id {\n  1026\t            let paths = mesh_core_module::package::ProfilePaths::from_root_graph(\n  1027\t                &self.installed_module_graph_path(),\n  1028\t            )?;\n  1029\t            paths\n  1030\t                .load(profile_id)?\n  1031\t                .roots\n  1032\t                .into_iter()\n  1033\t                .filter(|(_, root)| root.active && root.module == module_id)\n  1034\t                .map(|(instance_id, _)| instance_id)\n  1035\t                .collect::<Vec<_>>()\n  1036\t        } else {\n  1037\t            vec![entry.compiled.surface_id().to_string()]\n  1038\t        };\n  1039\t        let existing = self\n  1040\t            .components\n  1041\t            .iter()\n  1042\t            .map(|runtime| runtime.surface_id.clone())\n  1043\t            .collect::<HashSet<_>>();\n  1044\t        let mounted = (|| {\n  1045\t            let interface_catalog = std::sync::Arc::new(self.interfaces.resolved_catalog());\n  1046\t            let mut mounted = Vec::new();\n  1047\t            for instance_id in instance_ids {\n  1048\t                if existing.contains(&instance_id) {\n  1049\t                    continue;\n  1050\t                }\n  1051\t                if let Some(module) = self.modules.get_mut(module_id) {\n  1052\t                    if let Err(error) = module.mark_loaded() {\n  1053\t                        tracing::warn!(\n  1054\t                            module_id,\n  1055\t                            \"frontend activation did not load module: {error}\"\n  1056\t                        );\n  1057\t                    }\n  1058\t                }\n  1059\t                let mut component = FrontendSurfaceComponent::new(\n  1060\t                    entry.compiled.clone(),\n  1061\t                    entry.module_dir.clone(),\n  1062\t                    self.frontend_catalog.clone(),\n  1063\t                    interface_catalog.clone(),\n  1064\t                    self.settings_store.clone(),\n  1065\t                )\n  1066\t                .with_effective_capabilities(self.effective_capabilities.clone())\n  1067\t                .with_instance_id(&instance_id)\n  1068\t                .with_graph_i18n_catalogs(self.graph_i18n_catalog_paths());\n  1069\t                let diagnostics = self\n  1070\t                    .diagnostics\n  1071\t                    .register_instance(module_id.to_string(), instance_id.clone());\n  1072\t                let mut requests = VecDeque::from(\n  1073\t                    component\n  1074\t                        .mount(ComponentContext {\n  1075\t                            component_id: module_id.to_string(),\n  1076\t                            surface_id: instance_id,\n  1077\t                            diagnostics,\n  1078\t                        })\n  1079\t                        .map_err(ShellRunError::Component)?,\n  1080\t                );\n  1081\t                component\n  1082\t                    .locale_changed(&self.locale)\n  1083\t                    .map_err(ShellRunError::Component)?;\n  1084\t                for state in self.latest_service_state.values() {\n  1085\t                    let event = ServiceEvent::Updated {\n  1086\t                        service: state.interface.clone(),\n  1087\t                        source_module: state.provider_id.clone(),\n  1088\t                        payload: state.state.clone(),\n  1089\t                    };\n  1090\t                    if component.observes_service_event(&event) {\n  1091\t                        requests.extend(\n  1092\t                            component\n  1093\t                                .handle_service_event(&event)\n  1094\t                                .map_err(ShellRunError::Component)?,\n  1095\t                        );\n  1096\t                    }\n  1097\t                }\n  1098\t                mounted.push((component, requests));\n  1099\t            }\n  1100\t            Ok::<_, ShellRunError>(mounted)\n  1101\t        })();\n  1102\t        let mounted = match mounted {\n  1103\t            Ok(mounted) => mounted,\n  1104\t            Err(error) => {\n  1105\t                if let Some(module) = self.modules.get_mut(module_id) {\n  1106\t                    let _ = module.mark_failed(error.to_string());\n  1107\t                }\n  1108\t                self.frontend_catalog.restore(previous_catalog);\n  1109\t                return Err(error);\n  1110\t            }\n  1111\t        };\n  1112\t        let mut requests = VecDeque::new();\n  1113\t        for (component, component_requests) in mounted {\n  1114\t            let module_id = component.id().to_string();\n  1115\t            requests.extend(component_requests);\n  1116\t            self.register_component(Box::new(component));\n  1117\t            if let Some(module) = self.modules.get_mut(&module_id) {\n  1118\t                let _ = module.mark_initialized();\n  1119\t                if let Err(error) = module.mark_running() {\n  1120\t                    tracing::warn!(\n  1121\t                        module_id,\n  1122\t                        \"frontend activation lifecycle transition failed: {error}\"\n  1123\t                    );\n  1124\t                }\n  1125\t            }\n  1126\t        }\n  1127\t        self.sync_frontend_catalog_components();\n  1128\t        tracing::info!(module_id, \"activated frontend module live\");\n  1129\t        Ok(requests)\n  1130\t    }\n  1131\t\n  1132\t    pub(in crate::shell) fn deactivate_frontend_module(\n  1133\t        &mut self,\n  1134\t        module_id: &str,\n  1135\t        graph: Option<&InstalledModuleGraph>,\n  1136\t    ) -> Result<VecDeque<CoreRequest>, ShellRunError> {\n  1137\t        let previous_catalog = self.frontend_catalog.snapshot().catalog;\n  1138\t        let catalog =\n  1139\t            FrontendCatalog::from_modules_reusing(&self.modules, graph, Some(&previous_catalog))?;\n  1140\t        self.frontend_catalog.replace(catalog, None);\n  1141\t        self.sync_frontend_catalog_components();\n  1142\t\n  1143\t        let indices = self\n  1144\t            .components\n  1145\t            .iter()\n  1180\t        tracing::info!(module_id, \"deactivated frontend module live\");\n  1181\t        let mut requests = VecDeque::new();\n  1182\t        for surface_id in removed_surfaces {\n  1183\t            match self.broadcast_core_event(CoreEvent::SurfaceVisibilityChanged {\n  1184\t                surface_id,\n  1185\t                visible: false,\n  1186\t            }) {\n  1187\t                Ok(next) => requests.extend(next),\n  1188\t                Err(error) => tracing::warn!(\n  1189\t                    module_id,\n  1190\t                    \"frontend was disabled but its visibility notification failed: {error}\"\n  1191\t                ),\n  1192\t            }\n  1193\t        }\n  1194\t        Ok(requests)\n  1195\t    }\n  1196\t\n  1197\t    pub(in crate::shell) fn sync_frontend_catalog_components(&mut self) -> bool {\n  1198\t        let mut invalidated = false;\n  1199\t        for runtime in &mut self.components {\n  1200\t            invalidated |= runtime.component.frontend_catalog_changed();\n  1201\t        }\n  1202\t        if invalidated {\n  1203\t            self.service_delivery_index.mark_dirty();\n  1204\t            self.components_want_render = true;\n  1205\t        }\n  1206\t        invalidated\n  1207\t    }\n  1208\t\n  1209\t    fn graph_i18n_catalog_paths(&self) -> Vec<(String, String, PathBuf)> {\n  1210\t        let Some(graph) = self.installed_module_graph.as_ref() else {\n  1211\t            return Vec::new();\n  1212\t        };\n  1213\t        graph\n  1214\t            .contributed_i18n()\n  1215\t            .iter()\n  1216\t            .filter_map(|catalog| {\n  1217\t                let module_dir = catalog.source.manifest_path.parent()?;\n  1218\t                Some((\n  1219\t                    catalog.module_id.clone(),\n  1220\t                    catalog.locale.clone(),\n  1221\t                    module_dir.join(&catalog.path),\n  1222\t                ))\n  1223\t            })\n  1224\t            .collect()\n  1225\t    }\n  1226\t\n  1227\t    fn installed_enabled_frontend_ids(&self) -> HashSet<String> {\n  1228\t        let graph = self\n  1229\t            .installed_module_graph\n  1230\t            .as_ref()\n  1231\t            .expect(\"frontend loading requires a validated installed module graph\");\n  1232\t        let mut enabled = graph\n  1233\t            .frontend_modules()\n  1234\t            .into_iter()\n  1235\t            .map(|module| module.id.clone())\n  1236\t            .collect::<HashSet<_>>();\n  1237\t        enabled.insert(BUILTIN_DEBUG_INSPECTOR_ID.to_string());\n  1238\t        enabled\n  1239\t    }\n  1240\t\n  1241\t    pub(super) fn register_component(&mut self, component: Box<dyn ShellComponent>) {\n  1242\t        let surface_id = component.surface_id().to_string();\n  1243\t        let initial_visibility = component\n  1244\t            .initial