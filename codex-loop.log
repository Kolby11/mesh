   514\\t\\n   515\\t/// A lookup handle restricted to one module's catalogs.\\n   516\\t///\\n   517\\t/// The handle deliberately borrows the engine so callers cannot accidentally\\n   518\\t/// retain a copied global pool. A new handle observes the engine's current\\n   519\\t/// locale chain and catalog contents immediately.\\n   520\\t#[derive(Debug, Clone)]\\n   521\\tpub struct ModuleTranslator<'a> {\\n   522\\t    engine: &'a LocaleEngine,\\n   523\\t    module_id: String,\\n   524\\t}\\n   525\\t\\n   526\\timpl ModuleTranslator<'_> {\\n   527\\t    pub fn module_id(&self) -> &str {\\n   528\\t        &self.module_id\\n   529\\t    }\\n   530\\t\\n   531\\t    pub fn locale(&self) -> &str {\\n   532\\t        self.engine.current()\\n   533\\t    }\\n   534\\t\\n   535\\t    pub fn snapshot_revision(&self) -> u64 {\\n   536\\t        self.engine.catalog_snapshot().revision()\\n   537\\t    }\\n   538\\t\\n   539\\t    pub fn translate(&self, key: &str) -> Option<&str> {\\n   540\\t        self.engine\\n   541\\t            .translate_in_module(key, &self.module_id)\\n   542\\t            .and_then(CatalogEntry::default_text)\\n   543\\t    }\\n   544\\t\\n   545\\t    pub fn translate_with(&self, key: &str, args: &HashMap<String, String>) -> Option<String> {\\n   546\\t        let template = self.engine.resolve_in_module(key, &self.module_id, args)?;\\n   547\\t        interpolate(template, args)\\n   548\\t    }\\n   549\\t\\n   550\\t    /// Resolve a localized value with one shared fallback and miss policy.\\n   551\\t    /// The source is cloned from the immutable snapshot so the result remains\\n   552\\t    /// useful after a later catalog replacement.\\n   553\\t    pub fn resolve(&self, key: &str, fallback: Option<&str>) -> LocalizedTextResolution {\\n   554\\t        let source = self.source(key).cloned();\\n   555\\t        let translated = self.translate(key).map(str::to_owned);\\n   556\\t        let text = translated\\n   557\\t            .or_e