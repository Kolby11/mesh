{"type":"item.completed","item":{"id":"item_92","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"sed -n '1,100p' crates/core/runtime/scripting/src/context/errors.rs; sed -n '1,120p' crates/core/runtime/scripting/src/context.rs\"","aggregated_output":"use mesh_core_capability::CapabilitySet;\nuse serde_json::Value;\n\n#[derive(Debug, Clone)]\npub struct PublishedEvent {\n    pub channel: String,\n    pub payload: Value,\n    pub source_module_id: String,\n    pub source_capabilities: CapabilitySet,\n    /// Stable identity for a service invocation published by a Luau proxy.\n    /// Other published events leave this unset and retain their legacy route.\n    pub call_id: Option<u64>,\n    /// The originating frontend instance, used to deliver a terminal service\n    /// result back to the ticket that published it.\n    pub source_instance_id: Option<String>,\n}\n\n#[derive(Debug, Clone, PartialEq)]\npub struct ServiceCallCompletion {\n    pub status: String,\n    pub result: Value,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct ScriptDiagnostic {\n    pub module_id: String,\n    pub interface: String,\n    pub requested_version: Option<String>,\n    pub reason: String,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct ScriptInterfaceImport {\n    pub alias: String,\n    pub interface: String,\n    pub version: Option<String>,\n}\n\n/// Errors from the scripting runtime.\n#[derive(Debug, Clone, thiserror::Error)]\npub enum ScriptError {\n    #[error(\"Luau error: {0}\")]\n    LuaError(String),\n\n    #[error(\"script init failed: {0}\")]\n    InitFailed(String),\n\n    #[error(\"handler not found: {0}\")]\n    HandlerNotFound(String),\n\n    #[error(\"capability denied: {0}\")]\n    CapabilityDenied(String),\n\n    #[error(\"operation rejected: {0}\")]\n    OperationRejected(String),\n\n    #[error(\"script execution timed out\")]\n    Timeout,\n\n    #[error(\"interface unavailable: {0}\")]\n    InterfaceUnavailable(String),\n\n    #[error(\"unsupported interface operation: {interface}.{method}\")]\n    UnsupportedOperation { interface: String, method: String },\n}\nmod element_ref;\nmod errors;\nmod lookup;\nmod proxy;\nmod runtime;\nmod state;\n\npub use element_ref::ElementAction;\npub use errors::{\n    PublishedEvent, ScriptDiagnostic, ScriptError, ScriptInterfaceImport, ServiceCallCompletion,\n};\npub use runtime::{ScriptContext, SurfaceVm};\npub use state::{LocaleBoundState, ScriptState};\n\n#[cfg(test)]\nmod tests;\n","exit_code":0,"status":"completed"}}
