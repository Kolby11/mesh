\")]\n    24\tenum JournalPhase {\n    25\t    Prepared,\n    26\t    Applying,\n    27\t    Committed,\n    28\t    Aborted,\n    29\t}\n    30\t\n    31\t#[derive(Debug, Clone, Serialize, Deserialize)]\n    32\t#[serde(rename_all = \"camelCase\")]\n    33\tstruct JournalTarget {\n    34\t    /// Path relative to the transaction's configuration directory.\n    35\t    target: String,\n    36\t    /// Path relative to the transaction workspace, or absent when the target\n    37\t    /// did not exist at protection time.\n    38\t    backup: Option<String>,\n    39\t}\n    40\t\n    41\t#[derive(Debug, Clone, Serialize, Deserialize)]\n    42\t#[serde(rename_all = \"camelCase\")]\n    43\tstruct Journal {\n    44\t    schema_version: u32,\n    45\t    operation: String,\n    46\t    workspace: String,\n    47\t    phase: JournalPhase,\n    48\t    targets: Vec<JournalTarget>,\n    49\t}\n    50\t\n    51\t/// One serialized package mutation.\n    52\tpub struct PackageTransaction {\n    53\t    config_dir: PathBuf,\n    54\t    journal_path: PathBuf,\n    55\t    workspace: PathBuf,\n    56\t    journal: Journal,\n    57\t    lock_file: File,\n    58\t    finished: bool,\n    59\t}\n    60\t\n    61\timpl std::fmt::Debug for PackageTransaction {\n    62\t    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n    63\t        formatter\n    64\t            .debug_struct(\"PackageTransaction\")\n    65\t            .field(\"config_dir\", &self.config_dir)\n    66\t            .field(\"journal_path\", &self.journal_path)\n    67\t            .field(\"workspace\", &self.workspace)\n    68\t            .field(\"journal\", &self.journal)\n    69\t            .finish_non_exhaustive()\n    70\t    }\n    71\t}\n    72\t\n    73\timpl PackageTransaction {\n    74\t    /// Acquire the package lock and recover a prior interrupted operation.\n    75\t    ///\n    76\t    /// The lock is held by the returned value for its entire lifetime.  On\n    77\t    /// Unix this is a blocking `flock`, so a second CLI invocation waits rather\n    78\t    /// than racing a shell IPC request.  The journal is intentionally a fixed\n    79\t    /// path: there can be at most one package transaction per configuration\n    80\t    /// directory.\n    81\t    pub fn begin(\n    82\t        config_dir: &Path,\n    83\t        operation: impl Into<String>,\n    84\t    ) -> Result<Self, ModuleManifestError> {\n    85\t        let config_dir = canonical_config_dir(config_dir)?;\n    86\t        fs::create_dir_all(&config_dir).map_err(|source| ModuleManifestError::Io {\n    87\t            path: config_dir.clone(),\n    88\t            source,\n    89\t        })?;\n    90\t\n    91\t        let lock_path = config_dir.join(LOCK_FILE);\n    92\t        let lock_file = OpenOptions::new()\n    93\t            .create(true)\n    94\t            .read(true)\n    95\t            .write(true)\n    96\t            .open(&lock_path)\n    97\t            .map_err(|source| ModuleManifestError::Io {\n    98\t                path: lock_path.clone(),\n    99\t                source,\n   100\t            })?;\n   101\t        lock_exclusive(&lock_file).map_err(|source| ModuleManifestError::Io {\n   102\t            path: lock_path,\n   103\t            source,\n   104\t        })?;\n   105\t\n   106\t        let journal_path = config_dir.join(JOURNAL_FILE);\n   107\t        recover_journal(&config_dir, &journal_path)?;\n   108\t\n   109\t        let workspace_name = format!(\n   110\t            \"{WORKSPACE_PREFIX}{}-{}\",\n   111\t            std::process::id(),\n   112\t            monotonic_nonce()\n   113\t        );\n   114\t        let workspace = contained_path(&config_dir, &workspace_name, \"transaction workspace\")\n   115\t            .map_err(|error| error)?;\n   116\t        let staging = workspace.join(\"staging\");\n   117\t        fs::create_dir_all(&staging).map_err(|source| ModuleManifestError::Io {\n   118\t            path: staging,\n   119\t            source,\n   120\t        })?;\n   121\t\n   122\t        let journal = Journal {\n   123\t            schema_version: JOURNAL_SCHEMA_VERSION,\n   124\t            operation: operation.into(),\n   125\t            workspace: workspace_name,\n   126\t            phase: JournalPhase::Prepared,\n   127\t            targets: Vec::new(),\n   128\t        };\n   129\t        let transaction = Self {\n   130\t            config_dir,\n   131\t            journal_path,\n   132\t            workspace,\n   133\t            journal,\n   134\t            lock_file,\n   135\t            finished: false,\n   136\t        };\n   137\t        transaction.persist_journal()?;\n   138\t        Ok(transaction)\n   139\t    }\n   140\t\n   141\t    /// The directory for Git checkouts and other candidate materialization.\n   142\t    /// It is never part of the live module tree.\n   143\t    pub fn staging_dir(&self) -> PathBuf {\n   144\t        self.workspace.join(\"staging\")\n   145\t    }\n   146\t\n   147\t    /// Protect a file or directory before the caller mutates it.\n   148\t    ///\n   149\t    /// Protection is idempotent so callers can conservatively protect a whole\n   150\t    /// package state set and then protect a more specific destination.\n   151\t    pub fn protect(&mut self, path: &Path) -> Result<(), ModuleManifestError> {\n   152\t        let relative = self.relative_target(path)?;\n   153\t        if self\n   154\t            .journal\n   155\t            .targets\n   156\t            .iter()\n   157\t            .any(|target| target.target == relative)\n   158\t        {\n   159\t            return Ok(());\n   160\t        }\n   161\t\n   162\t        let target = self.config_dir.join(&relative);\n   163\t        let metadata = match fs::symlink_metadata(&target) {\n   164\t            Ok(metadata) => Some(metadata),\n   165\t            Err(error) if error.kind() == std::io::ErrorKind::NotFound => None,\n   166\t            Err(source) => {\n   167\t                return Err(ModuleManifestError::Io {\n   168\t                    path: target,\n   169\t                    source,\n   170\t                });\n   171\t            }\n   172\t        };\n   173\t        let backup = if let Some(metadata) = metadata {\n   174\t            if metadata.file_type().is_symlink() {\n   175\t                return Err(ModuleManifestError::Validation(format!(\n   176\t                    \"transaction target {} must not be a symlink\",\n   177\t                    target.display()\n   178\t                )));\n   179\t            }\n   180\t            let backup_relative = format!(\"backup/{}\", self.journal.targets.len());\n   181\t            let backup_path = self.workspace.join(&backup_relative);\n   182\t            copy_path(&target, &backup_path, &metadata)?;\n   183\t            Some(backup_relative)\n   184\t        } else {\n   185\t            None\n   186\t        };\n   187\t\n   188\t        self.journal.targets.push(JournalTarget {\n   189\t            target: relative,\n   190\t            backup,\n   191\t        });\n   192\t        self.journal.phase = JournalPhase::Applying;\n   193\t        self.persist_journal()\n   194\t    }\n   195\t\n   196\t    /// Protect the complete durable package state shared by install, update,\n   197\t    /// uninstall, and rollback.\n   198\t    pub fn protect_package_state(\n   199\t        &mut self,\n   200\t        root_graph: &Path,\n   201\t        modules_dir: &Path,\n   202\t    ) -> Result<(), ModuleManifestError> {\n   203\t        let config_dir = self.config_dir.clone();\n   204\t        for path in [\n   205\t            root_graph.to_path_buf(),\n   206\t            modules_dir.to_path_buf(),\n   207\t            config_dir.join(\"mesh.lock\"),\n   208\t            config_dir.join(\"lock-history\"),\n   209\t            config_dir.join(\"profiles\"),\n   210\t            config_dir.join(\"active-profile\"),\n   211\t            config_dir.join(