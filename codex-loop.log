        let bound = LocaleBoundState::new(&state, self.locale.module_translator(&host.package.id));\n   642\t        let prepared_styles = {\n   643\t            let cached = self.prepared_component_styles.borrow();\n   644\t            cached\n   645\t                .get(&host.package.id)\n   646\t                .and_then(|components| components.get(alias))\n   647\t                .cloned()\n   648\t        }\n   649\t        .unwrap_or_else(|| {\n   650\t            let prepared = Arc::new(mesh_core_frontend::PreparedComponentStyleRules::new(\n   651\t                component, host_rules,\n   652\t            ));\n   653\t            self.prepared_component_styles\n   654\t                .borrow_mut()\n   655\t                .entry(host.package.id.clone())\n   656\t                .or_default()\n   657\t                .insert(alias.to_string(), Arc::clone(&prepared));\n   658\t            prepared\n   659\t        });\n   660\t        let node =\n   661\t            mesh_core_frontend::build_embedded_widget_tree_from_component_with_prepared_styles(\n   662\t                component,\n   663\t                host,\n   664\t                &theme,\n   665\t                container_width,\n   666\t                container_height,\n   667\t                Some(self),\n   668\t                instance_key,\n   669\t                Some(&bound),\n   670\t                &prepared_styles,\n   671\t            );\n   672\t        node\n   673\t    }\n   674\t\n   675\t    pub(super) fn render_embedded_instance(\n   676\t        &self,\n   677\t        instance_key: &str,\n   678\t        module_id: &str,\n   679\t        props: &HashMap<String, serde_json::Value>,\n   680\t        container_width: f32,\n   681\t        container_height: f32,\n   682\t    ) -> WidgetNode {\n   683\t        if render_stack_contains_cycle(&self.render_stack.borrow(), module_id) {\n   684\t            return self.build_error_widget(format!(\"composition cycle blocked for '{module_id