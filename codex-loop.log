\"theme_id\", \"string\"),\n   544\t                (\"mode\", \"string?\"),\n   545\t                (\"mode_policy\", \"object?\"),\n   546\t                (\"color_scheme\", \"string?\"),\n   547\t                (\"contrast\", \"string?\"),\n   548\t                (\"tokens\", \"object?\"),\n   549\t                (\"provenance\", \"object?\"),\n   550\t                (\"revision\", \"string\"),\n   551\t                (\"fingerprint\", \"integer?\"),\n   552\t                (\"is_dark\", \"boolean\"),\n   553\t                (\"themes\", \"object[]\"),\n   554\t                (\"available\", \"string[]\"),\n   555\t                (\"system_resources\", \"object\"),\n   556\t            ],\n   557\t            &[\n   558\t                (\"set_theme\", &[(\"theme_id\", \"string\")]),\n   559\t                (\"set_icon_theme\", &[(\"theme_id\", \"string\")]),\n   560\t                (\"set_font_family\", &[(\"family\", \"string\")]),\n   561\t            ],\n   562\t        );\n   563\t        theme_contract.events = vec![\n   564\t            mesh_core_service::InterfaceEvent {\n   565\t                name: \"ThemeChanged\".into(),\n   566\t                payload: [\n   567\t                    (\"theme_id\", \"string\"),\n   568\t                    (\"mode\", \"string\"),\n   569\t                    (\"mode_policy\", \"object\"),\n   570\t                    (\"color_scheme\", \"string\"),\n   571\t                    (\"contrast\", \"string\"),\n   572\t                    (\"revision\", \"string\"),\n   573\t                    (\"tokens\", \"object\"),\n   574\t                    (\"provenance\", \"object\"),\n   575\t                    (\"changed_tokens\", \"object[]\"),\n   576\t                ]\n   577\t                .into_iter()\n   578\t                .map(|(name, arg_type)| mesh_core_service::InterfaceArgument {\n   579\t                    name: name.into(),\n   580\t                    arg_type: arg_type.into(),\n   581\t                })\n   582\t                .collect(),\n   583\t            },\n   584\t            mesh_core_service::InterfaceEvent {\n   585\t                name: \"TokenChanged\".into(),\n   586\t                payload: [\n   587\t                    (\"theme_id\", \"string\"),\n   588\t                    (\"mode\", \"string\"),\n   589\t                    (\"name\", \"string\"),\n   590\t                    (\"value\", \"any?\"),\n   591\t                    (\"provenance\", \"any?\"),\n   592\t                    (\"revision\", \"string\"),\n   593\t                ]\n   594\t                .into_iter()\n   595\t                .map(|(name, arg_type)| mesh_core_service::InterfaceArgument {\n   596\t                    name: name.into(),\n   597\t                    arg_type: arg_type.into(),\n   598\t                })\n   599\t                .collect(),\n   600\t            },\n   601\t        ];\n   602\t        interfaces.register_contract(theme_contract);\n   603\t        // Locale writes stay on the `mesh.locale.set` host API, which already\n   604\t        // enforces `locale.write`. A second, service-shaped way in would mean\n   605\t        // two capability names for one operation.\n   606\t        interfaces.register_contract(builtin_state_contract(\n   607\t            \"mesh.locale\",\n   608\t            &[\n   609\t                (\"current\", \"string\"),\n   610\t                (\"locale\", \"string\"),\n   611\t                (\"chain\", \"string[]\"),\n   612\t                (\"direction\", \"string\"),\n   613\t                (\"revision\", \"string\"),\n   614\t            ],\n   615\t        ));\n   616\t        interfaces.register_contract(builtin_contract(\n   617\t            \"mesh.settings\",\n   618\t            &[(\"revision\", \"string\"), (\"namespaces\", \"object\")],\n   619\t            &[\n   620\t                (\n   621\t                    \"set_prop\",\n   622\t                    &[\n   623\t                        (\"module_id\", \"string\"),\n   624\t                        (\"instance_id\", \"string?\"),\n   625\t                        (\"prop\", \"string\"),\n   626\t                        (\"value\", \"any\"),\n   627\t                    ],\n   628\t                ),\n   629\t                (\n   630\t                    \"unset_prop\",\n   631\t                    &[\n   632\t                        (\"module_id\", \"string\"),\n   633\t                        (\"instance_id\", \"string?\"),\n   634\t                        (\"prop\", \"string\"),\n   635\t                    ],\n   636\t                ),\n   637\t            ],\n   638\t        ));\n   639\t        interfaces.register_contract(builtin_contract(\n   640\t            \"mesh.packages\",\n   860\t            })?;\n   861\t            self.commit_installed_module_graph_with_locale(candidate, locale);\n   862\t        }\n   863\t        Ok(self\n   864\t            .installed_module_graph\n   865\t            .as_ref()\n   866\t            .expect(\"installed module graph was just loaded\"))\n   867\t    }\n   868\t\n   869\t    /// Read a replacement graph without changing the active graph. Callers\n   870\t    /// that prepare a live activation use this boundary so a malformed or\n   871\t    /// incomplete on-disk candidate cannot discard the last-known-good graph.\n   872\t    pub(in crate::shell) fn load_installed_module_graph_candidate(\n   873\t        &self,\n   874\t    ) -> Result<InstalledModuleGraph, mesh_core_module::package::ModuleManifestError> {\n   875\t        load_installed_module_graph_candidate(&self.installed_module_graph_path())\n   876\t    }\n   877\t\n   878\t    #[cfg(test)]\n   879\t    pub(in crate::shell) fn reload_installed_module_graph_at(\n   880\t        &mut self,\n   881\t        root_module_graph_path: &Path,\n   882\t    ) -> Result<InstalledModuleGraph, mesh_core_module::package::ModuleManifestError> {\n   883\t        let candidate = load_installed_module_graph_candidate(root_module_graph_path)?;\n   884\t        self.commit_installed_module_graph(candidate.clone())\n   885\t            .map_err(|error| {\n   886\t                mesh_core_module::package::ModuleManifestError::Validation(error.to_string())\n   887\t            })?;\n   888\t        Ok(candidate)\n   889\t    }\n   890\t\n   891\t    pub(in crate::shell) fn prepare_locale_for_graph(\n   892\t        &self,\n   893\t        graph: &InstalledModuleGraph,\n   894\t    ) -> Result<LocaleEngine, ShellRunError> {\n   895\t        let mut candidate = self.locale.clone();\n   896\t        let (sources, defaults) = graph_i18n_catalog_sources(graph);\n   897\t        let prepared = candidate\n   898\t            .prepare_catalog_snapshot(&sources, &defaults)\n   899\t            .map_err(|error| ShellRunError::LocaleCatalog(error.to_string()))?;\n   900\t        log_locale_catalog_diagnostics(prepared.diagnostics());\n   901\t        candidate.replace_catalog_snapshot(prepared.snapshot());\n   902\t        Ok(candidate)\n   903\t    }\n   904\t\n   905\t    pub(in crate::shell) fn prepare_locale_for_settings(\n   906\t        &self,\n   907\t        settings: &ShellSettings,\n   908\t        graph: &InstalledModuleGraph,\n   909\t    ) -> Result<LocaleEngine, ShellRunError> {\n   910\t        let mut candidate = self.prepare_locale_selection_for_settings(settings)?;\n   911\t        let (sources, defaults) = graph_i18n_catalog_sources(graph);\n   912\t        let prepared = candidate\n   913\t            .prepare_catalog_snapshot(&sources, &defaults)\n   914\t            .map_err(|error| ShellRunError::LocaleCatalog(error.to_string()))?;\n   915\t        log_locale_catalog_diagnostics(prepared.diagnostics());\n   916\t        candidate.replace_catalog_snapshot(prepared.snapshot());\n   917\t        Ok(candidate)\n   918\t    }\n   919\t\n   920\t    pub(in crate::shell) fn prepare_locale_selection_for_settings(\n   921\t        &self,\n   922\t        settings: &ShellSettings,\n   923\t    ) -> Result<LocaleEngine, ShellRunError> {\n   924\t        let requested = mesh_core_locale::LocaleSelection::try_new(\n   925\t            settings.i18n.locale.clone(),\n   926\t            settings.i18n.fallback_locale.clone(),\n   927\t            1,\n   928\t        )\n   929\t        .map_err(|error| ShellRunError::LocaleCatalog(error.to_string()))?;\n   930\t        let revision = if requested.active() == self.locale.current()\n   931\t            && requested.fallback() == self.locale.fallback_locale()\n   932\t        {\n   933\t            self.locale.revision()\n   934\t        } else {\n   935\t            self.locale.revision().saturating_add(1)\n   936\t        };\n   937\t        let selection = mesh_core_locale::LocaleSelection::try_new(\n   938\t            requested.active(),\n   939\t            requested.fallback(),\n   940\t            revision,\n   941\t        )\n   942\t        .map_err(|error| ShellRunError::LocaleCatalog(error.to_string()))?;\n   943\t        let mut candidate = self.locale.clone();\n   944\t        candidate.replace_selection(&selection);\n   945\t        Ok(candidate)\n   946\t    }\n   947\t\n   948\t    /// Commit a graph and its prepared locale candidate as one in-memory\n   949\t    /// activation boundary. Callers that need to prepare runtime objects first\n   950\t    /// use `commit_installed_module_graph_with_locale` with the same candidate.\n   951\t    pub(in crate::shell) fn commit_installed_module_graph(\n   952\t        &mut self,\n   953\t        graph: InstalledModuleGraph,\n   954\t    ) -> Result<(), ShellRunError> {\n   955\t        let locale = self.prepare_locale_for_graph(&graph)?;\n   956\t        self.commit_installed_module_graph_with_locale(graph, locale);\n   957\t        Ok(())\n   958\t    }\n   959\t\n   960\t    pub(in crate::shell) fn commit_installed_module_graph_with_locale(\n   961\t        &mut self,\n   962\t        graph: InstalledModuleGraph,\n   963\t        locale: LocaleEngine,\n   964\t    ) {\n   965\t        self.sync_module_graph_health(&graph);\n   966\t        self.locale = locale;\n   967\t        self.installed_module_graph = Some(graph);\n   968\t    }\n   969\t\n   970\t    /// Project immutable graph diagnostics into the live module records. The\n   971\t    /// graph remains static and reloadable; runtime failures are recorded on\n   972\t    /// the corresponding ModuleInstance instead of mutating this snapshot.\n   973\t    fn sync_module_graph_health(&mut self, graph: &InstalledModuleGraph) {\n   974\t        for (module_id, module) in &mut self.modules {\n   975\t            let Some(node) = graph.module(module_id) else {\n   976\t                continue;\n   977\t            };\n   978\t            let diagnostics = graph\n   979\t                .diagnostics()\n   980\t                .iter()\n   981\t                .filter(|diagnostic| diagnostic.module_id == *module_id)\n   982\t                .map(|diagnostic| (diagnostic.status.as_str(), diagnostic.message.as_str()));\n   983\t            let health_records = graph\n   984\t                .health()\n   985\t                .iter()\n   986\t                .filter(|record| record.module_id == *module_id)\n   987\t                .map(|record| (record.status.as_str(), record.message.as_str()));\n   988\t\n   989\t            let mut unavailable_reason = None;\n   990\t            let mut degraded_reason = None;\n   430\t                .into_iter()\n   431\t                .map(|name| {\n   432\t                    serde_json::json!({\n   433\t                        \"name\": name,\n   434\t                        \"value\": snapshot.tokens.get(&name),\n   435\t                        \"provenance\": snapshot.provenance.get(&name),\n   436\t                    })\n   437\t                })\n   438\t                .collect::<Vec<_>>();\n   439\t            let revision = format!(\"{:016x}\", snapshot.revision);\n   440\t            requests.extend(self.broadcast_shell_interface_event(\n   441\t                \"mesh.theme\",\n   442\t                \"ThemeChanged\",\n   443\t                serde_json::json!({\n   444\t                    \"theme_id\": snapshot.id.clone(),\n   445\t                    \"mode\": snapshot.mode.clone(),\n   446\t                    \"mode_policy\": self.settings.theme.mode_policy.clone(),\n   447\t                    \"color_scheme\": snapshot.color_scheme.clone(),\n   448\t                    \"contrast\": snapshot.contrast.clone(),\n   449\t                    \"revision\": revision.clone(),\n   450\t                    \"tokens\": snapshot.tokens.clone(),\n   451\t                    \"provenance\": snapshot.provenance.clone(),\n   452\t                    \"changed_tokens\": changed_tokens,\n   453\t                }),\n   454\t            )?);\n   455\t            for name in snapshot.changed_token_names(previous_snapshot) {\n   456\t                requests.extend(self.broadcast_shell_interface_event(\n   457\t                    \"mesh.theme\",\n   458\t                    \"TokenChanged\",\n   459\t                    serde_json::json!({\n   460\t                        \"theme_id\": snapshot.id.clone(),\n   461\t                        \"mode\": snapshot.mode.clone(),\n   462\t                        \"name\": name,\n   463\t                        \"value\": snapshot.tokens.get(&name),\n   464\t                        \"provenance\": snapshot.provenance.get(&name),\n   465\t                        \"revision\": revision.clone(),\n   466\t                    }),\n   467\t                )?);\n   468\t            }\n   469\t        }\n   470\t        self.last_published_theme_snapshot = Some(snapshot);\n   471\t        Ok(requests)\n   472\t    }\n   473\t\n   474\t    pub(in crate::shell) fn reload_locale_if_settings_changed(\n   475\t        &mut self,\n   476\t    ) -> Result<VecDeque<CoreRequest>, ShellRunError> {\n   477\t        let mut requests = VecDeque::new();\n   478\t        let now = std::time::Instant::now();\n   479\t        if now < self.next_shell_settings_reload_check {\n   480\t            return Ok(requests);\n   481\t        }\n   482\t        self.next_shell_settings_reload_check = now\n   483\t            + if self.file_watcher_active {\n   484\t                super::FILE_WATCHER_RELOAD_PARK\n   485\t            } else {\n   486\t                SHELL_SETTINGS_RELOAD_POLL_INTERVAL\n   487\t            };\n   488\t\n   489\t        let Ok(metadata) = std::fs::metadata(&self.settings_watch.path) else {\n   490\t            return Ok(requests);\n   491\t        };\n   492\t        let Ok(modified_at) = metadata.modified() else {\n   493\t            return Ok(requests);\n   494\t        };\n   495\t\n   496\t        if self.settings_watch.modified_at == Some(modified_at) {\n   497\t            return Ok(requests);\n   498\t        }\n   499\t\n   500\t        self.settings_watch.modified_at = Some(modified_at);\n   501\t\n   502\t        let store = match SettingsStore::load().and_then(|shared| {\n   503\t            let profile = self.active_profile_id.as_ref().and_then(|profile_id| {\n   504\t                mesh_core_module::package::ProfilePaths::from_root_graph(\n   505\t                    &self.installed_module_graph_path(),\n   506\t                )\n   507\t                .and_then(|paths| paths.load(profile_id))\n   508\t                .ok()\n   509\t            });\n   510\t            super::super::discovery::effective_profile_settings(shared, profile.as_ref())\n   511\t        }) {\n   512\t            Ok(mut store) => {\n   513\t                if let Some(graph) = self.installed_module_graph.as_ref()\n   514\t                    && let Err(error) =\n   515\t                        super::super::discovery::register_graph_settings_schemas(&mut store, graph)\n   516\t                {\n   517\t                    tracing::warn!(\n   518\t                        \"failed to register settings schemas during reload; retaining previous snapshot: {error}\"\n   519\t                    );\n   520\t                    return Ok(requests);\n   521\t                }\n   522\t                Arc::new(store)\n   523\t            }\n   524\t            Err(e) => {\n   525\t                tracing::warn!(\"failed to reload settings: {e}\");\n   526\t                return Ok(requests);\n   527\t            }\n   528\t        };\n   529\t        mesh_core_config::log_settings_diagnostics(\n   530\t            \"settings reload\",\n   531\t            &mesh_core_config::new_settings_diagnostics(\n   532\t                self.settings_store.diagnostics(),\n   533\t                store.diagnostics(),\n   534\t            ),\n   535\t        );\n   536\t        let new_settings = store.shell().clone();\n   537\t\n   538\t        let old_theme = self.settings.theme.clone();\n   539\t        let old_i18n = self.settings.i18n.clone();\n   540\t        let old_icons = self.settings.icons.clone();\n   541\t        let old_fonts = self.settings.fonts.clone();\n   542\t        let new_i18n = &new_settings.i18n;\n   543\t        let locale_changed = old_i18n.locale != new_i18n.locale\n   544\t            || old_i18n.fallback_locale != new_i18n.fallback_locale;\n   545\t\n   546\t        let prepared_locale = if locale_changed {\n   547\t            let result = if let Some(graph) = self.installed_module_graph.as_ref() {\n   548\t                self.prepare_locale_for_settings(&new_settings, graph)\n   549\t            } else {\n   550\t                self.prepare_locale_selection_for_settings(&new_settings)\n   551\t            };\n   552\t            match result {\n   553\t                Ok(candidate) => Some(candidate),\n   554\t                Err(error) => {\n   555\t                    tracing::warn!(\n   556\t                        \"locale settings reload rejected; retaining prior snapshot: {error}\"\n   557\t                    );\n   558\t                    self.diagnostics.record_lifecycle_error(\n   559\t                        \"@mesh/shell\",\n   560\t                        \"locale_reload_rejected\",\n   561\t                        error.to_string(),\n   562\t                    );\n   563\t                    return Ok(requests);\n   564\t                }\n   565\t            }\n   566\t        } else {\n   567\t            None\n   568\t        };\n   569\t\n   570\t        let theme_changed = old_theme != new_settings.theme || old_fonts != new_settings.fonts;\n   571\t        if theme_changed {\n   572\t            let (theme, theme_watch) = if let Some(graph) =\n   573\t                self.installed_module_graph.as_ref().filter(|graph| {\n   574\t                    graph\n   575\t                        .theme_catalog()\n   576\t                        .get(&new_settings.theme.active)\n   577\t                        .is_some()\n   578\t                }) {\n   579\t                match prepare_theme_for_graph(&new_settings, graph) {\n   580\t                    Ok(candidate) => candidate,\n   581\t                    Err(error) => {\n   582\t                        self.record_theme_reload_failure(&error);\n   583\t                        return Ok(requests);\n   584\t                    }\n   585\t                }\n   586\t            } else {\n   587\t                load_active_theme(&new_settings)\n   588\t            };\n   589\t            let active_theme_id = theme.active().id.clone();\n   590\t            tracing::info!(\n   591\t                \"active theme changed: {} -> {}\",\n   592\t                old_theme.active,\n   593\t                active_theme_id\n   594\t            );\n   595\t            self.theme = theme;\n   596\t            self.theme_watch = theme_watch;\n   597\t            self.mark_components_theme_changed()?;\n   598\t            requests.extend(self.sync_theme_service_state()?);\n   599\t        }\n   600\t\n   601\t        if old_icons != new_settings.icons {\n   602\t            mesh_core_icon::set_default_shell_pack(new_settings.icons.default_pack.clone());\n   603\t            if !theme_changed {\n   604\t                self.mark_components_theme_changed()?;\n   605\t            }\n   606\t        }\n   607\t\n   608\t        if locale_changed {\n   609\t            tracing::info!(\n   610\t                \"locale changed: {} (fallback: {}) -> {} (fallback: {})\",\n   611\t                old_i18n.locale,\n   612\t                old_i18n.fallback_locale,\n   613\t                new_i18n.locale,\n   614\t                new_i18n.fallback_locale,\n   615\t            );\n   616\t            self.locale =\n   617\t                prepared_locale.expect(\"locale candidate was prepared when settings changed\");\n   618\t            self.mark_components_locale_changed()?;\n   619\t            requests.extend(self.sync_locale_service_state()?);\n   620\t        }\n   621\t\n   622\t        mesh_core_render::set_blur_quality(blur_quality_from_settings(&new_settings.render.blur));\n   623\t        self.settings = new_settings;\n   624\t        self.settings_store = store;\n   625\t        self.apply_settings_to_components()?;\n   626\t        requests.extend(self.sync_settings_service_state()?);\n   627\t\n   628\t        Ok(requests)\n   629\t    }\n   630\t\n   631\t    /// Hand the reloaded store to every component.\n   632\t    ///\n   633\t    /// One file holds every namespace, so a single reload here serves every\n   634\t    /// component: they all adopt the snapshot the shell just read.\n   635\t    pub(in crate::shell) fn apply_settings_to_components(&mut self) -> Result<(), ShellRunError> {\n   636\t        let store = self.settings_store.clone();\n   637\t        for runtime in &mut self.components {\n   638\t            let changed = runtime\n   639\t                .component\n   640\t                .apply_settings(&store)\n   641\t                .map_err(ShellRunError::Component)?;\n   642\t            if changed {\n   643\t                tracing::info!(\n   644\t                    \"settings changed for component '{}'\",\n   645\t                    runtime.component.id()\n   646\t                );\n   647\t            }\n   648\t        }\n   649\t        Ok(())\n   650\t    }\n   651\t\n   652\t    pub(in crate::shell) fn mark_components_locale_changed(&mut self) -> Result<(), ShellRunError> {\n   653\t        let locale = self.locale.clone();\n   654\t        let locale_id = locale.current().to_string();\n   655\t        for runtime in &mut self.components {\n   656\t            runtime\n   657\t                .component\n   658\t                .locale_changed(&locale)\n   659\t                .map_err(ShellRunError::Component)?;\n   660\t            runtime.parent.force_full_present = true;\n   661\t        }\n   662\t        let _ = self.broadcast_core_event(CoreEvent::LocaleChanged { locale: locale_id })?;\n   663\t        Ok(())\n   664\t    }\n   665\t\n   666\t    pub(in crate::shell) fn apply_set_locale(\n   667\t        &mut self,\n   668\t        locale: &str,\n   669\t    ) -> Result<VecDeque<CoreRequest>, ShellRunError> {\n   670\t        let locale = locale.trim();\n   671\t        if locale.is_empty() {\n   672\t            tracing::warn!(\"ignoring empty locale request\");\n   673\t            return Ok(VecDeque::new());\n   674\t        }\n   675\t        match self.locale.try_set_locale(locale) {\n   676\t            Ok(false) => return self.sync_locale_service_state(),\n   677\t            Ok(true) => tracing::info!(\"active locale changed to '{}'\", self.locale.current()),\n   678\t            Err(error) => {\n   679\t                tracing::warn!(%error, \"ignoring invalid locale request\");\n   680\t                return self.sync_locale_service_state();\n   681\t            }\n   682\t        }\n   683\t        self.mark_components_locale_changed()?;\n   684\t        self.sync_locale_service_state()\n   685\t    }\n   686\t\n   687\t    pub(in crate::shell) fn sync_locale_service_state(\n   688\t        &mut self,\n   689\t    ) -> Result<VecDeque<CoreRequest>, ShellRunError> {\n   690\t        let selection = self.locale.selection();\n   691\t        let locale = selection.active().to_string();\n   692\t        let chain = selection.chain().to_vec();\n   693\t        let direction = selection.direction().as_str();\n   694\t        let revision = selection.revision().to_string();\n   695\t        // As with theme, the shell supplies the host-derived snapshot while\n   696\t        // the selected provider owns the interface state observed by modules.\n   697\t        let source_module = self.active_service_provider_or(\"mesh.locale\", \"@mesh/shell\");\n   698\t        self.broadcast_service_event(ServiceEvent::Updated {\n   699\t            service: \"mesh.locale\".into(),\n   700\t            source_module,\n   701\t            payload: serde_json::json!({\n   702\t                \"locale\": locale.clone(),\n   703\t                \"current\": locale,\n   704\t                \"chain\": chain,\n   705\t                \"direction\": direction,\n   706\t                \"revision\": revision,\n   707\t            }),\n   708\t        })\n   709\t    }\n   710\t}\n","exit_code":0,"status":"completed"}}
