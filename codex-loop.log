{"type":"item.completed","item":{"id":"item_325","type":"agent_message","text":"The typed catalog line is complete and recorded. I’m taking one bounded slice of the next snapshot item now: make catalog contents an immutable, revisioned `Arc` snapshot inside `LocaleEngine`, with explicit replacement support so future graph/profile preparation can commit a candidate without mutating the last-known-good catalog in place."}}
{"type":"item.started","item":{"id":"item_326","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"sed -n '1,18p' crates/core/foundation/locale/src/lib.rs; nl -ba crates/core/foundation/locale/src/lib.rs | sed -n '290,570p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_326","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"sed -n '1,18p' crates/core/foundation/locale/src/lib.rs; nl -ba crates/core/foundation/locale/src/lib.rs | sed -n '290,570p'\"","aggregated_output":"//! System-wide locale management with per-module translation catalogs,\n//! fallback chains, and runtime locale switching.\n\nuse serde::{Deserialize, Serialize};\nuse std::collections::{BTreeMap, BTreeSet, HashMap};\n\nconst MAX_CATALOG_ENTRIES: usize = 4096;\nconst MAX_VARIANTS_PER_ENTRY: usize = 32;\nconst MAX_MESSAGE_LENGTH: usize = 16 * 1024;\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum LocaleDirection {\n    Ltr,\n    Rtl,\n}\n\nimpl LocaleDirection {\n   290\t    if remaining.contains('}') {\n   291\t        return Err(\"message contains an unmatched '}'\".into());\n   292\t    }\n   293\t    Ok(placeholders)\n   294\t}\n   295\t\n   296\tfn plural_category(locale: &str, count: f64) -> &'static str {\n   297\t    let language = locale.split('-').next().unwrap_or_default();\n   298\t    let integer = count.fract() == 0.0;\n   299\t    let absolute = count.abs();\n   300\t    if language == \"sk\" && integer {\n   301\t        if absolute == 1.0 {\n   302\t            \"one\"\n   303\t        } else if (2.0..=4.0).contains(&absolute) {\n   304\t            \"few\"\n   305\t        } else {\n   306\t            \"many\"\n   307\t        }\n   308\t    } else if language == \"fr\" && (absolute == 0.0 || absolute == 1.0) {\n   309\t        \"one\"\n   310\t    } else if absolute == 1.0 {\n   311\t        \"one\"\n   312\t    } else {\n   313\t        \"other\"\n   314\t    }\n   315\t}\n   316\t\n   317\t/// A lookup handle restricted to one module's catalogs.\n   318\t///\n   319\t/// The handle deliberately borrows the engine so callers cannot accidentally\n   320\t/// retain a copied global pool. A new handle observes the engine's current\n   321\t/// locale chain and catalog contents immediately.\n   322\t#[derive(Debug, Clone)]\n   323\tpub struct ModuleTranslator<'a> {\n   324\t    engine: &'a LocaleEngine,\n   325\t    module_id: String,\n   326\t}\n   327\t\n   328\timpl ModuleTranslator<'_> {\n   329\t    pub fn module_id(&self) -> &str {\n   330\t        &self.module_id\n   331\t    }\n   332\t\n   333\t    pub fn locale(&self) -> &str {\n   334\t        self.engine.current()\n   335\t    }\n   336\t\n   337\t    pub fn translate(&self, key: &str) -> Option<&str> {\n   338\t        self.engine\n   339\t            .translate_in_module(key, &self.module_id)\n   340\t            .and_then(CatalogEntry::default_text)\n   341\t    }\n   342\t\n   343\t    pub fn translate_with(&self, key: &str, args: &HashMap<String, String>) -> Option<String> {\n   344\t        let template = self.engine.resolve_in_module(key, &self.module_id, args)?;\n   345\t        interpolate(template, args)\n   346\t    }\n   347\t\n   348\t    /// Copy the effective module catalog for a consumer that crosses an\n   349\t    /// execution boundary, such as a Luau context.\n   350\t    pub fn translations(&self) -> HashMap<String, String> {\n   351\t        self.engine.effective_module_translations(&self.module_id)\n   352\t    }\n   353\t\n   354\t    pub fn entries(&self) -> HashMap<String, CatalogEntry> {\n   355\t        self.engine.effective_module_entries(&self.module_id)\n   356\t    }\n   357\t}\n   358\t\n   359\t/// An explicitly named core-domain translator. Core strings never participate\n   360\t/// in module lookup implicitly.\n   361\t#[derive(Debug, Clone, Copy)]\n   362\tpub struct CoreTranslator<'a> {\n   363\t    engine: &'a LocaleEngine,\n   364\t}\n   365\t\n   366\timpl CoreTranslator<'_> {\n   367\t    pub fn translate(&self, key: &str) -> Option<&str> {\n   368\t        self.engine\n   369\t            .translate_in_core(key)\n   370\t            .and_then(CatalogEntry::default_text)\n   371\t    }\n   372\t\n   373\t    pub fn translate_with(&self, key: &str, args: &HashMap<String, String>) -> Option<String> {\n   374\t        let template = self.engine.resolve_in_core(key, args)?;\n   375\t        interpolate(template, args)\n   376\t    }\n   377\t\n   378\t    pub fn translations(&self) -> HashMap<String, String> {\n   379\t        self.engine.effective_core_translations()\n   380\t    }\n   381\t}\n   382\t\n   383\t#[derive(Debug, Clone)]\n   384\tpub struct LocaleEngine {\n   385\t    selection: LocaleSelection,\n   386\t    translations: HashMap<String, HashMap<String, CatalogEntry>>,\n   387\t    /// `module_id → locale → key → value`.\n   388\t    module_translations: HashMap<String, HashMap<String, HashMap<String, CatalogEntry>>>,\n   389\t}\n   390\t\n   391\timpl LocaleEngine {\n   392\t    pub fn new(default_locale: impl Into<String>) -> Self {\n   393\t        Self::with_fallback_locale(default_locale, \"en\")\n   394\t    }\n   395\t\n   396\t    pub fn try_with_fallback_locale(\n   397\t        default_locale: impl Into<String>,\n   398\t        fallback_locale: impl Into<String>,\n   399\t    ) -> Result<Self, LocaleError> {\n   400\t        Ok(Self {\n   401\t            selection: LocaleSelection::try_new(default_locale.into(), fallback_locale.into(), 1)?,\n   402\t            translations: HashMap::new(),\n   403\t            module_translations: HashMap::new(),\n   404\t        })\n   405\t    }\n   406\t\n   407\t    pub fn with_fallback_locale(\n   408\t        default_locale: impl Into<String>,\n   409\t        fallback_locale: impl Into<String>,\n   410\t    ) -> Self {\n   411\t        match Self::try_with_fallback_locale(default_locale, fallback_locale) {\n   412\t            Ok(engine) => engine,\n   413\t            Err(error) => {\n   414\t                tracing::warn!(%error, \"invalid locale selection; using en\");\n   415\t                Self::try_with_fallback_locale(\"en\", \"en\")\n   416\t                    .expect(\"the built-in en locale must be valid\")\n   417\t            }\n   418\t        }\n   419\t    }\n   420\t\n   421\t    pub fn selection(&self) -> &LocaleSelection {\n   422\t        &self.selection\n   423\t    }\n   424\t\n   425\t    pub fn direction(&self) -> LocaleDirection {\n   426\t        self.selection.direction()\n   427\t    }\n   428\t\n   429\t    pub fn revision(&self) -> u64 {\n   430\t        self.selection.revision()\n   431\t    }\n   432\t\n   433\t    pub fn fallback_locale(&self) -> &str {\n   434\t        self.selection.fallback()\n   435\t    }\n   436\t\n   437\t    /// Adopt an already validated selection while retaining loaded catalogs.\n   438\t    pub fn replace_selection(&mut self, selection: &LocaleSelection) {\n   439\t        self.selection = selection.clone();\n   440\t    }\n   441\t\n   442\t    pub fn try_set_locale(&mut self, locale: impl AsRef<str>) -> Result<bool, LocaleError> {\n   443\t        let next = LocaleSelection::try_new(\n   444\t            locale,\n   445\t            self.selection.fallback(),\n   446\t            self.selection.revision().saturating_add(1),\n   447\t        )?;\n   448\t        if next.active == self.selection.active && next.fallback == self.selection.fallback {\n   449\t            return Ok(false);\n   450\t        }\n   451\t        self.selection = next;\n   452\t        Ok(true)\n   453\t    }\n   454\t\n   455\t    pub fn current(&self) -> &str {\n   456\t        self.selection.active()\n   457\t    }\n   458\t\n   459\t    pub fn set_locale(&mut self, locale: impl Into<String>) {\n   460\t        if let Err(error) = self.try_set_locale(locale.into()) {\n   461\t            tracing::warn!(%error, \"ignoring invalid locale selection\");\n   462\t        }\n   463\t    }\n   464\t\n   465\t    /// Load a catalog owned by the explicit core domain.\n   466\t    pub fn load_core_translations(&mut self, set: TranslationSet) {\n   467\t        let locale = catalog_locale(&set.locale);\n   468\t        self.translations.entry(locale).or_default().extend(\n   469\t            set.messages\n   470\t                .into_iter()\n   471\t                .map(|(key, value)| (key, CatalogEntry::Text(value))),\n   472\t        );\n   473\t    }\n   474\t\n   475\t    pub fn load_core_catalog(&mut self, catalog: CompiledCatalog) {\n   476\t        let locale = catalog_locale(&catalog.locale);\n   477\t        self.translations\n   478\t            .entry(locale)\n   479\t            .or_default()\n   480\t            .extend(catalog.messages);\n   481\t    }\n   482\t\n   483\t    pub fn module_translator(&self, module_id: &str) -> ModuleTranslator<'_> {\n   484\t        ModuleTranslator {\n   485\t            engine: self,\n   486\t            module_id: module_id.to_string(),\n   487\t        }\n   488\t    }\n   489\t\n   490\t    pub fn core_translator(&self) -> CoreTranslator<'_> {\n   491\t        CoreTranslator { engine: self }\n   492\t    }\n   493\t\n   494\t    /// Load a catalog owned by one module. It is never copied into the core\n   495\t    /// domain, so one module cannot shadow another module's keys.\n   496\t    pub fn load_module_translations(&mut self, module_id: &str, set: TranslationSet) {\n   497\t        let locale = catalog_locale(&set.locale);\n   498\t        self.module_translations\n   499\t            .entry(module_id.to_string())\n   500\t            .or_default()\n   501\t            .entry(locale)\n   502\t            .or_default()\n   503\t            .extend(\n   504\t                set.messages\n   505\t                    .into_iter()\n   506\t                    .map(|(key, value)| (key, CatalogEntry::Text(value))),\n   507\t            );\n   508\t    }\n   509\t\n   510\t    pub fn load_module_catalog(&mut self, module_id: &str, catalog: CompiledCatalog) {\n   511\t        let locale = catalog_locale(&catalog.locale);\n   512\t        self.module_translations\n   513\t            .entry(module_id.to_string())\n   514\t            .or_default()\n   515\t            .entry(locale)\n   516\t            .or_default()\n   517\t            .extend(catalog.messages);\n   518\t    }\n   519\t\n   520\t    fn translate_in_core(&self, key: &str) -> Option<&CatalogEntry> {\n   521\t        for locale in self.selection.chain() {\n   522\t            if let Some(messages) = self.translations.get(locale) {\n   523\t                if let Some(value) = messages.get(key) {\n   524\t                    return Some(value);\n   525\t                }\n   526\t            }\n   527\t        }\n   528\t        None\n   529\t    }\n   530\t\n   531\t    fn translate_in_module(&self, key: &str, module_id: &str) -> Option<&CatalogEntry> {\n   532\t        if let Some(module_locales) = self.module_translations.get(module_id) {\n   533\t            for locale in self.selection.chain() {\n   534\t                if let Some(messages) = module_locales.get(locale) {\n   535\t                    if let Some(value) = messages.get(key) {\n   536\t                        return Some(value);\n   537\t                    }\n   538\t                }\n   539\t            }\n   540\t        }\n   541\t        None\n   542\t    }\n   543\t\n   544\t    fn resolve_in_core<'a>(&'a self, key: &str, args: &HashMap<String, String>) -> Option<&'a str> {\n   545\t        for locale in self.selection.chain() {\n   546\t            if let Some(entry) = self.translations.get(locale).and_then(|m| m.get(key)) {\n   547\t                return entry.resolve(args, self.current());\n   548\t            }\n   549\t        }\n   550\t        None\n   551\t    }\n   552\t\n   553\t    fn resolve_in_module<'a>(\n   554\t        &'a self,\n   555\t        key: &str,\n   556\t        module_id: &str,\n   557\t        args: &HashMap<String, String>,\n   558\t    ) -> Option<&'a str> {\n   559\t        if let Some(module_locales) = self.module_translations.get(module_id) {\n   560\t            for locale in self.selection.chain() {\n   561\t                if let Some(entry) = module_locales.get(locale).and_then(|m| m.get(key)) {\n   562\t                    return entry.resolve(args, self.current());\n   563\t                }\n   564\t            }\n   565\t        }\n   566\t        None\n   567\t    }\n   568\t\n   569\t    fn effective_core_translations(&self) -> HashMap<String, String> {\n   570\t        let mut messages = HashMap::new();\n","exit_code":0,"status":"completed"}}
