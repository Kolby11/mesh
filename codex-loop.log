       assert_eq!(fallback.text, \\\"Fallback\\\");\\n  1580\\t        assert!(fallback.missing);\\n  1581\\t        assert!(fallback.source.is_none());\\n  1582\\t\\n  1583\\t        let marker = translator.resolve(\\\"missing\\\", None);\\n  1584\\t        assert_eq!(marker.text, \\\"!!missing\\\");\\n  1585\\t        assert!(marker.missing);\\n  1586\\t        assert_eq!(marker.snapshot_revision, 1);\\n  1587\\t    }\\n  1588\\t\\n  1589\\t    fn test_catalog_path(name: &str) -> std::path::PathBuf {\\n  1590\\t        std::env::temp_dir().join(format!(\\\"mesh-locale-{}-{name}.json\\\", std::process::id()))\\n  1591\\t    }\\n  1592\\t\\n  1593\\t    #[test]\\n  1594\\t    fn catalog_preparation_keeps_last_known_good_on_read_or_parse_failure() {\\n  1595\\t        let mut engine = LocaleEngine::new(\\\"en\\\");\\n  1596\\t        engine.load_module_translations(\\n  1597\\t            \\\"@mesh/example\\\",\\n  1598\\t            TranslationSet {\\n  1599\\t                locale: \\\"en\\\".into(),\\n  1600\\t                messages: HashMap::from([(String::from(\\\"hello\\\"), String::from(\\\"Hello\\\"))]),\\n  1601\\t            },\\n  1602\\t        );\\n  1603\\t        let before = engine.catalog_snapshot();\\n  1604\\t\\n  1605\\t        let missing = test_catalog_path(\\\"missing\\\");\\n  1606\\t        let _ = std::fs::remove_file(&missing);\\n  1607\\t        let sources = vec![(\\\"@mesh/example\\\".into(), \\\"en\\\".into(), missing.clone())];\\n  1608\\t        assert!(matches!(\\n  1609\\t            engine.prepare_module_catalog_snapshot(&sources),\\n  1610\\t            Err(LocaleCatalogLoadError::Read { .. })\\n  1611\\t        ));\\n  1612\\t        assert_eq!(engine.catalog_snapshot().revision(), before.revision());\\n  1613\\t        assert_eq!(\\n  1614\\t            engine.module_translator(\\\"@mesh/example\\\").translate(\\\"hello\\\"),\\n  1615\\t            Some(\\\"Hello\\\")\\n  1616\\t        );\\n  1617\\t\\n  1618\\t        let malformed = test_catalog_path(\\\"malformed\\\");\\n  1619\\t        std::fs::write(&malformed, \\\"{ malformed\\\").unwrap();\\n  1620\\t        let sources = vec![(\\\"@mesh/example\\\".into(), \\\"en\\\".into(), malformed.clone())];\\n  1621\\t        assert!(matches!(\\n  1622\\t            engine.prepare_module_catalog_snapshot(&sources),\\n  1623\\t            Err(LocaleCatalogLoadError::Parse { .. })\\n  1624\\t        ));\\n  1625\\t        assert_eq!(engine.catalog_snapshot().revision(), before.revision());\\n  1626\\t        let _ = std::fs::remove_file(malformed);\\n  1627\\t    }\\n  1628\\t\\n  1629\\t    #[test]\\n  1630\\t    fn catalog_preparation_preserves_valid_siblings_and_reports_entry_diagnostics() {\\n  1631\\t        let path = test_catalog_path(\\\"diagnostics\\\");\\n  1632\\t        std::fs::write(\\n  1633\\t            &path,\\n  1634\\t            serde_json::json!({\\n  1635\\t                \\\"valid\\\": \\\"Visible\\\",\\n  1636\\t                \\\"broken\\\": { \\\"_plural\\\": true, \\\"one\\\": \\\"{count}\\\" }\\n  1637\\t            })\\n  1638\\t            .to_string(),\\n  1639\\t        )\\n  1640\\t        .unwrap();\\n  1641\\t        let sources = vec![(\\\"@mesh/example\\\".into(), \\\"en\\\".into(), path.clone())];\\n  1642\\t        let mut engine = LocaleEngine::new(\\\"en\\\");\\n  1643\\t        let prepared = engine.prepare_module_catalog_snapshot(&sources).unwrap();\\n  1644\\t\\n  1645\\t        assert_eq!(prepared.snapshot().revision(), 1);\\n  1646\\t        assert_eq!(prepared.diagnostics().len(), 1);\\n  1647\\t        engine.replace_catalog_snapshot(prepared.snapshot());\\n  1648\\t        assert_eq!(\\n  1649\\t            engine.module_translator(\\\"@mesh/example\\\").translate(\\\"valid\\\"),\\n  1650\\t            Some(\\\"Visible\\\")\\n  1651\\t        );\\n  1652\\t        assert_eq!(\\n  1653\\t            engine\\n  1654\\t                .module_translator(\\\"@mesh/example\\\")\\n  1655\\t     