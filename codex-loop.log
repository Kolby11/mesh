   }\n   711\t\n   712\t    pub fn discover_modules(&mut self) {\n   713\t        let graph = match self.load_installed_module_graph_candidate() {\n   714\t            Ok(graph) => graph,\n   715\t            Err(error) => {\n   716\t                tracing::error!(\n   717\t                    \"failed to load installed module graph; retaining last-known-good discovery: {error}\"\n   718\t                );\n   719\t                return;\n   720\t            }\n   721\t        };\n   722\t        self.commit_installed_module_graph(graph.clone());\n   723\t        self.modules.clear();\n   724\t        for node in graph.modules() {\n   725\t            let Some(module_dir) = node.manifest_path.parent() else {\n   726\t                tracing::error!(module_id = %node.id, \"graph module manifest has no parent directory\");\n   727\t                continue;\n   728\t            };\n   729\t            self.register_loaded_module(\n   730\t                module_dir,\n   731\t                mesh_core_module::LoadedManifest {\n   732\t                    manifest: node.manifest.clone().into_runtime_manifest(),\n   733\t                    path: node.manifest_path.clone(),\n   734\t                    source: mesh_core_module::manifest::ManifestSource::CanonicalModuleJson,\n   735\t                },\n   736\t            );\n   737\t        }\n   738\t        self.register_interfaces_from_graph(&graph);\n   739\t        tracing::info!(\"discovered {} graph-authorized modules\", self.modules.len());\n   740\t    }\n   741\t\n   742\t    pub(in crate::shell) fn installed_module_graph_path(&self) -> PathBuf {\n   743\t        installed_module_graph_path()\n   744\t    }\n   745\t\n   746\t    pub(in crate::shell) fn load_installed_module_graph_cached(\n   747\t        &mut self,\n   748\t    ) -> Result<&InstalledModuleGraph, mesh_core_module::package::ModuleManifestError> {\n   749\t        if self.installed_module_graph.is_none() {\n   750\t            let graph_path = self.installed_module_graph_path();\n   751\t            self.installed_module_graph = Some(load_installed_module_graph_candidate(&graph_path)?);\n   752\t        }\n   753\t        Ok(self\n   754\t            .installed_module_graph\n   755\t            .as_ref()\n   756\t            .expect(\"installed module graph was just loaded\"))\n   757\t    }\n   758\t\n   759\t    /// Read a replacement graph without changing the active graph. Callers\n   760\t    /// that prepare a live activation use this boundary so a malformed or\n   761\t    /// incomplete on-disk candidate cannot discard the last-known-good graph.\n   762\t    pub(in crate::shell) fn load_installed_module_graph_candidate(\n   763\t        &self,\n   764\t    ) -> Result<InstalledModuleGraph, mesh_core_module::package::ModuleManifestError> {\n   765\t        load_installed_module_graph_candidate(&self.installed_module_graph_path())\n   766\t    }\n   767\t\n   768\t    #[cfg(test)]\n   769\t    pub(in crate::shell) fn reload_installed_module_graph_at(\n   770\t        &mut self,\n   771\t        root_module_graph_path: &Path,\n   772\t    ) -> Result<InstalledModuleGraph, mesh_core_module::package::ModuleManifestError> {\n   773\t        let candidate = load_installed_module_graph_candidate(root_module_graph_path)?;\n   774\t        self.commit_installed_module_graph(candidate.clone());\n   775\t        Ok(candidate)\n   776\t    }\n   777\t\n   778\t    /// Commit a graph only after its runtime candidate has been prepared.\n   779\t    pub(in crate::shell) fn commit_installed_module_graph(&mut self, graph: InstalledModuleGraph) {\n   780\t        self.sync_module_graph_health(&graph);\n   781\t        self.installed_module_graph = Some(graph);\n   782\t    }\n   783\t\n   784\t    /// Project immutable graph diagnostics into the live module records. The\n   785\t    /// graph remains static and reloadable; runtime failures are recorded on\n   786\t    /// the corresponding ModuleInstance instead of mutating this snapshot.\n   787\t    fn sync_module_graph_health(&mut self, graph: &InstalledModuleGraph) {\n   788\t        for (module_id, module) in &mut self.modules {\n   789\t            let Some(node) = graph.module(module_id) else {\n   790\t                continue;\n   791\t            };\n   792\t            let diagnostics = graph\n   793\t                .diagnostics()\n   794\t                .iter()\n   795\t                .filter(|diagnostic| diagnostic.module_id == *module_id)\n   796\t                .map(|diagnostic| (diagnostic.status.as_str(), diagnostic.message.as_str()));\n   797\t            let health_records = graph\n   798\t                .health()\n   799\t                .iter()\n   800\t                .filter(|record| record.module_id == *module_id)\n   801\t                .map(|record| (record.status.as_str(), record.message.as_str()));\n   802\t\n   803\t            let mut unavailable_reason = None;\n   804\t            let mut degraded_reason = None;\n   805\t            for (status, message) in diagnostics.chain(health_records) {\n   806\t                if status.contains(\"required\")\n   807\t                    || status.contains(\"missing\")\n   808\t                    || status.contains(\"blocked\")\n   809\t                    || status.contains(\"conflict\")\n   810\t                    || status == \"provider_unavailable\"\n   811\t                    || status == \"interface_unavailable\"\n   812\t                {\n   813\t                    unavailable_reason.get_or_insert(message.to_string());\n   814\t                } else if status.contains(\"optional\")\n   815\t                    || status == \"interface_unconfigured\"\n   816\t                    || status == \"provider_degraded\"\n   817\t                {\n   818\t                    degraded_reason.get_or_insert(message.to_string());\n   819\t                }\n   820\t            }\n   821\t\n   822\t            let health = if !node.enabled {\n   823\t                ModuleHealthRecord::unavailable(\"module disabled by the installed graph\", false)\n   824\t            } else if let Some(reason) = unavailable_reason {\n   825\t                ModuleHealthRecord::unavailable(reason, true)\n   826\t            } else if let Some(reason) = degraded_reason {\n   827\t                ModuleHealthRecord::degraded(reason)\n   828\t            } else {\n   829\t                ModuleHealthRecord::healthy()\n   830\t            };\n   831\t            module.set_static_health(health);\n   832\t        }\n   833\t    }\n   834\t\n   835\t    pub(in crate::shell) fn register_interfaces_from_graph(\n   836\t        &mut self,\n   837\t        graph: &InstalledModuleGraph,\n   838\t    ) {\n   839\t        let mut settings = self.settings_store.as_ref().clone();\n   840\t        match register_graph_settings_schemas(&mut settings, graph) {\n   841\t            Ok(()) => {\n   842\t                self.settings = settings.shell().clone();\n   843\t                self.settings_store = Arc::new(settings);\n   844\t                mesh_core_config::log_settings_diagnostics(\n   845\t                    \"registered settings schemas\",\n   846\t                    self.settings_store.diagnostics(),\n   847\t                );\n   848\t            }\n   849\t            Err(error) => tracing::warn!(\n   850\t                \"failed to register graph-owned settings schemas transactionally: {error}\"\n   851\t            ),\n   852\t        }\n   853\t        for contract in graph.interface_contracts().values() {\n   854\t            self.interfaces.register_contract(contract.clone());\n   855\t        }\n   856\t\n   857\t        for provider in graph.backend_provider_contributions() {\n   858\t            self.interfaces.register(InterfaceProvider {\n   859\t                interface: canonical_interface_name(&provider.interface),\n   860\t                version: provider.version.clone(),\n   861\t                base_module: provider.base_module.clone(),\n   862\t                provider_module: provider.module_id.clone(),\n   863\t                backend_name: provider\n   864\t                    .provider\n   865\t                    .clone()\n   866\t                    .unwrap_or_else(|| provider.module_id.clone()),\n   867\t                priority: provider.priority,\n   868\t            });\n   869\t        }\n   870\t    }\n   871\t\n   872\t    fn register_loaded_module(&mut self, dir: &Path, loaded: mesh_core_module::LoadedManifest) {\n   873\t        let id = loaded.manifest.package.id.clone();\n   874\t        tracing::info!(\n   875\t            \"discovered module: {} v{} ({}) from {}\",\n   876\t            id,\n   877\t            loaded.manifest.package.version,\n   878\t            loaded.manifest.package.module_type,\n   879\t            loaded.source\n   880\t        );\n   881\t        register_module_icon_pack(&id, dir, loaded.manifest.assets.as_ref());\n   882\t        register_icon_pack_module(&id, dir, loaded.manifest.icon_pack.as_ref());\n   883\t        // Per-module icon overrides live in the module's own settings\n   884\t        // namespace, alongside its surface and prop overrides.\n   885\t        let icon_overrides =\n   886\t            ModuleSettingsOverrides::from_namespace(&self.settings_store.namespace(&id));\n   887\t        register_frontend_icon_bindings(&id, &loaded.manifest, icon_overrides.icons.as_ref());\n   888\t        self.modules.insert(\n   889\t            id,\n   890\t            ModuleInstance::new(\n   891\t                loaded.manifest,\n   892\t                dir.to_path_buf(),\n   893\t                loaded.path,\n   894\t                loaded.source,\n   895\t            ),\n   896\t        );\n   897\t    }\n   898\t\n   899\t    pub fn resolve_modules(&mut self) -> Result<(), ShellRunError> {\n   900\t        let active_graph = self.load_installed_module_graph_cached()?.clone();\n   901\t        self.sync_module_graph_health(&active_graph);\n   902\t        let mut effective_capabilities = HashMap::with_capacity(self.modules.len());\n   903\t        for (module_id, module) in &self.modules {\n   904\t            if !active_graph\n   905\t                .module(module_id)\n   906\t                .is_some_and(|node| node.enabled)\n   907\t            {\n   908\t                continue;\n   909\t            }\n   910\t            let effective = self.capability_policy.resolve(\n   911\t                module_id,\n   912\t                &module.manifest.capabilities.required,\n   913\t                &module.manifest.capabilities.optional,\n   914\t            )?;\n   915\t            effective_capabilities.insert(module_id.clone(), effective);\n   916\t        }\n   917\t        self.effective_capabilities = Arc::new(effective_capabilities);\n   918\t        let ids: Vec<String> = self.modules.keys().cloned().collect();\n   919\t        for id in ids {\n   920\t            if let Some(module) = self.modules.get_mut(&id) {\n   921\t                if module.state == ModuleState::Discovered && active_graph.module(&id).is_some() {\n   922\t                    if let Err(e) = module.transition(ModuleState::Resolved) {\n   923\t                        tracing::warn!(\"failed to resolve module {id}: {e}\");\n   924\t                    }\n   925\t                }\n   926\t            }\n   927\t        }\n   928\t        Ok(())\n   929\t    }\n   930\t\n   931\t    pub fn module(&self, id: &str) -> Option<&ModuleInstance> {\n   932\t        self.modules.get(id)\n   933\t    }\n   934\t\n   935\t    pub fn modules(&self) -> impl Iterator<Item = (&str, ModuleState)> {\n   936\t        self.modules\n   937\t            .iter()\n   938\t            .map(|(id, inst)| (id.as_str(), inst.state))\n   939\t    }\n   940\t\n   941\t    pub(super) fn load_frontend_components(&mut self) -> Result<(), ShellRunError> {\n   942\t        if !self.components.is_empty() {\n   943\t            return Ok(());\n   944\t        }\n   945\t\n   946\t        let graph = self.load_installed_module_graph_cached()?.clone();\n   947\t        let frontend_catalog = FrontendCatalog::from_modules(&self.modules, Some(&graph))?;\n   948\t        self.frontend_catalog.replace(frontend_catalog, None);\n   949\t        let frontend_catalog = self.frontend_catalog.snapshot().catalog;\n   950\t        let enabled_frontends = self.installed_enabled_frontend_ids();\n   951\t        let graph_i18n_catalogs = self.graph_i18n_catalog_paths();\n   952\t        let interface_catalog = std::sync::Arc::new(self.interfaces.resolved_catalog());\n   953\t        if let Some(profile_id) = self.active_profile_id.clone() {\n   954\t            let paths = mesh_core_module::package::ProfilePaths::from_root_graph(\n   955\t                &self.installed_module_graph_path(),\n   956\t            )?;\n   957\t            let profile = paths.load(&profile_id)?;\n   958\t            let entries = frontend_catalog\n   959\t                .top_level_surfaces()\n   960\t                .into_iter()\n   961\t                .map(|entry| (entry.compiled.manifest.package.id.clone(), entry))\n   962\t                .collect::<HashMap<_, _>>();\n   963\t            for (instance_id, root) in profile.roots.iter().filter(|(_, root)| root.active) {\n   964\t                let entry = entries.get(&root.module).ok_or_else(|| {\n   965\t                    ShellRunError::FrontendComposition {\n   966\t                        message: format!(\n   967\t                            \"profile root {instance_id} has no mountable frontend entrypoint\"\n   968\t                        ),\n   969\t                    }\n   970\t                })?;\n   971\t                self.register_component(Box::new(\n   972\t                    FrontendSurfaceComponent::new(\n   973\t                        entry.compiled.clone(),\n   974\t                        entry.module_dir.clone(),\n   975\t                        self.fron