n.locale != new_i18n.locale\n   544\t            || old_i18n.fallback_locale != new_i18n.fallback_locale;\n   545\t\n   546\t        let theme_changed = old_theme != new_settings.theme || old_fonts != new_settings.fonts;\n   547\t        if theme_changed {\n   548\t            let (theme, theme_watch) = if let Some(graph) =\n   549\t                self.installed_module_graph.as_ref().filter(|graph| {\n   550\t                    graph\n   551\t                        .theme_catalog()\n   552\t                        .get(&new_settings.theme.active)\n   553\t                        .is_some()\n   554\t                }) {\n   555\t                match prepare_theme_for_graph(&new_settings, graph) {\n   556\t                    Ok(candidate) => candidate,\n   557\t                    Err(error) => {\n   558\t                        self.record_theme_reload_failure(&error);\n   559\t                        return Ok(requests);\n   560\t                    }\n   561\t                }\n   562\t            } else {\n   563\t                load_active_theme(&new_settings)\n   564\t            };\n   565\t            let active_theme_id = theme.active().id.clone();\n   566\t            tracing::info!(\n   567\t                \"active theme changed: {} -> {}\",\n   568\t                old_theme.active,\n   569\t                active_theme_id\n   570\t            );\n   571\t            self.theme = theme;\n   572\t            self.theme_watch = theme_watch;\n   573\t            self.mark_components_theme_changed()?;\n   574\t            requests.extend(self.sync_theme_service_state()?);\n   575\t        }\n   576\t\n   577\t        if old_icons != new_settings.icons {\n   578\t            mesh_core_icon::set_default_shell_pack(new_settings.icons.default_pack.clone());\n   579\t            if !theme_changed {\n   580\t                self.mark_components_theme_changed()?;\n   581\t            }\n   582\t        }\n   583\t\n   584\t        if locale_changed {\n   585\t            tracing::info!(\n   586\t                \"locale changed: {} (fallback: {}) -> {} (fallback: {})\",\n   587\t                old_i18n.locale,\n   588\t                old_i18n.fallback_locale,\n   589\t                new_i18n.locale,\n   590\t                new_i18n.fallback_locale,\n   591\t            );\n   592\t            self.locale = LocaleEngine::with_fallback_locale(\n   593\t                new_i18n.locale.clone(),\n   594\t                new_i18n.fallback_locale.clone(),\n   595\t            );\n   596\t            self.mark_components_locale_changed()?;\n   597\t            requests.extend(self.sync_locale_service_state()?);\n   598\t        }\n   599\t\n   600\t        mesh_core_render::set_blur_quality(blur_quality_from_settings(&new_settings.render.blur));\n   601\t        self.settings = new_settings;\n   602\t        self.settings_store = store;\n   603\t        self.apply_settings_to_components()?;\n   604\t        requests.extend(self.sync_settings_service_state()?);\n   605\t\n   606\t        Ok(requests)\n   607\t    }\n   608\t\n   609\t    /// Hand the reloaded store to every component.\n   610\t    ///\n   611\t    /// One file holds every namespace, so a single reload here serves every\n   612\t    /// component: they all adopt the snapshot the shell just read.\n   613\t    pub(in crate::shell) fn apply_settings_to_components(&mut self) -> Result<(), ShellRunError> {\n   614\t        let store = self.settings_store.clone();\n   615\t        for runtime in &mut self.components {\n   616\t            let changed = runtime\n   617\t                .component\n   618\t                .apply_settings(&store)\n   619\t                .map_err(ShellRunError::Component)?;\n   620\t            if changed {\n   621\t                tracing::info!(\n   622\t                    \"settings changed for component '{}'\",\n   623\t                    runtime.component.id()\n   624\t                );\n   625\t            }\n   626\t        }\n   627\t        Ok(())\n   628\t    }\n   629\t\n   630\t    pub(in crate::shell) fn mark_components_locale_changed(&mut self) -> Result<(), ShellRunError> {\n   631\t        let locale = self.locale.clone();\n   632\t        let locale_id = locale.current().to_string();\n   633\t        for runtime in &mut self.components {\n   634\t            runtime\n   635\t                .component\n   636\t                .locale_changed(&locale)\n   637\t                .map_err(ShellRunError::Component)?;\n   638\t            runtime.parent.force_full_present = true;\n   639\t        }\n   640\t        let _ = self.broadcast_core_event(CoreEvent::LocaleChanged { locale: locale_id })?;\n   641\t        Ok(())\n   642\t    }\n   643\t\n   644\t    pub(in crate::shell) fn apply_set_locale(\n   645\t        &mut self,\n   646\t        locale: &str,\n   647\t    ) -> Result<VecDeque<CoreRequest>, ShellRunError> {\n   648\t        let locale = locale.trim();\n   649\t        if locale.is_empty() {\n   650\t            tracing::warn!(\"ignoring empty locale request\");\n   651\t            return Ok(VecDeque::new());\n   652\t        }\n   653\t        match self.locale.try_set_locale(locale) {\n   654\t            Ok(false) => return self.sync_locale_service_state(),\n   655\t            Ok(true) => tracing::info!(\"active locale changed to '{}'\", self.locale.current()),\n   656\t            Err(error) => {\n   657\t                tracing::warn!(%error, \"ignoring invalid locale request\");\n   658\t                return self.sync_locale_service_state();\n   659\t            }\n   660\t        }\n   661\t        self.mark_components_locale_changed()?;\n   662\t        self.sync_locale_service_state()\n   663\t    }\n   664\t\n   665\t    pub(in crate::shell) fn sync_locale_service_state(\n   666\t        &mut self,\n   667\t    ) -> Result<VecDeque<CoreRequest>, ShellRunError> {\n   668\t        let selection = self.locale.selection();\n   669\t        let locale = selection.active().to_string();\n   670\t        let chain = selection.chain().to_vec();\n   671\t        let direction = selection.direction().as_str();\n   672\t        let revision = selection.revision().to_string();\n   673\t        // As with theme, the shell supplies the host-derived snapshot while\n   674\t        // the selected provider owns the interface state observed by modules.\n   675\t        let source_module = self.active_service_provider_or(\"mesh.locale\", \"@mesh/shell\");\n   676\t        self.broadcast_service_event(ServiceEvent::Updated {\n   677\t            service: \"mesh.locale\".into(),\n   678\t            source_module,\n   679\t            payload: serde_json::json!({\n   680\t                \"locale\": locale.clone(),\n   681\t                \"current\": locale,\n   682\t                \"chain\": chain,\n   683\t                \"direction\": direction,\n   684\t                \"revision\": revision,\n   685\t            }),\n   686\t        })\n   687\t    }\n   688\t}\n   240\t                }\n   241\t                Err(error) => tracing::warn!(\n   242\t                    \"failed to compose selected graph theme '{}': {error}; retaining recovery theme\",\n   243\t                    self.settings.theme.active\n   244\t                ),\n   245\t            }\n   246\t        }\n   247\t        self.resolve_modules()?;\n   248\t        self.load_frontend_components()?;\n   249\t\n   250\t        let runtime = Runtime::new().map_err(ShellRunError::RuntimeInit)?;\n   251\t        let (tx, mut rx) = mpsc::unbounded_channel::<ShellMessage>();\n   252\t\n   253\t        let eventfd = rustix::event::eventfd(0, EventfdFlags::CLOEXEC | EventfdFlags::NONBLOCK)\n   254\t            .map_err(|e| ShellRunError::EventfdCreate(format!(\"eventfd: {e}\")))?;\n   255\t        let eventfd_raw = eventfd.as_raw_fd();\n   256\t        self.eventfd_fd = Some(eventfd);\n   257\t\n   258\t        self.file_watcher_active =\n   259\t            file_watch::spawn_file_watcher(self.file_watch_paths(), tx.clone(), eventfd_raw);\n   260\t        self.backend_respawn = Some(backend::BackendRespawnContext {\n   261\t            handle: runtime.handle().clone(),\n   262\t            tx: tx.clone(),\n   263\t            eventfd_fd: eventfd_raw,\n   264\t        });\n   265\t        self.spawn_backend_modules(runtime.handle(), tx.clone(), eventfd_raw);\n   266\t        let ipc_socket_path = default_ipc_socket_path();\n   267\t        spawn_ipc_server(&runtime, ipc_socket_path.clone(), tx, eventfd_raw).map_err(|source| {\n   268\t            ShellRunError::IpcInit {\n   269\t                path: ipc_socket_path.clone(),\n   270\t                source,\n   271\t            }\n   272\t        })?;\n   273\t\n   274\t        let mut pending = VecDeque::new();\n   275\t        pending.extend(self.mount_components()?);\n   276\t        pending.extend(self.replay_cached_service_events()?);\n   277\t        pending.extend(self.sync_theme_service_state()?);\n   278\t        self.mark_components_locale_changed()?;\n   279\t        pending.extend(self.sync_locale_service_state()?);\n   280\t        pending.extend(self.broadcast_core_event(CoreEvent::Started)?);\n   281\t        if let Some(request) = shell_sound_request(SoundKind::Startup, &self.settings.sounds) {\n   282\t            pending.push_back(request);\n   283\t        }\n   284\t\n   285\t        tracing::info!(\n   286\t            \"MESH shell core is running with {} frontend component(s)\",\n   287\t            self.components.len()\n   288\t        );\n   289\t\n   290\t        while !self.core.shutting_down {\n   291\t            pending.extend(self.reload_theme_if_changed()?);\n   292\t            pending.extend(self.reload_locale_if_settings_changed()?);\n   293\t            self.reload_frontend_components_if_changed()?;\n   294\t            self.dispatch_wayland()?;\n   295\t\n   296\t            let mut shell_messages = CoalescedShellMessages::default();\n   297\t            let mut drained_shell_message_count = 0;\n   298\t            for _ in 0..MAX_SHELL_MESSAGE_DRAIN_PER_FRAME {\n   299\t                let Ok(message) = rx.try_recv() else {\n   300\t                    break;\n   301\t                };\n   302\t                drained_shell_message_count += 1;\n   303\t                shell_messages.push(message);\n   304\t            }\n   305\t            let shell_message_backlog_likely =\n   306\t                drained_shell_message_count == MAX_SHELL_MESSAGE_DRAIN_PER_FRAME;\n   307\t            if drained_shell_message_count > 0 {\n   308\t                self.presented_last_frame = true;\n   309\t            }\n   310\t            for message in shell_messages.into_vec() {\n   311\t                self.handle_shell_message(&mut pending, message)?;\n   312\t            }\n   313\t\n   314\t            pending.extend(self.tick_components()?);\n   315\t            pending.extend(std::mem::take(&mut self.deferred_requests));\n   316\t            pending.extend(self.complete_due_surface_transitions()?);\n   317\t            if !pending.is_empty() {\n   318\t                self.presented_last_frame = true;\n   319\t            }\n   320\t            self.drain_requests(&mut pending)?;\n","exit_code":0,"status":"completed"}}
