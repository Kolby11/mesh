           }),\n   283\t            });\n   284\t        };\n   285\t        let paths = ProfilePaths::from_root_graph(&self.installed_module_graph_path())?;\n   286\t        let profile_delta = paths.load(&profile_id)?;\n   287\t        let generation = profile_generation(&profile_delta)?;\n   288\t        let graph = self.load_installed_module_graph_cached()?.clone();\n   289\t        let manifests = graph\n   290\t            .modules()\n   291\t            .into_iter()\n   292\t            .map(|module| &module.manifest)\n   293\t            .collect::<Vec<_>>();\n   294\t        let profile =\n   295\t            mesh_core_module::package::resolve_composition(&profile_delta, manifests)?.to_profile();\n   296\t        let catalog = self.frontend_catalog.snapshot().catalog;\n   297\t        let mut roots = Vec::new();\n   298\t        let mut slots = Vec::new();\n   299\t        let mut palette = Vec::new();\n   300\t\n   301\t        for (root_instance, root) in &profile.roots {\n   302\t            roots.push(serde_json::json!({\n   303\t                \"instance\": root_instance,\n   304\t                \"module\": root.module,\n   305\t                \"active\": root.active,\n   306\t            }));\n   307\t            if !root.active {\n   308\t                continue;\n   309\t            }\n   310\t            let Some(host) = catalog.modules.get(&root.module) else {\n   311\t                continue;\n   312\t            };\n   313\t            for descriptor in customizable_slots(&host.compiled.component) {\n   314\t                let Some(point) = descriptor.extension_point.as_deref() else {\n   315\t                    continue;\n   316\t                };\n   317\t                let slot_name = descriptor.name.as_deref().unwrap_or_default();\n   318\t                let hosted = host.compiled.manifest.hosted_extension_points.get(point);\n   319\t                let defaults = hosted\n   320\t                    .and_then(|hosted| hosted.slots.get(slot_name))\n   321\t                    .map(|slot| slot.defaults.clone())\n   322\t                    .unwrap_or_default();\n   323\t                let effective = catalog\n   324\t                    .node_slot_placement(root_instance, slot_name)\n   325\t                    .map(|slot| serde_json::to_value(&slot.nodes))\n   326\t                    .transpose()\n   327\t                    .map_err(|error| ShellRunError::Package(error.to_string()))?\n   328\t                    .unwrap_or_else(|| {\n   329\t                        serde_json::Value::Array(\n   330\t                            defaults\n   331\t                                .iter()\n   332\t                                .enumerate()\n   333\t                                .map(|(index, reference)| {\n   334\t                                    serde_json::json!({\n   335\t                                        \"id\": format!(\"default-{index}\"),\n   336\t                                        \"use\": reference,\n   337\t                                        \"props\": {},\n   338\t                                    })\n   339\t                                })\n   340\t                                .collect(),\n   341\t                        )\n   342\t                    });\n   343\t                slots.push(serde_json::json!({\n   344\t                    \"root_instance\": root_instance,\n   345\t                    \"name\": slot_name,\n   346\t                    \"contract\": point,\n   347\t                    \"layout\": hosted.and_then(|hosted| hosted.layout.clone()).unwrap_or_else(|| \"row\".into()),\n   348\t                    \"max\": hosted.and_then(|hosted| hosted.max),\n   349\t                    \"defaults\": defaults,\n   350\t                    \"nodes\": effective,\n   351\t                    \"overridden\": catalog.node_slot_placement(root_instance, slot_name).is_some(),\n   352\t                }));\n   353\t                for contribution in catalog.extension_point_contributions_for(&root.module, point) {\n   354\t                    let compiled = catalog\n   355\t                        .contribution_entry(\n   356\t                            &contribution.source_module_id,\n   357\t                            &contribution.contribution_id,\n   358\t                        )\n   359\t                        .expect(\"resolved contribution is compiled\");\n   360\t                    let props_schema = mesh_core_component::props_settings_schema(\n   361\t                        compiled.component.props.as_ref(),\n   362\t                    )\n   363\t                    .map(|schema| {\n   364\t                        resolve_component_props_schema(\n   365\t                            schema,\n   366\t                            &self\n   367\t                                .locale\n   368\t                                .module_translator(&contribution.source_module_id),\n   369\t                        )\n   370\t                    });\n   371\t                    palette.push(serde_json::json!({\n   372\t                        \"contract\": point,\n   373\t                        \"use\": format!(\"{}:{}\", contribution.source_module_id, contribution.contribution_id),\n   374\t                        \"module\": contribution.source_module_id,\n   375\t                        \"id\": contribution.contribution_id,\n   376\t                        \"props_schema\": props_schema,\n   377\t                    }));\n   378\t                }\n   379\t            }\n   380\t        }\n   381\t        palette.sort_by(|left, right| left[\"use\"].as_str().cmp(&right[\"use\"].as_str()));\n   382\t        palette.dedup_by(|left, right| left[\"use\"] == right[\"use\"]);\n   383\t\n   384\t        self.broadcast_service_event(ServiceEvent::Updated {\n   385\t            service: \"mesh.composition\".into(),\n   386\t            source_module: \"@mesh/shell\".into(),\n   387\t            payload: serde_json::json!({\n   388\t                \"profile_id\": profile_id,\n   389\t                \"generation\": generation,\n   390\t                \"roots\": roots,\n   391\t                \"slots\": slots,\n   392\t                \"palette\": palette,\n   393\t            }),\n   394\t        })\n   395\t    }\n   396\t\n   397\t    pub(in crate::shell) fn apply_set_module_prop(\n   398\t        &mut self,\n   399\t        module_id: &str,\n   400\t        instance_id: Option<&str>,\n   401\t        prop: &str,\n   402\t        value: Option<serde_json::Value>,\n   403\t    ) -> Result<VecDeque<CoreRequest>, ShellRunError> {\n   404\t        let catalog = self.frontend_catalog.snapshot();\n   405\t        let definition = catalog\n   406\t            .catalog\n   407\t            .module(module_id)\n   408\t            .and_then(|entry| entry.compiled.component.props.as_ref())\n   409\t            .and_then(|block| {\n   410\t                block\n   411\t                    .props\n   412\t                    .iter()\n   413\t                    .find(|definition| definition.name == prop)\n   414\t            })\n   415\t            .filter(|definition| definition.expose)\n   416\t            .cloned()\n   417\t            .ok_or_else(|| ShellRunError::FrontendComposition {\n   418\t                message: format!(\n   419\t                    \"module '{module_id}' does not expose a configurable prop named '{prop}'\"\n   420\t                ),\n   421\t            })?;\n   422\t\n   423\t        if let Some(instance_id) = instance_id\n   424\t            && !self.components.iter().any(|runtime| {\n   425\t                runtime.surface_id == instance_id && runtime.component.id() == module_id\n   426\t            })\n   427\t        {\n   428\t            return Err(ShellRunError::FrontendComposition {\n   429\t                message: format!(\"'{instance_id}' is not a live instance of module '{module_id}'\"),\n   430\t            });\n   431\t        }\n   432\t\n   433\t        let settings_path = instance_id\n   434\t            .map(|id| format!(\"props.instances.{id}\"))\n   435\t            .unwrap_or_else(|| \"props.global\".to_string());\n   436\t\n   437\t        if let Some(value) = value.as_ref() {\n   438\t            let parsed = mesh_core_component::json_to_prop_value_ref(value).ok_or_else(|| {\n   439\t                ShellRunError::FrontendComposition {\n   440\t                    message: format!(\n   441\t                        \"setting {module_id}.{settings_path}.{prop} must be a string, number, or boolean\"\n   442\t                    ),\n   443\t                }\n   444\t            })?;\n   445\t            mesh_core_component::validate_prop_value(&definition, &parsed).map_err(|error| {\n   446\t                ShellRunError::FrontendComposition {\n   447\t                    message: format!(\"invalid setting {module_id}.{settings_path}.{prop}: {error}\"),\n   448\t                }\n   449\t            })?;\n   450\t        }\n   451\t\n   452\t        let effective = if let Some(profile_id) = self.active_profile_id.clone() {\n   453\t            let paths = ProfilePaths::from_root_graph(&self.installed_module_graph_path())?;\n   454\t            let mut profile = paths.load(&profile_id)?;\n   455\t            let namespace = profile\n   456\t                .settings\n   457\t                .entry(module_id.to_string())\n   458\t                .or_insert_with(|| serde_json::json!({}));\n   459\t            update_module_prop_override(namespace, instance_id, prop, value);\n   460\t            if namespace.as_object().is_some_and(serde_json::Map::is_empty) {\n   461\t                profile.settings.remove(module_id);\n   462\t            }\n   463\t            paths.save(&profile_id, &profile)?;\n   464\t            let shared =\n   465\t                SettingsStore::load().map_err(|error| ShellRunError::FrontendComposition {\n   466\t                    message: format!(\"failed to reload shared settings: {error}\"),\n   467\t                })?;\n   468\t            super::discovery::effective_profile_settings(shared, Some(&profile)).map_err(\n   469\t                |error| ShellRunError::FrontendComposition {\n   470\t                    message: format!(\"failed to resolve updated profile settings: {error}\"),\n   471\t                },\n   472\t            )?\n   473\t        } else {\n   474\t            let mut shared =\n   475\t                SettingsStore::load().map_err(|error| ShellRunError::FrontendComposition {\n   476\t                    message: format!(\"failed to load settings for update: {error}\"),\n   477\t                })?;\n   478\t            let mut namespace = shared.namespace(module_id);\n   479\t            update_module_prop_override(&mut namespace, instance_id, prop, value);\n   480\t            shared.set_namespace(module_id, namespace);\n   481\t            shared\n   482\t                .save()\n   483\t                .map_err(|error| ShellRunError::FrontendComposition {\n   484\t                    message: format!(\"failed to save settings: {error}\"),\n   485\t                })?;\n   486\t            shared\n   487\t        };\n   488\t\n   489\t        let mut effective = effective;\n   490\t        if let Some(graph) = self.installed_module_graph.as_ref() {\n   491\t            super::discovery::register_graph_settings_schemas(&mut effective, graph).map_err(\n   492\t                |error| ShellRunError::FrontendComposition {\n   493\t                    message: format!(\"failed to register settings schemas: {error}\"),\n   494\t                },\n   495\t            )?;\n   496\t        }\n   497\t        self.settings_store = Arc::new(effective);\n   498\t        self.settings = self.settings_store.shell().clone();\n   499\t        self.settings_watch.modified_at = std::fs::metadata(&self.settings_watch.path)\n   500\t            .ok()\n   501\t            .and_then(|metadata| metadata.modified().ok());\n   502\t        self.apply_settings_to_components()?;\n   503\t        self.components_want_render = true;\n   504\t        Ok(VecDeque::new())\n   505\t    }\n   506\t\n   507\t    pub(in crate::shell) fn apply_switch_profile(\n   508\t        &mut self,\n   509\t        profile_id: &str,\n   510\t    ) -> VecDeque<CoreRequest> {\n","exit_code":0,"status":"completed"}}
