g,\n   580\t            Err(error) => {\n   581\t                self.reject_profile_switch(profile_id, error.to_string());\n   582\t                return VecDeque::new();\n   583\t            }\n   584\t        };\n   585\t        let temporary_catalog = FrontendCatalogHandle::from(catalog.clone());\n   586\t        let entries = catalog\n   587\t            .top_level_surfaces()\n   588\t            .into_iter()\n   589\t            .map(|entry| (entry.compiled.manifest.package.id.clone(), entry))\n   590\t            .collect::<HashMap<_, _>>();\n   591\t        let desired_surfaces = profile\n   592\t            .roots\n   593\t            .iter()\n   594\t            .filter(|(_, root)| root.active)\n   595\t            .map(|(instance_id, _)| instance_id.clone())\n   596\t            .collect::<HashSet<_>>();\n   597\t        let existing_surfaces = self\n   598\t            .components\n   599\t            .iter()\n   600\t            .map(|runtime| runtime.surface_id.clone())\n   601\t            .collect::<HashSet<_>>();\n   602\t        let mut prepared_frontends = Vec::new();\n   603\t        for (instance_id, root) in profile.roots.iter().filter(|(_, root)| root.active) {\n   604\t            if existing_surfaces.contains(instance_id) {\n   605\t                continue;\n   606\t            }\n   607\t            let Some(entry) = entries.get(&root.module) else {\n   608\t                self.reject_profile_switch(\n   609\t                    profile_id,\n   610\t                    format!(\"profile root {instance_id} has no mountable frontend entrypoint\"),\n   611\t                );\n   612\t                return VecDeque::new();\n   613\t            };\n   614\t            let mut component = FrontendSurfaceComponent::new(\n   615\t                entry.compiled.clone(),\n   616\t                entry.module_dir.clone(),\n   617\t                temporary_catalog.clone(),\n   618\t                Arc::new(self.interfaces.resolved_catalog()),\n   619\t                settings.clone(),\n   620\t            )\n   621\t            .with_effective_capabilities(self.effective_capabilities.clone())\n   622\t            .with_instance_id(instance_id)\n   623\t            .with_graph_i18n_catalogs(self.profile_i18n_catalog_paths(&graph));\n   624\t            let diagnostics = self\n   625\t                .diagnostics\n   626\t                .register_instance(root.module.clone(), instance_id.clone());\n   627\t            let mut requests = match component.mount(ComponentContext {\n   628\t                component_id: root.module.clone(),\n   629\t                surface_id: instance_id.clone(),\n   630\t                diagnostics,\n   631\t            }) {\n   632\t                Ok(requests) => VecDeque::from(requests),\n   633\t                Err(error) => {\n   634\t                    self.reject_profile_switch(profile_id, error.to_string());\n   635\t                    return VecDeque::new();\n   636\t                }\n   637\t            };\n   638\t            if let Err(error) = component.locale_changed(&self.locale) {\n   639\t                self.reject_profile_switch(profile_id, error.to_string());\n   640\t                return VecDeque::new();\n   641\t            }\n   642\t            for state in self.latest_service_state.values() {\n   643\t                let event = ServiceEvent::Updated {\n   644\t                    service: state.interface.clone(),\n   645\t                    source_module: state.provider_id.clone(),\n   646\t                    payload: state.state.clone(),\n   647\t                };\n   648\t                if component.observes_service_event(&event) {\n   649\t                    match component.handle_service_event(&event) {\n   650\t                        Ok(next) => requests.extend(next),\n   651\t                        Err(error) => {\n   652\t                            self.reject_profile_switch(profile_id, error.to_string());\n   653\t                 