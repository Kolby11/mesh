\t    pub category_key: Option<String>,\n    41\t    pub key: String,\n    42\t    pub modifiers: Vec<String>,\n    43\t    pub trigger_kind: String,\n    44\t    pub source: String,\n    45\t    pub accessibility_shortcut: String,\n    46\t}\n    47\t\n    48\t#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]\n    49\tpub enum DebugInspectorView {\n    50\t    #[default]\n    51\t    Overview,\n    52\t    Modules,\n    53\t    Surfaces,\n    54\t    BackendServices,\n    55\t    Benchmark,\n    56\t}\n    57\t\n    58\timpl DebugInspectorView {\n    59\t    pub fn label(self) -> &'static str {\n    60\t        match self {\n    61\t            Self::Overview => \"overview\",\n    62\t            Self::Modules => \"modules\",\n    63\t            Self::Surfaces => \"surfaces\",\n    64\t            Self::BackendServices => \"backend_services\",\n    65\t            Self::Benchmark => \"benchmark\",\n    66\t        }\n    67\t    }\n    68\t\n    69\t    pub fn from_legacy_tab(tab: DebugTab) -> Self {\n    70\t        match tab {\n    71\t            DebugTab::Modules => Self::Modules,\n    72\t            DebugTab::Interfaces => Self::Surfaces,\n    73\t            DebugTab::Health => Self::BackendServices,\n    74\t        }\n    75\t    }\n    76\t}\n    77\t\n    78\t#[derive(Debug, Clone, Default, Serialize)]\n    79\tpub struct DebugBenchmarkSnapshot {\n    80\t    pub scenarios: Vec<BenchmarkScenarioSnapshot>,\n   500\t            Self::PaintTraversal => \"paint_traversal\",\n   501\t            Self::TextShaping => \"text_shaping\",\n   502\t            Self::IconImageRaster => \"icon_image_raster\",\n   503\t            Self::Paint => \"paint\",\n   504\t            Self::PresentCommit => \"present_commit\",\n   505\t            Self::RedrawCount => \"redraw_count\",\n   506\t            Self::TotalSurfaceRender => \"total_surface_render\",\n   507\t        }\n   508\t    }\n   509\t}\n   510\t\n   511\t#[derive(Debug, Clone, Serialize)]\n   512\tpub struct ModuleEntry {\n   513\t    pub id: String,\n   514\t    pub module_type: String,\n   515\t    pub state: String,\n   516\t    pub health: String,\n   517\t    pub static_health: String,\n   518\t    pub runtime_health: String,\n   519\t    pub quarantined: bool,\n   520\t    pub error_count: u32,\n   521\t    pub last_error: Option<String>,\n   522\t}\n   523\t\n   524\t#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize)]\n   525\tpub struct ModuleGraphEntry {\n   526\t    pub module_id: String,\n   527\t    pub kind: String,\n   528\t    pub enabled: bool,\n   529\t    pub root_layout: bool,\n   530\t    pub path: String,\n   531\t    pub uses_modules: Vec<String>,\n   532\t    pub uses_interfaces: Vec<String>,\n   533\t    pub uses_optional_interfaces: Vec<String>,\n   534\t    pub uses_icon_packs: Vec<String>,\n   535\t    pub uses_i18n_packs: Vec<String>,\n   536\t    pub uses_theme_packs: Vec<String>,\n   537\t    pub uses_font_packs: Vec<String>,\n   538\t    pub required_binaries: Vec<String>,\n   539\t    pub optional_binaries: Vec<String>,\n   540\t    pub keybind_actions: Vec<String>,\n   541\t    /// Resolved `interface=provider` pairs for interfaces consumed by this module.\n   542\t    pub active_providers: Vec<String>,\n   543\t    pub native_binaries: Vec<ModuleBinaryHealthEntry>,\n   544\t    pub capabilities: Vec<String>,\n   545\t    pub optional_capabilities: Vec<String>,\n   546\t    pub surface_entrypoint: Option<String>,\n   547\t    pub surface_settings_namespace: Option<String>,\n   548\t    pub surface_accessibility_role: Option<String>,\n   549\t    pub surface_accessibility_label: Option<String>,\n   550\t    pub surface_size_policy: Option<String>,\n   551\t    pub surface_layout_label: Option<String>,\n   552\t    pub surface_layout_label_key: Option<String>,\n   553\t    pub surface_layout_label_fallback: Option<String>,\n   554\t    pub provides_interfaces: Vec<String>,\n   555\t    /// Parallel to `provides_interfaces`.\n 