{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/core/shell/src/shell/discovery.rs | sed -n '100,190p'; nl -ba crates/core/shell/src/shell/discovery.rs | sed -n '450,570p'; nl -ba crates/core/shell/src/shell/discovery.rs | sed -n '880,960p'\"","aggregated_output":"   100\t            module\n   101\t                .manifest\n   102\t                .mesh\n   103\t                .i18n\n   104\t                .default_locale\n   105\t                .clone()\n   106\t                .map(|locale| (module.id.clone(), locale))\n   107\t        })\n   108\t        .collect();\n   109\t    (sources, defaults)\n   110\t}\n   111\t\n   112\tfn log_locale_catalog_diagnostics(diagnostics: &[mesh_core_locale::CatalogSourceDiagnostics]) {\n   113\t    for source in diagnostics {\n   114\t        for diagnostic in &source.diagnostics {\n   115\t            tracing::warn!(\n   116\t                module_id = %source.module_id,\n   117\t                locale = %source.locale,\n   118\t                path = %source.path.display(),\n   119\t                key = %diagnostic.key,\n   120\t                \"locale catalog entry rejected: {}\",\n   121\t                diagnostic.message,\n   122\t            );\n   123\t        }\n   124\t    }\n   125\t}\n   126\t\n   127\t/// Layer a profile's sparse preferences and per-instance surface overrides on\n   128\t/// top of shared user defaults. The shared document remains untouched.\n   129\tpub(in crate::shell) fn effective_profile_settings(\n   130\t    shared: SettingsStore,\n   131\t    profile: Option<&mesh_core_module::package::ShellProfile>,\n   132\t) -> Result<SettingsStore, mesh_core_config::ConfigError> {\n   133\t    let Some(profile) = profile else {\n   134\t        return Ok(shared);\n   135\t    };\n   136\t    let path = shared.path().to_path_buf();\n   137\t    let mut document = shared.to_value();\n   138\t    let root = document\n   139\t        .as_object_mut()\n   140\t        .expect(\"SettingsStore always serializes an object\");\n   141\t    if let Some(theme) = &profile.resources.theme {\n   142\t        let target = root\n   143\t            .entry(\"shell\".to_string())\n   144\t            .or_insert_with(|| serde_json::json!({}));\n   145\t        mesh_core_config::merge_json(target, &serde_json::json!({ \"theme\": { \"active\": theme } }));\n   146\t    }\n   147\t    for (namespace, overrides) in &profile.settings {\n   148\t        let target = root\n   149\t            .entry(namespace.clone())\n   150\t            .or_insert_with(|| serde_json::json!({}));\n   151\t        mesh_core_config::merge_json(target, overrides);\n   152\t    }\n   153\t    for (instance_id, instance) in profile.roots.iter().filter(|(_, root)| root.active) {\n   154\t        let Some(surface) = &instance.surface else {\n   155\t            continue;\n   156\t        };\n   157\t        let target = root\n   158\t            .entry(instance_id.clone())\n   159\t            .or_insert_with(|| serde_json::json!({}));\n   160\t        mesh_core_config::merge_json(target, &serde_json::json!({ \"surface\": surface }));\n   161\t    }\n   162\t    SettingsStore::from_value(path, document)\n   163\t}\n   164\t\n   165\tfn builtin_state_contract(\n   166\t    interface: &str,\n   167\t    fields: &[(&str, &str)],\n   168\t) -> mesh_core_service::InterfaceContract {\n   169\t    builtin_contract(interface, fields, &[])\n   170\t}\n   171\t\n   172\t/// A core-provided contract: state fields the shell emits, plus the methods it\n   173\t/// answers itself.\n   174\t///\n   175\t/// The shell is the provider for these interfaces, so the methods here are the\n   176\t/// public, capability-gated way for any module to change composition and\n   177\t/// configuration. Declaring them as a contract rather than a reserved channel\n   178\t/// is what makes the settings frontend replaceable: the caller needs\n   179\t/// `service.<name>.control`, not a particular module id.\n   180\tfn builtin_contract(\n   181\t    interface: &str,\n   182\t    fields: &[(&str, &str)],\n   183\t    methods: &[(&str, &[(&str, &str)])],\n   184\t) -> mesh_core_service::InterfaceContract {\n   185\t    mesh_core_service::InterfaceContract {\n   186\t        interface: interface.to_string(),\n   187\t        version: mesh_core_service::parse_contract_version(\"1.0\")\n   188\t            .expect(\"built-in interface version must be valid\"),\n   189\t        state_fields: fields\n   190\t            .iter()\n   450\tpub(super) fn load_shell_module_manifests_serial(\n   451\t    module_dirs: &[PathBuf],\n   452\t) -> Vec<DiscoveredModuleManifest> {\n   453\t    module_dirs\n   454\t        .iter()\n   455\t        .map(|dir| DiscoveredModuleManifest {\n   456\t            dir: dir.clone(),\n   457\t            loaded: mesh_core_module::manifest::load_canonical_manifest(dir),\n   458\t        })\n   459\t        .collect()\n   460\t}\n   461\t\n   462\timpl Shell {\n   463\t    pub fn new() -> Self {\n   464\t        let config_path = mesh_core_config::default_config_path();\n   465\t        let config = load_config(&config_path).unwrap_or_else(|e| {\n   466\t            tracing::warn!(\"failed to load config, using defaults: {e}\");\n   467\t            ShellConfig {\n   468\t                shell: Default::default(),\n   469\t            }\n   470\t        });\n   471\t        let shared_settings = SettingsStore::load().unwrap_or_else(|e| {\n   472\t            tracing::warn!(\"failed to load settings, using defaults: {e}\");\n   473\t            SettingsStore::default()\n   474\t        });\n   475\t        let graph_path = installed_module_graph_path();\n   476\t        let capability_policy = RootModuleGraphManifest::from_path(&graph_path)\n   477\t            .map(|root| CapabilityPolicy::from_approvals(root.capability_approvals))\n   478\t            .unwrap_or_else(|error| {\n   479\t                tracing::warn!(\n   480\t                    \"failed to load capability approvals from {}: {error}\",\n   481\t                    graph_path.display()\n   482\t                );\n   483\t                CapabilityPolicy::default()\n   484\t            });\n   485\t        let active_profile = mesh_core_module::package::ProfilePaths::from_root_graph(&graph_path)\n   486\t            .and_then(|paths| paths.load_active())\n   487\t            .unwrap_or_else(|error| {\n   488\t                tracing::warn!(\"failed to load active shell profile: {error}\");\n   489\t                None\n   490\t            });\n   491\t        let active_profile_id = active_profile.as_ref().map(|(id, _)| id.clone());\n   492\t        let settings_store = Arc::new(\n   493\t            effective_profile_settings(\n   494\t                shared_settings,\n   495\t                active_profile.as_ref().map(|(_, profile)| profile),\n   496\t            )\n   497\t            .unwrap_or_else(|error| {\n   498\t                tracing::warn!(\"failed to apply active profile settings: {error}\");\n   499\t                SettingsStore::default()\n   500\t            }),\n   501\t        );\n   502\t        // A hand-edited file is the whole point of the store, so a bad value in\n   503\t        // it is reported and skipped, never fatal: the shell starts on declared\n   504\t        // defaults with the reason on stderr.\n   505\t        mesh_core_config::log_settings_diagnostics(\"settings\", settings_store.diagnostics());\n   506\t        let settings = settings_store.shell().clone();\n   507\t\n   508\t        // Discover and register XDG icon themes installed on the system.\n   509\t        // Icon-pack binding modules reference them by name in their\n   510\t        // mapping targets (`<theme>/<icon-name>`). Failures are logged\n   511\t        // but non-fatal — hicolor fallback still works.\n   512\t        for pack in mesh_core_icon::discover_xdg_packs() {\n   513\t            let id = pack.id.clone();\n   514\t            match mesh_core_icon::register_default_pack(pack) {\n   515\t                Ok(true) => tracing::info!(\"registered XDG icon theme '{}'\", id),\n   516\t                Ok(false) => tracing::debug!(\"XDG icon theme '{}' already registered\", id),\n   517\t                Err(err) => {\n   518\t                    tracing::warn!(\"failed to register XDG icon theme '{}': {err}\", id)\n   519\t                }\n   520\t            }\n   521\t        }\n   522\t        mesh_core_icon::set_default_shell_pack(settings.icons.default_pack.clone());\n   523\t        mesh_core_render::set_blur_quality(blur_quality_from_settings(&settings.render.blur));\n   524\t        let (theme, theme_watch) = load_active_theme(&settings);\n   525\t        let locale = LocaleEngine::with_fallback_locale(\n   526\t            settings.i18n.locale.clone(),\n   527\t            settings.i18n.fallback_locale.clone(),\n   528\t        );\n   529\t        let module_dirs = resolve_default_module_dirs(&config);\n   530\t        let settings_watch = {\n   531\t            let path = settings_store.path().to_path_buf();\n   532\t            let modified_at = std::fs::metadata(&path)\n   533\t                .ok()\n   534\t                .and_then(|m| m.modified().ok());\n   535\t            SettingsWatchState { path, modified_at }\n   536\t        };\n   537\t\n   538\t        let interfaces = InterfaceRegistry::new();\n   539\t        let mut theme_contract = builtin_contract(\n   540\t            \"mesh.theme\",\n   541\t            &[\n   542\t                (\"current\", \"string\"),\n   543\t                (\"theme_id\", \"string\"),\n   544\t                (\"mode\", \"string?\"),\n   545\t                (\"mode_policy\", \"object?\"),\n   546\t                (\"color_scheme\", \"string?\"),\n   547\t                (\"contrast\", \"string?\"),\n   548\t                (\"tokens\", \"object?\"),\n   549\t                (\"provenance\", \"object?\"),\n   550\t                (\"revision\", \"string\"),\n   551\t                (\"fingerprint\", \"integer?\"),\n   552\t                (\"is_dark\", \"boolean\"),\n   553\t                (\"themes\", \"object[]\"),\n   554\t                (\"available\", \"string[]\"),\n   555\t                (\"system_resources\", \"object\"),\n   556\t            ],\n   557\t            &[\n   558\t                (\"set_theme\", &[(\"theme_id\", \"string\")]),\n   559\t                (\"set_icon_theme\", &[(\"theme_id\", \"string\")]),\n   560\t                (\"set_font_family\", &[(\"family\", \"string\")]),\n   561\t            ],\n   562\t        );\n   563\t        theme_contract.events = vec![\n   564\t            mesh_core_service::InterfaceEvent {\n   565\t                name: \"ThemeChanged\".into(),\n   566\t                payload: [\n   567\t                    (\"theme_id\", \"string\"),\n   568\t                    (\"mode\", \"string\"),\n   569\t                    (\"mode_policy\", \"object\"),\n   570\t                    (\"color_scheme\", \"string\"),\n   880\t        &mut self,\n   881\t        root_module_graph_path: &Path,\n   882\t    ) -> Result<InstalledModuleGraph, mesh_core_module::package::ModuleManifestError> {\n   883\t        let candidate = load_installed_module_graph_candidate(root_module_graph_path)?;\n   884\t        self.commit_installed_module_graph(candidate.clone())\n   885\t            .map_err(|error| {\n   886\t                mesh_core_module::package::ModuleManifestError::Validation(error.to_string())\n   887\t            })?;\n   888\t        Ok(candidate)\n   889\t    }\n   890\t\n   891\t    pub(in crate::shell) fn prepare_locale_for_graph(\n   892\t        &self,\n   893\t        graph: &InstalledModuleGraph,\n   894\t    ) -> Result<LocaleEngine, ShellRunError> {\n   895\t        let mut candidate = self.locale.clone();\n   896\t        let (sources, defaults) = graph_i18n_catalog_sources(graph);\n   897\t        let prepared = candidate\n   898\t            .prepare_catalog_snapshot(&sources, &defaults)\n   899\t            .map_err(|error| ShellRunError::LocaleCatalog(error.to_string()))?;\n   900\t        log_locale_catalog_diagnostics(prepared.diagnostics());\n   901\t        candidate.replace_catalog_snapshot(prepared.snapshot());\n   902\t        Ok(candidate)\n   903\t    }\n   904\t\n   905\t    pub(in crate::shell) fn prepare_locale_for_settings(\n   906\t        &self,\n   907\t        settings: &ShellSettings,\n   908\t        graph: &InstalledModuleGraph,\n   909\t    ) -> Result<LocaleEngine, ShellRunError> {\n   910\t        let mut candidate = self.prepare_locale_selection_for_settings(settings)?;\n   911\t        let (sources, defaults) = graph_i18n_catalog_sources(graph);\n   912\t        let prepared = candidate\n   913\t            .prepare_catalog_snapshot(&sources, &defaults)\n   914\t            .map_err(|error| ShellRunError::LocaleCatalog(error.to_string()))?;\n   915\t        log_locale_catalog_diagnostics(prepared.diagnostics());\n   916\t        candidate.replace_catalog_snapshot(prepared.snapshot());\n   917\t        Ok(candidate)\n   918\t    }\n   919\t\n   920\t    pub(in crate::shell) fn prepare_locale_selection_for_settings(\n   921\t        &self,\n   922\t        settings: &ShellSettings,\n   923\t    ) -> Result<LocaleEngine, ShellRunError> {\n   924\t        let requested = mesh_core_locale::LocaleSelection::try_new(\n   925\t            settings.i18n.locale.clone(),\n   926\t            settings.i18n.fallback_locale.clone(),\n   927\t            1,\n   928\t        )\n   929\t        .map_err(|error| ShellRunError::LocaleCatalog(error.to_string()))?;\n   930\t        let revision = if requested.active() == self.locale.current()\n   931\t            && requested.fallback() == self.locale.fallback_locale()\n   932\t        {\n   933\t            self.locale.revision()\n   934\t        } else {\n   935\t            self.locale.revision().saturating_add(1)\n   936\t        };\n   937\t        let selection = mesh_core_locale::LocaleSelection::try_new(\n   938\t            requested.active(),\n   939\t            requested.fallback(),\n   940\t            revision,\n   941\t        )\n   942\t        .map_err(|error| ShellRunError::LocaleCatalog(error.to_string()))?;\n   943\t        let mut candidate = self.locale.clone();\n   944\t        candidate.replace_selection(&selection);\n   945\t        Ok(candidate)\n   946\t    }\n   947\t\n   948\t    /// Commit a graph and its prepared locale candidate as one in-memory\n   949\t    /// activation boundary. Callers that need to prepare runtime objects first\n   950\t    /// use `commit_installed_module_graph_with_locale` with the same candidate.\n   951\t    pub(in crate::shell) fn commit_installed_module_graph(\n   952\t        &mut self,\n   953\t        graph: InstalledModuleGraph,\n   954\t    ) -> Result<(), ShellRunError> {\n   955\t        let locale = self.prepare_locale_for_graph(&graph)?;\n   956\t        self.commit_installed_module_graph_with_locale(graph, locale);\n   957\t        Ok(())\n   958\t    }\n   959\t\n   960\t    pub(in crate::shell) fn commit_installed_module_graph_with_locale(\n","exit_code":0,"status":"completed"}}
