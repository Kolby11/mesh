ain\".into()\n    87\t}\n    88\t\n    89\tfn default_true() -> bool {\n    90\t    true\n    91\t}\n    92\t\n    93\tfn validate_unique_ordered_ids(field: &str, values: &[String]) -> Result<(), ModuleManifestError> {\n    94\t    let mut seen = HashSet::new();\n    95\t    for value in values {\n    96\t        if !seen.insert(value) {\n    97\t            return Err(ModuleManifestError::Validation(format!(\n    98\t                \"{field} contains duplicate module '{value}', which would make precedence ambiguous\"\n    99\t            )));\n   100\t        }\n   101\t    }\n   102\t    Ok(())\n   103\t}\n   104\t\n   105\timpl Default for ProfileRootInstance {\n   106\t    fn default() -> Self {\n   107\t        Self {\n   108\t            module: String::new(),\n   109\t            entrypoint: default_entrypoint(),\n   110\t            active: true,\n   111\t            surface: None,\n   112\t        }\n   113\t    }\n   114\t}\n   115\t\n   116\timpl ShellProfile {\n   117\t    pub fn new() -> Self {\n   118\t        Self {\n   119\t            schema_version: PROFILE_SCHEMA_VERSION,\n   120\t            revision: 0,\n   121\t            ..Self::default()\n   122\t        }\n   123\t    }\n   124\t\n   125\t    pub fn from_json_str(input: &str) -> Result<Self, ModuleManifestError> {\n   126\t        let mut profile: Self =\n   127\t            serde_json::from_str(input).map_err(|source| ModuleManifestError::Json {\n   128\t                path: PathBuf::from(\"<profile>\"),\n   129\t                source,\n   130\t            })?;\n   480\t            });\n   481\t        root.layout = self\n   482\t            .roots\n   483\t            .values()\n   484\t            .find(|instance| instance.active)\n   485\t            .map(|instance| RootLayoutSelection {\n   486\t                entrypoint: format!(\"{}:{}\", instance.module, instance.entrypoint),\n   487\t            });\n   488\t        root.validate()\n   489\t    }\n   490\t}\n   491\t\n   492\timpl Default for ShellProfile {\n   493\t    fn default() -> Self {\n   494\t        Self {\n   495\t            schema_version: PROFILE_SCHEMA_VERSION,\n   496\t            revision: 0,\n   497\t            from: None,\n   498\t            roots: BTreeMap::new(),\n   499\t            background_services: BTreeSet::new(),\n   500\t            providers: BTreeMap::new(),\n   501\t            resources: ProfileResources::default(),\n   502\t            node_slots: BTreeMap::new(),\n   503\t            settings: BTreeMap::new(),\n   504\t        }\n   505\t    }\n   506\t}\n   507\t\n   508\t#[derive(Debug, Clone)]\n   509\tpub struct ProfilePaths {\n   510\t    config_dir: PathBuf,\n   511\t}\n   512\t\n   513\timpl ProfilePaths {\n   514\t    pub fn from_root_graph(root_graph_path: &Path) -> Result<Self, ModuleManifestError> {\n   515\t        let config_dir = root_graph_path.parent().ok_or_else(|| {\n   516\t            ModuleManifestError::Validation(format!(\n   517\t                \"root module graph has no parent directory: {}\",\n   518\t                root_graph_path.display()\n   519\t            ))\n   520\t        })?;\n   521\t        Ok(Self {\n   522\t            config_dir: config_dir.to_path_buf(),\n   523\t        })\n   524\t    }\n   525\t\n   526\t    pub fn profiles_dir(&self) -> PathBuf {\n   527\t        self.config_dir.join(\"profiles\")\n   528\t    }\n   529\t\n   530\t    pub fn active_profile_path(&self) -> PathBuf {\n   531\t        self.config_dir.join(\"active-profile\")\n   532\t    }\n   533\t\n   534\t    pub fn profile_path(&self, profile_id: &str) -> Result<PathBuf, ModuleManifestError> {\n   535\t        validate_profile_id(profile_id)?;\n   536\t        Ok(self.profiles_dir().join(format!(\"{profile_id}.json\")))\n   537\t    }\n   538\t\n   539\t    pub fn active_profile_id(&self) -> Result<Option<String>, ModuleManifestError> {\n   540\t        let path = self.active_profile_path();\n   541\t        if !path.exists() {\n   542\t            return Ok(None);\n   543\t        }\n   544\t        super::validate_regular_file(&path, \"active profile pointer\")?;\n   545\t        let profile_id =\n   546\t            fs::read_to_string(&path).map_err(|source| ModuleManifestError::Io { path, source })?;\n   547\t        let profile_id = profile_id.trim();\n   548\t        validate_profile_id(profile_id)?;\n   549\t        Ok(Some(profile_id.to_string()))\n   550\t    }\n   551\t\n   552\t    pub fn load(&self, profile_id: &str) -> Result<ShellProfile, ModuleManifestError> {\n   553\t        ShellProfile::from_path(&self.profile_path(profile_id)?)\n   554\t    }\n   555\t\n   556\t    pub fn load_or_default(&self, profile_id: &str) -> Result<ShellProfile, ModuleManifestError> {\n   557\t        let path = self.profile_path(profile_id)?;\n   558\t        if fs::symlink_metadata(&path)\n   559\t            .map(|metadata| metadata.file_type().is_symlink())\n   560\t            .unwrap_or(false)\n   561\t        {\n   562\t            return Err(ModuleManifestError::Validation(format!(\n   563\t                \"shell profile {} must not be a symlink\",\n   564\t                path.display()\n   565\t            )));\n   566\t        }\n   567\t        if path.exists() {\n   568\t            ShellProfile::from_path(&path)\n   569\t        } else {\n   570\t            Ok(ShellProfile::new())\n   571\t        }\n   572\t    }\n   573\t\n   574\t    pub fn load_active(&self) -> Result<Option<(String, ShellProfile)>, ModuleManifestError> {\n   575\t        let Some(profile_id) = self.active_profile_id()? else {\n   576\t            return Ok(None);\n   577\t        };\n   578\t        let profile = self.load(&profile_id)?;\n   579\t        Ok(Some((profile_id, profile)))\n   580\t    }\n   581\t\n   582\t    pub fn save(\n   583\t        &self,\n   584\t        profile_id: &str,\n   585\t        profile: &ShellProfile,\n   586\t    ) -> Result<(), ModuleManifestError> {\n   587\t        profile.validate()?;\n   588\t        let path = self.profile_path(profile_id)?;\n   589\t        let mut content =\n   590\t            serde_json::to_string_pretty(profile).map_err(|source| ModuleManifestError::Json {\n   591\t                path: path.clone(),\n   592\t                source,\n   593\t            })?;\n   594\t        content.push('\\n');\n   595\t        atomic_write(&path, content.as_bytes())\n   596\t    }\n   597\t\n   598\t    /// Persist a profile candidate only if the on-disk profile still has the\n   599\t    /// expected revision. The returned profile carries the newly committed\n   600\t    /// revision for callers that keep the candidate in memory.\n   601\t    pub fn save_if_revision(\n   602\t        &self,\n   603\t        profile_id: &str,\n   604\t        profile: &ShellProfile,\n   605\t        expected_revision: u64,\n   606\t    ) -> Result<ShellProfile, ModuleManifestError> {\n   607\t        if profile.revision != expected_revision {\n   608\t            return Err(ModuleManifestError::Validation(format!(\n   609\t                \"profile revision conflict: expected {expected_revision}, found {}\",\n   610\t                profile.revision\n   611\t            )));\n   612\t        }\n   613\t\n   614\t        let current_revision = match self.load(profile_id) {\n   615\t            Ok(current) => current.revision,\n   616\t            Err(ModuleManifestError::Io { source, .. })\n   617\t                if source.kind() == std::io::ErrorKind::NotFound => 0,\n   618\t            Err(error) => return Err(error),\n   619\t        };\n   620\t        if current_revision != expected_revision {\n   621\t            return Err(ModuleManifestError::Validation(format!(\n   622\t                \"profile revision conflict: expected {expected_revision}, found {current_revision}\"\n   623\t            )));\n   624\t        }\n   625\t\n   626\t        let mut committed = profile.clone();\n   627\t        committed.revision = expected_revision.saturating_add(1);\n   628\t        self.save(profile_id, &committed)?;\n   629\t        Ok(committed)\n   630\t    }\n   631\t\n   632\t    pub fn set_active(&self, profile_id: &str) -> Result<(), ModuleManifestError> {\n   633\t        let profile_path = self.profile_path(profile_id)?;\n   634\t        if !profile_path.exists() {\n   635\t            return Err(ModuleManifestError::Validation(format!(\n","exit_code":0,"status":"completed"}}
