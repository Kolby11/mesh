   let graph_path = self.installed_module_graph_path();\n   222\t        let paths = ProfilePaths::from_root_graph(&graph_path)?;\n   223\t        let mut profile = paths.load(profile_id)?;\n   224\t        let generation = profile_generation(&profile)?;\n   225\t        if generation != expected_generation {\n   226\t            return Err(ShellRunError::Package(format!(\n   227\t                \"node_edit_generation_conflict: expected {expected_generation}, current {generation}\"\n   228\t            )));\n   229\t        }\n   230\t\n   231\t        match nodes {\n   232\t            Some(nodes) => {\n   233\t                let nodes: Vec<ComponentPlacement> =\n   234\t                    serde_json::from_value(nodes).map_err(|error| {\n   235\t                        ShellRunError::Package(format!(\"invalid_node_props: {error}\"))\n   236\t                    })?;\n   237\t                profile\n   238\t                    .node_slots\n   239\t                    .entry(root_instance.to_string())\n   240\t                    .or_default()\n   560\t                        profile_id,\n   561\t                        format!(\"failed to register candidate settings schemas: {error}\"),\n   562\t                    );\n   563\t                    return VecDeque::new();\n   564\t                }\n   565\t                Arc::new(settings)\n   566\t            }\n   567\t            Err(error) => {\n   568\t                self.reject_profile_switch(profile_id, error.to_string());\n   569\t                return VecDeque::new();\n   570\t            }\n   571\t        };\n   572\t\n   573\t        let previous_catalog = self.frontend_catalog.snapshot().catalog;\n   574\t        let catalog = match FrontendCatalog::from_modules_reusing(\n   575\t            &self.modules,\n   576\t            Some(&graph),\n   577\t            Some(&previous_catalog),\n   578\t        ) {\n   579\t            Ok(catalog) => catalog,\n   580\t            Err(error) => {\n   581\t 