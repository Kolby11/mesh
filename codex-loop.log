{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/core/foundation/config/src/settings.rs | sed -n '145,245p'; nl -ba crates/core/foundation/config/src/settings.rs | sed -n '360,470p'; nl -ba crates/core/foundation/config/src/settings.rs | sed -n '700,735p'\"","aggregated_output":"   145\t        if self.schemas.contains_key(&schema.namespace) {\n   146\t            return Err(SettingsSchemaError::DuplicateNamespace {\n   147\t                namespace: schema.namespace,\n   148\t            });\n   149\t        }\n   150\t        self.schemas.insert(schema.namespace.clone(), schema);\n   151\t        Ok(())\n   152\t    }\n   153\t}\n   154\t\n   155\t/// Every user-owned setting in the shell, loaded from one file.\n   156\t#[derive(Debug, Clone)]\n   157\tpub struct SettingsStore {\n   158\t    path: PathBuf,\n   159\t    root: JsonMap<String, JsonValue>,\n   160\t    revision: u64,\n   161\t    schemas: SettingsSchemaRegistry,\n   162\t    validated_root: JsonMap<String, JsonValue>,\n   163\t    shell: ShellSettings,\n   164\t    document_diagnostics: Vec<SettingsDiagnostic>,\n   165\t    diagnostics: Vec<SettingsDiagnostic>,\n   166\t}\n   167\t\n   168\timpl Default for SettingsStore {\n   169\t    fn default() -> Self {\n   170\t        Self {\n   171\t            path: default_settings_path(),\n   172\t            root: JsonMap::new(),\n   173\t            revision: 0,\n   174\t            schemas: SettingsSchemaRegistry::default(),\n   175\t            validated_root: JsonMap::new(),\n   176\t            shell: ShellSettings::default(),\n   177\t            document_diagnostics: Vec::new(),\n   178\t            diagnostics: Vec::new(),\n   179\t        }\n   180\t    }\n   181\t}\n   182\t\n   183\timpl SettingsStore {\n   184\t    /// A missing file is not an error: it means the user changed nothing.\n   185\t    pub fn load() -> Result<Self, ConfigError> {\n   186\t        Self::load_from(&default_settings_path())\n   187\t    }\n   188\t\n   189\t    pub fn load_from(path: &Path) -> Result<Self, ConfigError> {\n   190\t        let (root, diagnostics) = if path.exists() {\n   191\t            let content = std::fs::read_to_string(path)?;\n   192\t            match serde_json::from_str::<JsonValue>(&content)? {\n   193\t                JsonValue::Object(map) => (map, Vec::new()),\n   194\t                other => (\n   195\t                    JsonMap::new(),\n   196\t                    vec![non_object_document_diagnostic(\n   197\t                        &format!(\"{} must contain\", path.display()),\n   198\t                        &other,\n   199\t                    )],\n   200\t                ),\n   201\t            }\n   202\t        } else {\n   203\t            (JsonMap::new(), Vec::new())\n   204\t        };\n   205\t\n   206\t        let revision = document_revision(&root);\n   207\t        let mut store = Self {\n   208\t            path: path.to_path_buf(),\n   209\t            root,\n   210\t            revision,\n   211\t            schemas: SettingsSchemaRegistry::default(),\n   212\t            validated_root: JsonMap::new(),\n   213\t            shell: ShellSettings::default(),\n   214\t            document_diagnostics: diagnostics,\n   215\t            diagnostics: Vec::new(),\n   216\t        };\n   217\t        store.rebuild_validation();\n   218\t        Ok(store)\n   219\t    }\n   220\t\n   221\t    /// Build a store from an already-parsed document.\n   222\t    pub fn from_value(path: impl Into<PathBuf>, value: JsonValue) -> Result<Self, ConfigError> {\n   223\t        let path = path.into();\n   224\t        let (root, diagnostics) = match value {\n   225\t            JsonValue::Object(map) => (map, Vec::new()),\n   226\t            other => (\n   227\t                JsonMap::new(),\n   228\t                vec![non_object_document_diagnostic(\"settings must be\", &other)],\n   229\t            ),\n   230\t        };\n   231\t        let revision = document_revision(&root);\n   232\t        let mut store = Self {\n   233\t            path,\n   234\t            root,\n   235\t            revision,\n   236\t            schemas: SettingsSchemaRegistry::default(),\n   237\t            validated_root: JsonMap::new(),\n   238\t            shell: ShellSettings::default(),\n   239\t            document_diagnostics: diagnostics,\n   240\t            diagnostics: Vec::new(),\n   241\t        };\n   242\t        store.rebuild_validation();\n   243\t        Ok(store)\n   244\t    }\n   245\t\n   360\t    /// Replace one namespace's overrides; an empty object removes it so the\n   361\t    /// store stays sparse. A value the schema rejects still lands in the file\n   362\t    /// and surfaces in diagnostics, while readers receive only the validated\n   363\t    /// projection.\n   364\t    pub fn set_namespace(&mut self, name: &str, value: JsonValue) {\n   365\t        let is_empty = value.as_object().is_some_and(JsonMap::is_empty);\n   366\t        if value.is_null() || is_empty {\n   367\t            self.root.remove(name);\n   368\t        } else {\n   369\t            self.root.insert(name.to_string(), value);\n   370\t        }\n   371\t        self.rebuild_validation();\n   372\t    }\n   373\t\n   374\t    /// Merge overrides into a namespace, keeping unrelated stored keys.\n   375\t    pub fn merge_namespace(&mut self, name: &str, value: &JsonValue) {\n   376\t        let mut current = self.stored(name);\n   377\t        merge_json(&mut current, value);\n   378\t        self.set_namespace(name, current);\n   379\t    }\n   380\t\n   381\t    /// Drop every override in a namespace; declared defaults win again.\n   382\t    pub fn reset_namespace(&mut self, name: &str) {\n   383\t        self.set_namespace(name, JsonValue::Null);\n   384\t    }\n   385\t\n   386\t    /// The full document as written to disk, in `BTreeMap` key order so saves\n   387\t    /// diff cleanly regardless of which namespace was touched.\n   388\t    pub fn to_value(&self) -> JsonValue {\n   389\t        let mut root = self.root.clone();\n   390\t        root.insert(\n   391\t            SCHEMA_VERSION_KEY.to_string(),\n   392\t            JsonValue::from(SETTINGS_SCHEMA_VERSION),\n   393\t        );\n   394\t        if self.revision > 0 {\n   395\t            root.insert(REVISION_KEY.to_string(), JsonValue::from(self.revision));\n   396\t        }\n   397\t        JsonValue::Object(root)\n   398\t    }\n   399\t\n   400\t    /// Write the store through a unique owner-only temporary file, syncing the\n   401\t    /// file before the atomic rename and the parent directory afterwards.\n   402\t    ///\n   403\t    /// A failure before the rename leaves the previous settings file intact.\n   404\t    pub fn save(&self) -> Result<(), ConfigError> {\n   405\t        let parent = settings_parent(&self.path);\n   406\t        ensure_settings_directory(parent)?;\n   407\t        let mut content = serde_json::to_string_pretty(&self.to_value())?;\n   408\t        content.push('\\n');\n   409\t        let (temporary, mut file) = create_settings_temporary(&self.path, parent)?;\n   410\t        let result = (|| {\n   411\t            let file_result = (|| {\n   412\t                file.write_all(content.as_bytes())?;\n   413\t                file.sync_all()\n   414\t            })();\n   415\t            drop(file);\n   416\t            file_result?;\n   417\t            fs::rename(&temporary, &self.path)?;\n   418\t            sync_settings_directory(parent)\n   419\t        })();\n   420\t        if let Err(error) = result {\n   421\t            let _ = fs::remove_file(&temporary);\n   422\t            return Err(error.into());\n   423\t        }\n   424\t        Ok(())\n   425\t    }\n   426\t\n   427\t    /// Persist this candidate only if the file still has `expected_revision`.\n   428\t    ///\n   429\t    /// Callers prepare and validate a complete candidate first, then use this\n   430\t    /// method as the durable commit boundary. The in-memory store advances to\n   431\t    /// the committed revision only after the atomic replace succeeds.\n   432\t    pub fn save_if_revision(&mut self, expected_revision: u64) -> Result<(), ConfigError> {\n   433\t        if self.revision != expected_revision {\n   434\t            return Err(ConfigError::RevisionConflict {\n   435\t                expected: expected_revision,\n   436\t                actual: self.revision,\n   437\t            });\n   438\t        }\n   439\t\n   440\t        let actual_revision = Self::load_from(&self.path)?.revision;\n   441\t        if actual_revision != expected_revision {\n   442\t            return Err(ConfigError::RevisionConflict {\n   443\t                expected: expected_revision,\n   444\t                actual: actual_revision,\n   445\t            });\n   446\t        }\n   447\t\n   448\t        let next_revision = expected_revision.saturating_add(1);\n   449\t        let mut committed = self.clone();\n   450\t        committed.revision = next_revision;\n   451\t        committed.save()?;\n   452\t        self.revision = next_revision;\n   453\t        Ok(())\n   454\t    }\n   455\t\n   456\t    fn stored(&self, name: &str) -> JsonValue {\n   457\t        self.root\n   458\t            .get(name)\n   459\t            .cloned()\n   460\t            .unwrap_or_else(|| JsonValue::Object(JsonMap::new()))\n   461\t    }\n   462\t\n   463\t    fn resolved_stored(&self, name: &str) -> JsonValue {\n   464\t        if self.schemas.get(name).is_some() {\n   465\t            return self\n   466\t                .validated_root\n   467\t                .get(name)\n   468\t                .cloned()\n   469\t                .unwrap_or_else(|| JsonValue::Object(JsonMap::new()));\n   470\t        }\n   700\t                    None => {\n   701\t                        base.insert(key.clone(), value.clone());\n   702\t                    }\n   703\t                }\n   704\t            }\n   705\t        }\n   706\t        (base, overlay) => *base = overlay.clone(),\n   707\t    }\n   708\t}\n   709\t\n   710\t/// Resolve the `\"shell\"` namespace, dropping and reporting what it cannot use.\n   711\t///\n   712\t/// Infallible on purpose: a hand-edited file must never stop the shell from\n   713\t/// starting. Values are checked against [`SHELL_SETTINGS_FIELDS`] before the\n   714\t/// merge, so serde only ever sees well-typed input.\n   715\tfn resolve_shell_settings(\n   716\t    root: &JsonMap<String, JsonValue>,\n   717\t) -> (ShellSettings, Vec<SettingsDiagnostic>) {\n   718\t    let mut diagnostics = validate_settings_root(root);\n   719\t\n   720\t    let overrides = root.get(SHELL_NAMESPACE).map(|overrides| {\n   721\t        validate_object(\n   722\t            SHELL_NAMESPACE,\n   723\t            \"\",\n   724\t            SHELL_SETTINGS_FIELDS,\n   725\t            overrides,\n   726\t            &mut diagnostics,\n   727\t        )\n   728\t    });\n   729\t\n   730\t    let mut resolved = match serde_json::to_value(ShellSettings::default()) {\n   731\t        Ok(value) => value,\n   732\t        Err(_) => return (ShellSettings::default(), diagnostics),\n   733\t    };\n   734\t    if let Some(overrides) = &overrides {\n   735\t        merge_json(&mut resolved, overrides);\n","exit_code":0,"status":"completed"}}
