mmand {\ncrates/core/runtime/backend/src/lib.rs:1147:            .send(BackendServiceCommand {\ncrates/core/runtime/backend/src/lib.rs:1178:        // Sending a command name that no handler exists for must produce a CommandResult with\ncrates/core/runtime/backend/src/lib.rs:1194:            .send(BackendServiceCommand {\ncrates/core/runtime/backend/src/lib.rs:1203:            \"unsupported command should emit a generic error CommandResult\",\ncrates/core/runtime/backend/src/lib.rs:1272:            .send(BackendServiceCommand {\ncrates/core/runtime/backend/src/lib.rs:1309:        // 1. Emit a CommandResult with ok=false (caller-visible error result)\ncrates/core/runtime/backend/src/lib.rs:1328:            .send(BackendServiceCommand {\ncrates/core/runtime/backend/src/lib.rs:1337:            \"command failure should emit a caller-visible CommandResult\",\ncrates/core/runtime/backend/src/lib.rs:1343:            \"CommandResult should have ok=false for handler errors\"\ncrates/core/runtime/backend/src/lib.rs:1351:            \"CommandResult.error should carry the handler message\"\ncrates/core/runtime/backend/src/lib.rs:1527:            .send(BackendServiceCommand {\ncrates/core/runtime/backend/src/lib.rs:1534:        // Collect CommandResult\ncrates/core/runtime/backend/src/lib.rs:1536:            next_command_result(&mut event_rx, \"play command should emit a CommandResult\").await;\ncrates/core/runtime/backend/src/lib.rs:1560:            .send(BackendServiceCommand {\ncrates/core/runtime/backend/src/lib.rs:1568:            next_command_result(&mut event_rx, \"next command should emit a CommandResult\").await;\ncrates/core/runtime/backend/src/lib.rs:1613:            .send(BackendServiceCommand {\ncrates/core/runtime/backend/src/lib.rs:1622:            \"pause-when-not-playing should return a CommandResult\",\ncrates/core/runtime/backend/src/lib.rs:1630:            \"CommandResult source_module must identify the provider\"\n","exit_code":0,"status":"completed"}}
