{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/core/shell/src/shell/discovery.rs | sed -n '1,220p'; nl -ba crates/core/shell/src/shell/discovery.rs | sed -n '220,520p'; nl -ba crates/core/shell/src/shell/discovery.rs | sed -n '520,720p'\"","aggregated_output":"     1\tuse super::component::{FrontendCatalog, FrontendCatalogHandle, FrontendSurfaceComponent};\n     2\tuse super::*;\n     3\tuse mesh_core_module::ModuleHealthRecord;\n     4\tuse rayon::prelude::*;\n     5\tuse std::collections::{BTreeMap, HashSet};\n     6\t\n     7\tconst BUILTIN_DEBUG_INSPECTOR_ID: &str = \"@mesh/debug-inspector\";\n     8\t\n     9\tpub(in crate::shell) fn installed_module_graph_path() -> PathBuf {\n    10\t    if let Ok(path) = std::env::var(\"MESH_MODULE_GRAPH_PATH\")\n    11\t        && !path.trim().is_empty()\n    12\t    {\n    13\t        return PathBuf::from(path);\n    14\t    }\n    15\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n    16\t        .join(\"../../..\")\n    17\t        .join(\"config/module.json\")\n    18\t}\n    19\t\n    20\tfn load_installed_module_graph_candidate(\n    21\t    root_module_graph_path: &Path,\n    22\t) -> Result<InstalledModuleGraph, mesh_core_module::package::ModuleManifestError> {\n    23\t    load_installed_module_graph(root_module_graph_path)\n    24\t}\n    25\t\n    26\t/// Layer a profile's sparse preferences and per-instance surface overrides on\n    27\t/// top of shared user defaults. The shared document remains untouched.\n    28\tpub(in crate::shell) fn effective_profile_settings(\n    29\t    shared: SettingsStore,\n    30\t    profile: Option<&mesh_core_module::package::ShellProfile>,\n    31\t) -> Result<SettingsStore, mesh_core_config::ConfigError> {\n    32\t    let Some(profile) = profile else {\n    33\t        return Ok(shared);\n    34\t    };\n    35\t    let path = shared.path().to_path_buf();\n    36\t    let mut document = shared.to_value();\n    37\t    let root = document\n    38\t        .as_object_mut()\n    39\t        .expect(\"SettingsStore always serializes an object\");\n    40\t    if let Some(theme) = &profile.resources.theme {\n    41\t        let target = root\n    42\t            .entry(\"shell\".to_string())\n    43\t            .or_insert_with(|| serde_json::json!({}));\n    44\t        mesh_core_config::merge_json(target, &serde_json::json!({ \"theme\": { \"active\": theme } }));\n    45\t    }\n    46\t    for (namespace, overrides) in &profile.settings {\n    47\t        let target = root\n    48\t            .entry(namespace.clone())\n    49\t            .or_insert_with(|| serde_json::json!({}));\n    50\t        mesh_core_config::merge_json(target, overrides);\n    51\t    }\n    52\t    for (instance_id, instance) in profile.roots.iter().filter(|(_, root)| root.active) {\n    53\t        let Some(surface) = &instance.surface else {\n    54\t            continue;\n    55\t        };\n    56\t        let target = root\n    57\t            .entry(instance_id.clone())\n    58\t            .or_insert_with(|| serde_json::json!({}));\n    59\t        mesh_core_config::merge_json(target, &serde_json::json!({ \"surface\": surface }));\n    60\t    }\n    61\t    SettingsStore::from_value(path, document)\n    62\t}\n    63\t\n    64\tfn builtin_state_contract(\n    65\t    interface: &str,\n    66\t    fields: &[(&str, &str)],\n    67\t) -> mesh_core_service::InterfaceContract {\n    68\t    builtin_contract(interface, fields, &[])\n    69\t}\n    70\t\n    71\t/// A core-provided contract: state fields the shell emits, plus the methods it\n    72\t/// answers itself.\n    73\t///\n    74\t/// The shell is the provider for these interfaces, so the methods here are the\n    75\t/// public, capability-gated way for any module to change composition and\n    76\t/// configuration. Declaring them as a contract rather than a reserved channel\n    77\t/// is what makes the settings frontend replaceable: the caller needs\n    78\t/// `service.<name>.control`, not a particular module id.\n    79\tfn builtin_contract(\n    80\t    interface: &str,\n    81\t    fields: &[(&str, &str)],\n    82\t    methods: &[(&str, &[(&str, &str)])],\n    83\t) -> mesh_core_service::InterfaceContract {\n    84\t    mesh_core_service::InterfaceContract {\n    85\t        interface: interface.to_string(),\n    86\t        version: mesh_core_service::parse_contract_version(\"1.0\")\n    87\t            .expect(\"built-in interface version must be valid\"),\n    88\t        state_fields: fields\n    89\t            .iter()\n    90\t            .map(|(name, field_type)| mesh_core_service::ContractStateField {\n    91\t                name: (*name).to_string(),\n    92\t                field_type: (*field_type).to_string(),\n    93\t                description: None,\n    94\t            })\n    95\t            .collect(),\n    96\t        methods: methods\n    97\t            .iter()\n    98\t            .map(|(name, args)| mesh_core_service::InterfaceMethod {\n    99\t                name: (*name).to_string(),\n   100\t                args: args\n   101\t                    .iter()\n   102\t                    .map(|(arg, arg_type)| mesh_core_service::InterfaceArgument {\n   103\t                        name: (*arg).to_string(),\n   104\t                        arg_type: (*arg_type).to_string(),\n   105\t                    })\n   106\t                    .collect(),\n   107\t                returns: Some(\"Result\".to_string()),\n   108\t                // These land in the shell synchronously; there is no backend\n   109\t                // queue to coalesce against and no optimistic state to bind.\n   110\t                coalesce: false,\n   111\t                state_binding: None,\n   112\t            })\n   113\t            .collect(),\n   114\t        events: Vec::new(),\n   115\t        types: HashMap::new(),\n   116\t        capabilities: mesh_core_service::ContractCapabilities::default(),\n   117\t    }\n   118\t}\n   119\t\n   120\t#[derive(Debug)]\n   121\tpub(super) struct DiscoveredModuleManifest {\n   122\t    pub(super) dir: PathBuf,\n   123\t    pub(super) loaded:\n   124\t        Result<mesh_core_module::LoadedManifest, mesh_core_module::manifest::ManifestError>,\n   125\t}\n   126\t\n   127\tpub(super) fn discover_shell_module_manifests(\n   128\t    module_dirs: &[PathBuf],\n   129\t) -> Vec<DiscoveredModuleManifest> {\n   130\t    let manifest_dirs = discover_shell_module_manifest_dirs(module_dirs);\n   131\t    load_shell_module_manifests(&manifest_dirs)\n   132\t}\n   133\t\n   134\tpub(super) fn discover_shell_module_manifest_dirs(module_dirs: &[PathBuf]) -> Vec<PathBuf> {\n   135\t    let mut discovered = Vec::new();\n   136\t    for dir in module_dirs {\n   137\t        if !dir.exists() {\n   138\t            tracing::debug!(\"module directory does not exist: {}\", dir.display());\n   139\t            continue;\n   140\t        }\n   141\t        discovered.extend(discover_shell_module_manifest_dirs_under(dir));\n   142\t    }\n   143\t    discovered\n   144\t}\n   145\t\n   146\tfn discover_shell_module_manifest_dirs_under(dir: &Path) -> Vec<PathBuf> {\n   147\t    if shell_module_manifest_exists(dir) {\n   148\t        return vec![dir.to_path_buf()];\n   149\t    }\n   150\t\n   151\t    let entries = match std::fs::read_dir(dir) {\n   152\t        Ok(entries) => entries,\n   153\t        Err(e) => {\n   154\t            tracing::warn!(\"failed to read module directory {}: {e}\", dir.display());\n   155\t            return Vec::new();\n   156\t        }\n   157\t    };\n   158\t    let mut child_dirs = entries\n   159\t        .flatten()\n   160\t        .map(|entry| entry.path())\n   161\t        .filter(|path| path.is_dir())\n   162\t        .collect::<Vec<_>>();\n   163\t    child_dirs.sort();\n   164\t\n   165\t    child_dirs\n   166\t        .par_iter()\n   167\t        .flat_map(|path| discover_shell_module_manifest_dirs_under(path))\n   168\t        .collect()\n   169\t}\n   170\t\n   171\tfn shell_module_manifest_exists(dir: &Path) -> bool {\n   172\t    dir.join(\"package.json\").exists()\n   173\t        || dir.join(\"module.json\").exists()\n   174\t        || dir.join(\"mesh.toml\").exists()\n   175\t}\n   176\t\n   177\tpub(super) fn load_shell_module_manifests(\n   178\t    module_dirs: &[PathBuf],\n   179\t) -> Vec<DiscoveredModuleManifest> {\n   180\t    module_dirs\n   181\t        .par_iter()\n   182\t        .map(|dir| DiscoveredModuleManifest {\n   183\t            dir: dir.clone(),\n   184\t            loaded: mesh_core_module::manifest::load_canonical_manifest(dir),\n   185\t        })\n   186\t        .collect()\n   187\t}\n   188\t\n   189\t/// Translate the graph's owner declarations into one complete schema snapshot\n   190\t/// before any module receives settings. The config foundation keeps the raw\n   191\t/// document; this graph-owned registration produces the validated projection.\n   192\tpub(in crate::shell) fn register_graph_settings_schemas(\n   193\t    store: &mut SettingsStore,\n   194\t    graph: &InstalledModuleGraph,\n   195\t) -> Result<(), mesh_core_config::SettingsSchemaError> {\n   196\t    let mut properties_by_namespace: BTreeMap<String, serde_json::Map<String, serde_json::Value>> =\n   197\t        graph\n   198\t            .modules()\n   199\t            .into_iter()\n   200\t            .map(|module| (module.id.clone(), module_settings_properties()))\n   201\t            .collect();\n   202\t\n   203\t    for contribution in graph.settings_schemas() {\n   204\t        let properties = properties_by_namespace\n   205\t            .get_mut(&contribution.namespace)\n   206\t            .ok_or_else(|| mesh_core_config::SettingsSchemaError::OwnerMismatch {\n   207\t                namespace: contribution.namespace.clone(),\n   208\t                owner: contribution.module_id.clone(),\n   209\t            })?;\n   210\t        let schema = if contribution.source.local_id == \"props\" {\n   211\t            let prop_schema = normalize_object_schema(&contribution.schema);\n   212\t            serde_json::json!({\n   213\t                \"type\": \"object\",\n   214\t                \"properties\": {\n   215\t                    \"global\": prop_schema,\n   216\t                    \"instances\": {\n   217\t                        \"type\": \"object\",\n   218\t                        \"additionalProperties\": prop_schema\n   219\t                    }\n   220\t                }\n   220\t                }\n   221\t            })\n   222\t        } else {\n   223\t            normalize_object_schema(&contribution.schema)\n   224\t        };\n   225\t        let Some(fields) = schema\n   226\t            .get(\"properties\")\n   227\t            .and_then(serde_json::Value::as_object)\n   228\t        else {\n   229\t            continue;\n   230\t        };\n   231\t        for (key, value) in fields {\n   232\t            merge_schema_property(properties, key, value);\n   233\t        }\n   234\t    }\n   235\t\n   236\t    let schemas = properties_by_namespace\n   237\t        .into_iter()\n   238\t        .map(|(namespace, properties)| {\n   239\t            SettingsNamespaceSchema::new(\n   240\t                namespace.clone(),\n   241\t                namespace,\n   242\t                serde_json::json!({\n   243\t                    \"type\": \"object\",\n   244\t                    \"properties\": properties\n   245\t                }),\n   246\t            )\n   247\t        })\n   248\t        .collect::<Result<Vec<_>, _>>()?;\n   249\t    store.replace_namespace_schemas_transactionally(schemas)\n   250\t}\n   251\t\n   252\tfn normalize_object_schema(schema: &serde_json::Value) -> serde_json::Value {\n   253\t    if schema.as_object().is_some_and(|schema| {\n   254\t        schema.get(\"type\").and_then(serde_json::Value::as_str) == Some(\"object\")\n   255\t    }) {\n   256\t        return schema.clone();\n   257\t    }\n   258\t    serde_json::json!({\n   259\t        \"type\": \"object\",\n   260\t        \"properties\": schema\n   261\t    })\n   262\t}\n   263\t\n   264\tfn merge_schema_property(\n   265\t    properties: &mut serde_json::Map<String, serde_json::Value>,\n   266\t    key: &str,\n   267\t    value: &serde_json::Value,\n   268\t) {\n   269\t    let Some(existing) = properties.get_mut(key) else {\n   270\t        properties.insert(key.to_string(), value.clone());\n   271\t        return;\n   272\t    };\n   273\t    let Some(existing_properties) = existing\n   274\t        .get_mut(\"properties\")\n   275\t        .and_then(serde_json::Value::as_object_mut)\n   276\t    else {\n   277\t        *existing = value.clone();\n   278\t        return;\n   279\t    };\n   280\t    let Some(incoming_properties) = value\n   281\t        .get(\"properties\")\n   282\t        .and_then(serde_json::Value::as_object)\n   283\t    else {\n   284\t        *existing = value.clone();\n   285\t        return;\n   286\t    };\n   287\t    for (nested_key, nested_value) in incoming_properties {\n   288\t        existing_properties.insert(nested_key.clone(), nested_value.clone());\n   289\t    }\n   290\t}\n   291\t\n   292\tfn module_settings_properties() -> serde_json::Map<String, serde_json::Value> {\n   293\t    serde_json::json!({\n   294\t        \"surface\": {\n   295\t            \"type\": \"object\",\n   296\t            \"properties\": {\n   297\t                \"role\": { \"type\": \"string\" },\n   298\t                \"promotable\": { \"type\": \"boolean\" },\n   299\t                \"title\": { \"type\": \"string\" },\n   300\t                \"app_id\": { \"type\": \"string\" },\n   301\t                \"resizable\": { \"type\": \"boolean\" },\n   302\t                \"decorations\": { \"type\": \"string\" },\n   303\t                \"anchor\": { \"type\": \"string\" },\n   304\t                \"layer\": { \"type\": \"string\" },\n   305\t                \"exclusive_zone\": { \"type\": \"integer\" },\n   306\t                \"keyboard_mode\": { \"type\": \"string\" },\n   307\t                \"visible_on_start\": { \"type\": \"boolean\" },\n   308\t                \"margin_top\": { \"type\": \"integer\" },\n   309\t                \"margin_right\": { \"type\": \"integer\" },\n   310\t                \"margin_bottom\": { \"type\": \"integer\" },\n   311\t                \"margin_left\": { \"type\": \"integer\" },\n   312\t                \"blur\": { \"type\": \"boolean\" }\n   313\t            }\n   314\t        },\n   315\t        \"props\": {\n   316\t            \"type\": \"object\",\n   317\t            \"properties\": {\n   318\t                \"global\": { \"type\": \"object\" },\n   319\t                \"instances\": {\n   320\t                    \"type\": \"object\",\n   321\t                    \"additionalProperties\": { \"type\": \"object\" }\n   322\t                }\n   323\t            }\n   324\t        },\n   325\t        \"icons\": {\n   326\t            \"type\": \"object\",\n   327\t            \"properties\": {\n   328\t                \"use_packs\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n   329\t                \"overrides\": {\n   330\t                    \"type\": \"object\",\n   331\t                    \"additionalProperties\": { \"type\": \"string\" }\n   332\t                },\n   333\t                \"ignore_shell_default\": { \"type\": \"boolean\" }\n   334\t            }\n   335\t        },\n   336\t        \"i18n\": {\n   337\t            \"type\": \"object\",\n   338\t            \"properties\": {\n   339\t                \"default_locale\": { \"type\": \"string\" }\n   340\t            }\n   341\t        }\n   342\t    })\n   343\t    .as_object()\n   344\t    .cloned()\n   345\t    .expect(\"module settings schema is an object\")\n   346\t}\n   347\t\n   348\t#[cfg(test)]\n   349\tpub(super) fn load_shell_module_manifests_serial(\n   350\t    module_dirs: &[PathBuf],\n   351\t) -> Vec<DiscoveredModuleManifest> {\n   352\t    module_dirs\n   353\t        .iter()\n   354\t        .map(|dir| DiscoveredModuleManifest {\n   355\t            dir: dir.clone(),\n   356\t            loaded: mesh_core_module::manifest::load_canonical_manifest(dir),\n   357\t        })\n   358\t        .collect()\n   359\t}\n   360\t\n   361\timpl Shell {\n   362\t    pub fn new() -> Self {\n   363\t        let config_path = mesh_core_config::default_config_path();\n   364\t        let config = load_config(&config_path).unwrap_or_else(|e| {\n   365\t            tracing::warn!(\"failed to load config, using defaults: {e}\");\n   366\t            ShellConfig {\n   367\t                shell: Default::default(),\n   368\t            }\n   369\t        });\n   370\t        let shared_settings = SettingsStore::load().unwrap_or_else(|e| {\n   371\t            tracing::warn!(\"failed to load settings, using defaults: {e}\");\n   372\t            SettingsStore::default()\n   373\t        });\n   374\t        let graph_path = installed_module_graph_path();\n   375\t        let capability_policy = RootModuleGraphManifest::from_path(&graph_path)\n   376\t            .map(|root| CapabilityPolicy::from_approvals(root.capability_approvals))\n   377\t            .unwrap_or_else(|error| {\n   378\t                tracing::warn!(\n   379\t                    \"failed to load capability approvals from {}: {error}\",\n   380\t                    graph_path.display()\n   381\t                );\n   382\t                CapabilityPolicy::default()\n   383\t            });\n   384\t        let active_profile = mesh_core_module::package::ProfilePaths::from_root_graph(&graph_path)\n   385\t            .and_then(|paths| paths.load_active())\n   386\t            .unwrap_or_else(|error| {\n   387\t                tracing::warn!(\"failed to load active shell profile: {error}\");\n   388\t                None\n   389\t            });\n   390\t        let active_profile_id = active_profile.as_ref().map(|(id, _)| id.clone());\n   391\t        let settings_store = Arc::new(\n   392\t            effective_profile_settings(\n   393\t                shared_settings,\n   394\t                active_profile.as_ref().map(|(_, profile)| profile),\n   395\t            )\n   396\t            .unwrap_or_else(|error| {\n   397\t                tracing::warn!(\"failed to apply active profile settings: {error}\");\n   398\t                SettingsStore::default()\n   399\t            }),\n   400\t        );\n   401\t        // A hand-edited file is the whole point of the store, so a bad value in\n   402\t        // it is reported and skipped, never fatal: the shell starts on declared\n   403\t        // defaults with the reason on stderr.\n   404\t        mesh_core_config::log_settings_diagnostics(\"settings\", settings_store.diagnostics());\n   405\t        let settings = settings_store.shell().clone();\n   406\t\n   407\t        // Discover and register XDG icon themes installed on the system.\n   408\t        // Icon-pack binding modules reference them by name in their\n   409\t        // mapping targets (`<theme>/<icon-name>`). Failures are logged\n   410\t        // but non-fatal — hicolor fallback still works.\n   411\t        for pack in mesh_core_icon::discover_xdg_packs() {\n   412\t            let id = pack.id.clone();\n   413\t            match mesh_core_icon::register_default_pack(pack) {\n   414\t                Ok(true) => tracing::info!(\"registered XDG icon theme '{}'\", id),\n   415\t                Ok(false) => tracing::debug!(\"XDG icon theme '{}' already registered\", id),\n   416\t                Err(err) => {\n   417\t                    tracing::warn!(\"failed to register XDG icon theme '{}': {err}\", id)\n   418\t                }\n   419\t            }\n   420\t        }\n   421\t        mesh_core_icon::set_default_shell_pack(settings.icons.default_pack.clone());\n   422\t        mesh_core_render::set_blur_quality(blur_quality_from_settings(&settings.render.blur));\n   423\t        let (theme, theme_watch) = load_active_theme(&settings);\n   424\t        let locale = LocaleEngine::with_fallback_locale(\n   425\t            settings.i18n.locale.clone(),\n   426\t            settings.i18n.fallback_locale.clone(),\n   427\t        );\n   428\t        let module_dirs = resolve_default_module_dirs(&config);\n   429\t        let settings_watch = {\n   430\t            let path = settings_store.path().to_path_buf();\n   431\t            let modified_at = std::fs::metadata(&path)\n   432\t                .ok()\n   433\t                .and_then(|m| m.modified().ok());\n   434\t            SettingsWatchState { path, modified_at }\n   435\t        };\n   436\t\n   437\t        let interfaces = InterfaceRegistry::new();\n   438\t        let mut theme_contract = builtin_contract(\n   439\t            \"mesh.theme\",\n   440\t            &[\n   441\t                (\"current\", \"string\"),\n   442\t                (\"theme_id\", \"string\"),\n   443\t                (\"mode\", \"string?\"),\n   444\t                (\"mode_policy\", \"object?\"),\n   445\t                (\"color_scheme\", \"string?\"),\n   446\t                (\"contrast\", \"string?\"),\n   447\t                (\"tokens\", \"object?\"),\n   448\t                (\"provenance\", \"object?\"),\n   449\t                (\"revision\", \"string\"),\n   450\t                (\"fingerprint\", \"integer?\"),\n   451\t                (\"is_dark\", \"boolean\"),\n   452\t                (\"themes\", \"object[]\"),\n   453\t                (\"available\", \"string[]\"),\n   454\t                (\"system_resources\", \"object\"),\n   455\t            ],\n   456\t            &[\n   457\t                (\"set_theme\", &[(\"theme_id\", \"string\")]),\n   458\t                (\"set_icon_theme\", &[(\"theme_id\", \"string\")]),\n   459\t                (\"set_font_family\", &[(\"family\", \"string\")]),\n   460\t            ],\n   461\t        );\n   462\t        theme_contract.events = vec![\n   463\t            mesh_core_service::InterfaceEvent {\n   464\t                name: \"ThemeChanged\".into(),\n   465\t                payload: [\n   466\t                    (\"theme_id\", \"string\"),\n   467\t                    (\"mode\", \"string\"),\n   468\t                    (\"mode_policy\", \"object\"),\n   469\t                    (\"color_scheme\", \"string\"),\n   470\t                    (\"contrast\", \"string\"),\n   471\t                    (\"revision\", \"string\"),\n   472\t                    (\"tokens\", \"object\"),\n   473\t                    (\"provenance\", \"object\"),\n   474\t                    (\"changed_tokens\", \"object[]\"),\n   475\t                ]\n   476\t                .into_iter()\n   477\t                .map(|(name, arg_type)| mesh_core_service::InterfaceArgument {\n   478\t                    name: name.into(),\n   479\t                    arg_type: arg_type.into(),\n   480\t                })\n   481\t                .collect(),\n   482\t            },\n   483\t            mesh_core_service::InterfaceEvent {\n   484\t                name: \"TokenChanged\".into(),\n   485\t                payload: [\n   486\t                    (\"theme_id\", \"string\"),\n   487\t                    (\"mode\", \"string\"),\n   488\t                    (\"name\", \"string\"),\n   489\t                    (\"value\", \"any?\"),\n   490\t                    (\"provenance\", \"any?\"),\n   491\t                    (\"revision\", \"string\"),\n   492\t                ]\n   493\t                .into_iter()\n   494\t                .map(|(name, arg_type)| mesh_core_service::InterfaceArgument {\n   495\t                    name: name.into(),\n   496\t                    arg_type: arg_type.into(),\n   497\t                })\n   498\t                .collect(),\n   499\t            },\n   500\t        ];\n   501\t        interfaces.register_contract(theme_contract);\n   502\t        // Locale writes stay on the `mesh.locale.set` host API, which already\n   503\t        // enforces `locale.write`. A second, service-shaped way in would mean\n   504\t        // two capability names for one operation.\n   505\t        interfaces.register_contract(builtin_state_contract(\n   506\t            \"mesh.locale\",\n   507\t            &[\n   508\t                (\"current\", \"string\"),\n   509\t                (\"locale\", \"string\"),\n   510\t                (\"chain\", \"string[]\"),\n   511\t                (\"direction\", \"string\"),\n   512\t                (\"revision\", \"string\"),\n   513\t            ],\n   514\t        ));\n   515\t        interfaces.register_contract(builtin_contract(\n   516\t            \"mesh.settings\",\n   517\t            &[(\"revision\", \"string\"), (\"namespaces\", \"object\")],\n   518\t            &[\n   519\t                (\n   520\t                    \"set_prop\",\n   520\t                    \"set_prop\",\n   521\t                    &[\n   522\t                        (\"module_id\", \"string\"),\n   523\t                        (\"instance_id\", \"string?\"),\n   524\t                        (\"prop\", \"string\"),\n   525\t                        (\"value\", \"any\"),\n   526\t                    ],\n   527\t                ),\n   528\t                (\n   529\t                    \"unset_prop\",\n   530\t                    &[\n   531\t                        (\"module_id\", \"string\"),\n   532\t                        (\"instance_id\", \"string?\"),\n   533\t                        (\"prop\", \"string\"),\n   534\t                    ],\n   535\t                ),\n   536\t            ],\n   537\t        ));\n   538\t        interfaces.register_contract(builtin_contract(\n   539\t            \"mesh.packages\",\n   540\t            &[\n   541\t                (\"modules\", \"object[]\"),\n   542\t                (\"providers\", \"object\"),\n   543\t                (\"profiles\", \"string[]\"),\n   544\t                (\"active_profile\", \"string\"),\n   545\t            ],\n   546\t            &[\n   547\t                (\n   548\t                    \"set_module_enabled\",\n   549\t                    &[(\"module_id\", \"string\"), (\"enabled\", \"boolean\")],\n   550\t                ),\n   551\t                (\n   552\t                    \"set_provider\",\n   553\t                    &[(\"interface\", \"string\"), (\"provider_id\", \"string\")],\n   554\t                ),\n   555\t                (\"switch_profile\", &[(\"profile_id\", \"string\")]),\n   556\t                (\n   557\t                    \"install\",\n   558\t                    &[\n   559\t                        (\"source\", \"string\"),\n   560\t                        (\"profile_id\", \"string?\"),\n   561\t                        (\"available_only\", \"boolean?\"),\n   562\t                        (\"allow_elevated\", \"boolean?\"),\n   563\t                        (\"allow_high\", \"boolean?\"),\n   564\t                    ],\n   565\t                ),\n   566\t                (\n   567\t                    \"uninstall\",\n   568\t                    &[(\"module_id\", \"string\"), (\"force\", \"boolean?\")],\n   569\t                ),\n   570\t            ],\n   571\t        ));\n   572\t        interfaces.register_contract(builtin_contract(\n   573\t            \"mesh.composition\",\n   574\t            &[\n   575\t                (\"profile_id\", \"string\"),\n   576\t                (\"generation\", \"string\"),\n   577\t                (\"roots\", \"object[]\"),\n   578\t                (\"slots\", \"object[]\"),\n   579\t                (\"palette\", \"object[]\"),\n   580\t            ],\n   581\t            &[\n   582\t                (\n   583\t                    \"apply_node_slot\",\n   584\t                    &[\n   585\t                        (\"profile_id\", \"string\"),\n   586\t                        (\"root_instance\", \"string\"),\n   587\t                        (\"slot\", \"string\"),\n   588\t                        (\"nodes\", \"object[]\"),\n   589\t                        (\"expected_generation\", \"string\"),\n   590\t                    ],\n   591\t                ),\n   592\t                (\n   593\t                    \"reset_node_slot\",\n   594\t                    &[\n   595\t                        (\"profile_id\", \"string\"),\n   596\t                        (\"root_instance\", \"string\"),\n   597\t                        (\"slot\", \"string\"),\n   598\t                        (\"expected_generation\", \"string\"),\n   599\t                    ],\n   600\t                ),\n   601\t            ],\n   602\t        ));\n   603\t        interfaces.register(InterfaceProvider {\n   604\t            interface: mesh_core_debug::DEBUG_INTERFACE.to_string(),\n   605\t            version: Some(\"1.0\".to_string()),\n   606\t            base_module: Some(\"@mesh/debug\".to_string()),\n   607\t            provider_module: mesh_core_debug::DEBUG_SOURCE_MODULE_ID.to_string(),\n   608\t            backend_name: \"Shell\".to_string(),\n   609\t            priority: 100,\n   610\t        });\n   611\t        interfaces.register(InterfaceProvider {\n   612\t            interface: \"mesh.theme\".to_string(),\n   613\t            version: Some(\"1.0\".to_string()),\n   614\t            base_module: Some(\"@mesh/theme-interface\".to_string()),\n   615\t            provider_module: \"@mesh/shell\".to_string(),\n   616\t            backend_name: \"Shell Theme\".to_string(),\n   617\t            priority: 200,\n   618\t        });\n   619\t        interfaces.register(InterfaceProvider {\n   620\t            interface: \"mesh.locale\".to_string(),\n   621\t            version: Some(\"1.0\".to_string()),\n   622\t            base_module: Some(\"@mesh/locale-interface\".to_string()),\n   623\t            provider_module: \"@mesh/shell\".to_string(),\n   624\t            backend_name: \"Shell Locale\".to_string(),\n   625\t            priority: 200,\n   626\t        });\n   627\t        interfaces.register(InterfaceProvider {\n   628\t            interface: \"mesh.settings\".to_string(),\n   629\t            version: Some(\"1.0\".to_string()),\n   630\t            base_module: Some(\"@mesh/settings-interface\".to_string()),\n   631\t            provider_module: \"@mesh/shell\".to_string(),\n   632\t            backend_name: \"Shell Settings Store\".to_string(),\n   633\t            priority: 200,\n   634\t        });\n   635\t        interfaces.register(InterfaceProvider {\n   636\t            interface: \"mesh.packages\".to_string(),\n   637\t            version: Some(\"1.0\".to_string()),\n   638\t            base_module: Some(\"@mesh/packages-interface\".to_string()),\n   639\t            provider_module: \"@mesh/shell\".to_string(),\n   640\t            backend_name: \"Shell Package Graph\".to_string(),\n   641\t            priority: 200,\n   642\t        });\n   643\t        interfaces.register(InterfaceProvider {\n   644\t            interface: \"mesh.composition\".to_string(),\n   645\t            version: Some(\"1.0\".to_string()),\n   646\t            base_module: Some(\"@mesh/composition-interface\".to_string()),\n   647\t            provider_module: \"@mesh/shell\".to_string(),\n   648\t            backend_name: \"Shell Composition\".to_string(),\n   649\t            priority: 200,\n   650\t        });\n   651\t\n   652\t        let now = std::time::Instant::now();\n   653\t\n   654\t        Self {\n   655\t            config,\n   656\t            settings,\n   657\t            settings_store,\n   658\t            theme,\n   659\t            locale,\n   660\t            diagnostics: DiagnosticsCollector::new(),\n   661\t            interfaces,\n   662\t            capability_policy,\n   663\t            effective_capabilities: Arc::new(HashMap::new()),\n   664\t            installed_module_graph: None,\n   665\t            active_profile_id,\n   666\t            modules: HashMap::new(),\n   667\t            frontend_catalog: FrontendCatalogHandle::default(),\n   668\t            module_dirs,\n   669\t            core: ShellCoreState::default(),\n   670\t            last_published_theme_snapshot: None,\n   671\t            components: Vec::new(),\n   672\t            components_want_render: false,\n   673\t            presented_last_frame: true,\n   674\t            component_by_surface: HashMap::new(),\n   675\t            service_delivery_index: ServiceDeliveryIndex::default(),\n   676\t            surfaces: HashMap::new(),\n   677\t            clipboard: Box::new(WaylandClipboard::default()),\n   678\t            presentation_engine: PresentationEngine::select(),\n   679\t            eventfd_fd: None,\n   680\t            theme_watch,\n   681\t            settings_watch,\n   682\t            next_theme_reload_check: now,\n   683\t            next_shell_settings_reload_check: now,\n   684\t            next_frontend_reload_check: now,\n   685\t            file_watcher_active: false,\n   686\t            debug: DebugOverlayState::default(),\n   687\t            debug_overlay: DebugOverlay::new(),\n   688\t            active_key_modifiers: KeyModifiers::default(),\n   689\t            keyboard_focus_surface: None,\n   690\t            pending_wayland_events: VecDeque::new(),\n   691\t            transfer_owned_keyboard_modes: HashMap::new(),\n   692\t            service_handlers: HashMap::new(),\n   693\t            backend_runtimes: HashMap::new(),\n   694\t            pending_backend_runtimes: HashMap::new(),\n   695\t            pending_profile_switch: None,\n   696\t            deferred_requests: VecDeque::new(),\n   697\t            backend_runtime_statuses: HashMap::new(),\n   698\t            backend_supervision: HashMap::new(),\n   699\t            backend_respawn: None,\n   700\t            latest_service_state: HashMap::new(),\n   701\t            latest_service_health: HashMap::new(),\n   702\t            service_contract_validation: HashMap::new(),\n   703\t            pending_bound_service_state: HashMap::new(),\n   704\t            bound_service_state_transactions: HashMap::new(),\n   705\t            command_throttle: HashMap::new(),\n   706\t            pending_service_call_routes: HashMap::new(),\n   707\t            pending_popover_hides: HashMap::new(),\n   708\t            profiling: runtime::profiling::ProfilingRuntimeState::default(),\n   709\t        }\n   710\t    }\n   711\t\n   712\t    pub fn discover_modules(&mut self) {\n   713\t        let graph = match self.load_installed_module_graph_candidate() {\n   714\t            Ok(graph) => graph,\n   715\t            Err(error) => {\n   716\t                tracing::error!(\n   717\t                    \"failed to load installed module graph; retaining last-known-good discovery: {error}\"\n   718\t                );\n   719\t                return;\n   720\t            }\n","exit_code":0,"status":"completed"}}
