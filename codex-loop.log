{"type":"item.completed","item":{"id":"item_212","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"sed -n '35,180p' crates/core/ui/component/src/lib.rs; sed -n '225,285p' crates/core/ui/component/src/lib.rs; sed -n '200,275p' crates/core/ui/component/src/parser/props.rs; sed -n '290,335p' crates/core/shell/src/shell/profile.rs\"","aggregated_output":"    ComponentModule(String),\n    /// A MESH interface API, such as `mesh.audio` with an optional version requirement.\n    InterfaceApi {\n        interface: String,\n        version: Option<String>,\n    },\n}\n\n/// A parsed `.mesh` single-file component.\n#[derive(Debug, Clone)]\npub struct ComponentFile {\n    pub imports: Vec<ComponentImport>,\n    pub props: Option<PropsBlock>,\n    pub template: Option<TemplateBlock>,\n    pub script: Option<ScriptBlock>,\n    pub style: Option<StyleBlock>,\n}\n\n/// A parsed `<props>` block: the component's typed, defaulted configuration.\n///\n/// Each entry auto-projects to a `prop(name)` CSS reference, a reactive\n/// `props.name` script field, and a generated settings-UI row. See\n/// `docs/spec/03-components.md`.\n#[derive(Debug, Clone, Default, PartialEq)]\npub struct PropsBlock {\n    pub props: Vec<PropDef>,\n}\n\n/// A single declared prop.\n#[derive(Debug, Clone, PartialEq)]\npub struct PropDef {\n    pub name: String,\n    pub ty: PropType,\n    pub default: Option<PropValue>,\n    pub label: Option<LocalizedLabel>,\n    pub description: Option<LocalizedLabel>,\n    /// Allowed values for `enum` props.\n    pub options: Vec<String>,\n    pub min: Option<f64>,\n    pub max: Option<f64>,\n    pub step: Option<f64>,\n    pub unit: Option<String>,\n    /// Whether the prop appears in the generated settings UI (default `true`).\n    pub expose: bool,\n}\n\n/// The validated value domain of a prop. Drives CSS projection, the Lua value\n/// kind, the generated settings control, and use-site type checking.\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum PropType {\n    Size,\n    Number,\n    Int,\n    Bool,\n    Enum,\n    String,\n    Color,\n    Token,\n    Duration,\n    Icon,\n}\n\nimpl PropType {\n    pub fn from_str(value: &str) -> Option<Self> {\n        Some(match value {\n            \"size\" => Self::Size,\n            \"number\" => Self::Number,\n            \"int\" => Self::Int,\n            \"bool\" => Self::Bool,\n            \"enum\" => Self::Enum,\n            \"string\" => Self::String,\n            \"color\" => Self::Color,\n            \"token\" => Self::Token,\n            \"duration\" => Self::Duration,\n            \"icon\" => Self::Icon,\n            _ => return None,\n        })\n    }\n\n    pub fn as_str(self) -> &'static str {\n        match self {\n            Self::Size => \"size\",\n            Self::Number => \"number\",\n            Self::Int => \"int\",\n            Self::Bool => \"bool\",\n            Self::Enum => \"enum\",\n            Self::String => \"string\",\n            Self::Color => \"color\",\n            Self::Token => \"token\",\n            Self::Duration => \"duration\",\n            Self::Icon => \"icon\",\n        }\n    }\n\n    pub fn lua_type(self) -> &'static str {\n        match self {\n            Self::Number | Self::Int | Self::Duration => \"number\",\n            Self::Bool => \"boolean\",\n            Self::Size | Self::Enum | Self::String | Self::Color | Self::Token | Self::Icon => {\n                \"string\"\n            }\n        }\n    }\n}\n\n/// A scalar prop value (used for `default`).\n#[derive(Debug, Clone, PartialEq)]\npub enum PropValue {\n    String(String),\n    Number(f64),\n    Bool(bool),\n}\n\nimpl PropValue {\n    pub fn type_name(&self) -> &'static str {\n        match self {\n            Self::String(_) => \"string\",\n            Self::Number(_) => \"number\",\n            Self::Bool(_) => \"boolean\",\n        }\n    }\n}\n\n#[derive(Debug, Clone, PartialEq)]\npub struct PropValidationError {\n    pub message: String,\n}\n\nimpl std::fmt::Display for PropValidationError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.write_str(&self.message)\n    }\n}\n\nimpl std::error::Error for PropValidationError {}\n\npub fn validate_prop_value(def: &PropDef, value: &PropValue) -> Result<(), PropValidationError> {\n    match def.ty {\n        PropType::Size => validate_size_prop(def, value),\n        PropType::Number => validate_number_prop(def, value),\n        PropType::Int => validate_int_prop(def, value),\n        PropType::Bool => match value {\n            PropValue::Bool(_) => Ok(()),\n            _ => Err(type_error(def, \"boolean\", value)),\n        },\n        PropType::Enum => match value {\n}\n\npub fn prop_value_to_json(value: &PropValue) -> serde_json::Value {\n    match value {\n        PropValue::String(s) => serde_json::Value::String(s.clone()),\n        PropValue::Number(n) => serde_json::json!(n),\n        PropValue::Bool(b) => serde_json::Value::Bool(*b),\n    }\n}\n\n/// Derive the settings schema projected by a component's exposed props.\n///\n/// This lives with the prop grammar so graph discovery, the compiler, the LSP,\n/// and settings UI cannot grow separate schema translations.\npub fn props_settings_schema(block: Option<&PropsBlock>) -> Option<serde_json::Value> {\n    let block = block?;\n    let mut properties = serde_json::Map::new();\n    for def in &block.props {\n        if !def.expose {\n            continue;\n        }\n        let mut field = serde_json::Map::new();\n        field.insert(\n            \"type\".into(),\n            serde_json::Value::String(def.ty.as_str().into()),\n        );\n        if let Some(default) = &def.default {\n            field.insert(\"default\".into(), prop_value_to_json(default));\n        }\n        if let Some(label) = &def.label {\n            field.insert(\"label\".into(), localized_label_to_json(label));\n        }\n        if let Some(description) = &def.description {\n            field.insert(\"description\".into(), localized_label_to_json(description));\n        }\n        if !def.options.is_empty() {\n            field.insert(\n                \"enum\".into(),\n                serde_json::Value::Array(\n                    def.options\n                        .iter()\n                        .map(|option| serde_json::Value::String(option.clone()))\n                        .collect(),\n                ),\n            );\n        }\n        if let Some(min) = def.min {\n            field.insert(\"minimum\".into(), serde_json::json!(min));\n        }\n        if let Some(max) = def.max {\n            field.insert(\"maximum\".into(), serde_json::json!(max));\n        }\n        if let Some(step) = def.step {\n            field.insert(\"step\".into(), serde_json::json!(step));\n        }\n        if let Some(unit) = &def.unit {\n            field.insert(\"unit\".into(), serde_json::Value::String(unit.clone()));\n        }\n        properties.insert(def.name.clone(), serde_json::Value::Object(field));\n    }\n    (!properties.is_empty())\n            if key.is_empty() {\n                return Err(invalid(\"expected a field name inside a prop definition\"));\n            }\n            self.skip_ws();\n            if self.next() != Some(':') {\n                return Err(invalid(format!(\"expected `:` after field `{key}`\")));\n            }\n            let value = self.read_value()?;\n            fields.push((key, value));\n        }\n    }\n}\n\npub(super) fn parse_props(source: &str) -> Result<PropsBlock, ParseError> {\n    let mut scanner = Scanner::new(source);\n    let mut props: Vec<PropDef> = Vec::new();\n\n    loop {\n        scanner.skip_trivia();\n        if scanner.peek().is_none() {\n            break;\n        }\n        let name = scanner.read_ident();\n        if name.is_empty() {\n            return Err(invalid(format!(\n                \"expected a prop name, found {}\",\n                describe(scanner.peek())\n            )));\n        }\n        scanner.skip_ws();\n        if scanner.next() != Some(':') {\n            return Err(invalid(format!(\"expected `:` after prop `{name}`\")));\n        }\n        let fields = scanner.read_object()?;\n        if props.iter().any(|p| p.name == name) {\n            return Err(invalid(format!(\"duplicate prop `{name}`\")));\n        }\n        props.push(build_prop(name, fields)?);\n    }\n\n    Ok(PropsBlock { props })\n}\n\nfn build_prop(name: String, fields: Vec<(String, RawValue)>) -> Result<PropDef, ParseError> {\n    let mut ty: Option<PropType> = None;\n    let mut default: Option<PropValue> = None;\n    let mut label: Option<LocalizedLabel> = None;\n    let mut description: Option<LocalizedLabel> = None;\n    let mut options: Vec<String> = Vec::new();\n    let mut min: Option<f64> = None;\n    let mut max: Option<f64> = None;\n    let mut step: Option<f64> = None;\n    let mut unit: Option<String> = None;\n    let mut expose = true;\n\n    for (key, value) in fields {\n        match key.as_str() {\n            \"type\" => {\n                let raw = expect_string(&key, &name, &value)?;\n                ty =\n                    Some(PropType::from_str(&raw).ok_or_else(|| {\n                        invalid(format!(\"prop `{name}` has unknown type `{raw}`\"))\n                    })?);\n            }\n            \"default\" => default = Some(to_prop_value(&key, &name, value)?),\n            \"label\" => label = Some(to_label(&key, &name, value)?),\n            \"description\" => description = Some(to_label(&key, &name, value)?),\n            \"options\" => options = to_string_array(&key, &name, value)?,\n            \"min\" => min = Some(expect_number(&key, &name, &value)?),\n            \"max\" => max = Some(expect_number(&key, &name, &value)?),\n            \"step\" => step = Some(expect_number(&key, &name, &value)?),\n            \"unit\" => unit = Some(expect_string(&key, &name, &value)?),\n            \"expose\" => expose = expect_bool(&key, &name, &value)?,\n            other => {\n                return Err(invalid(format!(\n                    \"prop `{name}` has unknown field `{other}`\"\n                                .map(|(index, reference)| {\n                                    serde_json::json!({\n                                        \"id\": format!(\"default-{index}\"),\n                                        \"use\": reference,\n                                        \"props\": {},\n                                    })\n                                })\n                                .collect(),\n                        )\n                    });\n                slots.push(serde_json::json!({\n                    \"root_instance\": root_instance,\n                    \"name\": slot_name,\n                    \"contract\": point,\n                    \"layout\": hosted.and_then(|hosted| hosted.layout.clone()).unwrap_or_else(|| \"row\".into()),\n                    \"max\": hosted.and_then(|hosted| hosted.max),\n                    \"defaults\": defaults,\n                    \"nodes\": effective,\n                    \"overridden\": catalog.node_slot_placement(root_instance, slot_name).is_some(),\n                }));\n                for contribution in catalog.extension_point_contributions_for(&root.module, point) {\n                    let compiled = catalog\n                        .contribution_entry(\n                            &contribution.source_module_id,\n                            &contribution.contribution_id,\n                        )\n                        .expect(\"resolved contribution is compiled\");\n                    palette.push(serde_json::json!({\n                        \"contract\": point,\n                        \"use\": format!(\"{}:{}\", contribution.source_module_id, contribution.contribution_id),\n                        \"module\": contribution.source_module_id,\n                        \"id\": contribution.contribution_id,\n                        \"props_schema\": mesh_core_component::props_settings_schema(\n                            compiled.component.props.as_ref()\n                        ),\n                    }));\n                }\n            }\n        }\n        palette.sort_by(|left, right| left[\"use\"].as_str().cmp(&right[\"use\"].as_str()));\n        palette.dedup_by(|left, right| left[\"use\"] == right[\"use\"]);\n\n        self.broadcast_service_event(ServiceEvent::Updated {\n            service: \"mesh.composition\".into(),\n            source_module: \"@mesh/shell\".into(),\n            payload: serde_json::json!({\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_213","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc 'rg -n -C 8 \"owner-scoped|global pool|template|props|settings|translator\" .planning/log/sections/05-localization-i18n/improvements.md'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_213","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc 'rg -n -C 8 \"owner-scoped|global pool|template|props|settings|translator\" .planning/log/sections/05-localization-i18n/improvements.md'","aggregated_output":"1-# Section 5 — Localization / i18n: improvement audit\n2-\n3-**Audited:** 2026-08-19\n4-**Scope:** `mesh-core-locale`, canonical i18n contributions and diagnostics,\n5-shell startup/profile/reload paths, component and Luau consumption, localized\n6:manifest/props data, settings persistence, capabilities, and CLI/LSP tooling.\n7-\n8-This is a point-in-time review record, not a second task tracker. Open work from\n9-this audit lives in [`docs/BACKLOG.md`](../../../../docs/BACKLOG.md).\n10-\n11-## Logical process map\n12-\n13-The shipped path currently has three localization authorities which never form\n14-one coherent snapshot:\n15-\n16-```text\n17:settings.json + optional active profile       canonical InstalledModuleGraph\n18-  shell.i18n.locale/fallback_locale                     │\n19-                 │                                      ▼\n20-                 ▼                              contributed_i18n()\n21-      Shell LocaleEngine                        {owner, locale, path}\n22-      (selection, no catalogs)                           │\n23-                 │                                      ▼\n24-                 │                           raw module_dir.join(path)\n25-                 │                                      │\n26-                 │                     repeated for every mounted surface\n27-                 │                                      ▼\n28-                 └──────── locale string ──► FrontendSurfaceComponent\n29-                                               ├─ private LocaleEngine\n30-                                               ├─ reread/parse every catalog\n31:                                               ├─ module maps + global pool\n32-                                               └─ copied map per ScriptContext\n33-                                                        │\n34-                       ┌────────────────────────────────┼───────────────┐\n35-                       ▼                                ▼               ▼\n36:               template t(expr)                 mesh.i18n.t()   manifest text\n37-               global lookup                    module map      mixed resolvers\n38-                       │                                │               │\n39-                       └──────── miss: raw key ─────────┴──── diagnostics vary\n40-\n41-mesh.locale.set(locale)\n42-  └─ shell event → prepend locale to old chain → refresh all surfaces\n43:       ├─ does not persist settings\n44-       ├─ does not carry the configured/derived chain to components\n45-       └─ publishes only { current, locale }\n46-\n47-catalog edit / pack enablement / retained surface during profile switch\n48-  ╳ no catalog watcher, shared candidate, atomic commit, or live refresh\n49-```\n50-\n51-The result is that graph state controls which paths are handed to a newly\n52-mounted surface, each surface independently owns catalog contents, and the\n53-shell owns locale selection and some manifest lookups without owning any\n54-catalog contents.\n55-\n56-## Confirmed findings\n57-\n58:### 1. Critical — module-scoped translations leak through a global pool\n59-\n60-`LocaleEngine::load_module_translations` stores a catalog under its module ID\n61-and then also merges it into `translations`\n62-(`crates/core/foundation/locale/src/lib.rs:70`). Both\n63-`translate_for_module` and `effective_translations_for_module` fall back to\n64-that pool (`:94` and `:109`). The last loaded module silently wins duplicate\n65-global keys.\n66-\n--\n68-calls global `translate` (`crates/core/runtime/scripting/src/context/state.rs:412`).\n69-A key missing from one module can therefore render text owned by an unrelated\n70-module, with output depending on graph/catalog load order. This violates the\n71-specification's primary isolation rule and lets an untrusted module spoof text\n72-inside another module.\n73-\n74-**Improve it:** remove implicit global fallback. Every lookup must carry an\n75-owning module or an explicitly named interface/core catalog domain. Build a\n76:module-scoped translator from deterministic layers and use it for templates,\n77:scripts, manifests, props, debug data, and generated settings UI.\n78-\n79-### 2. Critical — locale selection and fallback semantics are incorrect\n80-\n81-`set_locale` inserts a new string at the front of the existing fallback vector\n82-and deduplicates it (`crates/core/foundation/locale/src/lib.rs:56`). Old active\n83-locales remain as accidental fallbacks. Constructors create only an exact\n84-active/fallback pair (`:23` and `:33`): there is no BCP 47 validation,\n85-canonicalization, or region/script parent derivation, so `sk-SK` does not find\n--\n114-one module-aware interpolation/plural/number/date/duration formatter to every\n115-consumption surface.\n116-\n117-### 4. High — catalog lifecycle is stale, repeated, and non-transactional\n118-\n119-Every surface synchronously reads and parses every graph catalog during mount\n120-(`crates/core/shell/src/shell/component/shell_component/mod.rs:79` and\n121-`shell/component/runtime.rs:248`). Existing surfaces retain those private maps.\n122:The watcher includes settings, theme, and component source paths but no catalog\n123-files (`crates/core/shell/src/shell/runtime/mod.rs:443`). Graph changes and\n124-profile switches attach a new path vector only to newly constructed surfaces;\n125-retained surfaces keep the old set (`shell/profile.rs:520` and `:855`).\n126-\n127-Settings/profile locale changes reconstruct only the shell engine, which has no\n128-catalogs, then ask each component to reinterpret its existing maps\n129-(`shell/runtime/theme.rs:395` and `shell/profile.rs:801`). An unreadable or\n130-malformed catalog is only a warning and a candidate can commit with a partial\n--\n151-exactly once, retaining the winning source for `which`, diagnostics, and debug\n152-inspection. Detect duplicate identities and ambiguous precedence before\n153-activation.\n154-\n155-### 6. High — locale writes are non-durable and module defaults corrupt live state\n156-\n157-`apply_set_locale` trims only empty input, mutates the in-memory engine, and\n158-broadcasts (`crates/core/shell/src/shell/runtime/theme.rs:455`). It does not\n159:write the sparse settings/profile store, so restart or settings reload loses\n160-the choice.\n161-\n162:Separately, component settings interpret `i18n.default_locale` as a new active\n163-locale (`shell/component/shell_component/mod.rs:1226`). That path neither\n164-refreshes the copied Luau translation maps nor runs the normal locale\n165-invalidation flow, so a component engine, existing `t()` closure, and the shell\n166-can disagree.\n167-\n168:**Improve it:** route manual, service, settings, and profile changes through one\n169-revision-checked durable selection transaction. Treat module default locale as\n170-metadata in resolution, never as a component-local active-locale override.\n171-\n172-### 7. High — the Luau API and capability boundary contradict themselves\n173-\n174-Runtime documentation and LSP knowledge advertise\n175-`mesh.locale.translate(key, params)`, but `install_locale_api` installs only\n176-`current` and `set` (`crates/core/runtime/scripting/src/host_api.rs:14` and\n--\n179-\n180-The direct host table is returned before interface-proxy resolution.\n181-`mesh.locale.current()` is installed without a `locale.read` check, and\n182-`require(\"mesh.i18n\")` returns the catalog helper before capability checks\n183-(`context/runtime/host_api.rs:125` and `:368`). A module without `locale.read`\n184-can inspect locale state and probe effective keys, while `set` alone checks\n185-`locale.write`.\n186-\n187:**Improve it:** choose one contract: `mesh.i18n` should be the scoped translator\n188-and `mesh.locale` the typed selection/formatting interface, or combine them\n189-deliberately. Generate runtime and LSP surfaces from the same ABI and enforce\n190-read/write capabilities consistently at creation and every operation.\n191-\n192-### 8. High — misses and localized metadata are handled inconsistently\n193-\n194:Luau `t()` and template `t(expr)` return the raw key without a diagnostic\n195-(`crates/core/runtime/scripting/src/context/runtime/helpers.rs:131` and\n196-`crates/core/frontend/compiler/src/expr.rs:322`), rather than the specified\n197-visible `!!key`. Manifest text has a separate resolver which can emit a degraded\n198-diagnostic, while the shell/debug engine generally has no loaded catalogs.\n199-\n200-Props preserve `{t, fallback}`, but generated frontends contain ad hoc\n201-resolution logic and can fall back to a prop name instead of resolving in the\n202-owner module. Static graph diagnostics inspect only literal `t()` calls against\n--\n239-**Improve it:** drive LSP, CLI, extraction, and doctor output from the compiled\n240-catalog/graph model. Either implement inline component catalogs with explicit\n241-precedence or reject `<i18n>` with a migration diagnostic; never accept and\n242-discard author input.\n243-\n244-## Recommended target architecture\n245-\n246-```text\n247:InstalledModuleGraph + profile resource selection + sparse settings\n248-        │\n249-        ▼\n250-LocaleCoordinator::prepare(graph, selection, prior_snapshot)\n251-  ├─ validate/canonicalize BCP 47 active tag and fallback chain\n252-  ├─ open contained, bounded catalog sources\n253-  ├─ compile typed message/plural/select/placeholder entries\n254-  ├─ resolve target modules and ordered language-pack layers\n255-  └─ produce Arc<CatalogSnapshot>\n256:       { revision, selection, direction, module translators,\n257-         source provenance, structured diagnostics }\n258-        │\n259-        ▼\n260:atomic last-known-good commit + durable settings/profile revision\n261-        │\n262:        ├─ module-scoped Translator handles for template/Luau/manifest/props\n263-        ├─ one LocaleChanged event with selection + snapshot revision\n264-        ├─ dependency-aware component invalidation\n265-        └─ CLI/LSP/doctor inspection of the same graph and provenance\n266-```\n267-\n268-A useful feature beyond the current flow is an explicit locale policy\n269-(`manual`, `follow-system`, or per-profile). Portal/environment changes should\n270-enter the same prepare/persist/commit path, and direction should be snapshot\n271-metadata so RTL layout changes cannot race translation changes.\n272-\n273-## Recommended implementation order\n274-\n275-1. Add regressions for cross-module leakage, stale fallback accumulation,\n276-   region/script fallback, plural-file rejection, non-durable selection,\n277-   retained-surface catalog staleness, API drift, and capability bypass.\n278:2. Freeze the canonical settings and contribution shapes; validate BCP 47,\n279-   nonempty/unique contribution identities, target modules, and pack order.\n280-3. Introduce typed catalog entries, per-entry diagnostics, limits, contained\n281-   source handles, and the immutable central snapshot.\n282:4. Remove the global pool and pass module-scoped translators through every\n283:   template, script, manifest, props, settings, and debug surface.\n284-5. Implement language-pack composition and per-module terminal defaults with\n285-   provenance and deterministic precedence.\n286:6. Route startup, settings/service writes, profile/graph changes, and catalog\n287-   reload through one durable prepare/commit coordinator.\n288-7. Align `mesh.i18n`, `mesh.locale`, service state/events, capabilities, LSP,\n289-   and CLI with one generated contract; add formatting and directionality.\n290:8. Add catalog watches, narrow invalidation by translator generation/key\n291-   dependencies, system-locale policy, extraction, missing-key, and `which`\n292-   tooling.\n293-\n294-## Required regression coverage\n295-\n296-- A module never resolves another module's catalog key, regardless of graph or\n297-  load order; explicit interface catalogs remain independently scoped.\n298-- BCP 47 tags normalize and derive parents (`zh-Hant-TW → zh-Hant → zh`), stale\n299-  active locales never remain in the chain, and each module default is terminal\n300-  only for that module.\n301-- String and plural/select entries coexist in one file; Slovak and English\n302-  categories, placeholder consistency, malformed sibling isolation, and size\n303-  limits are covered.\n304-- Two targeted packs shadow one module key in configured order; unrelated or\n305-  disabled packs do not participate; provenance identifies the winner.\n306:- Manual locale selection persists in the correct profile/settings scope and\n307-  survives restart; stale revisions and invalid tags do not mutate live state.\n308-- Catalog edits, graph enable/disable, and profile switches refresh retained and\n309-  new surfaces on one revision; an invalid candidate retains the old snapshot.\n310-- Catalog paths cannot escape through absolute, parent, or symlink traversal;\n311-  catalog bytes are read and parsed once per snapshot rather than once per\n312-  surface.\n313:- Templates, existing Luau `t()` handles, manifests, props, generated settings,\n314-  and debug data resolve the same module/revision and emit `!!key` plus one\n315-  structured miss diagnostic.\n316-- Runtime, service, documentation, and LSP APIs agree; `locale.read` and\n317-  `locale.write` denial is enforced consistently.\n318-- `<i18n>` is either compiled with documented precedence or rejected explicitly;\n319-  CLI/LSP locale discovery follows canonical graph contributions.\n320-\n321-## Verification\n","exit_code":0,"status":"completed"}}
