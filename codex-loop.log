evision().saturating_add(1)\n   860\t        };\n   861\t        let selection = mesh_core_locale::LocaleSelection::try_new(\n   862\t            candidate.current(),\n   863\t            candidate.fallback_locale(),\n   864\t            revision,\n   865\t        )\n   866\t        .map_err(|error| ShellRunError::LocaleCatalog(error.to_string()))?;\n   867\t        candidate.replace_selection(&selection);\n   868\t        Ok(candidate)\n   869\t    }\n   870\t\n   871\t    /// Commit a graph and its prepared locale candidate as one in-memory\n   872\t    /// activation boundary. Callers that need to prepare runtime objects first\n   873\t    /// use `commit_installed_module_graph_with_locale` with the same candidate.\n   874\t    pub(in crate::shell) fn commit_installed_module_graph(\n   875\t        &mut self,\n   876\t        graph: InstalledModuleGraph,\n   877\t    ) -> Result<(), ShellRunError> {\n   878\t        let locale = self.prepare_locale_for_graph(&graph)?;\n   879\t        self.commit_installed_module_graph_with_locale(graph, locale);\n   880\t        Ok(())\n   881\t    }\n   882\t\n   883\t    pub(in crate::shell) fn commit_installed_module_graph_with_locale(\n   884\t        &mut self,\n   885\t        graph: InstalledModuleGraph,\n   886\t        locale: LocaleEngine,\n   887\t    ) {\n   888\t        self.sync_module_graph_health(&graph);\n   889\t        self.locale = locale;\n   890\t        self.installed_module_graph = Some(graph);\n   891\t    }\n   892\t\n   893\t    /// Project immutable graph diagnostics into the live module records. The\n   894\t    /// graph remains static and reloadable; runtime failures are recorded on\n   895\t    /// the corresponding ModuleInstance instead of mutating this snapshot.\n   896\t    fn sync_module_graph_health(&mut self, graph: &InstalledModuleGraph) {\n   897\t        for (module_id, module) in &mut self.modules {\n   898\t            let Some(node) = graph.module(module_id) else {\n   899\t          