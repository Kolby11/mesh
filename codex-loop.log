{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/core/foundation/config/src/lib.rs | sed -n '1,280p'; nl -ba crates/core/foundation/config/src/lib.rs | sed -n '280,620p'; nl -ba crates/core/foundation/config/src/lib.rs | sed -n '620,980p'\"","aggregated_output":"     1\t//! Shell configuration loading and validation.\n     2\t\n     3\tuse serde::{Deserialize, Serialize};\n     4\tuse serde_json::Value as JsonValue;\n     5\tuse std::collections::HashMap;\n     6\tuse std::path::{Path, PathBuf};\n     7\t\n     8\tpub use mesh_core_theme::ThemeModePolicy;\n     9\t\n    10\tpub mod settings;\n    11\tpub mod validate;\n    12\t\n    13\tpub use settings::{\n    14\t    SETTINGS_SCHEMA_VERSION, SHELL_NAMESPACE, SettingsNamespaceSchema, SettingsSchemaError,\n    15\t    SettingsSchemaRegistry, SettingsStore, default_settings_path, load_shell_settings, merge_json,\n    16\t};\n    17\tpub use validate::{\n    18\t    FieldKind, FieldSpec, SettingsDiagnostic, SettingsDiagnosticSeverity, log_settings_diagnostics,\n    19\t    new_settings_diagnostics, validate_json_schema, validate_object,\n    20\t};\n    21\t\n    22\t#[derive(Debug, Clone, Serialize, Deserialize)]\n    23\tpub struct ShellConfig {\n    24\t    #[serde(default)]\n    25\t    pub shell: ShellSection,\n    26\t}\n    27\t\n    28\t/// Global shell settings sourced from JSON files.\n    29\t#[derive(Debug, Clone, Serialize, Deserialize, Default)]\n    30\tpub struct ShellSettings {\n    31\t    #[serde(default)]\n    32\t    pub theme: ThemeSettings,\n    33\t    #[serde(default)]\n    34\t    pub i18n: I18nSettings,\n    35\t    #[serde(default)]\n    36\t    pub sounds: ShellSounds,\n    37\t    #[serde(default)]\n    38\t    pub keyboard: KeyboardSettings,\n    39\t    #[serde(default)]\n    40\t    pub icons: IconSettings,\n    41\t    #[serde(default)]\n    42\t    pub fonts: FontSettings,\n    43\t    #[serde(default)]\n    44\t    pub tooltip: TooltipSettings,\n    45\t    #[serde(default)]\n    46\t    pub render: RenderSettings,\n    47\t}\n    48\t\n    49\t/// The `\"shell\"` namespace's schema. One entry per [`ShellSettings`] field:\n    50\t/// serde defines what a valid value falls back to, this defines what is valid.\n    51\t/// A field added without a line here is reported as an unknown key.\n    52\tpub const SHELL_SETTINGS_FIELDS: &[FieldSpec] = &[\n    53\t    FieldSpec::new(\n    54\t        \"theme\",\n    55\t        FieldKind::Section(&[\n    56\t            FieldSpec::new(\"active\", FieldKind::Str),\n    57\t            FieldSpec::new(\"mode\", FieldKind::Str),\n    58\t            FieldSpec::new(\"mode_policy\", FieldKind::Opaque),\n    59\t            FieldSpec::new(\"tokens\", FieldKind::Map(&THEME_TOKEN_VALUE)),\n    60\t        ]),\n    61\t    ),\n    62\t    FieldSpec::new(\n    63\t        \"i18n\",\n    64\t        FieldKind::Section(&[\n    65\t            FieldSpec::new(\"locale\", FieldKind::Str),\n    66\t            FieldSpec::new(\"fallback_locale\", FieldKind::Str),\n    67\t        ]),\n    68\t    ),\n    69\t    FieldSpec::new(\n    70\t        \"sounds\",\n    71\t        FieldKind::Section(&[\n    72\t            FieldSpec::new(\"startup\", FieldKind::Str),\n    73\t            FieldSpec::new(\"shutdown\", FieldKind::Str),\n    74\t            FieldSpec::new(\"device_connected\", FieldKind::Str),\n    75\t            FieldSpec::new(\"device_disconnected\", FieldKind::Str),\n    76\t            FieldSpec::new(\"error\", FieldKind::Str),\n    77\t            FieldSpec::new(\"notification\", FieldKind::Str),\n    78\t        ]),\n    79\t    ),\n    80\t    FieldSpec::new(\n    81\t        \"keyboard\",\n    82\t        FieldKind::Section(&[\n    83\t            FieldSpec::new(\"button_activation_keys\", FieldKind::StrArray),\n    84\t            FieldSpec::new(\"toggle_activation_keys\", FieldKind::StrArray),\n    85\t            FieldSpec::new(\"slider_decrement_keys\", FieldKind::StrArray),\n    86\t            FieldSpec::new(\"slider_increment_keys\", FieldKind::StrArray),\n    87\t            // module id -> action name -> { key }; both levels are the user's\n    88\t            // own vocabulary, so only the leaf shape is checked.\n    89\t            FieldSpec::new(\n    90\t                \"surface_shortcuts\",\n    91\t                FieldKind::Map(&FieldKind::Map(&FieldKind::Section(&[FieldSpec::new(\n    92\t                    \"key\",\n    93\t                    FieldKind::Str,\n    94\t                )]))),\n    95\t            ),\n    96\t        ]),\n    97\t    ),\n    98\t    FieldSpec::new(\n    99\t        \"icons\",\n   100\t        FieldKind::Section(&[FieldSpec::new(\"default_pack\", FieldKind::Str)]),\n   101\t    ),\n   102\t    FieldSpec::new(\n   103\t        \"fonts\",\n   104\t        FieldKind::Section(&[FieldSpec::new(\"ui_family\", FieldKind::Str)]),\n   105\t    ),\n   106\t    FieldSpec::new(\n   107\t        \"render\",\n   108\t        FieldKind::Section(&[FieldSpec::new(\n   109\t            \"blur\",\n   110\t            FieldKind::Section(&[\n   111\t                FieldSpec::new(\"passes\", FieldKind::UIntRange { min: 1, max: 3 }),\n   112\t                FieldSpec::new(\n   113\t                    \"max_radius\",\n   114\t                    FieldKind::FloatRange {\n   115\t                        min: 0.0,\n   116\t                        max: None,\n   117\t                    },\n   118\t                ),\n   119\t            ]),\n   120\t        )]),\n   121\t    ),\n   122\t    FieldSpec::new(\n   123\t        \"tooltip\",\n   124\t        FieldKind::Section(&[\n   125\t            FieldSpec::new(\n   126\t                \"position\",\n   127\t                FieldKind::Enum {\n   128\t                    canonicalize: canonical_tooltip_position,\n   129\t                    values: TOOLTIP_POSITIONS,\n   130\t                },\n   131\t            ),\n   132\t            FieldSpec::new(\"delay_ms\", FieldKind::UInt),\n   133\t            FieldSpec::new(\"gap\", FieldKind::Float),\n   134\t            FieldSpec::new(\"cursor_offset_x\", FieldKind::Float),\n   135\t            FieldSpec::new(\"cursor_offset_y\", FieldKind::Float),\n   136\t        ]),\n   137\t    ),\n   138\t];\n   139\t\n   140\tconst THEME_TOKEN_VALUE: FieldKind = FieldKind::Token;\n   141\t\n   142\t/// Accepted values for [`TooltipSettings::position`]. A `mesh-core-shell` test\n   143\t/// walks this list to keep anchor resolution from drifting apart from it.\n   144\tpub const TOOLTIP_POSITIONS: &[&str] = &[\"auto\", \"bottom\", \"top\", \"left\", \"right\", \"cursor\"];\n   145\t\n   146\tfn canonical_tooltip_position(value: &str) -> Option<&'static str> {\n   147\t    let value = value.trim();\n   148\t    TOOLTIP_POSITIONS\n   149\t        .iter()\n   150\t        .copied()\n   151\t        .find(|candidate| *candidate == value)\n   152\t}\n   153\t\n   154\t/// `default_pack` is prepended to every frontend's effective icon-pack chain\n   155\t/// unless the frontend sets `icons.ignore_shell_default`.\n   156\t#[derive(Debug, Clone, Serialize, Deserialize, Default, PartialEq, Eq)]\n   157\tpub struct IconSettings {\n   158\t    #[serde(default)]\n   159\t    pub default_pack: Option<String>,\n   160\t}\n   161\t\n   162\t/// The system font family used for shell typography. Individual components\n   163\t/// can still select another family or a semantic font-pack role explicitly.\n   164\t#[derive(Debug, Clone, Serialize, Deserialize, Default, PartialEq, Eq)]\n   165\tpub struct FontSettings {\n   166\t    #[serde(default)]\n   167\t    pub ui_family: Option<String>,\n   168\t}\n   169\t\n   170\t/// User overrides layered on the frontend manifest, read from the module's own\n   171\t/// namespace in the settings store rather than from a shell-wide map.\n   172\t#[derive(Debug, Clone, Serialize, Deserialize, Default, PartialEq, Eq)]\n   173\tpub struct ModuleSettingsOverrides {\n   174\t    #[serde(default)]\n   175\t    pub icons: Option<ModuleIconOverrides>,\n   176\t}\n   177\t\n   178\timpl ModuleSettingsOverrides {\n   179\t    /// Unknown keys are ignored: each consumer reads only what it owns.\n   180\t    pub fn from_namespace(namespace: &JsonValue) -> Self {\n   181\t        let icons = namespace\n   182\t            .get(\"icons\")\n   183\t            .and_then(|icons| serde_json::from_value(icons.clone()).ok());\n   184\t        Self { icons }\n   185\t    }\n   186\t}\n   187\t\n   188\t#[derive(Debug, Clone, Serialize, Deserialize, Default, PartialEq, Eq)]\n   189\tpub struct ModuleIconOverrides {\n   190\t    /// Replaces the frontend's declared `dependencies.icon_packs`.\n   191\t    #[serde(default)]\n   192\t    pub use_packs: Option<Vec<String>>,\n   193\t    /// Logical name → `<pack-id>/<asset-name>`, tried before every other\n   194\t    /// resolution path for matching names.\n   195\t    #[serde(default)]\n   196\t    pub overrides: HashMap<String, String>,\n   197\t    /// Also drop the shell-default pack from this module's chain.\n   198\t    #[serde(default)]\n   199\t    pub ignore_shell_default: bool,\n   200\t}\n   201\t\n   202\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]\n   203\tpub struct KeyboardSettings {\n   204\t    #[serde(default = \"default_button_activation_keys\")]\n   205\t    pub button_activation_keys: Vec<String>,\n   206\t    #[serde(default = \"default_toggle_activation_keys\")]\n   207\t    pub toggle_activation_keys: Vec<String>,\n   208\t    #[serde(default = \"default_slider_decrement_keys\")]\n   209\t    pub slider_decrement_keys: Vec<String>,\n   210\t    #[serde(default = \"default_slider_increment_keys\")]\n   211\t    pub slider_increment_keys: Vec<String>,\n   212\t    #[serde(default)]\n   213\t    pub surface_shortcuts: HashMap<String, HashMap<String, SurfaceShortcutOverride>>,\n   214\t}\n   215\t\n   216\timpl Default for KeyboardSettings {\n   217\t    fn default() -> Self {\n   218\t        Self {\n   219\t            button_activation_keys: default_button_activation_keys(),\n   220\t            toggle_activation_keys: default_toggle_activation_keys(),\n   221\t            slider_decrement_keys: default_slider_decrement_keys(),\n   222\t            slider_increment_keys: default_slider_increment_keys(),\n   223\t            surface_shortcuts: HashMap::new(),\n   224\t        }\n   225\t    }\n   226\t}\n   227\t\n   228\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq, Default)]\n   229\tpub struct SurfaceShortcutOverride {\n   230\t    #[serde(default)]\n   231\t    pub key: Option<String>,\n   232\t}\n   233\t\n   234\t/// Sound files for shell events, absolute or relative to the data directory,\n   235\t/// played through `mesh.audio.play_sound`. `None` silences the event.\n   236\t#[derive(Debug, Clone, Serialize, Deserialize, Default)]\n   237\tpub struct ShellSounds {\n   238\t    #[serde(default)]\n   239\t    pub startup: Option<String>,\n   240\t    #[serde(default)]\n   241\t    pub shutdown: Option<String>,\n   242\t    #[serde(default)]\n   243\t    pub device_connected: Option<String>,\n   244\t    #[serde(default)]\n   245\t    pub device_disconnected: Option<String>,\n   246\t    #[serde(default)]\n   247\t    pub error: Option<String>,\n   248\t    #[serde(default)]\n   249\t    pub notification: Option<String>,\n   250\t}\n   251\t\n   252\t#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n   253\tpub struct ThemeSettings {\n   254\t    #[serde(default = \"default_theme_id\")]\n   255\t    pub active: String,\n   256\t    #[serde(default)]\n   257\t    pub mode: Option<String>,\n   258\t    #[serde(default)]\n   259\t    pub mode_policy: ThemeModePolicy,\n   260\t    #[serde(default)]\n   261\t    pub tokens: HashMap<String, JsonValue>,\n   262\t}\n   263\t\n   264\timpl Default for ThemeSettings {\n   265\t    fn default() -> Self {\n   266\t        Self {\n   267\t            active: default_theme_id(),\n   268\t            mode: None,\n   269\t            mode_policy: ThemeModePolicy::Manual,\n   270\t            tokens: HashMap::new(),\n   271\t        }\n   272\t    }\n   273\t}\n   274\t\n   275\t#[derive(Debug, Clone, Serialize, Deserialize)]\n   276\tpub struct I18nSettings {\n   277\t    #[serde(default = \"default_locale\")]\n   278\t    pub locale: String,\n   279\t    #[serde(default = \"default_fallback_locale\")]\n   280\t    pub fallback_locale: String,\n   280\t    pub fallback_locale: String,\n   281\t}\n   282\t\n   283\timpl Default for I18nSettings {\n   284\t    fn default() -> Self {\n   285\t        Self {\n   286\t            locale: default_locale(),\n   287\t            fallback_locale: default_fallback_locale(),\n   288\t        }\n   289\t    }\n   290\t}\n   291\t\n   292\t#[derive(Debug, Clone, Serialize, Deserialize, Default, PartialEq)]\n   293\tpub struct RenderSettings {\n   294\t    #[serde(default)]\n   295\t    pub blur: BlurSettings,\n   296\t}\n   297\t\n   298\t/// Blur cost is the one part of painting worth a user-facing dial: it scales\n   299\t/// with covered *area* rather than element count, so a weak machine can trade\n   300\t/// fidelity for frame time without giving up the frosted look.\n   301\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n   302\tpub struct BlurSettings {\n   303\t    /// Passes per filtered layer (1–3). Each runs at a reduced sigma that keeps\n   304\t    /// total blur constant, so more passes buy a smoother falloff, not a\n   305\t    /// stronger blur, and cost roughly linearly.\n   306\t    #[serde(default = \"default_blur_passes\")]\n   307\t    pub passes: u8,\n   308\t\n   309\t    /// Larger radii are dropped with a diagnostic rather than rasterized,\n   310\t    /// bounding the worst frame a stylesheet can ask for.\n   311\t    #[serde(default = \"default_blur_max_radius\")]\n   312\t    pub max_radius: f32,\n   313\t}\n   314\t\n   315\timpl Default for BlurSettings {\n   316\t    fn default() -> Self {\n   317\t        Self {\n   318\t            passes: default_blur_passes(),\n   319\t            max_radius: default_blur_max_radius(),\n   320\t        }\n   321\t    }\n   322\t}\n   323\t\n   324\tfn default_blur_passes() -> u8 {\n   325\t    1\n   326\t}\n   327\t\n   328\tfn default_blur_max_radius() -> f32 {\n   329\t    96.0\n   330\t}\n   331\t\n   332\t/// Shell-wide tooltip defaults. The enter animation is not configured here —\n   333\t/// it is authored in theme CSS (`tooltip { animation: ... }` plus `@keyframes`).\n   334\t#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]\n   335\tpub struct TooltipSettings {\n   336\t    /// One of [`TOOLTIP_POSITIONS`], used when the element sets no\n   337\t    /// `tooltip-anchor`. Placement resolves in three steps: this default, the\n   338\t    /// element's CSS preference, then a container-aware flip to the opposite\n   339\t    /// side if the chosen one would overflow the nearest clipping container.\n   340\t    #[serde(default = \"default_tooltip_position\")]\n   341\t    pub position: String,\n   342\t\n   343\t    /// Delay after hover starts, in milliseconds.\n   344\t    #[serde(default = \"default_tooltip_delay_ms\")]\n   345\t    pub delay_ms: u64,\n   346\t\n   347\t    /// Gap in pixels between the tooltip and the hovered element.\n   348\t    #[serde(default = \"default_tooltip_gap\")]\n   349\t    pub gap: f32,\n   350\t\n   351\t    #[serde(default = \"default_tooltip_cursor_offset_x\")]\n   352\t    pub cursor_offset_x: f32,\n   353\t\n   354\t    #[serde(default = \"default_tooltip_cursor_offset_y\")]\n   355\t    pub cursor_offset_y: f32,\n   356\t}\n   357\t\n   358\timpl Default for TooltipSettings {\n   359\t    fn default() -> Self {\n   360\t        Self {\n   361\t            position: default_tooltip_position(),\n   362\t            delay_ms: default_tooltip_delay_ms(),\n   363\t            gap: default_tooltip_gap(),\n   364\t            cursor_offset_x: default_tooltip_cursor_offset_x(),\n   365\t            cursor_offset_y: default_tooltip_cursor_offset_y(),\n   366\t        }\n   367\t    }\n   368\t}\n   369\t\n   370\tfn default_tooltip_position() -> String {\n   371\t    \"bottom\".into()\n   372\t}\n   373\tfn default_tooltip_delay_ms() -> u64 {\n   374\t    300\n   375\t}\n   376\tfn default_tooltip_gap() -> f32 {\n   377\t    6.0\n   378\t}\n   379\tfn default_tooltip_cursor_offset_x() -> f32 {\n   380\t    14.0\n   381\t}\n   382\tfn default_tooltip_cursor_offset_y() -> f32 {\n   383\t    18.0\n   384\t}\n   385\t\n   386\t#[derive(Debug, Clone, Serialize, Deserialize)]\n   387\tpub struct ShellSection {\n   388\t    #[serde(default = \"default_surface\")]\n   389\t    pub default_surface: String,\n   390\t    #[serde(default)]\n   391\t    pub discovery_paths: Vec<String>,\n   392\t}\n   393\t\n   394\tfn default_surface() -> String {\n   395\t    \"@mesh/launcher\".to_string()\n   396\t}\n   397\t\n   398\tfn default_theme_id() -> String {\n   399\t    \"tokyo-night\".to_string()\n   400\t}\n   401\t\n   402\tfn default_locale() -> String {\n   403\t    \"en\".to_string()\n   404\t}\n   405\t\n   406\tfn default_fallback_locale() -> String {\n   407\t    \"en\".to_string()\n   408\t}\n   409\t\n   410\tfn default_button_activation_keys() -> Vec<String> {\n   411\t    vec![\"Enter\".into(), \"Space\".into()]\n   412\t}\n   413\t\n   414\tfn default_toggle_activation_keys() -> Vec<String> {\n   415\t    vec![\"Space\".into(), \"Enter\".into()]\n   416\t}\n   417\t\n   418\tfn default_slider_decrement_keys() -> Vec<String> {\n   419\t    vec![\"ArrowLeft\".into(), \"ArrowDown\".into()]\n   420\t}\n   421\t\n   422\tfn default_slider_increment_keys() -> Vec<String> {\n   423\t    vec![\"ArrowRight\".into(), \"ArrowUp\".into()]\n   424\t}\n   425\t\n   426\timpl Default for ShellSection {\n   427\t    fn default() -> Self {\n   428\t        Self {\n   429\t            default_surface: default_surface(),\n   430\t            discovery_paths: Vec::new(),\n   431\t        }\n   432\t    }\n   433\t}\n   434\t\n   435\tpub fn resolve_discovery_paths(workspace_root: &Path, configured_paths: &[String]) -> Vec<PathBuf> {\n   436\t    let mut resolved = if configured_paths.is_empty() {\n   437\t        default_discovery_paths(workspace_root)\n   438\t    } else {\n   439\t        configured_paths\n   440\t            .iter()\n   441\t            .filter_map(|path| {\n   442\t                let trimmed = path.trim();\n   443\t                if trimmed.is_empty() {\n   444\t                    return None;\n   445\t                }\n   446\t                let candidate = PathBuf::from(trimmed);\n   447\t                Some(if candidate.is_absolute() {\n   448\t                    candidate\n   449\t                } else {\n   450\t                    workspace_root.join(candidate)\n   451\t                })\n   452\t            })\n   453\t            .collect::<Vec<_>>()\n   454\t    };\n   455\t\n   456\t    resolved.dedup();\n   457\t    resolved\n   458\t}\n   459\t\n   460\tfn default_discovery_paths(workspace_root: &Path) -> Vec<PathBuf> {\n   461\t    let mut paths = vec![workspace_root.join(\"modules\")];\n   462\t\n   463\t    let mesh_home_modules = mesh_home_path().join(\"modules\");\n   464\t    if mesh_home_modules != workspace_root.join(\"modules\") {\n   465\t        paths.push(mesh_home_modules);\n   466\t    }\n   467\t\n   468\t    let system_modules = PathBuf::from(\"/usr/share/mesh/modules\");\n   469\t    if system_modules != workspace_root.join(\"modules\") {\n   470\t        paths.push(system_modules);\n   471\t    }\n   472\t\n   473\t    paths\n   474\t}\n   475\t\n   476\t#[derive(Debug, thiserror::Error)]\n   477\tpub enum ConfigError {\n   478\t    #[error(\"failed to read config file: {0}\")]\n   479\t    Io(#[from] std::io::Error),\n   480\t\n   481\t    #[error(\"failed to parse config: {0}\")]\n   482\t    Parse(#[from] toml::de::Error),\n   483\t\n   484\t    #[error(\"failed to parse json config: {0}\")]\n   485\t    Json(#[from] serde_json::Error),\n   486\t\n   487\t    #[error(\"validation error: {0}\")]\n   488\t    Validation(String),\n   489\t}\n   490\t\n   491\tpub fn default_config_path() -> PathBuf {\n   492\t    dirs_path(\"config\").join(\"mesh/config.toml\")\n   493\t}\n   494\t\n   495\tpub fn load_config(path: &Path) -> Result<ShellConfig, ConfigError> {\n   496\t    if !path.exists() {\n   497\t        return Ok(ShellConfig {\n   498\t            shell: ShellSection::default(),\n   499\t        });\n   500\t    }\n   501\t    let content = std::fs::read_to_string(path)?;\n   502\t    let config: ShellConfig = toml::from_str(&content)?;\n   503\t    Ok(config)\n   504\t}\n   505\t\n   506\tfn dirs_path(kind: &str) -> PathBuf {\n   507\t    match kind {\n   508\t        \"config\" => non_empty_env_path(std::env::var_os(\"XDG_CONFIG_HOME\")).unwrap_or_else(|| {\n   509\t            let home = std::env::var(\"HOME\").unwrap_or_else(|_| \"/tmp\".to_string());\n   510\t            PathBuf::from(home).join(\".config\")\n   511\t        }),\n   512\t        \"data\" => non_empty_env_path(std::env::var_os(\"XDG_DATA_HOME\")).unwrap_or_else(|| {\n   513\t            let home = std::env::var(\"HOME\").unwrap_or_else(|_| \"/tmp\".to_string());\n   514\t            PathBuf::from(home).join(\".local/share\")\n   515\t        }),\n   516\t        _ => PathBuf::from(\"/tmp\"),\n   517\t    }\n   518\t}\n   519\t\n   520\tfn non_empty_env_path(value: Option<std::ffi::OsString>) -> Option<PathBuf> {\n   521\t    value.filter(|value| !value.is_empty()).map(PathBuf::from)\n   522\t}\n   523\t\n   524\tfn mesh_home_path() -> PathBuf {\n   525\t    if let Ok(path) = std::env::var(\"MESH_HOME\") {\n   526\t        if !path.trim().is_empty() {\n   527\t            return PathBuf::from(path);\n   528\t        }\n   529\t    }\n   530\t\n   531\t    let home = std::env::var(\"HOME\").unwrap_or_else(|_| \"/tmp\".to_string());\n   532\t    PathBuf::from(home).join(\".mesh\")\n   533\t}\n   534\t\n   535\t#[cfg(test)]\n   536\tmod tests {\n   537\t    use super::*;\n   538\t    use serde_json::json;\n   539\t\n   540\t    #[test]\n   541\t    fn empty_xdg_directory_values_are_absent() {\n   542\t        assert_eq!(non_empty_env_path(Some(std::ffi::OsString::new())), None);\n   543\t        assert_eq!(\n   544\t            non_empty_env_path(Some(std::ffi::OsString::from(\"/tmp/mesh-config\"))),\n   545\t            Some(PathBuf::from(\"/tmp/mesh-config\"))\n   546\t        );\n   547\t    }\n   548\t\n   549\t    #[test]\n   550\t    fn keyboard_settings_default_shortcuts_remain_available_without_user_overrides() {\n   551\t        let settings = ShellSettings::default();\n   552\t        assert_eq!(\n   553\t            settings.keyboard.toggle_activation_keys,\n   554\t            vec![\"Space\".to_string(), \"Enter\".to_string()]\n   555\t        );\n   556\t        assert!(\n   557\t            settings.keyboard.surface_shortcuts.is_empty(),\n   558\t            \"module-owned defaults should remain the fallback when shell overrides are absent\"\n   559\t        );\n   560\t    }\n   561\t\n   562\t    #[test]\n   563\t    fn module_icon_overrides_read_from_the_modules_own_namespace() {\n   564\t        let namespace = json!({\n   565\t            \"surface\": { \"anchor\": \"bottom\" },\n   566\t            \"icons\": {\n   567\t                \"use_packs\": [\"@mesh/user-icons\"],\n   568\t                \"overrides\": { \"settings\": \"lucide/settings\" },\n   569\t                \"ignore_shell_default\": true\n   570\t            }\n   571\t        });\n   572\t\n   573\t        let overrides = ModuleSettingsOverrides::from_namespace(&namespace);\n   574\t        let icons = overrides.icons.expect(\"icon overrides parsed\");\n   575\t\n   576\t        assert_eq!(\n   577\t            icons.use_packs.as_deref(),\n   578\t            Some(&[\"@mesh/user-icons\".to_string()][..])\n   579\t        );\n   580\t        assert_eq!(\n   581\t            icons.overrides.get(\"settings\").map(String::as_str),\n   582\t            Some(\"lucide/settings\")\n   583\t        );\n   584\t        assert!(icons.ignore_shell_default);\n   585\t    }\n   586\t\n   587\t    #[test]\n   588\t    fn a_module_namespace_without_icons_yields_no_overrides() {\n   589\t        let overrides =\n   590\t            ModuleSettingsOverrides::from_namespace(&json!({ \"surface\": { \"anchor\": \"top\" } }));\n   591\t        assert!(overrides.icons.is_none());\n   592\t    }\n   593\t}\n","exit_code":0,"status":"completed"}}
