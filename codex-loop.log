   308\t                        })\n   309\t                        .unzip();\n   310\t\n   311\t                let module_settings = graph\n   312\t                    .settings_schemas()\n   313\t                    .iter()\n   314\t                    .find(|settings| settings.module_id == module.id);\n   315\t                let provides_settings = graph\n   316\t                    .settings_schemas()\n   317\t                    .iter()\n   318\t                    .filter(|settings| settings.module_id == module.id)\n   319\t                    .map(|settings| settings.namespace.clone())\n   320\t                    .collect::<Vec<_>>();\n   321\t                let settings_values = self\n   322\t                    .settings_store\n   323\t                    .namespace(&module.id)\n   324\t                    .pointer(\"/props/global\")\n   325\t                    .cloned()\n  1260\t            \"capabilities\": entry.capabilities,\n  1261\t            \"optional_capabilities\": entry.optional_capabilities,\n  1262\t        },\n  1263\t        \"provides\": {\n  1264\t            \"interfaces\": entry.provides_interfaces.iter().zip(entry.provides_interface_labels.iter())\n  1265\t                .map(|(iface, label)| serde_json::json!({ \"interface\": iface, \"label\": label }))\n  1266\t                .collect::<Vec<_>>(),\n  1267\t            \"themes\": entry.provides_themes.iter().zip(entry.provides_theme_labels.iter())\n  1268\t                .map(|(id, label)| serde_json::json!({ \"id\": id, \"label\": label }))\n  1269\t                .collect::<Vec<_>>(),\n  1270\t            \"settings\": entry.provides_settings,\n  1271\t            \"settings_schema\": entry.settings_schema,\n  1272\t            \"settings_values\": entry.settings_values,\n  1273\t            \"settings_instances\": entry.settings_instances,\n  1274\t            \"settings_instance_values\": entry.settings_instance_values,\n  1275\t            \"settings_page\": entry.settings_page,\n  1276\t            \"i18n\": entry.provides_i18n,\n  1277\t            \"required_icons\": entry.required_icons,\n  1278\t            \"optional_icons\": entry.optional_icons,\n  1279\t        },\n  1280\t        \"surface\": entry.surface_entrypoint.as_ref().map(|entrypoint| serde_json::json!({\n  1281\t            \"entrypoint\": entrypoint,\n  1282\t            \"settings_namespace\": entry.surface_settings_namespace.as_ref(),\n  1283\t            \"accessibility_role\": entry.surface_accessibility_role.as_ref(),\n  1284\t            \"accessibility_label\": entry.surface_accessibility_label.as_ref(),\n  1285\t            \"size_policy\": entry.surface_size_policy.as_ref(),\n  1286\t            \"layout_label\": entry.surface_layout_label.as_ref(),\n  1287\t            \"layout_label_key\": entry.surface_layout_label_key.as_ref(),\n  1288\t            \"layout_label_fallback\": entry.surface_layout_label_fallback.as_ref(),\n  1289\t        })),\n  1290\t        \"diagnostics\": entry.diagnostics,\n  1291\t        \"health\": entry.health,\n  1292\t    })\n  1293\t}\n  1294\t\n  1295\tfn sorted_keys<T>(map: &std::collections::HashMap<String, T>) -> Vec<String> {\n  1296\t    let mut keys = map.keys().cloned().collect::<Vec<_>>();\n  1297\t    keys.sort();\n  1298\t    keys\n  1299\t}\n  1300\t\n  1301\tfn resolve_debug_manifest_text(\n  1302\t    locale: &mesh_core_locale::LocaleEngine,\n  1303\t    module_id: &str,\n  1304\t    text: &mesh_core_module::LocalizedText,\n  1305\t) -> mesh_core_locale::LocalizedTextResolution {\n  1306\t    match text {\n  1307\t        mesh_core_module::LocalizedText::Literal(value) => {\n  1308\t            mesh_core_locale::LocalizedTextResolution::literal(\n  1309\t                module_id,\n  1310\t                value,\n  1311\t                locale.catalog_snapshot().revision(),\n  1312\t            )\n  1313\t        }\n  1314\t        mesh_core_module::LocalizedText::Translation { key, fallback } => {\n  1315\t            let translator = locale.module_translator(module_id);\n  1316\t            translator.resolve(key, Some(fallback))\n  1317\t        }\n  1318\t    }\n","exit_code":0,"status":"completed"}}
