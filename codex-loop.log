> u64 {\n    const FNV_OFFSET: u64 = 0xcbf29ce484222325;\n    const FNV_PRIME: u64 = 0x100000001b3;\n    bytes.iter().fold(FNV_OFFSET, |hash, byte| {\n        (hash ^ u64::from(*byte)).wrapping_mul(FNV_PRIME)\n    })\n}\n\n","exit_code":0,"status":"completed"}}
