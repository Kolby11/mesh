{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/core/runtime/scripting/src/backend/runtime.rs | sed -n '1,460p'\"","aggregated_output":"     1\tuse super::command::{BackendCommandOutcome, command_error_result, command_result_from_lua};\n     2\tuse super::exec::{exec_denied_to_lua, missing_exec_capability, run_exec};\n     3\tuse super::exec_stream::{StreamState, spawn_stream};\n     4\tuse super::logging::log_message;\n     5\tuse super::{BackendScriptError, MIN_POLL_INTERVAL_MS};\n     6\tuse crate::storage::{ScopedStorage, StorageManager, StorageScope, create_lua_storage_table};\n     7\tuse crate::util::{default_runtime_storage_root, is_named_event_channel};\n     8\tuse mlua::{Function, Lua, LuaSerdeExt, Table, Value as LuaValue};\n     9\tuse serde_json::Value as JsonValue;\n    10\tuse std::collections::HashSet;\n    11\tuse std::path::PathBuf;\n    12\tuse std::sync::{Arc, Mutex};\n    13\t\n    14\t/// Executes a backend module's Luau script.\n    15\t///\n    16\t/// Exposes these host APIs to scripts:\n    17\t/// - `start(self)` — required backend entrypoint called once after script load\n    18\t/// - `mesh.service.set_poll_interval(ms)` — set polling interval\n    19\t/// - `mesh.exec(\"program\", {\"arg1\", \"arg2\"})` — run a system command\n    20\t/// - `mesh.config()` — return the full module settings Lua table\n    21\t/// - `mesh.service.emit(table)` — emit service state\n    22\t/// - `mesh.service.emit_json(value?)` — parse JSON text or emit a Lua table directly\n    23\t/// - `mesh.service.emit_unavailable()` — emit unavailable state\n    24\t/// - `mesh.service.payload()` — get the current command payload as a Lua table\n    25\t/// - `mesh.service.has_capability(name)` — check whether the module was granted a capability\n    26\t/// - `mesh.log(level, msg)` / `mesh.log.debug(msg)` / `mesh.log.info(msg)` / `mesh.log.warn(msg)` / `mesh.log.error(msg)`\n    27\tpub struct BackendScriptContext {\n    28\t    module_id: String,\n    29\t    capabilities: HashSet<String>,\n    30\t    pub(super) lua: Option<Lua>,\n    31\t    runtime: Arc<Mutex<BackendRuntime>>,\n    32\t    builtin_globals: HashSet<String>,\n    33\t    storage: Arc<Mutex<ScopedStorage>>,\n    34\t    streams: Arc<StreamState>,\n    35\t}\n    36\t\n    37\t#[derive(Debug, Clone, PartialEq)]\n    38\tpub struct BackendScriptEvent {\n    39\t    pub name: String,\n    40\t    pub payload: JsonValue,\n    41\t}\n    42\t\n    43\t#[derive(Debug, Default)]\n    44\tstruct BackendRuntime {\n    45\t    poll_interval_ms: u64,\n    46\t    pending_emit: Option<JsonValue>,\n    47\t    pending_events: Vec<BackendScriptEvent>,\n    48\t    current_payload: JsonValue,\n    49\t    settings: JsonValue,\n    50\t    storage_diagnostics: Vec<String>,\n    51\t}\n    52\t\n    53\timpl BackendScriptContext {\n    54\t    #[cfg(test)]\n    55\t    pub fn new(module_id: impl Into<String>) -> Self {\n    56\t        Self::new_with_settings_and_capabilities(\n    57\t            module_id,\n    58\t            serde_json::json!({}),\n    59\t            Vec::<String>::new(),\n    60\t        )\n    61\t    }\n    62\t\n    63\t    #[cfg(test)]\n    64\t    pub fn new_with_settings(module_id: impl Into<String>, settings: JsonValue) -> Self {\n    65\t        Self::new_with_settings_and_capabilities(module_id, settings, Vec::<String>::new())\n    66\t    }\n    67\t\n    68\t    #[cfg(test)]\n    69\t    pub fn new_with_capabilities(\n    70\t        module_id: impl Into<String>,\n    71\t        capabilities: impl IntoIterator<Item = String>,\n    72\t    ) -> Self {\n    73\t        Self::new_with_settings_and_capabilities(module_id, serde_json::json!({}), capabilities)\n    74\t    }\n    75\t\n    76\t    pub fn new_with_settings_and_capabilities(\n    77\t        module_id: impl Into<String>,\n    78\t        settings: JsonValue,\n    79\t        capabilities: impl IntoIterator<Item = String>,\n    80\t    ) -> Self {\n    81\t        Self::new_with_settings_capabilities_and_storage_root(\n    82\t            module_id,\n    83\t            settings,\n    84\t            capabilities,\n    85\t            default_runtime_storage_root(),\n    86\t        )\n    87\t    }\n    88\t\n    89\t    #[cfg(test)]\n    90\t    pub fn new_with_storage_root(\n    91\t        module_id: impl Into<String>,\n    92\t        storage_root: impl Into<PathBuf>,\n    93\t    ) -> Self {\n    94\t        Self::new_with_settings_capabilities_and_storage_root(\n    95\t            module_id,\n    96\t            serde_json::json!({}),\n    97\t            Vec::<String>::new(),\n    98\t            storage_root,\n    99\t        )\n   100\t    }\n   101\t\n   102\t    fn new_with_settings_capabilities_and_storage_root(\n   103\t        module_id: impl Into<String>,\n   104\t        settings: JsonValue,\n   105\t        capabilities: impl IntoIterator<Item = String>,\n   106\t        storage_root: impl Into<PathBuf>,\n   107\t    ) -> Self {\n   108\t        let module_id = module_id.into();\n   109\t        let storage = StorageManager::new(storage_root.into()).open(StorageScope::backend(\n   110\t            module_id.clone(),\n   111\t            module_id.clone(),\n   112\t            module_id.clone(),\n   113\t        ));\n   114\t        let storage_diagnostics = storage\n   115\t            .diagnostics()\n   116\t            .iter()\n   117\t            .map(|diagnostic| diagnostic.reason.clone())\n   118\t            .collect();\n   119\t        let runtime = Arc::new(Mutex::new(BackendRuntime {\n   120\t            poll_interval_ms: 1000,\n   121\t            pending_emit: None,\n   122\t            pending_events: Vec::new(),\n   123\t            current_payload: JsonValue::Null,\n   124\t            settings,\n   125\t            storage_diagnostics,\n   126\t        }));\n   127\t\n   128\t        Self {\n   129\t            module_id,\n   130\t            capabilities: capabilities.into_iter().collect(),\n   131\t            lua: None,\n   132\t            runtime,\n   133\t            builtin_globals: HashSet::new(),\n   134\t            storage: Arc::new(Mutex::new(storage)),\n   135\t            streams: StreamState::new(),\n   136\t        }\n   137\t    }\n   138\t\n   139\t    pub(super) fn ensure_lua(&mut self) -> &Lua {\n   140\t        if let Some(ref lua) = self.lua {\n   141\t            return lua;\n   142\t        }\n   143\t        let lua = Lua::new();\n   144\t        self.lua = Some(lua);\n   145\t        let globals = self.lua.as_ref().unwrap().globals();\n   146\t        self.install_host_api(&globals)\n   147\t            .expect(\"backend host API setup should succeed\");\n   148\t        self.builtin_globals = self\n   149\t            .lua\n   150\t            .as_ref()\n   151\t            .unwrap()\n   152\t            .globals()\n   153\t            .pairs::<String, LuaValue>()\n   154\t            .filter_map(|result| result.ok().map(|(key, _)| key))\n   155\t            .collect();\n   156\t        self.lua.as_ref().unwrap()\n   157\t    }\n   158\t\n   159\t    pub fn poll_interval_ms(&self) -> u64 {\n   160\t        self.runtime.lock().unwrap().poll_interval_ms\n   161\t    }\n   162\t\n   163\t    /// Load and execute a backend Luau script.\n   164\t    pub fn load_script(&mut self, source: &str) -> Result<(), BackendScriptError> {\n   165\t        self.ensure_lua()\n   166\t            .load(source)\n   167\t            .set_name(&self.module_id)\n   168\t            .exec()\n   169\t            .map_err(|err| BackendScriptError::Runtime {\n   170\t                module_id: self.module_id.clone(),\n   171\t                message: err.to_string(),\n   172\t            })?;\n   173\t        tracing::info!(\"loaded backend script for {}\", self.module_id);\n   174\t        Ok(())\n   175\t    }\n   176\t\n   177\t    /// Call the backend script's `start(self)` startup entrypoint once after load.\n   178\t    pub fn call_init(&mut self) -> Result<Option<JsonValue>, BackendScriptError> {\n   179\t        self.reset_for_call(JsonValue::Null);\n   180\t        let globals = self.ensure_lua().globals();\n   181\t        let entrypoint = globals.get::<Function>(\"start\").map_err(|_| {\n   182\t            BackendScriptError::MissingEntrypoint {\n   183\t                module_id: self.module_id.clone(),\n   184\t                name: \"start\".to_string(),\n   185\t            }\n   186\t        })?;\n   187\t        let current_self =\n   188\t            self.current_self_table()\n   189\t                .map_err(|err| BackendScriptError::Runtime {\n   190\t                    module_id: self.module_id.clone(),\n   191\t                    message: err.to_string(),\n   192\t                })?;\n   193\t        entrypoint\n   194\t            .call::<()>(current_self)\n   195\t            .map_err(|err| BackendScriptError::Runtime {\n   196\t                module_id: self.module_id.clone(),\n   197\t                message: err.to_string(),\n   198\t            })?;\n   199\t        self.take_service_state_snapshot()\n   200\t    }\n   201\t\n   202\t    /// Call the backend script's optional `stop(self)` lifecycle hook.\n   203\t    pub fn call_stop(&mut self) -> Result<(), BackendScriptError> {\n   204\t        self.kill_streams();\n   205\t        self.reset_for_call(JsonValue::Null);\n   206\t        let globals = self.ensure_lua().globals();\n   207\t        let stop = match globals.get::<Function>(\"stop\") {\n   208\t            Ok(stop) => stop,\n   209\t            Err(_) => {\n   210\t                self.flush_storage();\n   211\t                return Ok(());\n   212\t            }\n   213\t        };\n   214\t        let current_self =\n   215\t            self.current_self_table()\n   216\t                .map_err(|err| BackendScriptError::Runtime {\n   217\t                    module_id: self.module_id.clone(),\n   218\t                    message: err.to_string(),\n   219\t                })?;\n   220\t        stop.call::<()>(current_self)\n   221\t            .map_err(|err| BackendScriptError::Runtime {\n   222\t                module_id: self.module_id.clone(),\n   223\t                message: err.to_string(),\n   224\t            })?;\n   225\t        self.flush_storage();\n   226\t        Ok(())\n   227\t    }\n   228\t\n   229\t    /// Shared subprocess-stream state. The backend service loop awaits on\n   230\t    /// `stream_state().wait_for_event()` to react to lines from\n   231\t    /// `mesh.exec_stream` subprocesses.\n   232\t    pub fn stream_state(&self) -> Arc<StreamState> {\n   233\t        Arc::clone(&self.streams)\n   234\t    }\n   235\t\n   236\t    /// Dispatch one wakeup's worth of subprocess lines to the script.\n   237\t    ///\n   238\t    /// `on_stream_batch(self, program, lines)` receives the full ordered batch;\n   239\t    /// scripts that only need a \"something changed\" signal can ignore `lines`.\n   240\t    /// Otherwise `on_stream_line(self, program, line)` runs once per line.\n   241\t    /// Returns the state snapshot taken after the whole batch.\n   242\t    pub fn run_stream_batch(\n   243\t        &mut self,\n   244\t        program: &str,\n   245\t        lines: &[String],\n   246\t    ) -> Result<Option<JsonValue>, BackendScriptError> {\n   247\t        if lines.is_empty() {\n   248\t            return Ok(None);\n   249\t        }\n   250\t        self.reset_for_call(JsonValue::Null);\n   251\t        let globals = self.ensure_lua().globals();\n   252\t        if let Ok(batch_handler) = globals.get::<Function>(\"on_stream_batch\") {\n   253\t            let current_self =\n   254\t                self.current_self_table()\n   255\t                    .map_err(|err| BackendScriptError::Runtime {\n   256\t                        module_id: self.module_id.clone(),\n   257\t                        message: err.to_string(),\n   258\t                    })?;\n   259\t            let lines_table = self\n   260\t                .ensure_lua()\n   261\t                .create_sequence_from(lines.iter().cloned())\n   262\t                .map_err(|err| BackendScriptError::Runtime {\n   263\t                    module_id: self.module_id.clone(),\n   264\t                    message: err.to_string(),\n   265\t                })?;\n   266\t            batch_handler\n   267\t                .call::<()>((current_self, program.to_string(), lines_table))\n   268\t                .map_err(|err| BackendScriptError::Runtime {\n   269\t                    module_id: self.module_id.clone(),\n   270\t                    message: err.to_string(),\n   271\t                })?;\n   272\t            return self.take_service_state_snapshot();\n   273\t        }\n   274\t        let line_handler = match globals.get::<Function>(\"on_stream_line\") {\n   275\t            Ok(handler) => handler,\n   276\t            Err(_) => return Ok(None),\n   277\t        };\n   278\t        for line in lines {\n   279\t            let current_self =\n   280\t                self.current_self_table()\n   281\t                    .map_err(|err| BackendScriptError::Runtime {\n   282\t                        module_id: self.module_id.clone(),\n   283\t                        message: err.to_string(),\n   284\t                    })?;\n   285\t            line_handler\n   286\t                .call::<()>((current_self, program.to_string(), line.clone()))\n   287\t                .map_err(|err| BackendScriptError::Runtime {\n   288\t                    module_id: self.module_id.clone(),\n   289\t                    message: err.to_string(),\n   290\t                })?;\n   291\t        }\n   292\t        self.take_service_state_snapshot()\n   293\t    }\n   294\t\n   295\t    /// Kill every active `mesh.exec_stream` subprocess. Idempotent; safe to\n   296\t    /// call from `Drop` and from `stop(self)` lifecycle.\n   297\t    pub fn kill_streams(&self) {\n   298\t        self.streams.kill_all();\n   299\t    }\n   300\t\n   301\t    /// Call `on_poll()` if it exists. Returns any exported service state.\n   302\t    pub fn run_poll(&mut self) -> Result<Option<JsonValue>, BackendScriptError> {\n   303\t        self.reset_for_call(JsonValue::Null);\n   304\t        let globals = self.ensure_lua().globals();\n   305\t        let handler = match globals.get::<Function>(\"on_poll\") {\n   306\t            Ok(handler) => handler,\n   307\t            Err(_) => return Ok(None),\n   308\t        };\n   309\t        let current_self =\n   310\t            self.current_self_table()\n   311\t                .map_err(|err| BackendScriptError::Runtime {\n   312\t                    module_id: self.module_id.clone(),\n   313\t                    message: err.to_string(),\n   314\t                })?;\n   315\t        handler\n   316\t            .call::<()>(current_self)\n   317\t            .map_err(|err| BackendScriptError::Runtime {\n   318\t                module_id: self.module_id.clone(),\n   319\t                message: err.to_string(),\n   320\t            })?;\n   321\t        self.take_service_state_snapshot()\n   322\t    }\n   323\t\n   324\t    /// Call `on_command_<name>()` for the given command. Returns any exported service state.\n   325\t    pub fn run_command(\n   326\t        &mut self,\n   327\t        command: &str,\n   328\t        payload: &JsonValue,\n   329\t    ) -> Result<Option<JsonValue>, BackendScriptError> {\n   330\t        self.reset_for_call(payload.clone());\n   331\t        let normalized = command.replace('-', \"_\");\n   332\t\n   333\t        let globals = self.ensure_lua().globals();\n   334\t        let handler_name = format!(\"on_command_{normalized}\");\n   335\t        let handler = match globals\n   336\t            .get::<Function>(handler_name.as_str())\n   337\t            .or_else(|_| globals.get::<Function>(normalized.as_str()))\n   338\t        {\n   339\t            Ok(handler) => handler,\n   340\t            Err(_) => return Ok(None),\n   341\t        };\n   342\t        let current_self =\n   343\t            self.current_self_table()\n   344\t                .map_err(|err| BackendScriptError::Runtime {\n   345\t                    module_id: self.module_id.clone(),\n   346\t                    message: err.to_string(),\n   347\t                })?;\n   348\t        handler\n   349\t            .call::<()>(current_self)\n   350\t            .map_err(|err| BackendScriptError::Runtime {\n   351\t                module_id: self.module_id.clone(),\n   352\t                message: err.to_string(),\n   353\t            })?;\n   354\t        self.take_service_state_snapshot()\n   355\t    }\n   356\t\n   357\t    pub fn run_command_with_result(\n   358\t        &mut self,\n   359\t        command: &str,\n   360\t        payload: &JsonValue,\n   361\t    ) -> Result<BackendCommandOutcome, BackendScriptError> {\n   362\t        self.reset_for_call(payload.clone());\n   363\t        let normalized = command.replace('-', \"_\");\n   364\t\n   365\t        let globals = self.ensure_lua().globals();\n   366\t        let handler_name = format!(\"on_command_{normalized}\");\n   367\t        let handler = match globals\n   368\t            .get::<Function>(handler_name.as_str())\n   369\t            .or_else(|_| globals.get::<Function>(normalized.as_str()))\n   370\t        {\n   371\t            Ok(handler) => handler,\n   372\t            Err(_) => {\n   373\t                return Ok(BackendCommandOutcome {\n   374\t                    state: None,\n   375\t                    result: command_error_result(format!(\"unsupported command: {command}\")),\n   376\t                    error: None,\n   377\t                });\n   378\t            }\n   379\t        };\n   380\t\n   381\t        let current_self =\n   382\t            self.current_self_table()\n   383\t                .map_err(|err| BackendScriptError::Runtime {\n   384\t                    module_id: self.module_id.clone(),\n   385\t                    message: err.to_string(),\n   386\t                })?;\n   387\t        let returned = match handler.call::<LuaValue>(current_self) {\n   388\t            Ok(returned) => returned,\n   389\t            Err(err) => {\n   390\t                let message = err.to_string();\n   391\t                return Ok(BackendCommandOutcome {\n   392\t                    state: None,\n   393\t                    result: command_error_result(message.clone()),\n   394\t                    error: Some(message),\n   395\t                });\n   396\t            }\n   397\t        };\n   398\t\n   399\t        let state = self.take_service_state_snapshot()?;\n   400\t        let module_id = self.module_id.clone();\n   401\t        let lua = self.ensure_lua();\n   402\t        let result = command_result_from_lua(lua, &module_id, returned)?;\n   403\t        Ok(BackendCommandOutcome {\n   404\t            state,\n   405\t            result,\n   406\t            error: None,\n   407\t        })\n   408\t    }\n   409\t\n   410\t    pub fn take_service_state_snapshot(&mut self) -> Result<Option<JsonValue>, BackendScriptError> {\n   411\t        if let Some(payload) = self.take_pending_emit() {\n   412\t            return Ok(Some(payload));\n   413\t        }\n   414\t\n   415\t        let globals = self.ensure_lua().globals();\n   416\t        let state =\n   417\t            globals\n   418\t                .get::<LuaValue>(\"state\")\n   419\t                .map_err(|err| BackendScriptError::SnapshotFailed {\n   420\t                    module_id: self.module_id.clone(),\n   421\t                    message: format!(\"failed to read state global: {err}\"),\n   422\t                })?;\n   423\t\n   424\t        if matches!(state, LuaValue::Nil) {\n   425\t            return Ok(None);\n   426\t        }\n   427\t\n   428\t        self.ensure_lua()\n   429\t            .from_value::<JsonValue>(state)\n   430\t            .map(Some)\n   431\t            .map_err(|err| BackendScriptError::SnapshotFailed {\n   432\t                module_id: self.module_id.clone(),\n   433\t                message: format!(\"failed to convert state to JSON: {err}\"),\n   434\t            })\n   435\t    }\n   436\t\n   437\t    pub fn drain_events(&self) -> Vec<BackendScriptEvent> {\n   438\t        std::mem::take(&mut self.runtime.lock().unwrap().pending_events)\n   439\t    }\n   440\t\n   441\t    pub fn drain_storage_diagnostics(&self) -> Vec<String> {\n   442\t        std::mem::take(&mut self.runtime.lock().unwrap().storage_diagnostics)\n   443\t    }\n   444\t\n   445\t    pub fn flush_storage(&self) {\n   446\t        let result = self.storage.lock().unwrap().flush_if_dirty();\n   447\t        if let Err(error) = result {\n   448\t            self.runtime\n   449\t                .lock()\n   450\t                .unwrap()\n   451\t                .storage_diagnostics\n   452\t                .push(format!(\"storage persistence failed: {error}\"));\n   453\t        }\n   454\t    }\n   455\t\n   456\t    pub fn public_function_names(&mut self) -> Vec<String> {\n   457\t        let globals = self.ensure_lua().globals();\n   458\t        let mut names = globals\n   459\t            .pairs::<String, LuaValue>()\n   460\t            .filter_map(|pair| {\n","exit_code":0,"status":"completed"}}
