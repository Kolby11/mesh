{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/core/foundation/config/src/settings.rs | sed -n '620,720p'; nl -ba crates/core/foundation/config/src/settings.rs | sed -n '960,1095p'; nl -ba crates/core/foundation/config/src/settings.rs | sed -n '1120,1180p'\"","aggregated_output":"   620\t        if !path.trim().is_empty() {\n   621\t            return PathBuf::from(path);\n   622\t        }\n   623\t    }\n   624\t\n   625\t    let repo_path = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n   626\t        .join(\"../../../..\")\n   627\t        .join(\"config/settings.json\");\n   628\t    if repo_path.exists() {\n   629\t        return repo_path;\n   630\t    }\n   631\t\n   632\t    mesh_home_path().join(\"settings.json\")\n   633\t}\n   634\t\n   635\t/// Load just the core shell preferences.\n   636\tpub fn load_shell_settings() -> Result<ShellSettings, ConfigError> {\n   637\t    Ok(SettingsStore::load()?.shell)\n   638\t}\n   639\t\n   640\t/// Objects merge key by key so setting one field does not erase its siblings.\n   641\t/// Every other kind replaces wholesale: a stored array (a pack chain, a key\n   642\t/// list) is a complete replacement by intent.\n   643\tpub fn merge_json(base: &mut JsonValue, overlay: &JsonValue) {\n   644\t    match (base, overlay) {\n   645\t        (JsonValue::Object(base), JsonValue::Object(overlay)) => {\n   646\t            for (key, value) in overlay {\n   647\t                match base.get_mut(key) {\n   648\t                    Some(existing) => merge_json(existing, value),\n   649\t                    None => {\n   650\t                        base.insert(key.clone(), value.clone());\n   651\t                    }\n   652\t                }\n   653\t            }\n   654\t        }\n   655\t        (base, overlay) => *base = overlay.clone(),\n   656\t    }\n   657\t}\n   658\t\n   659\t/// Resolve the `\"shell\"` namespace, dropping and reporting what it cannot use.\n   660\t///\n   661\t/// Infallible on purpose: a hand-edited file must never stop the shell from\n   662\t/// starting. Values are checked against [`SHELL_SETTINGS_FIELDS`] before the\n   663\t/// merge, so serde only ever sees well-typed input.\n   664\tfn resolve_shell_settings(\n   665\t    root: &JsonMap<String, JsonValue>,\n   666\t) -> (ShellSettings, Vec<SettingsDiagnostic>) {\n   667\t    let mut diagnostics = validate_settings_root(root);\n   668\t\n   669\t    let overrides = root.get(SHELL_NAMESPACE).map(|overrides| {\n   670\t        validate_object(\n   671\t            SHELL_NAMESPACE,\n   672\t            \"\",\n   673\t            SHELL_SETTINGS_FIELDS,\n   674\t            overrides,\n   675\t            &mut diagnostics,\n   676\t        )\n   677\t    });\n   678\t\n   679\t    let mut resolved = match serde_json::to_value(ShellSettings::default()) {\n   680\t        Ok(value) => value,\n   681\t        Err(_) => return (ShellSettings::default(), diagnostics),\n   682\t    };\n   683\t    if let Some(overrides) = &overrides {\n   684\t        merge_json(&mut resolved, overrides);\n   685\t    }\n   686\t\n   687\t    match serde_json::from_value(resolved) {\n   688\t        Ok(settings) => (settings, diagnostics),\n   689\t        Err(err) => {\n   690\t            // Reaching here means the schema table and `ShellSettings` disagree.\n   691\t            diagnostics.push(SettingsDiagnostic::error(\n   692\t                SHELL_NAMESPACE,\n   693\t                \"\",\n   694\t                format!(\"could not be applied: {err}\"),\n   695\t                \"report this as a MESH bug; the whole namespace fell back to its defaults\",\n   696\t            ));\n   697\t            (ShellSettings::default(), diagnostics)\n   698\t        }\n   699\t    }\n   700\t}\n   701\t\n   702\t/// Check the schema stamp and that other keys look like ownable namespaces.\n   703\tfn validate_settings_root(root: &JsonMap<String, JsonValue>) -> Vec<SettingsDiagnostic> {\n   704\t    const ROOT_KEYS: &[&str] = &[SHELL_NAMESPACE, SCHEMA_VERSION_KEY];\n   705\t    let mut diagnostics = Vec::new();\n   706\t\n   707\t    for (key, value) in root {\n   708\t        match key.as_str() {\n   709\t            SCHEMA_VERSION_KEY => match value.as_u64() {\n   710\t                Some(version) if version > SETTINGS_SCHEMA_VERSION => {\n   711\t                    diagnostics.push(SettingsDiagnostic::warning(\n   712\t                        key.clone(),\n   713\t                        \"\",\n   714\t                        format!(\n   715\t                            \"schema version {version} is newer than this build understands \\\n   716\t                             ({SETTINGS_SCHEMA_VERSION})\"\n   717\t                        ),\n   718\t                        \"some values may be ignored; update MESH or check the file by hand\",\n   719\t                    ));\n   720\t                }\n   960\t            .map(String::as_str)\n   961\t            .collect();\n   962\t\n   963\t        assert_eq!(\n   964\t            keys,\n   965\t            vec![\n   966\t                \"@mesh/navigation-bar\",\n   967\t                \"@mesh/quick-settings\",\n   968\t                \"schemaVersion\",\n   969\t                \"shell\"\n   970\t            ]\n   971\t        );\n   972\t        assert_eq!(document[\"schemaVersion\"], json!(SETTINGS_SCHEMA_VERSION));\n   973\t    }\n   974\t\n   975\t    #[test]\n   976\t    fn a_missing_file_loads_as_an_empty_store() {\n   977\t        let path = std::env::temp_dir().join(format!(\n   978\t            \"mesh-settings-absent-{}-{}.json\",\n   979\t            std::process::id(),\n   980\t            line!()\n   981\t        ));\n   982\t        let store = SettingsStore::load_from(&path).expect(\"absent file is not an error\");\n   983\t\n   984\t        assert_eq!(store.shell().theme.active, \"tokyo-night\");\n   985\t        assert_eq!(store.namespace_names().count(), 0);\n   986\t    }\n   987\t\n   988\t    #[test]\n   989\t    fn save_then_load_round_trips() {\n   990\t        let path = std::env::temp_dir().join(format!(\n   991\t            \"mesh-settings-roundtrip-{}-{}.json\",\n   992\t            std::process::id(),\n   993\t            line!()\n   994\t        ));\n   995\t        let mut written = SettingsStore::from_value(&path, json!({})).unwrap();\n   996\t        written.set_namespace(\"shell\", json!({ \"i18n\": { \"locale\": \"sk\" } }));\n   997\t        written.set_namespace(\n   998\t            \"@mesh/navigation-bar\",\n   999\t            json!({ \"surface\": { \"exclusive_zone\": 48 } }),\n  1000\t        );\n  1001\t        written.save().expect(\"write settings\");\n  1002\t\n  1003\t        let loaded = SettingsStore::load_from(&path).expect(\"read settings\");\n  1004\t        std::fs::remove_file(&path).ok();\n  1005\t\n  1006\t        assert_eq!(loaded.shell().i18n.locale, \"sk\");\n  1007\t        assert_eq!(loaded.shell().i18n.fallback_locale, \"en\");\n  1008\t        assert_eq!(\n  1009\t            loaded.namespace(\"@mesh/navigation-bar\")[\"surface\"][\"exclusive_zone\"],\n  1010\t            json!(48)\n  1011\t        );\n  1012\t    }\n  1013\t\n  1014\t    #[cfg(unix)]\n  1015\t    #[test]\n  1016\t    fn save_uses_owner_only_file_and_directory_permissions() {\n  1017\t        use std::os::unix::fs::PermissionsExt;\n  1018\t\n  1019\t        let root = std::env::temp_dir().join(format!(\n  1020\t            \"mesh-settings-permissions-{}-{}\",\n  1021\t            std::process::id(),\n  1022\t            line!()\n  1023\t        ));\n  1024\t        let parent = root.join(\"config\");\n  1025\t        let path = parent.join(\"settings.json\");\n  1026\t        let store = SettingsStore::from_value(&path, json!({})).unwrap();\n  1027\t\n  1028\t        store.save().expect(\"write settings\");\n  1029\t\n  1030\t        assert_eq!(\n  1031\t            std::fs::metadata(&parent).unwrap().permissions().mode() & 0o777,\n  1032\t            0o700\n  1033\t        );\n  1034\t        assert_eq!(\n  1035\t            std::fs::metadata(&path).unwrap().permissions().mode() & 0o777,\n  1036\t            0o600\n  1037\t        );\n  1038\t        assert_eq!(\n  1039\t            std::fs::read_dir(&parent)\n  1040\t                .unwrap()\n  1041\t                .filter_map(Result::ok)\n  1042\t                .count(),\n  1043\t            1,\n  1044\t            \"the unique temporary file must be removed by the rename\"\n  1045\t        );\n  1046\t\n  1047\t        std::fs::remove_dir_all(root).ok();\n  1048\t    }\n  1049\t\n  1050\t    #[test]\n  1051\t    fn concurrent_saves_keep_complete_documents_and_clean_temporary_files() {\n  1052\t        let root = std::env::temp_dir().join(format!(\n  1053\t            \"mesh-settings-concurrent-{}-{}\",\n  1054\t            std::process::id(),\n  1055\t            line!()\n  1056\t        ));\n  1057\t        let path = root.join(\"settings.json\");\n  1058\t        let shared_path = std::sync::Arc::new(path.clone());\n  1059\t\n  1060\t        let workers = (0..4)\n  1061\t            .map(|worker| {\n  1062\t                let path = shared_path.clone();\n  1063\t                std::thread::spawn(move || {\n  1064\t                    let mut store = SettingsStore::from_value(&*path, json!({})).unwrap();\n  1065\t                    store.set_namespace(\n  1066\t                        \"shell\",\n  1067\t                        json!({\n  1068\t                            \"i18n\": { \"locale\": format!(\"worker-{worker}\") }\n  1069\t                        }),\n  1070\t                    );\n  1071\t                    for _ in 0..8 {\n  1072\t                        store.save().unwrap();\n  1073\t                    }\n  1074\t                })\n  1075\t            })\n  1076\t            .collect::<Vec<_>>();\n  1077\t        for worker in workers {\n  1078\t            worker\n  1079\t                .join()\n  1080\t                .expect(\"concurrent settings writer must not panic\");\n  1081\t        }\n  1082\t\n  1083\t        let loaded = SettingsStore::load_from(&path).expect(\"last atomic document is valid JSON\");\n  1084\t        assert!(loaded.shell().i18n.locale.starts_with(\"worker-\"));\n  1085\t        assert_eq!(\n  1086\t            std::fs::read_dir(&root)\n  1087\t                .unwrap()\n  1088\t                .filter_map(Result::ok)\n  1089\t                .count(),\n  1090\t            1,\n  1091\t            \"unique temporary files must not remain after concurrent saves\"\n  1092\t        );\n  1093\t\n  1094\t        std::fs::remove_dir_all(root).ok();\n  1095\t    }\n  1120\t\n  1121\t    #[test]\n  1122\t    fn a_non_object_value_builds_a_default_store_with_a_root_diagnostic() {\n  1123\t        let store = SettingsStore::from_value(\"/tmp/mesh-test-settings.json\", json!(null))\n  1124\t            .expect(\"non-object values are recoverable\");\n  1125\t\n  1126\t        assert_eq!(store.shell().theme.active, \"tokyo-night\");\n  1127\t        let diagnostic = only(store.diagnostics());\n  1128\t        assert_eq!(diagnostic.namespace, \"\");\n  1129\t        assert_eq!(diagnostic.key_path, \"\");\n  1130\t        assert!(diagnostic.message.contains(\"found null\"));\n  1131\t    }\n  1132\t\n  1133\t    fn only(diagnostics: &[SettingsDiagnostic]) -> &SettingsDiagnostic {\n  1134\t        assert_eq!(\n  1135\t            diagnostics.len(),\n  1136\t            1,\n  1137\t            \"expected one diagnostic: {diagnostics:#?}\"\n  1138\t        );\n  1139\t        &diagnostics[0]\n  1140\t    }\n  1141\t\n  1142\t    #[test]\n  1143\t    fn the_repository_settings_file_is_clean() {\n  1144\t        let path = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n  1145\t            .join(\"../../../..\")\n  1146\t            .join(\"config/settings.json\");\n  1147\t        let store = SettingsStore::load_from(&path).expect(\"load repo settings\");\n  1148\t        assert_eq!(store.diagnostics(), &[], \"repo settings.json must validate\");\n  1149\t    }\n  1150\t\n  1151\t    #[test]\n  1152\t    fn a_wrong_type_is_reported_and_keeps_the_default() {\n  1153\t        let store = store(json!({ \"shell\": { \"tooltip\": { \"delay_ms\": \"300\" } } }));\n  1154\t\n  1155\t        let diagnostic = only(store.diagnostics());\n  1156\t        assert!(diagnostic.is_error());\n  1157\t        assert_eq!(diagnostic.namespace, \"shell\");\n  1158\t        assert_eq!(diagnostic.key_path, \"tooltip.delay_ms\");\n  1159\t        assert!(\n  1160\t            diagnostic.message.contains(\"non-negative integer\")\n  1161\t                && diagnostic.message.contains(\"the string \\\"300\\\"\"),\n  1162\t            \"message should name both the expectation and the value: {}\",\n  1163\t            diagnostic.message\n  1164\t        );\n  1165\t        assert_eq!(store.shell().tooltip.delay_ms, 300);\n  1166\t    }\n  1167\t\n  1168\t    #[test]\n  1169\t    fn a_bad_enum_value_lists_the_accepted_ones() {\n  1170\t        let store = store(json!({ \"shell\": { \"tooltip\": { \"position\": \"botom\" } } }));\n  1171\t\n  1172\t        let diagnostic = only(store.diagnostics());\n  1173\t        assert!(diagnostic.is_error());\n  1174\t        assert_eq!(diagnostic.key_path, \"tooltip.position\");\n  1175\t        assert!(\n  1176\t            diagnostic.suggested_action.contains(\"bottom\"),\n  1177\t            \"suggestion should quote the vocabulary: {}\",\n  1178\t            diagnostic.suggested_action\n  1179\t        );\n  1180\t        assert_eq!(store.shell().tooltip.position, \"bottom\");\n","exit_code":0,"status":"completed"}}
