\n   696\t                }\n   697\t            }\n   698\t        } else {\n   699\t            None\n   700\t        };\n   701\t        let candidate_theme_id = prepared_theme\n   702\t            .as_ref()\n   703\t            .map(|(theme, _)| theme.id.clone())\n   704\t            .unwrap_or_else(|| self.theme.active().id.clone());\n   705\t        for candidate in &mut candidates {\n   706\t            Self::apply_runtime_settings(\n   707\t                candidate,\n   708\t                &candidate_theme_id,\n   709\t                &settings.shell().i18n.locale,\n   710\t            );\n   711\t        }\n   712\t        let desired_providers = candidates\n   713\t            .iter()\n   714\t            .map(|candidate| (candidate.interface.clone(), candidate.module_id.clone()))\n   715\t            .collect::<HashMap<_, _>>();\n   716\t        let current_configs = self\n   717\t            .installed_module_graph\n   718\t            .as_ref()\n   719\t            .map(|current_graph| {\n   720\t                let (mut current, _) = backend_launch_candidates_from_graph_with_capabilities(\n   721\t                    current_graph,\n   722\t                    &self.modules,\n   723\t                    &self.settings_store,\n   724\t                    &self.interfaces,\n   725\t                    Some(&self.effective_capabilities),\n   726\t                );\n   727\t                for candidate in &mut current {\n   728\t                    self.apply_shell_runtime_settings(candidate);\n   729\t                }\n   730\t                current\n   731\t                    .into_iter()\n   732\t                    .map(|candidate| {\n   733\t                        (\n   734\t                            candidate.interface,\n   735\t                            (candidate.module_id, candidate.settings),\n   736\t                        )\n   737\t                    })\n   738\t                    .collect::<HashMap<_, _>>()\n   739\t           