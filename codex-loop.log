r/mod.rs    |  49 ++---\n crates/core/shell/src/shell/component/animation.rs |  55 +++++-\n crates/core/shell/src/shell/component/tooltip.rs   |  34 ++--\n crates/core/ui/elements/src/style/resolve/cache.rs |  19 +-\n .../ui/elements/src/style/resolve/declaration.rs   |  58 ++++--\n crates/core/ui/elements/src/style/resolve/node.rs  |  72 +++++++-\n .../core/ui/elements/src/style/resolve/subtree.rs  |  23 ++-\n .../src/style/resolve/tests/application.rs         |  55 ++++++\n crates/core/ui/elements/src/style/resolve/value.rs |  34 +++-\n crates/core/ui/elements/src/style/types.rs         |   8 +\n docs/BACKLOG.md                                    |   1 -\n 14 files changed, 545 insertions(+), 85 deletions(-)\n5c2326be feat: compose graph theme layers\n .planning/STATUS.md                           |   5 +-\n .planning/log/2026-08.md                      |  15 ++\n crates/core/foundation/config/src/lib.rs      |  16 +-\n crates/core/foundation/config/src/validate.rs |  10 +\n crates/core/foundation/theme/src/lib.rs       | 301 ++++++++++++++++++++++++++\n crates/core/shell/src/shell/profile.rs        |   6 +-\n crates/core/shell/src/shell/runtime/mod.rs    |  14 ++\n crates/core/shell/src/shell/runtime/theme.rs  | 105 ++++-----\n crates/core/shell/src/shell/surface_layout.rs |  89 +++++++-\n docs/BACKLOG.md                               |   1 -\n 10 files changed, 490 insertions(+), 72 deletions(-)\n","exit_code":0,"status":"completed"}}
