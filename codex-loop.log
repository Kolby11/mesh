ce_payloads: HashMap<String, CachedServicePayload>,\n   721\t    /// Service names declared by this surface's manifest (and the manifests of\n   722\t    /// the component modules it embeds). Payloads for these are cached even\n   723\t    /// while no live runtime reads them, so lazily created child runtimes are\n   724\t    /// seeded with real state instead of an empty service proxy.\n   725\t    declared_service_names: HashSet<String>,\n   726\t    /// Readable key cache used only at event/ref navigation boundaries.\n   727\t    focused_key: Option<String>,\n   728\t    focus_visible_key: Option<String>,\n   729\t    /// Authoritative focus identities for runtime annotation and restyling.\n   730\t    focused_id: Option<NodeId>,\n   731\t    focus_visible_id: Option<NodeId>,\n   732\t    pointer_down_id: Option<NodeId>,\n   733\t    pointer_down_bounds: Option<(f32, f32, f32, f32)>,\n   734\t    pointer_down_target: Option<input::PressedTargetSnapshot>,\n   735\t    active_slider_id: Option<NodeId>,\n   736\t    gesture_capture: Option<GestureCapture>,\n   737\t    touch_targets: HashMap<i32, String>,\n   738\t    active_touches: HashMap<i32, (f32, f32)>,\n   739\t    touch_gestures: HashMap<i32, TouchGestureCapture>,\n   740\t    last_tap: Option<TapRecord>,\n   741\t    keyboard_button_press_activations: HashSet<(NodeId, String)>,\n   742\t    /// When a surface with keyboard interactivity transitions visible→true,\n   743\t    /// this flag tells the next paint to seed focus on the first tabbable\n   744\t    /// element. Lets a popover work with keyboard immediately after opening\n   745\t    /// without the user needing to click inside it first.\n","exit_code":0,"status":"completed"}}
