ing()))?;\n   437\t                if self.active_profile_id.as_deref() == Some(profile_id.as_str())\n   438\t                    || self.active_profile_id.is_none()\n   439\t                {\n   440\t                    Ok(self.apply_switch_profile(&profile_id))\n   441\t                } else {\n   442\t                    Ok(VecDeque::new())\n   443\t                }\n   444\t            }\n   445\t            ModuleKind::Frontend => {\n   446\t                let Some(profile_id) = selected_profile else {\n   447\t                    let graph = self\n   448\t                        .load_installed_module_graph_cached()\n   449\t                        .map_err(|error| package_error(error.to_string()))?\n   450\t                        .clone();\n   451\t                    return self.activate_frontend_module(&manifest.name, &graph);\n   452\t                };\n   453\t                let mut profile = paths\n   454\t                    .load_or_default(&profile_id)\n   455\t                    .map_err(|error| package_error(error.to_string()))?;\n   456\t                profile\n   457\t                    .add_frontend(manifest)\n   458\t                    .map_err(|error| package_error(error.to_string()))?;\n   459\t                let manifests = self\n   460\t                    .load_installed_module_graph_cached()\n   461\t                    .map_err(|error| package_error(error.to_string()))?\n   462\t                    .modules()\n   463\t                    .into_iter()\n   464\t                    .map(|module| module.manifest.clone())\n   465\t                    .collect::<Vec<_>>();\n   466\t                profile\n   467\t                    .active_module_ids(manifests.iter())\n   468\t                    .map_err(|error| package_error(error.to_string()))?;\n   469\t                paths\n   470\t                    .save(&profile_id, &profile)\n   471\t                    .map_err(|error| package_error(error.to_string()))?;\n   472\t                if self.active_profile_id.as_deref() == Some(profile_id.as_str())\n   473\t                    || self.active_profile_id.is_none()\n   474\t                {\n   475\t                    Ok(self.apply_switch_profile(&profile_id))\n   476\t                } else {\n   477\t                    Ok(VecDeque::new())\n   478\t                }\n   479\t            }\n   480\t            _ => Ok(VecDeque::new()),\n   481\t        }\n   482\t    }\n   483\t}\n   484\t\n   485\tfn package_error(message: impl Into<String>) -> ShellRunError {\n   486\t    ShellRunError::Package(message.into())\n   487\t}\n   488\t\n   489\tfn check_install_capabilities(\n   490\t    manifest: &ModuleManifest,\n","exit_code":0,"status":"completed"}}
