{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/core/foundation/config/src/settings.rs | sed -n '1,360p'\"","aggregated_output":"     1\t//! The single settings store.\n     2\t//!\n     3\t//! One JSON file holds every user decision, keyed by namespace\n     4\t//! (`docs/spec/08-settings.md` §1). Defaults never live here — they come from\n     5\t//! [`ShellSettings`]'s serde defaults and from module manifests / `<props>`\n     6\t//! declarations, so a module updating its defaults still reaches users who\n     7\t//! never overrode them.\n     8\t//!\n     9\t//! ```json\n    10\t//! {\n    11\t//!   \"schemaVersion\": 1,\n    12\t//!   \"shell\": { \"theme\": { \"active\": \"gruvbox-dark\" } },\n    13\t//!   \"@mesh/navigation-bar\": {\n    14\t//!     \"surface\": { \"anchor\": \"bottom\" },\n    15\t//!     \"props\": { \"global\": { \"density\": \"compact\" } }\n    16\t//!   }\n    17\t//! }\n    18\t//! ```\n    19\t\n    20\tuse crate::validate::{\n    21\t    SettingsDiagnostic, describe, unknown_key_diagnostic_from, validate_json_schema,\n    22\t    validate_object,\n    23\t};\n    24\tuse crate::{ConfigError, SHELL_SETTINGS_FIELDS, ShellSettings, mesh_home_path};\n    25\tuse serde_json::{Map as JsonMap, Value as JsonValue};\n    26\tuse std::collections::BTreeMap;\n    27\tuse std::fs::{self, File, OpenOptions};\n    28\tuse std::io::{self, Write};\n    29\tuse std::path::{Path, PathBuf};\n    30\tuse std::sync::atomic::{AtomicU64, Ordering};\n    31\t\n    32\tpub const SETTINGS_SCHEMA_VERSION: u64 = 1;\n    33\t\n    34\t/// Namespace holding core shell preferences (theme, locale, icons, keyboard,\n    35\t/// tooltip, sounds). Every other top-level key is a module id\n    36\t/// (`@scope/name`, optionally `#instance`) or an interface id (`mesh.audio`).\n    37\tpub const SHELL_NAMESPACE: &str = \"shell\";\n    38\t\n    39\tconst SCHEMA_VERSION_KEY: &str = \"schemaVersion\";\n    40\tstatic TEMP_FILE_SEQUENCE: AtomicU64 = AtomicU64::new(0);\n    41\t\n    42\t/// A schema registered by the owner of one settings namespace.\n    43\t#[derive(Debug, Clone, PartialEq)]\n    44\tpub struct SettingsNamespaceSchema {\n    45\t    pub namespace: String,\n    46\t    pub owner: String,\n    47\t    pub schema: JsonValue,\n    48\t}\n    49\t\n    50\timpl SettingsNamespaceSchema {\n    51\t    pub fn new(\n    52\t        namespace: impl Into<String>,\n    53\t        owner: impl Into<String>,\n    54\t        schema: JsonValue,\n    55\t    ) -> Result<Self, SettingsSchemaError> {\n    56\t        let candidate = Self {\n    57\t            namespace: namespace.into(),\n    58\t            owner: owner.into(),\n    59\t            schema,\n    60\t        };\n    61\t        candidate.validate()?;\n    62\t        Ok(candidate)\n    63\t    }\n    64\t\n    65\t    fn validate(&self) -> Result<(), SettingsSchemaError> {\n    66\t        if !is_namespace_id(&self.namespace) || self.namespace.contains('#') {\n    67\t            return Err(SettingsSchemaError::InvalidNamespace {\n    68\t                namespace: self.namespace.clone(),\n    69\t            });\n    70\t        }\n    71\t        if self.owner.trim().is_empty() {\n    72\t            return Err(SettingsSchemaError::EmptyOwner {\n    73\t                namespace: self.namespace.clone(),\n    74\t            });\n    75\t        }\n    76\t        if self.owner != self.namespace {\n    77\t            return Err(SettingsSchemaError::OwnerMismatch {\n    78\t                namespace: self.namespace.clone(),\n    79\t                owner: self.owner.clone(),\n    80\t            });\n    81\t        }\n    82\t        if self\n    83\t            .schema\n    84\t            .get(\"type\")\n    85\t            .and_then(JsonValue::as_str)\n    86\t            .is_some_and(|kind| kind != \"object\")\n    87\t        {\n    88\t            return Err(SettingsSchemaError::InvalidSchema {\n    89\t                path: \"type\".into(),\n    90\t                message: \"a namespace schema must describe an object\".into(),\n    91\t            });\n    92\t        }\n    93\t        validate_schema_definition(&self.schema, \"\")\n    94\t    }\n    95\t\n    96\t    fn normalized(mut self) -> Self {\n    97\t        // Manifest contributions historically used a bare field map while\n    98\t        // component props use an explicit object schema.\n    99\t        if self\n   100\t            .schema\n   101\t            .as_object()\n   102\t            .is_some_and(|schema| !schema.contains_key(\"type\"))\n   103\t        {\n   104\t            self.schema = serde_json::json!({\n   105\t                \"type\": \"object\",\n   106\t                \"properties\": self.schema,\n   107\t            });\n   108\t        }\n   109\t        self\n   110\t    }\n   111\t}\n   112\t\n   113\t#[derive(Debug, Clone, PartialEq, Eq, thiserror::Error)]\n   114\tpub enum SettingsSchemaError {\n   115\t    #[error(\"settings namespace '{namespace}' is invalid\")]\n   116\t    InvalidNamespace { namespace: String },\n   117\t    #[error(\"settings namespace '{namespace}' has no owner\")]\n   118\t    EmptyOwner { namespace: String },\n   119\t    #[error(\"owner '{owner}' cannot register settings namespace '{namespace}'\")]\n   120\t    OwnerMismatch { namespace: String, owner: String },\n   121\t    #[error(\"settings namespace '{namespace}' has more than one owner\")]\n   122\t    DuplicateNamespace { namespace: String },\n   123\t    #[error(\"invalid settings schema at '{path}': {message}\")]\n   124\t    InvalidSchema { path: String, message: String },\n   125\t}\n   126\t\n   127\t#[derive(Debug, Clone, Default, PartialEq)]\n   128\tpub struct SettingsSchemaRegistry {\n   129\t    schemas: BTreeMap<String, SettingsNamespaceSchema>,\n   130\t}\n   131\t\n   132\timpl SettingsSchemaRegistry {\n   133\t    pub fn get(&self, namespace: &str) -> Option<&SettingsNamespaceSchema> {\n   134\t        self.schemas.get(namespace)\n   135\t    }\n   136\t\n   137\t    pub fn iter(&self) -> impl Iterator<Item = &SettingsNamespaceSchema> {\n   138\t        self.schemas.values()\n   139\t    }\n   140\t\n   141\t    fn register(&mut self, schema: SettingsNamespaceSchema) -> Result<(), SettingsSchemaError> {\n   142\t        let schema = schema.normalized();\n   143\t        schema.validate()?;\n   144\t        if self.schemas.contains_key(&schema.namespace) {\n   145\t            return Err(SettingsSchemaError::DuplicateNamespace {\n   146\t                namespace: schema.namespace,\n   147\t            });\n   148\t        }\n   149\t        self.schemas.insert(schema.namespace.clone(), schema);\n   150\t        Ok(())\n   151\t    }\n   152\t}\n   153\t\n   154\t/// Every user-owned setting in the shell, loaded from one file.\n   155\t#[derive(Debug, Clone)]\n   156\tpub struct SettingsStore {\n   157\t    path: PathBuf,\n   158\t    root: JsonMap<String, JsonValue>,\n   159\t    schemas: SettingsSchemaRegistry,\n   160\t    validated_root: JsonMap<String, JsonValue>,\n   161\t    shell: ShellSettings,\n   162\t    document_diagnostics: Vec<SettingsDiagnostic>,\n   163\t    diagnostics: Vec<SettingsDiagnostic>,\n   164\t}\n   165\t\n   166\timpl Default for SettingsStore {\n   167\t    fn default() -> Self {\n   168\t        Self {\n   169\t            path: default_settings_path(),\n   170\t            root: JsonMap::new(),\n   171\t            schemas: SettingsSchemaRegistry::default(),\n   172\t            validated_root: JsonMap::new(),\n   173\t            shell: ShellSettings::default(),\n   174\t            document_diagnostics: Vec::new(),\n   175\t            diagnostics: Vec::new(),\n   176\t        }\n   177\t    }\n   178\t}\n   179\t\n   180\timpl SettingsStore {\n   181\t    /// A missing file is not an error: it means the user changed nothing.\n   182\t    pub fn load() -> Result<Self, ConfigError> {\n   183\t        Self::load_from(&default_settings_path())\n   184\t    }\n   185\t\n   186\t    pub fn load_from(path: &Path) -> Result<Self, ConfigError> {\n   187\t        let (root, diagnostics) = if path.exists() {\n   188\t            let content = std::fs::read_to_string(path)?;\n   189\t            match serde_json::from_str::<JsonValue>(&content)? {\n   190\t                JsonValue::Object(map) => (map, Vec::new()),\n   191\t                other => (\n   192\t                    JsonMap::new(),\n   193\t                    vec![non_object_document_diagnostic(\n   194\t                        &format!(\"{} must contain\", path.display()),\n   195\t                        &other,\n   196\t                    )],\n   197\t                ),\n   198\t            }\n   199\t        } else {\n   200\t            (JsonMap::new(), Vec::new())\n   201\t        };\n   202\t\n   203\t        let mut store = Self {\n   204\t            path: path.to_path_buf(),\n   205\t            root,\n   206\t            schemas: SettingsSchemaRegistry::default(),\n   207\t            validated_root: JsonMap::new(),\n   208\t            shell: ShellSettings::default(),\n   209\t            document_diagnostics: diagnostics,\n   210\t            diagnostics: Vec::new(),\n   211\t        };\n   212\t        store.rebuild_validation();\n   213\t        Ok(store)\n   214\t    }\n   215\t\n   216\t    /// Build a store from an already-parsed document.\n   217\t    pub fn from_value(path: impl Into<PathBuf>, value: JsonValue) -> Result<Self, ConfigError> {\n   218\t        let path = path.into();\n   219\t        let (root, diagnostics) = match value {\n   220\t            JsonValue::Object(map) => (map, Vec::new()),\n   221\t            other => (\n   222\t                JsonMap::new(),\n   223\t                vec![non_object_document_diagnostic(\"settings must be\", &other)],\n   224\t            ),\n   225\t        };\n   226\t        let mut store = Self {\n   227\t            path,\n   228\t            root,\n   229\t            schemas: SettingsSchemaRegistry::default(),\n   230\t            validated_root: JsonMap::new(),\n   231\t            shell: ShellSettings::default(),\n   232\t            document_diagnostics: diagnostics,\n   233\t            diagnostics: Vec::new(),\n   234\t        };\n   235\t        store.rebuild_validation();\n   236\t        Ok(store)\n   237\t    }\n   238\t\n   239\t    pub fn path(&self) -> &Path {\n   240\t        &self.path\n   241\t    }\n   242\t\n   243\t    /// Everything rejected while resolving the shell namespace, file top\n   244\t    /// level, and owner-registered namespaces.\n   245\t    pub fn diagnostics(&self) -> &[SettingsDiagnostic] {\n   246\t        &self.diagnostics\n   247\t    }\n   248\t\n   249\t    /// Core shell preferences with declared defaults already applied.\n   250\t    pub fn shell(&self) -> &ShellSettings {\n   251\t        &self.shell\n   252\t    }\n   253\t\n   254\t    /// Runtime-facing overrides for one namespace, or `{}`. Invalid values in\n   255\t    /// a registered schema are omitted; the raw document remains available\n   256\t    /// through [`Self::to_value`]. For an instance key\n   257\t    /// (`@mesh/navigation-bar#top`) the bare module namespace is the base and\n   258\t    /// the instance object layers over it.\n   259\t    pub fn namespace(&self, name: &str) -> JsonValue {\n   260\t        let mut resolved = match name.split_once('#') {\n   261\t            Some((base, _)) => self.resolved_stored(base),\n   262\t            None => JsonValue::Object(JsonMap::new()),\n   263\t        };\n   264\t        merge_json(&mut resolved, &self.resolved_stored(name));\n   265\t        resolved\n   266\t    }\n   267\t\n   268\t    /// Owner-registered schemas currently used to validate module settings.\n   269\t    pub fn schema_registry(&self) -> &SettingsSchemaRegistry {\n   270\t        &self.schemas\n   271\t    }\n   272\t\n   273\t    /// Register a batch of namespace schemas as one state transition.\n   274\t    ///\n   275\t    /// Validation and duplicate-owner checks happen against a staged\n   276\t    /// registry. A failure leaves the existing registry and runtime-facing\n   277\t    /// settings projection untouched.\n   278\t    pub fn register_namespace_schemas_transactionally<I>(\n   279\t        &mut self,\n   280\t        schemas: I,\n   281\t    ) -> Result<(), SettingsSchemaError>\n   282\t    where\n   283\t        I: IntoIterator<Item = SettingsNamespaceSchema>,\n   284\t    {\n   285\t        let mut candidate = self.schemas.clone();\n   286\t        for schema in schemas {\n   287\t            candidate.register(schema)?;\n   288\t        }\n   289\t        self.commit_schema_registry(candidate);\n   290\t        Ok(())\n   291\t    }\n   292\t\n   293\t    /// Replace the complete owner snapshot atomically. This is used when a\n   294\t    /// candidate installed graph is prepared or committed.\n   295\t    pub fn replace_namespace_schemas_transactionally<I>(\n   296\t        &mut self,\n   297\t        schemas: I,\n   298\t    ) -> Result<(), SettingsSchemaError>\n   299\t    where\n   300\t        I: IntoIterator<Item = SettingsNamespaceSchema>,\n   301\t    {\n   302\t        let mut candidate = SettingsSchemaRegistry::default();\n   303\t        for schema in schemas {\n   304\t            candidate.register(schema)?;\n   305\t        }\n   306\t        self.commit_schema_registry(candidate);\n   307\t        Ok(())\n   308\t    }\n   309\t\n   310\t    fn commit_schema_registry(&mut self, candidate: SettingsSchemaRegistry) {\n   311\t        let mut staged = self.clone();\n   312\t        staged.schemas = candidate;\n   313\t        staged.rebuild_validation();\n   314\t        self.schemas = staged.schemas;\n   315\t        self.validated_root = staged.validated_root;\n   316\t        self.shell = staged.shell;\n   317\t        self.diagnostics = staged.diagnostics;\n   318\t    }\n   319\t\n   320\t    pub fn register_namespace_schema(\n   321\t        &mut self,\n   322\t        schema: SettingsNamespaceSchema,\n   323\t    ) -> Result<(), SettingsSchemaError> {\n   324\t        self.register_namespace_schemas_transactionally([schema])\n   325\t    }\n   326\t\n   327\t    /// Whether anything is stored under `name` or, for an instance key, its\n   328\t    /// base module.\n   329\t    pub fn has_namespace(&self, name: &str) -> bool {\n   330\t        if self.root.contains_key(name) {\n   331\t            return true;\n   332\t        }\n   333\t        match name.split_once('#') {\n   334\t            Some((base, _)) => self.root.contains_key(base),\n   335\t            None => false,\n   336\t        }\n   337\t    }\n   338\t\n   339\t    /// Namespaces with stored overrides, in file order.\n   340\t    pub fn namespace_names(&self) -> impl Iterator<Item = &str> {\n   341\t        self.root\n   342\t            .keys()\n   343\t            .map(String::as_str)\n   344\t            .filter(|key| *key != SHELL_NAMESPACE && *key != SCHEMA_VERSION_KEY)\n   345\t    }\n   346\t\n   347\t    /// Replace one namespace's overrides; an empty object removes it so the\n   348\t    /// store stays sparse. A value the schema rejects still lands in the file\n   349\t    /// and surfaces in diagnostics, while readers receive only the validated\n   350\t    /// projection.\n   351\t    pub fn set_namespace(&mut self, name: &str, value: JsonValue) {\n   352\t        let is_empty = value.as_object().is_some_and(JsonMap::is_empty);\n   353\t        if value.is_null() || is_empty {\n   354\t            self.root.remove(name);\n   355\t        } else {\n   356\t            self.root.insert(name.to_string(), value);\n   357\t        }\n   358\t        self.rebuild_validation();\n   359\t    }\n   360\t\n","exit_code":0,"status":"completed"}}
