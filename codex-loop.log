= Arc::new(Mutex::new(Vec::new()));\n   580\t    shell.register_component(Box::new(RecordingComponent::with_keybinds(\n   581\t        events.clone(),\n   582\t        vec![mesh_core_debug::DebugKeybindEntry {\n   583\t            surface_id: \"@mesh/navigation-bar\".into(),\n   584\t            module_id: \"@mesh/navigation-bar\".into(),\n   585\t            action_id: \"mute\".into(),\n   586\t            label: Some(\"Mute\".into()),\n   587\t            description: Some(\"Toggle audio output\".into()),\n   588\t            category: Some(\"Audio\".into()),\n   589\t            label_key: Some(\"keybind.mute.label\".into()),\n   590\t            description_key: Some(\"keybind.mute.description\".into()),\n   591\t            category_key: Some(\"keybind.category.audio\".into()),\n   592\t            key: \"m\".into(),\n   593\t            modifiers: vec![\"ctrl\".into()],\n   594\t            trigger_kind: \"shortcut\".into(),\n   595\t            source: \"module_default\".into(),\n   596\t            accessibility_shortcut: \"Control+m\".into(),\n   597\t        }],\n   598\t    )));\n   599\t\n   600\t    shell.publish_debug_snapshot().unwrap();\n   601\t\n   602\t    let events = events.lock().unwrap();\n   603\t    let ServiceEvent::Updated { payload, .. } = events\n   604\t        .last()\n   605\t        .expect(\"debug snapshot should be delivered as a service update\")\n   606\t    else {\n   607\t        panic!(\"expected debug snapshot service update\");\n   608\t    };\n   609\t    assert_eq!(\n   610\t        payload[\"keybinds\"][0],\n   611\t        serde_json::json!({\n   612\t            \"surface_id\": \"@mesh/navigation-bar\",\n   613\t            \"module_id\": \"@mesh/navigation-bar\",\n   614\t            \"action_id\": \"mute\",\n   615\t            \"label\": \"Mute\",\n   616\t            \"description\": \"Toggle audio output\",\n   617\t            \"category\": \"Audio\",\n   618\t            \"label_key\": \"keybind.mute.label\",\n  