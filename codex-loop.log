`.\n    15\t/// Their optimistic state bindings keep slider visuals smooth while the\n    16\t/// backend command rate stays below the process-launch cost.\n    17\tpub(in crate::shell) const COMMAND_THROTTLE_INTERVAL: std::time::Duration =\n    18\t    std::time::Duration::from_millis(100);\n    19\tconst SERVICE_CALL_TIMEOUT: std::time::Duration = std::time::Duration::from_millis(100);\n    20\tconst POPOVER_HOVER_BRIDGE_DELAY: std::time::Duration = std::time::Duration::from_millis(180);\n    21\tconst DEBUG_INSPECTOR_SURFACE_ID: &str = \"@mesh/debug-inspector\";\n    22\t\n    23\t/// Canonical failure payload when a service command cannot be delivered (no\n    24\t/// backend channel, send failure, or unregistered interface).\n    25\tfn service_unavailable_response() -> serde_json::Value {\n    26\t    serde_json::json!({\n    27\t        \"ok\": false,\n    28\t        \"error\": \"service_unavailable\",\n    29\t        \"status\": \"service_unavailable\",\n    30\t    })\n    31\t}\n    32\t\n    33\timpl Shell {\n    34\t    fn apply_set_module_enabled(\n    35\t        &mut self,\n    36\t        module_id: &str,\n    37\t        enabled: bool,\n    38\t    ) -> VecDeque<CoreRequest> {\n    39\t        if self.pending_profile_switch.is_some() {\n    40\t            tracing::warn!(\n    41\t                module_id,\n    42\t                enabled,\n    43\t                \"module change rejected during profile switch\"\n    44\t            );\n    45\t            return VecDeque::new();\n    46\t        }\n    47\t        let graph_path = self.installed_module_graph_path();\n    48\t        let uses_profile = mesh_core_module::package::ProfilePaths::from_root_graph(&graph_path)\n    49\t            .and_then(|paths| paths.active_profile_id())\n    50\t            .ok()\n    51\t            .flatten()\n    52\t            .is_some();\n    53\t        if !enabled\n    54\t            && self\n    55\t                .pending_backend_runtimes\n    56\t                .values()\n    57\t                .any(|pending| pending.slot.provider_id == module_id)\n    58\t        {\n    59\t            let message = format!(\n    60\t                \"cannot disable {module_id} while it is being prepared as an active provider\"\n    61\t            );\n    62\t            tracing::warn!(module_id, enabled, \"{message}\");\n    63\t            self.diagnostics.record_lifecycle_error(\n    64\t                \"@mesh/settings\".to_string(),\n    65\t                \"invalid_module_enabled_selection\",\n    66\t                message,\n    67\t            );\n    68\t            return VecDeque::new();\n    69\t        }\n    70\t        let rejection = match self.load_installed_module_graph_cached() {\n    71\t            Err(error) => Some(format!(\n    72\t                \"cannot update module {module_id}: failed to load {}: {error}\",\n    73\t                graph_path.display()\n    74\t            )),\n    75\t            Ok(graph) if graph.module(module_id).is_none() => {\n    76\t                Some(format!(\"cannot update unknown module {module_id}\"))\n    77\t            }\n    78\t            Ok(_) if !enabled && module_id == \"@mesh/settings\" => {\n    79\t                Some(\"cannot disable @mesh/settings from its own settings surface\".into())\n    80\t            }\n    81\t            Ok(graph)\n    82\t                if !uses_profile\n    83\t                    && !enabled\n    84\t                    && graph\n    85\t                        .layout_entrypoint()\n    86\t                        .is_some_and(|layout| layout.module_id == module_id) =>\n    87\t            {\n    88\t                Some(format!(\n    89\t                    \"cannot disable {module_id} while it is the active root layout\"\n    90\t                ))\n    91\t            }\n    92\t            Ok(graph) if !enabled => graph\n    93\t                .backend_provider_contributions()\n    94\t                .into_iter()\n    95\t                .filter(|provider| provider.module_id == module_id)\n    96\t                .find_map(|provider| {\n    97\t                    graph\n    98\t                        .active_provider(&provider.interface)\n    99\t                        .filter(|active| active.module_id == module_id)\n   100\t                        .map(|_| {\n   101\t                            format!(\n   102\t                                \"cannot disable {module_id} while it is the active provider for {}; select another provider first\",\n   103\t                                provider.interface\n   104\t                            )\n   105\t                        })\n   106\t                }),\n   107\t            Ok(_) => None,\n   108\t        };\n   109\t        if let Some(message) = rejection {\n   110\t            tracing::warn!(module_id, enabled, \"{message}\");\n   111\t            self.diagnostics.record_lifecycle_error(\n   112\t                \"@mesh/settings\".to_string(),\n   113\t                \"invalid_module_enabled_selection\",\n   114\t                message,\n   115\t            );\n   116\t            return VecDeque::new();\n   117\t        }\n   118\t\n   119\t        let module_kind = self\n   120\t            .installed_module_graph\n   121\t            .as_ref()\n   122\t            .and_then(|graph| graph.module(module_id))\n   123\t            .map(|module| module.kind)\n   124\t            .expect(\"module existence was validated above\");\n   125\t        let rollback = match crate::shell::module_config::write_composed_module_enabled(\n   126\t            &graph_path,\n   127\t            module_id,\n   128\t            module_kind,\n   129\t            enabled,\n   130\t        ) {\n","exit_code":1,"status":"failed"}}
