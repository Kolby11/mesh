           if let Some(generation) = self\n  1216\t                .runtimes\n  1217\t                .lock()\n  1218\t                .unwrap()\n  1219\t                .get(self.root_instance_key())\n  1220\t                .map(|runtime| runtime.script_ctx.state().mutation_generation())\n  1221\t            {\n  1222\t                self.sync_runtime_generation(self.root_instance_key(), generation);\n  1223\t            }\n  1224\t        }\n  1225\t\n  1226\t        let Some(locale) = self\n  1227\t            .settings_json\n  1228\t            .get(\"i18n\")\n  1229\t            .and_then(|i18n| i18n.get(\"default_locale\"))\n  1230\t            .and_then(|l| l.as_str())\n  1231\t        else {\n  1232\t            if layout_changed || settings_changed {\n  1233\t                self.invalidate_surface_config();\n  1234\t            }\n  1235\t            return Ok(layout_changed || settings_changed);\n  1236\t        };\n  1237\t\n  1238\t        if self.locale.current() != locale {\n  1239\t            tracing::info!(\n  1240\t                \"module '{}': applying locale '{}' from module settings\",\n  1241\t                self.id(),\n  1242\t                locale\n  1243\t            );\n  1244\t            self.locale.set_locale(locale);\n  1245\t        }\n  1246\t\n  1247\t        if layout_changed || settings_changed {\n  1248\t            self.invalidate_surface_config();\n  1249\t        }\n  1250\t        Ok(layout_changed || settings_changed)\n  1251\t    }\n  1252\t\n  1253\t    fn reload_source(&mut self) -> Result<bool, ComponentError> {\n  1254\t        let manifest = self.compiled.manifest.clone();\n  1255\t        let recompiled = compile_frontend_module(&manifest, &self.module_dir).map_err(|err| {\n  1256\t            ComponentError::Failed {\n  1257\t                component_id: self.id().to_string(),\n  1258\t                message: format!(\"frontend recompile failed: {err}\"),\n  1259\t            }\n  1260\t        })?;\n  1261\t\