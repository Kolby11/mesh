    pub memory_bytes: u64,\\n    pub error_count: u64,\\n    pub health: HealthStatus,\\n}\\n\\n#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]\\npub enum IssueSeverity {\\n    Warning,\\n    Error,\\n}\\n\\n#[derive(Debug, Clone)]\\npub struct DiagnosticIssue {\\n    pub module_id: String,\\n    pub instance_id: String,\\n    pub issue_code: String,\\n    pub severity: IssueSeverity,\\n    pub message: String,\\n    pub first_seen: SystemTime,\\n    pub last_seen: SystemTime,\\n    pub count: u64,\\n    pub active: bool,\\n}\\n\\n#[derive(Debug, Clone)]\\npub struct DiagnosticInstanceSnapshot {\\n    pub instance_id: String,\\n    pub health: HealthStatus,\\n    pub issues: Vec<DiagnosticIssue>,\\n    pub active_issues: Vec<DiagnosticIssue>,\\n}\\n\\n#[derive(Debug, Clone)]\\npub struct DiagnosticModuleSnapshot {\\n    pub module_id: String,\\n    pub health: HealthStatus,\\n    pub instances: Vec<DiagnosticInstanceSnapshot>,\\n}\\n\\n#[derive(Debug, Clone)]\\npub struct Diagnostics {\\n    module_id: String,\\n    instance_id: String,\\n    state: Arc<Mutex<DiagnosticsState>>,\\n}\\n\\n/// Compatibility view for callers that inspect backend lifecycle rows.\\n#[derive(Debug, Clone)]\\npub struct LifecycleErrorRecord {\\n    pub provider_id: String,\\n    pub stage: String,\\n    pub latest_message: String,\\n    pub count: u64,\\n    pub last_seen: SystemTime,\\n    pub active: bool,\\n}\\n\\n#[derive(Debug)]\\nstruct DiagnosticsState {\\n    error_count: u64,\\n    issues: HashMap<String, DiagnosticIssue>,\\n}\\n\\nimpl Diagnostics {\\n    pub fn new(module_id: impl Into<String>) -> Self {\\n        Self::new_instance(module_id, \\\"\\\")\\n    }\\n\\n    pub fn new_instance(module_id: impl Into<String>, instance_id: impl Into<String>) -> Self {\\n        Self {\\n            module_id: module_id.into(),\\n            instance_id: instance_id.into(),\\n            state: Arc::new(Mutex::new(DiagnosticsState {\\n                error_count: 0,\\n                issues: HashMap::new(),\\n            })),\\n        }\\n    }\\n\\n    pub fn module_id(&self) -> &str {\\n        &self.module_id\\n    }\\n\\n    pub fn instance_id(&self) -> &str {\\n        &self.instance_id\\n    }\\n\\n    /// Resolve only the generic runtime issue. Other active issues remain\\n    /// visible, so a successful operation cannot hide an unresolved fault.\\n    pub fn healthy(&self) {\\n        self.resolve_issue(\\\"runtime\\\");\\n    }\\n\\n    pub fn degraded(&self, message: impl Into<String>) {\\n        self.record_issue(\\\"runtime\\\", IssueSeverity::Warning, message);\\n    }\\n\\n    pub fn error(&self, message: impl Into<String>) {\\n        self.record_issue(\\\"runtime\\\", IssueSeverity::Error, message);\\n    }\\n\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_91\",\"type\":\"command_execution\",\"command\":\"/run/current-system/sw/bin/bash -lc \\\"nl -ba crates/core/shell/src/shell/tests/debug.rs | sed -n '200,310p;560,635p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_91\",\"type\":\"command_execution\",\"command\":\"/run/current-system/sw/bin/bash -lc \\\"nl -ba crates/core/shell/src/shell/tests/debug.rs | sed -n '200,310p;560,635p'\\\"\",\"aggregated_output\":\"   200\\t        .expect(\\\"serialized pipewire graph entry\\\");\\n   201\\t    assert!(\\n   202\\t        pipewire_json[\\\"uses\\\"][\\\"native_binaries\\\"]\\n   203\\t            .as_array()\\n   204\\t            .is_some_and(|binaries| binaries.iter().any(|binary| {\\n   205\\t                binary[\\\"name\\\"] == serde_json::json!(\\\"wpctl\\\")\\n   206\\t                    && binary[\\\"optional\\\"] == serde_json::json!(false)\\n   207\\t                    && binary[\\\"available\\\"].is_boolean()\\n   208\\t            }))\\n   209\\t    );\\n   210\\t}\\n   211\\t\\n   212\\t#[test]\\n   213\\tfn deb