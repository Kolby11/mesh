rate::shell) fn deactivate_frontend_module(\n  1133\t        &mut self,\n  1134\t        module_id: &str,\n  1135\t        graph: Option<&InstalledModuleGraph>,\n  1136\t    ) -> Result<VecDeque<CoreRequest>, ShellRunError> {\n  1137\t        let previous_catalog = self.frontend_catalog.snapshot().catalog;\n  1138\t        let catalog =\n  1139\t            FrontendCatalog::from_modules_reusing(&self.modules, graph, Some(&previous_catalog))?;\n  1140\t        self.frontend_catalog.replace(catalog, None);\n  1141\t        self.sync_frontend_catalog_components();\n  1142\t\n  1143\t        let indices = self\n  1144\t            .components\n  1145\t            .iter()\n  1146\t            .enumerate()\n  1147\t            .filter(|(_, runtime)| runtime.component.id() == module_id)\n  1148\t            .map(|(index, _)| index)\n  1149\t            .collect::<Vec<_>>();\n  1150\t        if indices.is_empty() {\n  1151\t            return Ok(VecDeque::new());\n  1152\t        }\n  1153\t        let mut removed_surfaces = Vec::new();\n  1154\t        for index in indices.into_iter().rev() {\n  1155\t            let surface_id = self.components[index].surface_id.clone();\n  1156\t            let module_id = self.components[index].component.id().to_string();\n  1157\t            if let Some(module) = self.modules.get_mut(&module_id)\n  1158\t                && let Err(error) = module.mark_unloaded()\n  1159\t            {\n  1160\t                tracing::warn!(\n  1161\t                    module_id,\n  1162\t                    \"frontend unload lifecycle transition failed: {error}\"\n  1163\t                );\n  1164\t            }\n  1165\t            self.destroy_all_child_surfaces(index);\n  1165\t            self.destroy_all_child_surfaces(index);\n  1166\t            self.presentation_engine.destroy_surface(&surface_id);\n  1167\t            self.components.remove(index);\n  1168\t            self.diagnostics.unregister(&module_id, &surface_id);\n  1169\t         