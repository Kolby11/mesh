h)\n   198\t            .map_err(|error| package_error(error.to_string()))?;\n   199\t        let node = graph\n   200\t            .module(module_id)\n   201\t            .ok_or_else(|| package_error(format!(\"module {module_id} is not installed\")))?;\n   202\t        let module_kind = node.kind;\n   203\t        transaction\n   204\t            .protect_package_state(&graph_path, &config_dir.join(&root.modules_dir))\n   205\t            .map_err(|error| package_error(error.to_string()))?;\n   206\t        let installed_at = contained_path(\n   207\t            &config_dir.join(&root.modules_dir),\n   208\t            &node.path,\n   209\t            \"installed module path\",\n   210\t        )\n   211\t        .map_err(|error| package_error(error.to_string()))?;\n   212\t\n   213\t        let lock_path = config_dir.join(\"mesh.lock\");\n   214\t        let mut lock = MeshLock::load_or_default(&lock_path)\n   215\t            .map_err(|error| package_error(error.to_string()))?;\n   216\t        if !force\n   217\t            && lock\n   218\t                .modules\n   219\t                .get(module_id)\n   220\t                .is_some_and(|entry| !entry.requested_by.is_empty())\n   300\t            if root\n   301\t                .layout\n   302\t                .as_ref()\n   303\t                .and_then(|layout| layout.entrypoint.split(':').next())\n   304\t                == Some(module_id)\n   305\t            {\n   306\t                root.layout = None;\n   307\t            }\n   308\t            root.disabled.retain(|disabled| disabled != module_id);\n   309\t            root.capability_approvals.remove(module_id);\n   310\t            root.providers.retain(|_, provider| provider != module_id);\n   311\t            if root\n   312\t                .theme\n   313\t                .as_ref()\n   314\t                .is_some_and(|theme| theme.active == module_id)\n   315\t            {\n   316\t                root.theme = None;\n   317\t            }\n   318\t        }\n   319\t\n   320\t        let explicit_inventory = !root.modules.is_empty();\n   321\t        root.modules.remove(module_id);\n   322\t        if explicit_inventory {\n   323\t            root.save(&graph_path)\n   324\t                .map_err(|error| package_error(error.to_string()))?;\n   325\t        }\n   326\t\n   327\t        let active_profile_changed = active_profile\n   328\t            .as_deref()\n   329\t            .is_some_and(|profile_id| changed_profiles.iter().any(|id| id == profile_id));\n   330\t        let mut requests = VecDeque::new();\n   331\t\n   332\t        if installed_at.exists() {\n   333\t            validate_module_tree(&installed_at)\n   334\t                .map_err(|error| package_error(error.to_string()))?;\n   335\t            fs::remove_dir_all(&installed_at).map_err(|error| {\n   336\t                package_error(format!(\n   337\t                    \"failed to remove {}: {error}\",\n   338\t                    installed_at.display()\n   339\t                ))\n   340\t            })?;\n   341\t        }\n   342\t        let new_graph = load_installed_module_graph(&graph_path)\n   343\t            .map_err(|error| package_error(error.to_string()))?;\n   344\t        // Do not remove the in-memory module or its live runtime until the\n   345\t        // replacement graph has loaded successfully. A broken on-disk\n   346\t        // candidate must leave the last-known-good activation coherent.\n   347\t        self.modules.remove(module_id);\n   348\t        self.commit_installed_module_graph(new_graph.clone());\n   349\t        self.discover_modules();\n   350\t        self.resolve_modules()?;\n   351\t        self.register_interfaces_from_graph(&new_graph);\n   352\t\n   353\t        if active_profile.is_none() && module_kind == ModuleKind::Frontend {\n   354\t            requests.extend(self.deactivate_frontend_module(module_id, Some(&new_graph))?);\n   355\t        }\n   356\t\n   357\t        if active_profile_changed {\n   358\t            requests\n   359\t                .extend(self.apply_switch_profile(active_profile.as_deref().unwrap_or_default()));\n   360\t        } else {\n   361\t            let previous_catalog = self.frontend_catalog.snapshot().catalog;\n   362\t            let catalog = FrontendCatalog::from_modules_reusing(\n   363\t                &self.modules,\n   364\t                Some(&new_graph),\n   365\t                Some(&previous_catalog),\n   366\t            )?;\n   367\t            self.frontend_catalog.replace(catalog, None);\n   368\t            self.sync_frontend_catalog_components();\n   369\t        }\n   370\t\n   371\t        let lock_changed = lock.modules.remove(module_id).is_some()\n   372\t            || lock\n   373\t                .composition\n   374\t                .as_ref()\n   375\t                .is_some_and(|composition| composition.module == module_id);\n   376\t        if lock\n   377\t            .composition\n   378\t            .as_ref()\n   379\t            .is_some_and(|composition| composition.module == module_id)\n   380\t        {\n   381\t            lock.composition = None;\n   382\t        }\n   383\t        let remaining_manifests = new_graph\n   384\t            .modules()\n   385\t            .into_iter()\n   386\t            .map(|module| module.manifest.clone())\n   387\t            .collect::<Vec<_>>();\n   388\t        lock.refresh_metadata(remaining_manifests.iter());\n   389\t        if lock_changed || lock_path.exists() {\n   390\t            MeshLock::archive(&lock_path, &config_dir.join(\"lock-history\"))\n   390\t            MeshLock::archive(&lock_path, &config_dir.join(\"lock-history\"))\n   391\t                .map_err(|error| package_error(error.to_string()))?;\n   392\t            lock.save_with_store(\n   393\t                &lock_path,\n   394\t                &config_dir.join(&root.modules_dir),\n   395\t                &module_store_dir(config_dir),\n   396\t            )