  458\t    /// Last committed provider health event, replayed when a consumer mounts\n   459\t    /// after a graph/runtime transition.\n   460\t    latest_service_health: HashMap<String, ServiceEvent>,\n   461\t    service_contract_validation: HashMap<String, ContractValidationCache>,\n   462\t    /// Command-bound service state awaiting provider confirmation, keyed by\n   463\t    /// (interface, state field). Replacing an entry makes the newer CallId the\n   464\t    /// sole owner of rollback for that field.\n   465\t    pending_bound_service_state: HashMap<(String, String), PendingBoundServiceState>,\n   466\t    /// Historical owners let a newer failed write reveal an older still-live\n   467\t    /// write, or skip over older writes that already failed.\n   468\t    bound_service_state_transactions: HashMap<mesh_core_backend::CallId, PendingBoundServiceState>,\n   469\t    command_throttle: HashMap<(String, String), CommandThrottleState>,\n   470\t    pending_service_call_routes: HashMap<u64, ServiceCallRoute>,\n   471\t    pending_popover_hides: HashMap<SurfaceId, std::time::Instant>,\n   472\t    profiling: runtime::profiling::ProfilingRuntimeState,\n   473\t}\n   474\t\n   475\ttype BackendRuntimeStatusMap = HashMap<String, HashMap<String, BackendRuntimeStatusEntry>>;\n   476\t\n   477\t#[derive(Debug, Clone)]\n   478\tstruct BackendRuntimeSlot {\n   479\t    interface: String,\n   480\t    provider_id: String,\n   481\t    /// Identity carried by events from this particular runtime generation.\n   482\t    /// Candidate generations use a private value until they are committed.\n   483\t    event_provider_id: Arc<std::sync::RwLock<String>>,\n   484\t    command_tx: mpsc::UnboundedSender<ServiceCommandMsg>,\n   485\t    task: AbortHandle,\n   486\t}\n   487\t\n   488\t#[derive(Debug, Clone)]\n   489\tstruct PendingBackendRuntime {\n   490\t    slot: BackendRuntimeSlot,\n   491\t    graph_path: Option<PathBuf>,\n   492\t    started: bool,\n   493\t    initial_state: Option<serde_json::Value>,\n   494\t}\n   495\t\n   496\tpub fn default_ipc_socket_path() -> PathBuf {\n   497\t    if let Ok(path) = std::env::var(\"MESH_IPC_SOCKET\") {\n   498\t        if !path.trim().is_empty() {\n   499\t            return PathBuf::from(path);\n   500\t        }\n   501\t    }\n   502\t\n   503\t    if let Some(runtime_dir) = non_empty_env_path(std::env::var_os(\"XDG_RUNTIME_DIR\")) {\n   504\t        return runtime_dir.join(\"mesh.sock\");\n   505\t    }\n   506\t\n   507\t    let uid = std::env::var(\"UID\").unwrap_or_else(|_| \"unknown\".to_string());\n   508\t    PathBuf::from(\"/tmp\")\n   509\t        .join(format!(\"mesh-{uid}\"))\n   510\t        .join(\"mesh.sock\")\n   511\t}\n   512\t\n   513\tfn non_empty_env_path(value: Option<std::ffi::OsString>) -> Option<PathBuf> {\n   514\t    value.filter(|value| !value.is_empty()).map(PathBuf::from)\n   515\t}\n   516\t\n   517\timpl Default for Shell {\n   518\t    fn default() -> Self {\n   519\t        Self::new()\n   520\t    }\n   521\t}\n   522\t\n   523\t#[derive(Debug, thiserror::Error)]\n   524\tpub enum ShellRunError {\n   525\t    #[error(\"failed to initialize async runtime: {0}\")]\n   526\t    RuntimeInit(std::io::Error),\n   527\t\n   528\t    #[error(\"eventfd creation failed: {0}\")]\n   529\t    EventfdCreate(String),\n   530\t\n   531\t    #[error(transparent)]\n   532\t    Component(#[from] ComponentError),\n   533\t\n   534\t    #[error(\"failed to compile frontend module '{module_id}': {source}\")]\n   535\t    FrontendCompile {\n   536\t        module_id: String,\n   537\t        source: mesh_core_frontend::CompileFrontendError,\n   538\t    },\n   539\t\n   540\t    #[error(transparent)]\n   541\t    DependencyGraph(#[from] DependencyGraphError),\n   542\t\n   543\t    #[error(transparent)]\n   544\t    CapabilityPolicy(#[from] mesh_core_capability::CapabilityPolicyError),\n   545\t\n   546\t    #[error(transparent)]\n   547\t    ModuleGraph(#[from] mesh_core_