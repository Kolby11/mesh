{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/core/shell/src/shell/profile.rs | sed -n '1,260p'; nl -ba crates/core/shell/src/shell/profile.rs | sed -n '500,700p'; nl -ba crates/core/shell/src/shell/profile.rs | sed -n '900,1050p'\"","aggregated_output":"     1\tuse super::backend::{\n     2\t    BackendRuntimeStatus, backend_launch_candidates_from_graph_with_capabilities,\n     3\t};\n     4\tuse super::component::{FrontendCatalog, FrontendCatalogHandle, FrontendSurfaceComponent};\n     5\tuse super::*;\n     6\tuse mesh_core_module::package::{\n     7\t    ComponentPlacement, InstalledModuleGraph, NodeSlotOverride, ProfilePaths,\n     8\t    load_installed_module_graph_for_profile,\n     9\t};\n    10\tuse std::collections::{HashMap, HashSet, VecDeque};\n    11\tuse std::hash::{Hash, Hasher};\n    12\t\n    13\tfn resolve_component_props_schema(\n    14\t    mut schema: serde_json::Value,\n    15\t    translator: &mesh_core_locale::ModuleTranslator<'_>,\n    16\t) -> serde_json::Value {\n    17\t    let Some(properties) = schema\n    18\t        .get_mut(\"properties\")\n    19\t        .and_then(serde_json::Value::as_object_mut)\n    20\t    else {\n    21\t        return schema;\n    22\t    };\n    23\t\n    24\t    for definition in properties.values_mut() {\n    25\t        let Some(definition) = definition.as_object_mut() else {\n    26\t            continue;\n    27\t        };\n    28\t        for field in [\"label\", \"description\"] {\n    29\t            let Some(value) = definition.get_mut(field) else {\n    30\t                continue;\n    31\t            };\n    32\t            let Some(localized) = value.as_object() else {\n    33\t                continue;\n    34\t            };\n    35\t            let key = localized\n    36\t                .get(\"t\")\n    37\t                .and_then(serde_json::Value::as_str)\n    38\t                .map(str::to_owned);\n    39\t            let fallback = localized\n    40\t                .get(\"fallback\")\n    41\t                .and_then(serde_json::Value::as_str)\n    42\t                .map(str::to_owned);\n    43\t            if let Some(text) = key\n    44\t                .as_deref()\n    45\t                .and_then(|key| translator.translate(key))\n    46\t                .or(fallback.as_deref())\n    47\t            {\n    48\t                *value = serde_json::Value::String(text.to_string());\n    49\t            }\n    50\t        }\n    51\t    }\n    52\t    schema\n    53\t}\n    54\t\n    55\tpub(super) struct PreparedProfileFrontend {\n    56\t    component: FrontendSurfaceComponent,\n    57\t    requests: VecDeque<CoreRequest>,\n    58\t}\n    59\t\n    60\t#[cfg(test)]\n    61\tmod tests {\n    62\t    use super::super::discovery::effective_profile_settings;\n    63\t    use super::update_module_prop_override;\n    64\t    use mesh_core_config::SettingsStore;\n    65\t    use mesh_core_module::package::ShellProfile;\n    66\t\n    67\t    #[test]\n    68\t    fn profile_preferences_layer_over_shared_settings_without_mutating_them() {\n    69\t        let shared = SettingsStore::from_value(\n    70\t            \"/tmp/shared-settings.json\",\n    71\t            serde_json::json!({\n    72\t                \"shell\": { \"theme\": { \"active\": \"mesh-default-light\" } },\n    73\t                \"@test/panel\": { \"props\": { \"global\": { \"density\": \"comfortable\" } } }\n    74\t            }),\n    75\t        )\n    76\t        .unwrap();\n    77\t        let profile = ShellProfile::from_json_str(\n    78\t            r#\"{\n    79\t                \"schemaVersion\": 3,\n    80\t                \"roots\": {},\n    81\t                \"settings\": {\n    82\t                    \"shell\": { \"theme\": { \"active\": \"mesh-default-dark\" } },\n    83\t                    \"@test/panel\": { \"props\": { \"global\": { \"density\": \"compact\" } } }\n    84\t                }\n    85\t            }\"#,\n    86\t        )\n    87\t        .unwrap();\n    88\t\n    89\t        let effective = effective_profile_settings(shared.clone(), Some(&profile)).unwrap();\n    90\t        assert_eq!(effective.shell().theme.active, \"mesh-default-dark\");\n    91\t        assert_eq!(\n    92\t            effective.namespace(\"@test/panel\")[\"props\"][\"global\"][\"density\"],\n    93\t            \"compact\"\n    94\t        );\n    95\t        assert_eq!(shared.shell().theme.active, \"mesh-default-light\");\n    96\t    }\n    97\t\n    98\t    #[test]\n    99\t    fn module_prop_updates_preserve_siblings_and_reset_sparsely() {\n   100\t        let mut namespace = serde_json::json!({\n   101\t            \"surface\": { \"anchor\": \"top\" },\n   102\t            \"props\": { \"global\": { \"density\": \"compact\" } }\n   103\t        });\n   104\t\n   105\t        update_module_prop_override(\n   106\t            &mut namespace,\n   107\t            None,\n   108\t            \"blur_enabled\",\n   109\t            Some(serde_json::json!(false)),\n   110\t        );\n   111\t        assert_eq!(\n   112\t            namespace[\"props\"][\"global\"],\n   113\t            serde_json::json!({ \"density\": \"compact\", \"blur_enabled\": false })\n   114\t        );\n   115\t\n   116\t        update_module_prop_override(&mut namespace, None, \"blur_enabled\", None);\n   117\t        update_module_prop_override(&mut namespace, None, \"density\", None);\n   118\t        assert!(namespace.get(\"props\").is_none());\n   119\t        assert_eq!(namespace[\"surface\"][\"anchor\"], serde_json::json!(\"top\"));\n   120\t    }\n   121\t\n   122\t    #[test]\n   123\t    fn instance_prop_updates_preserve_global_values_and_prune_empty_scopes() {\n   124\t        let mut namespace = serde_json::json!({\n   125\t            \"props\": { \"global\": { \"density\": \"compact\" } }\n   126\t        });\n   127\t        update_module_prop_override(\n   128\t            &mut namespace,\n   129\t            Some(\"@test/panel#bottom\"),\n   130\t            \"density\",\n   131\t            Some(serde_json::json!(\"comfortable\")),\n   132\t        );\n   133\t        assert_eq!(\n   134\t            namespace[\"props\"][\"instances\"][\"@test/panel#bottom\"][\"density\"],\n   135\t            \"comfortable\"\n   136\t        );\n   137\t\n   138\t        update_module_prop_override(&mut namespace, Some(\"@test/panel#bottom\"), \"density\", None);\n   139\t        assert!(namespace[\"props\"].get(\"instances\").is_none());\n   140\t        assert_eq!(namespace[\"props\"][\"global\"][\"density\"], \"compact\");\n   141\t    }\n   142\t\n   143\t    #[test]\n   144\t    fn instance_surface_override_is_scoped_to_the_profile_root_key() {\n   145\t        let shared = SettingsStore::from_value(\n   146\t            \"/tmp/shared-settings.json\",\n   147\t            serde_json::json!({ \"@test/panel\": { \"surface\": { \"anchor\": \"top\" } } }),\n   148\t        )\n   149\t        .unwrap();\n   150\t        let profile = ShellProfile::from_json_str(\n   151\t            r#\"{\n   152\t                \"schemaVersion\": 3,\n   153\t                \"roots\": {\n   154\t                    \"@test/panel#bottom\": {\n   155\t                        \"module\": \"@test/panel\",\n   156\t                        \"surface\": { \"anchor\": \"bottom\" }\n   157\t                    }\n   158\t                }\n   159\t            }\"#,\n   160\t        )\n   161\t        .unwrap();\n   162\t\n   163\t        let effective = effective_profile_settings(shared, Some(&profile)).unwrap();\n   164\t        assert_eq!(\n   165\t            effective.namespace(\"@test/panel#bottom\")[\"surface\"][\"anchor\"],\n   166\t            \"bottom\"\n   167\t        );\n   168\t        assert_eq!(\n   169\t            effective.namespace(\"@test/panel#other\")[\"surface\"][\"anchor\"],\n   170\t            \"top\"\n   171\t        );\n   172\t    }\n   173\t}\n   174\t\n   175\tpub(super) struct PendingProfileSwitch {\n   176\t    profile_id: String,\n   177\t    graph: InstalledModuleGraph,\n   178\t    locale: LocaleEngine,\n   179\t    settings: Arc<SettingsStore>,\n   180\t    prepared_theme: Option<(mesh_core_theme::Theme, ThemeWatchState)>,\n   181\t    catalog: FrontendCatalog,\n   182\t    desired_surfaces: HashSet<String>,\n   183\t    desired_providers: HashMap<String, String>,\n   184\t    prepared_frontends: Vec<PreparedProfileFrontend>,\n   185\t    candidate_backends: HashMap<String, BackendRuntimeSlot>,\n   186\t    waiting_backends: HashSet<String>,\n   187\t    candidate_started: HashSet<String>,\n   188\t    candidate_initial_states: HashMap<String, serde_json::Value>,\n   189\t}\n   190\t\n   191\timpl Shell {\n   192\t    pub(in crate::shell) fn profile_candidate_is_pending(\n   193\t        &self,\n   194\t        interface: &str,\n   195\t        provider_id: &str,\n   196\t    ) -> bool {\n   197\t        self.pending_profile_switch\n   198\t            .as_ref()\n   199\t            .and_then(|pending| pending.candidate_backends.get(interface))\n   200\t            .is_some_and(|slot| {\n   201\t                *slot\n   202\t                    .event_provider_id\n   203\t                    .read()\n   204\t                    .unwrap_or_else(|poisoned| poisoned.into_inner())\n   205\t                    == provider_id\n   206\t            })\n   207\t    }\n   208\t\n   209\t    pub(in crate::shell) fn apply_node_slot_edit(\n   210\t        &mut self,\n   211\t        profile_id: &str,\n   212\t        root_instance: &str,\n   213\t        slot: &str,\n   214\t        nodes: Option<serde_json::Value>,\n   215\t        expected_generation: &str,\n   216\t    ) -> Result<VecDeque<CoreRequest>, ShellRunError> {\n   217\t        if self.pending_profile_switch.is_some() {\n   218\t            return Err(ShellRunError::Package(\n   219\t                \"node edit rejected while a profile switch is pending\".into(),\n   220\t            ));\n   221\t        }\n   222\t        let graph_path = self.installed_module_graph_path();\n   223\t        let paths = ProfilePaths::from_root_graph(&graph_path)?;\n   224\t        let mut profile = paths.load(profile_id)?;\n   225\t        let generation = profile_generation(&profile)?;\n   226\t        if generation != expected_generation {\n   227\t            return Err(ShellRunError::Package(format!(\n   228\t                \"node_edit_generation_conflict: expected {expected_generation}, current {generation}\"\n   229\t            )));\n   230\t        }\n   231\t\n   232\t        match nodes {\n   233\t            Some(nodes) => {\n   234\t                let nodes: Vec<ComponentPlacement> =\n   235\t                    serde_json::from_value(nodes).map_err(|error| {\n   236\t                        ShellRunError::Package(format!(\"invalid_node_props: {error}\"))\n   237\t                    })?;\n   238\t                profile\n   239\t                    .node_slots\n   240\t                    .entry(root_instance.to_string())\n   241\t                    .or_default()\n   242\t                    .insert(slot.to_string(), NodeSlotOverride { nodes });\n   243\t            }\n   244\t            None => {\n   245\t                if let Some(slots) = profile.node_slots.get_mut(root_instance) {\n   246\t                    slots.remove(slot);\n   247\t                    if slots.is_empty() {\n   248\t                        profile.node_slots.remove(root_instance);\n   249\t                    }\n   250\t                }\n   251\t            }\n   252\t        }\n   253\t        profile.validate()?;\n   254\t        let candidate = load_installed_module_graph_for_profile(&graph_path, &profile)?;\n   255\t        let previous_catalog = self.frontend_catalog.snapshot().catalog;\n   256\t        FrontendCatalog::from_modules_reusing(\n   257\t            &self.modules,\n   258\t            Some(&candidate),\n   259\t            Some(&previous_catalog),\n   260\t        )?;\n   500\t            .ok()\n   501\t            .and_then(|metadata| metadata.modified().ok());\n   502\t        self.apply_settings_to_components()?;\n   503\t        self.components_want_render = true;\n   504\t        Ok(VecDeque::new())\n   505\t    }\n   506\t\n   507\t    pub(in crate::shell) fn apply_switch_profile(\n   508\t        &mut self,\n   509\t        profile_id: &str,\n   510\t    ) -> VecDeque<CoreRequest> {\n   511\t        if self.pending_profile_switch.is_some() {\n   512\t            self.reject_profile_switch(\n   513\t                profile_id,\n   514\t                \"another profile switch is already being prepared\".into(),\n   515\t            );\n   516\t            return VecDeque::new();\n   517\t        }\n   518\t        if !self.pending_backend_runtimes.is_empty() {\n   519\t            self.reject_profile_switch(\n   520\t                profile_id,\n   521\t                \"a provider switch is already being prepared\".into(),\n   522\t            );\n   523\t            return VecDeque::new();\n   524\t        }\n   525\t\n   526\t        let graph_path = self.installed_module_graph_path();\n   527\t        let paths = match ProfilePaths::from_root_graph(&graph_path) {\n   528\t            Ok(paths) => paths,\n   529\t            Err(error) => {\n   530\t                self.reject_profile_switch(profile_id, error.to_string());\n   531\t                return VecDeque::new();\n   532\t            }\n   533\t        };\n   534\t        let profile = match paths.load(profile_id) {\n   535\t            Ok(profile) => profile,\n   536\t            Err(error) => {\n   537\t                self.reject_profile_switch(profile_id, error.to_string());\n   538\t                return VecDeque::new();\n   539\t            }\n   540\t        };\n   541\t        let graph = match load_installed_module_graph_for_profile(&graph_path, &profile) {\n   542\t            Ok(graph) => graph,\n   543\t            Err(error) => {\n   544\t                self.reject_profile_switch(profile_id, error.to_string());\n   545\t                return VecDeque::new();\n   546\t            }\n   547\t        };\n   548\t        let shared = match SettingsStore::load() {\n   549\t            Ok(settings) => settings,\n   550\t            Err(error) => {\n   551\t                self.reject_profile_switch(profile_id, error.to_string());\n   552\t                return VecDeque::new();\n   553\t            }\n   554\t        };\n   555\t        let settings = match super::discovery::effective_profile_settings(shared, Some(&profile)) {\n   556\t            Ok(mut settings) => {\n   557\t                if let Err(error) =\n   558\t                    super::discovery::register_graph_settings_schemas(&mut settings, &graph)\n   559\t                {\n   560\t                    self.reject_profile_switch(\n   561\t                        profile_id,\n   562\t                        format!(\"failed to register candidate settings schemas: {error}\"),\n   563\t                    );\n   564\t                    return VecDeque::new();\n   565\t                }\n   566\t                Arc::new(settings)\n   567\t            }\n   568\t            Err(error) => {\n   569\t                self.reject_profile_switch(profile_id, error.to_string());\n   570\t                return VecDeque::new();\n   571\t            }\n   572\t        };\n   573\t\n   574\t        let locale = match self.prepare_locale_for_settings(settings.shell(), &graph) {\n   575\t            Ok(locale) => locale,\n   576\t            Err(error) => {\n   577\t                self.reject_profile_switch(\n   578\t                    profile_id,\n   579\t                    format!(\"candidate locale catalogs are invalid: {error}\"),\n   580\t                );\n   581\t                return VecDeque::new();\n   582\t            }\n   583\t        };\n   584\t\n   585\t        let previous_catalog = self.frontend_catalog.snapshot().catalog;\n   586\t        let catalog = match FrontendCatalog::from_modules_reusing(\n   587\t            &self.modules,\n   588\t            Some(&graph),\n   589\t            Some(&previous_catalog),\n   590\t        ) {\n   591\t            Ok(catalog) => catalog,\n   592\t            Err(error) => {\n   593\t                self.reject_profile_switch(profile_id, error.to_string());\n   594\t                return VecDeque::new();\n   595\t            }\n   596\t        };\n   597\t        let temporary_catalog = FrontendCatalogHandle::from(catalog.clone());\n   598\t        let entries = catalog\n   599\t            .top_level_surfaces()\n   600\t            .into_iter()\n   601\t            .map(|entry| (entry.compiled.manifest.package.id.clone(), entry))\n   602\t            .collect::<HashMap<_, _>>();\n   603\t        let desired_surfaces = profile\n   604\t            .roots\n   605\t            .iter()\n   606\t            .filter(|(_, root)| root.active)\n   607\t            .map(|(instance_id, _)| instance_id.clone())\n   608\t            .collect::<HashSet<_>>();\n   609\t        let existing_surfaces = self\n   610\t            .components\n   611\t            .iter()\n   612\t            .map(|runtime| runtime.surface_id.clone())\n   613\t            .collect::<HashSet<_>>();\n   614\t        let mut prepared_frontends = Vec::new();\n   615\t        for (instance_id, root) in profile.roots.iter().filter(|(_, root)| root.active) {\n   616\t            if existing_surfaces.contains(instance_id) {\n   617\t                continue;\n   618\t            }\n   619\t            let Some(entry) = entries.get(&root.module) else {\n   620\t                self.reject_profile_switch(\n   621\t                    profile_id,\n   622\t                    format!(\"profile root {instance_id} has no mountable frontend entrypoint\"),\n   623\t                );\n   624\t                return VecDeque::new();\n   625\t            };\n   626\t            let mut component = FrontendSurfaceComponent::new(\n   627\t                entry.compiled.clone(),\n   628\t                entry.module_dir.clone(),\n   629\t                temporary_catalog.clone(),\n   630\t                Arc::new(self.interfaces.resolved_catalog()),\n   631\t                settings.clone(),\n   632\t            )\n   633\t            .with_effective_capabilities(self.effective_capabilities.clone())\n   634\t            .with_instance_id(instance_id)\n   635\t            .with_locale_catalog_snapshot(locale.catalog_snapshot());\n   636\t            let diagnostics = self\n   637\t                .diagnostics\n   638\t                .register_instance(root.module.clone(), instance_id.clone());\n   639\t            let mut requests = match component.mount(ComponentContext {\n   640\t                component_id: root.module.clone(),\n   641\t                surface_id: instance_id.clone(),\n   642\t                diagnostics,\n   643\t            }) {\n   644\t                Ok(requests) => VecDeque::from(requests),\n   645\t                Err(error) => {\n   646\t                    self.reject_profile_switch(profile_id, error.to_string());\n   647\t                    return VecDeque::new();\n   648\t                }\n   649\t            };\n   650\t            if let Err(error) = component.locale_changed(&locale) {\n   651\t                self.reject_profile_switch(profile_id, error.to_string());\n   652\t                return VecDeque::new();\n   653\t            }\n   654\t            for state in self.latest_service_state.values() {\n   655\t                let event = ServiceEvent::Updated {\n   656\t                    service: state.interface.clone(),\n   657\t                    source_module: state.provider_id.clone(),\n   658\t                    payload: state.state.clone(),\n   659\t                };\n   660\t                if component.observes_service_event(&event) {\n   661\