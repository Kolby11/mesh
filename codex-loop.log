{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/core/runtime/scripting/src/context/proxy.rs | sed -n '1,240p'; nl -ba crates/core/runtime/scripting/src/context/proxy.rs | sed -n '340,470p'\"","aggregated_output":"     1\tuse super::PublishedEvent;\n     2\tuse super::state::ServiceContextState;\n     3\tuse mesh_core_capability::{Capability, CapabilitySet};\n     4\tpub(super) use mesh_core_service::service_name_from_interface;\n     5\tuse mesh_core_service::{InterfaceContract, InterfaceResolution};\n     6\tuse mlua::{Function, Lua, LuaSerdeExt, Table, Value as LuaValue};\n     7\tuse serde_json::Value;\n     8\tuse std::collections::{HashMap, HashSet};\n     9\tuse std::sync::{\n    10\t    Arc, Mutex,\n    11\t    atomic::{AtomicBool, Ordering},\n    12\t};\n    13\t\n    14\tpub(super) fn create_interface_proxy(\n    15\t    lua: &Lua,\n    16\t    scope: &Table,\n    17\t    resolution: InterfaceResolution,\n    18\t    source_module_id: String,\n    19\t    source_capabilities: CapabilitySet,\n    20\t    service_context_state: Arc<Mutex<ServiceContextState>>,\n    21\t    tracked_service_fields: Arc<Mutex<HashMap<String, HashSet<String>>>>,\n    22\t    subscribed_interface_events: Arc<Mutex<HashMap<String, HashMap<String, usize>>>>,\n    23\t    published_events: Arc<Mutex<Vec<PublishedEvent>>>,\n    24\t    pending_side_channels: Arc<AtomicBool>,\n    25\t) -> mlua::Result<Table> {\n    26\t    create_service_proxy(\n    27\t        lua,\n    28\t        scope,\n    29\t        service_name_from_interface(&resolution.requested),\n    30\t        resolution.contract,\n    31\t        resolution.requested,\n    32\t        source_module_id,\n    33\t        source_capabilities,\n    34\t        service_context_state,\n    35\t        tracked_service_fields,\n    36\t        subscribed_interface_events,\n    37\t        published_events,\n    38\t        pending_side_channels,\n    39\t    )\n    40\t}\n    41\t\n    42\tpub(super) fn create_service_proxy(\n    43\t    lua: &Lua,\n    44\t    scope: &Table,\n    45\t    service_name: String,\n    46\t    contract: Option<Arc<InterfaceContract>>,\n    47\t    interface_name: String,\n    48\t    source_module_id: String,\n    49\t    source_capabilities: CapabilitySet,\n    50\t    service_context_state: Arc<Mutex<ServiceContextState>>,\n    51\t    tracked_service_fields: Arc<Mutex<HashMap<String, HashSet<String>>>>,\n    52\t    subscribed_interface_events: Arc<Mutex<HashMap<String, HashMap<String, usize>>>>,\n    53\t    published_events: Arc<Mutex<Vec<PublishedEvent>>>,\n    54\t    pending_side_channels: Arc<AtomicBool>,\n    55\t) -> mlua::Result<Table> {\n    56\t    let proxy = lua.create_table()?;\n    57\t    let meta = lua.create_table()?;\n    58\t\n    59\t    let methods = contract\n    60\t        .as_ref()\n    61\t        .map(|c| c.methods.clone())\n    62\t        .unwrap_or_default();\n    63\t    let interface_name = contract\n    64\t        .as_ref()\n    65\t        .map(|c| c.interface.clone())\n    66\t        .filter(|name| !name.is_empty())\n    67\t        .unwrap_or(interface_name);\n    68\t    let observed_state_fields = Arc::new(Mutex::new(HashSet::new()));\n    69\t    let state_proxy = create_service_state_proxy(\n    70\t        lua,\n    71\t        service_name.clone(),\n    72\t        Arc::clone(&service_context_state),\n    73\t        Arc::clone(&tracked_service_fields),\n    74\t        Arc::clone(&observed_state_fields),\n    75\t    )?;\n    76\t    let events_proxy = create_events_proxy(\n    77\t        lua,\n    78\t        scope,\n    79\t        &service_name,\n    80\t        contract\n    81\t            .as_ref()\n    82\t            .map(|contract| {\n    83\t                contract\n    84\t                    .events\n    85\t                    .iter()\n    86\t                    .map(|event| event.name.clone())\n    87\t                    .collect::<Vec<_>>()\n    88\t            })\n    89\t            .unwrap_or_default(),\n    90\t        Arc::clone(&subscribed_interface_events),\n    91\t    )?;\n    92\t    let state_for_index = state_proxy.clone();\n    93\t    let events_for_index = events_proxy.clone();\n    94\t    let event_names = contract\n    95\t        .as_ref()\n    96\t        .map(|contract| {\n    97\t            contract\n    98\t                .events\n    99\t                .iter()\n   100\t                .map(|event| event.name.clone())\n   101\t                .collect::<Vec<_>>()\n   102\t        })\n   103\t        .unwrap_or_default();\n   104\t    let method_names = methods\n   105\t        .iter()\n   106\t        .map(|method| method.name.clone())\n   107\t        .collect::<HashSet<_>>();\n   108\t    let state_field_names = contract\n   109\t        .as_ref()\n   110\t        .map(|contract| {\n   111\t            contract\n   112\t                .state_fields\n   113\t                .iter()\n   114\t                .map(|field| field.name.clone())\n   115\t                .collect::<HashSet<_>>()\n   116\t        })\n   117\t        .unwrap_or_default();\n   118\t\n   119\t    let index_scope = scope.clone();\n   120\t    meta.set(\n   121\t        \"__index\",\n   122\t        lua.create_function(move |lua, (_table, key): (Table, String)| {\n   123\t            if key == \"state\" {\n   124\t                return Ok(LuaValue::Table(state_for_index.clone()));\n   125\t            }\n   126\t            if key == \"events\" {\n   127\t                return Ok(LuaValue::Table(events_for_index.clone()));\n   128\t            }\n   129\t            if event_names.iter().any(|name| name == &key)\n   130\t                && !method_names.contains(&key)\n   131\t                && !state_field_names.contains(&key)\n   132\t            {\n   133\t                return interface_event_channel(\n   134\t                    lua,\n   135\t                    &index_scope,\n   136\t                    &service_name,\n   137\t                    &key,\n   138\t                    Some(Arc::clone(&subscribed_interface_events)),\n   139\t                )\n   140\t                .map(LuaValue::Table);\n   141\t            }\n   142\t            // Case A: known contract method — dispatch as a service command.\n   143\t            if let Some(method) = methods.iter().find(|m| m.name == key) {\n   144\t                let required_capability = service_control_capability(&service_name);\n   145\t                let method = method.clone();\n   146\t                let iface = interface_name.clone();\n   147\t                let events = Arc::clone(&published_events);\n   148\t                let pending_side_channels = Arc::clone(&pending_side_channels);\n   149\t                let source_module_id = source_module_id.clone();\n   150\t                let source_capabilities = source_capabilities.clone();\n   151\t                return Ok(LuaValue::Function(lua.create_function(\n   152\t                    move |lua, args: mlua::Variadic<LuaValue>| {\n   153\t                        if !source_capabilities.is_granted(&required_capability) {\n   154\t                            return command_result_table(\n   155\t                                lua,\n   156\t                                false,\n   157\t                                false,\n   158\t                                Some(\"capability denied\"),\n   159\t                            )\n   160\t                            .map(LuaValue::Table);\n   161\t                        }\n   162\t                        let offset = consume_self_arg(&args);\n   163\t                        let payload = method\n   164\t                            .args\n   165\t                            .iter()\n   166\t                            .enumerate()\n   167\t                            .map(|(index, arg)| {\n   168\t                                let lua_value =\n   169\t                                    args.get(index + offset).cloned().unwrap_or(LuaValue::Nil);\n   170\t                                lua.from_value::<Value>(lua_value)\n   171\t                                    .map(|value| (arg.name.clone(), value))\n   172\t                            })\n   173\t                            .collect::<mlua::Result<serde_json::Map<String, Value>>>()?;\n   174\t                        pending_side_channels.store(true, Ordering::Release);\n   175\t                        events.lock().unwrap().push(PublishedEvent {\n   176\t                            channel: format!(\"{}.{}\", iface, method.name),\n   177\t                            payload: Value::Object(payload),\n   178\t                            source_module_id: source_module_id.clone(),\n   179\t                            source_capabilities: source_capabilities.clone(),\n   180\t                        });\n   181\t                        command_result_table(lua, true, true, None).map(LuaValue::Table)\n   182\t                    },\n   183\t                )?));\n   184\t            }\n   185\t\n   186\t            // Case B: state field read from the live service payload table.\n   187\t            record_tracked_field_once(\n   188\t                &tracked_service_fields,\n   189\t                &observed_state_fields,\n   190\t                &service_name,\n   191\t                &key,\n   192\t            );\n   193\t            service_payload_field(lua, &service_context_state, &service_name, &key)\n   194\t        })?,\n   195\t    )?;\n   196\t    meta.set(\n   197\t        \"__newindex\",\n   198\t        lua.create_function(|_, (_table, key, _value): (Table, String, LuaValue)| {\n   199\t            Err::<(), _>(mlua::Error::runtime(format!(\n   200\t                \"service state field '{key}' is read-only\"\n   201\t            )))\n   202\t        })?,\n   203\t    )?;\n   204\t    proxy.set_metatable(Some(meta))?;\n   205\t    Ok(proxy)\n   206\t}\n   207\t\n   208\tpub(super) fn create_events_proxy(\n   209\t    lua: &Lua,\n   210\t    scope: &Table,\n   211\t    service_name: &str,\n   212\t    event_names: Vec<String>,\n   213\t    subscribed_interface_events: Arc<Mutex<HashMap<String, HashMap<String, usize>>>>,\n   214\t) -> mlua::Result<Table> {\n   215\t    let events = lua.create_table()?;\n   216\t    for name in event_names {\n   217\t        events.set(\n   218\t            name.as_str(),\n   219\t            interface_event_channel(\n   220\t                lua,\n   221\t                scope,\n   222\t                service_name,\n   223\t                &name,\n   224\t                Some(Arc::clone(&subscribed_interface_events)),\n   225\t            )?,\n   226\t        )?;\n   227\t    }\n   228\t    Ok(events)\n   229\t}\n   230\t\n   231\t/// Resolve (or lazily create) the interface-event channel for `(service, event)`.\n   232\t///\n   233\t/// The channel registry lives on the per-instance `_ENV` table (`scope`), not on\n   234\t/// `lua.globals()`, so that components sharing a single thread VM keep\n   235\t/// independent channels and per-context subscription tracking.\n   236\tpub(super) fn interface_event_channel(\n   237\t    lua: &Lua,\n   238\t    scope: &Table,\n   239\t    service_name: &str,\n   240\t    event_name: &str,\n   340\t    lua: &Lua,\n   341\t    service_name: String,\n   342\t    service_context_state: Arc<Mutex<ServiceContextState>>,\n   343\t    tracked_service_fields: Arc<Mutex<HashMap<String, HashSet<String>>>>,\n   344\t    observed_state_fields: Arc<Mutex<HashSet<String>>>,\n   345\t) -> mlua::Result<Table> {\n   346\t    let state = lua.create_table()?;\n   347\t    let meta = lua.create_table()?;\n   348\t    meta.set(\n   349\t        \"__index\",\n   350\t        lua.create_function(move |lua, (_table, key): (Table, String)| {\n   351\t            record_tracked_field_once(\n   352\t                &tracked_service_fields,\n   353\t                &observed_state_fields,\n   354\t                &service_name,\n   355\t                &key,\n   356\t            );\n   357\t            service_payload_field(lua, &service_context_state, &service_name, &key)\n   358\t        })?,\n   359\t    )?;\n   360\t    meta.set(\n   361\t        \"__newindex\",\n   362\t        lua.create_function(|_, (_table, key, _value): (Table, String, LuaValue)| {\n   363\t            Err::<(), _>(mlua::Error::runtime(format!(\n   364\t                \"service state field '{key}' is read-only\"\n   365\t            )))\n   366\t        })?,\n   367\t    )?;\n   368\t    state.set_metatable(Some(meta))?;\n   369\t    Ok(state)\n   370\t}\n   371\t\n   372\tfn record_tracked_field_once(\n   373\t    tracked_service_fields: &Arc<Mutex<HashMap<String, HashSet<String>>>>,\n   374\t    observed_state_fields: &Arc<Mutex<HashSet<String>>>,\n   375\t    service_name: &str,\n   376\t    key: &str,\n   377\t) {\n   378\t    let mut observed = observed_state_fields.lock().unwrap();\n   379\t    if observed.contains(key) {\n   380\t        return;\n   381\t    }\n   382\t    observed.insert(key.to_string());\n   383\t    drop(observed);\n   384\t\n   385\t    tracked_service_fields\n   386\t        .lock()\n   387\t        .unwrap()\n   388\t        .entry(service_name.to_string())\n   389\t        .or_default()\n   390\t        .insert(key.to_string());\n   391\t}\n   392\t\n   393\tfn service_payload_field(\n   394\t    lua: &Lua,\n   395\t    service_context_state: &Arc<Mutex<ServiceContextState>>,\n   396\t    service_name: &str,\n   397\t    key: &str,\n   398\t) -> mlua::Result<LuaValue> {\n   399\t    let value = service_context_state\n   400\t        .lock()\n   401\t        .unwrap()\n   402\t        .field(service_name, key);\n   403\t    value\n   404\t        .map(|value| lua.to_value(&value))\n   405\t        .transpose()\n   406\t        .map(|value| value.unwrap_or(LuaValue::Nil))\n   407\t}\n   408\t\n   409\tfn command_result_table(\n   410\t    lua: &Lua,\n   411\t    ok: bool,\n   412\t    queued: bool,\n   413\t    error: Option<&str>,\n   414\t) -> mlua::Result<Table> {\n   415\t    let result = lua.create_table()?;\n   416\t    result.set(\"ok\", ok)?;\n   417\t    if ok {\n   418\t        result.set(\"queued\", queued)?;\n   419\t    }\n   420\t    if let Some(error) = error {\n   421\t        result.set(\"error\", error)?;\n   422\t    }\n   423\t    Ok(result)\n   424\t}\n   425\t\n   426\tfn consume_self_arg(args: &mlua::Variadic<LuaValue>) -> usize {\n   427\t    match args.get(0) {\n   428\t        Some(LuaValue::Table(_)) => 1,\n   429\t        _ => 0,\n   430\t    }\n   431\t}\n   432\t\n   433\tfn service_control_capability(service_name: &str) -> Capability {\n   434\t    Capability::new(format!(\"service.{service_name}.control\"))\n   435\t}\n   436\t\n   437\t#[cfg(test)]\n   438\tmod tests {\n   439\t    use super::*;\n   440\t\n   441\t    fn sinks() -> (\n   442\t        Arc<Mutex<HashMap<String, HashSet<String>>>>,\n   443\t        Arc<Mutex<HashSet<String>>>,\n   444\t    ) {\n   445\t        (\n   446\t            Arc::new(Mutex::new(HashMap::new())),\n   447\t            Arc::new(Mutex::new(HashSet::new())),\n   448\t        )\n   449\t    }\n   450\t\n   451\t    #[test]\n   452\t    fn repeated_tracked_field_reads_record_once() {\n   453\t        let (tracked, observed) = sinks();\n   454\t        record_tracked_field_once(&tracked, &observed, \"audio\", \"percent\");\n   455\t        record_tracked_field_once(&tracked, &observed, \"audio\", \"percent\");\n   456\t        record_tracked_field_once(&tracked, &observed, \"audio\", \"muted\");\n   457\t\n   458\t        let tracked = tracked.lock().unwrap();\n   459\t        let audio = tracked.get(\"audio\").expect(\"audio reads\");\n   460\t        assert_eq!(audio.len(), 2);\n   461\t        assert!(audio.contains(\"percent\"));\n   462\t        assert!(audio.contains(\"muted\"));\n   463\t    }\n   464\t\n   465\t    // cargo test -p mesh-core-scripting --release -- tracked_field_duplicate_read_gate_benchmark --ignored --nocapture\n   466\t    #[test]\n   467\t    #[ignore = \"release-only tracked service-field read microbenchmark\"]\n   468\t    fn tracked_field_duplicate_read_gate_benchmark() {\n   469\t        fn old_record(\n   470\t            tracked_service_fields: &Arc<Mutex<HashMap<String, HashSet<String>>>>,\n","exit_code":0,"status":"completed"}}
