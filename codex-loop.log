111\t        }\n   112\t        let root_changed = explicit_inventory\n   113\t            || updated_root.capability_approvals != previous_root.capability_approvals;\n   114\t        if root_changed {\n   115\t            if let Err(error) = updated_root.save(&graph_path) {\n   116\t                let _ = fs::remove_dir_all(&destination);\n   117\t                return Err(package_error(error.to_string()));\n   118\t            }\n   119\t        }\n   120\t\n   121\t        let graph = match load_installed_module_graph(&graph_path) {\n   122\t            Ok(graph) => graph,\n   123\t            Err(error) => {\n   124\t                let _ = fs::remove_dir_all(&destination);\n   125\t                if root_changed {\n   126\t                    let _ = previous_root.save(&graph_path);\n   127\t                }\n   128\t                return Err(package_error(error.to_string()));\n   129\t            }\n   130\t        };\n   131\t        let installed = graph.module(&manifest.name).ok_or_else(|| {\n   132\t            package_error(format!(\n   133\t                \"installed module {} was not discovered\",\n   134\t                manifest.name\n   135\t            ))\n   136\t        })?;\n   137\t        if installed.kind != manifest.mesh.kind {\n   138\t            let _ = fs::remove_dir_all(&destination);\n   139\t            if root_changed {\n   140\t                let _ = previous_root.save(&graph_path);\n   141\t            }\n   142\t            return Err(package_error(format!(\n   143\t                \"installed module {} changed kind while being copied\",\n   144\t                manifest.name\n   145\t            )));\n   146\t        }\n   147\t\n   148\t        let installed_manifests = graph\n   149\t            .modules()\n   150\t            .into_iter()\n   151\t            .map(|module| module.manifest.clone())\n   152\t            .collect::<Vec<_>>();\n   153\t        record_lock_entry(\n   154\t            config_dir,\n   155\t    