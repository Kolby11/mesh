   287\t\n   288\t    /// Resolve the modules needed by this profile. Roots are explicit; declared\n   289\t    /// module/resource dependencies and sole interface providers are inferred.\n   290\t    pub fn active_module_ids<'a>(\n   291\t        &self,\n   292\t        manifests: impl IntoIterator<Item = &'a ModuleManifest>,\n   293\t    ) -> Result<HashSet<String>, ModuleManifestError> {\n   294\t        let manifest_list = manifests.into_iter().collect::<Vec<_>>();\n   295\t        let manifests = manifest_list\n   296\t            .iter()\n   297\t            .copied()\n   298\t            .map(|manifest| (manifest.name.as_str(), manifest))\n   299\t            .collect::<HashMap<_, _>>();\n   300\t        let mut active = HashSet::new();\n   301\t        let mut queue = VecDeque::new();\n   302\t\n   303\t        // A composition module contributes a dependency node as well as the\n   304\t        // roots and resources that its profile declares. Resolve the same\n   305\t        // effective spec used by graph loading so the activation set contains\n   306\t        // the complete composition closure, including `extends` ancestors.\n   307\t        let profile_spec = self.as_composition_spec();\n   308\t        let effective = if self.from.is_some() {\n   309\t            Some(super::resolve_composition(\n   310\t                self,\n   311\t                manifest_list.iter().copied(),\n   312\t            )?)\n   313\t        } else {\n   314\t            None\n   315\t        };\n   316\t        let activation_spec = effective\n   317\t            .as_ref()\n   318\t            .map(|resolved| &resolved.spec)\n   319\t            .unwrap_or(&profile_spec);\n   320\t        for language_pack in &activation_spec.resources.languages {\n   321\t            let manifest = manifests.get(language_pack.as_str()).ok_or_else(|| {\n   322\t                ModuleManifestError::Validation(format!(\n   323\t                    \"profile references language pack {language_pack}, but it is not installed\"\n   324\t                ))\n   325\t            })?;\n   326\t            if manifest.mesh.kind != ModuleKind::LanguagePack {\n   327\t                return Err(ModuleManifestError::Validation(format!(\n   328\t                    \"profile resource {language_pack} is {:?}; resources.languages requires a language-pack module\",\n   329\t                    manifest.mesh.kind\n   330\t                )));\n   331\t            }\n   332\t        }\n   333\t        let orphaned = effective\n   334\t            .as_ref()\n   335\t            .map(|resolved| resolved.orphaned_overrides.as_slice())\n   336\t            .unwrap_or(&[]);\n   337\t        let is_active_host = |instance_id: &str| {\n   338\t            activation_spec\n   339\t                .roots\n   340\t                .get(instance_id)\n   341\t                .is_some_and(|instance| instance.active)\n   342\t                && !orphaned.iter().any(|orphan| {\n   343\t                    orphan == instance_id || orphan == &format!(\"nodeSlots.{instance_id}\")\n   344\t                })\n   345\t        };\n   346\t\n   347\t        for (instance_id, instance) in &activation_spec.roots {\n   348\t            if !instance.active || !is_active_host(instance_id) {\n   349\t                continue;\n   350\t            }\n   351\t            queue.push_back(instance.module.clone());\n   352\t        }\n   353\t        queue.extend(activation_spec.background_services.iter().cloned());\n   354\t        queue.extend(activation_spec.providers.values().cloned());\n   355\t        if let Some(theme) = &activation_spec.resources.theme {\n   356\t            queue.push_back(theme.clone());\n   357\t        }\n   358\t        queue.extend(activation_spec.resources.icons.iter().cloned());\n   359\t        queue.extend(activation_spec.resources.fonts.iter().cloned());\n   360\t        queue.extend(activation_spec.resources.languages.iter().cloned());\n   361\t        for (instance_id, slots) in &activation_spec.node_slots {\n   362\t            if !is_active_host(instance_id) {\n   363\t                continue;\n   364\t            }\n   365\t            for slot in slots.values() {\n   366\t                for node in &slot.nodes {\n   367\t                    if let Some((module_id, _)) = node.contribution.rsplit_once(':') {\n   368\t                        queue.push_back(module_id.to_string());\n   369\t                    }\n   370\t                }\n   371\t            }\n   372\t        }\n   373\t\n   374\t        if let Some(from) = &self.from {\n   375\t            let compositions = manifest_list\n   376\t                .iter()\n   377\t                .copied()\n   378\t                .filter(|manifest| manifest.mesh.kind == ModuleKind::Composition)\n   379\t                .map(|manifest| (manifest.name.as_str(), manifest))\n   380\t                .collect::<HashMap<_, _>>();\n   381\t            for composition_id in super::composition_chain(&from.module, &compositions)? {\n   382\t                queue.push_back(composition_id);\n   383\t            }\n   384\t        }\n   385\t\n   386\t        while let Some(module_id) = queue.pop_front() {\n   387\t            if !active.insert(module_id.clone()) {\n   388\t                continue;\n   389\t            }\n   390\t            let manifest = manifests.get(module_id.as_str()).ok_or_else(|| {\n   391\t                ModuleManifestError::Validation(format!(\n   392\t                    \"active profile references module {module_id}, but it is not installed\"\n   393\t                ))\n   394\t            })?;\n   395\t\n   396\t            queue.extend(\n   397\t                manifest\n   398\t                    .mesh\n   399\t                    .dependencies\n   400\t                    .modules\n   401\t                    .iter()\n   402\t                    .filter(|(_, dependency)| !dependency.is_optional())\n   403\t                    .map(|(module_id, _)| module_id.clone()),\n   404\t            );\n   405\t            queue.extend(manifest.mesh.uses.resources.icons.iter().cloned());\n   406\t            queue.extend(manifest.mesh.uses.resources.fonts.iter().cloned());\n   407\t            queue.extend(manifest.mesh.uses.resources.i18n.iter().cloned());\n   408\t            queue.extend(manifest.mesh.uses.resources.themes.iter().cloned());\n   409\t\n   410\t            for interface in manifest.mesh.uses.interfaces.keys() {\n   411\t                for candidate in manifests.values().filter(|candidate| {\n   412\t                    candidate.mesh.kind == ModuleKind::Interface\n   413\t                        && candidate\n   414\t                            .mesh\n   415\t                            .interface\n   416\t                            .as_ref()\n   417\t                            .is_some_and(|declaration| declaration.name == *interface)\n   418\t                }) {\n   419\t                    queue.push_back(candidate.name.clone());\n   420\t                }\n   421\t\n   422\t                if let Some(provider) = self.providers.get(interface) {\n   423\t                    queue.push_back(provider.clone());\n   424\t                    continue;\n   425\t                }\n   426\t                let providers = manifests\n   427\t                    .values()\n   428\t                    .filter(|candidate| {\n   429\t                        candidate.mesh.kind == ModuleKind::Backend\n   430\t                            && candidate\n   431\t                                .mesh\n   432\t                                .implementations()\n   433\t                                .any(|implementation| implementation.interface == *interface)\n   434\t                    })\n   435\t                    .collect::<Vec<_>>();\n   436\t                if providers.len() == 1 {\n   437\t                    queue.push_back(providers[0].name.clone());\n   438\t                }\n   439\t            }\n   440\t\n   441\t            if manifest.mesh.kind == ModuleKind::Backend {\n   442\t                for implementation in manifest.mesh.implementations() {\n   443\t                    if let Some(base_module) = &implementation.base_module {\n   444\t                        queue.push_back(base_module.clone());\n   445\t                    }\n   446\t                }\n   447\t            }\n   448\t        }\n   449\t        Ok(active)\n   450\t    }\n   451\t\n   452\t    pub fn apply_to_root(\n   453\t        &self,\n   454\t        root: &mut RootModuleGraphManifest,\n   455\t        manifests: &[ModuleManifest],\n   456\t    ) -> Result<(), ModuleManifestError> {\n   457\t        self.validate()?;\n   458\t        let active = self.active_module_ids(manifests)?;\n   459\t        for (module_id, entry) in &mut root.modules {\n   460\t            entry.enabled = active.contains(module_id);\n   498\t#[derive(Debug, Clone)]\n   499\tpub struct ProfilePaths {\n   500\t    config_dir: PathBuf,\n   501\t}\n   502\t\n   503\timpl ProfilePaths {\n   504\t    pub fn from_root_graph(root_graph_path: &Path) -> Result<Self, ModuleManifestError> {\n   505\t        let config_dir = root_graph_path.parent().ok_or_else(|| {\n   506\t            ModuleManifestError::Validation(format!(\n   507\t                \"root module graph has no parent directory: {}\",\n   508\t                root_graph_path.display()\n   509\t            ))\n   510\t        })?;\n   511\t        Ok(Self {\n   512\t            config_dir: config_dir.to_path_buf(),\n   513\t        })\n   514\t    }\n   515\t\n   516\t    pub fn profiles_dir(&self) -> PathBuf {\n   517\t        self.config_dir.join(\"profiles\")\n   518\t    }\n   519\t\n   520\t    pub fn active_profile_path(&self) -> PathBuf {\n   521\t        self.config_dir.join(\"active-profile\")\n   522\t    }\n   523\t\n   524\t    pub fn profile_path(&self, profile_id: &str) -> Result<PathBuf, ModuleManifestError> {\n   525\t        validate_profile_id(profile_id)?;\n   526\t        Ok(self.profiles_dir().join(format!(\"{profile_id}.json\")))\n   527\t    }\n   528\t\n   529\t    pub fn active_profile_id(&self) -> Result<Option<String>, ModuleManifestError> {\n   530\t        let path = self.active_profile_path();\n   531\t        if !path.exists() {\n   532\t            return Ok(None);\n   533\t        }\n   534\t        super::validate_regular_file(&path, \"active profile pointer\")?;\n   535\t        let profile_id =\n   536\t            fs::read_to_string(&path).map_err(|source| ModuleManifestError::Io { path, source })?;\n   537\t        let profile_id = profile_id.trim();\n   538\t        validate_profile_id(profile_id)?;\n   539\t        Ok(Some(profile_id.to_string()))\n   540\t    }\n   541\t\n   542\t    pub fn load(&self, profile_id: &str) -> Result<ShellProfile, ModuleManifestError> {\n   543\t        ShellProfile::from_path(&self.profile_path(profile_id)?)\n   544\t    }\n   545\t\n   546\t    pub fn load_or_default(&self, profile_id: &str) -> Result<ShellProfile, ModuleManifestError> {\n   547\t        let path = self.profile_path(profile_id)?;\n   548\t        if fs::symlink_metadata(&path)\n   549\t            .map(|metadata| metadata.file_type().is_symlink())\n   550\t            .unwrap_or(false)\n   551\t        {\n   552\t            return Err(ModuleManifestError::Validation(format!(\n   553\t                \"shell profile {} must not be a symlink\",\n   554\t                path.display()\n   555\t            )));\n   556\t        }\n   557\t        if path.exists() {\n   558\t            ShellProfile::from_path(&path)\n   559\t        } else {\n   560\t            Ok(ShellProfile::new())\n   561\t        }\n   562\t    }\n   563\t\n   564\t    pub fn load_active(&self) -> Result<Option<(String, ShellProfile)>, ModuleManifestError> {\n   565\t        let Some(profile_id) = self.active_profile_id()? else {\n   566\t            return Ok(None);\n   567\t        };\n   568\t        let profile = self.load(&profile_id)?;\n   569\t        Ok(Some((profile_id, profile)))\n   570\t    }\n   571\t\n   572\t    pub fn save(\n   573\t        &self,\n   574\t        profile_id: &str,\n   575\t        profile: &ShellProfile,\n   576\t    ) -> Result<(), ModuleManifestError> {\n   577\t        profile.validate()?;\n   578\t        let path = self.profile_path(profile_id)?;\n   579\t        let mut content =\n   580\t            serde_json::to_string_pretty(profile).map_err(|source| ModuleManifestError::Json {\n   581\t                path: path.clone(),\n   582\t                source,\n   583\t            })?;\n   584\t        content.push('\\n');\n   585\t        atomic_write(&path, content.as_bytes())\n   586\t    }\n   587\t\n   588\t    pub fn set_active(&self, profile_id: &str) -> Result<(), ModuleManifestError> {\n   589\t        let profile_path = self.profile_path(profile_id)?;\n   590\t        if !profile_path.exists() {\n   591\t            return Err(ModuleManifestError::Validation(format!(\n   592\t                \"profile {profile_id} does not exist at {}\",\n   593\t                profile_path.display()\n   594\t            )));\n   595\t        }\n   596\t        atomic_write(\n   597\t            &self.active_profile_path(),\n   598\t            format!(\"{profile_id}\\n\").as_bytes(),\n   599\t        )\n   600\t    }\n   601\t\n   602\t    pub fn list(&self) -> Result<Vec<String>, ModuleManifestError> {\n   603\t        let directory = self.profiles_dir();\n   604\t        if !directory.exists() {\n   605\t            return Ok(Vec::new());\n   606\t        }\n   607\t        if fs::symlink_metadata(&directory)\n   608\t            .map(|metadata| metadata.file_type().is_symlink())\n   609\t            .unwrap_or(false)\n   610\t        {\n   611\t            return Err(ModuleManifestError::Validation(format!(\n   612\t                \"profiles directory {} must not be a symlink\",\n   613\t                directory.display()\n   614\t            )));\n   615\t        }\n   616\t        let mut ids = fs::read_dir(&directory)\n   617\t            .map_err(|source| ModuleManifestError::Io {\n   618\t                path: directory.clone(),\n   619\t                source,\n   620\t            })?\n   621\t            .filter_map(Result::ok)\n   622\t            .filter_map(|entry| {\n   623\t                let path = entry.path();\n   624\t                (path.extension().and_then(|value| value.to_str()) == Some(\"json\"))\n   625\t                    .then(|| path.file_stem()?.to_str().map(str::to_string))\n   626\t                    .flatten()\n   627\t            })\n   628\t            .collect::<Vec<_>>();\n   629\t        ids.sort();\n   630\t        Ok(ids)\n","exit_code":0,"status":"completed"}}
