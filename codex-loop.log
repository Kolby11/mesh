default\n\nerror[E0425]: cannot find type `ThemeModeMetadata` in module `manifest`\n   --> crates/core/extension/module/src/package/installed_graph/contributions.rs:354:50\n    |\n354 |     pub mode_metadata: HashMap<String, manifest::ThemeModeMetadata>,\n    |                                                  ^^^^^^^^^^^^^^^^^ not found in `manifest`\n    |\nhelp: consider importing this struct through its public re-export\n    |\n  1 + use crate::package::ThemeModeMetadata;\n    |\nhelp: if you import `ThemeModeMetadata`, refer to it directly\n    |\n354 -     pub mode_metadata: HashMap<String, manifest::ThemeModeMetadata>,\n354 +     pub mode_metadata: HashMap<String, ThemeModeMetadata>,\n    |\n\nwarning: method `fingerprint` is never used\n  --> crates/core/runtime/scripting/src/context/state.rs:63:12\n   |\n27 | impl ServiceContextState {\n   | ------------------------ method in this implementation\n...\n63 |     pub fn fingerprint(&self, service: &str) -> Option<u64> {\n   |            ^^^^^^^^^^^\n   |\n   = note: `#[warn(dead_code)]` (part of `#[warn(unused)]`) on by default\n\nwarning: `mesh-core-scripting` (lib) generated 2 warnings (run `cargo fix --lib -p mesh-core-scripting` to apply 1 suggestion)\n    Checking mesh-core-backend v0.1.0 (/home/kolby/projects/mesh/crates/core/runtime/backend)\n    Checking mesh-core-frontend-host v0.1.0 (/home/kolby/projects/mesh/crates/core/frontend/host)\nerror[E0063]: missing field `revision` in initializer of `profile::ShellProfile`\n   --> crates/core/extension/module/src/package/composition.rs:151:9\n    |\n151 |         ShellProfile {\n    |         ^^^^^^^^^^^^ missing `revision`\n\nerror[E0282]: type annotations needed\n   --> crates/core/extension/module/src/package/content_store.rs:269:13\n    |\n269 |         let snapshot =\n    |             ^^^^^^^^\n...\n274 |         snapshot.validate()?;\n    |         -------- type must be known at this point\n    |\nhelp: consider giving `snapshot` an explicit type\n   