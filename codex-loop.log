\t            return Ok(false);\n   472\t        }\n   473\t        self.selection = next;\n   474\t        Ok(true)\n   475\t    }\n   476\t\n   477\t    pub fn current(&self) -> &str {\n   478\t        self.selection.active()\n   479\t    }\n   480\t\n   481\t    pub fn set_locale(&mut self, locale: impl Into<String>) {\n   482\t        if let Err(error) = self.try_set_locale(locale.into()) {\n   483\t            tracing::warn!(%error, \"ignoring invalid locale selection\");\n   484\t        }\n   485\t    }\n   486\t\n   487\t    /// Load a catalog owned by the explicit core domain.\n   488\t    pub fn load_core_translations(&mut self, set: TranslationSet) {\n   489\t        let locale = catalog_locale(&set.locale);\n   490\t        let catalogs = Arc::make_mut(&mut self.catalogs);\n   491\t        catalogs.core.entry(locale).or_default().extend(\n   492\t            set.messages\n   493\t                .into_iter()\n   494\t                .map(|(key, value)| (key, CatalogEntry::Text(value))),\n   495\t        );\n   496\t        catalogs.revision = catalogs.revision.saturating_add(1);\n   497\t    }\n   498\t\n   499\t    pub fn load_core_catalog(&mut self, catalog: CompiledCatalog) {\n   500\t        let locale = catalog_locale(&catalog.locale);\n   501\t        let catalogs = Arc::make_mut(&mut self.catalogs);\n   502\t        catalogs\n   503\t            .core\n   504\t            .entry(locale)\n   505\t            .or_default()\n   506\t            .extend(catalog.messages);\n   507\t        catalogs.revision = catalogs.revision.saturating_add(1);\n   508\t    }\n   509\t\n   510\t    pub fn module_translator(&self, module_id: &str) -> ModuleTranslator<'_> {\n   511\t        ModuleTranslator {\n   512\t            engine: self,\n   513\t            module_id: module_id.to_string(),\n   514\t        }\n   515\t    }\n   516\t\n   517\t    pub fn core_translator(&self) -> CoreTranslator<'_> {\n   518\t        CoreTranslator { engine: self }\n   519\t    }\n   520\t\n   521\t    /// Load a catalog owned by one module. It is never copied into the core\n   522\t    /// domain, so one module cannot shadow another module's keys.\n   523\t    pub fn load_module_translations(&mut self, module_id: &str, set: TranslationSet) {\n   524\t        let locale = catalog_locale(&set.locale);\n   525\t        let catalogs = Arc::make_mut(&mut self.catalogs);\n   526\t        catalogs\n   527\t            .modules\n   528\t            .entry(module_id.to_string())\n   529\t            .or_default()\n   530\t            .entry(locale)\n   531\t            .or_default()\n   532\t            .extend(\n   533\t                set.messages\n   534\t                    .into_iter()\n   535\t                    .map(|(key, value)| (key, CatalogEntry::Text(value))),\n   536\t            );\n   537\t        catalogs.revision = catalogs.revision.saturating_add(1);\n   538\t    }\n   539\t\n   540\t    pub fn load_module_catalog(&mut self, module_id: &str, catalog: CompiledCatalog) {\n   541\t        let locale = catalog_locale(&catalog.locale);\n   542\t        let catalogs = Arc::make_mut(&mut self.catalogs);\n   543\t        catalogs\n   544\t            .modules\n   545\t            .entry(module_id.to_string())\n   546\t            .or_default()\n   547\t            .entry(locale)\n   548\t            .or_default()\n   549\t            .extend(catalog.messages);\n   550\t        catalogs.revision = catalogs.revision.saturating_add(1);\n   551\t    }\n   552\t\n   553\t    fn translate_in_core(&self, key: &str) -> Option<&CatalogEntry> {\n   554\t        for locale in self.selection.chain() {\n   555\t            if let Some(messages) = self.catalogs.core.get(locale) {\n   556\t                if let Some(value) = messages.get(key) {\n   557\t                    return Some(value);\n   558\t                }\n   559\t            }\n   560\t        }\n   561\t        None\n   562\t    }\n   563\t\n   564\t    fn translate_in_module(&self, key: &str, module_id: &str) -> Option<&CatalogEntry> {\n   565\t        if let Some(module_locales) = self.catalogs.modules.get(module_id) {\n   566\t            for locale in self.selection.chain() {\n   567\t                if let Some(messages) = module_locales.get(locale) {\n   568\t                    if let Some(value) = messages.get(key) {\n   569\t                        return Some(value);\n   570\t                    }\n   571\t                }\n   572\t            }\n   573\t        }\n   574\t        None\n   575\t    }\n   576\t\n   577\t    fn resolve_in_core<'a>(&'a self, key: &str, args: &HashMap<String, String>) -> Option<&'a str> {\n   578\t        for locale in self.selection.chain() {\n   579\t            if let Some(entry) = self.catalogs.core.get(locale).and_then(|m| m.get(key)) {\n   580\t                return entry.resolve(args, self.current());\n   581\t            }\n   582\t        }\n   583\t        None\n   584\t    }\n   585\t\n   586\t    fn resolve_in_module<'a>(\n   587\t        &'a self,\n   588\t        key: &str,\n   589\t        module_id: &str,\n   590\t        args: &HashMap<String, String>,\n   591\t    ) -> Option<&'a str> {\n   592\t        if let Some(module_locales) = self.catalogs.modules.get(module_id) {\n   593\t            for locale in self.selection.chain() {\n   594\t                if let Some(entry) = module_locales.get(locale).and_then(|m| m.get(key)) {\n   595\t                    return entry.resolve(args, self.current());\n   596\t                }\n   597\t            }\n   598\t        }\n   599\t        None\n   600\t    }\n   601\t\n   602\t    fn effective_core_translations(&self) -> HashMap<String, String> {\n   603\t        let mut messages = HashMap::new();\n   604\t        for locale in self.selection.chain().iter().rev() {\n   605\t            if let Some(catalog) = self.catalogs.core.get(locale) {\n   606\t                messages.extend(catalog.iter().filter_map(|(key, entry)| {\n   607\t                    entry\n   608\t                        .default_text()\n   609\t                        .map(|value| (key.clone(), value.to_string()))\n   610\t                }));\n   611\t            }\n   612\t        }\n   613\t        messages\n   614\t    }\n   615\t\n   616\t    fn effective_module_translations(&self, module_id: &str) -> HashMap<String, String> {\n   617\t        let mut messages = HashMap::new();\n   618\t        if let Some(module_locales) = self.catalogs.modules.get(module_id) {\n   619\t            for locale in self.selection.chain().iter().rev() {\n   620\t                if let Some(catalog) = module_locales.get(locale) {\n   621\t                    messages.extend(catalog.iter().filter_map(|(key, entry)| {\n   622\t                        entry\n   623\t                            .default_text()\n   624\t                            .map(|value| (key.clone(), value.to_string()))\n   625\t                    }));\n   626\t                }\n   627\t            }\n   628\t        }\n   629\t        messages\n   630\t    }\n   631\t\n   632\t    fn effective_module_entries(&self, module_id: &str) -> HashMap<String, CatalogEntry> {\n   633\t        let mut messages = HashMap::new();\n   634\t        if let Some(module_locales) = self.catalogs.modules.get(module_id) {\n   635\t            for locale in self.selection.chain().iter().rev() {\n   636\t                if let Some(catalog) = module_locales.get(locale) {\n   637\t                    messages.extend(catalog.clone());\n   638\t                }\n   639\t            }\n   640\t        }\n   641\t        messages\n   642\t    }\n   643\t\n   644\t    pub fn fallback_chain(&self) -> &[String] {\n   645\t        self.selection.chain()\n   646\t    }\n   647\t}\n   648\t\n   649\tfn catalog_locale(locale: &str) -> String {\n   650\t    canonicalize_locale_tag(locale).unwrap_or_else(|_| locale.trim().to_string())\n   651\t}\n   652\t\n   653\tfn canonicalize_locale_tag(raw: &str) -> Result<String, LocaleError> {\n   654\t    let raw = raw.trim();\n   655\t    if raw.is_empty() {\n   656\t        return Err(LocaleError::EmptyTag);\n   657\t    }\n   658\t    let parts = raw.split('-').collect::<Vec<_>>();\n   659\t    if parts.iter().any(|part| part.is_empty()) {\n   660\t        return Err(LocaleError::InvalidTag {\n   661\t            tag: raw.to_string(),\n   662\t        });\n   663\t    }\n   664\t\n   665\t    let language = parts[0];\n   666\t    if !(2..=8).contains(&language.len()) || !language.chars().all(|ch| ch.is_ascii_alphabetic()) {\n   667\t        return Err(LocaleError::InvalidTag {\n   668\t            tag: raw.to_string(),\n   669\t        });\n   670\t    }\n   671\t    let mut normalized = vec![language.to_ascii_lowercase()];\n   672\t    let mut index = 1;\n   673\t\n   674\t    if parts\n   675\t        .get(index)\n   676\t        .is_some_and(|part| part.len() == 4 && part.chars().all(|ch| ch.is_ascii_alphabetic()))\n   677\t    {\n   678\t        let script = parts[index];\n   679\t        let mut chars = script.chars();\n   680\t        let first = chars.next().expect(\"script is nonempty\");\n   681\t        normalized.push(format!(\n   682\t            \"{}{}\",\n   683\t            first.to_ascii_uppercase(),\n   684\t            chars.as_str().to_ascii_lowercase()\n   685\t        ));\n   686\t        index += 1;\n   687\t    }\n   688\t\n   689\t    if parts.get(index).is_some_and(|part| {\n   690\t        (part.len() == 2 && part.chars().all(|ch| ch.is_ascii_alphabetic()))\n   691\t            || (part.len() == 3 && part.chars().all(|ch| ch.is_ascii_digit()))\n   692\t    }) {\n   693\t        normalized.push(if parts[index].chars().all(|ch| ch.is_ascii_digit()) {\n   694\t            parts[index].to_string()\n   695\t        } else {\n   696\t            parts[index].to_ascii_uppercase()\n   697\t        });\n   698\t        index += 1;\n   699\t    }\n   700\t\n   701\t    while index < parts.len() {\n   702\t        let part = parts[index];\n   703\t        if part.len() == 1 {\n   704\t            if !part.chars().all(|ch| ch.is_ascii_alphanumeric()) {\n   705\t                return Err(LocaleError::InvalidTag {\n   706\t                    tag: raw.to_string(),\n   707\t                });\n   708\t            }\n   709\t            normalized.push(part.to_ascii_lowercase());\n   710\t            index += 1;\n   711\t            let extension_start = index;\n   712\t            while index < parts.len() && parts[index].len() != 1 {\n   713\t                let extension = parts[index];\n   714\t                if !(2..=8).contains(&extension.len())\n   715\t                    || !extension.chars().all(|ch| ch.is_ascii_alphanumeric())\n   716\t                {\n   717\t                    return Err(LocaleError::InvalidTag {\n   718\t                        tag: raw.to_string(),\n   719\t                    });\n   720\t                }\n   721\t                normalized.push(extension.to_ascii_lowercase());\n   722\t                index += 1;\n   723\t            }\n   724\t            if index == extension_start {\n   725\t                return Err(LocaleError::InvalidTag {\n   726\t                    tag: raw.to_string(),\n   727\t                });\n   728\t            }\n   729\t            continue;\n   730\t        }\n   731\t\n   732\t        let is_variant = (5..=8).contains(&part.len())\n   733\t            && part.chars().all(|ch| ch.is_ascii_alphanumeric())\n   734\t            || (part.len() == 4\n   735\t                && part.chars().next().is_some_and(|ch| ch.is_ascii_digit())\n   736\t                && part.chars().all(|ch| ch.is_ascii_alphanumeric()));\n   737\t        if !is_variant {\n   738\t            return Err(LocaleError::InvalidTag {\n   739\t                tag: raw.to_string(),\n   740\t            });\n   741\t        }\n   742\t        normalized.push(part.to_ascii_lowercase());\n   743\t        index += 1;\n   744\t    }\n   745\t\n   746\t    Ok(normalized.join(\"-\"))\n   747\t}\n   748\t\n   749\tfn locale_parents(locale: &str) -> Vec<String> {\n   750\t    let mut parts = locale.split('-').collect::<Vec<_>>();\n   751\t    if let Some(extension_index) = parts.iter().position(|part| part.len() == 1) {\n   752\t        parts.truncate(extension_index);\n   753\t    }\n   754\t    let mut parents = Vec::new();\n   755\t    while parts.len() > 1 {\n   756\t        parts.pop();\n   757\t        parents.push(parts.join(\"-\"));\n   758\t    }\n   759\t    parents\n   760\t}\n   760\t}\n   761\t\n   762\tfn complete_fallback_chain(active: &str, fallback: &str) -> Vec<String> {\n   763\t    let mut chain = Vec::new();\n   764\t    let mut append = |locale: &str| {\n   765\t        if !chain.iter().any(|existing| existing == locale) {\n   766\t            chain.push(locale.to_string());\n   767\t        }\n   768\t    };\n   769\t    append(active);\n   770\t    for parent in locale_parents(active) {\n   771\t        append(&parent);\n   772\t    }\n   773\t    append(fallback);\n   774\t    for parent in locale_parents(fallback) {\n   775\t        append(&parent);\n   776\t    }\n   777\t    append(\"en\");\n   778\t    chain\n   779\t}\n   780\t\n   781\tfn direction_for(locale: &str) -> LocaleDirection {\n   782\t    let language = locale.split('-').next().unwrap_or_default();\n   783\t    let script = locale\n   784\t        .split('-')\n   785\t        .find(|part| part.len() == 4)\n   786\t        .unwrap_or_default();\n   787\t    if matches!(\n   788\t        language,\n   789\t        \"ar\" | \"dv\" | \"fa\" | \"he\" | \"ku\" | \"ps\" | \"sd\" | \"ug\" | \"ur\" | \"yi\"\n   790\t    ) || matches!(script, \"Arab\" | \"Hebr\" | \"Nkoo\" | \"Rohg\" | \"Syrc\" | \"Thaa\")\n   791\t    {\n   792\t        LocaleDirection::Rtl\n   793\t    } else {\n   794\t        LocaleDirection::Ltr\n   795\t    }\n   796\t}\n   797\t\n   798\t/// Interpolates `{name}` placeholders in one walk, so cost is O(template_len)\n   799\t/// regardless of how many args are supplied.\n   800\tfn interpolate(template: &str, args: &HashMap<String, String>) -> Option<String> {\n   801\t    let mut result = String::with_capacity(template.len());\n   802\t    let mut remaining = template;\n   803\t    while let Some(open) = remaining.find('{') {\n   804\t        result.push_str(&remaining[..open]);\n   805\t        let after_open = &remaining[open + 1..];\n   806\t        if let Some(close) = after_open.find('}') {\n   807\t            let name = &after_open[..close];\n   808\t            match args.get(name) {\n   809\t                Some(value) => result.push_str(value),\n   810\t                None => {\n   811\t                    result.push('{');\n   812\t                    result.push_str(name);\n   813\t                    result.push('}');\n   814\t                }\n   815\t            }\n   816\t            remaining = &after_open[close + 1..];\n   817\t        } else {\n   818\t            result.push_str(&remaining[open..]);\n   819\t            return Some(result);\n   820\t        }\n   821\t    }\n   822\t    result.push_str(remaining);\n   823\t    Some(result)\n   824\t}\n   825\t\n   826\t#[cfg(test)]\n   827\tmod tests {\n   828\t    use super::*;\n   829\t\n   830\t    #[test]\n   831\t    fn basic_translation() {\n   832\t        let mut engine = LocaleEngine::new(\"en\");\n   833\t        engine.load_core_translations(TranslationSet {\n   834\t            locale: \"en\".to_string(),\n   835\t            messages: HashMap::from([\n   836\t                (\"greeting\".to_string(), \"Hello, {name}!\".to_string()),\n   837\t                (\"bye\".to_string(), \"Goodbye\".to_string()),\n   838\t            ]),\n   839\t        });\n   840\t\n   841\t        assert_eq!(engine.core_translator().translate(\"bye\"), Some(\"Goodbye\"));\n   842\t\n   843\t        let args = HashMap::from([(\"name\".to_string(), \"World\".to_string())]);\n   844\t        assert_eq!(\n   845\t            engine.core_translator().translate_with(\"greeting\", &args),\n   846\t            Some(\"Hello, World!\".to_string())\n   847\t        );\n   848\t    }\n   849\t\n   850\t    #[test]\n   851\t    fn fallback_chain() {\n   852\t        let mut engine = LocaleEngine::new(\"fr\");\n   853\t        engine.load_core_translations(TranslationSet {\n   854\t            locale: \"en\".to_string(),\n   855\t            messages: HashMap::from([(\"ok\".to_string(), \"OK\".to_string())]),\n   856\t        });\n   857\t\n   858\t        assert_eq!(engine.core_translator().translate(\"ok\"), Some(\"OK\"));\n   859\t    }\n   860\t\n   861\t    #[test]\n   862\t    fn effective_module_catalog_matches_scoped_lookup_precedence() {\n   863\t        let mut engine = LocaleEngine::with_fallback_locale(\"sk\", \"en\");\n   864\t        engine.load_core_translations(TranslationSet {\n   865\t            locale: \"sk\".to_string(),\n   866\t            messages: HashMap::from([\n   867\t                (\"shared\".to_string(), \"global-sk\".to_string()),\n   868\t                (\"global\".to_string(), \"iba-global\".to_string()),\n   869\t            ]),\n   870\t        });\n   871\t        engine.load_core_translations(TranslationSet {\n   872\t            locale: \"en\".to_string(),\n   873\t            messages: HashMap::from([(\"shared\".to_string(), \"global-en\".to_string())]),\n   874\t        });\n   875\t        engine.load_module_translations(\n   876\t            \"@mesh/example\",\n   877\t            TranslationSet {\n   878\t                locale: \"en\".to_string(),\n   879\t                messages: HashMap::from([(\"shared\".to_string(), \"module-en\".to_string())]),\n   880\t            },\n   881\t        );\n   882\t\n   883\t        let translator = engine.module_translator(\"@mesh/example\");\n   884\t        assert_eq!(translator.translate(\"shared\"), Some(\"module-en\"));\n   885\t        assert_eq!(translator.translate(\"global\"), None);\n   886\t    }\n   887\t\n   888\t    #[test]\n   889\t    fn module_catalogs_never_leak_into_other_module_or_core_lookup() {\n   890\t        let mut engine = LocaleEngine::new(\"en\");\n   891\t        engine.load_module_translations(\n   892\t            \"@mesh/one\",\n   893\t            TranslationSet {\n   894\t                locale: \"en\".into(),\n   895\t                messages: HashMap::from([(String::from(\"shared\"), String::from(\"one\"))]),\n   896\t            },\n   897\t        );\n   898\t        engine.load_module_translations(\n   899\t            \"@mesh/two\",\n   900\t            TranslationSet {\n   901\t                locale: \"en\".into(),\n   902\t                messages: HashMap::from([(String::from(\"shared\"), String::from(\"two\"))]),\n   903\t            },\n   904\t        );\n   905\t\n   906\t        assert_eq!(\n   907\t            engine.module_translator(\"@mesh/one\").translate(\"shared\"),\n   908\t            Some(\"one\")\n   909\t        );\n   910\t        assert_eq!(\n   911\t            engine.module_translator(\"@mesh/two\").translate(\"shared\"),\n   912\t            Some(\"two\")\n   913\t        );\n   914\t        assert_eq!(engine.core_translator().translate(\"shared\"), None);\n   915\t    }\n   916\t\n   917\t    #[test]\n   918\t    fn selection_normalizes_parents_direction_and_revision() {\n   919\t        let selection = LocaleSelection::try_new(\" zh-hant-tw \", \"en-US\", 7).unwrap();\n   920\t\n   921\t        assert_eq!(selection.active(), \"zh-Hant-TW\");\n   922\t        assert_eq!(selection.fallback(), \"en-US\");\n   923\t        assert_eq!(\n   924\t            selection.chain(),\n   925\t            &[\"zh-Hant-TW\", \"zh-Hant\", \"zh\", \"en-US\", \"en\"]\n   926\t        );\n   927\t        assert_eq!(selection.direction(), LocaleDirection::Ltr);\n   928\t        assert_eq!(selection.revision(), 7);\n   929\t\n   930\t        let rtl = LocaleSelection::try_new(\"ar-EG\", \"en\", 1).unwrap();\n   931\t        assert_eq!(rtl.direction(), LocaleDirection::Rtl);\n   932\t    }\n   933\t\n   934\t    #[test]\n   935\t    fn locale_changes_replace_stale_chain_and_increment_revision() {\n   936\t        let mut engine = LocaleEngine::with_fallback_locale(\"sk-SK\", \"de-DE\");\n   937\t        assert_eq!(\n   938\t            engine.fallback_chain(),\n   939\t            &[\"sk-SK\", \"sk\", \"de-DE\", \"de\", \"en\"]\n   940\t        );\n   941\t        assert_eq!(engine.revision(), 1);\n   942\t\n   943\t        assert!(engine.try_set_locale(\"fr-FR\").unwrap());\n   944\t        assert_eq!(engine.current(), \"fr-FR\");\n   945\t        assert_eq!(\n   946\t            engine.fallback_chain(),\n   947\t            &[\"fr-FR\", \"fr\", \"de-DE\", \"de\", \"en\"]\n   948\t        );\n   949\t        assert_eq!(engine.revision(), 2);\n   950\t        assert!(!engine.try_set_locale(\"fr-fr\").unwrap());\n   951\t        assert_eq!(engine.revision(), 2);\n   952\t    }\n   953\t\n   954\t    #[test]\n   955\t    fn invalid_locale_tags_are_rejected() {\n   956\t        assert!(matches!(\n   957\t            LocaleSelection::try_new(\"\", \"en\", 1),\n   958\t            Err(LocaleError::EmptyTag)\n   959\t        ));\n   960\t        assert!(matches!(\n   961\t            LocaleSelection::try_new(\"en_US\", \"en\", 1),\n   962\t            Err(LocaleError::InvalidTag { .. })\n   963\t        ));\n   964\t        assert!(matches!(\n   965\t            LocaleSelection::try_new(\"en-a\", \"en\", 1),\n   966\t            Err(LocaleError::InvalidTag { .. })\n   967\t        ));\n   968\t    }\n   969\t\n   970\t    #[test]\n   971\t    fn typed_catalogs_keep_valid_siblings_and_resolve_variants() {\n   972\t        let compiled = compile_catalog(\n   973\t            \"sk\",\n   974\t            &serde_json::json!({\n   975\t                \"plain\": \"Ahoj {name}\",\n   976\t                \"items\": {\n   977\t                    \"_plural\": true,\n   978\t                    \"one\": \"{count} položka\",\n   979\t                    \"few\": \"{count} položky\",\n   980\t                    \"many\": \"{count} položiek\",\n   981\t                    \"other\": \"{count} položiek\"\n   982\t                },\n   983\t                \"greeting\": {\n   984\t                    \"_select\": true,\n   985\t                    \"formal\": \"Dobrý deň\",\n   986\t                    \"other\": \"Ahoj\"\n   987\t                },\n   988\t                \"broken\": {\n   989\t                    \"_plural\": true,\n   990\t                    \"one\": \"{count} položka\",\n   991\t                    \"other\": \"položky\"\n   992\t                }\n   993\t            }),\n   994\t        );\n   995\t        assert_eq!(compiled.messages.len(), 3);\n   996\t        assert_eq!(compiled.diagnostics.len(), 1);\n   997\t        assert_eq!(compiled.diagnostics[0].key, \"broken\");\n   998\t\n   999\t        let mut engine = LocaleEngine::new(\"sk\");\n  1000\t        engine.load_module_catalog(\"@mesh/example\", compiled);\n  1001\t        let translator = engine.module_translator(\"@mesh/example\");\n  1002\t        let args = HashMap::from([\n  1003\t            (\"count\".into(), \"3\".into()),\n  1004\t            (\"name\".into(), \"Mária\".into()),\n  1005\t            (\"select\".into(), \"formal\".into()),\n  1006\t        ]);\n  1007\t        assert_eq!(\n  1008\t            translator.translate_with(\"plain\", &args),\n  1009\t            Some(\"Ahoj Mária\".into())\n  1010\t        );\n  1011\t        assert_eq!(\n  1012\t            translator.translate_with(\"items\", &args),\n  1013\t            Some(\"3 položky\".into())\n  1014\t        );\n  1015\t        assert_eq!(\n  1016\t            translator.translate_with(\"greeting\", &args),\n  1017\t            Some(\"Dobrý deň\".into())\n  1018\t        );\n  1019\t        assert_eq!(translator.translate(\"items\"), Some(\"{count} položiek\"));\n  1020\t    }\n  1021\t\n  1022\t    #[test]\n  1023\t    fn catalog_snapshots_are_revisioned_and_replaced_atomically() {\n  1024\t        let mut engine = LocaleEngine::new(\"en\");\n  1025\t        let empty = engine.catalog_snapshot();\n  1026\t        engine.load_module_translations(\n  1027\t            \"@mesh/example\",\n  1028\t            TranslationSet {\n  1029\t                locale: \"en\".into(),\n  1030\t                messages: HashMap::from([(String::from(\"hello\"), String::from(\"Hello\"))]),\n  1031\t            },\n  1032\t        );\n  1033\t        let committed = engine.catalog_snapshot();\n  1034\t        assert_eq!(empty.revision(), 0);\n  1035\t        assert_eq!(committed.revision(), 1);\n  1036\t        assert_eq!(\n  1037\t            engine.module_translator(\"@mesh/example\").translate(\"hello\"),\n  1038\t            Some(\"Hello\")\n  1039\t        );\n  1040\t\n  1041\t        engine.replace_catalog_snapshot(empty);\n  1042\t        assert_eq!(engine.catalog_snapshot().revision(), 0);\n  1043\t        assert_eq!(\n  1044\t            engine.module_translator(\"@mesh/example\").translate(\"hello\"),\n  1045\t            None\n  1046\t        );\n  1047\t    }\n  1048\t}\n","exit_code":0,"status":"completed"}}
