\"{message}\");\n   414\t                return;\n   415\t            }\n   416\t            let candidate_graph = match self.load_installed_module_graph_candidate() {\n   417\t                Ok(graph) => graph,\n   418\t                Err(error) => {\n   419\t                    pending.slot.task.abort();\n   420\t                    let message = format!(\n   421\t                        \"provider selection was saved but the candidate graph could not be refreshed: {error}\"\n   422\t                    );\n   423\t                    tracing::warn!(interface, provider_id, \"{message}\");\n   424\t                    self.diagnostics.record_lifecycle_error(\n   425\t                        \"@mesh/shell\".to_string(),\n   426\t                        \"provider_selection_graph_reload_failed\",\n   427\t                        message,\n   428\t                    );\n   429\t                    return;\n   430\t                }\n   431\t            };\n   432\t            self.commit_installed_module_graph(candidate_graph);\n   433\t        }\n   434\t        self.backend_supervision.remove(interface);\n   435\t        let initial_state = pending.initial_state;\n   436\t        self.replace_backend_runtime(interface.to_string(), pending.slot);\n   437\t        self.note_backend_running(interface);\n   438\t        if let Some(payload) = initial_state {\n   439\t            self.publish_prepared_backend_state(interface, provider_id, payload);\n   440\t        }\n   441\t        self.publish_backend_health(\n   442\t            interface,\n   443\t            provider_id,\n   444\t            BackendRuntimeStatus::Running,\n   445\t            \"backend runtime ready\",\n   446\t            true,\n   447\t        );\n   448\t        tracing::info!(\n   449\t            interface,\n   450\t            provider_id,\n     1\tuse super::super::*;\n     2\t\n     3\tconst FRONTEND_RELOAD_POLL_INTERVAL: std::time::Duration = std::time::Duration::from_millis(250);\n     4\t\n     5\timpl Shell {\n     6\t    pub(in crate::shell) fn reload_frontend_components_if_changed(\n     7\t        &mut self,\n     8\t    ) -> Result<(), ShellRunError> {\n     9\t        let now = std::time::Instant::now();\n    10\t        if now < self.next_frontend_reload_check {\n    11\t            return Ok(());\n    12\t        }\n    13\t        self.next_frontend_reload_check = now\n    14\t            + if self.file_watcher_active {\n    15\t                super::FILE_WATCHER_RELOAD_PARK\n    16\t            } else {\n    17\t                FRONTEND_RELOAD_POLL_INTERVAL\n    18\t            };\n    19\t\n    20\t        for component_index in 0..self.components.len() {\n    21\t            let reloaded = {\n    22\t                let runtime = &mut self.components[component_index];\n    23\t                if runtime.source_paths.is_empty() {\n    24\t                    continue;\n    25\t                }\n    26\t\n    27\t                let changed_path_index =\n    28\t                    runtime.source_paths.iter().position(|(path, last_mtime)| {\n    29\t                        std::fs::metadata(path)\n    30\t                            .and_then(|metadata| metadata.modified())\n    31\t                            .is_ok_and(|modified_at| *last_mtime != Some(modified_at))\n    32\t                    });\n    33\t                let Some(trigger_index) = changed_path_index else {\n    34\t                    continue;\n    35\t                };\n    36\t                let trigger_display = runtime.source_paths[trigger_index].0.display().to_string();\n    37\t                let reloaded = runtime\n    38\t                    .component\n    39\t                    .reload_source()\n    40\t                    .map_err(ShellRunError::Component)?;\n    41\t\n    42\t                // Re-read the watched-paths list from the component because\n    43\t                // imports may have changed between compilations, and refresh\n    44\t                // every entry's mtime so we don't immediately reload again.\n    45\t                runtime.source_paths = runtime\n    46\t                    .component\n    47\t                    .watched_source_paths()\n    48\t                    .into_iter()\n    49\t                    .map(|path| {\n    50\t                        let mtime = std::fs::metadata(&path)\n    51\t                            .ok()\n    52\t                            .and_then(|m| m.modified().ok());\n    53\t                        (path, mtime)\n    54\t                    })\n    55\t                    .collect();\n    56\t\n    57\t                if reloaded {\n    58\t                    tracing::info!(\n    59\t                        \"recompiled frontend component '{}' (triggered by change in {})\",\n    60\t                        runtime.component.id(),\n    61\t                        trigger_display\n    62\t                    );\n    63\t                }\n    64\t                reloaded\n    65\t            };\n    66\t            if reloaded {\n    67\t                self.sync_frontend_catalog_components();\n    68\t            }\n    69\t        }\n    70\t\n    71\t        Ok(())\n    72\t    }\n    73\t\n    74\t    pub(in crate::shell) fn tick_components(\n    75\t        &mut self,\n    76\t    ) -> Result<VecDeque<CoreRequest>, ShellRunError> {\n    77\t        let mut requests = VecDeque::new();\n    78\t        for runtime in &mut self.components {\n    79\t            if !runtime.component.wants_tick() {\n    80\t                continue;\n    81\t            }\n    82\t            requests.extend(runtime.component.tick().map_err(ShellRunError::Component)?);\n    83\t        }\n    84\t        Ok(requests)\n    85\t    }\n    86\t}\n","exit_code":0,"status":"completed"}}
