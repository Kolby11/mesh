n M crates/core/shell/src/shell/runtime/service_state.rs\n M crates/core/shell/src/shell/runtime/theme.rs\n M crates/core/shell/src/shell/surface_layout.rs\n M crates/core/shell/src/shell/tests/debug.rs\n M crates/core/shell/src/shell/tests/graph.rs\n M crates/core/shell/src/shell/tests/theme.rs\n M docs/BACKLOG.md\n M docs/spec/07-i18n.md\n1b5f9a6e (HEAD -> main, origin/main, origin/HEAD) chore: checkpoint current worktree\n1dbaeb49 feat: unify theme keyframes and token dependencies\n63acf950 feat: share restricted theme css selectors\ne49d330b feat: persist fingerprinted theme selections\n5c2326be feat: compose graph theme layers\n86d08c5d docs: record transactional theme candidates\n4d11e431 feat: retain last-known-good theme candidates\n85cbc2b2 docs: record contained theme source loading\n","exit_code":0,"status":"completed"}}
