          .is_some_and(|module| module.kind == mesh_core_module::ModuleKind::LanguagePack)\n    45\t        })\n    46\t        .collect::<Vec<_>>();\n    47\t    bundled.sort_by(|left, right| {\n    48\t        left.target_module_id\n    49\t            .cmp(&right.target_module_id)\n    50\t            .then_with(|| left.locale.cmp(&right.locale))\n    51\t            .then_with(|| left.id.cmp(&right.id))\n    52\t    });\n    53\t\n    54\t    let mut sources = bundled\n    55\t        .into_iter()\n    56\t        .filter_map(|catalog| {\n    57\t            let module_dir = catalog.source.manifest_path.parent()?;\n    58\t            Some(mesh_core_locale::CatalogSource::module(\n    59\t                catalog.module_id.clone(),\n    60\t                catalog.id.clone(),\n    61\t                catalog.locale.clone(),\n    62\t                module_dir.join(&catalog.path),\n    63\t            ))\n    64\t        })\n    65\t        .collect::<Vec<_>>();\n    66\t\n    67\t    for pack_module_id in graph.language_pack_chain() {\n    68\t        let mut pack_catalogs = graph\n    69\t            .contributed_i18n()\n    70\t            .iter()\n    71\t            .filter(|catalog| {\n    72\t                catalog.module_id == *pack_module_id\n    73\t                    && selected_packs.contains(&catalog.module_id)\n    74\t                    && catalog.target_module_id != catalog.module_id\n    75\t                    && graph\n    76\t                        .module(&catalog.target_module_id)\n    77\t                        .is_some_and(|module| module.enabled)\n    78\t            })\n    79\t            .collect::<Vec<_>>();\n    80\t        pack_catalogs.sort_by(|left, right| left.id.cmp(&right.id));\n    81\t        for catalog in pack_catalogs {\n    82\t            let Some(module_dir) = catalog.source.manifest_path.parent() else {\n    83\t                continue;\n    84\t            };\n    85\t            sources.push(mesh_core_locale::CatalogSource::language_pack(\n    86\t                catalog.module_id.clone(),\n    87\t                catalog.target_module_id.clone(),\n    88\t                catalog.id.clone(),\n    89\t                catalog.locale.clone(),\n    90\t                module_dir.join(&catalog.path),\n    91\t            ));\n    92\t        }\n    93\t    }\n    94\t\n    95\t    let defaults = graph\n    96\t        .modules()\n    97\t        .into_iter()\n    98\t        .filter(|module| module.enabled)\n    99\t        .filter_map(|module| {\n   100\t            module\n   101\t                .manifest\n   102\t                .mesh\n   103\t                .i18n\n   104\t                .default_locale\n   105\t                .clone()\n   106\t                .map(|locale| (module.id.clone(), locale))\n   107\t        })\n   108\t        .collect();\n   109\t    (sources, defaults)\n   110\t}\n   111\t\n   112\tfn log_locale_catalog_diagnostics(diagnostics: &[mesh_core_locale::CatalogSourceDiagnostics]) {\n   113\t    for source in diagnostics {\n   114\t        for diagnostic in &source.diagnostics {\n   115\t            tracing::warn!(\n   116\t                module_id = %source.module_id,\n   117\t                locale = %source.locale,\n   118\t                path = %source.path.display(),\n   119\t                key = %diagnostic.key,\n   120\t                \"locale catalog entry rejected: {}\",\n   121\t                diagnostic.message,\n   122\t            );\n   123\t        }\n   124\t    }\n   125\t}\n   126\t\n   127\t/// Layer a profile's sparse preferences and per-instance surface overrides on\n   128\t/// top of shared user defaults. The shared document remains untouched.\n   129\tpub(in crate::shell) fn effective_profile_settings(\n   130\t    shared: SettingsStore,\n   850\t    }\n   851\t\n   852\t    pub(in crate::shell) fn load_installed_module_graph_cached(\n   853\t        &mut self,\n   854\t    ) -> Result<&InstalledModuleGraph, mesh_core_module::package::ModuleManifestError> {\n   855\t        if self.installed_module_graph.is_none() {\n   856\t            let graph_path = self.installed_module_graph_path();\n   857\t            let candidate = load_installed_module_graph_candidate(&graph_path)?;\n   858\t            let locale = self.prepare_locale_for_graph(&candidate).map_err(|error| {\n   859\t                mesh_core_module::package::ModuleManifestError::Validation(error.to_string())\n   860\t            })?;\n   861\t            self.commit_installed_module_graph_with_locale(candidate, locale);\n   862\t        }\n   863\t        Ok(self\n   864\t            .installed_module_graph\n   865\t            .as_ref()\n   866\t            .expect(\"installed module graph was just loaded\"))\n   867\t    }\n   868\t\n   869\t    /// Read a replacement graph without changing the active graph. Callers\n   870\t    /// that prepare a live activation use this boundary so a malformed or\n   871\t    /// incomplete on-disk candidate cannot discard the last-known-good graph.\n   872\t    pub(in crate::shell) fn load_installed_module_graph_candidate(\n   873\t        &self,\n   874\t    ) -> Result<InstalledModuleGraph, mesh_core_module::package::ModuleManifestError> {\n   875\t        load_installed_module_graph_candidate(&self.installed_module_graph_path())\n   876\t    }\n   877\t\n   878\t    #[cfg(test)]\n   879\t    pub(in crate::shell) fn reload_installed_module_graph_at(\n   880\t        &mut self,\n   881\t        root_module_graph_path: &Path,\n   882\t    ) -> Result<InstalledModuleGraph, mesh_core_module::package::ModuleManifestError> {\n   883\t        let candidate = load_installed_module_graph_candidate(root_module_graph_path)?;\n   884\t        self.commit_installed_module_graph(candidate.clone())\n   885\t            .map_err(|error| {\n   886\t                mesh_core_module::package::ModuleManifestError::Validation(error.to_string())\n   887\t            })?;\n   888\t        Ok(candidate)\n   889\t    }\n   890\t\n   891\t    pub(in crate::shell) fn prepare_locale_for_graph(\n   892\t        &self,\n   893\t        graph: &InstalledModuleGraph,\n   894\t    ) -> Result<LocaleEngine, ShellRunError> {\n   895\t        let mut candidate = self.locale.clone();\n   896\t        let (sources, defaults) = graph_i18n_catalog_sources(graph);\n   897\t        let prepared = candidate\n   898\t            .prepare_catalog_snapshot(&sources, &defaults)\n   899\t            .map_err(|error| ShellRunError::LocaleCatalog(error.to_string()))?;\n   900\t        log_locale_catalog_diagnostics(prepared.diagnostics());\n   901\t        candidate.replace_catalog_snapshot(prepared.snapshot());\n   902\t        Ok(candidate)\n   903\t    }\n   904\t\n   905\t    pub(in crate::shell) fn prepare_locale_for_settings(\n   906\t        &self,\n   907\t        settings: &ShellSettings,\n   908\t        graph: &InstalledModuleGraph,\n   909\t    ) -> Result<LocaleEngine, ShellRunError> {\n   910\t        let mut candidate = self.prepare_locale_selection_for_settings(settings)?;\n   911\t        let (sources, defaults) = graph_i18n_catalog_sources(graph);\n   912\t        let prepared = candidate\n   913\t            .prepare_catalog_snapshot(&sources, &defaults)\n   914\t            .map_err(|error| ShellRunError::LocaleCatalog(error.to_string()))?;\n   915\t        log_locale_catalog_diagnostics(prepared.diagnostics());\n   916\t        candidate.replace_catalog_snapshot(prepared.snapshot());\n   917\t        Ok(candidate)\n   918\t    }\n   919\t\n   920\t    pub(in crate::shell) fn prepare_locale_selection_for_settings(\n   921\t        &self,\n   922\t        settings: &ShellSettings,\n   923\t    ) -> Result<LocaleEngine, ShellRunError> {\n   924\t        let requested = mesh_core_locale::LocaleSelection::try_new(\n   925\t            settings.i18n.locale.clone(),\n   926\t            settings.i18n.fallback_locale.clone(),\n   927\t            1,\n   928\t        )\n   92