{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/core/shell/src/shell/mod.rs | sed -n '390,470p'; nl -ba crates/core/shell/src/shell/discovery.rs | sed -n '360,450p'; nl -ba crates/core/shell/src/shell/discovery.rs | sed -n '700,795p'\"","aggregated_output":"   390\t    if normalized.contains(\"shift\") {\n   391\t        modifiers.shift = false;\n   392\t    } else if normalized.contains(\"control\") || normalized == \"ctrl\" {\n   393\t        modifiers.ctrl = false;\n   394\t    } else if normalized.contains(\"alt\") {\n   395\t        modifiers.alt = false;\n   396\t    }\n   397\t}\n   398\t\n   399\tpub struct Shell {\n   400\t    pub config: ShellConfig,\n   401\t    /// Core shell preferences, resolved from [`Self::settings_store`]. Kept\n   402\t    /// alongside the store because most readers want only this.\n   403\t    pub settings: ShellSettings,\n   404\t    /// Every user decision in the shell, in one document. Shared with each\n   405\t    /// component so they read the same snapshot the shell does.\n   406\t    pub settings_store: Arc<SettingsStore>,\n   407\t    pub theme: ThemeEngine,\n   408\t    pub locale: LocaleEngine,\n   409\t    pub diagnostics: DiagnosticsCollector,\n   410\t    pub interfaces: InterfaceRegistry,\n   411\t    /// Catalog-backed policy loaded from the root graph's persisted approvals.\n   412\t    capability_policy: CapabilityPolicy,\n   413\t    /// Effective grants for the current activation candidate. Runtime\n   414\t    /// construction must consume this map rather than manifest declarations.\n   415\t    effective_capabilities: Arc<HashMap<String, EffectiveCapabilities>>,\n   416\t    installed_module_graph: Option<InstalledModuleGraph>,\n   417\t    active_profile_id: Option<String>,\n   418\t    modules: HashMap<String, ModuleInstance>,\n   419\t    frontend_catalog: component::FrontendCatalogHandle,\n   420\t    module_dirs: Vec<PathBuf>,\n   421\t    core: ShellCoreState,\n   422\t    /// Last rendered snapshot sent through the authoritative theme interface.\n   423\t    /// It is the baseline for deterministic revisioned token events.\n   424\t    last_published_theme_snapshot: Option<mesh_core_theme::ThemeSnapshot>,\n   425\t    components: Vec<ComponentRuntime>,\n   426\t    components_want_render: bool,\n   427\t    /// True after a component presented; false after a render pass with zero\n   428\t    /// presents.  When false, `components_have_ready_render_work` is suppressed\n   429\t    /// so stale `wants_render()` flags cannot spin the idle loop.\n   430\t    presented_last_frame: bool,\n   431\t    component_by_surface: HashMap<SurfaceId, usize>,\n   432\t    service_delivery_index: ServiceDeliveryIndex,\n   433\t    surfaces: HashMap<SurfaceId, StubSurface>,\n   434\t    clipboard: Box<dyn ClipboardWriter>,\n   435\t    presentation_engine: PresentationEngine,\n   436\t    eventfd_fd: Option<std::os::unix::io::OwnedFd>,\n   437\t    theme_watch: ThemeWatchState,\n   438\t    settings_watch: SettingsWatchState,\n   439\t    next_theme_reload_check: std::time::Instant,\n   440\t    next_shell_settings_reload_check: std::time::Instant,\n   441\t    next_frontend_reload_check: std::time::Instant,\n   442\t    file_watcher_active: bool,\n   443\t    debug: DebugOverlayState,\n   444\t    debug_overlay: DebugOverlay,\n   445\t    active_key_modifiers: KeyModifiers,\n   446\t    keyboard_focus_surface: Option<SurfaceId>,\n   447\t    pending_wayland_events: VecDeque<WindowEvent>,\n   448\t    transfer_owned_keyboard_modes: HashMap<SurfaceId, mesh_core_wayland::KeyboardMode>,\n   449\t    service_handlers: HashMap<String, mpsc::UnboundedSender<ServiceCommandMsg>>,\n   450\t    backend_runtimes: HashMap<String, BackendRuntimeSlot>,\n   451\t    pending_backend_runtimes: HashMap<String, PendingBackendRuntime>,\n   452\t    pending_profile_switch: Option<profile::PendingProfileSwitch>,\n   453\t    deferred_requests: VecDeque<CoreRequest>,\n   454\t    backend_runtime_statuses: BackendRuntimeStatusMap,\n   455\t    backend_supervision: HashMap<String, backend::BackendSupervisionState>,\n   456\t    backend_respawn: Option<backend::BackendRespawnContext>,\n   457\t    latest_service_state: HashMap<String, LatestServiceState>,\n   458\t    /// Last committed provider health event, replayed when a consumer mounts\n   459\t    /// after a graph/runtime transition.\n   460\t    latest_service_health: HashMap<String, ServiceEvent>,\n   461\t    service_contract_validation: HashMap<String, ContractValidationCache>,\n   462\t    /// Command-bound service state awaiting provider confirmation, keyed by\n   463\t    /// (interface, state field). Replacing an entry makes the newer CallId the\n   464\t    /// sole owner of rollback for that field.\n   465\t    pending_bound_service_state: HashMap<(String, String), PendingBoundServiceState>,\n   466\t    /// Historical owners let a newer failed write reveal an older still-live\n   467\t    /// write, or skip over older writes that already failed.\n   468\t    bound_service_state_transactions: HashMap<mesh_core_backend::CallId, PendingBoundServiceState>,\n   469\t    command_throttle: HashMap<(String, String), CommandThrottleState>,\n   470\t    pending_service_call_routes: HashMap<u64, ServiceCallRoute>,\n   360\t\n   361\timpl Shell {\n   362\t    pub fn new() -> Self {\n   363\t        let config_path = mesh_core_config::default_config_path();\n   364\t        let config = load_config(&config_path).unwrap_or_else(|e| {\n   365\t            tracing::warn!(\"failed to load config, using defaults: {e}\");\n   366\t            ShellConfig {\n   367\t                shell: Default::default(),\n   368\t            }\n   369\t        });\n   370\t        let shared_settings = SettingsStore::load().unwrap_or_else(|e| {\n   371\t            tracing::warn!(\"failed to load settings, using defaults: {e}\");\n   372\t            SettingsStore::default()\n   373\t        });\n   374\t        let graph_path = installed_module_graph_path();\n   375\t        let capability_policy = RootModuleGraphManifest::from_path(&graph_path)\n   376\t            .map(|root| CapabilityPolicy::from_approvals(root.capability_approvals))\n   377\t            .unwrap_or_else(|error| {\n   378\t                tracing::warn!(\n   379\t                    \"failed to load capability approvals from {}: {error}\",\n   380\t                    graph_path.display()\n   381\t                );\n   382\t                CapabilityPolicy::default()\n   383\t            });\n   384\t        let active_profile = mesh_core_module::package::ProfilePaths::from_root_graph(&graph_path)\n   385\t            .and_then(|paths| paths.load_active())\n   386\t            .unwrap_or_else(|error| {\n   387\t                tracing::warn!(\"failed to load active shell profile: {error}\");\n   388\t                None\n   389\t            });\n   390\t        let active_profile_id = active_profile.as_ref().map(|(id, _)| id.clone());\n   391\t        let settings_store = Arc::new(\n   392\t            effective_profile_settings(\n   393\t                shared_settings,\n   394\t                active_profile.as_ref().map(|(_, profile)| profile),\n   395\t            )\n   396\t            .unwrap_or_else(|error| {\n   397\t                tracing::warn!(\"failed to apply active profile settings: {error}\");\n   398\t                SettingsStore::default()\n   399\t            }),\n   400\t        );\n   401\t        // A hand-edited file is the whole point of the store, so a bad value in\n   402\t        // it is reported and skipped, never fatal: the shell starts on declared\n   403\t        // defaults with the reason on stderr.\n   404\t        mesh_core_config::log_settings_diagnostics(\"settings\", settings_store.diagnostics());\n   405\t        let settings = settings_store.shell().clone();\n   406\t\n   407\t        // Discover and register XDG icon themes installed on the system.\n   408\t        // Icon-pack binding modules reference them by name in their\n   409\t        // mapping targets (`<theme>/<icon-name>`). Failures are logged\n   410\t        // but non-fatal — hicolor fallback still works.\n   411\t        for pack in mesh_core_icon::discover_xdg_packs() {\n   412\t            let id = pack.id.clone();\n   413\t            match mesh_core_icon::register_default_pack(pack) {\n   414\t                Ok(true) => tracing::info!(\"registered XDG icon theme '{}'\", id),\n   415\t                Ok(false) => tracing::debug!(\"XDG icon theme '{}' already registered\", id),\n   416\t                Err(err) => {\n   417\t                    tracing::warn!(\"failed to register XDG icon theme '{}': {err}\", id)\n   418\t                }\n   419\t            }\n   420\t        }\n   421\t        mesh_core_icon::set_default_shell_pack(settings.icons.default_pack.clone());\n   422\t        mesh_core_render::set_blur_quality(blur_quality_from_settings(&settings.render.blur));\n   423\t        let (theme, theme_watch) = load_active_theme(&settings);\n   424\t        let locale = LocaleEngine::with_fallback_locale(\n   425\t            settings.i18n.locale.clone(),\n   426\t            settings.i18n.fallback_locale.clone(),\n   427\t        );\n   428\t        let module_dirs = resolve_default_module_dirs(&config);\n   429\t        let settings_watch = {\n   430\t            let path = settings_store.path().to_path_buf();\n   431\t            let modified_at = std::fs::metadata(&path)\n   432\t                .ok()\n   433\t                .and_then(|m| m.modified().ok());\n   434\t            SettingsWatchState { path, modified_at }\n   435\t        };\n   436\t\n   437\t        let interfaces = InterfaceRegistry::new();\n   438\t        let mut theme_contract = builtin_contract(\n   439\t            \"mesh.theme\",\n   440\t            &[\n   441\t                (\"current\", \"string\"),\n   442\t                (\"theme_id\", \"string\"),\n   443\t                (\"mode\", \"string?\"),\n   444\t                (\"mode_policy\", \"object?\"),\n   445\t                (\"color_scheme\", \"string?\"),\n   446\t                (\"contrast\", \"string?\"),\n   447\t                (\"tokens\", \"object?\"),\n   448\t                (\"provenance\", \"object?\"),\n   449\t                (\"revision\", \"string\"),\n   450\t                (\"fingerprint\", \"integer?\"),\n   700\t            latest_service_state: HashMap::new(),\n   701\t            latest_service_health: HashMap::new(),\n   702\t            service_contract_validation: HashMap::new(),\n   703\t            pending_bound_service_state: HashMap::new(),\n   704\t            bound_service_state_transactions: HashMap::new(),\n   705\t            command_throttle: HashMap::new(),\n   706\t            pending_service_call_routes: HashMap::new(),\n   707\t            pending_popover_hides: HashMap::new(),\n   708\t            profiling: runtime::profiling::ProfilingRuntimeState::default(),\n   709\t        }\n   710\t    }\n   711\t\n   712\t    pub fn discover_modules(&mut self) {\n   713\t        let graph = match self.load_installed_module_graph_candidate() {\n   714\t            Ok(graph) => graph,\n   715\t            Err(error) => {\n   716\t                tracing::error!(\n   717\t                    \"failed to load installed module graph; retaining last-known-good discovery: {error}\"\n   718\t                );\n   719\t                return;\n   720\t            }\n   721\t        };\n   722\t        self.commit_installed_module_graph(graph.clone());\n   723\t        self.modules.clear();\n   724\t        for node in graph.modules() {\n   725\t            let Some(module_dir) = node.manifest_path.parent() else {\n   726\t                tracing::error!(module_id = %node.id, \"graph module manifest has no parent directory\");\n   727\t                continue;\n   728\t            };\n   729\t            self.register_loaded_module(\n   730\t                module_dir,\n   731\t                mesh_core_module::LoadedManifest {\n   732\t                    manifest: node.manifest.clone().into_runtime_manifest(),\n   733\t                    path: node.manifest_path.clone(),\n   734\t                    source: mesh_core_module::manifest::ManifestSource::CanonicalModuleJson,\n   735\t                },\n   736\t            );\n   737\t        }\n   738\t        self.register_interfaces_from_graph(&graph);\n   739\t        tracing::info!(\"discovered {} graph-authorized modules\", self.modules.len());\n   740\t    }\n   741\t\n   742\t    pub(in crate::shell) fn installed_module_graph_path(&self) -> PathBuf {\n   743\t        installed_module_graph_path()\n   744\t    }\n   745\t\n   746\t    pub(in crate::shell) fn load_installed_module_graph_cached(\n   747\t        &mut self,\n   748\t    ) -> Result<&InstalledModuleGraph, mesh_core_module::package::ModuleManifestError> {\n   749\t        if self.installed_module_graph.is_none() {\n   750\t            let graph_path = self.installed_module_graph_path();\n   751\t            self.installed_module_graph = Some(load_installed_module_graph_candidate(&graph_path)?);\n   752\t        }\n   753\t        Ok(self\n   754\t            .installed_module_graph\n   755\t            .as_ref()\n   756\t            .expect(\"installed module graph was just loaded\"))\n   757\t    }\n   758\t\n   759\t    /// Read a replacement graph without changing the active graph. Callers\n   760\t    /// that prepare a live activation use this boundary so a malformed or\n   761\t    /// incomplete on-disk candidate cannot discard the last-known-good graph.\n   762\t    pub(in crate::shell) fn load_installed_module_graph_candidate(\n   763\t        &self,\n   764\t    ) -> Result<InstalledModuleGraph, mesh_core_module::package::ModuleManifestError> {\n   765\t        load_installed_module_graph_candidate(&self.in