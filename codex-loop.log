        };\n   233\t            diagnostics.push(ModuleGraphDiagnostic {\n   234\t                module_id: consumer.module_id.clone(),\n   235\t                contribution_id: Some(format!(\n   236\t                    \"{}:optional-interface:{}\",\n   237\t                    consumer.module_id, interface\n   238\t                )),\n   239\t                status: status.into(),\n   240\t                message,\n   241\t            });\n   242\t        }\n   243\t    }\n   244\t\n   245\t    (active, diagnostics, blocked_frontends)\n   246\t}\n   247\t\n   248\tfn provider_satisfies_requirement(\n   249\t    provider: &BackendProviderNode,\n   250\t    requirement: &str,\n   251\t    declaration: Option<&InterfaceDeclarationNode>,\n   252\t    contract: Option<&InterfaceContract>,\n   253\t) -> bool {\n   254\t    let Some(request) = parse_version_req(requirement) else {\n   255\t        return false;\n   256\t    };\n   257\t    if let Some(contract) = contract {\n   258\t        if !request.matches(&contract.version) {\n   259\t            return false;\n   260\t        }\n   261\t    } else if let Some(version) = declaration\n   262\t        .and_then(|declaration| declaration.version.as_deref())\n   263\t        .and_then(parse_contract_version)\n   264\t        && !request.matches(&version)\n   265\t    {\n   266\t        return false;\n   267\t    }\n   268\t\n   269\t    let Some(provider_version) = provider.version.as_deref() else {\n   270\t        // Older providers without a version inherit the declared contract\n   271\t        // version, which was checked above when one exists.\n   272\t        return true;\n   273\t    };\n   274\t    parse_contract_version(provider_version).is_some_and(|version| request.matches(&version))\n   275\t}\n   276\t\n   277\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n   278\tpub enum ModuleManifestSource {\n   279\t    CanonicalModuleJson,\n   280\t}\n   281\t\n   282\t#[derive(Debug, Clone)]\n   283\tpub struct I