gs(&[\r\n/home/kolby/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/tinystr-0.8.3/src/databake.rs:12:        let string = self.as_str();\n/home/kolby/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/tinystr-0.8.3/src/databake.rs:14:            tinystr::tinystr!(#N, #string)\n/home/kolby/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/tinystr-0.8.3/Cargo.toml.orig:7:description = \"A small ASCII-only bounded length string representation.\"\n/home/kolby/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/tinystr-0.8.3/Cargo.toml.orig:9:keywords = [\"small-string\", \"ascii\", \"string\", \"str\"]\n","exit_code":0,"status":"completed"}}
