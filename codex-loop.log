                     );\n   694\t                        return VecDeque::new();\n   695\t                    }\n   696\t                }\n   697\t            }\n   698\t        } else {\n   699\t            None\n   700\t        };\n   701\t        let candidate_theme_id = prepared_theme\n   702\t            .as_ref()\n   703\t            .map(|(theme, _)| theme.id.clone())\n   704\t            .unwrap_or_else(|| self.theme.active().id.clone());\n   705\t        for candidate in &mut candidates {\n   706\t            Self::apply_runtime_settings(\n   707\t                candidate,\n   708\t                &candidate_theme_id,\n   709\t                &settings.shell().i18n.locale,\n   710\t            );\n   711\t        }\n   712\t        let desired_providers = candidates\n   713\t            .iter()\n   714\t            .map(|candidate| (candidate.interface.clone(), candidate.module_id.clone()))\n   715\t            .collect::<HashMap<_, _>>();\n   716\t        let current_configs = self\n   717\t            .installed_module_graph\n   718\t            .as_ref()\n   719\t            .map(|current_graph| {\n   720\t                let (mut current, _) = backend_launch_candidates_from_graph_with_capabilities(\n   721\t                    current_graph,\n   722\t                    &self.modules,\n   723\t                    &self.settings_store,\n   724\t                    &self.interfaces,\n   725\t                    Some(&self.effective_capabilities),\n   726\t                );\n   727\t                for candidate in &mut current {\n   728\t                    self.apply_shell_runtime_settings(candidate);\n   729\t                }\n   730\t                current\n   731\t                    .into_iter()\n   732\t                    .map(|candidate| {\n   733\t                        (\n   734\t                            candidate.interface,\n   735\t                            (candidate.module_id, candidate.settings),\n   736\t                        )\n   737\t                    })\n   738\t                    .collect::<HashMap<_, _>>()\n   739\t            })\n   740\t            .unwrap_or_default();\n   741\t        let changed = candidates\n   742\t            .into_iter()\n   743\t            .filter(|candidate| {\n   744\t                let running_matches = self\n   745\t                    .backend_runtimes\n   746\t                    .get(&candidate.interface)\n   747\t                    .is_some_and(|running| running.provider_id == candidate.module_id);\n   748\t                let config_matches = current_configs.get(&candidate.interface).is_some_and(\n   749\t                    |(provider_id, settings)| {\n   750\t                        provider_id == &candidate.module_id && settings == &candidate.settings\n   751\t                    },\n   752\t                );\n   753\t                !(running_matches && config_matches)\n   754\t            })\n   755\t            .collect::<Vec<_>>();\n   756\t\n   757\t        let mut pending = PendingProfileSwitch {\n   758\t            profile_id: profile_id.to_string(),\n   759\t            graph,\n   760\t            settings,\n   761\t            prepared_theme,\n   762\t            catalog,\n   763\t            desired_surfaces,\n   764\t            desired_providers,\n   765\t            prepared_frontends,\n   766\t            candidate_backends: HashMap::new(),\n   767\t            waiting_backends: HashSet::new(),\n   768\t            candidate_started: HashSet::new(),\n   769\t            candidate_initial_states: HashMap::new(),\n   770\t        };\n   771\t        if !changed.is_empty() {\n   772\t            let Some(ctx) = self.backend_respawn.clone() else {\n   773\t                self.reject_profile_switch(\n   774\t                    profile_id,\n   775\t                    \"backend runtime is unavailable while candidate providers need preparation\"\n   776\t                        .into(),\n   777\t                );\n   778\t   