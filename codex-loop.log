ror, \\\"invalid locale selection; using en\\\");\\n   631\\t                Self::try_with_fallback_locale(\\\"en\\\", \\\"en\\\")\\n   632\\t                    .expect(\\\"the built-in en locale must be valid\\\")\\n   633\\t            }\\n   634\\t        }\\n   635\\t    }\\n   636\\t\\n   637\\t    pub fn selection(&self) -> &LocaleSelection {\\n   638\\t        &self.selection\\n   639\\t    }\\n   640\\t\\n   641\\t    pub fn direction(&self) -> LocaleDirection {\\n   642\\t        self.selection.direction()\\n   643\\t    }\\n   644\\t\\n   645\\t    pub fn revision(&self) -> u64 {\\n   646\\t        self.selection.revision()\\n   647\\t    }\\n   648\\t\\n   649\\t    pub fn fallback_locale(&self) -> &str {\\n   650\\t        self.selection.fallback()\\n   651\\t    }\\n   652\\t\\n   653\\t    /// Adopt an already validated selection while retaining loaded catalogs.\\n   654\\t    pub fn replace_selection(&mut self, selection: &LocaleSelection) {\\n   655\\t        self.selection = selection.clone();\\n   656\\t    }\\n   657\\t\\n   658\\t    pub fn catalog_snapshot(&self) -> Arc<LocaleCatalogSnapshot> {\\n   659\\t        Arc::clone(&self.catalogs)\\n   660\\t    }\\n   661\\t\\n   662\\t    /// Replace the catalog pointer after a complete candidate has been\\n   663\\t    /// prepared. Existing readers retaining the prior Arc keep last-known-good\\n   664\\t    /// data until the replacement is committed.\\n   665\\t    pub fn replace_catalog_snapshot(&mut self, snapshot: Arc<LocaleCatalogSnapshot>) {\\n   666\\t        self.catalogs = snapshot;\\n   667\\t    }\\n   668\\t\\n   669\\t    /// Prepare a complete replacement catalog without changing this engine.\\n   670\\t    /// Every source must be readable and parseable before the returned Arc can\\n   671\\t    /// be committed. Structured entry diagnostics are non-fatal so valid\\n   672\\t    /// siblings remain available in the candidate.\\n   673\\t    pub fn prepare_module_catalog_snapshot(\\n   674\\t        &self,\\n   675\\t        sources: &[(String, String, PathBuf)],\\n   676\\t    ) -> Result<PreparedLocaleCatalogSnapshot, LocaleCatalogLoadError> {\\n   677\\t        let sources = sources\\n   678\\t            .iter()\\n   679\\t            .map(|(module_id, locale, path)| {\\n   680\\t                CatalogSource::module(\\n   681\\t                    module_id.clone(),\\n   682\\t                    locale.clone(),\\n   683\\t                    locale.clone(),\\n   684\\t                    path.clone(),\\n   685\\t                )\\n   686\\t            })\\n   687\\t            .collect::<Vec<_>>();\\n   688\\t        self.prepare_catalog_snapshot(&sources, &HashMap::new())\\n   689\\t    }\\n   690\\t\\n   691\\t    /// Prepare a complete replacement from graph-authorized module and\\n   692\\t    /// language-pack sources. Sources are expected in configured pack order;\\n   693\\t    /// the first matching language pack wins, followed by the module-bundled\\n   694\\t    /// catalog. Module defaults are terminal fallbacks for their target only.\\n   695\\t    pub fn prepare_catalog_snapshot(\\n   696\\t        &self,\\n   697\\t        sources: &[CatalogSource],\\n   698\\t        module_defaults: &HashMap<String, String>,\\n   699\\t    ) -> Result<PreparedLocaleCatalogSnapshot, LocaleCatalogLoadError> {\\n   700\\t        let mut snapshot = LocaleCatalogSnapshot {\\n   701\\t            revision: self.catalogs.revision.saturating_add(1),\\n   702\\t            core: HashMap::new(),\\n   703\\t            modules: HashMap::new(),\\n   704\\t            module_defaults: HashMap::new(),\\n   705\\t        };\\n   706\\t        let mut diagnostics = Vec::new();\\n   707\\t\\n   708\\t        for (module_id, locale) in module_defaults {\\n   709\\t            let locale = canonicalize_locale_tag(locale).map_err(|_| {\\n   710\\t                LocaleCatalogLoadError::InvalidLocale {\\n   711\\t                    locale: locale.clone(),\\n   712\\t                    context: format!(\\\"default locale for module {module_id}\\\"),\\n   713\\t                }\\n   714\\t            })?;\\n   715\\t            snapshot.module_defaults.insert(module_id.clone(), locale);\\n   716\\t        }\\n   717\\t\\n   718\\t        for source in sources {\\n   719\\t            let locale = canonicalize_locale_tag(&source.locale).map_err(|_| {\\n   720\\t                LocaleCatalogLoadError::InvalidLocale {\\n   721\\t                    locale: source.locale.clone(),\\n   722\\t                    context: format!(\\\"catalog {}\\\", source.path.display()),\\n   723\\t                }\\n   724\\t            })?;\\n   725\\t            let content = std::fs::read_to_string(&source.path).map_err(|source_error| {\\n   726\\t                LocaleCatalogLoadError::Read {\\n   727\\t                    path: source.path.clone(),\\n   728\\t                    source: source_error,\\n   729\\t                }\\n   730\\t            })?;\\n   731\\t            let value = serde_json::from_str(&content).map_err(|source_error| {\\n   732\\t                LocaleCatalogLoadError::Parse {\\n   733\\t                    path: source.path.clone(),\\n   734\\t                    source: source_error,\\n   735\\t                }\\n   736\\t            })?;\\n   737\\t            let catalog = compile_catalog(locale.clone(), &value);\\n   738\\t            if !catalog.diagnostics.is_empty() {\\n   739\\t                diagnostics.push(CatalogSourceDiagnostics {\\n   740\\t                    module_id: source.owner_module_id.clone(),\\n   741\\t                    locale: locale.clone(),\\n   742\\t                    path: source.path.clone(),\\n   743\\t                    diagnostics: catalog.diagnostics,\\n   744\\t                });\\n   745\\t            }\\n   746\\t            let provenance = CatalogProvenance {\\n   747\\t                kind: source.kind,\\n   748\\t                owner_module_id: source.owner_module_id.clone(),\\n   749\\t                target_module_id: source.target_module_id.clone(),\\n   750\\t                contribution_id: source.contribution_id.clone(),\\n   751\\t                locale: locale.clone(),\\n   752\\t                path: source.path.clone(),\\n   753\\t            };\\n   754\\t            snapshot\\n   755\\t                .modules\\n   756\\t                .entry(source.target_module_id.clone())\\n   757\\t                .or_default()\\n   758\\t                .entry(locale)\\n   759\\t                .or_default()\\n   760\\t                .push(CatalogLayer {\\n   761\\t                    source: provenance,\\n   762\\t                    messages: catalog.messages,\\n   763\\t                });\\n   764\\t        }\\n   765\\t\\n   766\\t        // Keep the caller's order among pack layers, but always inspect packs\\n   767\\t        // before the target module's own catalog for a locale. `sort_by` is\\n   768\\t        // stable, so the configured first-pack-wins order is preserved.\\n   769\\t        for locales in snapshot.modules.values_mut() {\\n   770\\t            for layers in locales.values_mut() {\\n   771\\t                layers.sort_by_key(|layer| match layer.source.kind {\\n   772\\t                    CatalogSourceKind::LanguagePack => 0,\\n   773\\t                    CatalogSourceKind::ModuleBundled => 1,\\n   774\\t                });\\n   775\\t            }\\n   776\\t        }\\n   777\\t\\n   778\\t        Ok(PreparedLocaleCatalogSnapshot {\\n   779\\t            snapshot: Arc::new(snapshot),\\n   780\\t            diagnostics,\\n   781\\t        })\\n   782\\t    }\\n   783\\t\\n   784\\t    pub fn try_set_locale(&mut self, locale: impl AsRef<str>) -> Result<bool, LocaleError> {\\n   785\\t        let next = LocaleSelection::try_new(\\n   786\\t            locale,\\n   787\\t            self.selection.fallback(),\\n   788\\t            self.selection.revision().saturating_add(1),\\n   789\\t        )?;\\n   790\\t        if next.active == self.selection.active && next.fallback == self.selection.fallback {\\n   791\\t            return Ok(false);\\n   792\\t        }\\n   793\\t        self.selection = next;\\n   794\\t        Ok(true)\\n   795\\t    }\\n   796\\t\\n   797\\t    pub fn current(&self) -> &str {\\n   798\\t        self.selection.active()\\n   799\\t    }\\n   800\\t\\n   801\\t    pub fn set_locale(&mut self, locale: impl Into<String>) {\\n   802\\t        if let Err(error) = self.try_set_locale(locale.into()) {\\n   803\\t            tracing::warn!(%error, \\\"ignoring invalid locale selection\\\");\\n   804\\t        }\\n   805\\t    }\\n   806\\t\\n   807\\t    /// Load a catalog owned by the explicit core domain.\\n   808\\t    pub fn load_core_translations(&mut self, set: TranslationSet) {\\n   809\\t        let locale = catalog_locale(&set.locale);\\n   810\\t        let catalogs = Arc::make_mut(&mut self.catalogs);\\n   811\\t        catalogs.core.entry(locale).or_default().extend(\\n   812\\t            set.messages\\n   813\\t                .into_iter()\\n   814\\t                .map(|(key, value)| (key, CatalogEntry::Text(value))),\\n   815\\t        );\\n   816\\t        catalogs.revision = catalogs.revision.saturating_add(1);\\n   817\\t    }\\n   818\\t\\n   819\\t    pub fn load_core_catalog(&mut self, catalog: CompiledCatalog) {\\n   820\\t        let locale = catalog_locale(&catalog.locale);\\n   821\\t        let catalogs = Arc::make_mut(&mut self.catalogs);\\n   822\\t        catalogs\\n   823\\t            .core\\n   824\\t            .entry(locale)\\n   825\\t            .or_default()\\n   826\\t            .extend(catalog.messages);\\n   827\\t        catalogs.revision = catalogs.revision.saturating_add(1);\\n   828\\t    }\\n   829\\t\\n   830\\t    pub fn module_translator(&self, module_id: &str) -> ModuleTranslator<'_> {\\n   831\\t        ModuleTranslator {\\n   832\\t            engine: self,\\n   833\\t            module_id: module_id.to_string(),\\n   834\\t        }\\n   835\\t    }\\n   836\\t\\n   837\\t    pub fn core_translator(&self) -> CoreTranslator<'_> {\\n   838\\t        CoreTranslator { engine: self }\\n   839\\t    }\\n   840\\t\\n   841\\t    /// Load a catalog owned by one module. It is never copied into the core\\n   842\\t    /// domain, so one module cannot shadow another module's keys.\\n   843\\t    pub fn load_module_translations(&mut self, module_id: &str, set: TranslationSet) {\\n   844\\t        let locale = catalog_locale(&set.locale);\\n   845\\t        let catalogs = Arc::make_mut(&mut self.catalogs);\\n   846\\t        catalogs\\n   847\\t            .modules\\n   848\\t            .entry(module_id.to_string())\\n   849\\t            .or_default()\\n   850\\t            .entry(locale)\\n   851\\t            .or_default()\\n   852\\t            .push(CatalogLayer {\\n   853\\t                source: CatalogProvenance {\\n   854\\t                    kind: CatalogSourceKind::ModuleBundled,\\n   855\\t                    owner_module_id: module_id.to_string(),\\n   856\\t                    target_module_id: module_id.to_string(),\\n   857\\t                    contribution_id: \\\"runtime\\\".into(),\\n   858\\t                    locale: catalog_locale(&set.locale),\\n   859\\t                    path: PathBuf::new(),\\n   860\\t                },\\n   861\\t                messages: set\\n   862\\t                    .messages\\n   863\\t                    .into_iter()\\n   864\\t                    .map(|(key, value)| (key, CatalogEntry::Text(value)))\\n   865\\t                    .collect(),\\n   866\\t            });\\n   867\\t        catalogs.revision = catalogs.revision.saturating_add(1);\\n   868\\t    }\\n   869\\t\\n   870\\t    pub fn load_module_catalog(&mut self, module_id: &str, catalog: CompiledCatalog) {\\n   871\\t        let locale = catalog_locale(&catalog.locale);\\n   872\\t        let catalogs = Arc::make_mut(&mut self.catalogs);\\n   873\\t        catalogs\\n   874\\t            .modules\\n   875\\t            .entry(module_id.to_string())\\n   876\\t            .or_default()\\n   877\\t            .entry(locale)\\n   878\\t            .or_default()\\n   879\\t            .push(CatalogLayer {\\n   880\\t                source: CatalogProvenance {\\n   881\\t                    kind: CatalogSourceKind::ModuleBundled,\\n   882\\t                    owner_module_id: module_id.to_string(),\\n   883\\t                    target_module_id: module_id.to_string(),\\n   884\\t                    contribution_id: \\\"runtime\\\".into(),\\n   885\\t                    locale: catalog_locale(&catalog.locale),\\n   886\\t                    path: PathBuf::new(),\\n   887\\t                },\\n   888\\t                messages: catalog.messages,\\n   889\\t            });\\n   890\\t        catalogs.revision = catalogs.revision.saturating_add(1);\\n   891\\t    }\\n   892\\t\\n   893\\t    fn translate_in_core(&self, key: &str) -> Option<&CatalogEntry> {\\n   894\\t        for locale in self.selection.chain() {\\n   895\\t            if let Some(messages) = self.catalogs.core.get(locale) {\\n   896\\t                if let Some(value) = messages.get(key) {\\n   897\\t                    return Some(value);\\n   898\\t                }\\n   899\\t            }\\n   900\\t        }\\n   901\\t        None\\n   902\\t    }\\n   903\\t\\n   904\\t    fn translate_in_module(&self, key: &str, module_id: &str) -> Option<&CatalogEntry> {\\n   905\\t        for locale in self.selection.chain() {\\n   906\\t            if let Some(value) = self.module_entry(module_id, locale, key, true) {\\n   907\\t                return Some(value);\\n   908\\t            }\\n   909\\t        }\\n   910\\t        if let Some(default_locale) = self.catalogs.module_defaults.get(module_id)\\n   911\\t            && !self\\n   912\\t                .selection\\n   913\\t                .chain()\\n   914\\t                .iter()\\n   915\\t                .any(|locale| locale == default_locale)\\n   916\\t            && let Some(value) = self.module_entry(module_id, default_locale, key, false)\\n   917\\t        {\\n   918\\t            return Some(value);\\n   919\\t        }\\n   920\\t        None\\n   921\\t    }\\n   922\\t\\n   923\\t    fn resolve_in_core<'a>(&'a self, key: &str, args: &HashMap<String, String>) -> Option<&'a str> {\\n   924\\t        for locale in self.selection.chain() {\\n   925\\t            if let Some(entry) = self.catalogs.core.get(locale).and_then(|m| m.get(key)) {\\n   926\\t                return entry.resolve(args, self.current());\\n   927\\t            }\\n   928\\t        }\\n   929\\t        None\\n   930\\t    }\\n   931\\t\\n   932\\t    fn resolve_in_module<'a>(\\n   933\\t        &'a self,\\n   934\\t        key: &str,\\n   935\\t        module_id: &str,\\n   936\\t        args: &HashMap<String, String>,\\n   937\\t    ) -> Option<&'a str> {\\n   938\\t        for locale in self.selection.chain() {\\n   939\\t            if let Some(entry) = self.module_entry(module_id, locale, key, true) {\\n   940\\t                return entry.resolve(args, self.current());\\n   941\\t            }\\n   942\\t        }\\n   943\\t        if let Some(default_locale) = self.catalogs.module_defaults.get(module_id)\\n   944\\t            && !self\\n   945\\t                .selection\\n   946\\t                .chain()\\n   947\\t                .iter()\\n   948\\t                .any(|locale| locale == default_locale)\\n   949\\t            && let Some(entry) = self.module_entry(module_id, default_locale, key, false)\\n   950\\t        {\\n   951\\t            return entry.resolve(args, self.current());\\n   952\\t        }\\n   953\\t        None\\n   954\\t    }\\n   955\\t\\n   956\\t    fn module_entry(\\n   957\\t        &self,\\n   958\\t        module_id: &str,\\n   959\\t        locale: &str,\\n   960\\t        key: &str,\\n   961\\t        include_language_packs: bool,\\n   962\\t    ) -> Option<&CatalogEntry> {\\n   963\\t        self.catalogs\\n   964\\t            .modules\\n   965\\t            .get(module_id)\\n   966\\t            .and_then(|module_locales| module_locales.get(locale))\\n   967\\t            .and_then(|layers| {\\n   968\\t                layers.iter().find_map(|layer| {\\n   969\\t                    if !include_language_packs\\n   970\\t                        && layer.source.kind == CatalogSourceKind::LanguagePack\\n   971\\t                    {\\n   972\\t                        return None;\\n   973\\t                    }\\n   974\\t                    layer.messages.get(key)\\n   975\\t                })\\n   976\\t            })\\n   977\\t    }\\n   978\\t\\n   979\\t    fn source_for_module(&self, key: &str, module_id: &str) -> Option<&CatalogProvenance> {\\n   980\\t        for locale in self.selection.chain() {\\n   981\\t            if let Some(source) = self.module_source(module_id, locale, key, true) {\\n   982\\t                return Some(source);\\n   983\\t            }\\n   984\\t        }\\n   985\\t        if let Some(default_locale) = self.catalogs.module_defaults.get(module_id)\\n   986\\t            && !self\\n   987\\t                .selection\\n   988\\t                .chain()\\n   989\\t                .iter()\\n   990\\t                .any(|locale| locale == default_locale)\\n   991\\t        {\\n   992\\t            return self.module_source(module_id, default_locale, key, false);\\n   993\\t        }\\n   994\\t        None\\n   995\\t    }\\n   996\\t\\n   997\\t    fn module_source(\\n   998\\t        &self,\\n   999\\t        module_id: &str,\\n  1000\\t        locale: &str,\\n  1001\\t        key: &str,\\n  1002\\t        include_language_packs: bool,\\n  1003\\t    ) -> Option<&CatalogProvenance> {\\n  1004\\t        self.catalogs\\n  1005\\t            .modules\\n  1006\\t            .get(module_id)\\n  1007\\t            .and_then(|module_locales| m