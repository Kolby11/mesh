{\\\\n   366\\\\t                pending.slot.task.abort();\\\\n   367\\\\t                let message = format!(\\\\n   368\\\\t                    \\\\\\\"provider selection was saved but the candidate graph could not be refreshed: {error}\\\\\\\"\\\\n   369\\\\t                );\\\\n   370\\\\t                tracing::warn!(interface, provider_id, \\\\\\\"{message}\\\\\\\");\\\\n   371\\\\t                self.diagnostics.record_lifecycle_error(\\\\n   372\\\\t                    \\\\\\\"@mesh/shell\\\\\\\".to_string(),\\\\n   373\\\\t                    \\\\\\\"provider_selection_graph_reload_failed\\\\\\\",\\\\n   374\\\\t                    message,\\\\n   375\\\\t                );\\\\n   376\\\\t                return;\\\\n   377\\\\t            }\\\\n   378\\\\t        };\\\\n   379\\\\t        self.commit_installed_module_graph(candidate_graph);\\\\n   380\\\\t        self.backend_supervision.remove(interface);\\\\n   381\\\\t        self.replace_backend_runtime(interface.to_string(), pending.slot);\\\\n   382\\\\t        self.note_backend_running(interface);\\\\n   383\\\\t        tracing::info!(\\\\n   384\\\\t            interface,\\\\n   385\\\\t            provider_id,\\\\n   386\\\\t            \\\\\\\"switched active backend provider live\\\\\\\"\\\\n   387\\\\t        );\\\\n   388\\\\t    }\\\\n   389\\\\t\\\\n   390\\\\t    pub(in crate::shell) fn handle_backend_lifecycle(\\\\n   391\\\\t        &mut self,\\\\n   392\\\\t        interface: String,\\\\n   393\\\\t        provider_id: String,\\\\n   394\\\\t        stage: String,\\\\n   395\\\\t        status: String,\\\\n   396\\\\t        message: String,\\\\n   397\\\\t    ) {\\\\n   398\\\\t        let runtime_status = BackendRuntimeStatus::from_str(&status);\\\\n   399\\\\t        self.record_backend_runtime_status(\\\\n   400\\\\t            interface.clone(),\\\\n   401\\\\t            provider_id.clone(),\\\\n   402\\\\t            runtime_status,\\\\n   403\\\\t            message,\\\\n   404\\\\t        );\\\\n   405\\\\t        if self.handle_profile_backend_lifecycle(&interface, &provider_id, runtime_status) {\\\\n   406\\\\t            return;\\\\n   407\\\\t        }\\\\n   408\\\\t        let event_provider_is_pending = self\\\\n   409\\\\t            .pending_backend_runtimes\\\\n   410\\\\t            .get(&interface)\\\\n   411\\\\t            .is_some_and(|pending| pending.slot.provider_id == provider_id);\\\\n   412\\\\t        if event_provider_is_pending {\\\\n   413\\\\t            if runtime_status == BackendRuntimeStatus::Running {\\\\n   414\\\\t                self.complete_backend_runtime_switch(&interface, &provider_id);\\\\n   415\\\\t            } else if matches!(\\\\n   416\\\\t                runtime_status,\\\\n   417\\\\t                BackendRuntimeStatus::InitFailed\\\\n   418\\\\t                    | BackendRuntimeStatus::Failed\\\\n   419\\\\t                    | BackendRuntimeStatus::Stopped\\\\n   420\\\\t            ) && let Some(pending) = self.pending_backend_runtimes.remove(&interface)\\\\n   421\\\\t            {\\\\n   422\\\\t                pending.slot.task.abort();\\\\n   423\\\\t                tracing::warn!(\\\\n   424\\\\t                    interface,\\\\n   425\\\\t                    provider_id,\\\\n   426\\\\t                    stage,\\\\n   427\\\\t                    \\\\\\\"provider switch failed; keeping the current runtime active\\\\\\\"\\\\n   428\\\\t                );\\\\n   429\\\\t            }\\\\n   430\\\\t            return;\\\\n   431\\\\t        }\\\\n   432\\\\t        let event_provider_is_current = self\\\\n   433\\\\t            .backend_runtimes\\\\n   434\\\\t            .get(&interface)\\\\n   435\\\\t            .is_some_and(|slot| slot.provider_id == provider_id);\\\\n   436\\\\t        if runtime_status == BackendRuntimeStatus::Running && event_provider_is_current {\\\\n   437\\\\t            self.note_backend_running(&interface);\\\\n   438\\\\t        }\\\\n   439\\\