                },\n   701\t                    accessibility_shortcut: format_shortcut_for_accessibility(&shortcut),\n   702\t                }\n   703\t            })\n   704\t            .collect()\n   705\t    }\n   706\t\n   707\t    fn resolve_surface_shortcut_declaration(\n   708\t        &self,\n   709\t        declaration: &SurfaceShortcutDeclaration,\n   710\t        override_key: Option<String>,\n   711\t        active_locale: &str,\n   712\t    ) -> Option<ResolvedSurfaceShortcut> {\n   713\t        if let Some(key) = override_key {\n   714\t            let kind = declaration.generic_trigger.kind;\n   715\t            let modifiers = declaration.generic_trigger.modifiers.clone();\n","exit_code":0,"status":"completed"}}
