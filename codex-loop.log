 args: &HashMap<String, String>,\n   680\t    ) -> Option<&'a str> {\n   681\t        if let Some(module_locales) = self.catalogs.modules.get(module_id) {\n   682\t            for locale in self.selection.chain() {\n   683\t                if let Some(entry) = module_locales.get(locale).and_then(|m| m.get(key)) {\n   684\t                    return entry.resolve(args, self.current());\n   685\t                }\n   686\t            }\n   687\t        }\n   688\t        None\n   689\t    }\n   690\t\n   691\t    fn effective_core_translations(&self) -> HashMap<String, String> {\n   692\t        let mut messages = HashMap::new();\n   693\t        for locale in self.selection.chain().iter().rev() {\n   694\t            if let Some(catalog) = self.catalogs.core.get(locale) {\n   695\t                messages.extend(catalog.iter().filter_map(|(key, entry)| {\n   696\t                    entry\n   697\t                        .default_text()\n   698\t                        .map(|value| (key.clone(), value.to_string()))\n   699\t                }));\n   700\t            }\n   701\t        }\n   702\t        messages\n   703\t    }\n   704\t\n   705\t    fn effective_module_translations(&self, module_id: &str) -> HashMap<String, String> {\n   706\t        let mut messages = HashMap::new();\n   707\t        if let Some(module_locales) = self.catalogs.modules.get(module_id) {\n   708\t            for locale in self.selection.chain().iter().rev() {\n   709\t                if let Some(catalog) = module_locales.get(locale) {\n   710\t                    messages.extend(catalog.iter().filter_map(|(key, entry)| {\n   711\t                        entry\n   712\t                            .default_text()\n   713\t                            .map(|value| (key.clone(), value.to_string()))\n   714\t                    }));\n   715\t                }\n   716\t            }\n   717\t        }\n   718\t        messages\n   719\t    }\n   720\t\n   721\t    fn effective_module_entries(&self, module_id: &str) -> HashMap<String, CatalogEntry> {\n   722\t        let mut messages = HashMap::new();\n   723\t        if let Some(module_locales) = self.catalogs.modules.get(module_id) {\n   724\t            for locale in self.selection.chain().iter().rev() {\n   725\t                if let Some(catalog) = module_locales.get(locale) {\n   726\t                    messages.extend(catalog.clone());\n   727\t                }\n   728\t            }\n   729\t        }\n   730\t        messages\n   731\t    }\n   732\t\n   733\t    pub fn fallback_chain(&self) -> &[String] {\n   734\t        self.selection.chain()\n   735\t    }\n   736\t}\n   737\t\n   738\tfn catalog_locale(locale: &str) -> String {\n   739\t    canonicalize_locale_tag(locale).unwrap_or_else(|_| locale.trim().to_string())\n   740\t}\n   741\t\n   742\tfn canonicalize_locale_tag(raw: &str) -> Result<String, LocaleError> {\n   743\t    let raw = raw.trim();\n   744\t    if raw.is_empty() {\n   745\t        return Err(LocaleError::EmptyTag);\n   746\t    }\n   747\t    let parts = raw.split('-').collect::<Vec<_>>();\n   748\t    if parts.iter().any(|part| part.is_empty()) {\n   749\t        return Err(LocaleError::InvalidTag {\n   750\t            tag: raw.to_string(),\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_29","type":"agent_message","text":"The handoff is accurate on the next open item, but the current code confirms the missing pieces are split across two boundaries: manifests/graphs have no language-pack target or ordered selection, while `LocaleEngine` collapses all sources into one map and cannot report a winner. I’m implementing the smallest shared model that preserves existing module-owned catalogs, adds explicit pack layering, and keeps provenance attached to each winning entry."}}
