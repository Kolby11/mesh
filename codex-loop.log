ead locale catalog {path}: {source}\")]\n   157\t    Read {\n   158\t        path: PathBuf,\n   159\t        source: std::io::Error,\n   160\t    },\n   161\t    #[error(\"failed to parse locale catalog {path}: {source}\")]\n   162\t    Parse {\n   163\t        path: PathBuf,\n   164\t        source: serde_json::Error,\n   165\t    },\n   166\t}\n   167\t\n   168\t#[derive(Debug, Clone)]\n   169\tpub struct CatalogSourceDiagnostics {\n   170\t    pub module_id: String,\n   171\t    pub locale: String,\n   172\t    pub path: PathBuf,\n   173\t    pub diagnostics: Vec<CatalogDiagnostic>,\n   174\t}\n   175\t\n   176\t#[derive(Debug, Clone, Default, PartialEq, Eq)]\n   177\tpub struct LocaleCatalogSnapshot {\n   178\t    revision: u64,\n   179\t    core: HashMap<String, HashMap<String, CatalogEntry>>,\n   180\t    modules: HashMap<String, HashMap<String, HashMap<String, CatalogEntry>>>,\n   181\t}\n   182\t\n   183\timpl LocaleCatalogSnapshot {\n   184\t    pub fn revision(&self) -> u64 {\n   185\t        self.revision\n   186\t    }\n   187\t}\n   188\t\n   189\t#[derive(Debug, Clone)]\n   190\tpub struct PreparedLocaleCatalogSnapshot {\n   430\t\n   431\t    pub fn translations(&self) -> HashMap<String, String> {\n   432\t        self.engine.effective_core_translations()\n   433\t    }\n   434\t}\n   435\t\n   436\t#[derive(Debug, Clone)]\n   437\tpub struct LocaleEngine {\n   438\t    selection: LocaleSelection,\n   439\t    catalogs: Arc<LocaleCatalogSnapshot>,\n   440\t}\n   441\t\n   442\timpl LocaleEngine {\n   443\t    pub fn new(default_locale: impl Into<String>) -> Self {\n   444\t        Self::with_fallback_locale(default_locale, \"en\")\n   445\t    }\n   446\t\n   447\t    pub fn try_with_fallback_locale(\n   448\t        default_locale: impl Into<String>,\n   449\t        fallback_locale: impl Into<String>,\n   450\t    ) -> Result<Self, LocaleError> {\n   451\t        Ok(Self {\n   452\t            selection: LocaleSelection::try_new(default_locale.into(), fallback_locale.into(), 1)?,\n   453\t            catalogs: Arc::new(LocaleCatalogSnapshot::default()),\n   454\t        })\n   455\t    }\n   456\t\n   457\t    pub fn with_fallback_locale(\n   458\t        default_locale: impl Into<String>,\n   459\t        fallback_locale: impl Into<String>,\n   460\t    ) -> Self {\n   461\t        match Self::try_with_fallback_locale(default_locale, fallback_locale) {\n   462\t            Ok(engine) => engine,\n   463\t            Err(error) => {\n   464\t                tracing::warn!(%error, \"invalid locale selection; using en\");\n   465\t                Self::try_with_fallback_locale(\"en\", \"en\")\n   466\t                    .expect(\"the built-in en locale must be valid\")\n   467\t            }\n   468\t        }\n   469\t    }\n   470\t\n   471\t    pub fn selection(&self) -> &LocaleSelection {\n   472\t        &self.selection\n   473\t    }\n   474\t\n   475\t    pub fn direction(&self) -> LocaleDirection {\n   476\t        self.selection.direction()\n   477\t    }\n   478\t\n   479\t    pub fn revision(&self) -> u64 {\n   480\t        self.selection.revision()\n   481\t    }\n   482\t\n   483\t    pub fn fallback_locale(&self) -> &str {\n   484\t        self.selection.fallback()\n   485\t    }\n   486\t\n   487\t    /// Adopt an already validated selection while retaining loaded catalogs.\n   488\t    pub fn replace_selection(&mut self, selection: &LocaleSelection) {\n   489\t        self.selection = selection.clone();\n   490\t    }\n   491\t\n   492\t    pub fn catalog_snapshot(&self) -> Arc<LocaleCatalogSnapshot> {\n   493\t        Arc::clone(&self.catalogs)\n   494\t    }\n   495\t\n   496\t    /// Replace the catalog pointer after a complete candidate has been\n   497\t    /// prepared. Existing readers retaining the prior Arc keep last-known-good\n   498\t    /// data until the replacement is committed.\n   499\t    pub fn replace_catalog_snapshot(&mut self, snapshot: Arc<LocaleCatalogSnapshot>) {\n   500\t        self.catalogs = snapshot;\n   501\t    }\n   502\t\n   503\t    /// Prepare a complete replacement catalog without changing this engine.\n   504\t    /// Every source must be readable and parseable before the returned Arc can\n   505\t    /// be committed. Structured entry diagnostics are non-fatal so valid\n   506\t    /// siblings remain available in the candidate.\n   507\t    pub fn prepare_module_catalog_snapshot(\n   508\t        &self,\n   509\t        sources: &[(String, String, PathBuf)],\n   510\t    ) -> Result<PreparedLocaleCatalogSnapshot, LocaleCatalogLoadError> {\n   511\t        let mut snapshot = LocaleCatalogSnapshot {\n   512\t            revision: self.catalogs.revision.saturating_add(1),\n   513\t            core: HashMap::new(),\n   514\t            modules: HashMap::new(),\n   515\t        };\n   516\t        let mut diagnostics = Vec::new();\n   517\t\n   518\t        for (module_id, locale, path) in sources {\n   519\t            let content =\n   520\t                std::fs::read_to_string(path).map_err(|source| LocaleCatalogLoadError::Read {\n   521\t                    path: path.clone(),\n   522\t                    source,\n   523\t                })?;\n   524\t            let value =\n   525\t                serde_json::from_str(&content).map_err(|source| LocaleCatalogLoadError::Parse {\n   526\t                    path: path.clone(),\n   527\t                    source,\n   528\t                })?;\n   529\t            let catalog = compile_catalog(locale.clone(), &value);\n   530\t            if !catalog.diagnostics.is_empty() {\n   531\t                diagnostics.push(CatalogSourceDiagnostics {\n   532\t                    module_id: module_id.clone(),\n   533\t                    locale: locale.clone(),\n   534\t                    path: path.clone(),\n   535\t                    diagnostics: catalog.diagnostics,\n   536\t                });\n   537\t            }\n   538\t            snapshot\n   539\t                .modules\n   540\t                .entry(module_id.clone())\n   541\t                .or_default()\n   542\t                .entry(catalog_locale(locale))\n   543\t                .or_default()\n   544\t                .extend(catalog.messages);\n   545\t        }\n   546\t\n   547\t        Ok(PreparedLocaleCatalogSnapshot {\n   548\t            snapshot: Arc::new(snapshot),\n   549\t            diagnostics,\n   550\t        })\n   551\t    }\n   552\t\n   553\t    pub fn try_set_locale(&mut self, locale: impl AsRef<str>) -> Result<bool, LocaleError> {\n   554\t        let next = LocaleSelection::try_new(\n   555\t            locale,\n   556\t            self.selection.fallback(),\n   557\t            self.selection.revision().saturating_add(1),\n   558\t        )?;\n   559\t        if next.active == self.selection.active && next.fallback == self.selection.fallback {\n   560\t            return Ok(false);\n   561\t        }\n   562\t        self.selection = next;\n   563\t        Ok(true)\n   564\t    }\n   565\t\n   566\t    pub fn current(&self) -> &str {\n   567\t        self.selection.active()\n   568\t    }\n   569\t\n   570\t    pub fn set_locale(&mut self, locale: impl Into<String>) {\n   571\t        if let Err(error) = self.try_set_locale(locale.into()) {\n   572\t            tracing::warn!(%error, \"ignoring invalid locale selection\");\n   573\t        }\n   574\t    }\n   575\t\n   576\t    /// Load a catalog owned by the explicit core domain.\n   577\t    pub fn load_core_translations(&mut self, set: TranslationSet) {\n   578\t        let locale = catalog_locale(&set.locale);\n   579\t        let catalogs = Arc::make_mut(&mut self.catalogs);\n   580\t        catalogs.core.entry(locale).or_default().extend(\n   581\t            set.messages\n   582\t                .into_iter()\n   583\t                .map(|(key, value)| (key, CatalogEntry::Text(value))),\n   584\t        );\n   585\t        catalogs.revision = catalogs.revision.saturating_add(1);\n   586\t    }\n   587\t\n   588\t    pub fn load_core_catalog(&mut self, catalog: CompiledCatalog) {\n   589\t        let locale = catalog_locale(&catalog.locale);\n   590\t        let catalogs = Arc::make_mut(&mut self.catalogs);\n   591\t        catalogs\n   592\t            .core\n   593\t            .entry(locale)\n   594\t            .or_default()\n   595\t            .extend(catalog.messages);\n   596\t        catalogs.revision = catalogs.revision.saturating_add(1);\n   597\t    }\n   598\t\n   599\t    pub fn module_translator(&self, module_id: &str) -> ModuleTranslator<'_> {\n   600\t        ModuleTranslator {\n   601\t            engine: self,\n   602\t            module_id: module_id.to_string(),\n   603\t        }\n   604\t    }\n   605\t\n   606\t    pub fn core_translator(&self) -> CoreTranslator<'_> {\n   607\t        CoreTranslator { engine: self }\n   608\t    }\n   609\t\n   610\t    /// Load a catalog owned by one module. It is never copied into the core\n   611\t    /// domain, so one module cannot shadow another module's keys.\n   612\t    pub fn load_module_translations(&mut self, module_id: &str, set: TranslationSet) {\n   613\t        let locale = catalog_locale(&set.locale);\n   614\t        let catalogs = Arc::make_mut(&mut self.catalogs);\n   615\t        catalogs\n   616\t            .modules\n   617\t            .entry(module_id.to_string())\n   618\t            .or_default()\n   619\t            .entry(locale)\n   620\t            .or_default()\n   621\t            .extend(\n   622\t                set.messages\n   623\t                    .into_iter()\n   624\t                    .map(|(key, value)| (key, CatalogEntry::Text(value))),\n   625\t            );\n   626\t        catalogs.revision = catalogs.revision.saturating_add(1);\n   627\t    }\n   628\t\n   629\t    pub fn load_module_catalog(&mut self, module_id: &str, catalog: CompiledCatalog) {\n   630\t        let locale = catalog_locale(&catalog.locale);\n   631\t        let catalogs =