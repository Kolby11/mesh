<(), ShellRunError> {\n   653\t        let locale = self.locale.clone();\n   654\t        let locale_id = locale.current().to_string();\n   655\t        for runtime in &mut self.components {\n   656\t            runtime\n   657\t                .component\n   658\t                .locale_changed(&locale)\n   659\t                .map_err(ShellRunError::Component)?;\n   660\t            runtime.parent.force_full_present = true;\n   661\t        }\n   662\t        let _ = self.broadcast_core_event(CoreEvent::LocaleChanged { locale: locale_id })?;\n   663\t        Ok(())\n   664\t    }\n   665\t\n   666\t    pub(in crate::shell) fn apply_set_locale(\n   667\t        &mut self,\n   668\t        locale: &str,\n   669\t    ) -> Result<VecDeque<CoreRequest>, ShellRunError> {\n   670\t        let locale = locale.trim();\n   671\t        if locale.is_empty() {\n   672\t            tracing::warn!(\"ignoring empty locale request\");\n   673\t            return Ok(VecDeque::new());\n   674\t        }\n   675\t        match self.locale.try_set_locale(locale) {\n   676\t            Ok(false) => return self.sync_locale_service_state(),\n   677\t            Ok(true) => tracing::info!(\"active locale changed to '{}'\", self.locale.current()),\n   678\t            Err(error) => {\n   679\t                tracing::warn!(%error, \"ignoring invalid locale request\");\n   680\t                return self.sync_locale_service_state();\n   681\t            }\n   682\t        }\n   683\t        self.mark_components_locale_changed()?;\n   684\t        self.sync_locale_service_state()\n   685\t    }\n   686\t\n   687\t    pub(in crate::shell) fn sync_locale_service_state(\n   688\t        &mut self,\n   689\t    ) -> Result<VecDeque<CoreRequest>, ShellRunError> {\n   690\t        let selection = self.locale.selection();\n   691\t        let locale = selection.active().to_string();\n   692\t        let chain = selection.chain().to_vec();\n   693\t        let direction = selection.direction().as