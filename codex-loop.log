{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/core/foundation/config/src/settings.rs | sed -n '360,760p'\"","aggregated_output":"   360\t\n   361\t    /// Merge overrides into a namespace, keeping unrelated stored keys.\n   362\t    pub fn merge_namespace(&mut self, name: &str, value: &JsonValue) {\n   363\t        let mut current = self.stored(name);\n   364\t        merge_json(&mut current, value);\n   365\t        self.set_namespace(name, current);\n   366\t    }\n   367\t\n   368\t    /// Drop every override in a namespace; declared defaults win again.\n   369\t    pub fn reset_namespace(&mut self, name: &str) {\n   370\t        self.set_namespace(name, JsonValue::Null);\n   371\t    }\n   372\t\n   373\t    /// The full document as written to disk, in `BTreeMap` key order so saves\n   374\t    /// diff cleanly regardless of which namespace was touched.\n   375\t    pub fn to_value(&self) -> JsonValue {\n   376\t        let mut root = self.root.clone();\n   377\t        root.insert(\n   378\t            SCHEMA_VERSION_KEY.to_string(),\n   379\t            JsonValue::from(SETTINGS_SCHEMA_VERSION),\n   380\t        );\n   381\t        JsonValue::Object(root)\n   382\t    }\n   383\t\n   384\t    /// Write the store through a unique owner-only temporary file, syncing the\n   385\t    /// file before the atomic rename and the parent directory afterwards.\n   386\t    ///\n   387\t    /// A failure before the rename leaves the previous settings file intact.\n   388\t    pub fn save(&self) -> Result<(), ConfigError> {\n   389\t        let parent = settings_parent(&self.path);\n   390\t        ensure_settings_directory(parent)?;\n   391\t        let mut content = serde_json::to_string_pretty(&self.to_value())?;\n   392\t        content.push('\\n');\n   393\t        let (temporary, mut file) = create_settings_temporary(&self.path, parent)?;\n   394\t        let result = (|| {\n   395\t            let file_result = (|| {\n   396\t                file.write_all(content.as_bytes())?;\n   397\t                file.sync_all()\n   398\t            })();\n   399\t            drop(file);\n   400\t            file_result?;\n   401\t            fs::rename(&temporary, &self.path)?;\n   402\t            sync_settings_directory(parent)\n   403\t        })();\n   404\t        if let Err(error) = result {\n   405\t            let _ = fs::remove_file(&temporary);\n   406\t            return Err(error.into());\n   407\t        }\n   408\t        Ok(())\n   409\t    }\n   410\t\n   411\t    fn stored(&self, name: &str) -> JsonValue {\n   412\t        self.root\n   413\t            .get(name)\n   414\t            .cloned()\n   415\t            .unwrap_or_else(|| JsonValue::Object(JsonMap::new()))\n   416\t    }\n   417\t\n   418\t    fn resolved_stored(&self, name: &str) -> JsonValue {\n   419\t        if self.schemas.get(name).is_some() {\n   420\t            return self\n   421\t                .validated_root\n   422\t                .get(name)\n   423\t                .cloned()\n   424\t                .unwrap_or_else(|| JsonValue::Object(JsonMap::new()));\n   425\t        }\n   426\t        self.stored(name)\n   427\t    }\n   428\t\n   429\t    fn rebuild_validation(&mut self) {\n   430\t        let (shell, shell_diagnostics) = resolve_shell_settings(&self.root);\n   431\t        let mut diagnostics = self.document_diagnostics.clone();\n   432\t        diagnostics.extend(shell_diagnostics);\n   433\t        let mut validated_root = JsonMap::new();\n   434\t        for (name, value) in &self.root {\n   435\t            let base = name.split('#').next().unwrap_or(name);\n   436\t            let Some(schema) = self.schemas.get(base) else {\n   437\t                continue;\n   438\t            };\n   439\t            let validated = validate_json_schema(name, \"\", &schema.schema, value, &mut diagnostics);\n   440\t            if !validated.is_null() {\n   441\t                validated_root.insert(name.clone(), validated);\n   442\t            }\n   443\t        }\n   444\t        self.shell = shell;\n   445\t        self.diagnostics = diagnostics;\n   446\t        self.validated_root = validated_root;\n   447\t    }\n   448\t}\n   449\t\n   450\tfn settings_parent(path: &Path) -> &Path {\n   451\t    path.parent()\n   452\t        .filter(|parent| !parent.as_os_str().is_empty())\n   453\t        .unwrap_or_else(|| Path::new(\".\"))\n   454\t}\n   455\t\n   456\tfn ensure_settings_directory(parent: &Path) -> io::Result<()> {\n   457\t    #[cfg(unix)]\n   458\t    {\n   459\t        use std::os::unix::fs::DirBuilderExt;\n   460\t\n   461\t        fs::DirBuilder::new()\n   462\t            .recursive(true)\n   463\t            .mode(0o700)\n   464\t            .create(parent)?;\n   465\t    }\n   466\t    #[cfg(not(unix))]\n   467\t    {\n   468\t        fs::create_dir_all(parent)?;\n   469\t    }\n   470\t    Ok(())\n   471\t}\n   472\t\n   473\tfn create_settings_temporary(path: &Path, parent: &Path) -> io::Result<(PathBuf, File)> {\n   474\t    let file_name = path\n   475\t        .file_name()\n   476\t        .and_then(|name| name.to_str())\n   477\t        .unwrap_or(\"settings.json\");\n   478\t\n   479\t    for _ in 0..128 {\n   480\t        let sequence = TEMP_FILE_SEQUENCE.fetch_add(1, Ordering::Relaxed);\n   481\t        let temporary = parent.join(format!(\n   482\t            \".{file_name}.tmp-{}-{sequence}\",\n   483\t            std::process::id()\n   484\t        ));\n   485\t        let mut options = OpenOptions::new();\n   486\t        options.write(true).create_new(true);\n   487\t        #[cfg(unix)]\n   488\t        {\n   489\t            use std::os::unix::fs::OpenOptionsExt;\n   490\t\n   491\t            options.mode(0o600);\n   492\t        }\n   493\t        match options.open(&temporary) {\n   494\t            Ok(file) => return Ok((temporary, file)),\n   495\t            Err(error) if error.kind() == io::ErrorKind::AlreadyExists => continue,\n   496\t            Err(error) => return Err(error),\n   497\t        }\n   498\t    }\n   499\t\n   500\t    Err(io::Error::new(\n   501\t        io::ErrorKind::AlreadyExists,\n   502\t        format!(\n   503\t            \"could not allocate a unique temporary settings file in {}\",\n   504\t            parent.display()\n   505\t        ),\n   506\t    ))\n   507\t}\n   508\t\n   509\tfn sync_settings_directory(parent: &Path) -> io::Result<()> {\n   510\t    #[cfg(unix)]\n   511\t    {\n   512\t        File::open(parent)?.sync_all()\n   513\t    }\n   514\t    #[cfg(not(unix))]\n   515\t    {\n   516\t        let _ = parent;\n   517\t        Ok(())\n   518\t    }\n   519\t}\n   520\t\n   521\tfn validate_schema_definition(schema: &JsonValue, path: &str) -> Result<(), SettingsSchemaError> {\n   522\t    let Some(schema) = schema.as_object() else {\n   523\t        return Err(SettingsSchemaError::InvalidSchema {\n   524\t            path: path.to_string(),\n   525\t            message: \"schema must be an object\".into(),\n   526\t        });\n   527\t    };\n   528\t    if let Some(kind) = schema.get(\"type\") {\n   529\t        let Some(kind) = kind.as_str() else {\n   530\t            return Err(SettingsSchemaError::InvalidSchema {\n   531\t                path: join_schema_path(path, \"type\"),\n   532\t                message: \"type must be a string\".into(),\n   533\t            });\n   534\t        };\n   535\t        if !matches!(\n   536\t            kind,\n   537\t            \"any\"\n   538\t                | \"object\"\n   539\t                | \"array\"\n   540\t                | \"string\"\n   541\t                | \"str\"\n   542\t                | \"size\"\n   543\t                | \"duration\"\n   544\t                | \"color\"\n   545\t                | \"enum\"\n   546\t                | \"boolean\"\n   547\t                | \"bool\"\n   548\t                | \"integer\"\n   549\t                | \"int\"\n   550\t                | \"number\"\n   551\t                | \"float\"\n   552\t        ) {\n   553\t            return Err(SettingsSchemaError::InvalidSchema {\n   554\t                path: join_schema_path(path, \"type\"),\n   555\t                message: format!(\"unsupported type '{kind}'\"),\n   556\t            });\n   557\t        }\n   558\t    }\n   559\t    if let Some(properties) = schema.get(\"properties\") {\n   560\t        let Some(properties) = properties.as_object() else {\n   561\t            return Err(SettingsSchemaError::InvalidSchema {\n   562\t                path: join_schema_path(path, \"properties\"),\n   563\t                message: \"properties must be an object\".into(),\n   564\t            });\n   565\t        };\n   566\t        for (key, child) in properties {\n   567\t            validate_schema_definition(child, &join_schema_path(path, key))?;\n   568\t        }\n   569\t    }\n   570\t    if let Some(items) = schema.get(\"items\") {\n   571\t        validate_schema_definition(items, &join_schema_path(path, \"items\"))?;\n   572\t    }\n   573\t    if let Some(additional) = schema.get(\"additionalProperties\") {\n   574\t        if !additional.is_boolean() && !additional.is_object() {\n   575\t            return Err(SettingsSchemaError::InvalidSchema {\n   576\t                path: join_schema_path(path, \"additionalProperties\"),\n   577\t                message: \"additionalProperties must be a boolean or schema object\".into(),\n   578\t            });\n   579\t        }\n   580\t        if additional.is_object() {\n   581\t            validate_schema_definition(\n   582\t                additional,\n   583\t                &join_schema_path(path, \"additionalProperties\"),\n   584\t            )?;\n   585\t        }\n   586\t    }\n   587\t    for bound in [\"minimum\", \"maximum\"] {\n   588\t        if let Some(value) = schema.get(bound)\n   589\t            && !value.is_number()\n   590\t        {\n   591\t            return Err(SettingsSchemaError::InvalidSchema {\n   592\t                path: join_schema_path(path, bound),\n   593\t                message: \"numeric bounds must be numbers\".into(),\n   594\t            });\n   595\t        }\n   596\t    }\n   597\t    if let Some(enumeration) = schema.get(\"enum\")\n   598\t        && !enumeration.is_array()\n   599\t    {\n   600\t        return Err(SettingsSchemaError::InvalidSchema {\n   601\t            path: join_schema_path(path, \"enum\"),\n   602\t            message: \"enum must be an array\".into(),\n   603\t        });\n   604\t    }\n   605\t    Ok(())\n   606\t}\n   607\t\n   608\tfn join_schema_path(prefix: &str, key: &str) -> String {\n   609\t    if prefix.is_empty() {\n   610\t        key.to_string()\n   611\t    } else {\n   612\t        format!(\"{prefix}.{key}\")\n   613\t    }\n   614\t}\n   615\t\n   616\t/// `MESH_SETTINGS_PATH` wins; otherwise a checked-out repo uses\n   617\t/// `config/settings.json` so a dev shell stays out of the user's dotfiles.\n   618\tpub fn default_settings_path() -> PathBuf {\n   619\t    if let Ok(path) = std::env::var(\"MESH_SETTINGS_PATH\") {\n   620\t        if !path.trim().is_empty() {\n   621\t            return PathBuf::from(path);\n   622\t        }\n   623\t    }\n   624\t\n   625\t    let repo_path = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n   626\t        .join(\"../../../..\")\n   627\t        .join(\"config/settings.json\");\n   628\t    if repo_path.exists() {\n   629\t        return repo_path;\n   630\t    }\n   631\t\n   632\t    mesh_home_path().join(\"settings.json\")\n   633\t}\n   634\t\n   635\t/// Load just the core shell preferences.\n   636\tpub fn load_shell_settings() -> Result<ShellSettings, ConfigError> {\n   637\t    Ok(SettingsStore::load()?.shell)\n   638\t}\n   639\t\n   640\t/// Objects merge key by key so setting one field does not erase its siblings.\n   641\t/// Every other kind replaces wholesale: a stored array (a pack chain, a key\n   642\t/// list) is a complete replacement by intent.\n   643\tpub fn merge_json(base: &mut JsonValue, overlay: &JsonValue) {\n   644\t    match (base, overlay) {\n   645\t        (JsonValue::Object(base), JsonValue::Object(overlay)) => {\n   646\t            for (key, value) in overlay {\n   647\t                match base.get_mut(key) {\n   648\t                    Some(existing) => merge_json(existing, value),\n   649\t                    None => {\n   650\t                        base.insert(key.clone(), value.clone());\n   651\t                    }\n   652\t                }\n   653\t            }\n   654\t        }\n   655\t        (base, overlay) => *base = overlay.clone(),\n   656\t    }\n   657\t}\n   658\t\n   659\t/// Resolve the `\"shell\"` namespace, dropping and reporting what it cannot use.\n   660\t///\n   661\t/// Infallible on purpose: a hand-edited file must never stop the shell from\n   662\t/// starting. Values are checked against [`SHELL_SETTINGS_FIELDS`] before the\n   663\t/// merge, so serde only ever sees well-typed input.\n   664\tfn resolve_shell_settings(\n   665\t    root: &JsonMap<String, JsonValue>,\n   666\t) -> (ShellSettings, Vec<SettingsDiagnostic>) {\n   667\t    let mut diagnostics = validate_settings_root(root);\n   668\t\n   669\t    let overrides = root.get(SHELL_NAMESPACE).map(|overrides| {\n   670\t        validate_object(\n   671\t            SHELL_NAMESPACE,\n   672\t            \"\",\n   673\t            SHELL_SETTINGS_FIELDS,\n   674\t            overrides,\n   675\t            &mut diagnostics,\n   676\t        )\n   677\t    });\n   678\t\n   679\t    let mut resolved = match serde_json::to_value(ShellSettings::default()) {\n   680\t        Ok(value) => value,\n   681\t        Err(_) => return (ShellSettings::default(), diagnostics),\n   682\t    };\n   683\t    if let Some(overrides) = &overrides {\n   684\t        merge_json(&mut resolved, overrides);\n   685\t    }\n   686\t\n   687\t    match serde_json::from_value(resolved) {\n   688\t        Ok(settings) => (settings, diagnostics),\n   689\t        Err(err) => {\n   690\t            // Reaching here means the schema table and `ShellSettings` disagree.\n   691\t            diagnostics.push(SettingsDiagnostic::error(\n   692\t                SHELL_NAMESPACE,\n   693\t                \"\",\n   694\t                format!(\"could not be applied: {err}\"),\n   695\t                \"report this as a MESH bug; the whole namespace fell back to its defaults\",\n   696\t            ));\n   697\t            (ShellSettings::default(), diagnostics)\n   698\t        }\n   699\t    }\n   700\t}\n   701\t\n   702\t/// Check the schema stamp and that other keys look like ownable namespaces.\n   703\tfn validate_settings_root(root: &JsonMap<String, JsonValue>) -> Vec<SettingsDiagnostic> {\n   704\t    const ROOT_KEYS: &[&str] = &[SHELL_NAMESPACE, SCHEMA_VERSION_KEY];\n   705\t    let mut diagnostics = Vec::new();\n   706\t\n   707\t    for (key, value) in root {\n   708\t        match key.as_str() {\n   709\t            SCHEMA_VERSION_KEY => match value.as_u64() {\n   710\t                Some(version) if version > SETTINGS_SCHEMA_VERSION => {\n   711\t                    diagnostics.push(SettingsDiagnostic::warning(\n   712\t                        key.clone(),\n   713\t                        \"\",\n   714\t                        format!(\n   715\t                            \"schema version {version} is newer than this build understands \\\n   716\t                             ({SETTINGS_SCHEMA_VERSION})\"\n   717\t                        ),\n   718\t                        \"some values may be ignored; update MESH or check the file by hand\",\n   719\t                    ));\n   720\t                }\n   721\t                Some(_) => {}\n   722\t                None => diagnostics.push(SettingsDiagnostic::error(\n   723\t                    key.clone(),\n   724\t                    \"\",\n   725\t                    format!(\"expected a non-negative integer, found {}\", describe(value)),\n   726\t                    format!(\"set it to {SETTINGS_SCHEMA_VERSION}\"),\n   727\t                )),\n   728\t            },\n   729\t            SHELL_NAMESPACE => {}\n   730\t            other if is_namespace_id(other) => {}\n   731\t            other => diagnostics.push(unknown_key_diagnostic_from(\"\", \"\", other, ROOT_KEYS)),\n   732\t        }\n   733\t    }\n   734\t\n   735\t    diagnostics\n   736\t}\n   737\t\n   738\t/// Shaped like `@scope/name[#instance]` or a dotted interface id. Whether the\n   739\t/// owner exists is `config doctor`'s question; this only avoids mistaking a\n   740\t/// real namespace for a typo of `shell`.\n   741\tfn is_namespace_id(key: &str) -> bool {\n   742\t    let base = key.split('#').next().unwrap_or(key);\n   743\t    (base.starts_with('@') && base.contains('/')) || base.contains('.')\n   744\t}\n   745\t\n   746\tfn json_type_name(value: &JsonValue) -> &'static str {\n   747\t    match value {\n   748\t        JsonValue::Null => \"null\",\n   749\t        JsonValue::Bool(_) => \"a boolean\",\n   750\t        JsonValue::Number(_) => \"a number\",\n   751\t        JsonValue::String(_) => \"a string\",\n   752\t        JsonValue::Array(_) => \"an array\",\n   753\t        JsonValue::Object(_) => \"an object\",\n   754\t    }\n   755\t}\n   756\t\n   757\tfn non_object_document_diagnostic(source: &str, value: &JsonValue) -> SettingsDiagnostic {\n   758\t    SettingsDiagnostic::error(\n   759\t        \"\",\n   760\t        \"\",\n","exit_code":0,"status":"completed"}}
