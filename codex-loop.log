   587\t            &self.modules,\n   588\t            Some(&graph),\n   589\t            Some(&previous_catalog),\n   590\t        ) {\n   591\t            Ok(catalog) => catalog,\n   592\t            Err(error) => {\n   593\t                self.reject_profile_switch(profile_id, error.to_string());\n   594\t                return VecDeque::new();\n   595\t            }\n   596\t        };\n   597\t        let temporary_catalog = FrontendCatalogHandle::from(catalog.clone());\n   598\t        let entries = catalog\n   599\t            .top_level_surfaces()\n   600\t            .into_iter()\n   601\t            .map(|entry| (entry.compiled.manifest.package.id.clone(), entry))\n   602\t            .collect::<HashMap<_, _>>();\n   603\t        let desired_surfaces = profile\n   604\t            .roots\n   605\t            .iter()\n   606\t            .filter(|(_, root)| root.active)\n   607\t            .map(|(instance_id, _)| instance_id.clone())\n   608\t            .collect::<HashSet<_>>();\n   609\t        let existing_surfaces = self\n   610\t            .components\n   921\t    fn commit_pending_profile_switch(&mut self) -> VecDeque<CoreRequest> {\n   922\t        let Some(mut pending) = self.pending_profile_switch.take() else {\n   923\t            return VecDeque::new();\n   924\t        };\n   925\t        let paths = match ProfilePaths::from_root_graph(&self.installed_module_graph_path()) {\n   926\t            Ok(paths) => paths,\n   927\t            Err(error) => {\n   928\t                self.abort_profile_candidate(pending, error.to_string());\n   929\t                return VecDeque::new();\n   930\t            }\n   931\t        };\n   932\t        if let Err(error) = paths.set_active(&pending.profile_id) {\n   933\t            self.abort_profile_candidate(pending, error.to_string());\n   934\t            return VecDeque::new();\n   935\t        }\n   936\t\n   937\t        self.frontend_catalog.replace(pending.catalog, None);\n   938\t        for prepared in &mut pending.prepared_frontends {\n   939\t            prepared\n   940\t                .component\n   941\t                .adopt_frontend_catalog(self.frontend_catalog.clone());\n   942\t        }\n   943\t        for index in (0..self.components.len()).rev() {\n   944\t            if !pending\n   945\t                .desired_surfaces\n   946\t                .contains(&self.components[index].surface_id)\n   947\t            {\n   948\t                self.remove_profile_component(index);\n   949\t            }\n   950\t        }\n  1050\t            self.publish_backend_health(\n  1051\t                &interface,\n  1052\t                &provider_id,\n  1053\t                BackendRuntimeStatus::Running,\n  1054\t                \"backend runtime ready\",\n  1055\t                true,\n  1056\t            );\n  1057\t        }\n  1058\t        if let Ok(next) = self.sync_composition_service_state() {\n  1059\t            requests.extend(next);\n  1060\t        }\n  1061\t        self.sync_frontend_catalog_components();\n  1062\t        self.components_want_render = true;\n  1063\t        tracing::info!(\n  1064\t            profile_id = pending.profile_id,\n  1065\t            \"switched shell profile live\"\n  1066\t        );\n  1067\t        requests\n  1068\t    }\n  1069\t\n  1070\t    fn remove_profile_component(&mut self, index: usize) {\n  1071\t        let surface_id = self.components[index].surface_id.clone();\n  1072\t        let module_id = self.components[index].component.id().to_string();\n  1073\t        self.destroy_all_child_surfaces(index);\n  1074\t        self.presentation_engine.destroy_surface(&surface_id);\n  1075\t        self.components.remove(index);\n  1076\t        self.diagnostics.unregister(&module_id, &surface_id);\n  1077\t        self.core.surfaces.remove(&surface_id);\n  1078\t        self.surfaces.remove(&surface_id);\n  1079\t        self.pending_popover_hides.remove(&surface_id);\n  1080\t        self.transfer_owned_keyboard_modes.remove(&surface_id);\n  1081\t        if self.keyboard_focus_surface.as_deref() == Some(surface_id.as_str()) {\n  1082\t            self.keyboard_focus_surface = None;\n  1083\t        }\n  1084\t        self.rebuild_component_surface_index();\n  1085\t        self.service_delivery_index.mark_dirty();\n  1086\t    }\n  1087\t\n  1088\t    fn abort_pending_profile_switch(&mut self, message: String) {\n  1089\t        if let Some(pending) = self.pending_profile_switch.take() {\n  1090\t            self.abort_profile_candidate(pending, message);\n  1091\t        }\n  1092\t    }\n  1093\t\n  1094\t    fn abort_profile_candidate(&mut self, pending: PendingProfileSwitch, message: String) {\n  1095\t        for slot in pending.candidate_backends.into_values() {\n  1096\t            slot.task.abort();\n  1097\t        }\n  1098\t        self.reject_profile_switch(&pending.profile_id, message);\n  1099\t    }\n  1100\t\n  1101\t    fn reject_profile_switch(&mut self, profile_id: &str, message: String) {\n  1102\t        tracing::warn!(profile_id, \"profile switch rejected: {message}\");\n  1103\t        self.diagnostics.record_lifecycle_error(\n  1104\t            \"@mesh/shell\",\n  1105\t            \"profile_switch_rejected\",\n  1106\t            format!(\"profile {profile_id}: {message}\"),\n  1107\t        );\n  1108\t    }\n  1109\t}\n  1110\t\n","exit_code":0,"status":"completed"}}
