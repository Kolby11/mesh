         self.locale.revision()\n   934\t        } else {\n   935\t            self.locale.revision().saturating_add(1)\n   936\t        };\n   937\t        let selection = mesh_core_locale::LocaleSelection::try_new(\n   938\t            requested.active(),\n   939\t            requested.fallback(),\n   940\t            revision,\n   941\t        )\n   942\t        .map_err(|error| ShellRunError::LocaleCatalog(error.to_string()))?;\n   943\t        let mut candidate = self.locale.clone();\n   944\t        candidate.replace_selection(&selection);\n   945\t        Ok(candidate)\n   946\t    }\n   947\t\n   948\t    /// Commit a graph and its prepared locale candidate as one in-memory\n   949\t    /// activation boundary. Callers that need to prepare runtime objects first\n   950\t    /// use `commit_installed_module_graph_with_locale` with the same candidate.\n  1440\t        let component_index = self.components.len();\n  1441\t        self.components.push(ComponentRuntime::new(component));\n  1442\t        self.component_by_surface\n  1443\t            .insert(surface_id, component_index);\n  1444\t        self.service_delivery_index.mark_dirty();\n  1445\t    }\n  1446\t\n  1447\t    pub(super) fn mount_components(&mut self) -> Result<VecDeque<CoreRequest>, ShellRunError> {\n  1448\t        let mut requests = VecDeque::new();\n  1449\t        for runtime in &mut self.components {\n  1450\t            let module_id = runtime.component.id().to_string();\n  1451\t            if let Some(module) = self.modules.get_mut(&module_id)\n  1452\t                && let Err(error) = module.mark_loaded()\n  1453\t            {\n  1454\t                tracing::warn!(module_id, \"frontend mount did not load module: {error}\");\n  1455\t            }\n  1456\t            let diagnostics = self\n  1457\t                .diagnostics\n  1458\t                .register_instance(module_id.clone(), runtime.surface_id.clone());\n  1459\t            let ctx = ComponentContext {\n  1460\t                component_id: module_id.clone(),\n  1461\t                surface_id: runtime.surface_id.clone(),\n  1462\t                diagnostics,\n  1463\t            };\n  1464\t            match runtime.component.mount(ctx) {\n  1465\t                Ok(component_requests) => {\n  1466\t                    requests.extend(component_requests);\n  1467\t                    if let Some(module) = self.modules.get_mut(&module_id) {\n  1468\t                        let _ = module.mark_initialized();\n  1469\t                        if let Err(error) = module.mark_running() {\n  1470\t                            tracing::warn!(\n  1471\t                                module_id,\n  1472\t                                \"frontend mount lifecycle transition failed: {error}\"\n  1473\t                            );\n  1474\t                        }\n  1475\t                    }\n  1476\t                }\n  1477\t                Err(error) => {\n  1478\t                    if let Some(module) = self.modules.get_mut(&module_id) {\n  1479\t                        let _ = module.mark_failed(error.to_string());\n  1480\t                    }\n  1481\t                    return Err(ShellRunError::Component(error));\n  1482\t                }\n  1483\t            }\n  1484\t        }\n  1485\t        // Mount first so module scripts can establish their service proxy;\n  1486\t        // then deliver the revisioned effective settings snapshot normally.\n  1487\t        requests.extend(self.sync_settings_service_state()?);\n  1488\t        requests.extend(self.sync_composition_service_state()?);\n  1489\t        self.service_delivery_index.mark_dirty();\n  1490\t        Ok(requests)\n  1491\t    }\n  1492\t}\n","exit_code":0,"status":"completed"}}
