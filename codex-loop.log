81\t            store.shell().keyboard.button_activation_keys,\n   782\t            vec![\"Enter\".to_string(), \"Space\".to_string()]\n   783\t        );\n   784\t    }\n   785\t\n   786\t    #[test]\n   787\t    fn shell_overrides_are_sparse_and_leave_siblings_alone() {\n   788\t        let store = store(json!({\n   789\t            \"shell\": { \"tooltip\": { \"delay_ms\": 25 } }\n   790\t        }));\n   791\t\n   792\t        assert_eq!(store.shell().tooltip.delay_ms, 25);\n   793\t        assert_eq!(store.shell().tooltip.position, \"bottom\");\n   794\t        assert_eq!(store.shell().tooltip.gap, 6.0);\n   795\t        assert_eq!(store.shell().theme.active, \"tokyo-night\");\n   796\t    }\n   797\t\n   798\t    #[test]\n   799\t    fn module_namespace_returns_stored_overrides() {\n   800\t        let store = store(json!({\n   801\t            \"@mesh/navigation-bar\": { \"surface\": { \"anchor\": \"bottom\" } }\n   802\t        }));\n   803\t\n   804\t        assert_eq!(\n   805\t            store.namespace(\"@mesh/navigation-bar\"),\n   806\t            json!({ \"surface\": { \"anchor\": \"bottom\" } })\n   807\t        );\n   808\t        assert_eq!(store.namespace(\"@mesh/quick-settings\"), json!({}));\n   809\t    }\n   810\t\n   811\t    #[test]\n   812\t    fn owner_schema_filters_runtime_values_but_keeps_raw_orphans_for_repair() {\n   813\t        let mut store = store(json!({\n   814\t            \"@mesh/test\": {\n   815\t                \"enabled\": true,\n   816\t                \"limit\": 0,\n   817\t                \"unknown\": \"kept\"\n   818\t            },\n   819\t            \"@mesh/test#alternate\": { \"enabled\": false }\n   820\t        }));\n   821\t        let schema = SettingsNamespaceSchema::new(\n   822\t            \"@mesh/test\",\n   823\t            \"@mesh/test\",\n   824\t            json!({\n   825\t                \"type\": \"object\",\n   826\t                \"properties\": {\n   827\t                    \"enabled\": { \"type\": \"boolean\" },\n   828\t                    \"limit\": { \"type\": \"integer\", \"minimum\": 1 }\n   829\t                },\n   830\t                \"additionalProperties\": false\n   831\t            }),\n   832\t        )\n   833\t        .unwrap();\n   834\t\n   835\t        store\n   836\t            .replace_namespace_schemas_transactionally([schema])\n   837\t            .unwrap();\n   838\t\n   839\t        assert_eq!(store.namespace(\"@mesh/test\"), json!({ \"enabled\": true }));\n   840\t        assert_eq!(\n   841\t            store.namespace(\"@mesh/test#alternate\"),\n   842\t            json!({ \"enabled\": false })\n   843\t        );\n   844\t        assert_eq!(store.to_value()[\"@mesh/test\"][\"unknown\"], json!(\"kept\"));\n   845\t        assert_eq!(\n   846\t            store\n   847\t                .diagnostics()\n   848\t                .iter()\n   849\t                .filter(|diagnostic| diagnostic.namespace == \"@mesh/test\")\n   850\t                .count(),\n   851\t            2\n   852\t        );\n   853\t    }\n   854\t\n   855\t    #[test]\n   856\t    fn schema_registration_is_atomic_across_duplicate_owners() {\n   857\t        let mut store = store(json!({\n   858\t            \"@mesh/test\": { \"enabled\": \"wrong\" }\n   859\t        }));\n   860\t        let first = SettingsNamespaceSchema::new(\n   861\t            \"@mesh/test\",\n   862\t            \"@mesh/test\",\n   863\t            json!({ \"enabled\": { \"type\": \"boolean\" } }),\n   864\t        )\n   865\t        .unwrap();\n   866\t        let duplicate = SettingsNamespaceSchema::new(\n   867\t            \"@mesh/test\",\n   868\t            \"@mesh/test\",\n   869\t            json!({ \"enabled\": { \"type\": \"string\" } }),\n   870\t        )\n   871\t        .unwrap();\n   872\t\n   873\t        let error = store\n   874\t            .replace_namespace_schemas_transactionally([first, duplicate])\n   875\t            .unwrap_err();\n   876\t\n   877\t        assert!(matches!(\n   878\t            error,\n   879\t            SettingsSchemaError::DuplicateNamespace { .. }\n   880\t        ));\n   881\t        assert!(store.schema_registry().iter().next().is_none());\n   882\t        assert_eq!(store.namespace(\"@mesh/test\")[\"enabled\"], json!(\"wrong\"));\n   883\t        assert!(store.diagnostics().is_empty());\n   884\t    }\n   885\t\n   886\t    #[test]\n   887\t    fn instance_namespace_layers_over_its_base_module() {\n   888\t        let store = store(json!({\n   889\t            \"@mesh/navigation-bar\": {\n   890\t                \"surface\": { \"anchor\": \"top\", \"layer\": \"top\" }\n   891\t            },\n   892\t            \"@mesh/navigation-bar#bottom\": {\n   893\t                \"surface\": { \"anchor\": \"bottom\" }\n   894\t            }\n   895\t        }));\n   896\t\n   897\t        let resolved = store.namespace(\"@mesh/navigation-bar#bottom\");\n   898\t        assert_eq!(resolved[\"surface\"][\"anchor\"], json!(\"bottom\"));\n   899\t        assert_eq!(resolved[\"surface\"][\"layer\"], json!(\"top\"));\n   900\t    }\n   901\t\n   902\t    #[test]\n   903\t    fn setting_an_empty_namespace_removes_it() {\n   904\t        let mut store = store(json!({ \"@mesh/navigation-bar\": { \"surface\": {} } }));\n   905\t        store.set_namespace(\"@mesh/navigation-bar\", json!({}));\n   906\t\n   907\t        assert!(!store.has_namespace(\"@mesh/navigation-bar\"));\n   908\t        assert_eq!(store.namespace_names().count(), 0);\n   909\t    }\n   910\t\n   911\t    #[test]\n   912\t    fn merge_namespace_keeps_unrelated_stored_keys() {\n   913\t        let mut store = store(json!({\n   914\t            \"@mesh/navigation-bar\": {\n   915\t                \"surface\": { \"anchor\": \"top\" },\n   916\t                \"props\": { \"global\": { \"density\": \"compact\" } }\n   917\t            }\n   918\t        }));\n   919\t\n   920\t        store.merge_namespace(\n   921\t            \"@mesh/navigation-bar\",\n   922\t            &json!({ \"surface\": { \"layer\": \"overlay\" } }),\n   923\t        );\n   924\t\n   925\t        let resolved = store.namespace(\"@mesh/navigation-bar\");\n   926\t        assert_eq!(resolved[\"surface\"][\"anchor\"], json!(\"top\"));\n   927\t        assert_eq!(resolved[\"surface\"][\"layer\"], json!(\"overlay\"));\n   928\t        assert_eq!(resolved[\"props\"][\"global\"][\"density\"], json!(\"compact\"));\n   929\t    }\n   930\t\n   931\t    #[test]\n   932\t    fn setting_the_shell_namespace_reresolves_shell_settings() {\n   933\t        let mut store = store(json!({}));\n   934\t        store.set_namespace(\"shell\", json!({ \"theme\": { \"active\": \"gruvbox-dark\" } }));\n   935\t\n   936\t        assert_eq!(store.shell().theme.active, \"gruvbox-dark\");\n   937\t    }\n   938\t\n   939\t    #[test]\n   940\t    fn reset_namespace_restores_declared_defaults() {\n   941\t        let mut store = store(json!({ \"shell\": { \"tooltip\": { \"delay_ms\": 25 } } }));\n   942\t        store.reset_namespace(\"shell\");\n   943\t\n   944\t        assert_eq!(store.shell().tooltip.delay_ms, 300);\n   945\t    }\n   946\t\n   947\t    #[test]\n   948\t    fn written_documents_stamp_the_schema_version_and_order_deterministically() {\n   949\t        let store = store(json!({\n   950\t            \"@mesh/quick-settings\": { \"surface\": { \"anchor\": \"top\" } },\n   951\t            \"shell\": { \"theme\": { \"active\": \"gruvbox-dark\" } },\n   952\t            \"@mesh/navigation-bar\": { \"surface\": { \"anchor\": \"bottom\" } }\n   953\t        }));\n   954\t\n   955\t        let document = store.to_value();\n   956\t        let keys: Vec<&str> = document\n   957\t            .as_object()\n   958\t            .expect(\"object\")\n   959\t            .keys()\n   960\t            .map(String::as_str)\n   630\t        Ok(ids)\n   631\t    }\n   632\t}\n   633\t\n   634\tfn validate_instance_id(instance_id: &str, module_id: &str) -> Result<(), ModuleManifestError> {\n   635\t    ModuleId::parse(module_id)?;\n   636\t    let expected_prefix = format!(\"{module_id}#\");\n   637\t    let suffix = instance_id\n   638\t        .strip_prefix(&expected_prefix)\n   639\t        .unwrap_or_default();\n   640\t    if !instance_id.starts_with(&expected_prefix)\n   641\t        || suffix.is_empty()\n   642\t        || !suffix\n   643\t            .chars()\n   644\t            .all(|character| character.is_ascii_alphanumeric() || matches!(character, '-' | '_'))\n   645\t    {\n   646\t        return Err(ModuleManifestError::Validation(format!(\n   647\t            \"profile root key {instance_id} must use {module_id}#<instance-id>\"\n   648\t        )));\n   649\t    }\n   650\t    Ok(())\n   651\t}\n   652\t\n   653\tfn validate_module_ids<'a>(\n   654\t    ids: impl IntoIterator<Item = &'a String>,\n   655\t    field: &str,\n   656\t) -> Result<(), ModuleManifestError> {\n   657\t    for id in ids {\n   658\t        ModuleId::parse(id).map_err(|_| {\n   659\t            ModuleManifestError::Validation(format!(\n   660\t                \"profile {field} entry '{id}' must be a module id such as @scope/name\"\n   661\t            ))\n   662\t        })?;\n   663\t    }\n   664\t    Ok(())\n   665\t}\n   666\t\n   667\tfn validate_profile_id(profile_id: &str) -> Result<(), ModuleManifestError> {\n   668\t    if profile_id.is_empty()\n   669\t        || !profile_id\n   670\t            .chars()\n   671\t            .all(|character| character.is_ascii_alphanumeric() || matches!(character, '-' | '_'))\n   672\t    {\n   673\t        return Err(ModuleManifestError::Validation(format!(\n   674\t            \"profile id '{profile_id}' must contain only ASCII letters, digits, '-' or '_'\"\n   675\t        )));\n   676\t    }\n   677\t    Ok(())\n   678\t}\n   679\t\n   680\tpub(super) fn atomic_write(path: &Path, content: &[u8]) -> Result<(), ModuleManifestError> {\n   681\t    super::validate_no_symlink_path(path, \"package write target\")?;\n   682\t    if let Some(parent) = path.parent() {\n   683\t        fs::create_dir_all(parent).map_err(|source| ModuleManifestError::Io {\n   684\t            path: parent.to_path_buf(),\n   685\t            source,\n   686\t        })?;\n   687\t    }\n   688\t    let temporary = path.with_extension(format!(\"tmp-{}\", std::process::id()));\n   689\t    let result = (|| {\n   690\t        let mut file = OpenOptions::new()\n   691\t            .create(true)\n   692\t            .truncate(true)\n   693\t            .write(true)\n   694\t            .open(&temporary)?;\n   695\t        file.write_all(content)?;\n   696\t        file.sync_all()?;\n   697\t        fs::rename(&temporary, path)\n   698\t    })();\n   699\t    if let Err(source) = result {\n   700\t        let _ = fs::remove_file(&temporary);\n   701\t        return Err(ModuleManifestError::Io {\n   702\t            path: path.to_path_buf(),\n   703\t            source,\n   704\t        });\n   705\t    }\n   706\t    Ok(())\n   707\t}\n   708\t\n   709\t#[cfg(test)]\n   710\tmod tests {\n   711\t    use super::*;\n   712\t\n   713\t    fn manifest(json: &str) -> ModuleManifest {\n   714\t        ModuleManifest::from_json_str(json).unwrap()\n   715\t    }\n   716\t\n   717\t    #[test]\n   718\t    fn frontend_install_adds_active_instance_without_copying_surface_defaults() {\n   719\t        let module = manifest(\n   720\t            r#\"{\"name\":\"@me/weather\",\"version\":\"1\",\"mesh\":{\"apiVersion\":\"0.1\",\"kind\":\"frontend\",\"entry\":\"src/main.mesh\",\"surface\":{\"anchor\":\"top\"}}}\"#,\n","exit_code":0,"status":"completed"}}
