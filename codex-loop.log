n   390\t    if normalized.contains(\"shift\") {\n   391\t        modifiers.shift = false;\n   392\t    } else if normalized.contains(\"control\") || normalized == \"ctrl\" {\n   393\t        modifiers.ctrl = false;\n   394\t    } else if normalized.contains(\"alt\") {\n   395\t        modifiers.alt = false;\n   396\t    }\n   397\t}\n   398\t\n   399\tpub struct Shell {\n   400\t    pub config: ShellConfig,\n   401\t    /// Core shell preferences, resolved from [`Self::settings_store`]. Kept\n   402\t    /// alongside the store because most readers want only this.\n   403\t    pub settings: ShellSettings,\n   404\t    /// Every user decision in the shell, in one document. Shared with each\n   405\t    /// component so they read the same snapshot the shell does.\n   406\t    pub settings_store: Arc<SettingsStore>,\n   407\t    pub theme: ThemeEngine,\n   408\t    pub locale: LocaleEngine,\n   409\t    pub diagnostics: DiagnosticsCollector,\n   410\t    pub interfaces: InterfaceRegistry,\n   411\t    /// Catalog-backed policy loaded from the root graph's persisted approvals.\n   412\t    capability_policy: CapabilityPolicy,\n   413\t    /// Effective grants for the current activation candidate. Runtime\n   414\t    /// construction must consume this map rather than manifest declarations.\n   415\t    effective_capabilities: Arc<HashMap<String, EffectiveCapabilities>>,\n   416\t    installed_module_graph: Option<InstalledModuleGraph>,\n   417\t    active_profile_id: Option<String>,\n   418\t    modules: HashMap<String, ModuleInstance>,\n   419\t    frontend_catalog: component::FrontendCatalogHandle,\n   420\t    module_dirs: Vec<PathBuf>,\n   421\t    core: ShellCoreState,\n   422\t    /// Last rendered snapshot sent through the authoritative theme interface.\n   423\t    /// It is the baseline for deterministic revisioned token events.\n   424\t    last_published_theme_snapshot: Option<mesh_core_theme::ThemeSnapshot>,\n   425\t    components: Vec<ComponentRuntime>,\n