.find('{') {\\n  1231\\t        result.push_str(&remaining[..open]);\\n  1232\\t        let after_open = &remaining[open + 1..];\\n  1233\\t        if let Some(close) = after_open.find('}') {\\n  1234\\t            let name = &after_open[..close];\\n  1235\\t            match args.get(name) {\\n  1236\\t                Some(value) => result.push_str(value),\\n  1237\\t                None => {\\n  1238\\t                    result.push('{');\\n  1239\\t                    result.push_str(name);\\n  1240\\t                    result.push('}');\\n  1241\\t                }\\n  1242\\t            }\\n  1243\\t            remaining = &after_open[close + 1..];\\n  1244\\t        } else {\\n  1245\\t            result.push_str(&remaining[open..]);\\n  1246\\t            return Some(result);\\n  1247\\t        }\\n  1248\\t    }\\n  1249\\t    result.push_str(remaining);\\n  1250\\t    Some(result)\\n  1251\\t}\\n  1252\\t\\n  1253\\t#[cfg(test)]\\n  1254\\tmod tests {\\n  1255\\t    use super::*;\\n  1256\\t\\n  1257\\t    #[test]\\n  1258\\t    fn basic_translation() {\\n  1259\\t        let mut engine = LocaleEngine::new(\\\"en\\\");\\n  1260\\t        engine.load_core_translations(TranslationSet {\\n  1261\\t            locale: \\\"en\\\".to_string(),\\n  1262\\t            messages: HashMap::from([\\n  1263\\t                (\\\"greeting\\\".to_string(), \\\"Hello, {name}!\\\".to_string()),\\n  1264\\t                (\\\"bye\\\".to_string(), \\\"Goodbye\\\".to_string()),\\n  1265\\t            ]),\\n  1266\\t        });\\n  1267\\t\\n  1268\\t        assert_eq!(engine.core_translator().translate(\\\"bye\\\"), Some(\\\"Goodbye\\\"));\\n  1269\\t\\n  1270\\t        let args = HashMap::from([(\\\"name\\\".to_string(), \\\"World\\\".to_string())]);\\n  1271\\t        assert_eq!(\\n  1272\\t            engine.core_translator().translate_with(\\\"greeting\\\", &args),\\n  1273\\t            Some(\\\"Hello, World!\\\".to_string())\\n  1274\\t        );\\n  1275\\t    }\\n  1276\\t\\n  1277\\t    #[test]\\n  1278\\t    fn fallback_chain() {\\n  1279\\t        let mut engine = LocaleEngine::new(\\\"fr\\\");\\n  1280\\t        engine.load_core_translations(TranslationSet {\\n  1281\\t            locale: \\\"en\\\".to_string(),\\n  1282\\t            messages: HashMap::from([(\\\"ok\\\".to_string(), \\\"OK\\\".to_string())]),\\n  1283\\t        });\\n  1284\\t\\n  1285\\t        assert_eq!(engine.core_translator().translate(\\\"ok\\\"), Some(\\\"OK\\\"));\\n  1286\\t    }\\n  1287\\t\\n  1288\\t    #[test]\\n  1289\\t    fn effective_module_catalog_matches_scoped_lookup_precedence() {\\n  1290\\t        let mut engine = LocaleEngine::with_fallback_locale(\\\"sk\\\", \\\"en\\\");\\n  1291\\t        engine.load_core_translations(TranslationSet {\\n  1292\\t            locale: \\\"sk\\\".to_string(),\\n  1293\\t            messages: HashMap::from([\\n  1294\\t                (\\\"shared\\\".to_string(), \\\"global-sk\\\".to_string()),\\n  1295\\t                (\\\"global\\\".to_string(), \\\"iba-global\\\".to_string()),\\n  1296\\t            ]),\\n  1297\\t        });\\n  1298\\t        engine.load_core_translations(TranslationSet {\\n  1299\\t            locale: \\\"en\\\".to_string(),\\n  1300\\t            messages: HashMap::from([(\\\"shared\\\".to_string(), \\\"global-en\\\".to_string())]),\\n  1301\\t        });\\n  1302\\t        engine.load_module_translations(\\n  1303\\t            \\\"@mesh/example\\\",\\n  1304\\t            TranslationSet {\\n  1305\\t                locale: \\\"en\\\".to_string(),\\n  1306\\t                messages: HashMap::from([(\\\"shared\\\".to_string(), \\\"module-en\\\".to_string())]),\\n  1307\\t            },\\n  1308\\t        );\\n  1309\\t\\n  1310\\t        let translator = engine.module_translator(\\\"@mesh/example\\\");\\n  1311\\t        assert_eq!(translator.translate(\\\"shared\\\"), Some(\\\"module-en\\\"));\\n  1312\\t        assert_eq!(translator.translate(\\\"global\\\"), None);\\n  1313\\t    }\\n  1314\\t\\n  1315\\t    #[test]\\n  1316\\t    fn module_catalogs_never_leak_into_other_module_or_core_lookup() {\\n  1317\\t        let mut engine = LocaleEngine::new(\\\"en\\\");\\n  1318\\t        engine.load_module_translations(\\n  1319\\t            \\\"@mesh/one\\\",\\n  1320\\t            TranslationSet {\\n  1321\\t                locale: \\\"en\\\".into(),\\n  1322\\t                messages: HashMap::from([(String::from(\\\"shared\\\"), String::from(\\\"one\\\"))]),\\n  1323\\t            },\\n  1324\\t        );\\n  1325\\t        engine.load_module_translations(\\n  1326\\t            \\\"@mesh/two\\\",\\n  1327\\t            TranslationSet {\\n  1328\\t                locale: \\\"en\\\".into(),\\n  1329\\t                messages: HashMap::from([(String::from(\\\"shared\\\"), String::from(\\\"two\\\"))]),\\n  1330\\t            },\\n  1331\\t        );\\n  1332\\t\\n  1333\\t        assert_eq!(\\n  1334\\t            engine.module_translator(\\\"@mesh/one\\\").translate(\\\"shared\\\"),\\n  1335\\t            Some(\\\"one\\\")\\n  1336\\t        );\\n  1337\\t        assert_eq!(\\n  1338\\t            engine.module_translator(\\\"@mesh/two\\\").translate(\\\"shared\\\"),\\n  1339\\t            Some(\\\"two\\\")\\n  1340\\t        );\\n  1341\\t        assert_eq!(engine.core_translator().translate(\\\"shared\\\"), None);\\n  1342\\t    }\\n  1343\\t\\n  1344\\t    #[test]\\n  1345\\t    fn selection_normalizes_parents_direction_and_revision() {\\n  1346\\t        let selection = LocaleSelection::try_new(\\\" zh-hant-tw \\\", \\\"en-US\\\", 7).unwrap();\\n  1347\\t\\n  1348\\t        assert_eq!(selection.active(), \\\"zh-Hant-TW\\\");\\n  1349\\t        assert_eq!(selection.fallback(), \\\"en-US\\\");\\n  1350\\t        assert_eq!(\\n  1351\\t            selection.chain(),\\n  1352\\t            &[\\\"zh-Hant-TW\\\", \\\"zh-Hant\\\", \\\"zh\\\", \\\"en-US\\\", \\\"en\\\"]\\n  1353\\t        );\\n  1354\\t        assert_eq!(selection.direction(), LocaleDirection::Ltr);\\n  1355\\t        assert_eq!(selection.revision(), 7);\\n  1356\\t\\n  1357\\t        let rtl = LocaleSelection::try_new(\\\"ar-EG\\\", \\\"en\\\", 1).unwrap();\\n  1358\\t        assert_eq!(rtl.direction(), LocaleDirection::Rtl);\\n  1359\\t    }\\n  1360\\t\\n  1361\\t    #[test]\\n  1362\\t    fn locale_changes_replace_stale_chain_and_increment_revision() {\\n  1363\\t        let mut engine = LocaleEngine::with_fallback_locale(\\\"sk-SK\\\", \\\"de-DE\\\");\\n  1364\\t        assert_eq!(\\n  1365\\t            engine.fallback_chain(),\\n  1366\\t            &[\\\"sk-SK\\\", \\\"sk\\\", \\\"de-DE\\\", \\\"de\\\", \\\"en\\\"]\\n  1367\\t        );\\n  1368\\t        assert_eq!(engine.revision(), 1);\\n  1369\\t\\n  1370\\t        assert!(engine.try_set_locale(\\\"fr-FR\\\").unwrap());\\n  1371\\t        assert_eq!(engine.current(), \\\"fr-FR\\\");\\n  1372\\t        assert_eq!(\\n  1373\\t            engine.fallback_chain(),\\n  1374\\t            &[\\\"fr-FR\\\", \\\"fr\\\", \\\"de-DE\\\", \\\"de\\\", \\\"en\\\"]\\n  1375\\t        );\\n  1376\\t        assert_eq!(engine.revision(), 2);\\n  1377\\t        assert!(!engine.try_set_locale(\\\"fr-fr\\\").unwrap());\\n  1378\\t        assert_eq!(engine.revision(), 2);\\n  1379\\t    }\\n  1380\\t\\n  1381\\t    #[test]\\n  1382\\t    fn invalid_locale_tags_are_rejected() {\\n  1383\\t        assert!(matches!(\\n  1384\\t            LocaleSelection::try_new(\\\"\\\", \\\"en\\\", 1),\\n  1385\\t            Err(LocaleError::EmptyTag)\\n  1386\\t        ));\\n  1387\\t        assert!(matches!(\\n  1388\\t            LocaleSelection::try_new(\\\"en_US\\\", \\\"en\\\", 1),\\n  1389\\t            Err(LocaleError::InvalidTag { .. })\\n  1390\\t        ));\\n  1391\\t        assert!(matches!(\\n  1392\\t            LocaleSelection::try_new(\\\"en-a\\\", \\\"en\\\", 1),\\n  1393\\t            Err(LocaleError::InvalidTag { .. })\\n  1394\\t        ));\\n  1395\\t    }\\n  1396\\t\\n  1397\\t    #[test]\\n  1398\\t    fn typed_catalogs_keep_valid_siblings_and_resolve_variants() {\\n  1399\\t        let compiled = compile_catalog(\\n  1400\\t            \\\"sk\\\",\\n  1401\\t            &serde_json::json!({\\n  1402\\t                \\\"plain\\\": \\\"Ahoj {name}\\\",\\n  1403\\t                \\\"items\\\": {\\n  1404\\t                    \\\"_plural\\\": true,\\n  1405\\t                    \\\"one\\\": \\\"{count} položka\\\",\\n  1406\\t                    \\\"few\\\": \\\"{count} položky\\\",\\n  1407\\t                    \\\"many\\\": \\\"{count} položiek\\\",\\n  1408\\t                    \\\"other\\\": \\\"{count} položiek\\\"\\n  1409\\t                },\\n  1410\\t                \\\"greeting\\\": {\\n  1411\\t                    \\\"_select\\\": true,\\n  1412\\t                    \\\"formal\\\": \\\"Dobrý deň\\\",\\n  1413\\t                    \\\"other\\\": \\\"Ahoj\\\"\\n  1414\\t                },\\n  1415\\t                \\\"broken\\\": {\\n  1416\\t                    \\\"_plural\\\": true,\\n  1417\\t                    \\\"one\\\": \\\"{count} položka\\\",\\n  1418\\t                    \\\"other\\\": \\\"položky\\\"\\n  1419\\t                }\\n  1420\\t            }),\\n  1421\\t        );\\n  1422\\t        assert_eq!(compiled.messages.len(), 3);\\n  1423\\t        assert_eq!(compiled.diagnostics.len(), 1);\\n  1424\\t        assert_eq!(compiled.diagnostics[0].key, \\\"broken\\\");\\n  1425\\t\\n  1426\\t        let mut engine = LocaleEngine::new(\\\"sk\\\");\\n  1427\\t        engine.load_module_catalog(\\\"@mesh/example\\\", compiled);\\n  1428\\t        let translator = engine.module_translator(\\\"@mesh/example\\\");\\n  1429\\t        let args = HashMap::from([\\n  1430\\t            (\\\"count\\\".into(), \\\"3\\\".into()),\\n  1431\\t            (\\\"name\\\".into(), \\\"Mária\\\".into()),\\n  1432\\t            (\\\"select\\\".into(), \\\"formal\\\".into()),\\n  1433\\t        ]);\\n  1434\\t        assert_eq!(\\n  1435\\t            translator.translate_with(\\\"plain\\\", &args),\\n  1436\\t            Some(\\\"Ahoj Mária\\\".into())\\n  1437\\t        );\\n  1438\\t        assert_eq!(\\n  1439\\t            translator.translate_with(\\\"items\\\", &args),\\n  1440\\t            Some(\\\"3 položky\\\".into())\\n  1441\\t        );\\n  1442\\t        assert_eq!(\\n  1443\\t            translator.translate_with(\\\"greeting\\\", &args),\\n  1444\\t            Some(\\\"Dobrý deň\\\".into())\\n  1445\\t        );\\n  1446\\t        assert_eq!(translator.translate(\\\"items\\\"), Some(\\\"{count} položiek\\\"));\\n  1447\\t    }\\n  1448\\t\\n  1449\\t    #[test]\\n  1450\\t    fn ordered_language_packs_win_before_bundled_and_default_catalogs() {\\n  1451\\t        let module_path = test_catalog_path(\\\"layer-module\\\");\\n  1452\\t        let first_pack_path = test_catalog_path(\\\"layer-pack-first\\\");\\n  1453\\t        let second_pack_path = test_catalog_path(\\\"layer-pack-second\\\");\\n  1454\\t        let default_path = test_catalog_path(\\\"layer-default\\\");\\n  1455\\t        std::fs::write(\\n  1456\\t            &module_path,\\n  1457\\t            serde_json::json!({\\n  1458\\t                \\\"shared\\\": \\\"module-cs\\\",\\n  1459\\t                \\\"bundled\\\": \\\"bundled-cs\\\"\\n  1460\\t            })\\n  1461\\t            .to_string(),\\n  1462\\t        )\\n  1463\\t        .unwrap();\\n  1464\\t        std::fs::write(\\n  1465\\t            &first_pack_path,\\n  1466\\t            serde_json::json!({ \\\"shared\\\": \\\"first-pack\\\" }).to_string(),\\n  1467\\t        )\\n  1468\\t        .unwrap();\\n  1469\\t        std::fs::write(\\n  1470\\t            &second_pack_path,\\n  1471\\t            serde_json::json!({ \\\"shared\\\": \\\"second-pack\\\" }).to_string(),\\n  1472\\t        )\\n  1473\\t        .unwrap();\\n  1474\\t        std::fs::write(\\n  1475\\t            &default_path,\\n  1476\\t            serde_json::json!({ \\\"defaulted\\\": \\\"module-default\\\" }).to_string(),\\n  1477\\t        )\\n  1478\\t        .unwrap();\\n  1479\\t\\n  1480\\t        let sources = vec![\\n  1481\\t            CatalogSource::module(\\\"@mesh/example\\\", \\\"cs\\\", \\\"cs\\\", module_path.clone()),\\n  1482\\t            CatalogSource::language_pack(\\n  1483\\t                \\\"@mesh/first-pack\\\",\\n  1484\\t                \\\"@mesh/example\\\",\\n  1485\\t                \\\"first-cs\\\",\\n  1486\\t                \\\"cs\\\",\\n  1487\\t                first_pack_path.clone(),\\n  1488\\t            ),\\n  1489\\t            CatalogSource::language_pack(\\n  1490\\t                \\\"@mesh/second-pack\\\",\\n  1491\\t                \\\"@mesh/example\\\",\\n  1492\\t                \\\"second-cs\\\",\\n  1493\\t                \\\"cs\\\",\\n  1494\\t                second_pack_path.clone(),\\n  1495\\t            ),\\n  1496\\t            CatalogSource::module(\\\"@mesh/example\\\", \\\"default\\\", \\\"de\\\", default_path.clone()),\\n  1497\\t        ];\\n  1498\\t        let defaults = HashMap::from([(\\\"@mesh/example\\\".into(), \\\"de\\\".into())]);\\n  1499\\t        let mut engine = LocaleEngine::with_fallback_locale(\\\"cs-CZ\\\", \\\"en\\\");\\n  1500\\t        let prepared = engine\\n  1501\\t            .prepare_catalog_snapshot(&sources, &defaults)\\n  1502\\t            .unwrap();\\n  1503\\t        engine.replace_catalog_snapshot(prepared.snapshot());\\n  1504\\t\\n  1505\\t        let translator = engine.module_translator(\\\"@mesh/example\\\");\\n  1506\\t        assert_eq!(translator.translate(\\\"shared\\\"), Some(\\\"first-pack\\\"));\\n  1507\\t        assert_eq!(translator.translate(\\\"bundled\\\"), Some(\\\"bundled-cs\\\"));\\n  1508\\t        assert_eq!(translator.translate(\\\"defaulted\\\"), Some(\\\"module-default\\\"));\\n  1509\\t        let source = translator.source(\\\"shared\\\").unwrap();\\n  1510\\t        assert_eq!(source.kind, CatalogSourceKind::LanguagePack);\\n  1511\\t        assert_eq!(source.owner_module_id, \\\"@mesh/first-pack\\\");\\n  1512\\t        assert_eq!(source.contribution_id, \\\"first-cs\\\");\\n  1513\\t        assert_eq!(source.path, first_pack_path);\\n  1514\\t        assert_eq!(\\n  1515\\t            engine.module_translator(\\\"@mesh/other\\\").translate(\\\"shared\\\"),\\n  1516\\t            None\\n  1517\\t        );\\n  1518\\t\\n  1519\\t        for path in [module_path, first_pack_path, second_pack_path, default_path] {\\n  1520\\t            let _ = std::fs::remove_file(path);\\n  1521\\t        }\\n  1522\\t    }\\n  1523\\t\\n  1524\\t    #[test]\\n  1525\\t    fn catalog_snapshots_are_revisioned_and_replaced_atomically() {\\n  1526\\t        let mut engine = LocaleEngine::new(\\\"en\\\");\\n  1527\\t        let empty = engine.catalog_snapshot();\\n  1528\\t        engine.load_module_translations(\\n  1529\\t            \\\"@mesh/example\\\",\\n  1530\\t            TranslationSet {\\n  1531\\t                locale: \\\"en\\\".into(),\\n  1532\\t                messages: HashMap::from([(String::from(\\\"hello\\\"), String::from(\\\"Hello\\\"))]),\\n  1533\\t            },\\n  1534\\t        );\\n  1535\\t        let committed = engine.catalog_snapshot();\\n  1536\\t        assert_eq!(empty.revision(), 0);\\n  1537\\t        assert_eq!(committed.revision(), 1);\\n  1538\\t        assert_eq!(\\n  1539\\t            engine.module_translator(\\\"@mesh/example\\\").translate(\\\"hello\\\"),\\n  1540\\t            Some(\\\"Hello\\\")\\n  1541\\t        );\\n  1542\\t\\n  1543\\t        engine.replace_catalog_snapshot(empty);\\n  1544\\t        assert_eq!(engine.catalog_snapshot().revision(), 0);\\n  1545\\t        assert_eq!(\\n  1546\\t            engine.module_translator(\\\"@mesh/example\\\").translate(\\\"hello\\\"),\\n  1547\\t            None\\n  1548\\t        );\\n  1549\\t    }\\n  1550\\t\\n  1551\\t    #[test]\\n  1552\\t    fn localized_resolution_carries_provenance_and_visible_miss_policy() {\\n  1553\\t        let mut engine = LocaleEngine::new(\\\"en\\\");\\n  1554\\t        engine.load_module_translations(\\n  1555\\t            \\\"@mesh/example\\\",\\n  1556\\t            TranslationSet {\\n  1557\\t                locale: \\\"en\\\".into(),\\n  1558\\t                messages: HashMap::from([(String::from(\\\"hello\\\"), String::from(\\\"Hello\\\"))]),\\n  1559\\t            },\\n  1560\\t        );\\n  1561\\t\\n  1562\\t        let translator = engine.module_translator(\\\"@mesh/example\\\");\\n  1563\\t        let translated = translator.resolve(\\\"hello\\\", Some(\\\"Fallback\\\"));\\n  1564\\t        assert_eq!(translated.owner_module_id, \\\"@mesh/example\\\");\\n  1565\\t        assert_eq!(translated.key.as_deref(), Some(\\\"hello\\\"));\\n  1566\\t        assert_eq!(translated.text, \\\"Hello\\\");\\n  1567\\t        assert_eq!(translated.fallback.as_deref(), Some(\\\"Fallback\\\"));\\n  1568\\t        assert!(!translated.missing);\\n  1569\\t        assert_eq!(translated.snapshot_revision, 1);\\n  1570\\t        assert_eq!(\\n  1571\\t            translated\\n  1572\\t                .source\\n  1573\\t                .as_ref()\\n  1574\\t                .map(|source| source.owner_module_id.as_str()),\\n  1575\\t            Some(\\\"@mesh/example\\\")\\n  1576\\t        );\\n  1577\\t\\n  1578\\t        let fallback = translator.resolve(\\\"missing\\\", Some(\\\"Fallback\\\"));\\n  1579\\t        assert_eq!(fallback.text, \\\"Fallback\\\");\\n  1580\\t        assert!(fallback.missing);\\n  1581\\t        assert!(fallback.source.is_none());\\n  1582\\t\\n  1583\\t        let marker = translator.resolve(\\\"missing\\\", None);\\n  1584\\t        assert_eq!(marker.text, \\\"!!missing\\\");\\n  1585\\t        assert!(marker.missing);\\n  1586\\t        assert_eq!(marker.snapshot_revision, 1);\\n  1587\\t    }\\n  1588\\t\\n  1589\\t    fn test_catalog_path(name: &str) -> std::path::PathBuf {\\n  1590\\t        std::env::temp_dir