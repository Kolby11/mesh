{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/run/current-system/sw/bin/bash -lc \"nl -ba crates/core/shell/src/shell/runtime/request.rs | sed -n '957,1115p'; nl -ba crates/core/shell/src/shell/runtime/request.rs | sed -n '1115,1195p'\"","aggregated_output":"   957\t    pub(in crate::shell) fn dispatch_service_command(\n   958\t        &mut self,\n   959\t        interface: &str,\n   960\t        command: &str,\n   961\t        payload: &serde_json::Value,\n   962\t        source_module_id: &str,\n   963\t        source_capabilities: &mesh_core_capability::CapabilitySet,\n   964\t    ) -> serde_json::Value {\n   965\t        let interface_canonical = canonical_interface_name_cow(interface);\n   966\t        let service_caps = service_capabilities(interface_canonical.as_ref());\n   967\t        let required = &service_caps.control;\n   968\t        if !source_capabilities.is_granted(required) {\n   969\t            tracing::warn!(\n   970\t                source_module_id,\n   971\t                interface,\n   972\t                command,\n   973\t                required_capability = %required,\n   974\t                \"denied unauthorized service command dispatch\"\n   975\t            );\n   976\t            self.record_method_call(mesh_core_debug::MethodCallEntry {\n   977\t                interface: interface_canonical.to_string(),\n   978\t                provider_id: None,\n   979\t                source_module_id: source_module_id.to_string(),\n   980\t                command: command.to_string(),\n   981\t                status: \"capability_denied\".to_string(),\n   982\t                queued: false,\n   983\t                result: Some(serde_json::json!({\n   984\t                    \"ok\": false,\n   985\t                    \"error\": \"capability_denied\",\n   986\t                    \"status\": \"capability_denied\",\n   987\t                })),\n   988\t                error: Some(\"capability_denied\".to_string()),\n   989\t            });\n   990\t            return serde_json::json!({\n   991\t                \"ok\": false,\n   992\t                \"error\": \"capability_denied\",\n   993\t                \"status\": \"capability_denied\",\n   994\t            });\n   995\t        }\n   996\t\n   997\t        if !self.service_command_is_supported(interface_canonical.as_ref(), command) {\n   998\t            let message = format!(\"unsupported_service_command: {interface}.{command}\");\n   999\t            tracing::warn!(\n  1000\t                source_module_id,\n  1001\t                interface,\n  1002\t                command,\n  1003\t                \"unsupported_service_command\"\n  1004\t            );\n  1005\t            self.diagnostics.record_lifecycle_error(\n  1006\t                source_module_id.to_string(),\n  1007\t                \"unsupported_service_command\",\n  1008\t                message.clone(),\n  1009\t            );\n  1010\t            self.record_method_call(mesh_core_debug::MethodCallEntry {\n  1011\t                interface: interface_canonical.to_string(),\n  1012\t                provider_id: None,\n  1013\t                source_module_id: source_module_id.to_string(),\n  1014\t                command: command.to_string(),\n  1015\t                status: \"unsupported_service_command\".to_string(),\n  1016\t                queued: false,\n  1017\t                result: Some(serde_json::json!({\n  1018\t                    \"ok\": false,\n  1019\t                    \"error\": message,\n  1020\t                    \"status\": \"unsupported_service_command\",\n  1021\t                })),\n  1022\t                error: Some(message.clone()),\n  1023\t            });\n  1024\t            return serde_json::json!({\n  1025\t                \"ok\": false,\n  1026\t                \"error\": message,\n  1027\t                \"status\": \"unsupported_service_command\",\n  1028\t            });\n  1029\t        }\n  1030\t\n  1031\t        let interface = interface_canonical.as_ref();\n  1032\t        // Interfaces the shell provides itself answer here rather than on a\n  1033\t        // backend command queue. The capability check above already ran, so a\n  1034\t        // caller reaches this point exactly when it holds\n  1035\t        // `service.<name>.control` — no module id is consulted.\n  1036\t        let mut dispatch_result = if let Some(request) =\n  1037\t            core_service_request(interface_canonical.as_ref(), command, payload)\n  1038\t        {\n  1039\t            match self.apply_request(request) {\n  1040\t                Ok(follow_ups) => {\n  1041\t                    // Drained into `pending` at the top of the next frame, the\n  1042\t                    // same path a profile switch already uses.\n  1043\t                    self.deferred_requests.extend(follow_ups);\n  1044\t                    serde_json::json!({ \"ok\": true, \"status\": \"applied\" })\n  1045\t                }\n  1046\t                Err(error) => {\n  1047\t                    let message = error.to_string();\n  1048\t                    tracing::warn!(\n  1049\t                        interface,\n  1050\t                        command,\n  1051\t                        error = %message,\n  1052\t                        \"core service command failed\"\n  1053\t                    );\n  1054\t                    serde_json::json!({\n  1055\t                        \"ok\": false,\n  1056\t                        \"error\": message,\n  1057\t                        \"status\": \"failed\",\n  1058\t                    })\n  1059\t                }\n  1060\t            }\n  1061\t        } else if self.service_handlers.contains_key(interface) {\n  1062\t            let coalesce = self.service_command_is_coalescable(interface, command);\n  1063\t            if coalesce {\n  1064\t                let key = (interface.to_string(), command.to_string());\n  1065\t                let now = std::time::Instant::now();\n  1066\t                let entry = self.command_throttle.get(&key);\n  1067\t                let allow_send = entry\n  1068\t                    .map(|state| now.duration_since(state.last_send) >= COMMAND_THROTTLE_INTERVAL)\n  1069\t                    .unwrap_or(true);\n  1070\t                if allow_send {\n  1071\t                    self.command_throttle.insert(\n  1072\t                        key,\n  1073\t                        CommandThrottleState {\n  1074\t                            last_send: now,\n  1075\t                            pending: None,\n  1076\t                        },\n  1077\t                    );\n  1078\t                    match self.send_service_command_message(interface, command, payload, coalesce) {\n  1079\t                        Some(Ok(())) => serde_json::json!({ \"ok\": true, \"queued\": true }),\n  1080\t                        Some(Err(())) | None => service_unavailable_response(),\n  1081\t                    }\n  1082\t                } else {\n  1083\t                    let state =\n  1084\t                        self.command_throttle\n  1085\t                            .entry(key)\n  1086\t                            .or_insert_with(|| CommandThrottleState {\n  1087\t                                last_send: now,\n  1088\t                                pending: None,\n  1089\t                            });\n  1090\t                    state.pending = Some(payload.clone());\n  1091\t                    serde_json::json!({ \"ok\": true, \"queued\": true, \"throttled\": true })\n  1092\t                }\n  1093\t            } else {\n  1094\t                match self.send_service_command_message(interface, command, payload, coalesce) {\n  1095\t                    Some(Ok(())) => serde_json::json!({ \"ok\": true, \"queued\": true }),\n  1096\t                    Some(Err(())) | None => service_unavailable_response(),\n  1097\t                }\n  1098\t            }\n  1099\t        } else {\n  1100\t            tracing::debug!(\"no handler registered for service: {interface}\");\n  1101\t            service_unavailable_response()\n  1102\t        };\n  1103\t\n  1104\t        if dispatch_result\n  1105\t            .get(\"ok\")\n  1106\t            .and_then(|value| value.as_bool())\n  1107\t            .unwrap_or(false)\n  1108\t        {\n  1109\t            let state_binding = self\n  1110\t                .interfaces\n  1111\t                .resolve(interface_canonical.as_ref(), None)\n  1112\t                .contract\n  1113\t                .as_ref()\n  1114\t                .and_then(|contract| {\n  1115\t                    contract\n  1115\t                    contract\n  1116\t                        .methods\n  1117\t                        .iter()\n  1118\t                        .find(|method| method.name == command)\n  1119\t                        .and_then(|method| method.state_binding.clone())\n  1120\t                });\n  1121\t            if let Some(binding) = state_binding\n  1122\t                && let Some(value) =\n  1123\t                    self.bound_value_for_command(interface_canonical.as_ref(), &binding, payload)\n  1124\t            {\n  1125\t                self.apply_bound_service_state(interface_canonical.as_ref(), &binding.field, value);\n  1126\t                dispatch_result[\"state_bound\"] = serde_json::json!(true);\n  1127\t            }\n  1128\t        }\n  1129\t\n  1130\t        let provider_id = self\n  1131\t            .backend_runtimes\n  1132\t            .get(interface)\n  1133\t            .map(|slot| slot.provider_id.clone());\n  1134\t        let queued = dispatch_result\n  1135\t            .get(\"queued\")\n  1136\t            .and_then(|value| value.as_bool())\n  1137\t            .unwrap_or(false);\n  1138\t        let status = dispatch_result\n  1139\t            .get(\"status\")\n  1140\t            .and_then(|value| value.as_str())\n  1141\t            .map(ToOwned::to_owned)\n  1142\t            .unwrap_or_else(|| {\n  1143\t                if queued {\n  1144\t                    \"queued\".to_string()\n  1145\t                } else {\n  1146\t                    \"failed\".to_string()\n  1147\t                }\n  1148\t            });\n  1149\t        let error = dispatch_result\n  1150\t            .get(\"error\")\n  1151\t            .and_then(|value| value.as_str())\n  1152\t            .map(ToOwned::to_owned);\n  1153\t        self.record_method_call(mesh_core_debug::MethodCallEntry {\n  1154\t            interface: interface.to_string(),\n  1155\t            provider_id,\n  1156\t            source_module_id: source_module_id.to_string(),\n  1157\t            command: command.to_string(),\n  1158\t            status,\n  1159\t            queued,\n  1160\t            result: Some(dispatch_result.clone()),\n  1161\t            error,\n  1162\t        });\n  1163\t\n  1164\t        dispatch_result\n  1165\t    }\n  1166\t\n  1167\t    fn send_service_command_message(\n  1168\t        &mut self,\n  1169\t        interface: &str,\n  1170\t        command: &str,\n  1171\t        payload: &serde_json::Value,\n  1172\t        coalesce: bool,\n  1173\t    ) -> Option<Result<(), ()>> {\n  1174\t        let tx = self.service_handlers.get(interface).cloned()?;\n  1175\t        let active_provider_id = self\n  1176\t            .backend_runtimes\n  1177\t            .get(interface)\n  1178\t            .map(|slot| slot.provider_id.clone());\n  1179\t        let profiling_started = (self.profiling_enabled() && active_provider_id.is_some())\n  1180\t            .then(std::time::Instant::now);\n  1181\t        let result = tx\n  1182\t            .send(ServiceCommandMsg {\n  1183\t                command: command.to_string(),\n  1184\t                payload: payload.clone(),\n  1185\t                coalesce,\n  1186\t            })\n  1187\t            .map_err(|_| ());\n  1188\t        if let (Some(provider_id), Some(started)) = (active_provide