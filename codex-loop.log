rement))\n  1196\t        });\n  1197\t        unresolved\n  1198\t    }\n  1199\t\n  1200\t    pub fn layout_entrypoint(&self) -> Option<&ResolvedLayoutEntrypoint> {\n  1201\t        self.layout_entrypoint.as_ref()\n  1202\t    }\n  1203\t\n  1204\t    pub fn contributed_themes(&self) -> &[ContributedTheme] {\n  1205\t        &self.contributions.themes\n  1206\t    }\n  1207\t\n  1208\t    pub fn theme_catalog(&self) -> &ThemeCatalog {\n  1209\t        &self.theme_catalog\n  1210\t    }\n  1211\t\n  1212\t    pub fn contributed_icons(&self) -> &[ContributedPathResource] {\n  1213\t        &self.contributions.icons\n  1214\t    }\n  1215\t\n  1216\t    pub fn contributed_fonts(&self) -> &[ContributedPathResource] {\n  1217\t        &self.contributions.fonts\n  1218\t    }\n  1219\t\n  1220\t    pub fn contributed_i18n(&self) -> &[ContributedI18n] {\n  1221\t        &self.contributions.i18n\n  1222\t    }\n  1223\t\n  1224\t    pub fn contributed_libraries(&self) -> &[ContributedLibrary] {\n  1225\t        &self.contributions.libraries\n  1226\t    }\n  1227\t\n  1228\t    pub fn settings_schemas(&self) -> &[ContributedSettingsSchema] {\n  1229\t        &self.contributions.settings\n  1230\t    }\n  1231\t\n  1232\t    pub fn frontend_entrypoints(&self) -> &[ContributedFrontendEntrypoint] {\n  1233\t        &self.contributions.frontend_entrypoints\n  1234\t    }\n  1235\t\n  1236\t    pub fn frontend_surfaces(&self) -> &[ContributedFrontendSurface] {\n  1237\t        &self.contributions.frontend_surfaces\n  1238\t    }\n  1239\t\n  1240\t    pub fn contributed_layouts(&self) -> &[ContributedLayout] {\n","exit_code":0,"status":"completed"}}
