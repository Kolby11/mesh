  cargo test -p mesh-core-shell --release --lib patched_frame_restyle_visits_scale_with_the_patch_not_the_tree
  cargo test -p mesh-core-shell --release --lib template_patching
  cargo test -p mesh-core-shell --release --lib service_field_update_patches
  cargo test -p mesh-core-shell --release --lib service_fields_patch_keyed
  cargo test -p mesh-core-shell --release --lib service_binding_failure
  cargo test -p mesh-core-shell --release --lib keyed_list_
  cargo test -p mesh-core-elements --release --lib nested_fit_extents_visit_once
  cargo test -p mesh-core-frontend --release --lib compiler_normalizes_completed_tree_once
  cargo test -p mesh-core-shell --release --lib keyed_loop_bindings_capture_locals
