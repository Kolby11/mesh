#!/usr/bin/env bash
set -euo pipefail

readonly ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly BASELINE="${MESH_PERF_BASELINE:-$ROOT/config/performance-baseline.tsv}"
readonly RESULTS="$(mktemp)"
trap 'rm -f "$RESULTS"' EXIT

run_benchmark() {
  local package="$1"
  local test_name="$2"
  local features="${3:-}"
  local output
  local -a feature_args=()

  if [[ -n "$features" ]]; then
    feature_args=(--features "$features")
  fi
  if ! output="$(cargo test -p "$package" "${feature_args[@]}" --release -- "$test_name" --ignored --nocapture --test-threads=1 2>&1)"; then
    printf '%s\n' "$output"
    return 1
  fi
  printf '%s\n' "$output"
  printf '%s\n' "$output" | awk 'match($0, /MESH_PERF metric=/) { print substr($0, RSTART) }' >> "$RESULTS"
}

run_d9_workloads() {
  local artifacts test_binary output test_name
  artifacts="$(cargo test -p mesh-core-shell --release --lib --no-run --message-format=json)"
  test_binary="$(printf '%s\n' "$artifacts" | python3 -c '
import json
import sys
artifacts = [json.loads(line) for line in sys.stdin if line.strip()]
executables = [item["executable"] for item in artifacts
               if item.get("reason") == "compiler-artifact"
               and item.get("target", {}).get("name") == "mesh_core_shell"
               and item.get("profile", {}).get("test")
               and item.get("executable")]
if len(executables) != 1:
    sys.exit("expected exactly one shell test executable")
print(executables[0])
')"
  for test_name in d9_navigation_updates d9_popover_open d9_theme_switch \
      d9_settings_scroll_frame_gate d9_coalesced_reload_wakeup_profile \
      d9_glass_dashboard_open d9_glass_dock_animation d9_glass_bar_clock_tick; do
    if ! output="$("$test_binary" "$test_name" --ignored --nocapture --test-threads=1 2>&1)"; then
      printf '%s\n' "$output"
      return 1
    fi
    printf '%s\n' "$output"
    printf '%s\n' "$output" | awk 'match($0, /MESH_PERF metric=/) { print substr($0, RSTART) }' >> "$RESULTS"
  done
}

cd "$ROOT"
case "${1:-}" in
  "") workloads_only=false ;;
  --workloads-only) workloads_only=true ;;
  *) printf 'usage: %s [--workloads-only]\n' "$0" >&2; exit 2 ;;
esac

if ! "$workloads_only"; then
  python3 tools/test-profile-report.py
