  run_benchmark mesh-core-shell retained_single_fingerprint_pass_beats_separate_render_diff

fi
run_d9_workloads

awk -v workloads_only="$workloads_only" '
  BEGIN {
    failed = 0
    split("d9_idle_wakeups_per_minute d9_hover_p90_ms d9_service_update_p90_ms d9_scroll_p90_ms d9_popover_open_p90_ms d9_theme_switch_p90_ms d9_glass_dashboard_open_p90_ms d9_glass_dock_frame_p90_ms d9_glass_clock_tick_p90_ms", required, " ")
    for (i in required) expected[required[i]] = 1
  }
  FNR == NR {
    if ($0 ~ /^#/ || NF == 0) next
    if (workloads_only == "true" && $1 !~ /^d9_/) next
    direction[$1] = $2
    baseline[$1] = $3 + 0
    tolerance[$1] = $4 + 0
    expected[$1] = 1
    next
  }
  /^MESH_PERF metric=/ {
    split($2, metric_part, "=")
    split($3, value_part, "=")
    metric = metric_part[2]
    if (value_part[2] !~ /^[0-9]+([.][0-9]+)?$/) {
      printf "performance gate: invalid value for %s: %s\n", metric, value_part[2] > "/dev/stderr"
      failed = 1
    }
    value[metric] = value_part[2] + 0
    seen[metric]++
  }
  END {
    for (metric in expected) {
      if (seen[metric] != 1) {
        printf "performance gate: expected one result for %s, saw %d\n", metric, seen[metric] > "/dev/stderr"
        failed = 1
        continue
      }
      if (direction[metric] == "lower") {
        threshold = baseline[metric] * (1 - tolerance[metric] / 100)
        pass = value[metric] >= threshold
        comparator = ">="
      } else if (direction[metric] == "upper") {
        threshold = baseline[metric] * (1 + tolerance[metric] / 100)
        pass = value[metric] <= threshold
        comparator = "<="
      } else {
        printf "performance gate: invalid direction %s for %s\n", direction[metric], metric > "/dev/stderr"
        failed = 1
        continue
      }
      printf "performance gate: %-40s %.3f %s %.3f (baseline %.3f, tolerance %.0f%%) %s\n", metric, value[metric], comparator, threshold, baseline[metric], tolerance[metric], pass ? "PASS" : "FAIL"
      if (!pass) failed = 1
    }
    exit failed
  }
' "$BASELINE" "$RESULTS"
