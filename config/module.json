        "exec.argv:pkill:[\"-INT\",\"-x\",\"wf-recorder\"]",
        "exec.argv:sh:[\"-c\",\"d=\\\"${XDG_VIDEOS_DIR:-$HOME/Videos}/Recordings\\\"; mkdir -p \\\"$d\\\" && printf '%s' \\\"$d\\\"\"]",
        "exec.argv:wf-recorder:[\"-f\",\"*\"]"
      ]
