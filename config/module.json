{
  "mesh": {
    "disabled": [
      "@mesh/blur-test",
      "@mesh/debug-inspector",
      "@mesh/language-popover",
      "@mesh/opacity-test",
      "@mesh/text-selection-proof",
      "@mesh/touch-gesture-proof"
    ],
    "layout": {
      "entrypoint": "@mesh/navigation-bar:main"
    },
    "modulesDir": "../modules",
    "providers": {
      "mesh.audio": "@mesh/pipewire-audio",
      "mesh.brightness": "@mesh/backlight-brightness"
    },
    "capabilityApprovals": {
      "@mesh/audio-popover": ["service.audio.control", "service.audio.read"],
      "@mesh/backlight-brightness": [
        "exec.argv:brightnessctl:[\"-m\"]",
        "exec.argv:brightnessctl:[\"set\",\"*\"]"
      ],
      "@mesh/blur-test": ["shell.surface", "theme.read"],
      "@mesh/composition-editor": [
        "service.composition.control",
        "service.composition.read",
        "shell.surface"
      ],
      "@mesh/debug-inspector": [
        "locale.read",
        "service.debug.control",
        "service.debug.read",
        "shell.surface"
      ],
      "@mesh/device-info": [
        "exec.argv:cat:[\"/etc/os-release\"]",
        "exec.argv:cat:[\"/proc/cpuinfo\"]",
        "exec.argv:cat:[\"/proc/meminfo\"]",
        "exec.argv:cat:[\"/proc/uptime\"]",
        "exec.argv:hostname:[]",
        "exec.argv:uname:[\"-m\"]",
        "exec.argv:uname:[\"-r\"]",
        "exec.argv:uname:[\"-s\"]"
      ],
      "@mesh/hyprland-wm": [
        "exec.argv:hyprctl:[\"activeworkspace\",\"-j\"]",
        "exec.argv:hyprctl:[\"activewindow\",\"-j\"]",
        "exec.argv:hyprctl:[\"dispatch\",\"hl.dsp.focus({ workspace = \\\"*\\\" })\"]",
        "exec.argv:hyprctl:[\"dispatch\",\"workspace\",\"*\"]",
        "exec.argv:hyprctl:[\"instances\",\"-j\"]",
        "exec.argv:hyprctl:[\"workspaces\",\"-j\"]",
        "exec.argv:sh:[\"-c\",\"printf '%s' \\\"$HYPRLAND_INSTANCE_SIGNATURE\\\"\"]",
        "exec.argv:sh:[\"-c\",\"printf '%s' \\\"${XDG_RUNTIME_DIR:-/run/user/$(id -u)}\\\"\"]",
        "exec.argv:sh:[\"-c\",\"test -S * && echo ok\"]",
        "exec.argv:nc:[\"-U\",\"*\"]",
        "exec.argv:socat:[\"-\",\"UNIX-CONNECT:*\"]"
      ],
      "@mesh/language-popover": ["locale.read", "locale.write"],
      "@mesh/navigation-bar": [
        "locale.read",
        "locale.write",
        "service.audio.control",
        "service.audio.read",
        "service.brightness.control",
        "service.brightness.read",
        "service.media.read",
        "service.power.read",
        "service.settings.read",
        "service.wm.control",
        "service.wm.read",
        "shell.surface",
        "theme.read"
      ],
      "@mesh/opacity-test": ["shell.surface", "theme.read"],
      "@mesh/pipewire-audio": [
        "exec.argv:wpctl:[\"get-volume\",\"*\"]",
        "exec.argv:wpctl:[\"set-mute\",\"*\",\"*\"]",
        "exec.argv:wpctl:[\"set-volume\",\"*\",\"*\"]",
        "exec.argv:wpctl:[\"status\"]"
      ],
      "@mesh/pulseaudio-audio": [
        "exec.argv:pactl:[\"get-sink-mute\",\"@DEFAULT_SINK@\"]",
        "exec.argv:pactl:[\"get-sink-volume\",\"@DEFAULT_SINK@\"]",
        "exec.argv:pactl:[\"set-sink-mute\",\"@DEFAULT_SINK@\",\"*\"]",
        "exec.argv:pactl:[\"set-sink-volume\",\"@DEFAULT_SINK@\",\"*\"]",
        "exec.argv:pactl:[\"subscribe\"]"
      ],
      "@mesh/quick-settings": [
        "locale.read",
        "locale.write",
        "service.audio.control",
        "service.audio.read",
        "service.brightness.control",
        "service.brightness.read",
        "service.power.read",
        "service.theme.control",
        "shell.surface",
        "theme.read"
      ],
      "@mesh/settings": [
        "locale.read",
        "locale.write",
        "service.audio.control",
        "service.audio.read",
        "service.bluetooth.control",
        "service.bluetooth.read",
        "service.debug.read",
        "service.device.read",
        "service.network.control",
        "service.network.read",
        "service.packages.control",
        "service.packages.read",
        "service.settings.control",
        "service.settings.read",
        "service.theme.control",
        "shell.surface",
        "theme.read"
      ],
      "@mesh/text-selection-proof": ["shell.surface", "theme.read"],
      "@mesh/theme-selector": ["service.theme.control", "theme.read"],
      "@mesh/touch-gesture-proof": ["shell.surface", "theme.read"],
      "@mesh/upower-power": [
        "exec.argv:upower:[\"-e\"]",
        "exec.argv:upower:[\"-i\",\"*\"]"
      ]
    },
    "schemaVersion": 1
  },
  "name": "@mesh/local-config",
  "private": true,
  "version": "0.1.0"
}
