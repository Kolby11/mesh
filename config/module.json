        "exec.argv:wpctl:[\"set-mute\",\"*\",\"*\"]",
        "exec.argv:wpctl:[\"set-volume\",\"*\",\"*\"]",
        "exec.argv:wpctl:[\"status\"]",
        "exec.argv:pw-mon:[\"--hide-props\",\"--hide-params\",\"--print-separator\"]"
      ],
      "@mesh/profile-menu": [
