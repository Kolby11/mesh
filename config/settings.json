{
  "@mesh/navigation-bar": {
    "i18n": {
      "default_locale": "sk"
    }
  },
  "schemaVersion": 1,
  "shell": {
    "fonts": {
      "ui_family": "DejaVu Sans"
    },
    "i18n": {
      "fallback_locale": "en",
      "locale": "en",
      "policy": "manual"
    },
    "icons": {
      "default_pack": "breeze"
    },
    "render": {
      "blur": {
        "max_radius": 96,
        "passes": 2
      }
    },
    "theme": {
      "active": "tokyo-night"
    }
  }
}
